end

-- a spike's (down degrees, speed) met `behind` studs behind the net with this lean (-1 away from my facing .. 1 toward it), plus a
-- learned correction { down, speed } on top
function M.spikeShape(behind, lean, correction)
    lean = math.clamp(lean, -1, 1)
    local down0, speed0 = along(SPIKE_AT[0], behind)
    local down, speed
    if lean <= 0 then
        local downB, speedB = along(SPIKE_AT[-1], behind)
        down, speed = down0 + (down0 - downB) * lean, speed0 + (speed0 - speedB) * lean
    else
        down, speed = down0 + SPIKE_FORWARD.down * lean, speed0 + SPIKE_FORWARD.speed * lean
    end
    if correction then
        down, speed = down + (correction.down or 0), speed * (correction.speed or 1)
    end
    return down, speed
end

-- (horizontal, vertical) speeds for a down angle and speed
function M.spikeSpeeds(down, speed)
    local r = math.rad(down)
    return speed * math.cos(r), -speed * math.sin(r)
end

-- a bump's (horizontal, vertical) launch met `behind` studs behind the net at this charge
function M.bumpSpeeds(behind, charge)
    behind = math.max(behind, 0)
    local full = 12.7 + 0.44 * behind
    return full * (CHARGE_FLOOR + (1 - CHARGE_FLOOR) * math.clamp(charge, 0, 1)), 27 - 0.1 * (behind - 10.8)
end

-- how far a bump met `behind` studs behind the net carries at this charge, for a half `halfDepth` deep
function M.bumpReach(behind, halfDepth, charge)
    local full = math.max(behind, 0) + BUMP_DEPTH * halfDepth
    return full * (CHARGE_FLOOR + (1 - CHARGE_FLOOR) * math.clamp(charge, 0, 1))
end

-- the charge that makes that bump carry `dist`, clamped to what a charge can do
function M.bumpCharge(dist, behind, halfDepth)
    local full = M.bumpReach(behind, halfDepth, 1)
    if full <= 0 then return 1 end
    return math.clamp((dist / full - CHARGE_FLOOR) / (1 - CHARGE_FLOOR), 0, 1)
end

-- the game's serve power curve at this power (0..1)
function M.powerCurve(power)
    power = math.clamp(power, 0, 1)
    for i = 2, #POWER_CURVE do
        local a, b = POWER_CURVE[i - 1], POWER_CURVE[i]
        if power <= b[1] then return a[2] + (b[2] - a[2]) * (power - a[1]) / (b[1] - a[1]) end
    end
    return POWER_CURVE[#POWER_CURVE][2]
end

-- a serve spike's speed at this serve power
function M.serveSpeed(power)
    return SERVE_BASE + SERVE_SCALE * M.powerCurve(power)
end

-- a serve spike's (horizontal, vertical) launch and the gravity it flies under, for a lean (-1 away .. 1 toward my facing) and serve power
function M.serveSpeeds(lean, power)
    lean = math.clamp(lean, -1, 1)
    local speed = M.serveSpeed(power)
    local down = lean <= 0 and SERVE_DOWN[0] + (SERVE_DOWN[0] - SERVE_DOWN[-1]) * lean or SERVE_DOWN[0] + (SERVE_DOWN[1] - SERVE_DOWN[0]) * lean
    local h, v = M.spikeSpeeds(down * speed / SERVE_FULL, speed)
    return h, v, 17 * math.max(1, speed / SERVE_DIP_FROM) ^ SERVE_DIP_POWER
end

-- a post-hit velocity as (horizontal, vertical) speeds, the vertical one carried back along its own arc to my contact height so a late sample reads the same; nil when it can't be my aimed hit
function M.measure(velocity, facing, ballY, contactY, g)
    if velocity.Magnitude < MIN_SPEED then return nil end
    local h = math.sqrt(velocity.X * velocity.X + velocity.Z * velocity.Z)
    -- straight up has no direction to hold against my facing
    if h <= 0 then return nil end
    if (velocity.X * facing.X + velocity.Z * facing.Z) / h < MIN_FACING_DOT then return nil end
    local vy = velocity.Y
    local v = math.sqrt(math.max(vy * vy + 2 * g * (ballY - contactY), 0))
    if vy < 0 then v = -v end
    return h, v
end

function M.new()
    local speeds = {}
    for move, seed in pairs(SEEDS) do speeds[move] = { h = seed.h, v = seed.v } end
    -- how far my spikes run off the table, learned: degrees added to its down angle, and a factor on its speed
    local spikeFix = { down = 0, speed = 1 }

    local model = {}

    -- a spike's (down degrees, speed) with my learned correction
    function model.spike(behind, lean)
        return M.spikeShape(behind, lean, spikeFix)
    end

    -- (horizontal, vertical) for a move, or nil until it has been seeded or seen; a bump goes by its own speeds, a spike by its table
    function model.get(move)
        local s = move and speeds[move]
        if s then return s.h, s.v end
        return nil
    end

    -- the first sample of an unknown move is taken as it is; bumps are never learned, their speeds are the rule above; a spike's
    -- sample (with the distance and lean it was hit with) moves the correction toward it, and a soft one (off the sweet spot) is ignored
    function model.add(move, h, v, lean, behind)
        if move == "Bump" then return end
        if move == "Spike" then
            if type(behind) ~= "number" then return end
            local down0, speed0 = M.spikeShape(behind, lean or 0)
            local speed = math.sqrt(h * h + v * v)
            if speed < SOFT_SPIKE * speed0 then return end
            local down = math.deg(atan2(-v, h))
            spikeFix.down = spikeFix.down + WEIGHT * ((down - down0) - spikeFix.down)
            spikeFix.speed = spikeFix.speed + WEIGHT * (speed / speed0 - spikeFix.speed)
            return
        end
        local s = speeds[move]
        if not s then
            speeds[move] = { h = h, v = v }
            return
        end
        s.h = s.h + WEIGHT * (h - s.h)
        s.v = s.v + WEIGHT * (v - s.v)
    end

    return model
end

return M

end)
__bundle_register("Features/Volleyball/HitSettings", function(require, _LOADED, __bundle_register, __bundle_modules)
-- hit settings: the play tab's shared box for what every hit uses (aim spots and their shares, auto player adjust, aim spread, swing timing, hit range), built from static data before autoplay or assist read it
local M = {}

-- the aim spots in menu order, each with its share slider's id and default share
M.SPOTS = {
    { name = "Open Spot",     id = "VL_AimShare_Open",     share = 50 },
    { name = "Far Corner",    id = "VL_AimShare_Far",      share = 30 },
    { name = "Near Corner",   id = "VL_AimShare_Near",     share = 20 },
    { name = "Straight Over", id = "VL_AimShare_Straight", share = 50 },
    { name = "Deep Middle",   id = "VL_AimShare_Deep",     share = 50 },
    { name = "Short Drop",    id = "VL_AimShare_Short",    share = 50 },
}
M.DEFAULT_SPOTS = { "Open Spot", "Far Corner", "Near Corner" }

-- aim runs while Aim Assist or Auto Hit is on; auto hit's toggle sits in autoplay's box, whose one OnChanged handler autoplay keeps,
-- so that toggle's Callback reports here and assist listens
local gateListeners = {}

-- registers a listener; returns its removal
function M.onAimGate(fn)
    gateListeners[#gateListeners + 1] = fn
    return function()
        for i, f in ipairs(gateListeners) do
            if f == fn then
                table.remove(gateListeners, i)
                return
            end
        end
    end
end

function M.aimGateChanged()
    for _, fn in ipairs(gateListeners) do fn() end
end

-- whether aim should run: its own toggle, or auto hit's swings
function M.aimWanted(Toggles)
    local own, auto = Toggles.VL_AimAssist, Toggles.VL_AutoHit
    return (own ~= nil and own.Value == true) or (auto ~= nil and auto.Value == true)
end

-- auto serve's own hit is always aimed (at their hardest spot), on its own toggle's word
function M.serveWanted(Toggles)
    local serve = Toggles.VL_AutoServe
    return serve ~= nil and serve.Value == true
end

-- the picked spots' shares always add up to this
local TOTAL = 100

-- whole-number shares adding up to `total`, in proportion to the weights (all zero: even), the largest remainders taking the leftover points
function M.apportion(weights, total)
    local n = #weights
    if n == 0 then return {} end
    local sum = 0
    for _, w in ipairs(weights) do sum = sum + math.max(w, 0) end
    local raw, out, order, used = {}, {}, {}, 0
    for i, w in ipairs(weights) do
        raw[i] = sum > 0 and math.max(w, 0) * total / sum or total / n
        out[i] = math.floor(raw[i])
        used = used + out[i]
        order[i] = i
    end
    table.sort(order, function(a, b)
        local ra, rb = raw[a] - out[a], raw[b] - out[b]
        if ra ~= rb then return ra > rb end
        return a < b
    end)
    for k = 1, total - used do
        local i = order[(k - 1) % n + 1]
        out[i] = out[i] + 1
    end
    return out
end

function M.build(tab, Options)
    local box = tab:AddRightGroupbox("Hit Settings", "sliders-horizontal")

    local names = {}
    for i, spot in ipairs(M.SPOTS) do names[i] = spot.name end
    local sliders = {}
    -- our own writes while balancing must not balance again
    local balancing = false
    -- the spots picked when the shares were last balanced, so a newly picked one can be told apart
    local lastPicked = {}

    local function pickedSet()
        local spots = Options.VL_AimSpots
        return spots and spots.Value or {}
    end

    local function pickedList()
        local set, list = pickedSet(), {}
        for _, spot in ipairs(M.SPOTS) do
            if set[spot.name] == true then list[#list + 1] = spot end
        end
        return list
    end

    local function share(spot)
        return tonumber(Options[spot.id] and Options[spot.id].Value) or 0
    end

    local function setShares(spots, values)
        balancing = true
        for i, spot in ipairs(spots) do sliders[spot.name]:SetValue(values[i]) end
        balancing = false
    end

    -- a newly picked spot gets an even share and the ones already picked split the rest as they stood; dropping one scales the rest back up
    local function rebalance()
        local list = pickedList()
        local fresh, kept, keptWeights = {}, {}, {}
        for _, spot in ipairs(list) do
            if lastPicked[spot.name] then
                kept[#kept + 1] = spot
                keptWeights[#keptWeights + 1] = share(spot)
            else
                fresh[#fresh + 1] = spot
            end
        end
        lastPicked = {}
        for _, spot in ipairs(list) do lastPicked[spot.name] = true end
        if #list == 0 then return end
        if #kept == 0 then
            local weights = {}
            for i, spot in ipairs(list) do weights[i] = share(spot) end
            setShares(list, M.apportion(weights, TOTAL))
            return
        end
        local freshTotal = math.floor(TOTAL * #fresh / #list + 0.5)
        local evens = {}
        for i = 1, #fresh do evens[i] = 1 end
        setShares(fresh, M.apportion(evens, freshTotal))
        setShares(kept, M.apportion(keptWeights, TOTAL - freshTotal))
    end

    -- one picked share moved: the other picked ones take what is left, in proportion; a lone pick is always all of it
    local function shareMoved(moved)
        if balancing or pickedSet()[moved.name] ~= true then return end
        local others, weights = {}, {}
        for _, spot in ipairs(pickedList()) do
            if spot ~= moved then
                others[#others + 1] = spot
                weights[#weights + 1] = share(spot)
            end
        end
        if #others == 0 then
            setShares({ moved }, { TOTAL })
            return
        end
        setShares(others, M.apportion(weights, TOTAL - math.clamp(share(moved), 0, TOTAL)))
    end

    -- a spot's share only shows while it is picked; Callback, because OnChanged holds one handler and assist takes it
    local function showShares()
        local picked = pickedSet()
        for name, slider in pairs(sliders) do slider:SetVisible(picked[name] == true) end
    end
    box:AddDropdown("VL_AimSpots", {
        Text     = "Aim At",
        Values   = names,
        Default  = M.DEFAULT_SPOTS,
        Multi    = true,
        Tooltip  = "Pick several to mix your hits",
        Callback = function()
            showShares()
            rebalance()
        end,
    })
    for _, spot in ipairs(M.SPOTS) do
        sliders[spot.name] = box:AddSlider(spot.id, {
            Text = spot.name .. " Share", Default = spot.share, Min = 0, Max = 100, Rounding = 0, Suffix = "%",
            Callback = function() shareMoved(spot) end,
        })
    end
    box:AddToggle("VL_AimAdjust", {
        Text = "Auto Player Adjust", Default = true,
        Tooltip = "Picks the spot farthest from their players",
    })
    box:AddSlider("VL_AimSpread", {
        Text = "Aim Spread", Default = 0, Min = 0, Max = 10, Rounding = 1, Suffix = " studs",
        Tooltip = "Random miss so hits vary",
    })
    box:AddSlider("VL_SwingTiming", {
        Text = "Swing Timing", Default = 0, Min = -150, Max = 150, Rounding = 0, Suffix = " ms",
        Tooltip = "Raise if hits come late",
    })
    box:AddSlider("VL_HitRange", {
        Text = "Hit Range", Default = 100, Min = 100, Max = 200, Rounding = 0, Suffix = "%", Premium = true,
    })

    showShares()
    rebalance()
end

-- the picked spots with a share above zero, in menu order, as { name, weight }
function M.read(Options)
    local out = {}
    local spots = Options.VL_AimSpots
    local picked = spots and spots.Value or {}
    for _, spot in ipairs(M.SPOTS) do
        local slider = Options[spot.id]
        local weight = slider and tonumber(slider.Value) or 0
        if picked[spot.name] == true and weight > 0 then out[#out + 1] = { name = spot.name, weight = weight } end
    end
    return out
end

return M

end)
