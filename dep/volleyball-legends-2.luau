            }
        end
        if move == "Spike" and behind <= HitModel.SPIKE_MAX_BEHIND then
            return {
                kind = "lean", lo = controllable and -1 or 0, hi = controllable and HitModel.maxForwardLean(behind) or 0,
                g = HitModel.SPIKE_GRAVITY, behind = behind,
                launch = function(u) return HitModel.spikeSpeeds(model.spike(behind, u)) end,
            }
        end
        local h, v = model.get(move)
        if not h or h < SLOW_SPEED then return nil end
        local okG, g = Ball.gravity()
        if not (okG and type(g) == "number") then return nil end
        return { lo = 0, hi = 0, g = g, behind = behind, launch = function() return h, v end }
    end

    -- the flight's carry for a control
    local function carryFor(f, c, plan, u)
        local across, up = f.launch(u)
        return M.carry(across, up, f.g, c.Y - plan.floorY)
    end

    -- the landing this flight can actually make nearest (tx, tz), inside their half and over the net: x, z, carry, control, landsIn;
    -- the control for a carry is solved exactly for the answer, and read off a sampled curve while searching. a walk's push (a bump's,
    -- { x, z } over the whole flight at { vx, vz } studs/s) carries every landing that much further along it: the reachable ring is
    -- centred there and the carry is measured from there, while the ball itself still leaves from c
    local function reachFor(f, c, plan, tx, tz, push)
        local rA, rB = carryFor(f, c, plan, f.lo), carryFor(f, c, plan, f.hi)
        if not (rA and rB) then return nil end
        local rMin, rMax = math.min(rA, rB), math.max(rA, rB)
        local curve = M.sampleCarry(function(u) return carryFor(f, c, plan, u) end, f.lo, f.hi)
        local o = push and Vector3.new(c.X + push.x, c.Y, c.Z + push.z) or c
        local function overNet(x, z, r)
            if r <= 1e-6 then return false end
            local across, up = f.launch(M.readCurve(curve, r))
            local vx, vz = (x - o.X) / r * across, (z - o.Z) / r * across
            if push then vx, vz = vx + push.vx, vz + push.vz end
            local speed = math.sqrt(vx * vx + vz * vz)
            if speed <= 1e-6 then return false end
            return M.clearsNet(c, vx / speed, vz / speed, speed, up, f.g, plan)
        end
        local x, z, r, landsIn = Landing.reach(o, tx, tz, rMin, rMax, plan.half, overNet)
        if not x then return nil end
        return x, z, r, M.solve(function(u) return carryFor(f, c, plan, u) end, f.lo, f.hi, r), landsIn
    end

    -- of every picked spot and its mirror, the one whose real landing is farthest from their nearest player; ties go to the bigger share,
    -- a landing that goes out never wins
    local function awayFromPlayers(c, move, plan, controllable, opponents, rootZ)
        local names, weightOf = {}, {}
        for i, sp in ipairs(spots) do
            names[i] = sp.name
            weightOf[sp.name] = sp.weight
        end
        local f = flightOf(c, move, plan, controllable, rootZ)
        local best, bestScore, bestWeight
        for _, cand in ipairs(Landing.candidates(names, c, plan.half, opponents)) do
            local x, z, landsIn = cand.x, cand.z, true
            if f then
                local rx, rz, _, _, inside = reachFor(f, c, plan, cand.x, cand.z)
                if rx then x, z, landsIn = rx, rz, inside end
            end
            local score = landsIn and Landing.nearestSq(x, z, opponents) or -1
            local weight = weightOf[cand.name] or 0
            if best == nil or score > bestScore or (score == bestScore and weight > bestWeight) then
                best, bestScore, bestWeight = cand, score, weight
            end
        end
        return best
    end

    -- a serve spike's flight from contact point c at this serve power: lean -1..1 when it can still be set, under its own (harder) dip
    local function serveFlight(c, plan, power, controllable)
        local _, _, g = HitModel.serveSpeeds(0, power)
        return {
            kind = "lean", lo = controllable and -1 or 0, hi = controllable and 1 or 0, g = g, behind = (plan.netZ - c.Z) * plan.s,
            launch = function(u)
                local h, v = HitModel.serveSpeeds(u, power)
                return h, v
            end,
        }
    end

    -- a jump serve from contact point c: of every point a stud apart in their half that this serve can land on over the net, the one their
    -- nearest receiver falls furthest short of reaching in its flight time (nobody there: a receiver mid half), aimed with the lean that lands it;
    -- nil when the net isn't there yet or no point can be made (then the nearest reachable landing to their deep middle is used)
    local function planServe(c, controllable, power)
        local plan = courtPlan(c)
        if not (plan and plan.half) then return nil end
        local f = serveFlight(c, plan, power, controllable)
        local function carryOf(u) return carryFor(f, c, plan, u) end
        local rA, rB = carryOf(f.lo), carryOf(f.hi)
        if not (rA and rB) then return nil end
        local rMin, rMax = math.min(rA, rB), math.max(rA, rB)
        local curve = M.sampleCarry(carryOf, f.lo, f.hi)
        local receivers = opponentRoots()
        if #receivers == 0 then receivers = { Landing.receiverSpot(plan.half) } end
        local best, bestScore
        for _, p in ipairs(Landing.grid(plan.half, SERVE_GRID)) do
            local dx, dz = p.x - c.X, p.z - c.Z
            local r = math.sqrt(dx * dx + dz * dz)
            if r >= rMin and r <= rMax and r > 1e-6 then
                local across, up = f.launch(M.readCurve(curve, r))
                if M.clearsNet(c, dx / r, dz / r, across, up, f.g, plan) then
                    local score = Landing.shortfall(p.x, p.z, receivers, r / across)
                    if bestScore == nil or score > bestScore then best, bestScore = { x = p.x, z = p.z, r = r }, score end
                end
            end
        end
        local x, z, r, u
        if best then
            x, z, r, u = best.x, best.z, best.r, M.solve(carryOf, f.lo, f.hi, best.r)
        else
            local tx, tz = Landing.spot("Deep Middle", c, plan.half)
            x, z, r, u = reachFor(f, c, plan, tx, tz)
            if not x then return nil end
        end
        local dist = math.max(r, 1e-6)
        return {
            dir = Vector3.new((x - c.X) / dist, 0, (z - c.Z) / dist), dist = r, kind = "lean", control = u, behind = f.behind,
            serve = true, score = bestScore, landX = x, landZ = z,
        }
    end

    -- the push a bump pressed walking along `walk` takes over its flight (a bump's height doesn't change with its charge, so neither
    -- does its flight time); nil when it never comes down
    local function walkPush(f, c, plan, walk)
        local _, up = f.launch(f.hi)
        local t = Landing.flightTime(up, f.g, c.Y - plan.floorY)
        if not t then return nil end
        local vx, vz = walk.X * HitModel.BUMP_WALK, walk.Z * HitModel.BUMP_WALK
        return { x = vx * t, z = vz * t, vx = vx, vz = vz }
    end

    -- the plan for this shot from contact point c: { dir, dist, kind, control, behind, landX, landZ }, the facing, the carry from c to
    -- where it lands and the charge or lean that carries it there; a bump pressed with a walk (walk given) faces off the spot by the
    -- walk's push, and a spike is keyed off where the server has my root (rootZ); nil only when the net itself isn't there yet
    local function planShot(c, move, sh, controllable, walk, rootZ)
        local plan = courtPlan(c)
        if not plan then return nil end
        local function toward(x, z, extra)
            local dx, dz = x - c.X, z - c.Z
            local dist = math.sqrt(dx * dx + dz * dz)
            local out = extra or {}
            out.dir = dist > 1e-6 and Vector3.new(dx / dist, 0, dz / dist) or Vector3.new(0, 0, plan.s)
            out.dist = dist
            out.landX, out.landZ = x, z
            return out
        end
        -- training may have no court lines: straight across, a fixed depth into their half
        if not plan.half then return toward(c.X, plan.netZ + plan.s * STRAIGHT_DEPTH) end
        local opponents = (adjust() or sh.name == "Open Spot") and opponentRoots() or nil
        local tx, tz
        local away = adjust() and opponents and #opponents > 0 and awayFromPlayers(c, move, plan, controllable, opponents, rootZ)
        if away then
            tx, tz = away.x, away.z
        else
            tx, tz = Landing.spot(sh.name, c, plan.half, sh.name == "Open Spot" and opponents or nil)
        end
        -- a long hit keeps further inside the lines: its misses grow with its length
        plan.half = Landing.widen(plan.half, Landing.edgeFor(math.sqrt((tx - c.X) ^ 2 + (tz - c.Z) ^ 2)))
        tx, tz = Landing.clamp(plan.half, tx + sh.dx, tz + sh.dz)
        local f = flightOf(c, move, plan, controllable, rootZ)
        if not f then return toward(tx, tz) end
        local push = f.kind == "charge" and walk and plan.floorY and walkPush(f, c, plan, walk) or nil
        local x, z, r, u = reachFor(f, c, plan, tx, tz, push)
        if not x then return toward(tx, tz, { behind = f.behind }) end
        if not push then return toward(x, z, { kind = f.kind, control = u, behind = f.behind }) end
        -- walking, the hit's own carry runs from where the push takes it: faced along that, the sum lands on (x, z)
        local ox, oz = c.X + push.x, c.Z + push.z
        return {
            dir = r > 1e-6 and Vector3.new((x - ox) / r, 0, (z - oz) / r) or Vector3.new(0, 0, plan.s), dist = r, kind = f.kind, control = u,
            behind = f.behind, landX = x, landZ = z, walk = walk, across = f.launch(u),
        }
    end

    local function restoreCharge()
        if not charged then return end
        charged = false
        if Actions then Actions.setCharge(1) end
    end

    local function stopLean()
        if leanTask then maid[leanSlot] = nil end
        leanTask, leanSlot = nil, nil
    end

    -- lets go of the turn; the charge stays set until the whole hit is over
    local function release(keepCharge)
        local held = turn
        turn = nil
        stopLean()
        if not keepCharge then restoreCharge() end
        if not (held and held.humanoid) then return end
        pcall(function() held.humanoid.AutoRotate = held.autoRotate end)
    end

    -- whether the game's charge can be set; a miss is asked again at most this often, since finding it scans the game's functions
    local chargeKnown, chargeRetryAt = false, 0
    local function canCharge(now)
        if chargeKnown then return true end
        if not Actions or now < chargeRetryAt then return false end
        chargeRetryAt = now + CHARGE_RETRY
        chargeKnown = Actions.charge() == true
        return chargeKnown
    end

    -- a serve's power while its hit is still to come: the server's Power attribute on my character, set by the toss and cleared as the
    -- hit starts (DoMove.Game.lua:18-21); nil otherwise
    local function servePower(root)
        local ok, power = pcall(function() return root.Parent:GetAttribute("Power") end)
        if ok and type(power) == "number" then return power end
        return nil
    end

    -- a serve hit carries the serve's own power, so its charge is left alone
    local function serving(root)
        return root ~= nil and servePower(root) ~= nil
    end

    -- the walk direction that leans a spike by `amount` toward `dir` (sideways leaning changes nothing, so the rest goes sideways); none near 0
    local function leanVector(dir, amount)
        if math.abs(amount) < LEAN_DEADBAND then return Vector3.new(0, 0, 0) end
        local side = math.sqrt(math.max(1 - amount * amount, 0))
        return Vector3.new(dir.X * amount - dir.Z * side, 0, dir.Z * amount + dir.X * side)
    end

    -- the walk direction rides the stepped lane: after the game's input has set it and before physics and the jump step read it; a spike's
    -- lean for the whole turn, a grounded bump's step only for its first moments
    local function startLean()
        if leanTask then return end
        leanTask = Scheduler.stepped(function()
            local held = turn
            if not held then return end
            local walk = held.lean
            -- held back until the jump has taken its own drift
            if walk and airSince and os.clock() - airSince < LIFT_GUARD then return end
            if not walk and held.stepUntil and os.clock() < held.stepUntil then walk = held.dir end
            if not walk then return end
            pcall(function() held.humanoid:Move(walk, false) end)
        end, { name = "Assist/Lean" })
        if leanTask then leanSlot = maid:GiveTask(leanTask) end
    end

    local function jumping()
        if not Actions then return false end
        local ok, st = Actions.state()
        return ok == true and type(st) == "table" and st.IsJumping == true
    end

    -- the walk a move pressed now sends (DoMove.Game.lua:92): the jump's own drift in the air, else the humanoid's, flat
    local function walkNow()
        local ok, m = pcall(function()
            if jumping() and values and typeof(values.MovementDirection) == "Vector3" then return values.MovementDirection end
            return References.humanoid.MoveDirection
        end)
        if ok and typeof(m) == "Vector3" then return Vector3.new(m.X, 0, m.Z) end
        return Vector3.new(0, 0, 0)
    end

    -- the walk a bump was really pressed with: another than planned turns the whole launch back onto the spot (its charge is read)
    local function rewalk(held)
        local w = walkNow()
        if (w - held.walk).Magnitude < WALK_CHANGE then return end
        local c = held.contact
        local fx, fz = M.turnOnto(held.dir.X, held.dir.Z, held.across, w.X * HitModel.BUMP_WALK, w.Z * HitModel.BUMP_WALK,
            held.landX - c.X, held.landZ - c.Z)
        held.dir, held.walk = Vector3.new(fx, 0, fz), w
        Log.dev("Aim", "Bump pressed walking (%.2f, %.2f): turned onto its spot", w.X, w.Z)
    end

    -- where this hit will be met: the given contact, else the ball itself when it is within reach, else my root
    local function contactFor(root, given)
        if given then return given end
        local okA, ball = Ball.active()
        if okA and type(ball) == "table" and typeof(ball.position) == "Vector3" and (ball.position - root.Position).Magnitude <= CONTACT_REACH then
            return ball.position
        end
        return root.Position + Vector3.new(0, CONTACT_RISE, 0)
    end

    -- where the server has my root when this hit meets the ball tc seconds from now (its copy runs SERVER_LAG behind mine), along my
    -- current drift; tc unknown is a hit meeting it now
    local function serverRoot(root, tc)
        local okV, v = pcall(function() return root.AssemblyLinearVelocity end)
        if not (okV and typeof(v) == "Vector3") then return root.Position end
        return root.Position + Vector3.new(v.X, 0, v.Z) * ((tc or 0) - SERVER_LAG)
    end

    local function begin(holdFor, move, early, contact, tc)
        local root, hum = References.humanoidRootPart, References.humanoid
        if not (root and hum) then return end
        local now = os.clock()
        -- the swing an early turn was made for keeps it: its charge or lean was set for that spot before the swing could read them (a
        -- serve's swing also clears its Power, so it couldn't be told apart later)
        if not early and turn and turn.early and turn.move == move then
            turn.untilT = now + (holdFor or HOLD)
            if turn.walk then rewalk(turn) end
            if turn.contact then
                local c = turn.contact
                Log.dev("Aim", "%s swung on its plan from (%.1f, %.1f, %.1f): lands (%.1f, %.1f), lean %s", move, c.X, c.Y, c.Z,
                    turn.landX, turn.landZ, tostring(turn.leanAmount))
            end
            return
        end
        -- an early turn re-planned until the swing (in the air on a timer, on the ground when the walk moves) keeps its spot
        local replanning = early and turn ~= nil and turn.early and turn.move == move
        local power = serveAim and servePower(root) or nil
        local sh = power and serveShot(now) or (replanning and turn.shot) or rollShot(now)
        if not sh then return end
        -- the swing an early turn was made for keeps its plan: the charge or lean it set was worked out for that spot
        if not early and turn and turn.shot == sh and turn.move == move then
            turn.untilT = now + (holdFor or HOLD)
            if turn.walk then rewalk(turn) end
            return
        end
        -- only an early turn comes before the swing reads its charge or lean; a move already playing has read them
        local chargeable = early and move == "Bump" and canCharge(now) and not serving(root)
        local leanable = early and move == "Spike"
        local c = contactFor(root, contact)
        local p
        if power and move == "Spike" then p = planServe(c, leanable, power) end
        if not p then
            p = planShot(c, move, sh, chargeable or leanable, move == "Bump" and walkNow() or nil, move == "Spike" and serverRoot(root, tc).Z or nil)
        end
        if not p then return end
        -- a re-plan is the same turn: it keeps when it began and its step, and release hands autorotate back so it is read again after
        local startedAt = replanning and turn.startedAt or now
        local stepUntil = replanning and turn.stepUntil or nil
        release(true)
        turn = {
            dir = p.dir, dist = p.dist, untilT = now + (holdFor or HOLD), humanoid = hum, autoRotate = hum.AutoRotate,
            shot = sh, move = move, startedAt = startedAt, behind = p.behind, serve = power ~= nil,
            early = early == true, replanAt = now + REPLAN_EVERY, contact = c,
            landX = p.landX, landZ = p.landZ, walk = p.walk, across = p.across,
        }
        if not replanning or p.walk then
            Log.dev("Aim", "%s %s from (%.1f, %.1f, %.1f) behind %.1f: lands (%.1f, %.1f), carry %.1f, %s %s, walk %s", move, sh.name, c.X,
                c.Y, c.Z, p.behind or -1, p.landX, p.landZ, p.dist, tostring(p.kind), tostring(p.control), tostring(p.walk))
        end
        if p.kind == "charge" and chargeable and Actions.setCharge(p.control) then charged = true end
        if p.kind == "lean" and leanable then
            turn.leanAmount = p.control
            turn.lean = leanVector(p.dir, p.control)
            startLean()
        elseif move == "Bump" and hum.FloorMaterial ~= Enum.Material.Air then
            -- a turn begun walking is seen without one, and a walk key held into the swing is the user's own
            if replanning then
                turn.stepUntil = stepUntil
            elseif not (p.walk and p.walk.Magnitude >= WALK_CHANGE) then
                turn.stepUntil = now + STEP_TIME
            end
            if turn.stepUntil and now < turn.stepUntil then startLean() end
        end
    end

    -- the turn's lead: a later swing timing turns that much earlier, and so does standing still on the ground; in the air the whole
    -- rest of the jump (the walk direction a jump drifts along is taken once at take-off, so a lean held after it only tilts the hit)
    local function window(air)
        local t = tonumber(timing()) or 0
        if air then return AIR_WINDOW + math.max(t, 0) end
        local w = PRE_WINDOW + math.max(t, 0)
        local root = References.humanoidRootPart
        local okV, v = pcall(function() return root and root.AssemblyLinearVelocity end)
        if okV and typeof(v) == "Vector3" and Vector3.new(v.X, 0, v.Z).Magnitude < IDLE_SPEED then w = w + IDLE_EXTRA end
        return w
    end

    -- the predicted ball position t seconds out, or nil
    local function predictedAt(t)
        local okP, pred = Ball.predict({ horizon = t + 0.2, samples = 2 })
        if not (okP and type(pred) == "table" and type(pred.positionAt) == "function") then return nil end
        local okAt, p = pcall(pred.positionAt, t)
        if okAt and typeof(p) == "Vector3" then return p end
        return nil
    end

    local function gravity()
        local ok, g = pcall(function() return Workspace.Gravity end)
        if ok and type(g) == "number" and g > 0 then return g end
        return DEFAULT_GRAVITY
    end

    -- a ball within one window of this move's hitbox (my style's), read the way the game builds it, or (on the ground) one landing beside
    -- me that soon while i'm still walking under it; returns where it will be met (and in how long, when known), or nil. in the air the box rides my jump: read where it
    -- is now, a ball met on the way up was put several studs low (live: 11 up for a 17.5-up contact), where no spike clears the net
    local function incoming(w, move, grounded)
        local root = References.humanoidRootPart
        if not (root and Ball and Actions) then return nil end
        local okH, hb = Actions.hitbox(move)
        if not okH then return nil end
        local opts = { horizon = w }
        if not grounded then
            local okV, v = pcall(function() return root.AssemblyLinearVelocity end)
            if okV then opts.boxVelocity, opts.boxAccel = Contact.motion(v, gravity(), true) end
        end
        local okT, t = Ball.timeIntoBox(root.CFrame * hb.Offset, hb.Size, opts)
        if okT == true and t ~= nil and t <= w then
            -- a ball already in the box and climbing (a fresh spawn at my feet, my own toss) isn't about to be hit
            if t == 0 then
                local okA, ball = Ball.active()
                if okA and type(ball) == "table" and ball.velocity and ball.velocity.Y > 0 then return nil end
            end
            local lag = CONTACT_LAG + math.clamp(tonumber(ping()) or 0, 0, MAX_PING) / 2
            return predictedAt(t + lag) or (root.Position + Vector3.new(0, CONTACT_RISE, 0)), t + lag
        end
        if not grounded then return nil end
        local okL, land = Ball.landing(LANDING_OPTS)
        if not (okL and type(land) == "table" and land.position and type(land.time) == "number") or land.resting then return nil end
        if land.time > w + FALL_SLACK then return nil end
        local pos = root.Position
        local dx, dz = land.position.X - pos.X, land.position.Z - pos.Z
        if dx * dx + dz * dz > NEAR_LANDING * NEAR_LANDING then return nil end
        return Vector3.new(land.position.X, pos.Y + CHASE_RISE, land.position.Z)
    end

    local function hold()
        local root, hum = References.humanoidRootPart, References.humanoid
        if not root or hum ~= turn.humanoid then
            release()
            return
        end
        if hum.AutoRotate then
            -- the game switched it back on mid-turn (a landing), so that is what it gets once we let go
            turn.autoRotate = true
            hum.AutoRotate = false
        end
        local pos = root.Position
        -- faced along the planned direction, as a point that far off so a reader sees where it lands
        local flat = Vector3.new(pos.X + turn.dir.X * turn.dist, pos.Y, pos.Z + turn.dir.Z * turn.dist)
        if (flat - pos).Magnitude < MIN_TURN then return end
        root.CFrame = CFrame.lookAt(pos, flat)
        -- in the air i'm moving anyway, and touching the speed there would change the jump
        if hum.FloorMaterial ~= Enum.Material.Air and os.clock() - turn.startedAt <= WAKE_TIME then
            local v = root.AssemblyLinearVelocity
            if v.Y < WAKE_RISE then root.AssemblyLinearVelocity = Vector3.new(v.X, WAKE_RISE, v.Z) end
        end
    end

    -- the move is marked as playing every frame; facing and height only inside its hitbox poll, where the hit happens
    local function mark(move, now)
        seen.move, seen.at = move, now
        if now - seen.startedAt > HOLD then return end
        local root = References.humanoidRootPart
        if not root then return end
        local cf = root.CFrame
        local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
        if look.Magnitude < 1e-3 then return end
        seen.facing, seen.contactY = look.Unit, cf.Position.Y + CONTACT_RISE
        seen.lean = turn and turn.move == move and turn.leanAmount or 0
        -- a serve flies its own way, so it never teaches the spike model
        seen.behind = turn and turn.move == move and not turn.serve and turn.behind or nil
    end

    local function step()
        local okP, playing = Match.isPlaying()
        if not (okP and playing) then
            lastMove = nil
            release()
            return
        end
        local now = os.clock()
        local move = currentMove()
        local air = jumping()
        if air then airSince = airSince or now else airSince = nil end
        -- serve aim alone only ever turns me for a serve's hit
        local serveHit = serveAim and serving(References.humanoidRootPart)
        local aiming = #spots > 0 or serveHit
        if move ~= lastMove then
            lastMove = move
            if move then
                seen.serial, seen.startedAt, seen.facing = seen.serial + 1, now, nil
            end
            if move and AIM_MOVES[move] and (aiming or (turn and turn.serve)) then begin(nil, move) end
        end
        -- turned as the ball is about to arrive (in the air: once it will reach my box this jump, re-planned until the swing), held through
        -- the swing that follows; a serve is a jump serve, turned only in the air (a grounded step would carry into the jump and over the end line)
        if not move and aiming then
            local groundMove, airMove = moves()
            if serveHit then groundMove, airMove = nil, "Spike" end
            local early = air and airMove or groundMove
            -- in the air a ground turn still held is stale, and an air one is refreshed from the latest contact estimate; on the ground a
            -- bump's is planned again once the walk key moves off the one it was planned with (not during its own step, which is ours)
