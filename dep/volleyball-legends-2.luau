            Size                   = UDim2.new(1, 0, 0, 144),
            LayoutOrder            = 3,
            Parent                 = body,
        })
        New("TextLabel", {
            BackgroundTransparency = 1,
            Size                   = UDim2.new(1, 0, 0, 18),
            Font                   = Enum.Font.GothamBold,
            TextSize               = 13,
            TextColor3             = theme.Text,
            TextXAlignment         = Enum.TextXAlignment.Left,
            Text                   = tr("Description (optional)"),
            Parent                 = descBlock,
        })
        local descBox = New("TextBox", {
            Name              = "DescBox",
            Position          = UDim2.fromOffset(0, 22),
            Size              = UDim2.new(1, 0, 0, 122),
            BackgroundColor3  = theme.Row,
            BorderSizePixel   = 0,
            ClearTextOnFocus  = false,
            Text              = "",
            PlaceholderText   = tr("Anything that helps a moderator decide quickly."),
            PlaceholderColor3 = theme.TextMuted,
            TextColor3        = theme.Text,
            Font              = Enum.Font.Gotham,
            TextSize          = 13,
            TextXAlignment    = Enum.TextXAlignment.Left,
            TextYAlignment    = Enum.TextYAlignment.Top,
            TextWrapped       = true,
            MultiLine         = true,
            Parent            = descBlock,
        })
        Round(descBox, 6, theme.Outline)
        do
            local p = Pad(descBox, 10)
            p.PaddingTop    = UDim.new(0, 6)
            p.PaddingBottom = UDim.new(0, 6)
        end
        self.descBox = descBox

        local actions = New("Frame", {
            BackgroundTransparency = 1,
            Size                   = UDim2.new(1, 0, 0, 36),
            LayoutOrder            = 4,
            Parent                 = body,
        })

        local statusLabel = New("TextLabel", {
            BackgroundTransparency = 1,
            Size                   = UDim2.new(1, -240, 1, 0),
            Font                   = Enum.Font.Gotham,
            TextSize               = 12,
            TextColor3             = theme.TextMuted,
            TextXAlignment         = Enum.TextXAlignment.Left,
            TextWrapped            = true,
            Text                   = "",
            Parent                 = actions,
        })
        self.statusLabel = statusLabel

        local cancelBtn = New("TextButton", {
            Name             = "Cancel",
            AnchorPoint      = Vector2.new(1, 0.5),
            Position         = UDim2.new(1, -120, 0.5, 0),
            Size             = UDim2.fromOffset(110, 32),
            BackgroundColor3 = theme.Row,
            BorderSizePixel  = 0,
            Text             = tr("Cancel"),
            TextColor3       = theme.Text,
            Font             = Enum.Font.GothamBold,
            TextSize         = 13,
            AutoButtonColor  = false,
            Parent           = actions,
        })
        Round(cancelBtn, 6)
        Hover(cancelBtn, theme.Row, theme.RowHover)
        table.insert(self.connections, cancelBtn.Activated:Connect(function()
            self:Hide()
        end))

        local submitBtn = New("TextButton", {
            Name             = "SubmitReport",
            AnchorPoint      = Vector2.new(1, 0.5),
            Position         = UDim2.new(1, 0, 0.5, 0),
            Size             = UDim2.fromOffset(110, 32),
            BackgroundColor3 = theme.Danger,
            BorderSizePixel  = 0,
            Text             = tr("Submit"),
            TextColor3       = Color3.new(1, 1, 1),
            Font             = Enum.Font.GothamBold,
            TextSize         = 13,
            AutoButtonColor  = false,
            Parent           = actions,
        })
        Round(submitBtn, 6)
        self.submitBtn = submitBtn
        table.insert(self.connections, submitBtn.Activated:Connect(function()
            self:_submit()
        end))

        -- click-outside + Esc close, same pattern as main shell
        table.insert(self.connections, UserInputService.InputBegan:Connect(function(input, processed)
            if processed then return end
            if not self.opened then return end
            if input.KeyCode == Enum.KeyCode.Escape then
                self:Hide()
                return
            end
            local kind = input.UserInputType
            if kind ~= Enum.UserInputType.MouseButton1
                and kind ~= Enum.UserInputType.Touch
            then return end
            local p = self.panel
            if not p or not p.Parent then return end
            local pos, size = p.AbsolutePosition, p.AbsoluteSize
            local mx, my = input.Position.X, input.Position.Y
            if mx >= pos.X and mx <= pos.X + size.X
                and my >= pos.Y and my <= pos.Y + size.Y
            then return end
            self:Hide()
        end))

        if services.Unloader and services.Unloader.Register then
            services.Unloader:Register(function()
                for _, c in ipairs(self.connections) do
                    pcall(function() c:Disconnect() end)
                end
                self.connections = {}
                if self.gui then pcall(function() self.gui:Destroy() end) end
                self.gui = nil
            end)
        end
    end

    function self:_submit()
        local item = self.currentItem
        if not item then return end

        -- reason is sent in canonical english so moderation tooling sees a stable enum regardless of locale
        local reason = REASONS[self.reasonIndex] or "Other"
        local description = self.descBox and self.descBox.Text or ""

        self.submitBtn.Text = "..."
        self.submitBtn.AutoButtonColor = false
        setStatus(tr("Submitting…"), false)

        task.spawn(function()
            local ok, err = Reporter.submit({
                configId          = tostring(item.id or ""),
                configName        = item.name or "",
                game              = item.game or "",
                ownerDiscordId    = item.discord_id or "",
                reporterDiscordId = self.services.viewerDiscordId or "",
                reason            = reason,
                description       = description,
            })
            -- the request yielded, and this modal writes its gui instances directly, so UiWrite can't raise the identity for those
            Identity.elevate()
            if not ok then
                setStatus(string.format(tr("Report failed: %s"), tostring(err)), true)
                self.submitBtn.Text = tr("Submit")
                return
            end
            setStatus(tr("Reported. Thank you — moderators will review."), false)
            UiWrite.notify(Library, tr("Report submitted. Thank you."), 4)
            self.submitBtn.Text = tr("Submit")
            task.wait(1.2)
            Identity.elevate()
            self:Hide()
        end)
    end

    function self:Show(item)
        if type(item) ~= "table" then return end
        buildOnce()
        self.currentItem = item
        self.reasonIndex = 1
        applyReasonText()
        if self.descBox then self.descBox.Text = "" end
        if self.targetLabel then
            self.targetLabel.Text = string.format(
                tr("Reporting: <b>%s</b>  ·  by Discord:%s  ·  %s"),
                tostring(item.name or tr("(unnamed)")),
                tostring(item.discord_id or "?"),
                tostring(item.game or "")
            )
            self.targetLabel.RichText = true
        end
        setStatus("", false)

        self.gui.Enabled = true
        self.opened = true
        self.backdrop.BackgroundTransparency = 1
        self.panel.Size = UDim2.fromOffset(math.floor(PANEL_W * 0.96), math.floor(PANEL_H * 0.96))
        local fadeInfo = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(self.backdrop, fadeInfo, {
            BackgroundTransparency = theme.BackdropAlpha,
        }):Play()
        TweenService:Create(self.panel, fadeInfo, {
            Size = UDim2.fromOffset(PANEL_W, PANEL_H),
        }):Play()
    end

    function self:Hide()
        if not self.opened or not self.gui then return end
        self.opened = false
        local hideInfo = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        TweenService:Create(self.backdrop, hideInfo, {
            BackgroundTransparency = 1,
        }):Play()
        local panelTween = TweenService:Create(self.panel, hideInfo, {
            Size = UDim2.fromOffset(math.floor(PANEL_W * 0.96), math.floor(PANEL_H * 0.96)),
        })
        panelTween:Play()
        panelTween.Completed:Connect(function()
            if not self.opened and self.gui then
                self.gui.Enabled = false
            end
        end)
    end

    return self
end

end)
__bundle_register("Features/Configs/Tr", function(require, _LOADED, __bundle_register, __bundle_modules)
-- resolves configs ui strings against Features/Configs/Translations; en, missing locale, or missing key falls back to the source string

local Translations   = require("Features/Configs/Translations")
local LanguagePicker = require("Auth/LanguagePicker")

local M = {}

local function currentLocale()
    local loc = LanguagePicker.read() or "en"
    return (loc:lower():match("^([a-z]+)")) or "en"
end

function M.tr(s)
    if type(s) ~= "string" or s == "" then return s end
    local locale = currentLocale()
    if locale == "en" then return s end
    local t = Translations[locale]
    if not t then return s end
    return t[s] or s
end

return M

end)
