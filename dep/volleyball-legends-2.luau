__bundle_register("Utility/Debug", function(require, _LOADED, __bundle_register, __bundle_modules)
-- wires EventBuffer + LoadingScreen + CrashReport into the historical Debugger API so call sites stay unchanged
local EventBuffer   = require("Utility/EventBuffer")
local LoadingScreen = require("UI/LoadingScreen")
local CrashReport   = require("Utility/CrashReport")
local Identity      = require("Utility/Identity")
local Log           = require("Utility/Log")

return function(ctx)
    local buffer  = EventBuffer.new(160)
    -- tier comes from pre-boot, so the loader is already dressed the first frame it draws
    local loading = LoadingScreen.new(ctx.Tier)
    local crash   = CrashReport.new({
        ScriptVersion = ctx.ScriptVersion or "unknown",
        Services      = ctx.Services,
        References    = ctx.References,
        StartTime     = tick(),
        buffer        = buffer,
    })

    local Debugger = {}

    -- a module's game-api calls can leave the boot thread below the identity a gui write needs ("lacking capability Plugin"), so every loader write raises it first
    local function onLoader(method, ...)
        Identity.elevate()
        return loading[method](loading, ...)
    end

    -- never throws: LoadModule logs outside its xpcall, so a refused write here escaped mountAll and skipped every later tab and the rest of the boot
    function Debugger:Log(stage, message)
        local stageText = tostring(stage or "INFO")
        local rawMsg    = tostring(message or "")
        buffer:push(stageText, rawMsg)
        pcall(onLoader, "notifyStep", stageText, rawMsg)
    end

    function Debugger:ShowLoading(_message)
        onLoader("show")
    end

    function Debugger:HideLoading(onComplete)
        onLoader("hide", onComplete)
    end

    function Debugger:FinalizeLoading(_message, onComplete)
        onLoader("finalize", onComplete)
    end

    -- translation-phase pass-throughs used by Cerberus.lua between mountAll and FinalizeLoading
    function Debugger:FreezeBootProgress() onLoader("freezeBootProgress") end
    function Debugger:SetLoadingStatus(text) onLoader("setStatus", text) end
    function Debugger:SetLoadingSubtitle(text) onLoader("setSubtitle", text) end
    function Debugger:SetLoadingProgress(ratio) onLoader("setProgress", ratio) end
    function Debugger:AddLoaderSkipButton(label, onClick)
        return onLoader("addSkipButton", label, onClick)
    end

    function Debugger:BuildCrashReport(label, err)
        return crash:build(label, err)
    end

    function Debugger:ShowCrashGui(reportText)
        crash:show(reportText)
    end

    function Debugger:HandleCrash(label, err)
        pcall(onLoader, "hide")
        local report = crash:build(label, err)
        Log.warn("[Cerberus/Crash]\n" .. report)
        crash:show(report)
        return report
    end

    local function xpcallTraceback(e)
        return debug.traceback(tostring(e), 2)
    end

    function Debugger:Try(label, fn)
        self:Log("STEP", "Begin " .. tostring(label))
        local out = table.pack(xpcall(fn, xpcallTraceback))
        if out[1] == true then
            self:Log("STEP", "Completed " .. tostring(label))
            return true, table.unpack(out, 2, out.n)
        end
        self:Log("ERROR", tostring(label) .. " failed")
        self:HandleCrash(label, out[2])
        return false, out[2]
    end

    function Debugger:RunOrThrow(label, fn)
        self:Log("STEP", "Begin " .. tostring(label))
        local out = table.pack(xpcall(fn, xpcallTraceback))
        if out[1] == true then
            self:Log("STEP", "Completed " .. tostring(label))
            return table.unpack(out, 2, out.n)
        end
        error(string.format("[%s] %s", tostring(label), tostring(out[2])), 0)
    end

    function Debugger:LoadModule(moduleName, fn)
        local label = string.format("Module %s", tostring(moduleName))
        self:Log("STEP", "Begin " .. label)
        -- the tab before may have dropped the identity, and this tab's first Add* would throw on it
        Identity.elevate()
        local out = table.pack(xpcall(fn, xpcallTraceback))
        if out[1] == true then
            self:Log("STEP", "Completed " .. label)
            return table.unpack(out, 2, out.n)
        end
        local errMsg = tostring(out[2])
        self:Log("WARN", label .. " failed to load (skipping): " .. errMsg)
        Log.warn(string.format("[Cerberus] %s failed to load — continuing without it: %s", label, errMsg))
        return nil
    end

    return Debugger
end

end)
__bundle_register("Utility/CrashReport", function(require, _LOADED, __bundle_register, __bundle_modules)
-- crash report builder + copyable GUI: collapsed stack, module timeline, recent events, copy buttons
local Services    = require("Services")
local EventBuffer = require("Utility/EventBuffer")
local Log         = require("Utility/Log")
local UiHost      = require("UI/UiHost")

local TweenService = Services.TweenService
local Lighting     = Services.Lighting
local Game         = Services.Game

local SupportLink = "https://discord.gg/cerberus"

local Theme = {
    Panel   = Color3.fromRGB(20, 20, 24),
    Error   = Color3.fromRGB(255, 80, 80),
}

local function trim(s, maxLen)
    s = tostring(s or "")
    if #s <= maxLen then return s end
    return s:sub(1, maxLen - 3) .. "..."
end

local function splitLines(s)
    local lines = {}
    s = tostring(s or "")
    for line in (s .. "\n"):gmatch("([^\n]*)\n") do
        lines[#lines + 1] = line
    end
    return lines
end

local function normalizeWhitespace(s)
    return tostring(s or ""):gsub("^%s+", ""):gsub("%s+$", "")
end

local function extractModuleFromError(errText)
    return tostring(errText or ""):match("%[Module%s+([^%]]+)%]")
end

local function extractTopFrame(errText)
    for _, line in ipairs(splitLines(errText)) do
        local frame = line:match("^(script%s+[^:]+:%d+)")
        if frame then return frame end
    end
    return nil
end

local function buildCollapsedStack(errText)
    local out, seen = {}, {}
    for _, line in ipairs(splitLines(errText)) do
        local clean = normalizeWhitespace(line)
        if clean ~= "" and not seen[clean] then
            seen[clean] = true
            out[#out + 1] = clean
        end
    end
    return out
end

local function moduleTimeline(events)
    local out = {}
    for _, eventLine in ipairs(events or {}) do
        local ev = tostring(eventLine)
        if ev:find("[STEP] Begin Module ", 1, true) or ev:find("[STEP] Completed Module ", 1, true) then
            out[#out + 1] = ev
        end
    end
    return out
end

local function buildHints(label, errText, topFrame, moduleName)
    local hints = {}
    hints[#hints + 1] = "Keep and share the full report, including Recent Debug Events."

    if moduleName then
        hints[#hints + 1] = ("Failure appears inside '%s'. Check ctx fields and recent edits in that module."):format(moduleName)
    end
    if topFrame then
        hints[#hints + 1] = ("Top stack frame: %s"):format(topFrame)
    end
    if tostring(errText):find("attempt to call a nil value", 1, true) then
        hints[#hints + 1] = "Likely nil-call: verify renamed callbacks/functions and missing injections in module context."
    end
    if tostring(errText):find("attempt to index a nil value", 1, true) then
        hints[#hints + 1] = "Nil-index: a required field on ctx (or a sub-table) is missing at the point of use."
    end
    if tostring(label):find("Bootstrap", 1, true) then
