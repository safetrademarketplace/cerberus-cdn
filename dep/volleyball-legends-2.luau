-- ball esp group: registers a Ball group on the shared esp engine whose source is every live Ball-tagged model, so the esp tab grows a Ball box; call it before the esp menu builds
local Groups = require("Api/Esp/Groups")

local ACCENT = Color3.fromRGB(255, 140, 0)

-- the ball is destroyed and recreated every point, so a tagged model only counts while it is in the world with a PrimaryPart to anchor on
local function isLive(model)
    return model.Parent ~= nil and model.PrimaryPart ~= nil
end

return function(Engine, Services)
    if type(Engine) ~= "table" or type(Engine.RegisterGroup) ~= "function" then return false end
    local CollectionService = Services and Services.CollectionService
    if not CollectionService then return false end

    local config = Groups.defaultConfig(ACCENT)
    config.enabled = false
    config.health.bar = false
    config.health.text = false
    config.skeleton.enabled = false

    local function source()
        local out = {}
        local ok, tagged = pcall(CollectionService.GetTagged, CollectionService, "Ball")
        if not ok or type(tagged) ~= "table" then return out end
        for _, model in ipairs(tagged) do
            local okLive, live = pcall(isLive, model)
            if okLive and live then out[#out + 1] = { instance = model, kind = "entity", label = "Ball" } end
        end
        return out
    end

    return Engine.RegisterGroup({ key = "Ball", label = "Ball", config = config, source = source }) == true
end

