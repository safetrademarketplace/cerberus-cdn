__bundle_register("Utility/Helpers/Http", function(require, _LOADED, __bundle_register, __bundle_modules)
-- the one egress point: resolves whichever executor http client exists and paces per host, so retry policy, 429 backoff and the egress log live in exactly one place

local Services = require("Services")
local Executor = require("Utility/Executor")
local Jobs     = require("Utility/Jobs")
local Log      = require("Utility/Log")

local HttpService = Services.HttpService
local Game        = Services.Game

-- ordered by how specific the name is, so a wrapper executor's own client wins over a generic alias
local CLIENTS = {
    "syn.request", "http.request", "http_request", "request",
    "fluxus.request", "krnl.request",
}

-- backoff schedule shared by every retrying caller; a timeout is the common case, so the first wait is generous enough to outlast a blip
local RETRY_ATTEMPTS = 3
local RETRY_BACKOFF  = 1
local RETRY_FACTOR   = 2
local RETRY_CEILING  = 8

-- minimum seconds between requests to a host; discord's webhook bucket is roughly one per second sustained
local HOST_GAP = {
    ["discord.com"] = 0.5,
}

local M = {}

local nextAllowed = {}   -- host -> os.clock() before which no request may leave

local function hostOf(url)
    return tostring(url or ""):match("^%w+://([^/]+)") or "?"
end

local function readStatus(res)
    return tonumber(res.StatusCode or res.Status or res.status_code) or 0
end

local function readBody(res)
    local body = res.Body or res.body
    return type(body) == "string" and body or nil
end

local function readHeader(res, name)
    local headers = res and (res.Headers or res.headers)
    if type(headers) ~= "table" then return nil end
    for k, v in pairs(headers) do
        if tostring(k):lower() == name then return v end
    end
    return nil
end

-- lets a fork widen or relax pacing for its own backend without touching call sites
function M.setHostGap(host, seconds)
    HOST_GAP[tostring(host)] = tonumber(seconds) or nil
end

-- returns the raw request function (options table -> response table) or nil
function M.client()
    for _, name in ipairs(CLIENTS) do
        local fn = Executor.get(name)
        if type(fn) == "function" then return fn end
    end
    return nil
end

-- returns (ok, response|err); callers decide whether to decode the body
function M.request(opts)
    local req = M.client()
    if type(req) ~= "function" then return false, "no http client" end

    local host = hostOf(opts and opts.Url)

    -- honour the hold unconditionally: gating on HOST_GAP would let an unconfigured host record a 429 backoff and then ignore it
    local wait = (nextAllowed[host] or 0) - os.clock()
    if wait > 0 then task.wait(wait) end

    local ok, res = pcall(req, opts)

    -- paced from completion, not from dispatch, so a slow response doesn't stack the next one on top
    local gap = HOST_GAP[host]
    if gap then nextAllowed[host] = os.clock() + gap end

    -- a 429 tells us how long to hold off; it outranks the standing gap
    if ok and type(res) == "table" and readStatus(res) == 429 then
        local retryAfter = tonumber(readHeader(res, "retry-after")) or 1
        nextAllowed[host] = os.clock() + retryAfter
    end

    Log.dev("Http", "%s %s -> %s", tostring(opts and opts.Method or "GET"), host,
        ok and tostring(type(res) == "table" and readStatus(res) or "?") or "transport error")
    return ok, res
end

-- a timeout surfaces as a transport failure, not a status; those, plus 408/429 and 5xx, are worth another attempt, and every other status is the server's final answer
function M.isTransient(ok, res)
    if not ok or type(res) ~= "table" then return true end
    local status = readStatus(res)
    if status == 0 or status == 408 or status == 429 then return true end
    return status >= 500
end

-- cfg = { attempts, backoff, factor, ceiling, onRetry = fn(attempt, res) }; every field is optional
local function backoffLoop(cfg, attempt_fn)
    cfg = cfg or {}
    local attempts = cfg.attempts or RETRY_ATTEMPTS
    local delay    = cfg.backoff or RETRY_BACKOFF
    local factor   = cfg.factor or RETRY_FACTOR
    local ceiling  = cfg.ceiling or RETRY_CEILING

    local a, b, c
    for attempt = 1, attempts do
        local settled
        settled, a, b, c = attempt_fn(attempt)
        if settled then return a, b, c end
        if attempt < attempts then
            if cfg.onRetry then pcall(cfg.onRetry, attempt, a) end
            task.wait(delay)
            delay = math.min(delay * factor, ceiling)
        end
    end
    return a, b, c
end

-- retries a request through transient failures; returns (ok, response) exactly like request()
function M.retry(opts, cfg)
    return backoffLoop(cfg, function()
        local ok, res = M.request(opts)
        return not M.isTransient(ok, res), ok, res
    end)
end

-- raw GET body via game:HttpGet, falling back to the request client for executors that sandbox HttpGet away from non-roblox hosts; pass cfg to retry transient failures
function M.getBody(url, cfg)
    local function once()
        local okFetch, raw = pcall(function()
            return Game:HttpGet(url)
        end)
        if okFetch and type(raw) == "string" and raw ~= "" then return raw end

        local okReq, res = M.request({ Url = url, Method = "GET" })
        if not okReq or type(res) ~= "table" then
            return nil, ("fetch failed: %s"):format(tostring(okFetch and "empty body" or raw))
        end

        local status = readStatus(res)
        local body   = readBody(res)
        if status >= 200 and status < 300 and body and body ~= "" then return body end
        return nil, ("http %d"):format(status)
    end

    if not cfg then return once() end
    return backoffLoop(cfg, function()
        local body, err = once()
        return body ~= nil, body, err
    end)
end

-- fire-and-forget retrying GET; done(body, err) runs on the worker thread, never on the caller's
function M.getBodyAsync(url, done, cfg)
    return Jobs.spawn(function()
        local body, err = M.getBody(url, cfg or {})
        if done then pcall(done, body, err) end
    end, { name = "HttpGet:" .. hostOf(url) })
end

-- encode, send with retry, classify, decode; opts = { url, method, body, headers, retry = cfg|false }, returns (data, err, status, decoded) with status 0 for a transport failure
function M.json(opts)
    opts = opts or {}
    local method  = (opts.method or "GET"):upper()
    local headers = { ["Content-Type"] = "application/json" }
    if type(opts.headers) == "table" then
        for k, v in pairs(opts.headers) do headers[k] = v end
    end

    local encoded
    if opts.body ~= nil then
        local okEncode, body = pcall(HttpService.JSONEncode, HttpService, opts.body)
        if not okEncode or type(body) ~= "string" then return nil, "encode failed", 0, nil end
        encoded = body
    end

    local reqOpts = { Url = opts.url, Method = method, Headers = headers, Body = encoded }

    -- only idempotent verbs retry: replaying a POST could double-submit a config or a webhook
    local retryable = opts.retry ~= false and (method == "GET" or method == "HEAD" or opts.retry)
    local ok, res
    if retryable then
        ok, res = M.retry(reqOpts, type(opts.retry) == "table" and opts.retry or nil)
    else
        ok, res = M.request(reqOpts)
    end

    if not ok or type(res) ~= "table" then
        return nil, "request failed: " .. tostring(res), 0, nil
    end

    local status = readStatus(res)
    local raw    = readBody(res) or ""

    local decoded
    if raw ~= "" then
        local okDecode, value = pcall(HttpService.JSONDecode, HttpService, raw)
        if okDecode then decoded = value end
    end

    if status >= 200 and status < 300 then
        if raw ~= "" and decoded == nil then return nil, "decode failed", status, nil end
        return decoded or {}, nil, status, decoded
    end

    local message
