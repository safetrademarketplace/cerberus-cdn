__bundle_register("Features/Fun/CustomCursor/Render", function(require, _LOADED, __bundle_register, __bundle_modules)
-- cursor renderer: ScreenGui + line/dot frames, ShowCustomCursor cooperation, and the per-frame position loop
local Identity  = require("Utility/Identity")
local Jobs      = require("Utility/Jobs")
local Scheduler = require("Utility/Scheduler")
local UiHost    = require("UI/UiHost")

return function(env)
    local Services   = env.Services
    local Library    = env.Library
    local References = env.References
    local track      = env.track

    -- capture pre-existing Library state for cleanup; explicit nil check so a valid false doesn't collapse via or-fallback
    local originalShowCustomCursor
    if Library then originalShowCustomCursor = Library.ShowCustomCursor end

    local destroyed = false

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name             = "_Cursor"
    screenGui.IgnoreGuiInset   = true
    screenGui.ZIndexBehavior   = Enum.ZIndexBehavior.Global
    screenGui.DisplayOrder     = 2147483647
    screenGui.ResetOnSpawn     = false
    screenGui.Parent           = UiHost.pick()

    local TOP_Z = 2147483647

    local function newLine()
        local f = Instance.new("Frame")
        f.BorderSizePixel       = 0
        f.AnchorPoint           = Vector2.new(0.5, 0.5)
        f.BackgroundColor3      = Color3.new(1, 1, 1)
        f.BackgroundTransparency = 0
        f.ZIndex                = TOP_Z
        f.Parent                = screenGui
        local s = Instance.new("UIStroke")
        s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        s.Parent          = f
        return f, s
    end

    local function newDot()
        local f = Instance.new("Frame")
        f.BorderSizePixel  = 0
        f.AnchorPoint      = Vector2.new(0.5, 0.5)
        f.BackgroundColor3 = Color3.new(1, 1, 1)
        f.ZIndex           = TOP_Z
        local corner = Instance.new("UICorner", f)
        corner.CornerRadius = UDim.new(1, 0)
        f.Parent = screenGui
        local s = Instance.new("UIStroke")
        s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        s.Parent          = f
        return f, s
    end

    local LINES = {}
    local DOT     = { newDot() }
    local DOTONLY = { newDot() }

    local function ensureLineCount(n)
        n = math.clamp(n, 2, 24)
        for i = #LINES + 1, n do
            LINES[i] = { newLine() }
        end
        for i = #LINES, n + 1, -1 do
            LINES[i][1]:Destroy()
            LINES[i] = nil
        end
    end

    -- zero out obsidian's own ShowCustomCursor crosshair frame once so it can't visually double our cursor
    local obsidianCursorNeutered = false
    local function neutralizeObsidianCursor()
        if obsidianCursorNeutered then return end
        if not (Library and Library.ScreenGui) then return end
        for _, d in ipairs(Library.ScreenGui:GetDescendants()) do
            if d:IsA("Frame") and d.ZIndex == 999 and d.Size == UDim2.fromOffset(9, 1) then
                pcall(function()
                    d.Size = UDim2.fromOffset(0, 0)
                    d.BackgroundTransparency = 1
                    for _, c in ipairs(d:GetDescendants()) do
                        if c:IsA("Frame") then c.BackgroundTransparency = 1 end
                    end
                end)
                obsidianCursorNeutered = true
                break
            end
        end
    end

    -- 4 Hz one-shot poller (5 s cap): the GetDescendants scan halved frame rate when it rode RenderStepped, so it lives off the hot loop
    local cursorPollerStarted = false
    local function ensureObsidianPoller()
        if cursorPollerStarted or obsidianCursorNeutered then return end
        cursorPollerStarted = true
        local deadline = os.clock() + 5
        track(Jobs.interval(0.25, function(job)
            if destroyed or obsidianCursorNeutered or os.clock() >= deadline then
                job:Cancel()
                return
            end
            Identity.elevate()
            neutralizeObsidianCursor()
        end, { name = "CursorNeuterPoll", immediate = true }))
    end

    -- ShowCustomCursor=true has obsidian write MouseIconEnabled=false each frame; we also write it directly since the Library's render step isn't bound while closed
    local lastHidden = nil
    local function applyCursorVisibility(hide)
        if destroyed then return end
        if hide then
            neutralizeObsidianCursor()
            -- if the first scan missed, the async poller retries off RenderStepped
            ensureObsidianPoller()
            if lastHidden ~= true then
                lastHidden = true
                pcall(function()
                    if Library and Library.ShowCustomCursor ~= nil then
                        Library.ShowCustomCursor = true
                    end
                end)
                pcall(function() Services.UserInputService.MouseIconEnabled = false end)
                pcall(function()
                    local m = References.player:GetMouse()
                    if m then m.Icon = "" end
                end)
            end
        else
            if lastHidden ~= false then
                lastHidden = false
                pcall(function()
                    if Library and Library.ShowCustomCursor ~= nil then
                        Library.ShowCustomCursor = originalShowCustomCursor == true
                    end
                end)
                pcall(function() Services.UserInputService.MouseIconEnabled = true end)
            end
        end
    end

    local function apply(P, enabled)
        if destroyed then return end
        applyCursorVisibility(enabled)
        if not P then return end

        if P.type == "crosshair" then
            ensureLineCount(math.clamp(P.lineCount or 4, 2, 24))
            for i = 1, #LINES do
                local f, s = LINES[i][1], LINES[i][2]
                f.BackgroundColor3 = P.color
                f.Size             = UDim2.fromOffset(math.max(1, P.thickness or 2), math.max(2, P.length or 18))
                s.Thickness        = (P.outline and math.max(0, P.outlineThickness or 0)) or 0
                s.Color            = P.outlineColor or Color3.new(0, 0, 0)
                f.Visible          = enabled
            end
            DOT[1].BackgroundColor3 = P.color
            DOT[1].Size             = UDim2.fromOffset(math.max(1, P.dotSize or 2), math.max(1, P.dotSize or 2))
            DOT[2].Thickness        = (P.outline and math.max(0, P.outlineThickness or 0)) or 0
            DOT[2].Color            = P.outlineColor or Color3.new(0, 0, 0)
            DOT[1].Visible          = enabled and (P.centerDot == true)
            DOTONLY[1].Visible      = false
        else
            DOTONLY[1].BackgroundColor3 = P.color
            DOTONLY[1].Size             = UDim2.fromOffset(math.max(1, P.size or 10), math.max(1, P.size or 10))
            DOTONLY[2].Thickness        = (P.outline and math.max(0, P.outlineThickness or 0)) or 0
            DOTONLY[2].Color            = P.outlineColor or Color3.new(0, 0, 0)
            DOTONLY[1].Visible          = enabled
            for _, pair in ipairs(LINES) do
                pair[1].Visible = false
            end
            DOT[1].Visible = false
        end
    end

    -- per-frame position update; state = { getProps, isEnabled, getNudge } callbacks
    local function bindLoop(state)
        track(Scheduler.render(function()
            if destroyed or not state.isEnabled() then return end

            -- every wake, because a scheduler callback can run below the identity a write under the ui root needs
            Identity.elevate()

            -- re-assert cursor-hidden every frame: at boot there's a window before Library:Toggle binds where the game can re-enable MouseIconEnabled (the "double cursor" bug); both checks are cheap reads
            if Services.UserInputService.MouseIconEnabled then
                Services.UserInputService.MouseIconEnabled = false
            end
            if Library and Library.ShowCustomCursor == false then
                Library.ShowCustomCursor = true
            end

            local P = state.getProps()
            if not P then return end
            local nx, ny = state.getNudge()
            local ml = Services.UserInputService:GetMouseLocation()
            local mx, my = ml.X + (nx or 0), ml.Y + (ny or 0)
            if P.type == "crosshair" then
                local thick = math.max(1, P.thickness or 2)
                local len   = math.max(2, P.length or 18)
                local gap   = math.max(0, P.gap or 8)
                local lines = math.clamp(P.lineCount or 4, 2, 24)
                local offset = gap + (len / 2)
                local step   = 360 / lines
                for i = 1, lines do
                    local f = LINES[i][1]
                    local angle = (i - 1) * step
                    local rad   = math.rad(angle)
                    f.Position = UDim2.fromOffset(mx + math.cos(rad) * offset, my + math.sin(rad) * offset)
                    f.Size     = UDim2.fromOffset(thick, len)
                    f.Rotation = angle
                end
                DOT[1].Position = UDim2.fromOffset(mx, my)
            else
                DOTONLY[1].Position = UDim2.fromOffset(mx, my)
            end
        end, { name = "CustomCursor", priority = 200 }))
    end

    local function destroy()
        if destroyed then return end
        destroyed = true
        if screenGui then
            pcall(function() screenGui:Destroy() end)
            screenGui = nil
        end
        LINES, DOT, DOTONLY = {}, {}, {}
        pcall(function()
            if Library and originalShowCustomCursor ~= nil then
                Library.ShowCustomCursor = originalShowCustomCursor
            end
        end)
        pcall(function()
            local m = References.player:GetMouse()
            if m then m.Icon = "" end
        end)
        -- obsidian's self-unbinding render step restores MouseIconEnabled to a stale false; re-restore on defer + short delay so the OS cursor returns regardless of teardown order
        local function restoreMouseIcon()
            pcall(function() Services.UserInputService.MouseIconEnabled = true end)
        end
        restoreMouseIcon()
        task.defer(restoreMouseIcon)
        -- leak:allow — completes a teardown; cancelling it at unload would leave the cursor hidden
        task.delay(0.2, restoreMouseIcon)
    end

    return {
        apply        = apply,
        bindLoop     = bindLoop,
        destroy      = destroy,
        isDestroyed  = function() return destroyed end,
        resetHidden  = function() lastHidden = nil end,
    }
end

end)
__bundle_register("Features/Fun/CustomCursor/Storage", function(require, _LOADED, __bundle_register, __bundle_modules)
-- load/save cursor_builder.json, falling back to (and re-writing) a clone of Presets.DEFAULTS when missing or corrupt

local Store   = require("Utility/Store")
local Presets = require("Features/Fun/CustomCursor/Presets")

local M = {}

local KEY = "cursor_builder"

-- intentionally shallow clone — entries still share references with Presets.DEFAULTS; deep-cloning would change observable behavior
local function freshDefaults()
    local cfg = table.clone(Presets.DEFAULTS)
    for _, entry in ipairs(cfg.entries) do
        entry.locked = false
    end
    return cfg
end

function M.load()
    local cfg = Store.read(Store.GLOBAL, KEY)
    if type(cfg) == "table" and type(cfg.entries) == "table" then
        cfg.enabled  = cfg.enabled == true
        cfg.selected = tostring(cfg.selected or Presets.DEFAULTS.selected)
        cfg.settings = cfg.settings or table.clone(Presets.DEFAULTS.settings)
        cfg.settings.xNudge = tonumber(cfg.settings.xNudge) or 0
        cfg.settings.yNudge = tonumber(cfg.settings.yNudge) or 0
        for _, entry in ipairs(cfg.entries) do
            if type(entry) == "table" then
                entry.locked = false
            end
        end
        return cfg
    end

    local fresh = freshDefaults()
    M.save(fresh)
    return fresh
end

function M.save(cfg)
    Store.write(Store.GLOBAL, KEY, cfg)
end

M.freshDefaults = freshDefaults

return M

end)
__bundle_register("Utility/Store", function(require, _LOADED, __bundle_register, __bundle_modules)
-- namespaced json persistence: one path builder, one folder-ensure, one encode/decode, so a feature never hand-rolls the readfile/writefile/pcall dance again

local Services   = require("Services")
local References = require("References")
local Fs         = require("Utility/Helpers/Fs")
local Log        = require("Utility/Log")

local HttpService = Services.HttpService

local ROOT = "Cerberus"

local M = {}

-- a fork's Meta game name is arbitrary ("Bleach: VV"), and executors reject makefolder/writefile on reserved punctuation, so anything outside this set becomes "_"
local function sanitize(segment)
    segment = tostring(segment or "")
    segment = segment:gsub("[^%w%-_ %.]", "_")
    segment = segment:gsub("^%s+", ""):gsub("%s+$", "")
    return segment
end

M.GLOBAL = ""
M.GAME   = sanitize(References.gameName)

-- creates each segment in turn: makefolder fails on a nested path whose parent doesn't exist yet
local function ensureFolder(dir)
    if not (isfolder and makefolder) then return false end
    if isfolder(dir) then return true end
    local accum = nil
    for segment in dir:gmatch("[^/]+") do
        accum = accum and (accum .. "/" .. segment) or segment
        if not isfolder(accum) then
            local ok = pcall(makefolder, accum)
            if not ok then
                Log.devwarn("Store", "makefolder failed for %s", accum)
                return false
            end
        end
    end
    return true
end

-- a namespace may nest ("Universal/settings"); each segment is sanitized, the separators survive
local function folderOf(namespace)
    local dir = ROOT
    for segment in tostring(namespace or ""):gmatch("[^/]+") do
        local clean = sanitize(segment)
        if clean ~= "" then dir = dir .. "/" .. clean end
    end
    return dir
end

function M.path(namespace, key)
    return folderOf(namespace) .. "/" .. sanitize(key) .. ".json"
end

function M.exists(namespace, key)
    return type(isfile) == "function" and isfile(M.path(namespace, key)) == true
end

-- reads the raw file body; nil when absent or unreadable, so a caller can tell empty from missing
function M.readRaw(namespace, key)
    local file = M.path(namespace, key)
    if type(isfile) ~= "function" or type(readfile) ~= "function" then return nil end
    if not isfile(file) then return nil end
    local ok, body = pcall(readfile, file)
    if not ok or type(body) ~= "string" then
        Log.devwarn("Store", "readfile failed for %s", file)
        return nil
    end
    return body
end

function M.writeRaw(namespace, key, body)
    if not ensureFolder(folderOf(namespace)) then return false, "no folder" end
    return Fs.safeWrite(M.path(namespace, key), body, "Store")
end

-- `default` covers missing and corrupt alike: a half-written json file should degrade to first-run rather than throw
function M.read(namespace, key, default)
    local body = M.readRaw(namespace, key)
    if not body or body == "" then return default end
    local ok, value = pcall(HttpService.JSONDecode, HttpService, body)
    if not ok then
        Log.devwarn("Store", "corrupt json at %s, using default", M.path(namespace, key))
        return default
    end
    return value
end

function M.write(namespace, key, value)
    local ok, body = pcall(HttpService.JSONEncode, HttpService, value)
    if not ok or type(body) ~= "string" then
        Log.devwarn("Store", "encode failed for %s", M.path(namespace, key))
        return false, "encode failed"
    end
    return M.writeRaw(namespace, key, body)
end

function M.delete(namespace, key)
    local file = M.path(namespace, key)
    if type(isfile) ~= "function" or not isfile(file) then return true end
    if type(delfile) ~= "function" then return false end
    return (pcall(delfile, file))
end

-- key names (no directory, no .json) of every entry in the namespace
function M.list(namespace)
    local out = {}
    local dir = folderOf(namespace)
    if not (type(listfiles) == "function" and type(isfolder) == "function") then return out end
    if not isfolder(dir) then return out end
    local ok, entries = pcall(listfiles, dir)
    if not ok or type(entries) ~= "table" then return out end
    for _, full in ipairs(entries) do
        local name = tostring(full):match("([^/\\]+)%.json$")
        if name then out[#out + 1] = name end
    end
    table.sort(out)
    return out
end

return M

end)
