    local watch, watchSlot

    local function makeWrapper(base)
        local wrapper
        wrapper = function(...)
            local entry = base(...)
            -- a wrapper that is no longer the live one passes straight through, so a stale one can never scale twice
            if wrapper ~= live or factor == 1 or type(entry) ~= "table" then return entry end
            return scaledCopy(entry, factor)
        end
        OWN[wrapper] = base
        return wrapper
    end

    local function release()
        if target and live and target.get == live then
            local ok, err = pcall(function() target.get = original end)
            if not ok then Log.devwarn("Assist", "could not restore the hitbox lookup: %s", tostring(err)) end
        end
        target, original, live = nil, nil, nil
    end

    local function ensure()
        if factor == 1 then
            release()
            return
        end
