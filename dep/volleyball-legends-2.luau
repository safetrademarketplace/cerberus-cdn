    if type(lrm) ~= "table" then return nil end
    local v = lrm.LRM_LinkedDiscordID
    if type(v) == "number" then v = tostring(v) end
    if type(v) ~= "string" or v == "" then return nil end
    if DISCORD_PLACEHOLDERS[v:lower()] then return nil end
