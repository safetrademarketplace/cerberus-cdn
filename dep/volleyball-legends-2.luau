    local approachId
    local owned = false
    local recv, dive, block, spike = {}, {}, {}, {}
    local serve = {}
    local jumping, swungThisJump = false, false
    local mates = { at = -math.huge }

    local function on(id)
        local t = Toggles[id]
        return t ~= nil and t.Value == true
    end

    local function value(id, default)
        local o = Options[id]
        if o == nil or o.Value == nil then return default end
        return o.Value
    end

    local function readWants()
        local w = {
            hit   = on("VL_AutoHit"),
            chase = on("VL_ChaseBall"),
            dive  = on("VL_AutoDive"),
            serve = on("VL_AutoServe"),
            spike = on("VL_AutoSpike"),
            block = on("VL_AutoBlock"),
        }
        w.any = w.hit or w.chase or w.dive or w.serve or w.spike or w.block
        return w
    end

    local function ready(now)
        return now - lastActionAt >= ACTION_COOLDOWN
    end

    local function acted(now, what, fmt, ...)
        lastActionAt = now
        Log.dev("AutoPlay", "%s " .. fmt, what, ...)
    end

    -- grounded, not mid-move, not stunned and off cooldown
    local function free(v)
        local st = v.st
        return not st.IsBusy and not st.IsStunned and not st.IsJumping and ready(v.now)
    end

    -- latches are only ever written while a ball is tracked, so with no approach they are already clean
    local function resetApproach(id)
        if id == nil and approachId == nil then return end
        approachId = id
        owned = false
        recv, dive, block, spike = {}, {}, {}, {}
    end

    -- idle: hand movement back and forget every approach, once per idle stretch
    local stopped = true
    local function stop()
        if stopped then return end
        stopped = true
        local hum = References.humanoid
        local root = References.humanoidRootPart
        local okP, rootPos = pcall(function() return root and root.Position end)
        steer:release(hum, okP and rootPos or nil)
        resetApproach(nil)
        serve = {}
        mates = { at = -math.huge }
        jumping, swungThisJump = false, false
    end

    -- the game's own hitbox for a move with my style's special, read fresh every time so a scaled hit range is honoured
    local function hitbox(move)
        local ok, hb = Actions.hitbox(move)
        if not ok or type(hb) ~= "table" or hb.Offset == nil or hb.Size == nil then return nil end
        return hb
    end

    -- (true, seconds or nil) until the ball reaches a move's hitbox at my current pose; false when it can't be asked
    local function timeToBox(v, move, horizon)
        local hb = hitbox(move)
        if not hb then return false end
        local ok, t = Ball.timeIntoBox(v.root.CFrame * hb.Offset, hb.Size, { horizon = horizon, samples = 2 })
        if not ok then return false end
        return true, t
    end

    -- when to swing for a clean contact: as the ball reaches the high middle of my box, or, when its path only clips the box, as it reaches the edge;
    -- returns (true, seconds or nil, lead to swing at) or false when it can't be asked
    local function swingTime(v, move, timing)
        local hb = hitbox(move)
        if not hb then return false end
        local cf = v.root.CFrame * hb.Offset
        local zoneCf, zone = Contact.zone(cf, hb.Size)
        -- in the air my box rides the jump, so a ball met on the way up isn't read late
        local boxV, boxA
        if v.st.IsJumping then
            local okV, vel = pcall(function() return v.root.AssemblyLinearVelocity end)
            local okG, g = pcall(function() return Services.Workspace.Gravity end)
            if okV then boxV, boxA = Contact.motion(vel, (okG and type(g) == "number") and g or DEFAULT_GRAVITY, true) end
        end
        local okC, tc = Ball.timeIntoBox(zoneCf, zone, {
            horizon = CORE_LEAD + timing + SCAN_PAD, samples = 2, boxVelocity = boxV, boxAccel = boxA,
        })
        if not okC then return false end
        if tc ~= nil then return true, tc, math.max(0, CORE_LEAD + timing) end
        local ok, t = Ball.timeIntoBox(cf, hb.Size, { horizon = v.swingLead + SCAN_PAD, samples = 2, boxVelocity = boxV, boxAccel = boxA })
        if not ok then return false end
        return true, t, v.swingLead
    end

    local function jumpModel()
        local okG, g = pcall(function() return Services.Workspace.Gravity end)
        local gravity = (okG and type(g) == "number" and g > 0) and g or DEFAULT_GRAVITY
        local okM, mult = pcall(function() return References.player:GetAttribute(JUMP_ATTR) end)
        return Plan.jump(gravity, JUMP_LAUNCH * ((okM and type(mult) == "number") and mult or 1))
    end

    -- hardcore refuses a back-row jump in front of the attack line
    local function hardcoreBackRow(v)
        if not v.hardcore then return false end
        local ok, pos = Match.myPosition()
        return ok and type(pos) == "table" and pos.backRow == true
    end

    local function teammates(now)
        if mates.list and now - mates.at < TEAMMATE_REFRESH then return mates.list end
        local ok, list = Match.teammates()
        if not ok or type(list) ~= "table" then return NO_MATES end
        local out = { roots = {}, names = {}, count = 0 }
        for _, entry in ipairs(list) do
            out.count = out.count + 1
            if entry.name then out.names[entry.name] = true end
            local pos = rootPosOf(entry.player)
            if pos then out.roots[#out.roots + 1] = pos end
        end
        mates.list, mates.at = out, now
        return out
    end

    -- net z and which half is mine (-1 below the net, +1 at or above); training has no real sides, so there it's the half I stand in
    local function readCourt(v)
        local okC, c = Match.context()
        local mode = (okC and type(c) == "table") and c.gamemode or nil
        v.training = mode == TRAINING
        v.hardcore = mode == HARDCORE
        local okCourt, court = Match.court()
        if okCourt and type(court) == "table" then
            v.netZ = partZ(court.net) or partZ(court.bounds)
            v.lines = court.courtlines
        end
        if v.netZ == nil then return end
        if v.training then
            v.side = v.rootPos.Z >= v.netZ and 1 or -1
            return
        end
        local okT, team = Match.myTeam()
        if not okT or team == nil then return end
        local okS, s = Match.side(team)
        if okS and type(s) == "table" then v.side = s.ownsBelowNetZ and -1 or 1 end
    end

    -- the server's name while a serve is still unreceived; nobody may spike or block it
    local function servedBy(v)
        local by = v.rally.ServedByPlayer
        if type(by) == "string" and by ~= "" then return by end
        return nil
    end

    local function ourServe(v)
        local by = servedBy(v)
        return by ~= nil and (by == v.myName or v.mates.names[by] == true)
    end

    -- their touch (or their serve) heading out of the court: leaving it scores the point, touching it would give it back
    local function goingOut(v)
        local lines = v.lines
        if lines == nil or v.land == nil then return false end
        local okL, pos, size = pcall(function() return lines.Position, lines.Size end)
        if not okL then return false end
        local okT, team = Match.myTeam()
        local mine = okT and team and team.Name
        local lastTeam = v.rally.LastHitTeam
        if mine == nil or type(lastTeam) ~= "string" or lastTeam == "" or lastTeam == mine then return false end
        local okR, r = Ball.radius()
        return not Plan.inCourt(v.land.position, pos, size, (okR and r or 1.3) + OUT_MARGIN)
    end

    local function isMine(v)
        if v.land == nil then return false end
        if v.servePhase or v.training then return true end
        if v.netZ == nil or v.side == nil then return false end
        if not Plan.onSide(v.land.position.Z, v.netZ, v.side) then return false end
        if ourServe(v) then return false end
        if goingOut(v) then return false end
        local m = v.mates
        if m.count == 0 then return true end
        -- a second touch in a row is skipped by the game unless it granted a bypass
        if v.rally.LastHitter == v.myName and v.rally.HitBypass ~= v.myName then return false end
        local margin = owned and OWNER_KEEP or OWNER_MARGIN
        local mine = Plan.flatDist(v.rootPos, v.land.position)
        for _, pos in ipairs(m.roots) do
            if Plan.flatDist(pos, v.land.position) + margin < mine then return false end
        end
        return true
    end

    local function expire(v)
        local vy = sign(v.ball.velocity.Y)
        if recv.at and (v.now - recv.at >= SWING_LATCH or flipped(recv, vy)) then recv = {} end
        if dive.at and (v.now - dive.at >= DIVE_LATCH or flipped(dive, vy)) then dive = {} end
        if block.at and v.now - block.at >= BLOCK_LATCH then block = {} end
        if spike.aborted and flipped(spike, vy) then spike = {} end
    end

    local function applySteer(v, target, settle)
        if settle then
            steer:halt(v.hum, v.rootPos)
        elseif target == nil then
            steer:release(v.hum, v.rootPos)
        elseif not v.st.IsBusy then
            steer:walk(v.hum, v.rootPos, Plan.clampToSide(target, v.netZ, v.side, NET_CLEAR), v.now)
        end
    end

    local function tickServe(now, st, want)
        serve.since = serve.since or now
        if not want.serve then return end
        if serve.sentAt and now - serve.sentAt < SERVE_RETRY then return end
        if now - serve.since < SERVE_DELAY then return end
        if st.IsBusy or st.IsStunned or st.IsJumping or not ready(now) then return end
        local power = math.clamp(tonumber(value("VL_ServePower", 100)) or 100, 50, 100) / 100
        if Actions.serve(power) then
            serve.sentAt = now
            acted(now, "serve", "at %d%%", math.floor(power * 100 + 0.5))
        end
    end

    -- grounded hit of a ball of mine: Bump/Set when it is one lead away from the box, once per approach; true while i should stand still for it
    local function tryReceive(v, move)
        local ok, t, lead = swingTime(v, move, v.timing)
        if not ok then return false end
        if recv.at then
            if t == 0 then
                recv.inside = true
            elseif recv.inside then
                recv = {}
            end
            if recv.at then return v.now - recv.at < STILL_AFTER end
        end
        local still = t ~= nil and t <= lead + STILL_LEAD
        if t == nil or t > lead or not free(v) then return still end
        -- a ball already in the box and climbing out of it (a fresh spawn, our own toss) can't be met yet; wait for it to come back down
        if t == 0 and v.ball.velocity.Y > 0 then return false end
        local okM, allowed = Actions.canMove(move)
        if not okM or not allowed then return still end
        if Actions.move(move) then
            recv = { at = v.now, sign = sign(v.ball.velocity.Y), inside = t == 0 }
            if v.servePhase then serve.hitDone = true end
            acted(v.now, move, "ball in %.2fs", t)
        end
        return true
    end

    -- where the falling ball passes my contact height, so it is met high in my box, kept on my side of the net; its landing when that can't be read
    local function chaseSpot(v)
        local ok, pred = Ball.predict({ horizon = v.horizon, samples = 2 })
        if not ok or type(pred) ~= "table" then return v.land.position end
        local t = Plan.descendTime(pred, v.rootPos.Y + CHASE_RISE, v.horizon, SCAN_STEP)
        if not t then return v.land.position end
        local p = pred.positionAt(t)
        return Plan.clampToSide(Vector3.new(p.X, v.rootPos.Y, p.Z), v.netZ, v.side, NET_CLEAR)
    end

    -- a ball of mine landing too soon and too far to walk to: line up on it, then dive; returns where to steer meanwhile
    local function tryDive(v, move, hitOn)
        if dive.at then return nil end
        local land = v.land
        local d = Plan.flatDist(v.rootPos, land.position)
        -- walking stops inside the arrive radius anyway, so only the distance past it counts
        local tooFar = d > STEER.arrive and Plan.walkTime(d - STEER.arrive, v.hum.WalkSpeed) > land.time - DIVE_SLACK
        if land.time <= 0 or land.time > DIVE_MAX_TIME or d > DIVE_MAX_DIST or not tooFar then
            dive.armedAt = nil
            return nil
        end
        if hitOn then
            local ok, t = timeToBox(v, move, land.time)
            if ok and t ~= nil then
                dive.armedAt = nil
                return nil
            end
        end
        dive.armedAt = dive.armedAt or v.now
        local md = v.hum.MoveDirection
        local along = (md.X * (land.position.X - v.rootPos.X) + md.Z * (land.position.Z - v.rootPos.Z)) / math.max(d, 1e-6)
        if (along >= DIVE_ALIGN or v.now - dive.armedAt >= DIVE_STEER) and free(v) and Actions.dive({}) then
            dive = { at = v.now, sign = sign(v.ball.velocity.Y) }
            acted(v.now, "dive", "%.1f studs, lands in %.2fs", d, land.time)
            return nil
        end
        return land.position
    end

    local function planSpike(v)
        -- a serve is struck from behind the end line, which hardcore's back row may jump from
        if spike.aborted or (not v.servePhase and hardcoreBackRow(v)) then return nil end
        if not v.servePhase and (v.netZ == nil or v.side == nil or servedBy(v)) then return nil end
        local jump = jumpModel()
        if not jump then return nil end
        local ok, pred = Ball.predict({ horizon = v.horizon, samples = 2 })
        if not ok or type(pred) ~= "table" then return nil end
        local above, below = SPIKE_ABOVE_APEX, SPIKE_BELOW_APEX
        if v.servePhase then
            local hb = hitbox("Spike")
            if not hb then return nil end
            above = hb.Offset.Position.Y + hb.Size.Y * Contact.CONTACT_TOP
            below = SERVE_BELOW_TOP - above
        end
        return Plan.spike(pred, {
            rootPos = v.rootPos, jump = jump, walkSpeed = v.hum.WalkSpeed,
            -- a serve toss is hit from where I stand, wherever the net is
            netZ = (not v.servePhase) and v.netZ or nil, sideSign = v.side, fixed = v.servePhase,
            netRange = SPIKE_NET_RANGE, aboveApex = above, belowApex = below,
            spotTol = SPIKE_SPOT_TOL, backoff = SPIKE_BACKOFF, netClear = NET_CLEAR,
            horizon = v.horizon, step = SCAN_STEP, scanStep = PLAN_STEP,
        })
    end

    -- phase one of a spike: get under the meeting point, stand still, take off; returns (steer target, settle)
    local function runSpike(v, plan)
        local near = Plan.flatDist(v.rootPos, plan.stand) <= SPIKE_SPOT_TOL
        if plan.takeoffIn > math.max(0, TAKEOFF_LEAD + v.timing) then
            -- a serve's toss comes back down where i stand: never step toward the end line for it
            if v.servePhase or (near and plan.takeoffIn <= SETTLE_TIME) then return nil, true end
            return plan.stand, false
        end
        if not near then
            spike = { aborted = true, sign = sign(v.ball.velocity.Y) }
            return nil, false
        end
        if free(v) and Actions.jump() then
            acted(v.now, "jump", "to spike in %.2fs", plan.meetIn)
        end
        return nil, true
    end

    -- phase two, airborne: swing once the ball is one lead away from the spike box
    local function trySpikeSwing(v, move)
        move = move or "Spike"
        if swungThisJump or v.st.IsBusy or v.st.IsStunned or not ready(v.now) then return end
        if not v.servePhase and hardcoreBackRow(v) then return end
        if not v.servePhase and not v.training then
            if servedBy(v) or v.netZ == nil or v.side == nil then return end
            if not Plan.onSide(v.ball.position.Z, v.netZ, v.side) then return end
        end
        local ok, t, lead = swingTime(v, move, v.timing)
        if not ok or t == nil or t > lead then return end
        local okM, allowed = Actions.canMove(move)
        if not okM or not allowed then return end
        if Actions.move(move) then
            swungThisJump = true
            if v.servePhase then serve.hitDone = true end
            acted(v.now, move, "ball in %.2fs", t)
        end
    end

    local function planBlock(v)
        if block.at or v.servePhase or v.netZ == nil or v.side == nil or servedBy(v) then return nil end
        -- cheap gate before predicting: on their side and near the net
        local bp = v.ball.position
        if Plan.onSide(bp.Z, v.netZ, v.side) or math.abs(bp.Z - v.netZ) > BLOCK_RANGE then return nil end
        if hardcoreBackRow(v) then return nil end
        local jump = jumpModel()
        if not jump then return nil end
        local ok, pred = Ball.predict({ horizon = BLOCK_MAX_TIME, samples = 2 })
        if not ok or type(pred) ~= "table" then return nil end
        return Plan.block(pred, {
            rootPos = v.rootPos, netZ = v.netZ, sideSign = v.side, range = BLOCK_RANGE,
            horizon = BLOCK_MAX_TIME, step = SCAN_STEP, lateral = BLOCK_LATERAL,
            minH = BLOCK_MIN_H, maxH = jump.apexH + BLOCK_ABOVE_APEX, gap = BLOCK_GAP,
            lead = math.max(0, BLOCK_LEAD + v.timing), spotTol = BLOCK_SPOT_TOL, walkSpeed = v.hum.WalkSpeed,
        })
    end

    -- step to the net under the crossing, stand still, jump-block; returns (steer target, settle, handled)
    local function runBlock(v, plan)
        local near = Plan.flatDist(v.rootPos, plan.stand) <= BLOCK_SPOT_TOL
        if plan.jumpIn > 0 then
            if near and plan.jumpIn <= SETTLE_TIME then return nil, true, true end
            return plan.stand, false, true
        end
        if not near then return nil, false, false end
        if free(v) and Actions.move("Block") then
            block = { at = v.now }
            acted(v.now, "Block", "crossing in %.2fs", plan.crossIn)
        end
        return nil, true, true
    end

    local function tick()
        local want = readWants()
        if not want.any then
            stop()
            return
        end
        local okP, playing = Match.isPlaying()
        if not okP or not playing then
            stop()
            return
        end
        local root, hum = References.humanoidRootPart, References.humanoid
        if root == nil or hum == nil then
            stop()
            return
        end
        local okS, st = Actions.state()
        if not okS or type(st) ~= "table" then
            stop()
            return
        end

        stopped = false
        local now = os.clock()
        local rootPos = root.Position
        if st.IsJumping then
            jumping = true
        elseif jumping then
            jumping, swungThisJump = false, false
        end

        if st.IsServing then
            steer:release(hum, rootPos)
            resetApproach(nil)
            tickServe(now, st, want)
            return
        end
        if serve.since then
            -- the presses landed: the tossed ball is mine to hit for a moment
            if serve.sentAt and want.serve then serve.hitUntil, serve.hitDone = now + SERVE_HIT_WINDOW, false end
            serve.since, serve.sentAt = nil, nil
        end

        local okB, ball = Ball.active()
        if not okB or type(ball) ~= "table" or ball.position == nil or ball.velocity == nil then
            steer:release(hum, rootPos)
            resetApproach(nil)
            return
        end
        local id = ball.id
        if id == nil then id = ball.model end
        if id ~= approachId then resetApproach(id) end

        local okL, land = Ball.landing(LANDING_OPTS)
        local v = {
            now = now, root = root, rootPos = rootPos, hum = hum, st = st, ball = ball,
            -- a ball lying on the floor is no ball of mine to play
            land = (okL and type(land) == "table" and not land.resting) and land or nil,
            myName = References.player.Name,
            servePhase = serve.hitUntil ~= nil and now < serve.hitUntil and not serve.hitDone,
            timing = (tonumber(value("VL_SwingTiming", 0)) or 0) / 1000,
        }
        v.swingLead = math.max(0, SWING_LEAD + v.timing)
        v.horizon = math.min(v.land and v.land.time or PLAN_HORIZON, PLAN_HORIZON)
        readCourt(v)
        local okR, rally = Ball.rally()
        v.rally = (okR and type(rally) == "table") and rally or EMPTY_RALLY
        v.mates = v.training and NO_MATES or teammates(now)
        expire(v)

        if st.IsJumping then
            -- auto hit plays whatever reaches me in the air too, with the chosen air hit; auto spike alone keeps its spike; a serve is always a spike
            if v.servePhase and want.serve then
                trySpikeSwing(v, "Spike")
            elseif want.hit then
                trySpikeSwing(v, value("VL_AirHit", "Spike") == "Jump Set" and "JumpSet" or "Spike")
            elseif want.spike then
                trySpikeSwing(v, "Spike")
            end
            return
        end

        if want.block then
            local plan = planBlock(v)
            if plan then
                local target, settle, handled = runBlock(v, plan)
                if handled then
                    applySteer(v, target, settle)
                    return
                end
            end
        end

        owned = isMine(v)
        if not owned then
            steer:release(hum, rootPos)
            return
        end

        -- auto serve's hit is always a jump serve
        if want.spike or (v.servePhase and want.serve) then
            local plan = planSpike(v)
            if plan then
                local target, settle = runSpike(v, plan)
                if not spike.aborted then
                    applySteer(v, target, settle)
                    return
                end
            end
        end

        -- ground hit "Nothing" leaves balls on the ground to me (auto hit then only plays them in the air); a serve's own hit still goes
        local ground = value("VL_HitWith", "Bump")
        local hitOn = (want.hit and ground ~= "Nothing") or (v.servePhase and want.serve)
        local move = ground
        if v.servePhase or (move ~= "Bump" and move ~= "Set") then move = "Bump" end
        if hitOn and tryReceive(v, move) and want.chase and not v.servePhase then
            -- stand still for the swing so it goes where i face
            applySteer(v, nil, true)
            return
        end

        local target
        if want.dive and not v.servePhase then target = tryDive(v, move, hitOn) end
        if target == nil and want.chase and not v.servePhase then target = chaseSpot(v) end
        applySteer(v, target, false)
    end

    return { tick = tick, stop = stop }
end

return M

end)
__bundle_register("Features/Volleyball/AutoPlay/Steer", function(require, _LOADED, __bundle_register, __bundle_modules)
-- autoplay steering: walks my humanoid to a ground point with arrive/resume hysteresis, halts in place on request, and hands movement back to the player exactly once; MoveTo(own position) is what cancels a walk, since Move(zero) alone leaves a MoveTo running
local Plan = require("Features/Volleyball/AutoPlay/Plan")

local M = {}
M.__index = M

-- cfg: arrive, resume, repath (studs), reissue (seconds)
function M.new(cfg)
    return setmetatable({ cfg = cfg, active = false, walking = false, holding = false, goal = nil, issuedAt = 0 }, M)
end

function M:walk(hum, rootPos, goal, now)
    local cfg = self.cfg
    local d = Plan.flatDist(rootPos, goal)
    self.active = true
    if d <= cfg.arrive or (self.holding and d <= cfg.resume) then
        self:halt(hum, rootPos)
        self.holding = true
        return
    end
    self.holding = false
    local stale = self.goal == nil or Plan.flatDist(self.goal, goal) > cfg.repath or now - self.issuedAt >= cfg.reissue
    if self.walking and not stale then return end
    hum:MoveTo(Vector3.new(goal.X, rootPos.Y, goal.Z))
    self.walking, self.goal, self.issuedAt = true, goal, now
end

-- stand still but keep control, e.g. right before a jump so it goes straight up
function M:halt(hum, rootPos)
    self.active = true
    if not self.walking then return end
    self.walking, self.goal = false, nil
    hum:MoveTo(rootPos)
end

function M:release(hum, rootPos)
    if not self.active then return end
    self.active, self.walking, self.holding, self.goal = false, false, false, nil
    if hum == nil then return end
    if rootPos ~= nil then pcall(hum.MoveTo, hum, rootPos) end
    pcall(hum.Move, hum, Vector3.zero)
end

return M

end)
