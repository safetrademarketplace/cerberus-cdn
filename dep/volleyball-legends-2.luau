    linkRow.Position = UDim2.fromOffset(0, 116)
    linkRow.Size = UDim2.new(1, 0, 0, 30)
    linkRow.ZIndex = 1002
    linkRow.Parent = card
    Instance.new("UICorner", linkRow).CornerRadius = UDim.new(0, 8)
    local linkStroke = Instance.new("UIStroke")
