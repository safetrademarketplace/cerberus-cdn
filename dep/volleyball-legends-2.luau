        for _, key in ipairs(registry.keys()) do
            local ev = registry.Get(key)
            if ev.default then store.data.events[key] = true end
        end
        store.flush()
    end

    local api = {}

    api.OnSent   = signals.OnSent
    api.OnFailed = signals.OnFailed

    api.Send = function(spec, onDone) return send(spec, nil, onDone) end
    api.Emit = function(key, a, b) return emit(key, a, b) end
    -- test send; onDone(ok, status) reports discord's actual response (ui submit-test + button)
    api.Test = function(route, onDone)
        return send({
            route       = route,
            title       = "Webhook Test",
            description = "Your Cerberus webhook is connected and working.",
            timestamp   = true,
        }, "test", onDone)
    end

    api.GetUrl    = store.getUrl
    api.SetUrl    = function(url) store.setUrl(url); refreshArming() end
    api.GetRoute  = store.getRoute
    api.SetRoute  = function(name, url) store.setRoute(name, url); refreshArming() end
    api.GetRoutes = store.getRoutes

    api.GetColor     = store.getColor
    api.SetColor     = store.setColor
    api.GetAnon      = store.getAnon
    api.SetAnon      = store.setAnon
    api.SetUsername  = store.setUsername
    api.SetAvatarUrl = store.setAvatarUrl

    api.RegisterEvent = registerEvent
    api.GetEventList  = registry.List
    api.GetEvent      = registry.Get
    api.IsEventEnabled = store.isEventEnabled
    api.SetEventEnabled = function(key, on) store.setEventEnabled(key, on); refreshArming() end
    api.SetEnabledFromSelection = function(sel)
        store.setEnabledFromSelection(sel, function(k) return registry.Get(k) ~= nil end)
