                prev = t
                t = t + step
            end
            return nil
        end)
        if not okScan then return false, Errors.BAD_ARGS end
        return true, crossing
    end

    local function inPlay()
        if not net then return false, Errors.NO_NET end
        return true, attr(Services.ReplicatedStorage, "IsBallInPlay") == true
    end

    -- the rally attributes as one snapshot table (recon ball_moves.md 1.8)
    local function rally()
        if not net then return false, Errors.NO_NET end
        local rs = Services.ReplicatedStorage
        return true, {
            LastHitter       = attr(rs, "LastHitter"),
            LastHitTeam      = attr(rs, "LastHitTeam"),
            LastHitType      = attr(rs, "LastHitType"),
            LastHitPosition  = attr(rs, "LastHitPosition"),
            LastHitTimestamp = attr(rs, "LastHitTimestamp"),
            TeamHitStreak    = attr(rs, "TeamHitStreak"),
            ServedByPlayer   = attr(rs, "ServedByPlayer"),
            HitBypass        = attr(rs, "HitBypass"),
        }
    end

    local function gravity()        if not net then return false, Errors.NO_NET end return true, currentGravity()  end
    local function timeScale()      if not net then return false, Errors.NO_NET end return true, currentTimeScale() end
    local function sizeMultiplier() if not net then return false, Errors.NO_NET end return true, currentSizeMult()  end
    local function radius()         if not net then return false, Errors.NO_NET end return true, currentRadius()    end

    -- (true, Vector3) the ball's whole measured sim-time acceleration (gravity included), or (true, nil) until two packets of one ball have arrived
    local function acceleration()
        if not net then return false, Errors.NO_NET end
        ensureStream()
        return true, fitted
    end

    -- subscribe raw to BallController.Streamed; the handle is reaped by the api maid
    local function observeStream(fn)
        if not net then return nil, Errors.NO_NET end
        if type(fn) ~= "function" then return nil, Errors.BAD_ARGS end
        local ok, controller = net.controller("BallController")
        if not ok or type(controller) ~= "table" then return nil, Errors.NO_STREAM end
        local okSig, signal = pcall(function() return controller.Streamed end)
        if not okSig or type(signal) ~= "table" or type(signal.Connect) ~= "function" then
            return nil, Errors.NO_STREAM
        end
        local okC, conn = pcall(signal.Connect, signal, fn)
        if not okC or conn == nil then return nil, Errors.NO_STREAM end
        return track(conn)
    end

    ensureStream()
    base.log("ball api ready (%s)", net and "net present" or "no net")

    return {
        Errors = Errors,

        active   = active,
        inPlay   = inPlay,
        rally    = rally,

        gravity        = gravity,
        timeScale      = timeScale,
        sizeMultiplier = sizeMultiplier,
        radius         = radius,

        predict     = predict,
        landing     = landing,
        timeIntoBox = timeIntoBox,

        acceleration = acceleration,
        observeStream = observeStream,
        changed = changed,
    }
end

return M

end)
__bundle_register("Api/Ball/Trajectory", function(require, _LOADED, __bundle_register, __bundle_modules)
-- ball trajectory: the bounce-aware flight as closed-form arcs split at each contact, swept in fixed real-time chords through an injected spherecast; pure, it never touches the world itself, and with no cast it is exactly the old single analytic arc

local Physics = require("Api/Ball/Physics")

local M = {}

local MIN_SPAN  = 1e-6
local MIN_SWEEP = 1e-4
-- restart just off the surface: a cast that starts touching a part never reports it, so a ball left on the contact could tunnel through
local SKIN = 0.05
-- a ball lying on the court sits a few hundredths under its resting height with a velocity jittering a few tenths, so it has landed
-- while its centre is no higher than this above that height and it is climbing no faster than this
local REST_SLOP = 0.1
local REST_RISE = 1

-- a ball already down on the floor plane and not rising: it has landed where it lies
function M.landed(o)
    return o.floorY ~= nil and o.p0.Y <= o.floorY + o.radius + REST_SLOP and o.v0.Y <= REST_RISE
end

-- the arc that owns real time t: the last piece starting at or before it (pieces are in time order, at most maxBounces + 1)
local function pieceFor(path, t)
    local pieces = path.pieces
    local piece = pieces[1]
    for i = 2, #pieces do
        local nextPiece = pieces[i]
        if nextPiece.t0 > t then break end
        piece = nextPiece
    end
    return piece
end

local function pieceAt(path, piece, t)
    return Physics.positionAt(piece.p, piece.v, path.a, path.k * (t - piece.t0))
end

function M.positionAt(path, t)
    return pieceAt(path, pieceFor(path, t), t)
end

function M.velocityAt(path, t)
    local piece = pieceFor(path, t)
    return Physics.velocityAt(piece.v, path.a, path.k * (t - piece.t0))
end

-- real time this arc's centre first reaches floorY + radius: the old analytic landing (Safety.timeToFloor)
local function floorCrossing(path, piece, floorY, radius)
    if floorY == nil or path.k <= 0 then return nil end
    local tau = Physics.floorTime(piece.p.Y, piece.v.Y, path.a.Y, floorY + radius)
    if not tau then return nil end
    return piece.t0 + tau / path.k
end

-- one cast per grid step (a bounce folds the rest of its step into the next chord), so a run never exceeds ceil(horizon / step) casts; past the cap or the horizon the last arc runs free to the floor plane
function M.simulate(o)
    local piece = { t0 = 0, p = o.p0, v = o.v0 }
    local path = { a = o.a, k = o.k, pieces = { piece }, bounces = {}, landing = nil, casts = 0 }
    if M.landed(o) then
        path.landing = { t = 0, position = Vector3.new(o.p0.X, o.floorY + o.radius, o.p0.Z), resting = true }
        return path
    end
    local tFloor = floorCrossing(path, piece, o.floorY, o.radius)

    if o.cast and o.k > 0 then
        local tNow = 0
        local steps = math.ceil(o.horizon / o.step - 1e-9)
        for i = 1, steps do
            local t1 = math.min(i * o.step, o.horizon)
            if t1 - tNow > MIN_SPAN then
                local from = pieceAt(path, piece, tNow)
                local sweep = pieceAt(path, piece, t1) - from
                local length = sweep.Magnitude
                local hit
                if length > MIN_SWEEP then
                    path.casts = path.casts + 1
                    hit = o.cast(from, sweep)
                end

                local tHit, centre
                if hit then
                    local frac = math.clamp(hit.Distance / length, 0, 1)
                    tHit = tNow + (t1 - tNow) * frac
                    centre = from + sweep * frac
                end
                local crosses = tFloor ~= nil and tFloor <= t1
                local onFloor = hit ~= nil and o.isFloor(hit)

                if hit and not onFloor and not (crosses and tFloor <= tHit) then
                    -- net, post or wall: reflect like the game and carry on from the contact
                    local normal = hit.Normal
                    local vIn = Physics.velocityAt(piece.v, path.a, path.k * (tHit - piece.t0))
                    path.bounces[#path.bounces + 1] = { time = tHit, position = centre, normal = normal }
                    piece = { t0 = tHit, p = centre + normal * SKIN, v = Physics.reflect(vIn, normal, o.damping) }
                    path.pieces[#path.pieces + 1] = piece
                    tFloor = floorCrossing(path, piece, o.floorY, o.radius)
                    tNow = tHit
                    if #path.bounces >= o.maxBounces then break end
                elseif crosses then
                    -- the court plane inside this chord: land exactly where the analytic arc meets it
                    path.landing = { t = tFloor, position = pieceAt(path, piece, tFloor) }
                    break
                elseif onFloor then
                    -- floor that is not the court plane (lower ground, a low step): land on the contact itself
                    path.landing = { t = tHit, position = centre }
                    break
                else
                    tNow = t1
                end
            end
        end
    end

    if not path.landing and tFloor then
        path.landing = { t = tFloor, position = pieceAt(path, piece, tFloor) }
    end
    return path
end

return M

end)
__bundle_register("Api/Ball/Physics", function(require, _LOADED, __bundle_register, __bundle_modules)
-- ball physics: the game's own no-drag constant-gravity solver written fresh, in sim time (tau = GlobalTimeScale * realSeconds); mirrors Shirudo Timing.positionAt, Safety.timeToFloor, the Common.Physics bounce and isSphereIntersectingPart, never requires a game module

local M = {}

local EPSILON = 1e-9

-- semi-implicit euler closed form; a is the total sim-time acceleration (fitted accel plus gravity), tau in sim seconds
-- mirrors RS.Content.Special.Shirudo.Utility.Timing.lua:6-9 (p + v*dt + (acc + gravityVec)*0.5*dt^2)
function M.positionAt(p0, v0, a, tau)
    return p0 + v0 * tau + a * (0.5 * tau * tau)
end

-- sim-unit velocity at sim time tau
function M.velocityAt(v0, a, tau)
    return v0 + a * tau
end

-- earliest sim time tau > 0 at which the vertical position comes down to targetY, solving 0.5*aY*tau^2 + v0y*tau + (p0y - targetY) = 0
-- the degenerate aY=0 case is the linear fall-through; the quadratic + root reproduces Safety.timeToFloor (lua:32-40) when aY = -gravity*gm,
-- except that a ball starting under targetY and rising skips its way up through it: that crossing is not a landing
function M.floorTime(p0y, v0y, aY, targetY)
    local A = 0.5 * aY
    local B = v0y
    local C = p0y - targetY
    if math.abs(A) < EPSILON then
        if math.abs(B) < EPSILON then return nil end
        local t = -C / B
        if t > 0 and B < 0 then return t end
        return nil
    end
    local disc = B * B - 4 * A * C
    if disc < 0 then return nil end
    local root = math.sqrt(disc)
    local best
    for _, t in ipairs({ (-B + root) / (2 * A), (-B - root) / (2 * A) }) do
        if t > 0 and B + aY * t <= EPSILON and (not best or t < best) then best = t end
    end
    return best
end

-- the game's bounce: reflect the unit velocity about the hit normal, keep the speed, then damp it (RS.Common.Physics.lua:142,149)
function M.reflect(v, normal, damping)
    local speed = v.Magnitude
    if speed < EPSILON then return v * 0 end
    local u = v / speed
    return (u - normal * (2 * u:Dot(normal))) * (speed * damping)
end

-- is a ball sphere of the given radius, centred at point, touching the oriented box {cf, size}
-- mirrors RS.Common.Physics.lua:170-173 (clamp into the box in object space, compare the residual to the radius)
function M.sphereInBox(cf, size, point, radius)
    local half = size * 0.5
    local lp = cf:PointToObjectSpace(point)
    local dx = lp.X - math.clamp(lp.X, -half.X, half.X)
    local dy = lp.Y - math.clamp(lp.Y, -half.Y, half.Y)
    local dz = lp.Z - math.clamp(lp.Z, -half.Z, half.Z)
    return (dx * dx + dy * dy + dz * dz) <= radius * radius
end

return M

end)
