end

-- their half inset from its lines and the net: x range, and the near and back z
local function inset(half)
    local edge = half.edge or INSET
    local back = half.cz + half.s * (half.ez - edge)
    return half.cx - half.ex + edge, half.cx + half.ex - edge, half.netZ + half.s * INSET, back
end

-- a spot pulled back inside their inset half
function M.clamp(half, x, z)
    local minX, maxX, near, back = inset(half)
    if minX > maxX then minX, maxX = half.cx, half.cx end
    local lo, hi = math.min(near, back), math.max(near, back)
