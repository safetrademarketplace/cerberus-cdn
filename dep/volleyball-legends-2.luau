M.layout = {
    { key = "Home", label = "Home", icon = "house", configKeys = { "Home" } },
    { section = "Volleyball", tabs = {
        { key = "Play",     label = "Play",     icon = "volleyball", configKeys = { "AutoPlay", "Assist" } },
        { key = "Progress", label = "Progress", icon = "trophy",     configKeys = { "Progress" } },
    } },
    { section = "Player", tabs = {
        -- key stays Movement so Speed/Jump element ids and saved configs are untouched; the label is what the player sees
