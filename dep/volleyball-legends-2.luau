__bundle_register("Features/Volleyball/AutoPlay", function(require, _LOADED, __bundle_register, __bundle_modules)
-- autoplay: the play tab's automatic player (auto hit, chase, dive, serve, spike, block); one heartbeat brain, bound only while one of its toggles is on, plays through the match, ball, actions and net apis and hands movement back whenever it lets go
local Log       = require("Utility/Log")
local Mount     = require("Utility/Mount")
local Scheduler = require("Utility/Scheduler")
local Brain     = require("Features/Volleyball/AutoPlay/Brain")
local Menu      = require("Features/Volleyball/AutoPlay/Menu")

-- any one of these on wakes the brain
local TOGGLES = { "VL_AutoHit", "VL_ChaseBall", "VL_AutoDive", "VL_AutoServe", "VL_AutoSpike", "VL_AutoBlock" }
local TICK_PRIORITY = 20

return function(ctx)
    local O = Mount.orchestrator(ctx, "AutoPlay")
    if not O then return {} end

    Menu(ctx.Tabs.Play)

    local Api = ctx.Api
    if not (Api and Api.Match and Api.Ball and Api.Actions) then
        Log.devwarn("AutoPlay", "game apis missing; menu only")
        O.finalize()
        return {}
    end

    local Toggles = ctx.Toggles
    local brain = Brain.new({
        Match      = Api.Match,
        Ball       = Api.Ball,
        Actions    = Api.Actions,
        Services   = ctx.Services,
        References = ctx.References,
        Toggles    = Toggles,
        Options    = ctx.Options,
    })

    -- a throw is logged rather than left to the scheduler, which drops a task after three in a row
    local function step()
        local ok, err = pcall(brain.tick)
        if not ok then Log.devwarn("AutoPlay", "tick failed: %s", tostring(err)) end
    end

    local slot
    local unloaded = false

    local function anyOn()
        for _, id in ipairs(TOGGLES) do
            local t = Toggles[id]
            if t and t.Value then return true end
        end
        return false
    end

    local function refresh()
        if unloaded then return end
        if anyOn() then
            if slot == nil then
                local handle = Scheduler.heartbeat(step, { name = "AutoPlay", priority = TICK_PRIORITY })
                if handle then slot = O.maid:GiveTask(handle) end
            end
        elseif slot ~= nil then
            O.maid[slot] = nil
            slot = nil
            brain.stop()
        end
    end

    for _, id in ipairs(TOGGLES) do
        local t = Toggles[id]
        if t then t:OnChanged(refresh) end
    end

    O.onUnload(function()
        unloaded = true
        brain.stop()
    end)

    refresh()
    O.finalize()
    return {}
end

end)
