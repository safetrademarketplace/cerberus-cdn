                if beats(miss, off, in1, in2) then inX, inZ, inR, in1, in2 = x, z, r, miss, off end
            elseif beats(out, off, out1, out2) then
                outX, outZ, outR, out1, out2 = x, z, r, out, off
            end
        end
    end
    if inX then return inX, inZ, inR, true end
    return outX, outZ, outR, false
end

return M

end)
__bundle_register("Features/Volleyball/Assist/HitWatch", function(require, _LOADED, __bundle_register, __bundle_modules)
-- hit watch: spots each of my own hits on the ball stream (in a match a new LastHitTimestamp of mine; in training, which sets no rally attributes, the ball turning from falling to rising beside me just after a move of mine) and feeds the first update after it to the hit model, at most once per move played
local HitModel = require("Features/Volleyball/Assist/HitModel")

-- a move counts as the one that hit for this long after it was last seen playing
local MOVE_RECENT = 0.4
-- training: the ball must turn around this close to my root
local NEAR = 6
-- the sample is the first update this long after the hit (the stream can decode several in one frame), dropped past the window
local SAMPLE_GAP    = 0.03
local SAMPLE_WINDOW = 0.3
-- a stream that isn't up yet is asked for again this often
local RETRY = 2

local M = {}

-- deps.recent() answers the last move seen playing as { move, at, facing, contactY, lean, behind, serial }
function M.new(deps)
    local Ball       = deps.Ball
    local References = deps.References
    local model      = deps.model
    local recent     = deps.recent
    local maid       = deps.maid

    local handle, slot
    local nextTry = 0
    -- the first stamp read only primes, so a hit from before we started never counts
    local primed, lastStamp
    local lastId, lastVy
    local lastSerial
    -- { id, at, move, facing, contactY } between a hit and its sample
    local pending

    local function myName()
        local player = References.player
        if not player then return nil end
        return player.Name
    end

    local function arm(id, now)
        local seen = recent()
        if not (seen and seen.move and seen.facing and now - seen.at <= MOVE_RECENT) then return end
        if seen.serial == lastSerial then return end
        lastSerial = seen.serial
        pending = { id = id, at = now, move = seen.move, facing = seen.facing, contactY = seen.contactY, lean = seen.lean, behind = seen.behind }
    end

    local function take(velocity, position)
        local hit = pending
        pending = nil
        local okG, g = Ball.gravity()
        if not (okG and type(g) == "number") then return end
        local h, v = HitModel.measure(velocity, hit.facing, position.Y, hit.contactY, g)
        if h then model.add(hit.move, h, v, hit.lean, hit.behind) end
    end

    local function onPacket(packet)
        if type(packet) ~= "table" then return end
        local id, velocity = packet.ID, packet.velocity
        local okP, position = pcall(function() return packet.cframe.Position end)
        if not (okP and typeof(position) == "Vector3" and typeof(velocity) == "Vector3") then return end
        local now = os.clock()
        local prevVy = id == lastId and lastVy or nil
        lastId, lastVy = id, velocity.Y

        if pending then
            local age = now - pending.at
            if id ~= pending.id or age > SAMPLE_WINDOW then
                pending = nil
            elseif age >= SAMPLE_GAP then
                take(velocity, position)
                return
            else
                return
            end
        end

        local okR, rally = Ball.rally()
        local stamp = okR and type(rally) == "table" and rally.LastHitTimestamp or nil
        if stamp ~= nil then
            local fresh = primed and stamp ~= lastStamp
            primed, lastStamp = true, stamp
            local me = myName()
            if fresh and me and rally.LastHitter == me then arm(id, now) end
            return
        end
        primed = true
        if prevVy and prevVy < 0 and velocity.Y > 0 then
            local root = References.humanoidRootPart
            if root and (position - root.Position).Magnitude <= NEAR then arm(id, now) end
        end
    end

    -- subscribes once; while the stream isn't up it is asked for again every few seconds
    local function ensure()
        if handle then return true end
        local now = os.clock()
        if now < nextTry then return false end
        nextTry = now + RETRY
        local h = Ball.observeStream(onPacket)
        if not h then return false end
        handle = h
        if maid then slot = maid:GiveTask(h) end
        primed, lastStamp, lastId, lastVy, pending = false, nil, nil, nil, nil
        return true
    end

    local function stop()
        local held, heldSlot = handle, slot
        handle, slot, nextTry, pending = nil, nil, 0, nil
        if heldSlot then
            maid[heldSlot] = nil
        elseif held then
            held:Disconnect()
        end
    end

    return { ensure = ensure, stop = stop }
end

return M

end)
