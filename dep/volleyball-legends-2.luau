            clock         = noNet,
            context       = noNet,
            myTeam        = noNet,
            teams         = noNet,
            side          = noNet,
            score         = noNet,
            myPosition    = noNet,
            players       = noNet,
            teammates     = noNet,
            opponents     = noNet,
            court         = noNet,
            join          = noNet,
            joinTraining  = noNet,
            leave         = noNet,
