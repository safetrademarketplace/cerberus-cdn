    end
    api.GetEnabledEvents = store.getEnabledEvents
    api.GetEventOption   = store.getEventOption
    api.SetEventOption   = store.setEventOption

    -- persistence guard passthrough for the ui's load-time :SetValue flurry
    api.SetSuspended = store.setSuspended
    api.IsSuspended  = store.isSuspended
    api.Save         = store.save
    api.Store        = store

    api.Pending = transport.pending

    base.maid:GiveTask(function()
        for _, key in ipairs(registry.keys()) do disarmEvent(key) end
        transport.stop()
    end)

    refreshArming()
    base.log("webhook api ready (%d events)", #registry.keys())
    return api
end

