__bundle_register("Features/Navigation/Subplaces", function(require, _LOADED, __bundle_register, __bundle_modules)
-- lists every place in the current universe and TPs to one; develop.roblox.com via Http.client() (executor forwards .ROBLOSECURITY)
local Http    = require("Utility/Helpers/Http")
local Mount   = require("Utility/Mount")
local UiWrite = require("Utility/UiWrite")

return function(ctx)
    local O = Mount.orchestrator(ctx, "Subplaces")
    if not O then return end

    local Services   = ctx.Services
    local Tabs       = ctx.Tabs
    local Library    = ctx.Library
    local References = ctx.References

    local SubplacesGroup = Tabs.Server:AddLeftGroupbox("Subplaces", "map")

    local statusLabel = SubplacesGroup:AddLabel({ Text = "Idle.", DoesWrap = true })

    local subplaceDD = SubplacesGroup:AddDropdown("SubplaceTarget", {
        Text       = "Destination",
        Values     = {},
        Default    = nil,
        Multi      = false,
        Searchable = true,
    })

    local labelToPlaceId = {}
    local fetching = false
    local cancelled = false

    O.onUnload(function() cancelled = true end)

    local function setStatus(text)
        if cancelled then return end
        UiWrite.text(statusLabel, text)
    end

    local function fetchSubplaces()
        if fetching then return end
        fetching = true
        setStatus("Fetching subplaces…")

        task.spawn(function()
            local httpRequest = Http.client()
            if not httpRequest then
                setStatus("HTTP request unavailable on this executor.")
                fetching = false
                return
            end

            local universeId = Services.Game.GameId
            if not universeId or universeId == 0 then
                setStatus("No universe ID available.")
                fetching = false
                return
            end

            local collected = {}
            local cursor = nil
            local errMsg = nil
            local MAX_PAGES = 5

            for page = 1, MAX_PAGES do
                if cancelled then fetching = false; return end
                local url = ("https://develop.roblox.com/v1/universes/%d/places?isUniverseCreation=false&limit=100&sortOrder=Asc"):format(universeId)
                if cursor and cursor ~= "" then
                    url = url .. "&cursor=" .. Services.HttpService:UrlEncode(cursor)
                end

                local okCall, res = pcall(httpRequest, {
                    Url = url,
                    Method = "GET",
                    Headers = { ["Content-Type"] = "application/json" },
                })

                if not okCall or type(res) ~= "table" then
                    errMsg = "request failed"
                    break
                end

                local status = res.StatusCode or res.status_code or res.Status
                local ok2xx = type(status) == "number" and status >= 200 and status < 300
                if status == nil and res.Success ~= nil then ok2xx = res.Success == true end
                if not ok2xx then
                    errMsg = "HTTP " .. tostring(status or "error")
                    break
                end

                local body = res.Body or res.body
                if type(body) ~= "string" or body == "" then
                    errMsg = "empty response"
                    break
                end

                local okDec, data = pcall(Services.HttpService.JSONDecode, Services.HttpService, body)
                if not okDec or type(data) ~= "table" or type(data.data) ~= "table" then
                    errMsg = "decode failed"
                    break
                end

                for _, entry in ipairs(data.data) do
                    if entry.id and entry.name then
                        collected[#collected + 1] = { id = entry.id, name = entry.name }
                    end
                end

                cursor = data.nextPageCursor
                if not cursor or cursor == "" then break end
            end

            if #collected == 0 then
                if errMsg == "HTTP 401" or errMsg == "HTTP 403" then
                    setStatus("API rejected request — Roblox only lists subplaces for users with developer access to this universe.")
                elseif errMsg then
                    setStatus("Failed to fetch subplaces: " .. errMsg)
                else
                    setStatus("No subplaces found for this universe.")
                end
                fetching = false
                return
            end

            table.sort(collected, function(a, b)
                return a.name:lower() < b.name:lower()
            end)

            local labels = {}
            local mapping = {}
            local currentPlaceId = Services.Game.PlaceId
            for _, p in ipairs(collected) do
                local label = p.name
                if p.id == currentPlaceId then
                    label = label .. "  (current)"
                end
                -- disambiguate duplicate names by appending the placeId
                if mapping[label] then
                    label = ("%s [%d]"):format(label, p.id)
                end
                labels[#labels + 1] = label
                mapping[label] = p.id
            end

            if cancelled then fetching = false; return end

            labelToPlaceId = mapping
            UiWrite.values(subplaceDD, labels)
            setStatus(("Loaded %d subplace%s."):format(#collected, #collected == 1 and "" or "s"))
            fetching = false
        end)
    end

    SubplacesGroup:AddButton({
        Text = "Teleport",
        Func = function()
            local label = subplaceDD.Value
            local placeId = label and labelToPlaceId[label]
            if not placeId then
                Library:Notify("Pick a subplace first.", 3)
                return
            end
            local ok, err = pcall(function()
                Services.TeleportService:Teleport(placeId, References.player)
            end)
            if not ok then
                Library:Notify("Teleport failed: " .. tostring(err), 4)
            end
        end,
    })

    task.spawn(fetchSubplaces)

    O.finalize()
    return {}
end

end)
