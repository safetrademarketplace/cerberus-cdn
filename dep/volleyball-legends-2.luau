__bundle_register("Api/Webhook/Registry", function(require, _LOADED, __bundle_register, __bundle_modules)
-- webhook event registry: named embed sources with a declarative option schema (auto-rendered by the ui) and a lazy arm(); universal events plus fork events register here

local M = {}

-- option kinds the ui knows how to render + the store knows how to persist; dropdown/multi pick from `values`
local OPTION_KINDS = {
    toggle   = true,
    slider   = true,
    dropdown = true,
    multi    = true,
    input    = true,
}

local function sanitizeOptions(raw)
    if type(raw) ~= "table" then return {} end
    local out = {}
    for _, opt in ipairs(raw) do
        if type(opt) == "table" and type(opt.key) == "string" and opt.key ~= ""
            and OPTION_KINDS[opt.kind] then
            out[#out + 1] = {
                key     = opt.key,
                kind    = opt.kind,
                label   = opt.label or opt.key,
                default = opt.default,
                values  = opt.values,
                min     = opt.min,
                max     = opt.max,
                tooltip = opt.tooltip,
            }
        end
    end
    return out
end

function M.new()
    local events = {}
    local order  = {}

    -- def = { key, label, default, options = {schema...}, arm = fn(bus) }
    local function register(def)
        if type(def) ~= "table" or type(def.key) ~= "string" or def.key == "" then return false end
        if not events[def.key] then order[#order + 1] = def.key end
        events[def.key] = {
            key     = def.key,
            label   = def.label or def.key,
            default = def.default == true,
            options = sanitizeOptions(def.options),
            arm     = type(def.arm) == "function" and def.arm or nil,
        }
        return true
    end

    local function get(key) return events[key] end

    -- ordered snapshot for the ui (key, label, default, options)
    local function list()
        local out = {}
        for _, key in ipairs(order) do
            local e = events[key]
            out[#out + 1] = {
                key     = e.key,
                label   = e.label,
                default = e.default,
                options = e.options,
            }
        end
        return out
    end

    local function keys()
        local out = {}
        for _, key in ipairs(order) do out[#out + 1] = key end
        return out
    end

    return {
        Register = register,
        Get      = get,
        List     = list,
        keys     = keys,
    }
end

return M

end)
__bundle_register("Api/Webhook/Store", function(require, _LOADED, __bundle_register, __bundle_modules)
-- webhook persistence: owns webhooks.json — destination url + routes, embed theme, enabled events, and per-event options, migrating the old {url,color,anon,selected} layout forward

local Store = require("Utility/Store")

local SCHEMA_VERSION = 2

local M = {}

local function clampComponent(value)
    local n = tonumber(value)
    if not n then return nil end
    if n <= 1 then n = n * 255 end
    n = math.floor(n + 0.5)
    if n < 0 then n = 0 elseif n > 255 then n = 255 end
    return n
end

local function colorToTable(c)
    if typeof(c) ~= "Color3" then return nil end
    return { r = clampComponent(c.R), g = clampComponent(c.G), b = clampComponent(c.B) }
end

local function tableToColor(t)
    if type(t) ~= "table" then return nil end
    local r = clampComponent(t.r or t.R or t[1])
    local g = clampComponent(t.g or t.G or t[2])
    local b = clampComponent(t.b or t.B or t[3])
    if r and g and b then return Color3.fromRGB(r, g, b) end
    return nil
end

function M.new(ctx)
    local DEFAULT_COLOR = Color3.fromRGB(54, 150, 45)
    local KEY           = "webhooks"

    local data = {
        url        = "",
        routes     = {},   -- name -> url
        color      = DEFAULT_COLOR,
        anon       = false,
        username   = "",   -- "" = fall back to theme default
        avatarUrl  = "",
        events     = {},   -- key -> bool
        options    = {},   -- key -> { optKey -> value }
    }

    -- normalize a persisted enabled-map that may be legacy {name=true} or an array
    local function normalizeEvents(raw)
        local out = {}
        if type(raw) ~= "table" then return out end
        local sawBool = false
        for k, v in pairs(raw) do
            if type(v) == "boolean" then sawBool = true; if v then out[tostring(k)] = true end end
        end
        if sawBool then return out end
        for _, name in ipairs(raw) do
            if type(name) == "string" then out[name] = true end
        end
        return out
    end

    local function loadFromDisk()
        local obj = Store.read(Store.GAME, KEY)
        if type(obj) ~= "table" then return end

        if type(obj.url) == "string" then data.url = obj.url end
        if type(obj.anon) == "boolean" then data.anon = obj.anon end
        if type(obj.username) == "string" then data.username = obj.username end
        if type(obj.avatarUrl) == "string" then data.avatarUrl = obj.avatarUrl end
        local color = tableToColor(obj.color)
        if color then data.color = color end
        if type(obj.routes) == "table" then
            for name, url in pairs(obj.routes) do
                if type(name) == "string" and type(url) == "string" then data.routes[name] = url end
            end
        end
        -- events: new `events` map, else migrate the old `selected`/`events` list
        data.events = normalizeEvents(obj.events or obj.selected)
        if type(obj.options) == "table" then
            for key, opts in pairs(obj.options) do
                if type(key) == "string" and type(opts) == "table" then data.options[key] = opts end
            end
        elseif type(obj.eventOptions) == "table" then
            for key, opts in pairs(obj.eventOptions) do
                if type(key) == "string" and type(opts) == "table" then data.options[key] = opts end
            end
        end
    end

    loadFromDisk()

    -- true when no file existed at load — lets the api seed first-run event defaults
    local fresh = not Store.exists(Store.GAME, KEY)

    -- suspendSave starts true to swallow the callback flurry while the ui :SetValues controls from disk; the feature flips it false once settled
    local suspendSave = true

    local function serialize()
        return {
            version   = SCHEMA_VERSION,
            url       = tostring(data.url or ""),
            routes    = data.routes,
            color     = colorToTable(data.color or DEFAULT_COLOR) or colorToTable(DEFAULT_COLOR),
            anon      = data.anon == true,
            username  = tostring(data.username or ""),
            avatarUrl = tostring(data.avatarUrl or ""),
            events    = data.events,
            options   = data.options,
        }
    end

    local function writeNow()
        Store.write(Store.GAME, KEY, serialize())
    end

    local function save()
        if suspendSave then return end
        writeNow()
    end

    -- ensure a file exists on first launch even while the save guard is up
    if fresh then writeNow() end

    local api = {
        data         = data,
        defaultColor = DEFAULT_COLOR,
        file         = Store.path(Store.GAME, KEY),
    }

    function api.getUrl() return tostring(data.url or "") end
    function api.setUrl(v)
        data.url = (type(v) == "string") and v or tostring(v or "")
        save()
    end

    function api.getRoute(name)
        if name == nil or name == "" then return api.getUrl() end
        return data.routes[name] or api.getUrl()
    end
    function api.setRoute(name, url)
        if type(name) ~= "string" or name == "" then return end
        if url == nil or url == "" then data.routes[name] = nil
        else data.routes[name] = tostring(url) end
        save()
    end
    function api.getRoutes() return data.routes end

    function api.getColor() return data.color or DEFAULT_COLOR end
    function api.setColor(c)
        data.color = (typeof(c) == "Color3") and c or DEFAULT_COLOR
        save()
    end

    function api.getAnon() return data.anon == true end
    function api.setAnon(v) data.anon = v == true; save() end

    function api.getUsername()
        return (data.username ~= "" and data.username) or nil
    end
    function api.setUsername(v) data.username = tostring(v or ""); save() end

    function api.getAvatarUrl()
        return (data.avatarUrl ~= "" and data.avatarUrl) or nil
    end
    function api.setAvatarUrl(v) data.avatarUrl = tostring(v or ""); save() end

    function api.isEventEnabled(key) return data.events[key] == true end
    function api.setEventEnabled(key, on)
        if type(key) ~= "string" then return end
        data.events[key] = on == true or nil
        save()
    end
    -- replace the whole enabled set from a selection map/array (dropdown callback)
    function api.setEnabledFromSelection(selection, validKey)
        for k in pairs(data.events) do data.events[k] = nil end
        local picked = normalizeEvents(selection)
        for k in pairs(picked) do
            if not validKey or validKey(k) then data.events[k] = true end
        end
        save()
    end
    function api.getEnabledEvents()
        local out = {}
        for k, on in pairs(data.events) do if on then out[#out + 1] = k end end
        table.sort(out)
        return out
    end

    function api.getEventOption(key, optKey, fallback)
        local bucket = data.options[key]
        local v = bucket and bucket[optKey]
        if v == nil then return fallback end
        return v
    end
    function api.setEventOption(key, optKey, value)
        if type(key) ~= "string" or type(optKey) ~= "string" then return end
        local bucket = data.options[key]
        if not bucket then bucket = {}; data.options[key] = bucket end
        bucket[optKey] = value
        save()
    end

    api.save          = save
    api.flush         = writeNow                       -- write regardless of the suspend guard
    api.wasFresh      = function() return fresh end
    api.setSuspended  = function(v) suspendSave = v == true end
    api.isSuspended   = function() return suspendSave end

    return api
end

return M

end)
__bundle_register("Api/Webhook/Embed", function(require, _LOADED, __bundle_register, __bundle_modules)
-- webhook embed builder: turns a spec into a discord embed, applies theme defaults, truncates to discord's per-field limits, and scrubs player names when anonymize is on

local M = {}

-- discord embed field limits (over these the whole send 400s, so we truncate)
local LIMIT = {
    title       = 256,
    description  = 4096,
    fieldName   = 256,
    fieldValue  = 1024,
    fields      = 25,
    footer      = 2048,
    authorName  = 256,
}

local function truncate(s, max)
    s = tostring(s or "")
    if #s <= max then return s end
    return s:sub(1, max - 1) .. "…"
end

-- color3 or already-packed int -> discord's 0xrrggbb integer
local function discordColor(c)
    if type(c) == "number" then return math.floor(c) end
    if typeof(c) == "Color3" then
        return math.floor(c.R * 255) * 65536
            + math.floor(c.G * 255) * 256
            + math.floor(c.B * 255)
    end
    return nil
end
M.discordColor = discordColor

function M.new(Services)
    local Players = Services.Players

    -- weak-keyed escaped-pattern cache; stored name/display auto-invalidate on mid-session rename
    local escapedCache = setmetatable({}, { __mode = "k" })

    local function escapePattern(s)
        return tostring(s or ""):gsub("([^%w])", "%%%1")
    end

    local function getEscaped(plr)
        local entry = escapedCache[plr]
        local name = tostring(plr.Name or "")
        local display = tostring(plr.DisplayName or "")
        if entry and entry.name == name and entry.display == display then
            return entry
        end
        entry = {
            name       = name,
            display    = display,
            patName    = name ~= "" and escapePattern(name) or nil,
            patDisplay = (display ~= "" and display ~= name) and escapePattern(display) or nil,
        }
        escapedCache[plr] = entry
        return entry
    end

    -- replace player names with "Anonymous"; gsubs gated behind cheap plain-finds so no-match strings stay one scan
    local function anonymize(text)
        local out = tostring(text or "")
        if out == "" then return out end
        local hasAt = string.find(out, "@", 1, true) ~= nil
        for _, plr in ipairs(Players:GetPlayers()) do
            local e = getEscaped(plr)
            if e.patName and string.find(out, e.name, 1, true) then
                if hasAt then out = out:gsub("@" .. e.patName, "@Anonymous") end
                out = out:gsub(e.patName, "Anonymous")
            end
            if e.patDisplay and string.find(out, e.display, 1, true) then
                if hasAt then out = out:gsub("@" .. e.patDisplay, "@Anonymous") end
                out = out:gsub(e.patDisplay, "Anonymous")
            end
        end
        return out
    end

    -- spec = embed content; opts = live theme { defaultColor, anon, attribution, playerName, gameName }
    local function build(spec, opts)
        spec = spec or {}
        opts = opts or {}
        local anon = opts.anon == true
        local function clean(s) return anon and anonymize(s) or tostring(s or "") end

        local embed = {}

        if spec.title and spec.title ~= "" then
            embed.title = truncate(clean(spec.title), LIMIT.title)
        end
        if spec.description and spec.description ~= "" then
            embed.description = truncate(clean(spec.description), LIMIT.description)
        end
        if spec.url and spec.url ~= "" then embed.url = tostring(spec.url) end

        local color = discordColor(spec.color) or discordColor(opts.defaultColor)
        if color then embed.color = color end

        local fields = {}
        if type(spec.fields) == "table" then
            for _, f in ipairs(spec.fields) do
                if type(f) == "table" and f.name and f.value then
                    fields[#fields + 1] = {
                        name   = truncate(clean(f.name), LIMIT.fieldName),
                        value  = truncate(clean(f.value), LIMIT.fieldValue),
                        inline = f.inline == true,
                    }
                end
            end
        end

        -- session attribution unless a spec opts out or anon hides the player
        local wantAttribution = spec.attribution ~= false and opts.attribution ~= false
        if wantAttribution and not anon and opts.playerName then
            fields[#fields + 1] = { name = "Player", value = truncate(tostring(opts.playerName), LIMIT.fieldValue), inline = true }
        end
        if wantAttribution and opts.gameName then
            fields[#fields + 1] = { name = "Game", value = truncate(tostring(opts.gameName), LIMIT.fieldValue), inline = true }
        end

        if #fields > 0 then
            if #fields > LIMIT.fields then
                for i = #fields, LIMIT.fields + 1, -1 do fields[i] = nil end
            end
            embed.fields = fields
        end

        if type(spec.thumbnail) == "string" and spec.thumbnail ~= "" then
            embed.thumbnail = { url = spec.thumbnail }
        end
        if type(spec.image) == "string" and spec.image ~= "" then
            embed.image = { url = spec.image }
        end

        if type(spec.author) == "table" and spec.author.name then
            embed.author = { name = truncate(clean(spec.author.name), LIMIT.authorName) }
            if type(spec.author.icon) == "string" and spec.author.icon ~= "" then
                embed.author.icon_url = spec.author.icon
            end
        end

        if spec.footer ~= nil then
            local text, icon
            if type(spec.footer) == "table" then
                text, icon = spec.footer.text, spec.footer.icon
            else
                text = spec.footer
            end
            if text and text ~= "" then
                embed.footer = { text = truncate(clean(text), LIMIT.footer) }
                if type(icon) == "string" and icon ~= "" then embed.footer.icon_url = icon end
            end
        end

        if spec.timestamp == true then
            embed.timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
        elseif type(spec.timestamp) == "string" then
            embed.timestamp = spec.timestamp
        end

        return embed
    end

    return {
        build        = build,
        anonymize    = anonymize,
        discordColor = discordColor,
    }
end

return M

end)
__bundle_register("Api/Webhook/Transport", function(require, _LOADED, __bundle_register, __bundle_modules)
-- webhook http layer: enqueues built payloads onto a bounded fifo that one lazy worker paces out to discord, backing off + requeuing on rate-limit; the worker spawns on first send and exits when the queue drains, so it's idle-free

local Http = require("Utility/Helpers/Http")
local Jobs = require("Utility/Jobs")

-- pacing/backoff tunables, file-scoped so behaviour is visible at a glance
local MIN_GAP_SECONDS   = 0.75   -- min spacing between sends (burst-friendly, well under 429s)
local RATE_BACKOFF      = 2.0    -- fallback sleep on a 429 with no Retry-After
local TRANSIENT_BACKOFF = 3.0    -- sleep before re-sending after a timeout or 5xx
local MAX_ATTEMPTS      = 3      -- per-item send attempts before it's dropped
local MAX_PENDING       = 120    -- queue cap; oldest is dropped past this

local M = {}

local function statusOf(res)
    if type(res) ~= "table" then return nil end
    return tonumber(res.StatusCode or res.Status or res.status_code)
end

-- best-effort Retry-After (seconds) from a 429 response; executors vary in shape
local function retryAfter(res, decode)
    if type(res) ~= "table" then return nil end
    local h = res.Headers or res.headers
    if type(h) == "table" then
        local v = tonumber(h["Retry-After"] or h["retry-after"])
        if v then return v end
    end
    if type(res.Body) == "string" and res.Body ~= "" and type(decode) == "function" then
        local ok, decoded = pcall(decode, res.Body)
        if ok and type(decoded) == "table" and tonumber(decoded.retry_after) then
            return tonumber(decoded.retry_after)
        end
    end
    return nil
end

-- opts = { encode = fn(tbl)->str, decode = fn(str)->tbl, log, warn, onResult = fn(label, ok, status) }
function M.new(opts)
    local encode   = opts.encode
    local decode   = opts.decode
    local log      = opts.log or function() end
    local warn     = opts.warn or function() end
    local onResult = opts.onResult or function() end

    local queue = {}      -- FIFO of { url, payload, label, attempts }
    local head, tail = 1, 0
    local running = false
    local stopped = false
    local workerJob = nil

    local function pending()
        return tail - head + 1
    end

    -- fire the shared result hook + the per-send onDone (test pings await this) exactly once
    local function finish(item, ok, status)
        onResult(item.label, ok, status)
        local cb = item.onDone
        if cb then item.onDone = nil; pcall(cb, ok, status) end
    end

    -- one send. returns true on success, false to requeue (rate-limited), nil to drop
    local function sendOne(item)
        local okEnc, body = pcall(encode, item.payload)
        if not okEnc or type(body) ~= "string" then
            warn("payload encode failed: %s", tostring(body))
            finish(item, false, nil)
            return nil
        end

        local ok, res = Http.request({
            Url     = item.url,
            Method  = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body    = body,
        })

        local status = statusOf(res)
        if ok and (status == nil or (status >= 200 and status < 300)) then
            log("sent %s -> HTTP %s (%d queued)", tostring(item.label), tostring(status or "?"), pending() - 1)
            finish(item, true, status)
            return true
        end

        -- a timeout arrives as a transport failure with no status; requeue those alongside 429s and 5xx rather than losing the event
        if Http.isTransient(ok, res) then
            item.lastStatus = status
            local wait = (status == 429 and (retryAfter(res, decode) or RATE_BACKOFF)) or TRANSIENT_BACKOFF
            warn("%s on %s, retrying in %.2fs", status == 429 and "rate-limited" or "transient failure",
                tostring(item.label), wait)
            task.wait(wait)
            return false
        end

        warn("send %s failed (HTTP %s, ok=%s)", tostring(item.label), tostring(status), tostring(ok))
        finish(item, false, status)
        return nil
    end

    -- named local (not a literal) so the auto-wrapper leaves the worker virtualized — sub-30Hz pacer, no perf need, no secrets
    local function worker(job)
        while job.alive and not stopped and head <= tail do
            local item = queue[head]
            local verdict = sendOne(item)
            if verdict == false and item.attempts < MAX_ATTEMPTS then
                item.attempts = item.attempts + 1   -- keep at head, retry after the backoff
            else
                if verdict == false then
                    warn("dropping %s after %d attempts", tostring(item.label), item.attempts)
                    finish(item, false, item.lastStatus)
                end
                queue[head] = nil
                head = head + 1
            end
            if not stopped and head <= tail then
                if not job:sleep(MIN_GAP_SECONDS) then return end
            end
        end
        if head > tail then head, tail = 1, 0 end   -- reset indices when fully drained
        running = false
        workerJob = nil
    end

    -- onDone(ok, status) is an optional per-send result callback (used by test pings)
    local function post(url, payload, label, onDone)
        if stopped then return false, "transport stopped" end
        if type(url) ~= "string" or url == "" then return false, "no url" end
        if type(encode) ~= "function" then return false, "no encoder" end

        if pending() >= MAX_PENDING then
            local dropped = queue[head]
            queue[head] = nil
            head = head + 1
            warn("queue full (%d) — dropped oldest (%s)", MAX_PENDING, dropped and tostring(dropped.label) or "?")
            if dropped then finish(dropped, false, nil) end
        end

        tail = tail + 1
        queue[tail] = { url = url, payload = payload, label = label or "event", attempts = 1, onDone = onDone }

        if not running then
            running = true
            workerJob = Jobs.spawn(worker, { name = "WebhookQueue" })
        end
        return true
    end

    local function stop()
        stopped = true
        -- cancel rather than let the worker notice: it may be parked in a 3s transient backoff
        if workerJob then workerJob:Cancel(); workerJob = nil end
        running = false
        for i = head, tail do queue[i] = nil end
        head, tail = 1, 0
    end

    return {
        post    = post,
        stop    = stop,
        pending = pending,
    }
end

return M

end)
__bundle_register("Api/Esp", function(require, _LOADED, __bundle_register, __bundle_modules)
-- esp api: from-scratch Drawing engine (box/box3d/name/distance/health/tracer/arrow/skeleton + chams) over a group registry; built once at boot, shared as ctx.Api.Esp

local Api         = require("Api")
local EntityIndex = require("Utility/EntityIndex")
local Identity    = require("Utility/Identity")
local Scheduler   = require("Utility/Scheduler")
local UiHost      = require("UI/UiHost")
local Groups      = require("Api/Esp/Groups")
local Object      = require("Api/Esp/Object")

local M = {}

function M.new(ctx)
    local base = Api.define("Esp", ctx)
    local Services = ctx.Services
    local References = ctx.References
    local Workspace = Services.Workspace

    local hasDrawing = type(Drawing) == "table" and type(Drawing.new) == "function"

    local index  = EntityIndex.get(ctx)
    local groups = Groups.new({ index = index })
    local shared = { textSize = 13, textFont = 2 }

    local container = Instance.new("Folder")
    pcall(function() container.Parent = UiHost.pick() end)
    base.maid:GiveTask(function() pcall(container.Destroy, container) end)

    local deps = { container = container }
    local objects = {}       -- key -> { [instance] = Object }
    local lastRescan = {}
    local groupList = groups.List()  -- cached so the per-frame rescan loop allocates nothing; refreshed on RegisterGroup

    -- drawings live in each object's bin (not in the container), so tear them all down on unload
    base.maid:GiveTask(function()
        for _, bucket in pairs(objects) do
            for inst, obj in pairs(bucket) do obj:Destruct(); bucket[inst] = nil end
        end
    end)

    local function localRoot()
        local char = References.player and References.player.Character
        return char and char:FindFirstChild("HumanoidRootPart")
    end

    local function targetPosition(t)
        local inst = t.instance
        if t.kind == "player" then
            local ch = inst.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            return hrp and hrp.Position
        end
        if not inst.Parent then return nil end
        local hrp = inst:FindFirstChild("HumanoidRootPart") or inst.PrimaryPart
        if hrp then return hrp.Position end
        local ok, pivot = pcall(inst.GetPivot, inst)
        return ok and pivot.Position or nil
    end

    -- reconcile a group's live objects with its source list; distance-capped at maxTracked so nearest targets win
    local function rescan(gd)
        local cfg = gd.config
        local bucket = objects[gd.key]
        if not bucket then bucket = {}; objects[gd.key] = bucket end

        if not (cfg.enabled and hasDrawing) then
            for inst, obj in pairs(bucket) do obj:Destruct(); bucket[inst] = nil end
            return
        end

        local ok, targets = pcall(gd.source, gd)
        if not ok or type(targets) ~= "table" then return end

        local cap = cfg.maxTracked or 100
        if #targets > cap then
            local root = localRoot()
            local myPos = root and root.Position
            if myPos then
                for _, t in ipairs(targets) do
                    local p = targetPosition(t)
                    t._d = p and (p - myPos).Magnitude or math.huge
                end
                table.sort(targets, function(a, b) return a._d < b._d end)
            end
        end

        local present = {}
        for i = 1, math.min(#targets, cap) do present[targets[i].instance] = targets[i] end

        for inst, obj in pairs(bucket) do
            if not present[inst] then obj:Destruct(); bucket[inst] = nil end
        end
        for inst, t in pairs(present) do
            if not bucket[inst] then bucket[inst] = Object.new(t, cfg, shared, deps) end
        end
    end

    -- each lane elevates on every wake: a scheduler callback runs below the identity an instance read or a Highlight needs, and it does not keep what it set last frame
    -- own throttle rather than the lane interval: refreshInterval is per group and live-editable
    base.maid:GiveTask(Scheduler.heartbeat(function()
        Identity.elevate()
        local now = os.clock()
        for _, entry in ipairs(groupList) do
            local gd = groups.Get(entry.key)
            if gd then
                local interval = gd.config.refreshInterval or 1.0
                if now - (lastRescan[entry.key] or 0) >= interval then
                    lastRescan[entry.key] = now
                    rescan(gd)
                end
            end
        end
    end, { name = "EspRescan", priority = 210, deferrable = true }))

    -- a throwing object is torn down, not left to spam
    base.maid:GiveTask(Scheduler.render(function()
        Identity.elevate()
        local camera = Workspace.CurrentCamera
        if not camera then return end
        local viewport = camera.ViewportSize
        for _, bucket in pairs(objects) do
            for inst, obj in pairs(bucket) do
                local ok = pcall(obj.Tick, obj, camera, viewport)
                if not ok then obj:Destruct(); bucket[inst] = nil end
            end
        end
    end, { name = "EspDraw", priority = 205, deferrable = true }))

    if not hasDrawing then base.warn("Drawing api unavailable — esp will not render") end
    base.log("esp api ready (drawing=%s)", tostring(hasDrawing))

    return {
        RegisterGroup  = function(def)
            local ok = groups.Register(def)
            if ok then groupList = groups.List() end
            return ok
        end,
        GetGroupList   = function() return groups.List() end,
        GetGroupConfig = function(key) local g = groups.Get(key); return g and g.config end,
        SetGroupConfig = function(key, partial) groups.SetConfig(key, partial) end,
        SetEnabled     = function(key, on) groups.SetConfig(key, { enabled = on == true }) end,
        SetShared      = function(cfg) if type(cfg) == "table" then for k, v in pairs(cfg) do shared[k] = v end end end,
        GetShared      = function() return shared end,
        -- apply one field across every group (drives the universal ui controls)
        SetAllGroups   = function(partial)
            for _, entry in ipairs(groups.List()) do groups.SetConfig(entry.key, partial) end
        end,
        HasDrawing     = function() return hasDrawing end,
    }
end

return M

end)
__bundle_register("Api/Esp/Object", function(require, _LOADED, __bundle_register, __bundle_modules)
-- one config-driven visual per target: reused Drawing bin (box/box3d/fill/name/distance/health/tracer/arrow/skeleton) + chams Highlight; Update/Render are the per-frame hot path, native-speed in the unobfuscated half

local Geometry = require("Api/Esp/Geometry")

local round = math.round
local HEALTH_BAR_OFFSET = Vector2.new(5, 0)
local NAME_OFFSET = Vector2.new(0, 2)
local DISTANCE_OFFSET = Vector2.new(0, 2)
local SKELETON_MAX = 16

local Object = {}
Object.__index = Object

local function create(bin, class, props)
    local drawing = Drawing.new(class)
    for prop, value in next, props do
        pcall(function() drawing[prop] = value end)
    end
    bin[#bin + 1] = drawing
    return drawing
end

function Object.new(target, group, shared, deps)
    local self = setmetatable({}, Object)
    self.instance = target.instance
    self.kind     = target.kind          -- "player" | "entity" | "object"
    self.label    = type(target.label) == "string" and target.label or nil -- a source may name its targets ("Ball") instead of the raw instance name
    self.group    = group                -- live config ref (group.config)
    self.shared   = shared
    self.deps     = deps
    self.bin      = {}
    self.charCache = {}
    self.childCount = 0

    local bin = self.bin
    -- drawing order = creation order, so a fill/outline must be created before the element it sits behind or it paints over it
    self.boxFill     = create(bin, "Square", { Filled = true, Visible = false })
    self.boxOutline  = create(bin, "Square", { Thickness = 3, Filled = false, Visible = false })
    self.box         = create(bin, "Square", { Thickness = 1, Filled = false, Visible = false })

    self.box3d = {}
    for _ = 1, 12 do self.box3d[#self.box3d + 1] = create(bin, "Line", { Thickness = 1, Visible = false }) end
    self.skeleton = {}
    for _ = 1, SKELETON_MAX do self.skeleton[#self.skeleton + 1] = create(bin, "Line", { Visible = false }) end

    self.healthOutln = create(bin, "Line", { Thickness = 3, Visible = false })
    self.healthBar   = create(bin, "Line", { Thickness = 1, Visible = false })
    self.tracerOutln = create(bin, "Line", { Thickness = 3, Visible = false })
    self.tracer      = create(bin, "Line", { Thickness = 1, Visible = false })
    self.arrowOutln  = create(bin, "Triangle", { Thickness = 3, Visible = false })
    self.arrow       = create(bin, "Triangle", { Filled = true, Visible = false })
    self.healthText  = create(bin, "Text", { Center = true, Visible = false })
    self.name        = create(bin, "Text", { Center = true, Visible = false })
    self.distance    = create(bin, "Text", { Center = true, Visible = false })

    self.highlight = Instance.new("Highlight")
    self.highlight.Enabled = false
    self.highlight.Parent = deps.container

    return self
end

function Object:Destruct()
    for i = 1, #self.bin do pcall(self.bin[i].Remove, self.bin[i]) end
    if self.highlight then pcall(self.highlight.Destroy, self.highlight) end
    table.clear(self)
end

-- team color for players; falls back to the configured color
function Object:resolveColor(color)
    if self.group.teamColor and self.kind == "player" then
        local team = self.instance.Team
        if team then return team.TeamColor.Color end
    end
    return color
end

Object.Update = function(self, camera, viewport)
    local inst = self.instance
    local group = self.group

    local character
    if self.kind == "player" then
        character = inst.Character
    elseif inst.Parent then
        character = inst
    end
    self.character = character

    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        self.health, self.maxHealth = humanoid.Health, humanoid.MaxHealth
        local dead = humanoid.Health <= 0 or humanoid:GetState() == Enum.HumanoidStateType.Dead
        self.enabled = group.enabled and not dead
    else
        self.health, self.maxHealth = nil, nil
        self.enabled = group.enabled and (character ~= nil or (self.kind == "object" and inst.Parent ~= nil))
    end

    self.displayName = self.label
        or (self.kind == "player" and ((inst.DisplayName ~= "" and inst.DisplayName) or inst.Name))
        or (character and character.Name) or inst.Name

    -- anchor: head/root for a character, else the instance pivot
    local anchor
    if character then
        anchor = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
            or character.PrimaryPart
    end
    local world = anchor and anchor.Position or (inst.Parent and inst:GetPivot().Position)
    if not (self.enabled and world) then
        self.onScreen = false
        return
    end

    local screen, onScreen, depth = Geometry.worldToScreen(camera, world)
    self.distanceStuds = depth
    if group.limitDistance and depth > group.maxDistance then onScreen = false end
    self.onScreen = onScreen
    self.screenPoint = screen
    self.corners = nil -- recomputed below; a humanoid gets a box, a bare instance stays a label

    if onScreen then
        if character then
            local cache = self.charCache
            local children = character:GetChildren()
            if not cache[1] or self.childCount ~= #children then
                table.clear(cache)
                for i = 1, #children do
                    local part = children[i]
                    if part:IsA("BasePart") and Geometry.isBodyPart(part.Name) then cache[#cache + 1] = part end
                end
                self.childCount = #children
            end
            if cache[1] then
                local cf, size = Geometry.boundingBox(cache)
                if cf then self.corners = Geometry.corners(camera, viewport, cf, size) end
            elseif self.kind ~= "player" and character:IsA("Model") then
                -- a plain model with no body parts (a ball, a prop) is boxed by its own extents
                local okB, cf, size = pcall(character.GetBoundingBox, character)
                if okB and cf then self.corners = Geometry.corners(camera, viewport, cf, size) end
            end
        end
    elseif group.arrow and group.arrow.enabled then
        local cf = camera.CFrame
        local flat = CFrame.fromMatrix(cf.Position, cf.RightVector, Vector3.yAxis)
        local os = flat:PointToObjectSpace(world)
        self.direction = Vector2.new(os.X, os.Z).Unit
    end
end

Object.Render = function(self, camera, viewport)
    local group = self.group
    local shared = self.shared
    local onScreen = self.onScreen or false
    local enabled = self.enabled or false
    local corners = self.corners
    local textSize = shared.textSize or 13
    local textFont = shared.textFont or 2

    -- chams render independent of on-screen
    local chams = group.chams
    self.highlight.Enabled = enabled and chams and chams.enabled and self.character ~= nil
    if self.highlight.Enabled then
        self.highlight.Adornee = self.character
        self.highlight.FillColor = self:resolveColor(chams.fillColor)
        self.highlight.FillTransparency = chams.fillTransparency
        self.highlight.OutlineColor = chams.outlineColor
        self.highlight.OutlineTransparency = chams.outlineTransparency
        self.highlight.DepthMode = chams.visibleOnly and Enum.HighlightDepthMode.Occluded or Enum.HighlightDepthMode.AlwaysOnTop
    end

    local drawBox = enabled and onScreen and corners ~= nil
    local box, boxCfg = group.box, group.box
    self.box.Visible = drawBox and box.enabled
    self.boxOutline.Visible = self.box.Visible and box.outline
    if self.box.Visible then
        self.box.Position = corners.topLeft
        self.box.Size = corners.bottomRight - corners.topLeft
        self.box.Color = self:resolveColor(box.color)
        self.box.Transparency = box.transparency
        self.box.Thickness = box.thickness or 1
        if self.boxOutline.Visible then
            self.boxOutline.Position = corners.topLeft
            self.boxOutline.Size = self.box.Size
            self.boxOutline.Color = box.outlineColor
            self.boxOutline.Transparency = box.transparency
        end
    end

    local fill = group.boxFill
    self.boxFill.Visible = drawBox and fill.enabled
    if self.boxFill.Visible then
        self.boxFill.Position = corners.topLeft
        self.boxFill.Size = corners.bottomRight - corners.topLeft
        self.boxFill.Color = self:resolveColor(fill.color)
        self.boxFill.Transparency = fill.transparency
    end

    local health = group.health
    local haveHealth = self.health ~= nil and self.maxHealth ~= nil and self.maxHealth > 0
    local ratio = haveHealth and (self.health / self.maxHealth) or 1
    self.healthBar.Visible = drawBox and health.bar and haveHealth
    self.healthOutln.Visible = self.healthBar.Visible and health.outline
    if self.healthBar.Visible then
        local barTo = corners.bottomLeft - HEALTH_BAR_OFFSET
        local barFrom = corners.topLeft - HEALTH_BAR_OFFSET
        self.healthBar.To = barTo
        self.healthBar.From = barTo:Lerp(barFrom, ratio)
        self.healthBar.Color = health.dyingColor:Lerp(health.healthyColor, ratio)
        if self.healthOutln.Visible then
            self.healthOutln.To = barTo + Vector2.new(0, 1)
            self.healthOutln.From = barFrom - Vector2.new(0, 1)
            self.healthOutln.Color = health.outlineColor
        end
    end
    self.healthText.Visible = drawBox and health.text and haveHealth
    if self.healthText.Visible then
        local barFrom = corners.topLeft - HEALTH_BAR_OFFSET
        local barTo = corners.bottomLeft - HEALTH_BAR_OFFSET
        local t = self.healthText
        t.Text = round(self.health) .. "hp"
        t.Size = textSize; t.Font = textFont
        t.Color = health.textColor or Color3.new(1, 1, 1)
        t.Outline = true
        t.Position = barTo:Lerp(barFrom, ratio) - t.TextBounds * 0.5 - Vector2.new(3, 0)
    end

    -- text/tracer anchor: box edges for a humanoid, else the projected point (label esp)
    local labelTop = corners and (corners.topLeft + corners.topRight) * 0.5 or self.screenPoint
    local labelBottom = corners and (corners.bottomLeft + corners.bottomRight) * 0.5 or self.screenPoint

    local name = group.name
    self.name.Visible = enabled and onScreen and name.enabled and labelTop ~= nil
    if self.name.Visible then
        local n = self.name
        n.Text = self.displayName
        n.Size = textSize; n.Font = textFont
        n.Color = self:resolveColor(name.color)
        n.Transparency = name.transparency
        n.Outline = name.outline
        n.OutlineColor = name.outlineColor
        n.Position = labelTop - Vector2.new(0, n.TextBounds.Y) - NAME_OFFSET
    end

    local dist = group.distance
    self.distance.Visible = enabled and onScreen and dist.enabled and self.distanceStuds ~= nil and labelBottom ~= nil
    if self.distance.Visible then
        local d = self.distance
        d.Text = round(self.distanceStuds) .. " studs"
        d.Size = textSize; d.Font = textFont
        d.Color = self:resolveColor(dist.color)
        d.Transparency = dist.transparency
        d.Outline = dist.outline
        d.OutlineColor = dist.outlineColor
        d.Position = labelBottom + DISTANCE_OFFSET
    end

    local tracer = group.tracer
    self.tracer.Visible = enabled and onScreen and tracer.enabled and labelBottom ~= nil
    self.tracerOutln.Visible = self.tracer.Visible and tracer.outline
    if self.tracer.Visible then
        local origin = tracer.origin
        local from = origin == "Top" and viewport * Vector2.new(0.5, 0)
            or origin == "Middle" and viewport * 0.5
            or viewport * Vector2.new(0.5, 1)
        local to = labelBottom
        self.tracer.From = from; self.tracer.To = to
        self.tracer.Color = self:resolveColor(tracer.color)
        self.tracer.Transparency = tracer.transparency
        if self.tracerOutln.Visible then
            self.tracerOutln.From = from; self.tracerOutln.To = to
            self.tracerOutln.Color = tracer.outlineColor
        end
    end

    local box3d = group.box3d
    local draw3d = enabled and onScreen and box3d.enabled and corners ~= nil
    for i = 0, 3 do
        for j = 1, 3 do
            local line = self.box3d[i * 3 + j]
            line.Visible = draw3d
            if draw3d then
                line.Color = self:resolveColor(box3d.color)
                line.Transparency = box3d.transparency
                line.Thickness = box3d.thickness or 1
            end
        end
        if draw3d then
            local c = corners.corners
            local idx = i + 1
            self.box3d[i * 3 + 1].From = c[idx]; self.box3d[i * 3 + 1].To = c[idx == 4 and 1 or idx + 1]
            self.box3d[i * 3 + 2].From = c[idx == 4 and 1 or idx + 1]; self.box3d[i * 3 + 2].To = c[idx == 4 and 5 or idx + 5]
            self.box3d[i * 3 + 3].From = c[idx == 4 and 5 or idx + 5]; self.box3d[i * 3 + 3].To = c[idx == 4 and 8 or idx + 4]
        end
    end

    local skel = group.skeleton
    local drawSkel = enabled and onScreen and skel.enabled and self.character ~= nil
    local used = 0
    if drawSkel then
        local hum = self.character:FindFirstChildOfClass("Humanoid")
        local bones = Geometry.bones(self.character, hum)
        local color = self:resolveColor(skel.color)
        for b = 1, #bones do
            if used >= SKELETON_MAX then break end
            local p1 = self.character:FindFirstChild(bones[b][1])
            local p2 = self.character:FindFirstChild(bones[b][2])
            if p1 and p2 then
                local s1, on1 = Geometry.worldToScreen(camera, p1.Position)
                local s2, on2 = Geometry.worldToScreen(camera, p2.Position)
                if on1 and on2 then
                    used = used + 1
                    local line = self.skeleton[used]
                    line.Visible = true
                    line.From = s1; line.To = s2
                    line.Color = color
                    line.Transparency = skel.transparency
                    line.Thickness = skel.thickness or 1
                end
            end
        end
    end
    for k = used + 1, SKELETON_MAX do self.skeleton[k].Visible = false end

    local arrow = group.arrow
    self.arrow.Visible = enabled and (not onScreen) and arrow.enabled and self.direction ~= nil
    self.arrowOutln.Visible = self.arrow.Visible and arrow.outline
    if self.arrow.Visible then
        local center = viewport * 0.5
        local a = center + self.direction * arrow.radius
        a = a:Max(Vector2.one * 25):Min(viewport - Vector2.one * 25)
        local b = a - Geometry.rotateVector(self.direction, 0.45) * arrow.size
        local c = a - Geometry.rotateVector(self.direction, -0.45) * arrow.size
        self.arrow.PointA = a; self.arrow.PointB = b; self.arrow.PointC = c
        self.arrow.Color = self:resolveColor(arrow.color)
        self.arrow.Transparency = arrow.transparency
        if self.arrowOutln.Visible then
            self.arrowOutln.PointA = a; self.arrowOutln.PointB = b; self.arrowOutln.PointC = c
            self.arrowOutln.Color = arrow.outlineColor
        end
    end
end

function Object:Tick(camera, viewport)
    self:Update(camera, viewport)
    self:Render(camera, viewport)
end

return Object

end)
__bundle_register("Api/Esp/Geometry", function(require, _LOADED, __bundle_register, __bundle_modules)
-- projection + bounding-box + rig/skeleton math for the esp renderer; hot per-frame helpers run native-speed in the unobfuscated half

local floor = math.floor

local VERTICES = {
    Vector3.new(-1, -1, -1), Vector3.new(-1, 1, -1), Vector3.new(-1, 1, 1), Vector3.new(-1, -1, 1),
    Vector3.new(1, -1, -1),  Vector3.new(1, 1, -1),  Vector3.new(1, 1, 1),  Vector3.new(1, -1, 1),
}

-- adjacent part-name pairs to connect with a line
local R15_BONES = {
    { "Head", "UpperTorso" }, { "UpperTorso", "LowerTorso" },
    { "UpperTorso", "LeftUpperArm" }, { "LeftUpperArm", "LeftLowerArm" }, { "LeftLowerArm", "LeftHand" },
    { "UpperTorso", "RightUpperArm" }, { "RightUpperArm", "RightLowerArm" }, { "RightLowerArm", "RightHand" },
    { "LowerTorso", "LeftUpperLeg" }, { "LeftUpperLeg", "LeftLowerLeg" }, { "LeftLowerLeg", "LeftFoot" },
    { "LowerTorso", "RightUpperLeg" }, { "RightUpperLeg", "RightLowerLeg" }, { "RightLowerLeg", "RightFoot" },
}
local R6_BONES = {
    { "Head", "Torso" },
    { "Torso", "Left Arm" }, { "Torso", "Right Arm" },
    { "Torso", "Left Leg" }, { "Torso", "Right Leg" },
}

local M = {}

function M.isBodyPart(name)
    return name == "Head" or name:find("Torso") or name:find("Leg") or name:find("Arm")
end

-- rig from Humanoid.RigType, falling back to part presence
function M.bones(character, humanoid)
    local rig = humanoid and humanoid.RigType
    if rig == Enum.HumanoidRigType.R15 then return R15_BONES end
    if rig == Enum.HumanoidRigType.R6 then return R6_BONES end
    return character:FindFirstChild("UpperTorso") and R15_BONES or R6_BONES
end

M.worldToScreen = function(camera, world)
    local screen, onScreen = camera:WorldToViewportPoint(world)
    return Vector2.new(screen.X, screen.Y), onScreen, screen.Z
end

M.rotateVector = function(vector, radians)
    local x, y = vector.X, vector.Y
    local c, s = math.cos(radians), math.sin(radians)
    return Vector2.new(x * c - y * s, x * s + y * c)
end

M.boundingBox = function(parts)
    local min, max
    for i = 1, #parts do
        local cframe, size = parts[i].CFrame, parts[i].Size
        min = (min or cframe.Position):Min((cframe - size * 0.5).Position)
        max = (max or cframe.Position):Max((cframe + size * 0.5).Position)
    end
    if not min then return nil end
    local center = (min + max) * 0.5
    return CFrame.new(center, Vector3.new(center.X, center.Y, max.Z)), max - min
end

M.corners = function(camera, viewportSize, cframe, size)
    local corners = table.create(8)
    for i = 1, 8 do
        local screen = camera:WorldToViewportPoint((cframe + size * 0.5 * VERTICES[i]).Position)
        corners[i] = Vector2.new(screen.X, screen.Y)
    end
    local min = viewportSize:Min(table.unpack(corners))
    local max = Vector2.zero:Max(table.unpack(corners))
    return {
        corners = corners,
        topLeft = Vector2.new(floor(min.X), floor(min.Y)),
        topRight = Vector2.new(floor(max.X), floor(min.Y)),
        bottomLeft = Vector2.new(floor(min.X), floor(max.Y)),
        bottomRight = Vector2.new(floor(max.X), floor(max.Y)),
    }
end

return M

end)
__bundle_register("Utility/EntityIndex", function(require, _LOADED, __bundle_register, __bundle_modules)
-- shared session-wide target index (non-local players + non-player humanoid models); workspace listeners start lazily on first entities() call

local M = {}

local shared = nil

local function build(ctx)
    local Services   = ctx.Services
    local References = ctx.References

    local maid = (ctx.NewMaid and ctx.NewMaid())
        or (ctx.Maid and type(ctx.Maid.new) == "function" and ctx.Maid.new())
        or nil

    local entityModels  = {}
    local playerCharSet = {}
    local entityReady   = false

    local function rebuildPlayerCharSet()
        table.clear(playerCharSet)
        for _, plr in ipairs(Services.Players:GetPlayers()) do
            if plr.Character then playerCharSet[plr.Character] = true end
        end
    end

    local function isPlayerModelName(name)
        return type(name) == "string" and name ~= ""
            and Services.Players:FindFirstChild(name) ~= nil
    end

    local function shouldTrack(model)
        if not (model and model:IsA("Model") and model.Parent) then return false end
        if Services.Players:GetPlayerFromCharacter(model) then return false end
        if isPlayerModelName(model.Name) then return false end
        if playerCharSet[model] then return false end
        return model:FindFirstChildOfClass("Humanoid") ~= nil
    end

    local function ensureEntityIndex()
        if entityReady then return end
        entityReady = true
        table.clear(entityModels)
        rebuildPlayerCharSet()
        for _, d in ipairs(Services.Workspace:GetDescendants()) do
            if d:IsA("Humanoid") then
                local model = d.Parent
                if shouldTrack(model) then entityModels[model] = true end
            end
        end
        if not maid then return end
        maid:GiveTask(Services.Workspace.DescendantAdded:Connect(function(d)
            if d:IsA("Humanoid") then
                local model = d.Parent
                if shouldTrack(model) then entityModels[model] = true end
            end
        end))
        maid:GiveTask(Services.Workspace.DescendantRemoving:Connect(function(d)
            if d:IsA("Humanoid") then
                local model = d.Parent
                if model then entityModels[model] = nil end
                return
            end
            if d:IsA("Model") then entityModels[d] = nil; playerCharSet[d] = nil end
        end))
    end

    -- optional narrowing by workspace folder, CollectionService tag or predicate; no options = every non-player humanoid
    local function passesOptions(model, options)
        if not options then return true end
        if options.predicate then
            local ok, pass = pcall(options.predicate, model)
            if not ok or not pass then return false end
        end
        if options.tag and not Services.CollectionService:HasTag(model, options.tag) then
            return false
        end
        if options.folders then
            local inFolder = false
            for _, name in ipairs(options.folders) do
                local folder = Services.Workspace:FindFirstChild(name)
                if folder and model:IsDescendantOf(folder) then inFolder = true; break end
            end
            if not inFolder then return false end
        end
        return true
    end

    -- eager player-character tracking (cheap, needed for exclusion + players())
    rebuildPlayerCharSet()
    local function trackPlayer(plr)
        if not maid then return end
        maid:GiveTask(plr.CharacterAdded:Connect(function(char)
            playerCharSet[char] = true
            entityModels[char] = nil
        end))
        maid:GiveTask(plr.CharacterRemoving:Connect(function(char)
            playerCharSet[char] = nil
            entityModels[char] = nil
        end))
    end
    if maid then
        maid:GiveTask(Services.Players.PlayerAdded:Connect(function(plr)
            trackPlayer(plr)
            rebuildPlayerCharSet()
        end))
    end
    for _, plr in ipairs(Services.Players:GetPlayers()) do trackPlayer(plr) end

    local function players()
        local out = {}
        -- compare by UserId, not reference: References.player is a cloneref, so `plr ~= it` never excludes self
        local localId = (References.player and References.player.UserId)
            or (Services.Players.LocalPlayer and Services.Players.LocalPlayer.UserId)
        for _, plr in ipairs(Services.Players:GetPlayers()) do
            if plr.UserId ~= localId then out[#out + 1] = plr end
        end
        return out
    end

    local function entities(options)
        ensureEntityIndex()
        local out = {}
        for model in pairs(entityModels) do
            if model and model.Parent and not playerCharSet[model] then
                if passesOptions(model, options) then out[#out + 1] = model end
            else
                entityModels[model] = nil
            end
        end
        return out
    end

    if maid and ctx.Unloader and type(ctx.Unloader.Register) == "function" then
        ctx.Unloader:Register(function()
            maid:DoCleaning()
            shared = nil
        end)
    end

    return { players = players, entities = entities }
end

function M.get(ctx)
    if not shared then shared = build(ctx) end
    return shared
end

return M

end)
__bundle_register("Api/Profile", function(require, _LOADED, __bundle_register, __bundle_modules)
-- profile api: the player's saved profile kept current from the game's own update events, plus the rolls, slot picks and free claims the game's own buttons send; a verb the game's client would refuse is refused here before any remote, and nothing here spends gems or robux
local Jobs   = require("Utility/Jobs")
local Api    = require("Api")
local Cache  = require("Api/Profile/Cache")
local Claims = require("Api/Profile/Claims")
local Errors = require("Api/Profile/Errors")
local Rules  = require("Api/Profile/Rules")

local PATH = {
    Season           = "ReplicatedStorage.Content.Season",
    Quest            = "ReplicatedStorage.Content.Quest",
    Style            = "ReplicatedStorage.Content.Style",
    Ability          = "ReplicatedStorage.Content.Ability",
    Mastery          = "ReplicatedStorage.Content.Mastery",
    MasteryTree      = "ReplicatedStorage.Content.Mastery.MasteryTree",
    Level            = "ReplicatedStorage.Content.Level",
    ChallengeRewards = "ReplicatedStorage.Content.ChallengeRewards",
    TimedPresent     = "ReplicatedStorage.Content.TimedPresent",
    Ranks            = "ReplicatedStorage.Configuration.Ranks",
    Matchmaking      = "ReplicatedStorage.Configuration.Matchmaking",
    Rarity           = "ReplicatedStorage.Configuration.Rarity",
    Requirements     = "ReplicatedStorage.Configuration.Requirements",
    DropChance       = "ReplicatedStorage.Tools.DropChance",
}

local KINDS = { Style = "StyleService", Ability = "AbilityService" }

-- C.StyleController:134-141, C.AbilityController:145-150
local SPIN_FIELDS = {
    Style   = { normal = "StyleSpins",   lucky = "StyleLuckySpins" },
    Ability = { normal = "AbilitySpins", lucky = "AbilityLuckySpins" },
}

-- player attributes are keyed "<Id>_<Key>" (RS.Common.State:5-23)
local LEVEL_ATTRIBUTE        = "User_Level"
local FORCED_STYLE_ATTRIBUTE = "Gameplay_ForcedStyle"

-- the spin button's cooldown after every roll (C.StyleController:586-591,632)
local ROLL_COOLDOWN = 0.5

local SURFACE = {
    "get", "refresh", "currencies", "spins", "pity", "slots", "current", "season", "rank", "quests",
    "odds", "info", "claimable", "roll", "selectSlot", "toggleLock", "boost", "claimQuest",
    "claimAllQuests", "claimSeasonTier", "claimMilestone", "claimChallenge", "claimMastery",
    "claimLevelRewards", "claimDailyPresent", "redeemCode",
}

local M = {}

local function inert(changed, level)
    local api = {
        Errors   = Errors,
        changed  = changed,
        level    = level,
        isLoaded = function() return false end,
        peek     = function() return nil end,
    }
    for _, name in ipairs(SURFACE) do
        api[name] = function() return false, Errors.NO_NET end
    end
    return api
end

function M.new(ctx)
    local base       = Api.define("Profile", ctx)
    local maid       = base.maid
    local References = ctx.References
    local changed    = base.signal()

    local function attribute(name)
        local player = References and References.player
        if not player then return nil end
        local ok, value = pcall(player.GetAttribute, player, name)
        if ok then return value end
        return nil
    end

    -- C.LevelRewardsController:32
    local function level()
        local value = attribute(LEVEL_ATTRIBUTE)
        return type(value) == "number" and value or 0
    end

    local Net = ctx.Api and ctx.Api.Net
    if type(Net) ~= "table" then
        base.warn("net api missing; every profile read answers no_net")
        return inert(changed, level)
    end

    local function mod(path)
        local ok, value = Net.module(path)
        if ok and type(value) == "table" then return value end
        return nil
    end

    -- the season every ui slice is keyed by: the highest Content.Season entity, "-1" when there is none (RS.Content.Season:42-52, C.InterfaceController:40,127)
    local function seasonNow()
        local Season = mod(PATH.Season)
        if not Season or type(Season.getCurrent) ~= "function" then return nil end
        local ok, season = pcall(Season.getCurrent)
        if not ok then return nil end
        if type(season) ~= "table" then return "-1", nil end
        return season.Id or "-1", season
    end

    local cache = Cache.new({
        Net      = Net,
        base     = base,
        changed  = changed,
        seasonId = function() return (seasonNow()) end,
    })

    -- the current season's slice the way the ui binds it, {} until the season has data (C.InterfaceController:126-133); (slice, id, season) or (nil, err)
    local function currentSlice()
        local all = cache.held("Seasonal")
        if not all then return nil, Errors.NOT_LOADED end
        local id, season = seasonNow()
        if not id then return nil, Errors.NO_DATA end
        return Rules.tableOr(all[id]), id, season
    end

    -- yields on a miss
    local function freshSlice()
        local all, err = cache.need("Seasonal")
        if not all then return nil, err end
        return currentSlice()
    end

    local function overall(slice)
        local Ranks, Matchmaking = mod(PATH.Ranks), mod(PATH.Matchmaking)
        if not (Ranks and Matchmaking) then return nil end
        return Ranks, Rules.overallRank(Ranks, Matchmaking, slice.Ranked)
    end

    -- C.StyleController:164-165,197-207
    local function forcedStyle()
        return attribute(FORCED_STYLE_ATTRIBUTE)
    end

    local function questEntry(index, def, state, live)
        state = Rules.tableOr(state)
        local hasDef = type(def) == "table"
        return {
            index       = index,
            id          = hasDef and def.Id or nil,
            description = hasDef and def.Description or nil,
            reward      = hasDef and def.Reward or nil,
            requirement = hasDef and Rules.number(def.Requirement) or 0,
            progress    = Rules.number(state.Progress),
            claimed     = not not state.Claimed,
            claimable   = live and Rules.questDone(def, state) or false,
        }
    end

    -- seasonal definitions are the season's own Quests, daily ones the profile's serialized entries (C.SeasonController.Quests:18-23,95-136, C.SeasonController.Quests.Quest:12-18); (list, live) or (nil, err)
    local function questList(isSeasonal)
        local id, season = seasonNow()
        if not id then return nil, Errors.NO_DATA end
        local live = Rules.isLive(season)
        local list = {}
        if isSeasonal then
            local all = cache.held("Seasonal")
            if not all then return nil, Errors.NOT_LOADED end
            local states = Rules.tableOr(Rules.tableOr(all[id]).Quests)
            for index, def in ipairs(Rules.tableOr(season and season.Quests)) do
                list[#list + 1] = questEntry(index, def, states[index], live)
            end
            return list, live
        end
        local daily = cache.held("Quests")
        if not daily then return nil, Errors.NOT_LOADED end
        local Quest = mod(PATH.Quest)
        if not Quest then return nil, Errors.NO_DATA end
        local raws = Rules.tableOr(daily.Quests)
        local indices = {}
        for index in pairs(raws) do
            if Rules.isIndex(index) then indices[#indices + 1] = index end
        end
        table.sort(indices)
        for _, index in ipairs(indices) do
            local raw = raws[index]
            local ok, def = pcall(Quest.deserialize, raw)
            list[#list + 1] = questEntry(index, ok and def or nil, raw, live)
        end
        return list, live
    end

    -- a read never throws into a feature; a game module of an unexpected shape answers no_data
    local function shield(label, fn)
        return function(...)
            local result = table.pack(pcall(fn, ...))
            if result[1] then return table.unpack(result, 2, result.n) end
            base.warn("%s threw: %s", label, tostring(result[2]))
            return false, Errors.NO_DATA
        end
    end

    -- one request per tag; a holder whose job was cancelled mid-call is dead and no longer counts
    local holders = {}
    local function isBusy(tag)
        local holder = holders[tag]
        return holder ~= nil and coroutine.status(holder) ~= "dead"
    end

    local function exclusive(tag, fn)
        if isBusy(tag) then return false, Errors.BUSY end
        local holder = coroutine.running()
        holders[tag] = holder
        local result = table.pack(pcall(fn))
        if holders[tag] == holder then holders[tag] = nil end
        if result[1] then return table.unpack(result, 2, result.n) end
        base.warn("%s threw: %s", tag, tostring(result[2]))
        return false, Errors.FAILED
    end

    local function serverMessage(message)
        if type(message) == "string" and message ~= "" then return message end
        return Errors.REJECTED
    end

    -- the server answers (ok, message?), the shape the game's Notify.handleServerResult reads (Cm.Notify:44-59)
    local function answered(sent, ok, message)
        if not sent then return false, ok end
        if not ok then return false, serverMessage(message) end
        return true, message
    end

    -- for remotes whose reply the game never reads, only an explicit false is a refusal
    local function acknowledged(sent, ok, message)
        if not sent then return false, ok end
        if ok == false then return false, serverMessage(message) end
        return true, message
    end

    -- the game reads this once from policy at boot (C.InterfaceController:42-43); (ok, restricted)
    local function restrictedRegion()
        local ok, ui = Net.controller("InterfaceController")
        if not ok or type(ui) ~= "table" then return false, Errors.NO_DATA end
        return true, ui.ArePaidRandomItemsRestricted == true
    end

    -- a rarity group is listed only while it has odds on a tab the player can open (C.StyleController.MenuFrame.Rarities:20-28, ...Rarities.Group:13-18,26, C.AbilityController.Rarities:55-93)
    local function groupShown(kind, rarity)
        local okOdds, data = Net.get("RollService", "Data")
        if not okOdds or type(data) ~= "table" then return false, Errors.NO_DATA end
        local okRegion, restricted = restrictedRegion()
        if not okRegion then return false, restricted end
        local DropChance
        if kind == "Ability" then
            -- the ability picker builds nothing without lucky odds (C.AbilityController.Rarities:56-58)
            if data.LuckyDistribution == nil then return false, Errors.NOT_OFFERED end
            DropChance = mod(PATH.DropChance)
            if not DropChance then return false, Errors.NO_DATA end
        end
        local tabs = { { data.Distribution, false } }
        if not restricted then tabs[2] = { data.LuckyDistribution, true } end
        local key = tostring(rarity)
        for _, tab in ipairs(tabs) do
            local dist = tab[1]
            if type(dist) == "table" then
                if DropChance then dist = DropChance.effectiveAbilityDistribution(dist, true, tab[2]) end
                if (tonumber(dist[key]) or 0) > 0 then return true end
            end
        end
        return false, Errors.NOT_OFFERED
    end

    local function get(key)
        if type(key) ~= "string" or key == "" then return false, Errors.BAD_ARGS end
        return cache.get(key)
    end

    local function refresh(key)
        if type(key) ~= "string" or key == "" then return false, Errors.BAD_ARGS end
        return cache.refresh(key)
    end

    local function peek(key)
        if type(key) ~= "string" then return nil end
        return cache.peek(key)
    end

    local function currencies()
        local stats = cache.held("Statistics")
        if not stats then return false, Errors.NOT_LOADED end
        local slice = currentSlice()
        -- Currency is yen, PremiumCurrency gems, TournamentCurrency challenger tokens (RS.Content.Reward:47-49); seasonal is the season slice's Currency (C.SeasonController:188)
        return true, {
            yen      = Rules.number(stats.Currency),
            gems     = Rules.number(stats.PremiumCurrency),
            tokens   = Rules.number(stats.TournamentCurrency),
            seasonal = slice and Rules.number(slice.Currency) or nil,
        }
    end

    local function spins()
        local stats = cache.held("Statistics")
        if not stats then return false, Errors.NOT_LOADED end
        return true, {
            style        = Rules.number(stats.StyleSpins),
            styleLucky   = Rules.number(stats.StyleLuckySpins),
            ability      = Rules.number(stats.AbilitySpins),
            abilityLucky = Rules.number(stats.AbilityLuckySpins),
        }
    end

    -- C.StyleController:134-141,222, C.AbilityController:145-150
    local function pity()
        local stats = cache.held("Statistics")
        if not stats then return false, Errors.NOT_LOADED end
        local boosted = Rules.tableOr(stats.BoostedChances)
        return true, {
            pity              = Rules.number(stats.Pity),
            secret            = Rules.number(stats.SecretPity),
            secretSpun        = Rules.number(stats.SecretPitySpun),
            ultra             = Rules.number(stats.UltraPity),
            evo               = Rules.number(stats.EvoPity),
            abilitySecret     = Rules.number(stats.SecretAbilityPity),
            abilitySecretSpun = Rules.number(stats.SecretAbilityPitySpun),
            boostedStyle      = boosted.Style,
            preferredSecret   = boosted.SecretStyle,
            boostedAbility    = boosted.Ability,
        }
    end

    local function slots(kind)
        if not KINDS[kind] then return false, Errors.BAD_ARGS end
        local all = cache.held("Slots")
        if not all then return false, Errors.NOT_LOADED end
        return true, Rules.slotState(all[kind])
    end

    local function current(kind)
        local ok, state = slots(kind)
        if not ok then return false, state end
        return true, state.ids[state.active] or ""
    end

    local function season()
        local slice, id = currentSlice()
        if not slice then return false, id end
        return true, id, slice
    end

    local function rank(matchType)
        if matchType ~= nil and type(matchType) ~= "string" then return false, Errors.BAD_ARGS end
        local slice, err = currentSlice()
        if not slice then return false, err end
        local Ranks = mod(PATH.Ranks)
        if not Ranks then return false, Errors.NO_DATA end
        local tier, elo, highest, games, wins
        if matchType then
            local entry = Rules.tableOr(Rules.tableOr(slice.Ranked)[matchType])
            tier = Rules.ladderRank(Ranks, entry)
            elo, highest = Rules.number(entry.Elo), Rules.number(entry.HighestElo)
            games, wins = Rules.number(entry.Games), Rules.number(entry.Wins)
        else
            local found
            found, tier, elo, highest, games, wins = overall(slice)
            if not found then return false, Errors.NO_DATA end
        end
        local data = Rules.tableOr(Ranks.Data)[tier]
        return true, {
            elo        = elo,
            highestElo = highest,
            games      = games,
            wins       = wins,
            rank       = tier,
            rankName   = type(data) == "table" and data.Name or "",
        }
    end

    local function quests(isSeasonal)
        if isSeasonal ~= nil and type(isSeasonal) ~= "boolean" then return false, Errors.BAD_ARGS end
        local list, err = questList(isSeasonal == true)
        if not list then return false, err end
        return true, list
    end

    local function odds()
        return Net.get("RollService", "Data")
    end

    local function info(kind, id)
        if not KINDS[kind] or type(id) ~= "string" or id == "" then return false, Errors.BAD_ARGS end
        local Content, Rarity = mod(PATH[kind]), mod(PATH.Rarity)
        if not (Content and Rarity) then return false, Errors.NO_DATA end
        local ok, def = pcall(Content.Get, Content, id)
        if not ok or type(def) ~= "table" then return false, Errors.UNKNOWN_ID end
        local tier = Rules.tableOr(Rarity.Data)[def.Rarity]
        return true, {
            id         = def.Id or id,
            name       = def.DisplayNameOverride or def.DisplayName or id,
            rarity     = def.Rarity,
            rarityName = type(tier) == "table" and tier.Name or "",
        }
    end

    local nextRoll = {}

    local function roll(kind, lucky)
        local service = KINDS[kind]
        if not service or (lucky ~= nil and type(lucky) ~= "boolean") then return false, Errors.BAD_ARGS end
        lucky = lucky == true
        return exclusive("roll:" .. kind, function()
            if os.clock() < (nextRoll[kind] or 0) then return false, Errors.BUSY end
            if lucky then
                -- lucky spins are hidden where paid random items are restricted (C.StyleController:269-285, C.AbilityController:239-240)
                local okRegion, restricted = restrictedRegion()
                if not okRegion then return false, restricted end
                if restricted then return false, Errors.NOT_OFFERED end
            end
            local all, err = cache.need("Slots")
            if not all then return false, err end
            local state = Rules.slotState(all[kind])
            -- C.StyleController:533-538, C.AbilityController:488-493
            if state.locks[state.active] == true then return false, Errors.SLOT_LOCKED end
            local stats, errStats = cache.need("Statistics")
            if not stats then return false, errStats end
            -- with no spins left the game still sends the roll and opens the robux spin shop on refusal, so that case stops here (C.StyleController:255-260,612-630)
            local count = stats[SPIN_FIELDS[kind][lucky and "lucky" or "normal"]]
            if type(count) ~= "number" or count <= 0 then return false, Errors.NO_SPINS end
            local sent, ok, reel = Net.callAllowed(service, "Roll", lucky)
            nextRoll[kind] = os.clock() + ROLL_COOLDOWN
            if not sent then return false, ok end
            if not ok then return false, serverMessage(reel) end
            -- the reel's last entry is the result (C.StyleController:592-611, C.AbilityController:524-540)
            if type(reel) ~= "table" or #reel == 0 then return false, Errors.BAD_REPLY end
            return true, reel[#reel], reel
        end)
    end

    -- the slot buttons do nothing while a spin plays (C.StyleController.MenuFrame.Slots:95-98)
    local function selectSlot(kind, index)
        local service = KINDS[kind]
        if not service or not Rules.isIndex(index) then return false, Errors.BAD_ARGS end
        return exclusive("slot:" .. kind, function()
            if isBusy("roll:" .. kind) then return false, Errors.BUSY end
            local all, err = cache.need("Slots")
            if not all then return false, err end
            -- past the last owned slot the game's button opens the slot shop instead (C.StyleController.MenuFrame.Slots:99-103)
            if index > #Rules.slotState(all[kind]).ids then return false, Errors.NO_SLOT end
            return answered(Net.callAllowed(service, "SelectSlot", index))
        end)
    end

    -- the lock button only ever sends the active slot (C.StyleController:446-450, C.AbilityController:338-342)
    local function toggleLock(kind, index)
        local service = KINDS[kind]
        if not service or (index ~= nil and not Rules.isIndex(index)) then return false, Errors.BAD_ARGS end
        return exclusive("slot:" .. kind, function()
            if isBusy("roll:" .. kind) then return false, Errors.BUSY end
            local all, err = cache.need("Slots")
            if not all then return false, err end
            local state = Rules.slotState(all[kind])
            local target = index or state.active
            if target ~= state.active then return false, Errors.NOT_ACTIVE_SLOT end
            if target > #state.ids then return false, Errors.NO_SLOT end
            return answered(Net.callAllowed(service, "ToggleLockSlot", target))
        end)
    end

    local function boost(kind, id, secret)
        local service = KINDS[kind]
        if not service or type(id) ~= "string" or id == "" or (secret ~= nil and type(secret) ~= "boolean") then
            return false, Errors.BAD_ARGS
        end
        secret = secret == true
        return exclusive("boost:" .. kind, function()
            local Content, Rarity = mod(PATH[kind]), mod(PATH.Rarity)
            if not (Content and Rarity) then return false, Errors.NO_DATA end
            local okDef, def = pcall(Content.Get, Content, id)
            if not okDef or type(def) ~= "table" then return false, Errors.UNKNOWN_ID end
            if not Rules.isOffered(Content, def) then return false, Errors.NOT_OFFERED end
            if secret then
                -- only styles have a preferred secret, picked from the secret group (C.StyleController.MenuFrame.SecretPity.List:8-10)
                if kind ~= "Style" or def.Rarity ~= Rules.tableOr(Rarity.Type).Secret then
                    return false, Errors.NOT_OFFERED
                end
                local stats, err = cache.need("Statistics")
                if not stats then return false, err end
                -- picking the current preferred secret again sends nothing (C.StyleController.MenuFrame.SecretPity.List.StyleTemplate:56-63)
                if Rules.tableOr(stats.BoostedChances).SecretStyle == id then return false, Errors.ALREADY_SET end
                return acknowledged(Net.callAllowed(service, "SelectChance", id, true))
            end
            local shown, err = groupShown(kind, def.Rarity)
            if not shown then return false, err end
            -- C.StyleController.MenuFrame.Rarities.Group.StyleTemplate:41-45, C.AbilityController.Rarities:188-192
            return acknowledged(Net.callAllowed(service, "SelectChance", id))
        end)
    end

    local claims = Claims.new({
        Net          = Net,
        cache        = cache,
        mod          = mod,
        PATH         = PATH,
        currentSlice = currentSlice,
        freshSlice   = freshSlice,
        questList    = questList,
        overall      = overall,
        forcedStyle  = forcedStyle,
        level        = level,
        exclusive    = exclusive,
        answered     = answered,
        acknowledged = acknowledged,
    })

    local prefetch = Jobs.spawn(cache.prefetch, { name = "ProfilePrefetch" })
    if maid then
        maid:GiveTask(prefetch)
        maid:GiveTask(cache.destroy)
    end

    return {
        Errors  = Errors,
        changed = changed,

        isLoaded   = cache.isLoaded,
        peek       = peek,
        get        = get,
        refresh    = refresh,
        level      = level,
        currencies = shield("currencies", currencies),
        spins      = shield("spins", spins),
        pity       = shield("pity", pity),
        slots      = shield("slots", slots),
        current    = shield("current", current),
        season     = shield("season", season),
        rank       = shield("rank", rank),
        quests     = shield("quests", quests),
        odds       = odds,
        info       = shield("info", info),
        claimable  = shield("claimable", claims.claimable),

        -- every verb yields; call from a job
        roll              = roll,
        selectSlot        = selectSlot,
        toggleLock        = toggleLock,
        boost             = boost,
        claimQuest        = claims.claimQuest,
        claimAllQuests    = claims.claimAllQuests,
        claimSeasonTier   = claims.claimSeasonTier,
        claimMilestone    = claims.claimMilestone,
        claimChallenge    = claims.claimChallenge,
        claimMastery      = claims.claimMastery,
        claimLevelRewards = claims.claimLevelRewards,
        claimDailyPresent = claims.claimDailyPresent,
        redeemCode        = claims.redeemCode,
    }
end

return M

end)
__bundle_register("Api/Profile/Rules", function(require, _LOADED, __bundle_register, __bundle_modules)
-- profile rules: the game's own client-side reads and claim checks as pure functions over profile data and game modules; each returns a refusal code or nil and cites the client lines it mirrors
local Errors = require("Api/Profile/Errors")

local R = {}

local function isInteger(n)
    return type(n) == "number" and n == n and n % 1 == 0
end

local function isIndex(n)
    return isInteger(n) and n >= 1
end

local function number(v)
    return type(v) == "number" and v or 0
end

local function tableOr(v)
    return type(v) == "table" and v or {}
end

R.isInteger = isInteger
R.isIndex   = isIndex
R.number    = number
R.tableOr   = tableOr

-- the ui's slot view: ids ("" for an empty slot), locks, and the active index floored at 1 (Cm.SlotStates:22-32, RS.Common.SlotHandler:49-93)
function R.slotState(records)
    local ids, locks, active = {}, {}, 0
    if type(records) ~= "table" then
        return { ids = ids, locks = locks, active = 1 }
    end
    for i, rec in ipairs(records) do
        local isRecord = type(rec) == "table"
        if isRecord and type(rec.Id) == "string" and rec.Id ~= "" then
            ids[i] = rec.Id
        elseif type(rec) == "string" then
            ids[i] = rec
        else
            ids[i] = ""
        end
        locks[i] = isRecord and rec.IsLocked == true
        if active == 0 and isRecord and rec.IsActive == true then active = i end
    end
    if active == 0 and #ids > 0 then active = 1 end
    return { ids = ids, locks = locks, active = math.max(active, 1) }
end

function R.isLive(season)
    if type(season) ~= "table" or type(season.IsLive) ~= "function" then return false end
    local ok, live = pcall(season.IsLive, season)
    return ok and live == true
end

-- one ladder, unranked until placement is done (C.RankedQueueController.Ranked:19-25)
function R.ladderRank(Ranks, entry)
    entry = tableOr(entry)
    if Ranks.isUnranked(entry.Games or 0, entry.Elo) then return Ranks.Type.Unranked end
    return Ranks.getRankFromElo(entry.Elo or 0)
end

-- the best counted ladder, which is the rank every milestone unlocks on (C.RankedRewardsController.Data:12-31); games and wins are summed over the same ladders
function R.overallRank(Ranks, Matchmaking, ranked)
    local elo, highest, games, wins, placement = 0, 0, 0, 0, true
    for key, entry in pairs(tableOr(ranked)) do
        local data = type(entry) == "table" and Matchmaking.Data[Matchmaking.ResolveType(key)]
        if data and not data.IsCasual and entry.Elo ~= -1 and not Ranks.isUnranked(entry.Games, entry.Elo) then
            elo = math.max(elo, entry.Elo or 0)
            highest = math.max(highest, entry.HighestElo or 0)
            games = games + number(entry.Games)
            wins = wins + number(entry.Wins)
            placement = false
        end
    end
    local rank = Ranks.Type.Unranked
    if not placement then rank = Ranks.getRankFromElo(elo) end
    return rank, elo, highest, games, wins
end

-- a quest's claim button shows while unclaimed with progress at the requirement (C.SeasonController.Quests.Quest:36-39)
function R.questDone(def, state)
    state = tableOr(state)
    return type(def) == "table" and not state.Claimed and type(state.Progress) == "number"
        and type(def.Requirement) == "number" and def.Requirement <= state.Progress
end

-- the tier experience buys, clamped to the pass (C.SeasonController:145-150, RS.Content.Season:54-63)
function R.seasonTier(season, slice)
    slice = tableOr(slice)
    local ok, tier = pcall(season.GetTierFromExperience, season, slice.Experience or 0, slice.Rebirths or 0)
    return ok and number(tier) or 0
end

local function flagged(t, key)
    t = tableOr(t)
    return t[key] or t[tostring(key)]
end

-- one claim takes both tracks, so a tier is open while either unlocked track is unclaimed (C.SeasonController.SeasonPass.Rewards.Reward:17-56)
function R.tierRefusal(season, slice, tier)
    slice = tableOr(slice)
    if not isIndex(tier) or tier > #tableOr(tableOr(season.Rewards).Regular) then return Errors.BAD_ARGS end
    if R.seasonTier(season, slice) < tier then return Errors.NOT_REACHED end
    local claimed = tableOr(slice.Claimed)
    if not flagged(claimed.Regular, tier) then return nil end
    if slice.IsPremium and not flagged(claimed.Premium, tier) then return nil end
    return Errors.ALREADY_CLAIMED
end

-- ranked milestones are ranks Bronze1..Pro not on a multiple of three, champion ones are Pro..UltimateChampion with two rewards each, all gated on the overall rank and on the season not yet paid out (Cm.MilestoneReward:26-41, C.RankedRewardsController.RankedRewards.Rewards:14-36, ...ChampionRewards.Ladder.LeagueRankDisplay:20-35, C.RankedRewardsController.Data:47-79)
function R.milestoneRefusal(season, slice, Ranks, rank, requiredRank, index)
    slice = tableOr(slice)
    local T = Ranks.Type
    if not isInteger(requiredRank) then return Errors.BAD_ARGS end
    if index == nil then
        if requiredRank < T.Bronze1 or requiredRank > T.Pro then return Errors.BAD_ARGS end
        if requiredRank % 3 == 0 or not tableOr(season.RankedRewards)[requiredRank] then return Errors.NOT_OFFERED end
        if slice.IsRewarded then return Errors.NOT_OFFERED end
        if tableOr(slice.ClaimedRankedRewards)[tostring(requiredRank)] then return Errors.ALREADY_CLAIMED end
    else
        if requiredRank < T.Pro or requiredRank > T.UltimateChampion then return Errors.BAD_ARGS end
        if not isIndex(index) or index > 2 then return Errors.BAD_ARGS end
        if not tableOr(tableOr(season.ChampionRewards)[requiredRank])[index] then return Errors.NOT_OFFERED end
        if slice.IsRewarded then return Errors.NOT_OFFERED end
        local got = tableOr(slice.ClaimedChampionRewards)[tostring(requiredRank)]
        if type(got) == "table" and (got[tostring(index)] or got[index]) == true then return Errors.ALREADY_CLAIMED end
    end
    if requiredRank > rank then return Errors.NOT_REACHED end
    return nil
end

-- a challenge level pays once its wins are reached, and the button hides at max strikes (C.ChallengeController.RewardsTrack.ItemBtn:21-39,130-138)
function R.challengeRefusal(rewards, tournaments, level)
    tournaments = tableOr(tournaments)
    if not isIndex(level) or level > number(rewards.MaxLevel) then return Errors.BAD_ARGS end
    if number(rewards.MaxStrikes) <= number(tournaments.Strikes) then return Errors.OUT_OF_STRIKES end
    if tableOr(tournaments.Claimed)[tostring(level)] ~= nil then return Errors.ALREADY_CLAIMED end
    if level > number(tournaments.Wins) then return Errors.NOT_REACHED end
    return nil
end

-- the level rewards button shows while fewer rewards are claimed than levels reached (C.LevelRewardsController:87-89)
function R.levelRewardsRefusal(claimed, level, count)
    if number(claimed) < math.min(number(level), number(count)) then return nil end
    return Errors.NOTHING_TO_CLAIM
end

-- a mastery quest pays once progress reaches the requirement (C.MasteryController.Masteries.Challenges.Template:27-35,111-116, ...TreeMenu.RightPanel.Quests:29-35,76-78)
function R.masteryQuestDone(quest)
    local requirement = number(quest.Requirement)
    if requirement <= 0 then return false end
    local progress = math.min(number(quest.Progress), requirement)
    return progress / requirement >= 1
end

-- the pickers only list entries that are live right now (RS.Content.Style:65-82, C.StyleController.MenuFrame.Rarities.Group.StyleTemplate:20-44)
function R.isOffered(Content, def)
    local okExpired, expired = pcall(Content.isExpired, def)
    local okActive, active = pcall(Content.isActive, def)
    return okExpired and okActive and not expired and active == true
end

return R

end)
