-- job registry for anything that yields: owns every long-lived thread so the unloader can cancel it deterministically instead of waiting on a per-feature stop flag

local Log = require("Utility/Log")

local M = {}

local live = {}    -- handle -> true
local nextSeq = 0

-- cancellation is cooperative first (job.alive / job:sleep return false), then hard: a thread parked in task.wait is cancelled outright
local function killThread(thread)
    if type(thread) ~= "thread" then return end
    if coroutine.running() == thread then return end
    local status = coroutine.status(thread)
    if status == "dead" then return end
    local ok = pcall(task.cancel, thread)
    if not ok then
        task.defer(function() pcall(task.cancel, thread) end)
    end
end

local function finish(handle)
    if not handle.alive then return end
    handle.alive = false
    live[handle] = nil
end

local function newHandle(name)
    nextSeq = nextSeq + 1
    local handle = {
        name  = name or ("job#" .. nextSeq),
        seq   = nextSeq,
        alive = true,
        thread = nil,
    }

    -- a body that yields should check this rather than rely on the hard cancel landing mid-call
    function handle:sleep(seconds)
        if not self.alive then return false end
        task.wait(seconds)
        return self.alive
    end

    function handle:Cancel()
        if not self.alive then return end
        local thread = self.thread
        finish(self)
        killThread(thread)
    end

    handle.Disconnect = handle.Cancel
    handle.Destroy = handle.Cancel

    -- mirrors the Scheduler handle so track() / maid:GiveTask() treat both the same way
    function handle:IsRunning() return self.alive end

    live[handle] = true
    return handle
end

-- xpcall'd so a throwing job is logged with a traceback and retired, never left as a dead thread the caller believes is running
local function run(handle, fn, ...)
    local args = table.pack(...)
    handle.thread = task.spawn(function()
        local ok, err = xpcall(function()
            fn(handle, table.unpack(args, 1, args.n))
        end, function(e) return debug.traceback(tostring(e), 2) end)
        if not ok then
            Log.devwarn("Jobs", "%s threw: %s", handle.name, tostring(err))
        end
        finish(handle)
    end)
    return handle
end

-- one-shot thread. fn receives the handle, so a body that yields can bail with `if not job.alive then return end`
function M.spawn(fn, opts)
    if type(fn) ~= "function" then
        Log.devwarn("Jobs", "spawn ignored: fn is %s", type(fn))
        return nil
    end
    opts = opts or {}
    return run(newHandle(opts.name), fn)
end

function M.delay(seconds, fn, opts)
    if type(fn) ~= "function" then
        Log.devwarn("Jobs", "delay ignored: fn is %s", type(fn))
        return nil
    end
    opts = opts or {}
    local handle = newHandle(opts.name)
    return run(handle, function(job)
        if not job:sleep(seconds) then return end
        fn(job)
    end)
end

-- repeating body on a fixed cadence; the registry owns the loop, so cancellation is immediate
function M.interval(seconds, fn, opts)
    if type(fn) ~= "function" then
        Log.devwarn("Jobs", "interval ignored: fn is %s", type(fn))
        return nil
    end
    opts = opts or {}
    local handle = newHandle(opts.name)
    local period = math.max(0, tonumber(seconds) or 0)
    return run(handle, function(job)
        if opts.immediate then
            fn(job)
            if not job.alive then return end
        end
        while true do
            -- re-read before sleeping, so a slider-driven cadence takes effect on the next wait
            if type(opts.period) == "function" then
                local next_ = tonumber(opts.period())
                if next_ then period = math.max(0, next_) end
            end
            if not job:sleep(period) then return end
            fn(job)
            -- a body may cancel its own job (a poller that reached a terminal state)
            if not job.alive then return end
        end
    end)
end

function M.cancelAll()
    for handle in pairs(live) do
        handle:Cancel()
    end
    table.clear(live)
end

function M.stats()
    local names, n = {}, 0
    for handle in pairs(live) do
        n = n + 1
        names[#names + 1] = handle.name
    end
    table.sort(names)
    return { running = n, names = names }
end

return M

