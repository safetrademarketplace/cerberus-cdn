-- auto join team: while you are off the court of a casual match, asks every few seconds to join the emptier team at its lowest slot no real player holds (a bot's slot counts as open), one request per pass; once a join lands it waits until the match lets you go again
local Jobs = require("Utility/Jobs")
local Log  = require("Utility/Log")

local PERIOD    = 4
-- a join the server accepted that never puts you on the court is retried after this long
local SETTLE    = 12
local POSITIONS = 6
-- the seat a real player holds, server-set (RS.Common.State:5-12, TeamSelectionController.lua:170)
local KEY_POSITION = "Gameplay_Position"

local SKIP_MODES  = { Tutorial = true, Training = true, Pro = true }
local OPEN_ROUNDS = { Joining = true, Live = true }

local M = {}

function M.new(deps)
    local Match = deps.Match
    local maid  = deps.maid

    local job, jobSlot
    -- os.clock() of the last join that landed; nil while free to try
    local joinedAt
    local sawPlaying = false
    -- seats the server turned down since we were last on a court, so the next pass tries another
    local refused = {}

    local function seatKey(teamSlot, position)
        return teamSlot * 10 + position
    end

    local function positionOf(entry)
        local ok, n = pcall(function() return entry.player:GetAttribute(KEY_POSITION) end)
        if ok and type(n) == "number" then return n end
        return nil
    end

    -- the casual court is taking players: not tutorial/training/ranked, and the round is joining or live (or has no round at all)
    local function courtOpen()
        local okCtx, info = Match.context()
        if not okCtx or SKIP_MODES[info.gamemode] then return false end
        local okRound, round = Match.roundState()
        if not okRound then return true end
        return OPEN_ROUNDS[round.name] == true
    end

    -- (teamSlot, position) to ask for, where teamSlot indexes Match.teams() the way RequestJoin expects (TeamSelect:118-121)
    local function plan()
        local okTeams, teams = Match.teams()
        if not (okTeams and type(teams) == "table") then return nil end
        local okRoster, roster = Match.players()
        if not okRoster then return nil end

        local options = {}
        for slot, team in ipairs(teams) do
            local okSide, side = Match.side(team)
            if okSide then
                local held, count = {}, 0
                for _, entry in ipairs(roster) do
                    if not entry.isBot and not entry.isLocal and entry.teamIndex == side.index then
                        local position = positionOf(entry)
                        if position then
                            held[position] = true
                            count = count + 1
                        end
                    end
                end
                options[#options + 1] = { slot = slot, count = count, held = held }
            end
        end
        table.sort(options, function(a, b)
            if a.count ~= b.count then return a.count < b.count end
            return a.slot < b.slot
        end)

        local turnedDown = false
        for _, option in ipairs(options) do
            for position = 1, POSITIONS do
                if not option.held[position] then
