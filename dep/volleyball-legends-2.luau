__bundle_register("Features/Player/Utils/AutoRejoin", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto-rejoin sub-module of utils: rejoins on kick / teleport failure
local Jobs = require("Utility/Jobs")

return function(ctx)
    local Services   = ctx.Services
    local References = ctx.References
    local UtilsGroup = ctx.UtilsGroup

    local rejoinState = {
        enabled = false,
        pending = false,
        nextAttemptAt = 0,
        retryDelay = 2,
        maxDelay = 20,
        loop = nil,
        token = 0,
        conns = {},
    }

    local function trackRejoin(conn)
        if conn then
            rejoinState.conns[#rejoinState.conns + 1] = conn
        end
        return conn
    end

    local function clearRejoinConns()
        for i = #rejoinState.conns, 1, -1 do
            local c = rejoinState.conns[i]
            rejoinState.conns[i] = nil
            pcall(function()
                if c and type(c.Disconnect) == "function" then
                    c:Disconnect()
                end
            end)
        end
    end

    local function markRejoinPending(reason)
        if not rejoinState.enabled then return end
        rejoinState.pending = true
        rejoinState.reason = reason
    end

    local function tryRejoin()
        if not rejoinState.enabled then return end
        local now = os.clock()

        if now < rejoinState.nextAttemptAt then return end
        rejoinState.nextAttemptAt = now + rejoinState.retryDelay

        local ok = pcall(function()
            local plr = References.player or Services.Players.LocalPlayer
            Services.TeleportService:Teleport(Services.Game.PlaceId, plr)
        end)

        if ok then
            rejoinState.retryDelay = 2
        else
            rejoinState.retryDelay = math.min(rejoinState.maxDelay, rejoinState.retryDelay + 2)
        end
    end

    local function startAutoRejoin()
        if rejoinState.enabled then return end
        rejoinState.enabled = true
        rejoinState.pending = false
        rejoinState.nextAttemptAt = 0
        rejoinState.retryDelay = 2
        rejoinState.token = rejoinState.token + 1
        local token = rejoinState.token

        -- ErrorMessageChanged fires for unrelated ui prompts too; keyword filter avoids rejoining on every error dialog
        local DISCONNECT_PATTERNS = {
            "disconnect", "kick", "lost connection",
            "cannot join", "lost contact", "teleport failed",
            "error code",
        }
        local function looksLikeDisconnect(msg)
            if type(msg) ~= "string" or msg == "" then return false end
            local lower = msg:lower()
            for _, kw in ipairs(DISCONNECT_PATTERNS) do
                if lower:find(kw, 1, true) then return true end
            end
            return false
        end
        trackRejoin(Services.GuiService.ErrorMessageChanged:Connect(function(errorMsg)
            if looksLikeDisconnect(errorMsg) then
                markRejoinPending("error_prompt: " .. tostring(errorMsg))
            end
        end))

        local plr = References.player or Services.Players.LocalPlayer
        if plr and plr.OnTeleport then
            trackRejoin(plr.OnTeleport:Connect(function(state)
                if state == Enum.TeleportState.Failed then
                    markRejoinPending("teleport_failed")
                elseif state == Enum.TeleportState.Started then
                    rejoinState.pending = false
                end
            end))
        end

        trackRejoin(Services.TeleportService.TeleportInitFailed:Connect(function(failedPlr)
            if failedPlr == plr then
                markRejoinPending("teleport_init_failed")
            end
        end))

        -- retry loop only acts while a rejoin is pending
        rejoinState.loop = Jobs.interval(1, function(job)
            if not (rejoinState.enabled and rejoinState.token == token) then
                job:Cancel()
                return
            end
            if rejoinState.pending then tryRejoin() end
        end, { name = "AutoRejoin" })
    end

    local function stopAutoRejoin()
        if not rejoinState.enabled then return end
        rejoinState.token = rejoinState.token + 1
        rejoinState.enabled = false
        rejoinState.pending = false
        rejoinState.nextAttemptAt = 0
        rejoinState.retryDelay = 2
        if rejoinState.loop then
            rejoinState.loop:Cancel()
            rejoinState.loop = nil
        end
        clearRejoinConns()
    end

    UtilsGroup:AddToggle("AutoRejoin", {
        Text = "Auto Rejoin",
        Default = false,
        Tooltip = "Rejoin the game on kick, disconnect, or teleport failure",
        Callback = function(v)
            if v then startAutoRejoin() else stopAutoRejoin() end
        end
    })

    return { cleanup = stopAutoRejoin }
end

end)
__bundle_register("Features/Player/Utils/PerformanceMode", function(require, _LOADED, __bundle_register, __bundle_modules)
-- performance-mode sub-module of utils: lowers render quality / fx and caps cerberus' own per-frame budget
local Scheduler = require("Utility/Scheduler")

-- ~12% of a 60fps frame; enough headroom that nothing defers in normal play, tight enough to cap esp under load
local FRAME_BUDGET_MS = 2

return function(ctx)
    local Services   = ctx.Services
    local Toggles    = ctx.Toggles
    local UtilsGroup = ctx.UtilsGroup
    local track      = ctx.track

    UtilsGroup:AddToggle("PerformanceMode", {
        Text = "Performance Mode",
        Default = false,
        Tooltip = "Reduce visual effects locally for better FPS",
    })

    local originals = nil
    local perfModeConn = nil

    local function snapshot()
        if originals then return end
        originals = {
            QualityLevel  = settings().Rendering.QualityLevel,
            GlobalShadows = Services.Lighting.GlobalShadows,
            Ambient       = Services.Lighting.Ambient,
            Brightness    = Services.Lighting.Brightness,
            FogEnd        = Services.Lighting.FogEnd,
            FogStart      = Services.Lighting.FogStart,
            Effects       = {},
            Terrain       = {},
        }

        for _, inst in ipairs(Services.Lighting:GetDescendants()) do
            if inst:IsA("BloomEffect") or inst:IsA("ColorCorrectionEffect")
                or inst:IsA("SunRaysEffect") or inst:IsA("DepthOfFieldEffect")
                or inst:IsA("BlurEffect") then
                originals.Effects[inst] = inst.Enabled
            end
        end

        local terr = Services.Workspace:FindFirstChildOfClass("Terrain")
        if terr then
            originals.Terrain.WaterWaveSize     = terr.WaterWaveSize
            originals.Terrain.WaterReflectance  = terr.WaterReflectance
            originals.Terrain.WaterTransparency = terr.WaterTransparency
            local ok, dec = pcall(function() return terr.Decoration end)
            if ok and type(dec) == "boolean" then
                originals.Terrain.Decoration = dec
            end
        end
    end

    local function processEffect(d)
        if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") or d:IsA("Smoke") or d:IsA("Fire") then
            if d.Enabled then
                d:SetAttribute("PerfWasEnabled", true)
                d.Enabled = false
            end
        end
    end

    local function perfOn()
        snapshot()
        Scheduler.setBudget(FRAME_BUDGET_MS)

        pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)

        Services.Lighting.GlobalShadows   = false
        Services.Lighting.Ambient         = Color3.new(0.3, 0.3, 0.3)
        Services.Lighting.Brightness      = 1
        Services.Lighting.FogEnd          = 1e10
        Services.Lighting.FogStart        = 1e10

        for inst in pairs(originals.Effects) do
            if inst and inst.Parent then inst.Enabled = false end
        end

        local terr = Services.Workspace:FindFirstChildOfClass("Terrain")
        if terr then
            terr.WaterWaveSize     = 0
            terr.WaterReflectance  = 0
            terr.WaterTransparency = 1
            if originals.Terrain.Decoration ~= nil then
                pcall(function() terr.Decoration = false end)
            end
        end

        task.defer(function()
            for _, d in ipairs(Services.Workspace:GetDescendants()) do
                if not Toggles.PerformanceMode.Value then break end -- user toggled off mid-sweep
                processEffect(d)
            end
        end)

        if not perfModeConn then
            perfModeConn = Services.Workspace.DescendantAdded:Connect(function(descendant)
                processEffect(descendant)
            end)
            if track then track(perfModeConn) end
        end
    end

    local function perfOff()
        Scheduler.setBudget(nil)
        if not originals then return end

        if perfModeConn then
            perfModeConn:Disconnect()
            perfModeConn = nil
        end

        pcall(function() settings().Rendering.QualityLevel = originals.QualityLevel end)

        Services.Lighting.GlobalShadows   = originals.GlobalShadows
        Services.Lighting.Ambient         = originals.Ambient
        Services.Lighting.Brightness      = originals.Brightness
        Services.Lighting.FogEnd          = originals.FogEnd
        Services.Lighting.FogStart        = originals.FogStart

        for inst, was in pairs(originals.Effects) do
            if inst and inst.Parent then inst.Enabled = was end
        end

        local terr = Services.Workspace:FindFirstChildOfClass("Terrain")
        if terr then
            terr.WaterWaveSize     = originals.Terrain.WaterWaveSize or terr.WaterWaveSize
            terr.WaterReflectance  = originals.Terrain.WaterReflectance or terr.WaterReflectance
            terr.WaterTransparency = originals.Terrain.WaterTransparency or terr.WaterTransparency
            if originals.Terrain.Decoration ~= nil then
                pcall(function() terr.Decoration = originals.Terrain.Decoration end)
            end
        end

        task.defer(function()
            for _, d in ipairs(Services.Workspace:GetDescendants()) do
                if d:GetAttribute("PerfWasEnabled") then
                    d:SetAttribute("PerfWasEnabled", nil)
                    if d.Enabled ~= nil then d.Enabled = true end
                end
            end
        end)

        originals = nil
    end

    Toggles.PerformanceMode:OnChanged(function()
        if Toggles.PerformanceMode.Value then perfOn() else perfOff() end
    end)

    return { cleanup = perfOff }
end

end)
__bundle_register("Features/Player/Utils/Zoom", function(require, _LOADED, __bundle_register, __bundle_modules)
-- zoom sub-module of utils (fov-based zoom on the render lane)
local Scheduler = require("Utility/Scheduler")

return function(ctx)
    local Services   = ctx.Services
    local Library    = ctx.Library
    local References = ctx.References
    local Toggles    = ctx.Toggles
    local UtilsGroup = ctx.UtilsGroup
    local track      = ctx.track

    local Zoom = { on = false, conn = nil, origFov = nil, strength = 2 }

    local function applyZoom()
        local cam = References.camera or Services.Workspace.CurrentCamera
        if not (cam and Zoom.origFov) then return end
        cam.FieldOfView = math.clamp(Zoom.origFov / math.max(0.1, Zoom.strength), 10, 120)
    end

    -- hands back the fov from when this zoom began, and only while a zoom is actually on; a value kept from an earlier zoom would be stale
    local function stopZoom()
        local wasOn = Zoom.on
        Zoom.on = false
        if Zoom.conn then
            pcall(function() Zoom.conn:Disconnect() end); Zoom.conn = nil
        end
        local cam = References.camera or Services.Workspace.CurrentCamera
        if wasOn and cam and Zoom.origFov then pcall(function() cam.FieldOfView = Zoom.origFov end) end
        Zoom.origFov = nil
    end

    local tg
    tg = UtilsGroup:AddToggle("ZOOM_Enable", {
        Text = "Zoom",
        Default = false,
        Callback = function(on)
            local cam = References.camera or Services.Workspace.CurrentCamera
            if not cam then
                Library:Notify("Camera not ready.", 3); if tg.SetValue then tg:SetValue(false) end; return
            end
            if on then
                if not Zoom.on then Zoom.origFov = cam.FieldOfView end
                Zoom.on = true; applyZoom()
                if not Zoom.conn then
                    Zoom.conn = track(Scheduler.render(function()
                        if Zoom.on then applyZoom() end
                    end, { name = "Zoom", priority = 50 }))
                end
            else
                stopZoom()
            end
        end
    }):AddKeyPicker("ZoomKey", {
        Default = nil,
        SyncToggleState = true,
        Mode = "Toggle",
    })

    local ZoomBox = UtilsGroup:AddDependencyBox()

    ZoomBox:AddSlider("ZOOM_Strength", {
        Text = "Zoom Strength",
        Default = 2,
        Min = 1,
        Max = 10,
        Rounding = 1,
        Callback = function(v)
            Zoom.strength = v; if Zoom.on then applyZoom() end
        end
    })

    ZoomBox:SetupDependencies({
        { Toggles.ZOOM_Enable, true },
    })

    return { cleanup = stopZoom }
end

end)
__bundle_register("Features/Player/Movement", function(require, _LOADED, __bundle_register, __bundle_modules)
-- movement orchestrator: wires Speed and Jump
local Mount = require("Utility/Mount")
local Speed = require("Features/Player/Movement/Speed")
local Jump  = require("Features/Player/Movement/Jump")

return function(ctx)
    local O = Mount.orchestrator(ctx, "Movement")
    if not O then return end

    -- O.mount so a crashing sub-module factory can't take down siblings; manual onUnload stays since these expose stopX, not cleanup
    local subCtx = O.subCtx()
    local speedAPI = O.mount(Speed, subCtx)
    local jumpAPI  = O.mount(Jump, subCtx)

    local API = {
        startSpeed        = speedAPI.startSpeed,
        stopSpeed         = speedAPI.stopSpeed,
        startJumpMod      = jumpAPI.startJumpMod,
        stopJumpMod       = jumpAPI.stopJumpMod,
        startInfiniteJump = jumpAPI.startInfiniteJump,
        stopInfiniteJump  = jumpAPI.stopInfiniteJump,
    }

    O.onUnload(function()
        if API.stopSpeed        then API.stopSpeed(true) end
        if API.stopJumpMod      then API.stopJumpMod() end
        if API.stopInfiniteJump then API.stopInfiniteJump() end
    end)
    O.finalize()

    return API
end

end)
__bundle_register("Features/Player/Movement/Jump", function(require, _LOADED, __bundle_register, __bundle_modules)
-- jump sub-module of movement (jump power + infinite jump)
return function(ctx)
    local Services   = ctx.Services
    local Tabs       = ctx.Tabs
    local References = ctx.References
    local Options    = ctx.Options
    local Toggles    = ctx.Toggles
    local track      = ctx.track

    local JumpGroup = Tabs.Movement:AddLeftGroupbox("Jump", "move-vertical")

    JumpGroup:AddToggle("JumpPower", {
        Text = "Jump Power",
        Default = false
    })

    local JumpPowerBox = JumpGroup:AddDependencyBox()

    JumpPowerBox:AddSlider("JumpHeight", {
        Text = "Jump Height",
        Default = 7.2,
        Min = 5,
        Max = 200,
        Rounding = 1
    })

    JumpPowerBox:SetupDependencies({
        { Toggles.JumpPower, true },
    })

    JumpGroup:AddToggle("InfiniteJump", {
        Text = "Infinite Jump",
        Default = false
    })

    local currentJumpHeight = Options.JumpHeight.Value
    local isInfiniteJumpEnabled = Toggles.InfiniteJump.Value

    local function applyJumpHeight()
        local hum = References.humanoid
        if not hum then return end

        -- use the native JumpHeight property instead of calculating JumpPower math
        if hum.UseJumpPower ~= nil then
            hum.UseJumpPower = false
        end
        if hum.JumpHeight ~= nil then
            if hum.JumpHeight ~= currentJumpHeight then
                hum.JumpHeight = currentJumpHeight
            end
        end
    end

    local _orig = nil
    local jumpConn               -- humanoid:GetPropertyChangedSignal("JumpHeight")
    local jumpCharConn           -- References.onCharacter unsubscribe
    local jumpModEnabled = false

    References.onCharacterRemoving(function() _orig = nil end)

    local function bindHumanoid()
        if jumpConn then jumpConn:Disconnect(); jumpConn = nil end
        local hum = References.humanoid
        if not hum then return end

        if not _orig then
            _orig = {
                UseJumpPower = hum.UseJumpPower,
                JumpPower = hum.JumpPower,
                JumpHeight = hum.JumpHeight
            }
        end

        applyJumpHeight()

        -- re-assert on external JumpHeight writes; applyJumpHeight checks ~= before assigning, so this can't infinite-loop
        jumpConn = hum:GetPropertyChangedSignal("JumpHeight"):Connect(function()
            if jumpModEnabled then applyJumpHeight() end
        end)
    end

    local function startJumpMod()
        if jumpModEnabled then return end
        jumpModEnabled = true
        bindHumanoid()
        -- re-bind on respawn so the new humanoid gets the override
        jumpCharConn = References.onCharacter(function() bindHumanoid() end)
    end

    local function stopJumpMod()
        jumpModEnabled = false
        if jumpConn then jumpConn:Disconnect(); jumpConn = nil end
        if jumpCharConn then jumpCharConn(); jumpCharConn = nil end
        local hum = References.humanoid

        if hum and _orig then
            if hum.UseJumpPower ~= nil then hum.UseJumpPower = _orig.UseJumpPower end
            if hum.JumpPower ~= nil then hum.JumpPower = _orig.JumpPower end
            if hum.JumpHeight ~= nil then hum.JumpHeight = _orig.JumpHeight end
        end
    end

    local ijConn, ijBusy = nil, false

    local function startInfiniteJump()
        if ijConn then return end
        ijConn = track(Services.UserInputService.JumpRequest:Connect(function()
            if not isInfiniteJumpEnabled then return end

            local hum = References.humanoid
            if not hum or ijBusy then return end

            ijBusy = true
            -- leak:allow — one-frame busy-flag reset; it cannot outlive the frame it starts in
            task.defer(function()
                pcall(function()
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                    hum.Jump = true
                end)
                task.wait()
                ijBusy = false
            end)
        end))
    end

    local function stopInfiniteJump()
        if ijConn then ijConn:Disconnect(); ijConn = nil end
        ijBusy = false
    end

    if Toggles.JumpPower then
        Toggles.JumpPower:OnChanged(function()
            if Toggles.JumpPower.Value then startJumpMod() else stopJumpMod() end
        end)
    end

    if Options.JumpHeight then
        Options.JumpHeight:OnChanged(function()
            currentJumpHeight = Options.JumpHeight.Value
            if Toggles.JumpPower and Toggles.JumpPower.Value then
                applyJumpHeight()
            end
        end)
    end

    if Toggles.InfiniteJump then
        Toggles.InfiniteJump:OnChanged(function()
            isInfiniteJumpEnabled = Toggles.InfiniteJump.Value
            if isInfiniteJumpEnabled then startInfiniteJump() else stopInfiniteJump() end
        end)
    end

    return {
        startJumpMod      = startJumpMod,
        stopJumpMod       = stopJumpMod,
        startInfiniteJump = startInfiniteJump,
        stopInfiniteJump  = stopInfiniteJump,
    }
end

end)
