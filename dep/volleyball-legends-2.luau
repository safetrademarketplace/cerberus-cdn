        while OWN[base] do base = OWN[base] end
        local wrapper = makeWrapper(base)
        local okSet, err = pcall(function() mod.get = wrapper end)
        if not okSet then
            Log.devwarn("Assist", "could not wrap the hitbox lookup: %s", tostring(err))
            return
        end
        target, original, live = mod, base, wrapper
    end

    local function stopWatch()
        if watch then maid[watchSlot] = nil end
        watch, watchSlot = nil, nil
    end

    local function setPercent(value)
        local pct = math.clamp(tonumber(value) or MIN_PERCENT, MIN_PERCENT, MAX_PERCENT)
        factor = pct / 100
        if factor == 1 then
            stopWatch()
            release()
            return
        end
        ensure()
        if not (watch and watch.Connected) then
            stopWatch()
            watch = Scheduler.heartbeat(ensure, { name = "Assist/HitRange", interval = RECHECK })
            if watch then watchSlot = maid:GiveTask(watch) end
        end
    end

    local function stop()
        factor = 1
        stopWatch()
        release()
    end

    return { setPercent = setPercent, stop = stop }
end

