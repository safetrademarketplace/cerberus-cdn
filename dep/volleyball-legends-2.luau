local function openSpot(half, opponents)
    local minX, maxX, near, back = inset(half)
    local bestX, bestZ, bestScore
    for i = 0, GRID - 1 do
        local x = minX + (maxX - minX) * i / (GRID - 1)
        for j = 0, GRID - 1 do
            local z = near + (back - near) * j / (GRID - 1)
            local score = nearestSq(x, z, opponents)
            if bestScore == nil or score > bestScore + EPS then bestX, bestZ, bestScore = x, z, score end
        end
    end
    return bestX, bestZ
end

-- the spot a named aim wants in their half, seen from where i hit: open spot (nobody there: far corner), the back corner farthest from me
-- or nearest me, the middle of their back line, straight across, or a short drop just over the net straight across
function M.spot(name, from, half, opponents)
    local minX, maxX, near, back = inset(half)
    local acrossX = math.clamp(from.X, math.min(minX, maxX), math.max(minX, maxX))
    if name == "Open Spot" and opponents and #opponents > 0 then return openSpot(half, opponents) end
    if name == "Straight Over" then return acrossX, half.netZ + half.s * STRAIGHT_SHARE * M.depth(half) end
    if name == "Short Drop" then return acrossX, half.netZ + half.s * SHORT_DEPTH end
    if name == "Deep Middle" then return half.cx, back end
    local leftFar = math.abs(minX - from.X) >= math.abs(maxX - from.X)
    if name == "Near Corner" then return leftFar and maxX or minX, back end
    return leftFar and minX or maxX, back
end

-- every spot a pick could mean, as { name, x, z }: each named spot, and for one tied to a side of their court (the corners, straight
-- over, a short drop) its mirror across their half's middle too, so a defender standing on one side sends it to the other
function M.candidates(names, from, half, opponents)
    local out = {}
    for _, name in ipairs(names) do
        local x, z = M.spot(name, from, half, opponents)
        out[#out + 1] = { name = name, x = x, z = z }
        if name ~= "Open Spot" and name ~= "Deep Middle" then
            local mx = 2 * half.cx - x
            if math.abs(mx - x) > EPS then out[#out + 1] = { name = name, x = mx, z = z, mirrored = true } end
        end
    end
    return out
end

-- lexicographic "a beats b" on two keys, both smaller-is-better
local function beats(a1, a2, b1, b2)
    if b1 == nil then return true end
    if a1 < b1 - EPS then return true end
    return math.abs(a1 - b1) <= EPS and a2 < b2 - EPS
end

-- a landing the net blocks counts this far out when nothing lands in
local NET_BLOCKED = 0.5

-- the landing nearest (tx, tz) of a hit leaving `from` that carries anywhere from rMin to rMax: the spot itself when it is in and in reach,
-- else the in-court one nearest it from every direction 3° apart across the half-circle facing their side, else the one least out;
-- `clears(x, z, carry)`, when given, says whether that flight gets over the net, and a landing it blocks is never taken as in; returns x, z, carry, landsIn
function M.reach(from, tx, tz, rMin, rMax, half, clears)
    local dx, dz = tx - from.X, tz - from.Z
    local d = math.sqrt(dx * dx + dz * dz)
    if d >= rMin - EPS and d <= rMax + EPS and M.outside(half, tx, tz) <= 0 and (not clears or clears(tx, tz, d)) then
        return tx, tz, d, true
    end

    local radii = { math.clamp(d, rMin, rMax) }
    if rMax - rMin > EPS then
        for k = 0, RINGS do radii[#radii + 1] = rMin + (rMax - rMin) * k / RINGS end
    end

    local inX, inZ, inR, in1, in2
    local outX, outZ, outR, out1, out2
    for i = 0, 180 / STEP_DEG do
        local deg = -90 + i * STEP_DEG
        local a = math.rad(deg)
        local sx, cz = math.sin(a), half.s * math.cos(a)
        local off = math.abs(deg)
        for _, r in ipairs(radii) do
            local x, z = from.X + sx * r, from.Z + cz * r
            local out = M.outside(half, x, z)
            if out <= 0 and clears and not clears(x, z, r) then out = NET_BLOCKED end
            if out <= 0 then
