-- shared orchestrator scaffolding (maid + tracked conns + subCtx + Unloader register) for feature init.lua files
local Identity = require("Utility/Identity")
local Log      = require("Utility/Log")

local M = {}

local function resolveNewMaid(ctx)
    if type(ctx.NewMaid) == "function" then return ctx.NewMaid end
    if ctx.Maid and type(ctx.Maid.new) == "function" then
        return function() return ctx.Maid.new() end
    end
    return nil
end

function M.orchestrator(ctx, name)
    -- the feature mounted before this one may have called into the game and dropped the identity its Add* calls need
    Identity.elevate()
    local newMaid = resolveNewMaid(ctx)
    if not newMaid then
        Log.warn(("[%s] Missing ctx.NewMaid; module will not initialize."):format(name or "Mount"))
        return nil
    end

    local moduleMaid = newMaid()
    local tracked = {}
    local teardown = {}
    local registered = false
    local cleaned = false

    local function cleanup()
        -- exposed on the orchestrator and registered with the Unloader, guarded so a direct call followed by unload can't run every teardown twice
        if cleaned then return end
        cleaned = true
        -- disconnect before teardown so watchers can't race state-restore
        for conn in pairs(tracked) do
            local okDc, errDc = pcall(function()
                if conn and conn.Disconnect then conn:Disconnect() end
            end)
            if not okDc then
                Log.warn(("[%s] Mount: tracked disconnect failed: %s"):format(name or "Mount", tostring(errDc)))
            end
            tracked[conn] = nil
        end
        local okMaid, errMaid = pcall(function() moduleMaid:DoCleaning() end)
        if not okMaid then
            Log.warn(("[%s] Mount: maid cleanup failed: %s"):format(name or "Mount", tostring(errMaid)))
        end
        for i = #teardown, 1, -1 do
            local okTd, errTd = pcall(teardown[i])
            if not okTd then
                Log.warn(("[%s] Mount: teardown[%d] failed: %s"):format(name or "Mount", i, tostring(errTd)))
            end
        end
    end

    -- registers cleanup with the Unloader on first tracked resource, so a mid-body error can't orphan connections
    local function ensureRegistered()
        if registered then return end
        registered = true
        if ctx.Unloader and ctx.Unloader.Register then
            ctx.Unloader:Register(cleanup)
        end
    end

    local function track(conn)
        if conn then
            tracked[conn] = true
            ensureRegistered()
        end
        return conn
    end

    local function subCtx(extras)
        local lib = ctx.Library
        local base = {
            -- forwarded like everything else: a feature reading ctx.Api on a sub-ctx that dropped it silently renders nothing
            Api        = ctx.Api,
            Services   = ctx.Services,
            Tabs       = ctx.Tabs,
            References = ctx.References,
            Library    = lib,
            Options    = ctx.Options or (lib and lib.Options),
            Toggles    = ctx.Toggles or (lib and lib.Toggles),
            Window     = ctx.Window,
            Helpers    = ctx.Helpers,
            Maid       = ctx.Maid,
            NewMaid    = ctx.NewMaid,
            track      = track,
