__bundle_register("Features/Volleyball/Progress/Account", function(require, _LOADED, __bundle_register, __bundle_modules)
-- progress account: the account box; yen, gems, spins, level and rank from the cached profile plus what this session gained, redrawn on profile updates and every 5 s
local Jobs = require("Utility/Jobs")
local Text = require("Features/Volleyball/Progress/Text")

local REFRESH_EVERY = 5
local WATCHED       = { Statistics = true, Seasonal = true }
local PENDING       = "…"

local M = {}

-- kit: Profile, O, session
function M.new(kit, box)
    local Profile, session = kit.Profile, kit.session
    local baseline

    local function line(text)
        return Text.writer(box:AddLabel(text .. ": " .. PENDING))
    end

    local yen          = line("Yen")
    local gems         = line("Gems")
    local styleSpins   = line("Style Spins")
    local abilitySpins = line("Ability Spins")
    local level        = line("Level")
    local rank         = line("Rank")
    box:AddDivider()
    box:AddLabel("This Session")
    local gainedYen    = line("Yen")
    local gainedGems   = line("Gems")
    local spinsUsed    = line("Spins Used")

    local function spinPair(spins, normal, lucky)
        return ("%s + %s lucky"):format(Text.number(spins[normal]), Text.number(spins[lucky]))
    end

    local function refresh()
        local okCurrency, currency = Profile.currencies()
        local okSpins, spins = Profile.spins()
        local okRank, ranked = Profile.rank()
        local levelNow = Profile.level()
        -- gains count from the first fully loaded read, so a half-loaded profile never reads as a gain
        if not baseline and okCurrency and Profile.isLoaded() then
            baseline = { yen = currency.yen, gems = currency.gems }
        end
        local rankName = okRank and Text.clean(ranked.rankName) or ""

        yen("Yen: " .. (okCurrency and Text.number(currency.yen) or PENDING))
        gems("Gems: " .. (okCurrency and Text.number(currency.gems) or PENDING))
        styleSpins("Style Spins: " .. (okSpins and spinPair(spins, "style", "styleLucky") or PENDING))
        abilitySpins("Ability Spins: " .. (okSpins and spinPair(spins, "ability", "abilityLucky") or PENDING))
        level("Level: " .. (levelNow > 0 and Text.number(levelNow) or PENDING))
        rank("Rank: " .. (rankName ~= "" and rankName or PENDING))
        gainedYen("Yen: " .. (baseline and okCurrency and Text.signed(currency.yen - baseline.yen) or PENDING))
        gainedGems("Gems: " .. (baseline and okCurrency and Text.signed(currency.gems - baseline.gems) or PENDING))
        spinsUsed("Spins Used: " .. Text.number(session.rolls))
    end

    return {
        refresh = refresh,
        -- starts the redraws; call once every box is built
        begin = function()
            kit.O.track(Profile.changed:Connect(function(key)
                if WATCHED[key] then refresh() end
            end))
            kit.O.maid:GiveTask(Jobs.interval(REFRESH_EVERY, refresh, { name = "ProgressAccount", immediate = true }))
        end,
    }
end

return M

end)
__bundle_register("Features/Volleyball/Assist", function(require, _LOADED, __bundle_register, __bundle_modules)
-- assist: wires the play tab's assist box (aim assist, auto ability, auto join team), the jump and dive assist box (both built by Assist/Menu) and the shared hit settings box (aim spots, spread, hit range) to their parts, each control driving its own part; aim runs while Aim Assist or Auto Hit is on, and everything a part changed in the game goes back on unload
local Log         = require("Utility/Log")
local Mount       = require("Utility/Mount")
local HitSettings = require("Features/Volleyball/HitSettings")
local Aim         = require("Features/Volleyball/Assist/Aim")
local AutoAbility = require("Features/Volleyball/Assist/AutoAbility")
local AutoJoin    = require("Features/Volleyball/Assist/AutoJoin")
local HitRange    = require("Features/Volleyball/Assist/HitRange")
local Reach       = require("Features/Volleyball/Assist/Reach")

return function(ctx)
    local O = Mount.orchestrator(ctx, "Assist")
    if not O then return {} end

    local Tabs    = ctx.Tabs
    local Options = ctx.Options
    local Toggles = ctx.Toggles
    local Api     = ctx.Api
    -- both boxes are built before this mounts (Tabs/Volleyball)
    if not (Tabs and Tabs.Play and Options and Toggles and Options.VL_AimSpots and Toggles.VL_AimAssist) then
        O.finalize()
        return {}
    end

    if not (Api and Api.Net and Api.Match and Api.Ball and Api.Actions) then
        Log.devwarn("Assist", "game apis missing; assist controls stay idle")
        O.finalize()
        return {}
    end

    local aim = Aim.new({
        Match = Api.Match, Net = Api.Net, Ball = Api.Ball, Actions = Api.Actions, References = ctx.References, maid = O.maid,
        Workspace = ctx.Services and ctx.Services.Workspace,
        -- the ping players see (Stats "Data Ping", a round trip), so a hit is planned where the server will meet the ball
        ping = function()
            local okI, item = pcall(function() return ctx.Services.Stats.Network.ServerStatsItem["Data Ping"] end)
            if not (okI and item) then return 0 end
            local okV, ms = pcall(item.GetValue, item)
            return (okV and type(ms) == "number") and ms / 1000 or 0
        end,
        timing = function()
            local o = Options.VL_SwingTiming
            return (o and tonumber(o.Value) or 0) / 1000
        end,
        adjust = function()
            local t = Toggles.VL_AimAdjust
            return t ~= nil and t.Value == true
        end,
        -- what auto hit plays on the ground and in the air, so an early turn plans the hit that follows
        moves = function()
            local ground, air = Options.VL_HitWith, Options.VL_AirHit
            local g = ground and ground.Value == "Set" and "Set" or "Bump"
            local a = air and air.Value == "Jump Set" and "JumpSet" or "Spike"
            return g, a
        end,
    })
    local range = HitRange.new({ Net = Api.Net, maid = O.maid })
    local ability = AutoAbility.new({ Match = Api.Match, Ball = Api.Ball, Actions = Api.Actions, maid = O.maid })
    local join = AutoJoin.new({ Match = Api.Match, maid = O.maid })
    local reach = Reach.new({
        Ball = Api.Ball, Actions = Api.Actions, Match = Api.Match, References = ctx.References,
        Workspace = ctx.Services and ctx.Services.Workspace, maid = O.maid,
        airMove = function()
            local air = Options.VL_AirHit
            return air and air.Value == "Jump Set" and "JumpSet" or "Spike"
        end,
    })

    O.onUnload(aim.stop)
    O.onUnload(range.stop)
    O.onUnload(ability.stop)
    O.onUnload(join.stop)
    O.onUnload(reach.stop)

    local function applyAim()
        aim.setServe(HitSettings.serveWanted(Toggles))
        if HitSettings.aimWanted(Toggles) then aim.setSpots(HitSettings.read(Options)) else aim.setSpots({}) end
    end
    local function applySpread() aim.setSpread(Options.VL_AimSpread.Value) end
    local function applyRange() range.setPercent(Options.VL_HitRange.Value) end
    local function applyAbility() ability.setEnabled(Toggles.VL_AutoAbility.Value) end
    local function applyJoin() join.setEnabled(Toggles.VL_AutoJoin.Value) end
    local function applyReach()
        if not (Toggles.VL_JumpAssist and Toggles.VL_DiveAssist and Options.VL_ReachBoost) then return end
        reach.setBoost(Options.VL_ReachBoost.Value)
        reach.setJump(Toggles.VL_JumpAssist.Value)
        reach.setDive(Toggles.VL_DiveAssist.Value)
    end

    Toggles.VL_AimAssist:OnChanged(applyAim)
    O.onUnload(HitSettings.onAimGate(applyAim))
    Options.VL_AimSpots:OnChanged(applyAim)
    for _, spot in ipairs(HitSettings.SPOTS) do
        local share = Options[spot.id]
        if share then share:OnChanged(applyAim) end
    end
    Options.VL_AimSpread:OnChanged(applySpread)
    Options.VL_HitRange:OnChanged(applyRange)
    Toggles.VL_AutoAbility:OnChanged(applyAbility)
    Toggles.VL_AutoJoin:OnChanged(applyJoin)
    if Toggles.VL_JumpAssist then Toggles.VL_JumpAssist:OnChanged(applyReach) end
    if Toggles.VL_DiveAssist then Toggles.VL_DiveAssist:OnChanged(applyReach) end
    if Options.VL_ReachBoost then Options.VL_ReachBoost:OnChanged(applyReach) end

    -- a config may already have set these before the handlers existed
    applySpread()
    applyAim()
    applyRange()
    applyAbility()
    applyJoin()
    applyReach()

    O.finalize()
    return {}
end

end)
__bundle_register("Features/Volleyball/Assist/Reach", function(require, _LOADED, __bundle_register, __bundle_modules)
-- reach: jump and dive assist; while i'm in a jump or a dive with a ball coming it re-plans every frame where my air hit's clean zone (or my dive's box) meets the ball and steers there before physics: a jump's launch speed once at take-off and its drift after, a dive's direction and push; never more than the boost past what the game gives, and once the ball is hit it holds the last steer so the game's own drift never snaps back
local Scheduler = require("Utility/Scheduler")
local Contact   = require("Features/Volleyball/Contact")

local STEP            = 1 / 60 -- the meeting-time scan
local MIN_MEET        = 0.08   -- a meeting sooner than this can't be swung for
local HORIZON         = 1.6
local VERT_TOL        = 0.8    -- share of the clean zone's half height the ball may sit off its middle
local LAUNCH_STEPS    = 8      -- launch speeds tried across the allowed range at take-off
local LAUNCH_MIN      = 0.5    -- of the game's launch: a first frame climbing slower than this is no fresh take-off (assist turned on mid-jump)
local LAUNCH_COST     = 1.5    -- a launch off the game's own, weighed against a centred contact
local DRIFT_COST      = 0.5
local TIME_COST       = 0.15
local OVERSPEED_COST  = 3
local REACH_SLACK     = 1.5    -- a meeting needing up to this many times the allowed speed is still steered for, at the allowed speed
local HIT_KICK        = 12     -- a ball whose velocity jumps this much between frames has been hit
local NET_CLEAR       = 1.5
local DIVE_TIME       = 1.08   -- the dive's push fades to 1% over this long, then the game removes it (Dive.lua:78,121: 0.9 x Duration 1.2)
local DIVE_FADE       = 0.99
local DIVE_EFF        = 0.82   -- share of that push the ground lets through, measured live
local DIVE_SPEED_COST = 1
local DEFAULT_WALK    = 23     -- StarterPlayer.CharacterWalkSpeed in this game
local DEFAULT_GRAVITY = 196.2
local PREDICT_OPTS    = { horizon = HORIZON, samples = 2 }
local LANDING_OPTS    = { samples = 2 }

local M = {}

-- a point pulled back so it stays NET_CLEAR inside my half; unchanged while the net is unknown
local function onMySide(x, z, net)
    if not net then return x, z end
    if (z - net.z) * net.side >= NET_CLEAR then return x, z end
    return x, net.z + net.side * NET_CLEAR
end

-- the cheapest meeting on one vertical flight (launch vy from root now) between my air hit's clean zone and the ball; extra is what that launch costs
local function bestAir(o, vy, extra, best)
    local rise = math.max(o.root.Y - o.groundY, 0)
    local tLand = (vy + math.sqrt(vy * vy + 2 * o.g * rise)) / o.g
    local t = MIN_MEET
    local tEnd = math.min(o.horizon, tLand)
    while t <= tEnd do
        local ball = o.pred.positionAt(t)
        local dy = ball.Y - (o.root.Y + vy * t - 0.5 * o.g * t * t + o.offset.Y)
        if math.abs(dy) <= o.halfY * VERT_TOL then
            local tx, tz = onMySide(ball.X - o.offset.X, ball.Z - o.offset.Z, o.net)
            local vx, vz = (tx - o.root.X) / t, (tz - o.root.Z) / t
            local speed = math.sqrt(vx * vx + vz * vz)
            local cost = math.abs(dy) / o.halfY + DRIFT_COST * speed / o.hCap + TIME_COST * t + extra
            if speed > o.hCap then cost = cost + OVERSPEED_COST * (speed - o.hCap) / o.hCap end
            if not best or cost < best.cost then
                best = { t = t, vx = vx, vz = vz, speed = speed, vy = vy, cost = cost }
            end
        end
        t = t + STEP
    end
    return best
end

-- at take-off: the launch (o.vyLo..o.vyHi around the game's o.vy0) and drift that meet the ball best; { t, vx, vz, speed, vy } or nil.
-- o: pred, root, g, groundY, offset (root to clean zone centre, world), halfY (zone half height), hCap, horizon, net = { z, side } or nil
function M.takeoff(o)
    local best = bestAir(o, o.vy0, 0, nil)
    for i = 0, LAUNCH_STEPS do
        local vy = o.vyLo + (o.vyHi - o.vyLo) * i / LAUNCH_STEPS
        best = bestAir(o, vy, LAUNCH_COST * math.abs(vy - o.vy0) / o.vy0, best)
    end
    return best
end

-- in the air: the drift that meets the ball best on the flight i'm on (o.vy now)
function M.drift(o)
    return bestAir(o, o.vy, 0, nil)
end

-- a dive o.s0 seconds in: the direction and push scale k (of the game's own) that bring my dive box's centre onto the ball before the push is spent;
-- { t, ux, uz, k (capped at o.kHi), need (uncapped) } or nil. o: pred, root, s0, v0, ahead/up (root to box centre along facing / up), halfY, kHi, horizon, net
function M.dive(o)
    local best
    local t = STEP
    local tEnd = math.min(o.horizon, DIVE_TIME - o.s0)
    while t <= tEnd do
        local ball = o.pred.positionAt(t)
        if math.abs(ball.Y - (o.root.Y + o.up)) <= o.halfY then
            local tx, tz = onMySide(ball.X, ball.Z, o.net)
            local dx, dz = tx - o.root.X, tz - o.root.Z
            local dist = math.sqrt(dx * dx + dz * dz)
            local s1 = o.s0 + t
            local pushed = DIVE_EFF * o.v0 * (t - DIVE_FADE * 0.5 * (s1 * s1 - o.s0 * o.s0) / DIVE_TIME)
            if dist > 1e-6 and pushed > 1e-6 then
                local need = math.max(0, dist - o.ahead) / pushed
                local cost = DIVE_SPEED_COST * math.abs(need - 1) + TIME_COST * t
                if need > o.kHi then cost = cost + OVERSPEED_COST * (need - o.kHi) end
                if not best or cost < best.cost then
                    best = { t = t, ux = dx / dist, uz = dz / dist, need = need, k = math.min(need, o.kHi), cost = cost }
                end
            end
        end
        t = t + STEP
    end
    return best
end

-- deps: Ball, Actions, Match, References, Workspace, maid, airMove() -> "Spike" | "JumpSet"
function M.new(deps)
    local Ball, Actions, Match = deps.Ball, deps.Actions, deps.Match
    local References, Workspace, maid = deps.References, deps.Workspace, deps.maid

    local loop, loopSlot
    local jumpOn, diveOn, boost = false, false, 0
    local walk = DEFAULT_WALK
    local jump, dive
    local lastBall

    local function gravity()
        local ok, g = pcall(function() return Workspace.Gravity end)
        if ok and type(g) == "number" and g > 0 then return g end
        return DEFAULT_GRAVITY
    end

    -- my half: the side of the net i stand in
    local function netFor(rootPos)
        local ok, court = Match.court()
        if not ok or type(court) ~= "table" or court.net == nil then return nil end
        local okZ, z = pcall(function() return court.net.Position.Z end)
        if not okZ or type(z) ~= "number" then return nil end
        return { z = z, side = rootPos.Z >= z and 1 or -1 }
    end

    -- the ball as seen this frame and whether it was just hit; none while it lies on the floor
    local function readBall()
        local okA, view = Ball.active()
        if not okA or type(view) ~= "table" or view.position == nil or view.velocity == nil then
            lastBall = nil
            return nil, false
        end
        local hit = lastBall ~= nil and lastBall.id == view.id and (view.velocity - lastBall.velocity).Magnitude > HIT_KICK
        lastBall = { id = view.id, velocity = view.velocity }
        local okL, land = Ball.landing(LANDING_OPTS)
        if okL and type(land) == "table" and land.resting then return nil, hit end
        local okP, pred = Ball.predict(PREDICT_OPTS)
        if not okP or type(pred) ~= "table" then return nil, hit end
        return pred, hit
    end

    local function setDrift(root, vx, vz)
        local v = root.AssemblyLinearVelocity
        root.AssemblyLinearVelocity = Vector3.new(vx, v.Y, vz)
    end

    local function airPlan(root, pred)
        local okH, hb = Actions.hitbox(deps.airMove())
        if not okH or type(hb) ~= "table" or hb.Offset == nil or hb.Size == nil then return nil end
        local cf = root.CFrame
        local pos = cf.Position
        local v = root.AssemblyLinearVelocity
        local o = {
            pred = pred, root = pos, g = gravity(), groundY = jump.groundY,
            offset = cf:VectorToWorldSpace(hb.Offset.Position + Contact.centre(hb.Size)),
            halfY = hb.Size.Y * (Contact.CONTACT_TOP - Contact.CONTACT_LOW) / 2,
            hCap = walk * (1 + boost), horizon = HORIZON, net = netFor(pos),
        }
        if jump.fresh then
            o.vy0, o.vyLo, o.vyHi = v.Y, v.Y * (1 - boost), v.Y * (1 + boost)
            local plan = M.takeoff(o)
            -- the launch only changes for a meeting the drift can make
            if plan and plan.speed <= o.hCap and plan.vy ~= v.Y then
                root.AssemblyLinearVelocity = Vector3.new(v.X, plan.vy, v.Z)
            end
            return plan, o.hCap
        end
        o.vy = v.Y
        return M.drift(o), o.hCap
    end

    local function stepJump(root, pred, hit)
        if not jump then
            -- the game set the launch as the jump began (Jump.Physics.lua:24), so a fresh one climbs at full speed on its first frame here;
            -- a serve's jump (the toss left its Power on my character) is left alone: drift would carry me over the end line
            local vy = root.AssemblyLinearVelocity.Y
            local okP, power = pcall(function() return root.Parent:GetAttribute("Power") end)
            jump = { groundY = root.Position.Y, fresh = vy > 0 and vy >= LAUNCH_MIN * 30, serve = okP and power ~= nil }
        end
        if jump.serve then return end
        if hit and jump.vx then jump.held = true end
        if not jump.held and pred then
            local plan, hCap = airPlan(root, pred)
            if plan and plan.speed <= hCap * REACH_SLACK then
                local scale = math.min(1, hCap / math.max(plan.speed, 1e-6))
                jump.vx, jump.vz = plan.vx * scale, plan.vz * scale
            end
        end
        jump.fresh = false
        if jump.vx then setDrift(root, jump.vx, jump.vz) end
    end

    local function divePlan(root, pred, s)
        local okH, hb = Actions.hitbox("Dive")
        if not okH or type(hb) ~= "table" or hb.Offset == nil or hb.Size == nil then return nil end
        local okR, radius = Ball.radius()
        local centre = hb.Offset.Position
        local pos = root.Position
        return M.dive({
            pred = pred, root = pos, s0 = s, v0 = dive.v0, ahead = -centre.Z, up = centre.Y,
            halfY = hb.Size.Y / 2 - ((okR and type(radius) == "number") and radius or 0),
            kHi = 1 + boost, horizon = HORIZON, net = netFor(pos),
        })
    end

    -- a dive in progress, read off what it builds: a plane LinearVelocity on my root holding an AlignOrientation (Dive.lua:76-110); the game
    -- publishes no diving state, and a dive that met a wall at once builds none
    local function divePush(root)
        local lv = root:FindFirstChildOfClass("LinearVelocity")
        if not lv then return nil end
        local ok, plane = pcall(function() return lv.VelocityConstraintMode == Enum.VelocityConstraintMode.Plane end)
        if not (ok and plane) then return nil end
        local ao = lv:FindFirstChildOfClass("AlignOrientation")
        if not ao then return nil end
        return lv, ao
    end

    local function stepDive(root, lv, ao, pred, hit, now)
        if not dive or dive.lv ~= lv then
            local ok, pv = pcall(function() return lv.PlaneVelocity end)
            if not ok or pv.Magnitude < 1 then return end
            dive = { lv = lv, ao = ao, at = now, v0 = pv.Magnitude }
        end
        local s = now - dive.at
        if hit and dive.ux then dive.held = true end
        if not dive.held and pred then
            local plan = divePlan(root, pred, s)
            if plan and plan.need <= (1 + boost) * REACH_SLACK then
                dive.ux, dive.uz, dive.k = plan.ux, plan.uz, plan.k
            end
        end
        if not dive.ux then return end
        local push = dive.k * dive.v0 * math.max(1 - DIVE_FADE, 1 - DIVE_FADE * s / DIVE_TIME)
        lv.PlaneVelocity = Vector2.new(dive.ux, dive.uz) * push
        ao.CFrame = CFrame.lookAt(Vector3.zero, Vector3.new(dive.ux, 0, dive.uz))
    end

    -- the stepped lane: after the game's jump and dive steps have written their velocities, before physics reads them
    local function step()
        local root = References.humanoidRootPart
        local hum = References.humanoid
        if not (root and root.Parent) then
            jump, dive = nil, nil
            return
        end
        local okS, st = Actions.state()
        local jumping = jumpOn and okS == true and type(st) == "table" and st.IsJumping == true
        local lv, ao
        if diveOn then lv, ao = divePush(root) end
        local diving = lv ~= nil
        if not jumping then jump = nil end
        if not diving then dive = nil end
        if not (jumping or diving) then
            -- jumps and dives zero WalkSpeed, so remember the last real one
            local okW, w = pcall(function() return hum and hum.WalkSpeed end)
            if okW and type(w) == "number" and w > 0 then walk = w end
            lastBall = nil
            return
        end
        local pred, hit = readBall()
        if jumping then stepJump(root, pred, hit) end
        if diving then stepDive(root, lv, ao, pred, hit, os.clock()) end
    end

    local function stopLoop()
        if loop then maid[loopSlot] = nil end
        loop, loopSlot = nil, nil
        jump, dive, lastBall = nil, nil, nil
    end

    local function refresh()
        if not (jumpOn or diveOn) then
            stopLoop()
            return
        end
        if loop then return end
        loop = Scheduler.stepped(step, { name = "Assist/Reach" })
        if loop then loopSlot = maid:GiveTask(loop) end
    end

    return {
        setJump = function(on) jumpOn = on == true refresh() end,
        setDive = function(on) diveOn = on == true refresh() end,
        setBoost = function(percent) boost = math.clamp((tonumber(percent) or 0) / 100, 0, 1) end,
        stop = stopLoop,
    }
end

return M

end)
__bundle_register("Features/Volleyball/Assist/HitRange", function(require, _LOADED, __bundle_register, __bundle_modules)
-- hit range: grows every move's client hitbox by wrapping the game's hitbox lookup, which the move code reads off the module table on each swing (Orchestrator.lua:72), so each call returns a scaled copy and the game's cached entry is never touched; at most one wrapper, and the exact original goes back at 100% and on unload
local Log       = require("Utility/Log")
local Scheduler = require("Utility/Scheduler")

local HITBOX_PATH = "ReplicatedStorage.Tools.Hitbox"
-- how often the module is re-resolved while widened, so a replaced module or lookup is picked up
local RECHECK     = 3
local MIN_PERCENT = 100
local MAX_PERCENT = 200

-- every wrapper made this session, mapped to what it wraps, so one of ours found in place is peeled rather than stacked
local OWN = setmetatable({}, { __mode = "k" })

local M = {}

-- a new entry with the same fields and a scaled size; Offset, Custom and DebugColor are shared, never mutated
local function scaledCopy(entry, factor)
    local copy = {}
    for k, v in pairs(entry) do copy[k] = v end
    if typeof(entry.Size) == "Vector3" then copy.Size = entry.Size * factor end
    return copy
end

function M.new(deps)
    local Net  = deps.Net
    local maid = deps.maid

    local factor = 1
    -- the module table we wrote to, the function we found there, and our wrapper standing in for it
