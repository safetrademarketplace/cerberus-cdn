__bundle_register("Api/Profile/Claims", function(require, _LOADED, __bundle_register, __bundle_modules)
-- profile claims: the free reward claims, each sent with the exact shape the game's own button sends and only when that button would be live for this player; everything else is refused before any remote
local Errors = require("Api/Profile/Errors")
local Rules  = require("Api/Profile/Rules")

local M = {}

-- kit: Net, cache, mod, PATH, currentSlice, freshSlice, questList, overall, forcedStyle, level, exclusive, answered, acknowledged
function M.new(kit)
    local Net, cache, mod, PATH = kit.Net, kit.cache, kit.mod, kit.PATH
    local exclusive, answered, acknowledged = kit.exclusive, kit.answered, kit.acknowledged
    local tableOr, number = Rules.tableOr, Rules.number

    local function findQuest(list, index)
        for _, entry in ipairs(list) do
            if entry.index == index then return entry end
        end
        return nil
    end

    -- the quests panel, daily and seasonal tabs alike, only exists while the season is live (C.SeasonController:36-44,87-93)
    local function claimQuest(index, isSeasonal)
        if not Rules.isIndex(index) or (isSeasonal ~= nil and type(isSeasonal) ~= "boolean") then
            return false, Errors.BAD_ARGS
        end
        isSeasonal = isSeasonal == true
        return exclusive("quests", function()
            local held, err = cache.need(isSeasonal and "Seasonal" or "Quests")
            if not held then return false, err end
            local list, live = kit.questList(isSeasonal)
            if not list then return false, live end
            if not live then return false, Errors.SEASON_NOT_LIVE end
            local entry = findQuest(list, index)
            if not entry then return false, Errors.NOT_FOUND end
            if entry.claimed then return false, Errors.ALREADY_CLAIMED end
            if not entry.claimable then return false, Errors.NOT_COMPLETE end
            -- C.SeasonController.Quests.Quest:40-44
            return answered(Net.call("QuestService", "Claim", index, isSeasonal))
        end)
    end

    -- the claim-all button has no check of its own, so it is only sent when at least one quest on that tab is ready (C.SeasonController.Quests:29-36)
    local function claimAllQuests(isSeasonal)
        if isSeasonal ~= nil and type(isSeasonal) ~= "boolean" then return false, Errors.BAD_ARGS end
        isSeasonal = isSeasonal == true
        return exclusive("quests", function()
            local held, err = cache.need(isSeasonal and "Seasonal" or "Quests")
            if not held then return false, err end
            local list, live = kit.questList(isSeasonal)
            if not list then return false, live end
            if not live then return false, Errors.SEASON_NOT_LIVE end
            local ready = false
            for _, entry in ipairs(list) do
                if entry.claimable then
                    ready = true
                    break
                end
            end
            if not ready then return false, Errors.NOTHING_TO_CLAIM end
            return answered(Net.call("QuestService", "ClaimAll", isSeasonal))
        end)
    end

    local function liveSeason()
        local slice, id, season = kit.freshSlice()
        if not slice then return nil, id end
        if not Rules.isLive(season) then return nil, Errors.SEASON_NOT_LIVE end
        return slice, season
    end

    local function claimSeasonTier(tier)
        if not Rules.isIndex(tier) then return false, Errors.BAD_ARGS end
        return exclusive("seasonTier", function()
            local slice, season = liveSeason()
            if not slice then return false, season end
            local refusal = Rules.tierRefusal(season, slice, tier)
            if refusal then return false, refusal end
            -- C.SeasonController.SeasonPass.Rewards.Reward:50-56
            return acknowledged(Net.call("SeasonService", "RequestRewardClaim", tier))
        end)
    end

    -- both milestone menus hide outside a live season (C.RankedRewardsController.RankedRewards.Rewards:10-13, C.RankedRewardsController.Data:39-50)
    local function claimMilestone(requiredRank, index)
        if not Rules.isInteger(requiredRank) or (index ~= nil and not Rules.isIndex(index)) then
            return false, Errors.BAD_ARGS
        end
        return exclusive("milestone", function()
            local slice, season = liveSeason()
            if not slice then return false, season end
            local Ranks, rank = kit.overall(slice)
            if not Ranks then return false, Errors.NO_DATA end
            local refusal = Rules.milestoneRefusal(season, slice, Ranks, rank, requiredRank, index)
            if refusal then return false, refusal end
            -- the ranked track sends (rank, nil), the champion ladder (rank, 1|2) (Cm.MilestoneReward:84-86)
            return acknowledged(Net.call("SeasonService", "RequestMilestoneReward", requiredRank, index))
        end)
    end

    local function claimChallenge(levelIndex)
        if not Rules.isIndex(levelIndex) then return false, Errors.BAD_ARGS end
        return exclusive("challenge", function()
            local slice, err = kit.freshSlice()
            if not slice then return false, err end
            local rewards = mod(PATH.ChallengeRewards)
            if not rewards then return false, Errors.NO_DATA end
            -- the track reads the season's Ranked.Tournaments entry (C.ChallengeController:71-75)
            local refusal = Rules.challengeRefusal(rewards, tableOr(slice.Ranked).Tournaments, levelIndex)
            if refusal then return false, refusal end
            -- C.ChallengeController.RewardsTrack.ItemBtn:133-138
            return acknowledged(Net.call("ChallengeService", "ClaimReward", levelIndex))
        end)
    end

    -- the mastery menu follows the style in use (forced style first, else the active slot) and that style's MasteryId (C.MasteryController:58-67,103-136, C.StyleController:164-165)
    local function resolveMastery(slots, masteries)
        local Style, Mastery, Quest = mod(PATH.Style), mod(PATH.Mastery), mod(PATH.Quest)
        if not (Style and Mastery and Quest) then return nil, Errors.NO_DATA end
        local state = Rules.slotState(slots.Style)
        local styleId = kit.forcedStyle() or state.ids[state.active]
        local okStyle, style = pcall(Style.Get, Style, styleId)
        local meta = okStyle and type(style) == "table" and type(style.Metadata) == "table" and style.Metadata or nil
        local masteryId = meta and meta.MasteryId
        if not masteryId then return nil, Errors.NOT_OFFERED end
        local okMastery, mastery = pcall(Mastery.Get, Mastery, masteryId)
        if not okMastery or type(mastery) ~= "table" then return nil, Errors.NOT_OFFERED end
        local Type = tableOr(Mastery.Type)
        local found = { Quest = Quest }
        if mastery.Type == Type.Tree then
            local Tree = mod(PATH.MasteryTree)
            if not Tree then return nil, Errors.NO_DATA end
            -- tree progress is kept per style slot (C.MasteryController.TreeMenu:20-28)
            local profile = masteries[("%s_%s"):format(tostring(mastery.Id), tostring(state.active))]
            if type(profile) ~= "table" then profile = { Points = 0, Invested = "0,0,0", Quests = {} } end
            local okSum, invested = pcall(Tree.sumInvestedPoints, profile.Invested)
            if not okSum then return nil, Errors.NO_DATA end
            found.tree = true
            found.profile = profile
            -- the quest panel hides once every tree quest is done (C.MasteryController.TreeMenu:29-54)
            found.completed = #tableOr(tableOr(mastery.Tree).Quests) <= number(profile.Points) + number(invested)
        elseif mastery.Type == Type.Classic then
            local profile = masteries[masteryId]
            if type(profile) ~= "table" or profile.Type == Type.Tree then profile = { Level = 1, Quests = {} } end
            found.profile = profile
        else
            return nil, Errors.NOT_OFFERED
        end
        return found
    end

    local function masteryRefusal(found, questIndex)
        if found.tree then
            -- the tree panel only ever claims its single quest (C.MasteryController.TreeMenu.RightPanel.Quests:22-28,76-78)
            if questIndex ~= 1 then return Errors.NOT_FOUND end
            if found.completed then return Errors.NOT_OFFERED end
        end
        local raw = tableOr(found.profile.Quests)[questIndex]
        if type(raw) ~= "table" then return Errors.NOT_FOUND end
        if raw.Claimed then return Errors.ALREADY_CLAIMED end
        local ok, quest = pcall(found.Quest.deserialize, raw)
        if not ok or type(quest) ~= "table" then return Errors.NO_DATA end
        if not Rules.masteryQuestDone(quest) then return Errors.NOT_COMPLETE end
        return nil
    end

    -- below a full bar the game's button opens a robux skip instead, so that case is refused here (C.MasteryController.Masteries.Challenges.Template:111-136)
    local function claimMastery(questIndex)
        if not Rules.isIndex(questIndex) then return false, Errors.BAD_ARGS end
        return exclusive("mastery", function()
            local slots, err = cache.need("Slots")
            if not slots then return false, err end
            local masteries, errMasteries = cache.need("Masteries")
            if not masteries then return false, errMasteries end
            local found, errFound = resolveMastery(slots, masteries)
            if not found then return false, errFound end
            local refusal = masteryRefusal(found, questIndex)
            if refusal then return false, refusal end
            return answered(Net.call("MasteryService", "RequestClaim", questIndex))
        end)
    end

    local function levelRewardCount()
        local Level = mod(PATH.Level)
        if not Level or type(Level.getRewards) ~= "function" then return nil end
        local ok, rewards = pcall(Level.getRewards)
        if not ok or type(rewards) ~= "table" then return nil end
        return #rewards
    end

    local function claimLevelRewards()
        return exclusive("levels", function()
            local stats, err = cache.need("Statistics")
            if not stats then return false, err end
            local count = levelRewardCount()
            if not count then return false, Errors.NO_DATA end
            local refusal = Rules.levelRewardsRefusal(stats.LevelRewardsClaimed, kit.level(), count)
            if refusal then return false, refusal end
            -- the claim-all button sends no level (C.LevelRewardsController:128-131)
            return acknowledged(Net.call("LevelService", "ClaimLevelRewards"))
        end)
    end

    -- the presents menu switches itself off when no present is running, and only a running present gets a page (C.SeasonController.DailyPresents.StatesHandler:66-74,100-118)
    local function claimDailyPresent(serverIndex, isFree)
        if not Rules.isIndex(serverIndex) or type(isFree) ~= "boolean" then return false, Errors.BAD_ARGS end
        return exclusive("present", function()
            local TimedPresent, Quest = mod(PATH.TimedPresent), mod(PATH.Quest)
            if not (TimedPresent and Quest) or type(TimedPresent.getAllActive) ~= "function" then
                return false, Errors.NO_DATA
            end
            local okActive, active = pcall(TimedPresent.getAllActive)
            if not okActive or type(active) ~= "table" then return false, Errors.NO_DATA end
            if #active == 0 then return false, Errors.NOT_OFFERED end
            local presents, err = cache.need("DailyPresents")
            if not presents then return false, err end
            local entry = presents[serverIndex]
            if type(entry) ~= "table" then return false, Errors.NOT_FOUND end
            local running = false
            for _, present in ipairs(active) do
                if type(present) == "table" and present.Id == entry.Id then
                    running = true
                    break
                end
            end
            if not running then return false, Errors.NOT_OFFERED end
            if isFree then
                if entry.IsFreeClaimed then return false, Errors.ALREADY_CLAIMED end
            else
                local raw = entry.Quest
                if type(raw) ~= "table" then return false, Errors.NOT_FOUND end
                if raw.Claimed then return false, Errors.ALREADY_CLAIMED end
                local okQuest, quest = pcall(Quest.deserialize, raw)
                if not okQuest or type(quest) ~= "table" then return false, Errors.NO_DATA end
                -- the quest bar must be full (C.SeasonController.DailyPresents.Menu:78-80,110-117)
                if number(raw.Progress) < (tonumber(quest.Requirement) or math.huge) then return false, Errors.NOT_COMPLETE end
            end
            -- C.SeasonController.DailyPresents:55-77
            return answered(Net.call("SeasonService", "ClaimDailyPresent", serverIndex, isFree))
        end)
    end

    -- the code box is read-only below the level gate (C.ShopController.MenuFrame.Sections.Codes:21-56, RS.Configuration.Requirements:8)
    local function redeemCode(code)
        if type(code) ~= "string" then return false, Errors.BAD_ARGS end
        local text = code:match("^%s*(.-)%s*$")
        if text == "" then return false, Errors.BAD_ARGS end
        return exclusive("code", function()
            local Requirements = mod(PATH.Requirements)
            if not Requirements or type(Requirements.Code) ~= "number" then return false, Errors.NO_DATA end
            if kit.level() < Requirements.Code then return false, Errors.LEVEL_TOO_LOW end
            return answered(Net.callAllowed("CodeService", "Redeem", text))
        end)
    end

    -- everything the game's own menus would let this player claim right now, from the cache only; never yields
    local function claimable()
        local stats = cache.held("Statistics")
        local slice, _, season = kit.currentSlice()
        if not stats or not slice then return false, Errors.NOT_LOADED end
        local out = {
            seasonTiers = {}, milestones = {}, challenges = {}, mastery = {},
            levelRewards = false, quests = { daily = {}, seasonal = {} },
        }
        if Rules.isLive(season) then
            for tier = 1, #tableOr(tableOr(season.Rewards).Regular) do
                if not Rules.tierRefusal(season, slice, tier) then table.insert(out.seasonTiers, tier) end
            end
            local Ranks, rank = kit.overall(slice)
            if Ranks then
                local T = Ranks.Type
                for required = T.Bronze1, T.Pro do
                    if not Rules.milestoneRefusal(season, slice, Ranks, rank, required, nil) then
                        table.insert(out.milestones, { rank = required })
                    end
                end
                for required = T.Pro, T.UltimateChampion do
                    for index = 1, 2 do
                        if not Rules.milestoneRefusal(season, slice, Ranks, rank, required, index) then
                            table.insert(out.milestones, { rank = required, index = index })
                        end
                    end
                end
            end
            for _, isSeasonal in ipairs({ false, true }) do
                local list = kit.questList(isSeasonal)
                local into = out.quests[isSeasonal and "seasonal" or "daily"]
                for _, entry in ipairs(list or {}) do
                    if entry.claimable then table.insert(into, entry.index) end
                end
            end
        end
        local rewards = mod(PATH.ChallengeRewards)
        if rewards then
            local tournaments = tableOr(slice.Ranked).Tournaments
            for level = 1, number(rewards.MaxLevel) do
                if not Rules.challengeRefusal(rewards, tournaments, level) then table.insert(out.challenges, level) end
            end
        end
        local count = levelRewardCount()
        if count then
            out.levelRewards = Rules.levelRewardsRefusal(stats.LevelRewardsClaimed, kit.level(), count) == nil
        end
        local slots, masteries = cache.held("Slots"), cache.held("Masteries")
        local found = slots and masteries and resolveMastery(slots, masteries)
        if found then
            for index in pairs(tableOr(found.profile.Quests)) do
                if Rules.isIndex(index) and not masteryRefusal(found, index) then table.insert(out.mastery, index) end
            end
            table.sort(out.mastery)
        end
        return true, out
    end

    return {
        claimQuest        = claimQuest,
        claimAllQuests    = claimAllQuests,
        claimSeasonTier   = claimSeasonTier,
        claimMilestone    = claimMilestone,
        claimChallenge    = claimChallenge,
        claimMastery      = claimMastery,
        claimLevelRewards = claimLevelRewards,
        claimDailyPresent = claimDailyPresent,
        redeemCode        = redeemCode,
        claimable         = claimable,
    }
end

return M

end)
__bundle_register("Api/Profile/Cache", function(require, _LOADED, __bundle_register, __bundle_modules)
-- profile cache: top-level profile keys read through DataService:Get and kept current from ProfileUpdated plus each system's side channel, patched in place the way the game's own ui patches its copies
local Errors = require("Api/Profile/Errors")

local PREFETCH = { "Statistics", "Slots", "Seasonal", "Quests", "Masteries" }

local READY_POLL    = 1
local READY_TRIES   = 300
local FETCH_TRIES   = 3
local FETCH_BACKOFF = 2

local M = {}

M.PREFETCH = PREFETCH

-- deps: Net, base (logger), changed (signal fired (key, value) after every update), seasonId() -> current season id or nil
function M.new(deps)
    local Net, base, changed, seasonId = deps.Net, deps.base, deps.changed, deps.seasonId

    local values, has, replaced = {}, {}, {}
    local handles = {}
    local alive, listening, prefetched = true, false, false

    local function store(key, value)
        values[key] = value
        has[key] = true
        replaced[key] = (replaced[key] or 0) + 1
        changed:Fire(key, value)
    end

    -- a patch only lands on a key already held; the reply to a read still in flight was sent after it, so it already carries the change
    local function patch(key, fn)
        if not alive or not has[key] then return end
        local value = values[key]
        if type(value) ~= "table" then
            value = {}
            values[key] = value
        end
        fn(value)
        changed:Fire(key, value)
    end

    local function patchSeason(fn)
        if not alive or not has.Seasonal then return end
        local id = seasonId()
        if id == nil then return end
        patch("Seasonal", function(all)
            local slice = all[id]
            if type(slice) ~= "table" then
                slice = {}
                all[id] = slice
            end
            fn(slice)
        end)
    end

    -- whole subtree replace (Cm.Persistence:22-26)
    local function onProfileUpdated(key, value)
        if alive and type(key) == "string" then store(key, value) end
    end

    -- C.InterfaceController:134-147
    local function onQuestUpdated(index, data)
        if index == nil or type(data) ~= "table" then return end
        patchSeason(function(slice)
            local quests = type(slice.Quests) == "table" and slice.Quests or {}
            slice.Quests = quests
            local entry = type(quests[index]) == "table" and quests[index] or {}
            quests[index] = entry
            entry.Progress = data.Progress or entry.Progress
            if data.Claimed == nil then
                entry.Claimed = entry.Claimed or false
            else
                entry.Claimed = data.Claimed
            end
        end)
    end

    -- C.InterfaceController:148-152
    local function onSeasonUpdated(key, value)
        if key == nil then return end
        patchSeason(function(slice) slice[key] = value end)
    end

    -- C.InterfaceController:153-158
    local function onRankedUpdated(key, value)
        if key == nil then return end
        patchSeason(function(slice)
            local ranked = type(slice.Ranked) == "table" and slice.Ranked or {}
            slice.Ranked = ranked
            ranked[key] = value
        end)
    end

    -- C.CareerController:74-80
    local function onCareerUpdated(fields)
        if type(fields) ~= "table" then return end
        patch("Career", function(career)
            for k, v in pairs(fields) do career[k] = v end
        end)
    end

    -- C.InventoryController:101-105
    local function onInventoryChanged(itemId, count)
        if itemId == nil then return end
        patch("Inventory", function(inventory) inventory[itemId] = count end)
    end

    -- C.MasteryController:81-99
    local function onMasteryQuest(update)
        if type(update) ~= "table" or update.MasteryId == nil then return end
        patch("Masteries", function(masteries)
            local entry = type(masteries[update.MasteryId]) == "table" and masteries[update.MasteryId] or {}
            local quests = type(entry.Quests) == "table" and entry.Quests or {}
            for _, change in pairs(type(update.Updates) == "table" and update.Updates or {}) do
                if type(change) == "table" and change.Index ~= nil then
                    local quest = type(quests[change.Index]) == "table" and quests[change.Index] or {}
                    local new = change.New
                    if type(new) == "table" and new.Progress ~= nil then quest.Progress = new.Progress end
                    if type(new) == "table" and new.Claimed ~= nil then quest.Claimed = new.Claimed end
                    quests[change.Index] = quest
                end
            end
            entry.Quests = quests
            entry.Notification = update.Notification or entry.Notification
            masteries[update.MasteryId] = entry
        end)
    end

    local LISTENERS = {
        { "DataService",      "ProfileUpdated",   onProfileUpdated },
        { "QuestService",     "DataUpdated",      onQuestUpdated },
        { "SeasonService",    "DataUpdated",      onSeasonUpdated },
        { "RankedService",    "DataUpdated",      onRankedUpdated },
        { "CareerService",    "DataUpdated",      onCareerUpdated },
        { "InventoryService", "InventoryChanged", onInventoryChanged },
        { "MasteryService",   "OnQuestUpdate",    onMasteryQuest },
    }

    local function listen()
        if listening then return end
        listening = true
        for _, entry in ipairs(LISTENERS) do
            local handle, err = Net.on(entry[1], entry[2], entry[3])
            if handle then
                handles[#handles + 1] = handle
            else
                base.warn("could not watch %s.%s: %s", entry[1], entry[2], tostring(err))
            end
        end
    end

    -- yields; a whole-subtree update that lands while the read is in flight is at least as new as the reply, so it wins
    local function fetch(key)
        local before = replaced[key]
        local ok, value = Net.call("DataService", "Get", key)
        if not ok then return false, value end
        if not alive then return false, Errors.FAILED end
        if replaced[key] ~= before then return true, values[key] end
        store(key, value)
        return true, value
    end

    local cache = {}

    -- the prefetch job body: wait for knit, watch every channel, then read each key with a short backoff
    function cache.prefetch(job)
        local tries = 0
        while not Net.isReady() do
            tries = tries + 1
            if tries > READY_TRIES then
                base.warn("knit never started; profile not prefetched")
                return
            end
            if not job:sleep(READY_POLL) then return end
        end
        listen()
        for _, key in ipairs(PREFETCH) do
            local attempt = 0
            while not has[key] and attempt < FETCH_TRIES do
                if not job.alive or not alive then return end
                attempt = attempt + 1
                local ok, err = fetch(key)
                if not ok then
                    base.warn("could not read %s (try %d of %d): %s", key, attempt, FETCH_TRIES, tostring(err))
                    if attempt < FETCH_TRIES and not job:sleep(FETCH_BACKOFF * attempt) then return end
                end
            end
        end
        prefetched = true
        base.log("profile prefetched (%s)", cache.isLoaded() and "complete" or "partial")
    end

    function cache.isLoaded()
        if not prefetched then return false end
        for _, key in ipairs(PREFETCH) do
            if not has[key] then return false end
        end
        return true
    end

    -- the live cached subtree; callers treat it as read-only
    function cache.peek(key)
        return values[key]
    end

    -- a held key as a table ({} when the profile holds nothing there), nil when not held
    function cache.held(key)
        if not has[key] then return nil end
        local value = values[key]
        return type(value) == "table" and value or {}
    end

    function cache.get(key)
        if has[key] then return true, values[key] end
        return fetch(key)
    end

    function cache.refresh(key)
        return fetch(key)
    end

    -- held key or a read-through; (table) or (nil, err)
    function cache.need(key)
        local value = cache.held(key)
        if value then return value end
        local ok, fetched = fetch(key)
        if not ok then return nil, fetched end
        return type(fetched) == "table" and fetched or {}
    end

    function cache.destroy()
        alive = false
        for _, handle in ipairs(handles) do
            pcall(handle.Destroy, handle)
        end
        table.clear(handles)
        table.clear(values)
        table.clear(has)
    end

    return cache
end

return M

end)
__bundle_register("Api/Actions", function(require, _LOADED, __bundle_register, __bundle_modules)
-- actions api: performs one volleyball move the way the game's own input does, by driving the live GameController/InputController through ctx.Api.Net, so every client gate and the real CreateHitbox->Interact sequence run; it builds no remote payloads itself and mirrors the game's move gate read-only
local Identity = require("Utility/Identity")
local Jobs     = require("Utility/Jobs")
local Api      = require("Api")
local Errors = require("Api/Actions/Errors")

-- the moves this api drives through GameController:DoMove; jump/dive/toss/serve have their own verbs
local MOVES = { Bump = true, Set = true, Spike = true, JumpSet = true, Block = true }

-- the game's own move gate reads these five Fusion values off GameController (GC.Actions.Binding.Registry.DoMove.lua:57-60)
local GATE_KEYS = { "IsPlaying", "IsJumping", "IsBusy", "IsServing", "IsStunned" }

-- isAerial lives on each move entry here (ReplicatedStorage.Configuration.Actions)
local ACTIONS_PATH = "ReplicatedStorage.Configuration.Actions"
-- the game builds every move's client hitbox from this module (Orchestrator.lua:69-72)
local HITBOX_PATH = "ReplicatedStorage.Tools.Hitbox"
local HITBOX_MOVES = { Bump = true, Set = true, Spike = true, JumpSet = true, Block = true, Dive = true }

-- an aerial move lifts off first, then swings; bound so a stuck jump never hangs the swing forever
local JUMP_WAIT      = 0.75
local JUMP_POLL      = 0.03
-- the toss handler ignores a second press inside 0.5s (Toss.lua:52-58), so space the two serve presses past it
local SERVE_DEBOUNCE = 0.55
-- the power bar swings 0 -> 1 -> 0 every ~1.1 s and reads a perfect 1 for only 2-7 frames at its top (measured per frame), so the wait
-- looks every frame and spans two swings; a perfect serve leaves at 144.5 studs/s, a 0.78 one at 99.8
local SERVE_POWER_WAIT = 2.5

-- the charge a move sends (0..1) is a NumberValue held only as an upvalue of the power bar's getCharge (PowerBar.lua:844-846), and the one
-- function holding that component table is DoMove's getSpecialChargeAndReset (StyleSpecial.lua:37-41); a tap sends 1, a held move less
local CHARGE_FN = "getSpecialChargeAndReset"

local M = {}

function M.new(ctx)
    local base = Api.define("Actions", ctx)
    local Net  = ctx.Api and ctx.Api.Net

    -- every verb and mirror answers NO_NET instead of calling into a bus that isn't there
    if not Net then
        base.warn("net api missing; actions disabled")
        local function no() return false, Errors.NO_NET end
        return {
            Errors  = Errors,
            move    = function() return false, Errors.NO_NET end,
            jump    = no,
            dive    = function() return false, Errors.NO_NET end,
            toss    = no,
            serve   = function() return false, Errors.NO_NET end,
            canMove = function() return false, Errors.NO_NET end,
            state   = no,
            ultimate      = no,
            ultimateReady = no,
            hitbox        = function() return false, Errors.NO_NET end,
            charge        = no,
            setCharge     = function() return false, Errors.NO_NET end,
        }
    end

    local maid = base.maid

    -- runs body as a job and keeps it on the maid only while it is in flight, so unload cancels it and dead handles never pile up
    local function spawn(name, body)
        -- leak:allow no maid in this ctx is degenerate; the job registry still cancels it at unload via Jobs.cancelAll()
        if not maid then return Jobs.spawn(body, { name = name }) end
        local slot
        local handle = Jobs.spawn(function(job)
            body(job)
            if slot then maid[slot] = nil end
        end, { name = name })
        if not handle then return nil end
        slot = maid:GiveTask(handle)
        if not handle.alive then maid[slot] = nil end
        return handle
    end

    local function controller(name, code)
        local ok, value = Net.controller(name)
        if not ok then return false, code or Errors.NO_CONTROLLER end
        return true, value
    end

    -- read one GameController Fusion value defensively; (false) when the field or :get is absent, else (true, bool)
    local function readFlag(gc, key)
        local okIdx, obj = pcall(function() return gc[key] end)
        if not okIdx or type(obj) ~= "table" or type(obj.get) ~= "function" then return false end
        local okGet, value = pcall(obj.get, obj)
        if not okGet then return false end
        return true, value and true or false
    end

    -- snapshot the five gate flags; (false, NO_STATE) if the controller hasn't published them yet
    local function readState(gc)
        local st = {}
        for _, key in ipairs(GATE_KEYS) do
            local ok, value = readFlag(gc, key)
            if not ok then return false, Errors.NO_STATE end
            st[key] = value
        end
        return true, st
    end

    -- isAerial comes from the game's own config, never a hardcoded table
    local function resolveAerial(name)
        local ok, cfg = Net.module(ACTIONS_PATH)
        if not ok or type(cfg) ~= "table" then return false, Errors.NO_CONFIG end
        local entry = cfg[name]
        if type(entry) ~= "table" then return false, Errors.NO_CONFIG end
        return true, entry.IsAerial and true or false
    end

    -- the stun/busy/serving/playing part of the gate, shared by every verb
    local function refuseIfIdle(st)
        if st.IsStunned then return Errors.STUNNED end
        if st.IsBusy then return Errors.BUSY end
        if st.IsServing then return Errors.SERVING end
        if not st.IsPlaying then return Errors.NOT_PLAYING end
        return nil
    end

    -- calls a game controller method at the game's own identity (its lazy require()s refuse ours), then awaits any promise it returns
    local function callGame(label, obj, method, ...)
        local okCall, result = Identity.asGame(obj[method], obj, ...)
        if not okCall then
            base.warn("%s failed: %s", label, tostring(result))
            return
        end
        if type(result) == "table" and type(result.await) == "function" then
            base.safe(label, function() result:await() end)
        end
    end

    -- GameController:DoMove returns a Promise; we await it inside the job (never a per-frame task) so the game's orchestrator runs to completion
    local function doMove(gc, name, isAerial, opts)
        local meta = (type(opts) == "table" and type(opts.Metadata) == "table") and opts.Metadata or {}
        local args = {
            ActionName = name,
            IsAerial   = isAerial,
            InputState = Enum.UserInputState.Begin,
            Metadata   = meta,
        }
        callGame("DoMove:" .. name, gc, "DoMove", args)
    end

    -- matches the game's own jump binding: PerformJump, then tell the server it moved (Jump.lua:147-148)
    local function performJump(gc)
        callGame("PerformJump", gc, "PerformJump")
        Net.send("GameService", "RegisterMoved", "Jump")
    end

    -- wait for the jump state to go up before the aerial swing; returns false if cancelled or it never lifts
    local function waitForJumping(gc, job)
        local deadline = os.clock() + JUMP_WAIT
        while job.alive do
            local ok, st = readState(gc)
            if ok and st.IsJumping then return true end
            if os.clock() >= deadline then return false end
            if not job:sleep(JUMP_POLL) then return false end
        end
        return false
    end

    -- best-effort: hold the second serve press until the game's own power bar first reaches the target
    local function waitForServePower(gc, job, power)
        local target = math.clamp(power, 0, 1)
        local deadline = os.clock() + SERVE_POWER_WAIT
        while job.alive do
            local okIdx, obj = pcall(function() return gc.Power end)
            if not okIdx or type(obj) ~= "table" or type(obj.get) ~= "function" then return end
            local okGet, value = pcall(obj.get, obj)
            if okGet and type(value) == "number" and value >= target then return end
            if os.clock() >= deadline then return end
            if not job:sleep(0) then return end
        end
    end

    -- one Toss press through the game's own synthetic input (what the mobile button fires)
    local function performToss(ic)
        callGame("Toss", ic, "PerformAction", "Toss", Enum.UserInputState.Begin)
    end

    local function move(name, opts)
        if not MOVES[name] then return false, Errors.BAD_MOVE end
        if opts ~= nil and type(opts) ~= "table" then return false, Errors.BAD_ARGS end
        local okGc, gc = controller("GameController")
        if not okGc then return false, gc end
        local okA, isAerial = resolveAerial(name)
        if not okA then return false, isAerial end
        local okState, st = readState(gc)
        if not okState then return false, st end

        local refusal = refuseIfIdle(st)
        if refusal then return false, refusal end

        if not isAerial then
            -- the grounded gate also demands both feet down; mirror it rather than swing mid-air
            if st.IsJumping then return false, Errors.WRONG_STATE end
            spawn("Actions/move:" .. name, function(job)
                if not job.alive then return end
                doMove(gc, name, false, opts)
            end)
            return true
        end

        local alreadyJumping = st.IsJumping
        spawn("Actions/move:" .. name, function(job)
            if not job.alive then return end
            if not alreadyJumping then
                performJump(gc)
                if not waitForJumping(gc, job) then return end
            end
            if not job.alive then return end
            doMove(gc, name, true, opts)
        end)
        return true
    end

    local function jump()
        local okGc, gc = controller("GameController")
        if not okGc then return false, gc end
        local okState, st = readState(gc)
        if not okState then return false, st end
        local refusal = refuseIfIdle(st)
        if refusal then return false, refusal end
        if st.IsJumping then return false, Errors.WRONG_STATE end
        spawn("Actions/jump", function(job)
            if not job.alive then return end
            performJump(gc)
        end)
        return true
    end

    -- GameController:Dive gates itself (busy/stun/jumping/playing), so we pass its own options table straight through
    local function dive(opts)
        if opts ~= nil and type(opts) ~= "table" then return false, Errors.BAD_ARGS end
        local okGc, gc = controller("GameController")
        if not okGc then return false, gc end
        spawn("Actions/dive", function(job)
            if not job.alive then return end
            callGame("Dive", gc, "Dive", opts or {})
        end)
        return true
    end

    local function toss()
        local okIc, ic = controller("InputController")
        if not okIc then return false, ic end
        spawn("Actions/toss", function(job)
            if not job.alive then return end
            performToss(ic)
        end)
        return true
    end

    -- the game serves on the second Toss press: press once to raise the ball, wait past the toss debounce (and, if asked, for the power bar), then press again to fire GameService:Serve through executeToss
    local function serve(power)
        if power ~= nil and type(power) ~= "number" then return false, Errors.BAD_ARGS end
        local okIc, ic = controller("InputController")
        if not okIc then return false, ic end
        spawn("Actions/serve", function(job)
            if not job.alive then return end
            performToss(ic)
            if not job:sleep(SERVE_DEBOUNCE) then return end
            if power then
                local okGc, gc = controller("GameController")
