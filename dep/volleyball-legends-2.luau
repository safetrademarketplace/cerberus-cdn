-- landing: where a hit lands in closed form (no drag, constant gravity, sim speeds with sim gravity so the time scale cancels out of the spot), the other team's half as the game's in-court test sees it (Physics.lua:190-209), the aim spots in that half, and the reachable landing nearest a spot from a sweep of directions and carries; pure maths, no game reads

local STEP_DEG = 3
-- carries tried between the shortest and longest a move can reach
local RINGS = 8
-- every planned landing (a spot, a scattered spot, or the nearest reachable one) keeps its centre at least this far inside the lines;
-- the game calls a ball in up to its radius outside them (Physics.lua:190-209), so a hit has EDGE + radius (~3.3 studs) to miss by,
-- above the worst live miss measured (3.0); spots in the corners sit right on it
local EDGE = 2
-- and this far past the net
local NET_EDGE = 2
local INSET = EDGE
-- a long hit misses by more (a few tenths of a degree is studs at 70+: hand spikes over 66-75 studs landed 4-7 off, and a back-leaned
-- spike from 34-41 back lands 54-66 past the net), so past LONG_FROM studs a landing keeps LONG_EDGE further inside the lines per stud
local LONG_FROM = 30
local LONG_EDGE = 0.05
local LONG_EDGE_MAX = 4
-- a straight over hit lands this share of their half's depth past the net (where a full straight bump lands anyway)
local STRAIGHT_SHARE = 0.75
-- a short drop lands this far past the net
local SHORT_DEPTH = 6
-- of a grid this size over their half, open spot takes the point farthest from every opponent; odd, so it has a centre
local GRID = 7
local EPS = 1e-6
-- a receiver reacts this late, then runs at walk speed, and plays a ball this far from where they stand (a bump's box and the ball)
local RECEIVER_REACT = 0.25
local RECEIVER_SPEED = 23
local RECEIVER_REACH = 5

local M = {}

-- time until a ball leaving `drop` studs above the landing plane at vertical speed v comes down onto it (Safety.lua:23-41); nil when it never does
function M.flightTime(v, g, drop)
    if g <= 0 then return nil end
    local disc = v * v + 2 * g * drop
    if disc < 0 then return nil end
    local t = (v + math.sqrt(disc)) / g
    if t > 0 then return t end
    return nil
end

-- the court-lines box and the net, as plain numbers; s is +1 when their half lies at z above the net (the radius is the game's own
-- allowance past the lines, which plans never lean on)
function M.half(center, size, netZ, s, radius)
    return {
        cx = center.X, cz = center.Z, ex = size.X / 2, ez = size.Z / 2,
        grow = -EDGE, edge = EDGE, radius = radius, netZ = netZ, s = s,
    }
end

-- how far inside the lines a hit carrying `dist` studs keeps its landing
function M.edgeFor(dist)
    return EDGE + math.min(LONG_EDGE * math.max(dist - LONG_FROM, 0), LONG_EDGE_MAX)
end

-- the same half with its lines kept `edge` studs in (the net side keeps its own margin)
function M.widen(half, edge)
    local out = {}
    for k, v in pairs(half) do out[k] = v end
    out.grow, out.edge = -edge, edge
    return out
end

-- how deep their half runs from the net to its back line
function M.depth(half)
    return math.max((half.cz + half.s * half.ez - half.netZ) * half.s, 0)
end

-- above 0: how far a spot is out of their half (margin kept); 0 or below: in, and its negative is how deep
function M.outside(half, x, z)
    local dx = math.abs(x - half.cx) - half.ex
    local dz = math.abs(z - half.cz) - half.ez
    local ox, oz = math.max(dx, 0), math.max(dz, 0)
    -- signed distance to the lines box, kept EDGE inside them
    local lines = math.sqrt(ox * ox + oz * oz) + math.min(math.max(dx, dz), 0) - half.grow
