-- filesystem helpers centralising the pcall + warn pattern so call sites don't silently swallow disk failures
local Log = require("Utility/Log")

local M = {}

-- returns (ok, err); warns exactly once per site whether writefile is missing or the write fails
function M.safeWrite(path, body, moduleName)
