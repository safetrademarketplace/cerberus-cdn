-- how far the nearest receiver still falls short of a ball landing at (x, z) after t seconds in the air; the higher, the harder to return
function M.shortfall(x, z, receivers, t)
    local reach = RECEIVER_SPEED * math.max(t - RECEIVER_REACT, 0) + RECEIVER_REACH
    return math.sqrt(nearestSq(x, z, receivers)) - reach
end

-- where a receiver stands when nobody is on their side: the middle of their half
function M.receiverSpot(half)
    local back = half.cz + half.s * half.ez
    return Vector3.new(half.cx, 0, (half.netZ + back) / 2)
end

-- points `step` apart across their inset half, from the net row to the back line, as { x, z }
function M.grid(half, step)
    local minX, maxX, near, back = inset(half)
    local nx = math.max(1, math.floor(math.abs(maxX - minX) / step + 0.5))
    local nz = math.max(1, math.floor(math.abs(back - near) / step + 0.5))
    local out = {}
    for i = 0, nz do
        local z = near + (back - near) * i / nz
        for j = 0, nx do out[#out + 1] = { x = minX + (maxX - minX) * j / nx, z = z } end
