        })
        Round(dlBtn, 6)

        -- report button opens the report modal seeded with this row's item
        local reportBtn = New("TextButton", {
            Name                   = "Report",
            AnchorPoint            = Vector2.new(1, 1),
            Position               = UDim2.new(1, 0, 1, 0),
            Size                   = UDim2.fromOffset(110, 18),
