__bundle_register("Utility/Identity", function(require, _LOADED, __bundle_register, __bundle_modules)
-- thread identity: restores the executor thread to an identity that may create and touch gui instances, because a game-api call or a yield silently drops it mid-build

-- 8 is the level at which Instance.new and gui property writes are permitted; below it they throw
-- "lacking capability Plugin"
local TARGET = 8

local setter = setthreadidentity or set_thread_identity or setidentity
    or (syn and syn.set_thread_identity)
local getter = getthreadidentity or get_thread_identity or getidentity
    or (syn and syn.get_thread_identity)

local M = {}

M.supported = type(setter) == "function"

function M.current()
    if type(getter) ~= "function" then return nil end
    local ok, value = pcall(getter)
    return ok and value or nil
end

-- always sets, never trusts a read: the getter can report the target while the thread has already lost the
-- capability, and skipping the write on that reading is what leaves a groupbox unable to build
function M.elevate()
    if not M.supported then return false end
    return (pcall(setter, TARGET))
end

-- 2 is a game LocalScript's own level. game code called from our thread runs its own require() of game
-- modules, and roblox refuses that above this level ("Cannot require a non-RobloxScript module from a
-- RobloxScript"), so calls into game controllers run here; threads the call spawns (promise chains) keep it
local GAME = 2

-- pcalls fn at the game's identity, then puts the thread back (at TARGET when the old level can't be read); returns pcall's results
function M.asGame(fn, ...)
    if not M.supported then return pcall(fn, ...) end
    local before = M.current()
    pcall(setter, GAME)
    local result = table.pack(pcall(fn, ...))
    pcall(setter, before or TARGET)
    return table.unpack(result, 1, result.n)
end

return M

end)
