            enabledConn = root:GetPropertyChangedSignal("Enabled"):Connect(function()
                if root.Enabled then schedule() end
            end)
        end)
    end
    local win = root:FindFirstChild(WINDOW)
    if win then watchWindow(win) end
end

function observe()
    if coreConn then return end
    coreConn = CoreGui.ChildAdded:Connect(function(child)
        if child.Name == "DevConsoleMaster" then
            watch(child)
            schedule()
        end
    end)
end

function resolve(job)
    observe()
    local root = CoreGui:FindFirstChild("DevConsoleMaster")
        or CoreGui:WaitForChild("DevConsoleMaster", BIND_TIMEOUT)
    if not (root and job.alive) then return end
    watch(root)

    -- the console rebuilds over several frames, so hold the pass until every bind has survived a few in a row
    local deadline, settled = os.clock() + BIND_TIMEOUT, 0
    repeat
        settled = bindPass(root) == 0 and settled + 1 or 0
        if settled >= SETTLE_PASSES then return end
        if not job:sleep() then return end
    until os.clock() >= deadline
end

-- one resolver job ever walks the console; anything asking while it runs only re-arms the flag
function schedule()
    requested = true
    if resolver then return end
    resolver = Jobs.spawn(function(job)
        while requested and job.alive do
            requested = false
            resolve(job)
        end
        resolver = nil
    end, { name = "LiveConsole" })
end

local function flush(entry)
    if not write(entry) then schedule() end
end

-- printing the real text is what makes a reopen safe: a bind that never lands costs the color, never the line
local function emit(entry)
    entry.seed = entry.text ~= "" and entry.text or " "
    history[#history + 1] = entry
    if #history > HISTORY_MAX then table.remove(history, 1) end
    print(entry.seed) -- log:allow — the located line is the console handle we recolor
    schedule()
    return entry
end

-- single reusable progress line, buffered so an update issued before the console opens still shows
function M.step(text, ratio, color)
    local pct = math.clamp(math.floor((ratio or 0) * 100 + 0.5), 0, 100)
    local rendered = ("%s %3d%%  %s"):format(M.progressBar(pct), pct, tostring(text))
    if not stepEntry then
        stepEntry = emit({ text = rendered, color = resolveColor(color) })
        return
    end
    stepEntry.text, stepEntry.color = rendered, resolveColor(color)
    flush(stepEntry)
end

-- discrete one-off colored line (webhook syncs, notices); each gets its own line
function M.log(text, color)
    emit({ text = tostring(text), color = resolveColor(color) })
end

-- drops the console watchers so a relaunched session's history is the only one being rebound
function M.stop()
    if masterConn then masterConn:Disconnect() end
    if enabledConn then enabledConn:Disconnect() end
    if windowConn then windowConn:Disconnect() end
    if coreConn then coreConn:Disconnect() end
    if resolver then resolver:Cancel() end
    masterConn, enabledConn, windowConn, coreConn = nil, nil, nil, nil
    master, window, resolver = nil, nil, nil
    requested = false
    table.clear(history)
    stepEntry = nil
end

return M

