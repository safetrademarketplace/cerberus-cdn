            desc = desc .. string.format(
                "\n\n**Player:** `%s`\n**Game:** `%s`",
                tostring(playerName),
                tostring(gameName)
            )
        end

        local payload = {
            username = nickname or "Cerberus Macro Logger",
            avatar_url = ICON_URL,
            embeds = { {
                title = tostring(title or "Cerberus Event"),
                description = desc,
                color = EMBED_COLOR,
            } },
        }

        local ok
        if Http.client() then
            -- through Http.postJson so discord's per-host pacing and 429 backoff apply here too
            ok = Http.postJson(webhookUrl, payload) ~= nil
