                else
                    setStatus(string.format(
                        isUpdate and tr("Update failed: %s") or tr("Upload failed: %s"),
                        tostring(err)), true)
                end
                submitBtn.Text = isUpdate and tr("Update") or tr("Submit")
                return
            end
            local statusText = isUpdate
                and tr("Updated %q — visible to others now.")
                or tr("Uploaded %q — visible to others now.")
            local notifyText = isUpdate
                and tr("Updated %q in the community catalog")
                or tr("Uploaded %q in the community catalog")
            setStatus(string.format(statusText, submittedName), false)
            UiWrite.notify(Library, string.format(notifyText, submittedName), 4)
