        bindAction(
            inputBindNames.KB,
            keyMapHandler(keyboard, digitalKeyValue),
            Enum.KeyCode.W, Enum.KeyCode.U,
            Enum.KeyCode.A, Enum.KeyCode.H,
            Enum.KeyCode.S, Enum.KeyCode.J,
            Enum.KeyCode.D, Enum.KeyCode.K,
            Enum.KeyCode.E, Enum.KeyCode.I,
            Enum.KeyCode.Q, Enum.KeyCode.Y,
            Enum.KeyCode.Up, Enum.KeyCode.Down
        )

        bindAction(inputBindNames.MousePan, function(_, input)
            local d = input.Delta
            mouse.Delta = Vector2.new(-d.Y, -d.X)
        end, Enum.UserInputType.MouseMovement)

        bindAction(inputBindNames.Wheel, function(_, input)
            mouse.MouseWheel = -input.Position.Z
        end, Enum.UserInputType.MouseWheel)

        bindAction(inputBindNames.TouchPan, function(state, input)
            if state == Enum.UserInputState.Begin then
                touch.ActiveTouches[input] = true
            elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
                touch.ActiveTouches[input] = nil
            elseif state == Enum.UserInputState.Change then
                local touchCount = 0
                for _ in pairs(touch.ActiveTouches) do
                    touchCount = touchCount + 1
                end

                local d = input.Delta
                if touchCount == 1 then
                    touch.PanDelta = touch.PanDelta + Vector2.new(-d.Y, -d.X)
                elseif touchCount >= 2 then
                    touch.VerticalPanDelta = touch.VerticalPanDelta + d
                end
            end
        end, Enum.UserInputType.Touch)

        if Services.UserInputService and Services.UserInputService.TouchPinch then
            touchPinchConn = Services.UserInputService.TouchPinch:Connect(function(_, scale, _, state)
                if state == Enum.UserInputState.Change then
                    touch.PinchDelta = scale
                end
            end)
        end

        bindAction(
            inputBindNames.GPBtn,
            keyMapHandler(gamepad, digitalKeyValue),
            Enum.KeyCode.ButtonX,
            Enum.KeyCode.ButtonY
        )

        bindAction(
            inputBindNames.GPTrig,
            keyMapHandler(gamepad, function(_, input) return input.Position.Z end),
            Enum.KeyCode.ButtonR2,
            Enum.KeyCode.ButtonL2
        )

        bindAction(
            inputBindNames.GPThumb,
            keyMapHandler(gamepad, function(_, input) return input.Position end),
            Enum.KeyCode.Thumbstick1,
            Enum.KeyCode.Thumbstick2
        )
    end

    local function pushGuiState()
        if not isCinematic() then
            return
        end

        local playerGui = References.player and References.player:FindFirstChildOfClass("PlayerGui")
        hudCache.screens = {}

        if not playerGui then
            return
        end

        for _, gui in ipairs(playerGui:GetChildren()) do
            if gui:IsA("ScreenGui")
                and gui.Enabled
                and gui.Name ~= "TouchGui"
                and gui.Name ~= "DynamicThumbstick" then
                table.insert(hudCache.screens, gui)
                gui.Enabled = false
            end
        end
    end

    local function popGuiState()
        if hudCache.screens then
            for _, gui in ipairs(hudCache.screens) do
                if gui and gui.Parent then
                    gui.Enabled = true
                end
            end
        end

        hudCache = {}
    end

    local function disableJumpForHumanoid(humanoid)
        if not humanoid then
            return
        end

        humRef = humanoid

        if humRef.SetStateEnabled then
            humJumpState = humRef:GetStateEnabled(Enum.HumanoidStateType.Jumping)
            humRef:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
        end

        if jumpConn then
            jumpConn:Disconnect()
            jumpConn = nil
        end

        if Services.UserInputService and Services.UserInputService.JumpRequest then
            jumpConn = Services.UserInputService.JumpRequest:Connect(function()
                if humRef then
                    humRef.Jump = false
                end
            end)
        end
    end

    local function restoreJump()
        if jumpConn then
            jumpConn:Disconnect()
            jumpConn = nil
        end

        if humRef and humRef.SetStateEnabled then
            humRef:SetStateEnabled(Enum.HumanoidStateType.Jumping, humJumpState ~= false)
        end

        humRef = nil
        humJumpState = nil
    end

    local function forceDisableFromDamage()
        if not freecamOn then
            return
        end

        if restoringToggle then
            return
        end

        restoringToggle = true
        UiWrite.notify(Library, "Freecam disabled: damage taken.", 2)
        UiWrite.value(Toggles.FreecamEnabled, false)
        restoringToggle = false
    end

    local function bindDamageWatcher(humanoid)
        if healthConn then
            healthConn:Disconnect()
            healthConn = nil
        end

        lastHealth = nil

        if not humanoid then
            return
        end

        lastHealth = humanoid.Health

        healthConn = humanoid.HealthChanged:Connect(function(newHealth)
            if freecamOn and lastHealth and newHealth < lastHealth - 0.001 then
                forceDisableFromDamage()
            end
            lastHealth = newHealth
        end)
    end

    local function handleCharacterAdded(character)
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not humanoid then
            humanoid = References.humanoid
        end

        bindDamageWatcher(humanoid)

        if freecamOn then
            disableJumpForHumanoid(humanoid)
        end
    end

    local function bindCharacterWatcher()
        if characterAddedConn then
            characterAddedConn:Disconnect()
            characterAddedConn = nil
        end

        if References.player then
            characterAddedConn = References.player.CharacterAdded:Connect(function(character)
                handleCharacterAdded(character)
            end)
        end

        handleCharacterAdded(References.character)
    end

    local function velInput(dt, sens)
        navSpeed = clamp(navSpeed + dt * (keyboard.Up - keyboard.Down) * 0.75, 0.01, 4)

        local gamepadVec = Vector3.new(
            thumbstickCurve(gamepad.Thumbstick1.X),
            thumbstickCurve(gamepad.ButtonR2) - thumbstickCurve(gamepad.ButtonL2),
            thumbstickCurve(-gamepad.Thumbstick1.Y)
        )

        local keyboardVec = Vector3.new(
            keyboard.D - keyboard.A + keyboard.K - keyboard.H,
            keyboard.E - keyboard.Q + keyboard.I - keyboard.Y - (touch.VerticalPanDelta.Y * 0.1),
            keyboard.S - keyboard.W + keyboard.J - keyboard.U
        )

        touch.VerticalPanDelta = Vector2.zero

        local shiftHeld =
            Services.UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
            or Services.UserInputService:IsKeyDown(Enum.KeyCode.RightShift)

        local speedMultiplier = 64 * navSpeed * (shiftHeld and 0.25 or 1) * sens

        return (gamepadVec + keyboardVec) * speedMultiplier
    end

    local function panInput(sens)
        local gp = Vector2.new(
            thumbstickCurve(gamepad.Thumbstick2.Y),
            thumbstickCurve(-gamepad.Thumbstick2.X)
        ) * (pi / 8)

        local km = (mouse.Delta + touch.PanDelta) * (pi / 64)

        mouse.Delta = Vector2.zero
        touch.PanDelta = Vector2.zero

        return (gp + km) * (8 * sens)
    end

    local function fovInput()
        local gp = (gamepad.ButtonX - gamepad.ButtonY) * 0.25
        local mw = mouse.MouseWheel
        local pinch = (touch.PinchDelta - 1.0) * -5.0

        mouse.MouseWheel = 0
        touch.PinchDelta = 1.0

        return gp + mw + pinch
    end

    local function stepCinematic(dt)
        local sens = (Options.FreecamSensitivity and Options.FreecamSensitivity.Value) or 1

        local vel = velSpring:Update(dt, velInput(dt, sens))
        local pan = panSpring:Update(dt, panInput(sens))
        local fov = fovSpring:Update(dt, fovInput())

        local zoomFactor = sqrt(tan(rad(70 / 2)) / tan(rad(cameraFov / 2)))
        cameraFov = clamp(cameraFov + fov * 300 * (dt / zoomFactor), 1, 120)
        cameraRot = cameraRot + pan * (dt / zoomFactor)
        cameraRot = Vector2.new(clamp(cameraRot.X, -PITCH_LIMIT, PITCH_LIMIT), cameraRot.Y % (2 * pi))

        local cf = CFrame.new(cameraPos)
            * CFrame.fromOrientation(cameraRot.X, cameraRot.Y, 0)
            * CFrame.new(vel * dt)

        cameraPos = cf.Position

        Camera.CFrame = cf
        Camera.Focus = cf
        Camera.FieldOfView = cameraFov
    end

    local function stepFunctional(dt)
        local sens = (Options.FreecamSensitivity and Options.FreecamSensitivity.Value) or 1

        local vel = velInput(dt, sens)
        local pan = panInput(sens)
        local fov = fovInput()

        cameraFov = clamp(cameraFov + (fov * 8), 1, 120)
        cameraRot = cameraRot + pan * dt
        cameraRot = Vector2.new(clamp(cameraRot.X, -PITCH_LIMIT, PITCH_LIMIT), cameraRot.Y % (2 * pi))

        local cf = CFrame.new(cameraPos)
            * CFrame.fromOrientation(cameraRot.X, cameraRot.Y, 0)
            * CFrame.new(vel * dt)

        cameraPos = cf.Position

        Camera.CFrame = cf
        Camera.Focus = cf
        Camera.FieldOfView = cameraFov
    end

    local function assertFreecamState()
        if not Camera then return end
        -- PlayerScripts CameraModule/MouseLockController revert these, so re-assert every frame
        if Camera.CameraType ~= Enum.CameraType.Scriptable then
            Camera.CameraType = Enum.CameraType.Scriptable
        end
        if Camera.CameraSubject ~= nil then
            Camera.CameraSubject = nil
        end
        pcall(function()
            if Services.UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
                Services.UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
            end
            if Services.UserInputService.MouseIconEnabled then
                Services.UserInputService.MouseIconEnabled = false
            end
        end)
    end

    local stepFreecam = function(dt)
        if not freecamOn or not Camera then
            return
        end

        assertFreecamState()

        if getFreecamMode() == "Functional" then
            stepFunctional(dt)
        else
            stepCinematic(dt)
        end
    end

    local function saveState()
        savedState.CameraType = Camera.CameraType
        savedState.CameraSubject = Camera.CameraSubject
        savedState.FieldOfView = Camera.FieldOfView
        savedState.MouseBehavior = Services.UserInputService.MouseBehavior
        savedState.MouseIconEnabled = Services.UserInputService.MouseIconEnabled
    end

    local function restoreState()
        if Camera then
            -- subject first so CameraModule has a valid target the moment it reactivates on the Scriptable→Custom flip
            Camera.CameraSubject = References.humanoid or savedState.CameraSubject
            Camera.CameraType = Enum.CameraType.Custom
            Camera.FieldOfView = savedState.FieldOfView or 70
        end

        -- force the mouse back unconditionally (savedState may say hidden if shift-lock hid it first) and repeat across frames to outrun CameraModule re-asserting its own mouse state
        local function forceMouseBack()
            pcall(function()
                Services.UserInputService.MouseBehavior = Enum.MouseBehavior.Default
                Services.UserInputService.MouseIconEnabled = true
            end)
        end
        forceMouseBack()
        task.defer(forceMouseBack)
        -- leak:allow — completes a teardown; cancelling it at unload would leave mouse behaviour freecam's
        task.delay(0.1, forceMouseBack)
        -- leak:allow — as above; the second pass catches a late camera-script rewrite
        task.delay(0.3, forceMouseBack)

        savedState.CameraType, savedState.CameraSubject = nil, nil
        savedState.FieldOfView = nil
        savedState.MouseBehavior, savedState.MouseIconEnabled = nil, nil
    end

    local function StartFreecam()
        -- re-resolve in case CurrentCamera flipped before our listener fired and the upvalue is a destroyed camera
        Camera = Services.Workspace.CurrentCamera
        if freecamOn or not Camera then
            return
        end

        saveState()

        -- snapshot pose before switching CameraType (Scriptable stops CFrame updates); roll is dropped so cameraRot stays pitch/yaw
        local cf = Camera.CFrame
        local pitch, yaw = cf:ToOrientation()
        cameraRot = Vector2.new(clamp(pitch, -PITCH_LIMIT, PITCH_LIMIT), yaw)
        cameraPos = cf.Position
        cameraFov = Camera.FieldOfView

        velSpring:Reset(Vector3.zero)
        panSpring:Reset(Vector2.zero)
        fovSpring:Reset(0)

        pushGuiState()
        disableJumpForHumanoid(References.humanoid)

        -- clear the follow target before flipping CameraType so PlayerScripts doesn't re-attach to the humanoid
        Camera.CameraSubject = nil
        Camera.CameraType = Enum.CameraType.Scriptable
        pcall(function()
            Services.UserInputService.MouseIconEnabled = false
            Services.UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
        end)

        bindInputs()
        -- scheduler:allow — must run at RenderPriority.Camera + 1, i.e. after roblox's own camera step; a render-lane task has no such ordering
        Services.RunService:BindToRenderStep(
            FREECAM_RENDERSTEP,
            Enum.RenderPriority.Camera.Value + 1,
            stepFreecam
        )

        freecamOn = true
    end

    local function StopFreecam()
        if not freecamOn then
            return
        end

        freecamOn = false

        -- re-resolve so restoreState writes to whichever camera is live now
        Camera = Services.Workspace.CurrentCamera

        Services.RunService:UnbindFromRenderStep(FREECAM_RENDERSTEP)
        unbindInputs()
        restoreJump()
        restoreState()
        popGuiState()
    end

    bindCharacterWatcher()

    Toggles.FreecamEnabled:OnChanged(function()
        if Toggles.FreecamEnabled.Value then
            StartFreecam()
            if freecamOn then
                Library:Notify(("Freecam enabled (%s)."):format(getFreecamMode()), 2)
            end
        else
            StopFreecam()
            if not restoringToggle then
                Library:Notify("Freecam disabled.", 2)
            end
        end
    end)

    return {
        cleanup = function()
            if healthConn then
                healthConn:Disconnect()
                healthConn = nil
            end

            if characterAddedConn then
                characterAddedConn:Disconnect()
                characterAddedConn = nil
            end

            StopFreecam()
        end
    }
end

end)
__bundle_register("Features/Visuals/Visuals/FOV", function(require, _LOADED, __bundle_register, __bundle_modules)
-- camera fov sub-module of visuals: opt-in custom fov that never touches the camera while off, holds its value while on, and hands back the fov the game last set (it changes its own: 110 on team select, 30 in tutorial dialogue)
return function(ctx)
    local Services     = ctx.Services
    local Options      = ctx.Options
    local Toggles      = ctx.Toggles
    local VisualsGroup = ctx.VisualsGroup
    local track        = ctx.track

    VisualsGroup:AddToggle("CameraFOV_Enable", { Text = "Custom FOV", Default = false })
    local box = VisualsGroup:AddDependencyBox()
    box:AddSlider("CameraFOV", {
        Text = "Camera FOV",
        Default = 70,
        Min = 40,
        Max = 120,
        Rounding = 0,
    })
    box:SetupDependencies({ { Toggles.CameraFOV_Enable, true } })

    local on = false
    local writing = false
    -- the fov the game last asked for, so turning this off hands back the right one, never a value from load time
    local gameFov
    local watch

    local function camera()
        return Services.Workspace.CurrentCamera
    end

    local function write(cam, value)
        writing = true
        pcall(function() cam.FieldOfView = value end)
        writing = false
    end

    local function unwatch()
        if watch then pcall(function() watch:Disconnect() end) end
        watch = nil
    end

    local function apply()
        local cam = camera()
        if not cam then return end
        if cam.FieldOfView ~= Options.CameraFOV.Value then write(cam, Options.CameraFOV.Value) end
    end

    local function start()
        if on then return end
        local cam = camera()
        if not cam then return end
        on = true
        gameFov = cam.FieldOfView
        -- the game re-sets its fov on its own screens; remember what it wanted, then keep ours
        watch = track(cam:GetPropertyChangedSignal("FieldOfView"):Connect(function()
            if writing or not on then return end
            -- zoom owns the fov while it runs, and our own value coming back (zoom handing it back) is not the game's
            if Toggles.ZOOM_Enable and Toggles.ZOOM_Enable.Value then return end
            if cam.FieldOfView == Options.CameraFOV.Value then return end
            gameFov = cam.FieldOfView
            apply()
        end))
        apply()
    end

    local function stop()
        if not on then return end
        on = false
        unwatch()
        local cam = camera()
        if cam and gameFov then write(cam, gameFov) end
        gameFov = nil
    end

    Toggles.CameraFOV_Enable:OnChanged(function()
        if Toggles.CameraFOV_Enable.Value then start() else stop() end
    end)
    Options.CameraFOV:OnChanged(function()
        if on then apply() end
    end)

    return { cleanup = stop }
end

end)
__bundle_register("Features/Visuals/Visuals/Fullbright", function(require, _LOADED, __bundle_register, __bundle_modules)
-- fullbright sub-module of visuals (passive/aggressive lighting override)
local Scheduler = require("Utility/Scheduler")

return function(ctx)
    local Services     = ctx.Services
    local Options      = ctx.Options
    local Toggles      = ctx.Toggles
    local track        = ctx.track
    local VisualsGroup = ctx.VisualsGroup

    VisualsGroup:AddToggle("Fullbright", {
        Text = "Fullbright",
        Default = false
    })

    local FullbrightBox = VisualsGroup:AddDependencyBox()

    FullbrightBox:AddDropdown("Fullbright_Mode", {
        Text = "Lighting Mode",
        Default = 2,
        Values = {"Passive", "Aggressive"},
        Tooltip = "Passive keeps shadows, Aggressive removes them"
    })

    FullbrightBox:AddSlider("Fullbright_Brightness", {
        Text = "Brightness",
        Default = 1,
        Min = 0.01,
        Max = 5,
        Rounding = 3
    })

    FullbrightBox:SetupDependencies({
        { Toggles.Fullbright, true },
    })

    local currentBrightness = Options.Fullbright_Brightness.Value

    local fbConn, fbSaved

    local COLOR_AGGRESSIVE = Color3.new(1, 1, 1)
    local COLOR_PASSIVE    = Color3.fromRGB(150, 150, 150)

    local function fbOn()
        if fbConn then return end

        local lighting = Services.Lighting

        fbSaved = fbSaved or {
            B = lighting.Brightness,
            GS = lighting.GlobalShadows,
            A = lighting.Ambient,
            OA = lighting.OutdoorAmbient
        }

        fbConn = track(Scheduler.render(function()
            local mode = Options.Fullbright_Mode and Options.Fullbright_Mode.Value or "Aggressive"

            local targetShadows = (mode == "Passive")
            local targetColor   = (mode == "Passive") and COLOR_PASSIVE or COLOR_AGGRESSIVE

            -- only write properties that differ — this runs every frame
            if lighting.Brightness ~= currentBrightness then
                lighting.Brightness = currentBrightness
            end
            if lighting.GlobalShadows ~= targetShadows then
                lighting.GlobalShadows = targetShadows
            end
            if lighting.Ambient ~= targetColor then
                lighting.Ambient = targetColor
            end
            if lighting.OutdoorAmbient ~= targetColor then
                lighting.OutdoorAmbient = targetColor
            end
        end, { name = "Fullbright" }))
    end

    local function fbOff()
        if fbConn then
            fbConn:Disconnect()
            fbConn = nil
        end
        if fbSaved then
            local lighting = Services.Lighting
            lighting.Brightness = fbSaved.B
            lighting.GlobalShadows = fbSaved.GS
            lighting.Ambient = fbSaved.A
            lighting.OutdoorAmbient = fbSaved.OA
            fbSaved = nil
        end
    end

    if Toggles.Fullbright then
        Toggles.Fullbright:OnChanged(function()
            if Toggles.Fullbright.Value then fbOn() else fbOff() end
        end)
    end

    if Options.Fullbright_Brightness then
        Options.Fullbright_Brightness:OnChanged(function()
            currentBrightness = Options.Fullbright_Brightness.Value
        end)
    end

    return { cleanup = fbOff }
end

end)
__bundle_register("Features/Visuals/Visuals/NoFog", function(require, _LOADED, __bundle_register, __bundle_modules)
-- no-fog sub-module of visuals: kills fog/atmosphere/clouds/post-fx and reapplies on property changes so per-frame lighting rewrites can't undo it
return function(ctx)
    local Services     = ctx.Services
    local Toggles      = ctx.Toggles
    local VisualsGroup = ctx.VisualsGroup

    VisualsGroup:AddToggle("NoFog", {
        Text = "No Fog",
        Default = false,
        Tooltip = "Removes fog, clouds and post-processing",
    })

    local saved, conns, applying = nil, {}, false

    local function pushConn(c) conns[#conns + 1] = c; return c end

    local function clearConns()
        for i = 1, #conns do
            pcall(function() conns[i]:Disconnect() end)
        end
        conns = {}
    end

    local function applyFogProps()
        applying = true
        Services.Lighting.FogEnd = 1e10
        Services.Lighting.FogStart = 1e10
        applying = false
    end

    local function suppressAtmosphere(inst)
        if not saved then return end
        if not saved.Atmo[inst] then
            saved.Atmo[inst] = { D = inst.Density, H = inst.Haze, G = inst.Glare }
        end
        inst.Density, inst.Haze, inst.Glare = 0, 0, 0
    end

    local function suppressClouds(inst)
        if not saved then return end
        if not saved.Clouds[inst] then
            saved.Clouds[inst] = { Cover = inst.Cover, Density = inst.Density }
        end
        inst.Cover, inst.Density = 0, 0
    end

    local function suppressPostEffect(inst)
        if inst:IsA("BloomEffect") or inst:IsA("SunRaysEffect")
            or inst:IsA("DepthOfFieldEffect") or inst:IsA("ColorCorrectionEffect")
            or inst:IsA("BlurEffect") then
            if inst.Enabled then
                inst:SetAttribute("NFWasEnabled", true)
                inst.Enabled = false
            end
            return true
        end
        return false
    end

    local function handleLightingDescendant(inst)
        if suppressPostEffect(inst) then return end
        if inst:IsA("Atmosphere") then
            suppressAtmosphere(inst)
            pushConn(inst:GetPropertyChangedSignal("Density"):Connect(function()
                if saved and inst.Density > 0 then suppressAtmosphere(inst) end
            end))
            pushConn(inst:GetPropertyChangedSignal("Haze"):Connect(function()
                if saved and inst.Haze > 0 then suppressAtmosphere(inst) end
            end))
        end
    end

    local function nfOn()
        if saved then return end
        saved = {
            FogEnd   = Services.Lighting.FogEnd,
            FogStart = Services.Lighting.FogStart,
            FogColor = Services.Lighting.FogColor,
            Atmo     = {},
            Clouds   = {},
        }

        applyFogProps()
        for _, d in ipairs(Services.Lighting:GetDescendants()) do
            handleLightingDescendant(d)
        end

        pushConn(Services.Lighting:GetPropertyChangedSignal("FogEnd"):Connect(function()
            if saved and not applying and Services.Lighting.FogEnd < 1e9 then applyFogProps() end
        end))
        pushConn(Services.Lighting:GetPropertyChangedSignal("FogStart"):Connect(function()
            if saved and not applying and Services.Lighting.FogStart < 1e9 then applyFogProps() end
        end))
        pushConn(Services.Lighting.DescendantAdded:Connect(handleLightingDescendant))

        local terrain = Services.Workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            for _, c in ipairs(terrain:GetChildren()) do
                if c:IsA("Clouds") then suppressClouds(c) end
            end
            pushConn(terrain.ChildAdded:Connect(function(c)
                if c:IsA("Clouds") then suppressClouds(c) end
            end))
        end
    end

    local function nfOff()
        if not saved then return end
        clearConns()
        applying = true
        Services.Lighting.FogEnd   = saved.FogEnd
        Services.Lighting.FogStart = saved.FogStart
        Services.Lighting.FogColor = saved.FogColor
        applying = false
        for _, d in ipairs(Services.Lighting:GetDescendants()) do
            if d:GetAttribute("NFWasEnabled") then
                d:SetAttribute("NFWasEnabled", nil)
                if d.Enabled ~= nil then d.Enabled = true end
            end
        end
        for inst, v in pairs(saved.Atmo) do
            if inst and inst.Parent then
                pcall(function() inst.Density, inst.Haze, inst.Glare = v.D, v.H, v.G end)
            end
        end
        for inst, v in pairs(saved.Clouds) do
            if inst and inst.Parent then
                pcall(function() inst.Cover, inst.Density = v.Cover, v.Density end)
            end
        end
        saved = nil
    end

    Toggles.NoFog:OnChanged(function()
        if Toggles.NoFog.Value then nfOn() else nfOff() end
    end)

    return { cleanup = nfOff }
end

end)
