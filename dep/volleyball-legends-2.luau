    local Options = deps.Options
    local Toggles = deps.Toggles
    local Engine  = deps.Engine

    if not (Tabs and Tabs.ESP and Engine) then return end

    -- a toggle with an attached color picker; pickers fire Callback, not :OnChanged
    local function coloredToggle(container, id, text, dflt, toggleApply, colorId, colorDflt, title, colorApply)
        local t = container:AddToggle(id, { Text = text, Default = dflt, Callback = toggleApply })
        t:AddColorPicker(colorId, { Default = colorDflt, Title = title,
            Callback = function() colorApply(Options[colorId].Value) end })
        return t
    end

