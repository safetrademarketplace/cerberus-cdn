        local content = New("Frame", {
            Name             = "Content",
            Position         = UDim2.fromOffset(0, 96),
            Size             = UDim2.new(1, 0, 1, -96),
            BackgroundTransparency = 1,
            BorderSizePixel  = 0,
            Parent           = panel,
