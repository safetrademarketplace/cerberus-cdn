local SIM_HORIZON  = 4 -- real seconds of bounce-aware flight; past it the last arc runs free
local SIM_STEP     = 1 / 30 -- one spherecast per step, so at most 120 per simulation
local MAX_BOUNCES  = 4
local RESIM_AGE    = 0.1 -- a cached simulation serves every reader until it is this old,
local RESIM_DRIFT  = 1 -- or the live ball is this many studs off it (a new packet or a hit)
local SIM_STALE    = 1 -- another ball's simulations are dropped once this old
local MAX_VARIANTS = 4 -- option sets (fitted or extra accel, velocity override) cached side by side per ball

local FLOOR_NORMAL_Y = 0.7
local FLOOR_RISE     = 0.5
local FLOOR_TOP_SLOP = 0.05
local DEFAULT_BOUNCINESS = 0.9 -- Configuration.Game.Physics.lua:4-5
local DEFAULT_FRICTION   = 0.7

