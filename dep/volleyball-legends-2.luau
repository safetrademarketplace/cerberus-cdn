__bundle_register("Api", function(require, _LOADED, __bundle_register, __bundle_modules)
-- api framework + boot orchestrator: scoped logger, safe-call helpers, shared signal, unload-wired maid per api; Api.build instantiates the manifest into ctx.Api

local Log = require("Utility/Log")

-- requires must be string literals for the static bundler, and deferred in loaders so Api/<Name> can require this module back without a circular-load deadlock
local LOADERS = {
    -- the knit transport first: every game api below reaches the game through it
    { name = "Net",     load = function() return require("Api/Net") end },
    -- game apis, all reading ctx.Api.Net: match state/world, the ball, the move driver, the account
    { name = "Match",   load = function() return require("Api/Match") end },
    { name = "Ball",    load = function() return require("Api/Ball") end },
    { name = "Actions", load = function() return require("Api/Actions") end },
    { name = "Profile", load = function() return require("Api/Profile") end },
    { name = "Esp",     load = function() return require("Api/Esp") end },
    { name = "Webhook", load = function() return require("Api/Webhook") end },
    { name = "KeyCheck", load = function() return require("Api/KeyCheck") end },
    { name = "Link",    load = function() return require("Api/Link") end },
}

local Api = {}

-- Fire pcalls every subscriber so one bad handler can't break the emit
function Api.signal()
    local subs = {}
    local sig = {}
    function sig:Connect(fn)
        if type(fn) ~= "function" then return { Disconnect = function() end } end
        local token = {}
        subs[token] = fn
        return { Disconnect = function() subs[token] = nil end }
    end
    function sig:Fire(...)
        for _, fn in pairs(subs) do pcall(fn, ...) end
    end
    return sig
end

local function newMaid(ctx)
    if type(ctx.NewMaid) == "function" then return ctx.NewMaid() end
    if ctx.Maid and type(ctx.Maid.new) == "function" then return ctx.Maid.new() end
    return nil
end

-- per-api base; maid cleanup registers with the session unloader so an api never leaks on unload
function Api.define(name, ctx)
    local tag = "Api/" .. tostring(name)
    local base = {
        name   = name,
        ctx    = ctx,
        signal = Api.signal,
        maid   = newMaid(ctx),
    }

    function base.log(fmt, ...)  Log.dev(tag, fmt, ...)     end
    function base.warn(fmt, ...) Log.devwarn(tag, fmt, ...) end

    -- pcall with dev-logged failure; returns ok + result/err
    function base.safe(label, fn, ...)
        local ok, res = pcall(fn, ...)
        if not ok then base.warn("%s failed: %s", tostring(label), tostring(res)) end
        return ok, res
    end

    -- xpcall with traceback for heavier call sites (tick loops)
    function base.try(label, fn)
        local ok, res = xpcall(fn, function(e) return debug.traceback(tostring(e), 2) end)
        if not ok then base.warn("%s threw: %s", tostring(label), tostring(res)) end
        return ok, res
    end

    if base.maid and ctx.Unloader and type(ctx.Unloader.Register) == "function" then
        ctx.Unloader:Register(function()
            if not base.maid then return end
            local ok, err = pcall(function() base.maid:DoCleaning() end)
            if not ok then base.warn("maid cleanup failed: %s", tostring(err)) end
        end)
    end

    return base
end

-- one api failing is logged and skipped, never fatal to boot
local built = {}
function Api.build(ctx)
    ctx.Api = ctx.Api or {}
    for _, entry in ipairs(LOADERS) do
        local okReq, mod = pcall(entry.load)
        if okReq and type(mod) == "table" and type(mod.new) == "function" then
            local okNew, inst = pcall(mod.new, ctx)
            if okNew and inst then
                ctx.Api[entry.name] = inst
                built[entry.name] = inst
            else
                Log.devwarn("Api", "%s.new failed: %s", entry.name, tostring(inst))
            end
        else
            Log.devwarn("Api", "require %s failed: %s", entry.name, tostring(mod))
        end
    end
    return ctx.Api
end

function Api.get(name) return built[name] end

return Api

end)
__bundle_register("Api/Webhook", function(require, _LOADED, __bundle_register, __bundle_modules)
-- webhook api: wires store/transport/embed/registry, arms each event only while it's enabled and a destination exists, and exposes send/emit/test + registration; built once as ctx.Api.Webhook and shared by the ui, the launch ping, and fork features

local Api             = require("Api")
local Transport       = require("Api/Webhook/Transport")
local Embed           = require("Api/Webhook/Embed")
local Store           = require("Api/Webhook/Store")
local Registry        = require("Api/Webhook/Registry")
local UniversalEvents = require("Api/Webhook/Events")
local Log             = require("Utility/Log")

-- theme fallbacks when the user hasn't overridden username/avatar
local DEFAULT_USERNAME = "Cerberus"
local DEFAULT_AVATAR   = "https://media.discordapp.net/attachments/1349939253739651134/1428995137505067069/cerberus_logo.png"

local M = {}

local function isWebhookUrl(url)
    if type(url) ~= "string" then return false end
    local l = url:lower()
    return l:find("discord.com/api/webhooks", 1, true) ~= nil
        or l:find("discordapp.com/api/webhooks", 1, true) ~= nil
end

function M.new(ctx)
    local base       = Api.define("Webhook", ctx)
    local Services   = ctx.Services
    local References = ctx.References
    local Http       = Services.HttpService
    local NewMaid    = ctx.NewMaid
        or ((ctx.Maid and type(ctx.Maid.new) == "function") and function() return ctx.Maid.new() end)

    -- inert when Config.Webhook is off: the api still builds so ctx.Api.Webhook exists, but never arms detection or sends
    local enabledGlobally = not (ctx.Config and ctx.Config.Webhook == false)

    local store    = Store.new(ctx)
    local embed    = Embed.new(Services)
    local registry = Registry.new()

    local signals = {
        OnSent   = base.signal(),
        OnFailed = base.signal(),
    }

    local transport = Transport.new({
        encode = function(t) return Http:JSONEncode(t) end,
        decode = function(s) return Http:JSONDecode(s) end,
        log    = base.log,
        warn   = base.warn,
        onResult = function(label, ok, status)
            Log.webhook(label, ok)   -- user-friendly "Synced X"; base.log already covers dev detail
            if ok then signals.OnSent:Fire(label, status)
            else signals.OnFailed:Fire(label, status) end
        end,
    })

    -- live theme snapshot handed to the embed builder on every send
    local function themeOpts()
        return {
            defaultColor = store.getColor(),
            anon         = store.getAnon(),
            attribution  = true,
            playerName   = References.player and References.player.Name or nil,
            gameName     = References.gameName,
        }
    end

    local function resolveUrl(spec)
        if type(spec) == "table" and type(spec.route) == "string" and spec.route ~= "" then
            return store.getRoute(spec.route)
        end
        return store.getUrl()
    end

    -- the raw ungated primitive (Test + forks use it); optional onDone(ok, status) fires with the real http result
    local function send(spec, label, onDone)
        if not enabledGlobally then return false, "webhooks disabled" end
        spec = spec or {}
        local url = resolveUrl(spec)
        if not isWebhookUrl(url) then return false, "no webhook url" end

        local built = embed.build(spec, themeOpts())
        local payload = {
            username   = spec.username or store.getUsername() or DEFAULT_USERNAME,
            avatar_url = spec.avatarUrl or store.getAvatarUrl() or DEFAULT_AVATAR,
            embeds     = { built },
        }
        return transport.post(url, payload, label or spec.title or "event", onDone)
    end

    -- gated send for a registered event; accepts (key, spec) or (key, title, description)
    local function emit(key, specOrTitle, description)
        if not enabledGlobally or not store.isEventEnabled(key) then return false end
        local spec = (type(specOrTitle) == "table") and specOrTitle
            or { title = specOrTitle, description = description }
        local ev = registry.Get(key)
        return send(spec, (ev and ev.label) or key)
    end

    -- arm an event's detection only while it's enabled and a destination exists, so webhooks stay zero-cost until configured
    local armed = {}   -- key -> maid

    local function eventBus(key)
        local ev = registry.Get(key)
        return {
            Services   = Services,
            References = References,
            NewMaid    = NewMaid,
            -- events arm lazily, after every game api is built, so the live table is complete by then
            Api        = ctx.Api,
            -- store value, else the schema default for this option, else the caller's fallback
            getOption  = function(optKey, fallback)
