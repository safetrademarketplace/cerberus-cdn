                tabbox.__cerb_localize_wrapped = true
                local addTab = tabbox.AddTab
                if type(addTab) == "function" then
                    tabbox.AddTab = function(tbself, subName, iconName)
                        local subTab = addTab(tbself, tStr(subName), iconName)
                        if subTab then patchFuncs(subTab) end
                        return subTab
                    end
                end
            end
            return tabbox
        end
    end

    wrapTabboxFactory("AddLeftTabbox")
    wrapTabboxFactory("AddRightTabbox")

    -- UpdateWarningBox: Title + Text are user-visible; the flag keys are left alone
    if type(tab.UpdateWarningBox) == "function" then
        local origUpdateWarning = tab.UpdateWarningBox
        tab.UpdateWarningBox = function(self, info)
            if type(info) == "table" then translateInfo(info) end
            return origUpdateWarning(self, info)
        end
    end

    -- SetName/SetDescription relabel at runtime, so translate those too; SetIcon takes lucide ids, not text
    for _, method in ipairs({ "SetName", "SetDescription" }) do
        if type(tab[method]) == "function" then
            local orig = tab[method]
