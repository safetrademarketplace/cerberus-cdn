-- walkspeed sub-module of movement
return function(ctx)
    local Services   = ctx.Services
    local Tabs       = ctx.Tabs
    local References = ctx.References
    local Library    = ctx.Library
    local Options    = ctx.Options
    local Toggles    = ctx.Toggles
    local track      = ctx.track

    local SpeedGroup = Tabs.Movement:AddLeftGroupbox("Speed", "move")

    SpeedGroup:AddToggle("SpeedEnabled", {
        Text = "Speed",
        Default = false
    }):AddKeyPicker("SpeedKey", {
        Default = nil,
        SyncToggleState = true,
        Mode = "Toggle"
    })

    local SpeedBox = SpeedGroup:AddDependencyBox()

    SpeedBox:AddSlider("SpeedValue", {
        Text = "Speed Value",
        Default = 30,
        Min = 16,
        Max = 300,
        Rounding = 0
    })

    SpeedBox:SetupDependencies({
        { Toggles.SpeedEnabled, true },
    })

    local currentSpeedValue = Options.SpeedValue.Value

    local speedPropConn
    local speedCharConn
    local speedEnabled = false
    local speedOrigWalkSpeed
    local speedOrigHumanoid

    local function cacheSpeedBaseline(hum)
        if not hum then return end
        if speedOrigHumanoid ~= hum then
            speedOrigHumanoid = hum
            speedOrigWalkSpeed = hum.WalkSpeed
        end
    end

    local function applySpeed()
        local hum = References.humanoid
        if not hum then return end
        if hum.WalkSpeed ~= currentSpeedValue then
            hum.WalkSpeed = currentSpeedValue
        end
    end

    local function bindHumanoid()
        if speedPropConn then speedPropConn:Disconnect(); speedPropConn = nil end
        local hum = References.humanoid
        if not hum then return end
        cacheSpeedBaseline(hum)
        applySpeed()
        speedPropConn = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
            if speedEnabled then applySpeed() end
        end)
    end

    local function startSpeed()
        if speedEnabled then return end
        speedEnabled = true
        Library:Notify("Speed enabled.", 2)
        bindHumanoid()
        speedCharConn = References.onCharacter(function() bindHumanoid() end)
    end

    local function stopSpeed(silent)
        if not speedEnabled then return end
        speedEnabled = false
        if not silent then Library:Notify("Speed disabled.", 2) end
        if speedPropConn then speedPropConn:Disconnect(); speedPropConn = nil end
        if speedCharConn then speedCharConn(); speedCharConn = nil end

        local hum = References.humanoid
        if hum and speedOrigHumanoid == hum and speedOrigWalkSpeed ~= nil then
            hum.WalkSpeed = speedOrigWalkSpeed
        end
    end

    if Toggles.SpeedEnabled then
        Toggles.SpeedEnabled:OnChanged(function()
            if Toggles.SpeedEnabled.Value then startSpeed() else stopSpeed() end
        end)
    end

    if Options.SpeedValue then
        Options.SpeedValue:OnChanged(function()
            currentSpeedValue = Options.SpeedValue.Value
            if speedEnabled then applySpeed() end
        end)
    end

    return { startSpeed = startSpeed, stopSpeed = stopSpeed }
end

end)
