            base.log("armed event %s", key)
        end
    end

    local function disarmEvent(key)
        local maid = armed[key]
        if not maid then return end
        armed[key] = nil
        maid:DoCleaning()
        base.log("disarmed event %s", key)
    end

    -- a destination is any valid primary url or route url
    local function hasDestination()
        if isWebhookUrl(store.getUrl()) then return true end
        for _, u in pairs(store.getRoutes()) do
            if isWebhookUrl(u) then return true end
        end
        return false
    end

    local function refreshArming()
        local dest = enabledGlobally and hasDestination()
        for _, key in ipairs(registry.keys()) do
            local ev = registry.Get(key)
            local should = dest and ev.arm ~= nil and store.isEventEnabled(key)
            if should and not armed[key] then armEvent(key)
            elseif not should and armed[key] then disarmEvent(key) end
        end
    end

    -- register the universal events, then seed their defaults on a first-ever run only
    local function registerEvent(def)
        local ok = registry.Register(def)
        if ok then refreshArming() end
        return ok
    end
    for _, def in ipairs(UniversalEvents) do registry.Register(def) end
