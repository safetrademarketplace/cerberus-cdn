__bundle_register("Features/Volleyball/Progress/Text", function(require, _LOADED, __bundle_register, __bundle_modules)
-- progress text: the formatting the progress boxes share, rich-text-safe server strings, grouped numbers, refusal codes turned into short status lines, and a label writer that skips a line already on screen
local UiWrite = require("Utility/UiWrite")

local M = {}

-- labels render rich text, so a server string loses its angle brackets
function M.clean(text)
    if type(text) ~= "string" then return "" end
    local stripped = text:gsub("[<>]", "")
    return (stripped:match("^%s*(.-)%s*$"))
end

function M.number(n)
    n = math.floor(tonumber(n) or 0)
    local digits = ("%d"):format(math.abs(n)):reverse():gsub("(%d%d%d)", "%1,"):reverse()
    digits = digits:gsub("^,", "")
    return (n < 0 and "-" or "") .. digits
end

function M.signed(n)
    n = math.floor(tonumber(n) or 0)
    return (n >= 0 and "+" or "") .. M.number(n)
end

-- every refusal code the apis can answer, so anything else is read as the server's own message
function M.codes(...)
    local set = {}
    for i = 1, select("#", ...) do
        local errors = select(i, ...)
        if type(errors) == "table" then
            for _, code in pairs(errors) do set[code] = true end
        end
    end
    return set
end

function M.reason(err, lines, codes, fallback)
    if lines[err] then return lines[err] end
    if type(err) == "string" and not codes[err] then
        local text = M.clean(err)
        if text ~= "" then return text end
    end
    return fallback
end

-- a refused write is not remembered, so the next one retries it
function M.writer(label)
    local shown
    return function(text)
        if text == shown then return end
        if UiWrite.text(label, text) then shown = text end
    end
end

return M

end)
__bundle_register("Features/Volleyball/Progress/Spin", function(require, _LOADED, __bundle_register, __bundle_modules)
-- progress spin: one kind's spin box (style or ability); auto spin rolls the active slot until a roll meets the rarity or name target, then locks it if asked, and never rolls a locked slot, past the last free spin, or with no target
local Jobs    = require("Utility/Jobs")
local UiWrite = require("Utility/UiWrite")
local Text    = require("Features/Volleyball/Progress/Text")

local RARITY_PATH = "ReplicatedStorage.Configuration.Rarity"
local RARITIES    = { "Off", "Epic", "Legendary", "Godly", "Secret", "Ultra", "Evo" }

-- the game's spin button holds 0.5 s after each roll (C.StyleController:632)
local ROLL_GAP       = 0.6
local IDLE_WAIT      = 1
local FILL_WAIT      = 3
local FILL_TRIES     = 20
local NOTIFY_SECONDS = 6

local KINDS = {
    Style = {
        toggle = "VL_SpinStyle", lucky = "VL_StyleLucky", rarity = "VL_StyleRarity",
        targets = "VL_StyleTargets", lock = "VL_StyleLock", targetsText = "Stop On Style",
        normal = "style", luckyCount = "styleLucky",
        content = "ReplicatedStorage.Content.Style", unknown = "Stopped on unknown style",
    },
    Ability = {
        toggle = "VL_SpinAbility", lucky = "VL_AbilityLucky", rarity = "VL_AbilityRarity",
        targets = "VL_AbilityTargets", lock = "VL_AbilityLock", targetsText = "Stop On Ability",
        normal = "ability", luckyCount = "abilityLucky",
        content = "ReplicatedStorage.Content.Ability", unknown = "Stopped on unknown ability",
    },
}

local M = {}

-- kit: Profile, Net, Library, O, codes, onRoll
function M.new(kit, box, kind)
    local spec = KINDS[kind]
    local Profile, Net = kit.Profile, kit.Net
    local E = Profile.Errors

    local refusals = {
        [E.SLOT_LOCKED] = "Slot is locked",
        [E.NO_SPINS]    = "Out of spins",
        [E.NOT_OFFERED] = "No lucky spins here",
        [E.REJECTED]    = "Spin was refused",
    }

    local toggle, lucky, rarity, targets, lock, say
    local run = { job = nil, stopping = false }
    local nameToIds = {}

    local function pickedIds()
        local ids, any = {}, false
        for name, on in pairs(targets.Value) do
            if on then
                for _, id in ipairs(nameToIds[name] or {}) do
                    ids[id] = true
                    any = true
                end
            end
        end
        return ids, any
    end

    -- (target) or (nil, status line); the rarity rule takes the game's own rarity numbers, where lower is rarer (RS.Configuration.Rarity:3-12)
    local function readTarget()
        local ids, any = pickedIds()
        local choice, maxRarity = rarity.Value, nil
        if choice and choice ~= "Off" then
            local ok, Rarity = Net.module(RARITY_PATH)
            local types = ok and type(Rarity) == "table" and Rarity.Type
            maxRarity = type(types) == "table" and types[choice] or nil
            if type(maxRarity) ~= "number" then return nil, "Loading game data" end
        end
        if not maxRarity and not any then return nil, "Pick a target" end
        return { ids = ids, maxRarity = maxRarity }
    end

    -- (meets, info, waiting); meets is nil when the rarity rule cannot judge this id, and waiting says the game data may still be loading
    local function judge(target, id)
        if type(id) ~= "string" or id == "" then return false end
        local ok, value = Profile.info(kind, id)
        local info = ok and value or nil
        if target.ids[id] then return true, info end
        if not target.maxRarity then return false, info end
        if not info or type(info.rarity) ~= "number" then return nil, info, value == E.NO_DATA end
        return info.rarity <= target.maxRarity, info
    end

    local function nameOf(id, info)
        local name = Text.clean(info and info.name)
        return name ~= "" and name or Text.clean(id)
    end

    -- ends the run from inside its own job; the toggle's callback must not cancel the job that is switching it off
    local function finish(text)
        say(text)
        run.stopping = true
        UiWrite.value(toggle, false)
        run.stopping = false
    end

    -- the game's lock button sends only the active slot (C.StyleController:446-450, C.AbilityController:338-342)
    local function lockFound(job, rolled)
        if not lock.Value then return true end
        local ok, slots = Profile.slots(kind)
        if ok and slots.locks[slots.active] == true then return true end
        if rolled and not job:sleep(ROLL_GAP) then return false end
        return (Profile.toggleLock(kind)) == true
    end

    local function found(job, id, info, rolled)
        local text = ("Got %s!"):format(nameOf(id, info))
        say(text)
        if rolled then UiWrite.notify(kit.Library, text, NOTIFY_SECONDS) end
        local locked = lockFound(job, rolled)
        if not job.alive then return end
        finish(locked and text or (text .. " Not locked"))
    end

    -- a read that answers "not loaded" waits for the profile; any other refusal ends the run
    local function unread(err)
        if err == E.NOT_LOADED then
            say("Loading profile")
            return IDLE_WAIT
        end
        finish("Not available here")
        return nil
    end

    -- one pass of the run: seconds to wait before the next, or nil once it is over
    local function step(job)
        local target, why = readTarget()
        if not target then
            say(why)
            return IDLE_WAIT
        end
        local okCurrent, current = Profile.current(kind)
        if not okCurrent then return unread(current) end
        local okSlots, slots = Profile.slots(kind)
        if not okSlots then return unread(slots) end

        local meets, info, waiting = judge(target, current)
        if meets == nil then
            if waiting then
                say("Loading game data")
                return IDLE_WAIT
            end
            finish(spec.unknown)
            return nil
        end
        if meets then
            found(job, current, info, false)
            return nil
        end
        if slots.locks[slots.active] == true then
            finish("Slot is locked")
            return nil
        end

        local okSpins, spins = Profile.spins()
        if not okSpins then return unread(spins) end
        local useLucky = lucky.Value == true
        local left = spins[useLucky and spec.luckyCount or spec.normal] or 0
        if left <= 0 then
            finish("Out of spins")
            return nil
        end

        local okRoll, result = Profile.roll(kind, useLucky)
        if not job.alive then return nil end
        if not okRoll then
            if result == E.BUSY then return ROLL_GAP end
            finish(Text.reason(result, refusals, kit.codes, "Spin failed"))
            return nil
        end
        kit.onRoll()

        local hit, resultInfo = judge(target, result)
        if hit then
            found(job, result, resultInfo, true)
            return nil
        end
        if hit == nil then
            finish(spec.unknown)
            return nil
        end
        say(("Rolled %s, %s left"):format(nameOf(result, resultInfo), Text.number(left - 1)))
        return ROLL_GAP
    end

    local function spin(job)
        say("Spinning…")
        while job.alive do
            local wait = step(job)
            if not wait or not job:sleep(wait) then return end
        end
    end

    local function start()
        if run.job and run.job.alive then return end
        run.job = Jobs.spawn(spin, { name = "ProgressSpin" .. kind })
    end

    local function stop()
        if run.stopping then return end
        local job = run.job
        run.job = nil
        if job and job.alive then
            job:Cancel()
            say("Idle")
        end
    end

    -- one entry per display name the game can roll right now (RS.Content.Style:84-92, RS.Content.Ability:76-84, RS.Tools.Factory:41-56)
    local function readNames()
        local ok, Content = Net.module(spec.content)
        if not ok or type(Content) ~= "table" then return nil end
        local okIds, ids = pcall(Content.GetActiveIds, Content)
        if not okIds or type(ids) ~= "table" then return nil end
        local names, map = {}, {}
        for _, id in ipairs(ids) do
            local okDef, def = pcall(Content.Get, Content, id)
            local name = okDef and type(def) == "table" and def.DisplayName or id
            if type(name) == "string" and name ~= "" then
                if not map[name] then
                    map[name] = {}
                    names[#names + 1] = name
                end
                table.insert(map[name], id)
            end
        end
        table.sort(names, function(a, b) return a:lower() < b:lower() end)
        return names, map
    end

    local function fill(job)
        for _ = 1, FILL_TRIES do
            local names, map = readNames()
            if names and #names > 0 then
                nameToIds = map
                UiWrite.values(targets, names)
                return
            end
            if not job:sleep(FILL_WAIT) then return end
        end
    end

    toggle = box:AddToggle(spec.toggle, {
        Text     = "Auto Spin",
        Default  = false,
        Callback = function(on)
            if on then start() else stop() end
        end,
    })
    lucky = box:AddToggle(spec.lucky, { Text = "Use Lucky Spins", Default = false })
    rarity = box:AddDropdown(spec.rarity, {
        Text    = "Stop On Rarity",
        Values  = RARITIES,
        Default = "Godly",
        Tooltip = "That rarity or rarer",
    })
    targets = box:AddDropdown(spec.targets, {
        Text       = spec.targetsText,
        Values     = {},
        Default    = {},
        Multi      = true,
        Searchable = true,
    })
    lock = box:AddToggle(spec.lock, { Text = "Lock When Found", Default = true })
    say = Text.writer(box:AddLabel({ Text = "Idle", DoesWrap = true }))

    kit.O.onUnload(function()
        local job = run.job
        run.job = nil
        if job then job:Cancel() end
    end)

    return {
        -- fills the target list from the game; call once every box is built
        begin = function()
            kit.O.maid:GiveTask(Jobs.spawn(fill, { name = "ProgressTargets" .. kind }))
        end,
    }
end

return M

end)
__bundle_register("Features/Volleyball/Progress/Rewards", function(require, _LOADED, __bundle_register, __bundle_modules)
-- progress rewards: the rewards box; claims every picked kind of free reward the game would let the player claim, every 20 s or on demand and spaced like clicks, and redeems a code once the player is past the game's level gate
local Str     = require("Utility/Helpers/Str")
local Jobs    = require("Utility/Jobs")
local UiWrite = require("Utility/UiWrite")
local Text    = require("Features/Volleyball/Progress/Text")

local CATEGORIES        = { "Quests", "Season Pass", "Rank Rewards", "Challenges", "Mastery", "Level Rewards" }
local REQUIREMENTS_PATH = "ReplicatedStorage.Configuration.Requirements"
local CLAIM_EVERY       = 20
local CLAIM_GAP         = 0.4
local NOTIFY_SECONDS    = 6

local M = {}

-- the claims one pass sends, in menu order; worth is how many rewards a success counts for
local function plan(Profile, list, picked)
    local steps = {}
    local function add(fn, worth, ...)
        steps[#steps + 1] = { fn = fn, worth = worth, args = table.pack(...) }
    end
    if picked.Quests then
        for _, tab in ipairs({ { list.quests.daily, false }, { list.quests.seasonal, true } }) do
            local ready, isSeasonal = tab[1], tab[2]
            if #ready == 1 then
                add(Profile.claimQuest, 1, ready[1], isSeasonal)
            elseif #ready > 1 then
                add(Profile.claimAllQuests, #ready, isSeasonal)
            end
        end
    end
    if picked["Season Pass"] then
        for _, tier in ipairs(list.seasonTiers) do add(Profile.claimSeasonTier, 1, tier) end
    end
    if picked["Rank Rewards"] then
        for _, milestone in ipairs(list.milestones) do add(Profile.claimMilestone, 1, milestone.rank, milestone.index) end
    end
    if picked.Challenges then
        for _, level in ipairs(list.challenges) do add(Profile.claimChallenge, 1, level) end
    end
    if picked.Mastery then
        for _, index in ipairs(list.mastery) do add(Profile.claimMastery, 1, index) end
    end
    if picked["Level Rewards"] and list.levelRewards then add(Profile.claimLevelRewards, 1) end
    return steps
end

-- kit: Profile, Net, Library, O, codes
function M.new(kit, box)
    local Profile, Net = kit.Profile, kit.Net
    local E = Profile.Errors

    local redeemReasons = {
        [E.BAD_ARGS] = "Enter a code",
        [E.BUSY]     = "Already redeeming",
        [E.REJECTED] = "Code didn't work",
    }

    local what, code, say
    local autoJob, nowJob, redeemJob, passJob

    local function pass(job)
        if passJob and passJob.alive then return end
        passJob = job
        local ok, list = Profile.claimable()
        if not ok then
            passJob = nil
            say(list == E.NOT_LOADED and "Loading profile" or "Can't check rewards")
            return
        end
        local claimed, sent = 0, 0
        for _, step in ipairs(plan(Profile, list, what.Value)) do
            if sent > 0 and not job:sleep(CLAIM_GAP) then return end
            sent = sent + 1
            local okClaim = step.fn(table.unpack(step.args, 1, step.args.n))
            if not job.alive then return end
            if okClaim == true then claimed = claimed + step.worth end
        end
        passJob = nil
        if claimed > 0 then
            say(claimed == 1 and "Claimed 1 reward" or ("Claimed %d rewards"):format(claimed))
        else
            say(sent > 0 and "Couldn't claim rewards" or "Nothing to claim")
        end
    end

    local function setAuto(on)
        if on then
            if autoJob and autoJob.alive then return end
            autoJob = Jobs.interval(CLAIM_EVERY, pass, { name = "ProgressAutoClaim", immediate = true })
        elseif autoJob then
            autoJob:Cancel()
            autoJob = nil
        end
    end

    local function claimNow()
        if nowJob and nowJob.alive then return end
        nowJob = Jobs.spawn(pass, { name = "ProgressClaimNow" })
    end

    -- the game's code box is read-only below this level (C.ShopController.MenuFrame.Sections.Codes:21-56, RS.Configuration.Requirements:8)
    local function codeLevel()
        local ok, Requirements = Net.module(REQUIREMENTS_PATH)
        local need = ok and type(Requirements) == "table" and Requirements.Code
        return type(need) == "number" and need or nil
    end

    local function redeem(job)
        local text = Str.trim(code.Value)
        if type(text) ~= "string" or text == "" then
            say("Enter a code")
            return
        end
        local need = codeLevel()
        if need and Profile.level() < need then
            say(("Reach level %d first"):format(need))
            return
        end
        local ok, message = Profile.redeemCode(text)
        if not job.alive then return end
        local result
        if ok then
            result = Text.clean(message)
            if result == "" then result = "Code redeemed" end
        elseif message == E.LEVEL_TOO_LOW then
            result = need and ("Reach level %d first"):format(need) or "Reach a higher level first"
        else
            result = Text.reason(message, redeemReasons, kit.codes, "Couldn't redeem")
        end
        say(result)
        UiWrite.notify(kit.Library, result, NOTIFY_SECONDS)
    end

    local function redeemNow()
        if redeemJob and redeemJob.alive then return end
        redeemJob = Jobs.spawn(redeem, { name = "ProgressRedeem" })
    end

    box:AddToggle("VL_AutoClaim", { Text = "Auto Claim", Default = false, Callback = setAuto })
    what = box:AddDropdown("VL_ClaimWhat", {
        Text    = "Claim",
        Values  = CATEGORIES,
        Default = CATEGORIES,
        Multi   = true,
    })
    box:AddButton({ Text = "Claim Now", Func = claimNow })
    code = box:AddInput("VL_Code", { Text = "Code", Default = "", Placeholder = "Enter a code" })
    box:AddButton({ Text = "Redeem", Func = redeemNow })
    say = Text.writer(box:AddLabel({ Text = "Idle", DoesWrap = true }))

    kit.O.onUnload(function()
        if autoJob then autoJob:Cancel() end
        if nowJob then nowJob:Cancel() end
        if redeemJob then redeemJob:Cancel() end
        autoJob, nowJob, redeemJob = nil, nil, nil
    end)

    return {}
