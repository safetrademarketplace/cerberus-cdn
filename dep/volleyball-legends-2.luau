__bundle_register("Api/Webhook/Events/LevelUp", function(require, _LOADED, __bundle_register, __bundle_modules)
-- level up event: posts each new level as the local player's User_Level attribute rises (Common.State:5-12, LevelRewardsController:32)

local LEVEL_ATTRIBUTE = "User_Level"

return {
    key     = "LevelUp",
    label   = "Level Ups",
    default = false,
    arm = function(bus)
        local Profile = type(bus.Api) == "table" and bus.Api.Profile or nil
        local player = bus.References.player
        if type(Profile) ~= "table" or not player then return end

        -- level reads 0 until the attribute replicates, so that first reading only sets the baseline
        local last = Profile.level()
        bus.track(player:GetAttributeChangedSignal(LEVEL_ATTRIBUTE):Connect(function()
            local now = Profile.level()
            local from = last
            last = now
            if from > 0 and now > from then
                bus.emit({ title = "Level Up!", description = ("Reached level %d"):format(math.floor(now)) })
            end
        end))
    end,
}

end)
