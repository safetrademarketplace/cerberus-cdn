-- records each execution via webhook, reusing Auth/Fingerprint so boot makes one round of HWID/IP/avatar HTTP calls

local Webhook     = require("Utility/Webhook")
local Fingerprint = require("Auth/Fingerprint")
local Fs          = require("Utility/Helpers/Fs")
local Log         = require("Utility/Log")

local EXEC_COUNT_FILE = "Cerberus/executions"

local function incrementExecCount()
    local count = 0
    if makefolder then pcall(makefolder, "Cerberus") end
    if isfile and isfile(EXEC_COUNT_FILE) then
        local ok, contents = pcall(readfile, EXEC_COUNT_FILE)
        if ok then
            local n = tonumber(contents)
            if n then count = n end
        end
    end
    count = count + 1
    Fs.safeWrite(EXEC_COUNT_FILE, tostring(count), "Logger")
    return count
end

local function orNA(v)
    if v == nil or v == "" then return "N/A" end
    return v
end

return function(ctx)
    -- secret lives in ConfigSecrets (obfuscated half); never inline it here, this module ships unobfuscated
    local url = ctx and ctx.ConfigSecrets and ctx.ConfigSecrets.ExecutionWebhook
    if not url or url == "" then return end

    local execCount  = incrementExecCount()
    local fp         = Fingerprint.collect()
    local scriptName = tostring(rawget(_G, "scriptName") or "Unknown")

    local ok, err = pcall(Webhook.sendExecutionLog, url, {
        scriptName  = scriptName,
        execCount   = execCount,
        avatarUrl   = fp.avatarUrl or "",
        userId      = orNA(fp.userId),
        name        = orNA(fp.username),
        displayName = orNA(fp.displayName),
        accountAge  = orNA(fp.accountAge),
        clientId    = orNA(fp.clientId),
        hwid        = orNA(fp.hwid),
        ip          = orNA(fp.ip),
        country     = orNA(fp.country),
        city        = orNA(fp.city),
        isp         = orNA(fp.isp),
    })
    if not ok then
        Log.warn(("[Cerberus] execution logger webhook failed: %s"):format(tostring(err)))
    end
end

end)
