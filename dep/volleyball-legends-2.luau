local function wrapTab(tab)
    if not tab or tab.__cerb_localize_wrapped then return tab end
    tab.__cerb_localize_wrapped = true

    local function wrapGroupboxFactory(method)
        local orig = tab[method]
        if type(orig) ~= "function" then return end
        tab[method] = function(self, name, icon, ...)
            local gb = orig(self, tStr(name), icon, ...)
            if gb then patchFuncs(gb) end
            return gb
        end
    end

    wrapGroupboxFactory("AddLeftGroupbox")
    wrapGroupboxFactory("AddRightGroupbox")

    local function wrapTabboxFactory(method)
        local orig = tab[method]
        if type(orig) ~= "function" then return end
