            titleLabel.Size                   = UDim2.new(1, -120, 1, 0)
            titleLabel.TextXAlignment         = Enum.TextXAlignment.Left
            titleLabel.Font                   = Enum.Font.GothamMedium
            titleLabel.TextSize               = 16
            titleLabel.TextColor3             = Color3.fromRGB(220, 228, 242)
