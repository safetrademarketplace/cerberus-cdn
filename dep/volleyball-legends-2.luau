-- auto ability: presses your ability the moment it is fully charged while you are playing and a ball is live, then waits out a short local cooldown
local Scheduler = require("Utility/Scheduler")

local POLL     = 0.1
local COOLDOWN = 3

local M = {}

function M.new(deps)
    local Match   = deps.Match
    local Ball    = deps.Ball
    local Actions = deps.Actions
    local maid    = deps.maid

    local loop, loopSlot
    local readyAt = 0

    local function ballLive()
        local okIn, inPlay = Ball.inPlay()
        if okIn and inPlay then return true end
        local okBall, ball = Ball.active()
        return okBall and ball ~= nil
    end

    local function step()
        local now = os.clock()
        if now < readyAt then return end
        local okP, playing = Match.isPlaying()
        if not (okP and playing) then return end
        if not ballLive() then return end
        local okR, ready = Actions.ultimateReady()
        if not (okR and ready) then return end
        readyAt = now + COOLDOWN
        Actions.ultimate()
    end

    local function stopLoop()
        if loop then maid[loopSlot] = nil end
        loop, loopSlot = nil, nil
    end

    local function setEnabled(on)
        if not on then
            stopLoop()
            return
        end
        if loop and loop.Connected then return end
        stopLoop()
        loop = Scheduler.heartbeat(step, { name = "Assist/AutoAbility", interval = POLL })
        if loop then loopSlot = maid:GiveTask(loop) end
    end

    return { setEnabled = setEnabled, stop = stopLoop }
end

return M

end)
