                end
                Library:Notify(string.format(tr("Deleted local %q — you can re-download now."), item.name), 4)
                refreshSaveManagerDropdown()
                applyActionVisual(false)
                return
            end

            dlBtn.AutoButtonColor = false
            dlBtn.Text = "..."
            task.spawn(function()
                local full, err = Api.get(item.id)
                Identity.elevate()
                if not full then
                    UiWrite.notify(Library, string.format(tr("Download failed: %s"), tostring(err)), 4)
                    applyActionVisual(false)
                    return
                end
                -- defensive payload extraction: backends wrap responses or JSON-string the data field; log top-level keys if no shape matches
                local payload = full.data
                if payload == nil and type(full.config) == "table" then
                    payload = full.config.data
                end
                if payload == nil and type(full.payload) ~= "nil" then
                    payload = full.payload
                end
                if type(payload) == "string" then
                    local HttpService = Services.HttpService
                    local okDecode, decoded = pcall(HttpService.JSONDecode, HttpService, payload)
                    if okDecode then payload = decoded end
                end
                if payload == nil then
                    local keys = {}
                    for k in pairs(full) do keys[#keys + 1] = tostring(k) end
                    Log.warn("[Cerberus.Configs] /api/configs/" .. tostring(item.id)
                        .. " — no recognized data field. keys=[" .. table.concat(keys, ", ") .. "]")
                    UiWrite.notify(Library, string.format(
                        tr("Download failed: server returned no data field (keys: %s)"),
                        table.concat(keys, ", ")), 8)
                    applyActionVisual(false)
                    return
                end
                -- race guard: bail if a same-named config appeared on disk mid-download
                if Storage.exists(item.name) then
                    UiWrite.notify(Library, string.format(tr("You already have a config named %q — delete the local copy first."), item.name), 6)
                    applyActionVisual(true)
                    return
                end
                local ok, writeErr = Storage.write(item.name, payload)
                if not ok then
                    UiWrite.notify(Library, string.format(tr("Save failed: %s"), tostring(writeErr)), 4)
                    applyActionVisual(false)
                    return
                end
                UiWrite.notify(Library, string.format(tr("Saved %q — visible in Configurations"), item.name), 4)
                refreshSaveManagerDropdown()
                applyActionVisual(true)
            end)
        end)

        return row
    end

    function self:Refresh()
        if self.loading then return end
        self.loading = true
        clearRows()
        emptyLabel.Visible = false
        setStatus(tr("Loading…"), false)

        task.spawn(function()
            local data, err = Api.list({
                game              = Storage.gameName(),
                viewer_discord_id = services.viewerDiscordId,
                sort              = self.sort,
                limit             = 100,
            })
            Identity.elevate()
            self.loading = false
            if not data then
                setStatus(string.format(tr("Couldn't load: %s"), tostring(err)), true)
                return
            end
            -- accept { items = [...] } or a bare array, backend-dependent
            local items = data.items or data.configs or data
            if type(items) ~= "table" or #items == 0 then
                setStatus("", false)
                emptyLabel.Text = string.format(
                    tr("No configs uploaded for %s yet — be the first!"),
                    Storage.gameName())
                emptyLabel.Visible = true
                return
            end
            self.items = items
            for i, item in ipairs(items) do
                self.rows[item.id] = buildRow(item, i)
            end
            setStatus(string.format(tr("%d configs"), #items), false)
        end)
    end

    sortBtn.Activated:Connect(function()
        local idx = (self.sort == "popular") and 2 or 1
        self.sort = SORT_VALUES[idx]
        sortBtn.Text = tr("Sort: ") .. tr(SORT_LABELS[self.sort])
        self:Refresh()
    end)

    refreshBtn.Activated:Connect(function()
        self:Refresh()
    end)

    function self:OnShow()
        self:Refresh()
    end

    return self
end

end)
__bundle_register("Features/Configs/Ui", function(require, _LOADED, __bundle_register, __bundle_modules)
-- configs popup shell (:Show/:Hide/:RegisterPane); panes built lazily, factory(parentFrame, services) returns optional { OnShow, OnHide }

local Theme    = require("UI/Scheme")
local Build    = require("UI/Build")
local Log      = require("Utility/Log")
local Services = require("Services")
local UiHost   = require("UI/UiHost")
local tr       = require("Features/Configs/Tr").tr

local TweenService     = Services.TweenService
local UserInputService = Services.UserInputService

local New     = Build.New
local Round   = Build.Round
local Pad     = Build.Pad
local Hover   = Build.Hoverable

-- scale-based panel with UISizeConstraint clamps (880×620 desktop down to 320×420 mobile); UIScale drives the open/close anim
local PANEL_SCALE   = UDim2.new(0.92, 0, 0.92, 0)
local PANEL_MIN     = Vector2.new(320, 420)
local PANEL_MAX     = Vector2.new(880, 620)
local NARROW_WIDTH  = 600  -- below this width we collapse Submit's two columns

local pickHostGui = UiHost.pick

return function(services)
    local Library  = services.Library
    local theme    = Theme(Library)

    local shell = {
        services    = services,
        theme       = theme,
        gui         = nil,
        backdrop    = nil,
        panel       = nil,
        contentArea = nil,
        tabBar      = nil,
        tabButtons  = {},   -- name -> TextButton
        panes       = {},   -- name -> { factory, frame, ctrl, built }
        order       = {},   -- ordered list of pane names for tab layout
        active      = nil,  -- currently visible pane name
        opened      = false,
        connections = {},
        unloaderRegistered = false,
    }

    function shell:_buildOnce()
        if self.gui then return end

        local screen = New("ScreenGui", {
            Name           = "ConfigsBrowser",
            ResetOnSpawn   = false,
            IgnoreGuiInset = true,
            DisplayOrder   = 9990,           -- below loading screen (9999) but above main UI
            Enabled        = false,
            Parent         = pickHostGui(),
        })
        self.gui = screen

        local backdrop = New("TextButton", {
            Name                   = "Backdrop",
            Size                   = UDim2.fromScale(1, 1),
            BackgroundColor3       = theme.Backdrop,
            BackgroundTransparency = 1,
            BorderSizePixel        = 0,
            AutoButtonColor        = false,
            Text                   = "",
            Parent                 = screen,
        })
        self.backdrop = backdrop

        local panel = New("Frame", {
            Name             = "Panel",
            -- Active = true sinks mouse input so empty-panel clicks don't fall through to the backdrop close handler
            Active           = true,
            AnchorPoint      = Vector2.new(0.5, 0.5),
            Position         = UDim2.fromScale(0.5, 0.5),
            Size             = PANEL_SCALE,
            BackgroundColor3 = theme.Panel,
            BorderSizePixel  = 0,
            ClipsDescendants = true,
            Parent           = screen,
        })
        Round(panel, 10, theme.Outline)
        New("UISizeConstraint", {
            MinSize = PANEL_MIN,
            MaxSize = PANEL_MAX,
            Parent  = panel,
        })
        local panelScale = New("UIScale", {
            Scale  = 1,
            Parent = panel,
        })
        self.panel = panel
        self.panelScale = panelScale

        -- viewport tracking so panes can flip desktop/mobile layout via shell.OnViewportChange
        self._viewportListeners = {}
        local Workspace = Services.Workspace
        local function fireViewport()
            local cam = Workspace.CurrentCamera
            local size = cam and cam.ViewportSize or Vector2.new(0, 0)
            for _, cb in ipairs(self._viewportListeners) do
                pcall(cb, size)
            end
        end
        local function bindCamera()
            local cam = Workspace.CurrentCamera
            if not cam then return end
            table.insert(self.connections,
                cam:GetPropertyChangedSignal("ViewportSize"):Connect(fireViewport))
        end
        bindCamera()
        table.insert(self.connections,
            Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
                bindCamera()
                fireViewport()
            end))
        self._fireViewport = fireViewport

        local header = New("Frame", {
            Name             = "Header",
            Size             = UDim2.new(1, 0, 0, 56),
            BackgroundColor3 = theme.Background,
            BorderSizePixel  = 0,
            Parent           = panel,
        })
        New("Frame", {
            Name             = "Border",
            Size             = UDim2.new(1, 0, 0, 1),
            Position         = UDim2.new(0, 0, 1, -1),
            BackgroundColor3 = theme.Outline,
            BorderSizePixel  = 0,
            Parent           = header,
        })

        New("TextLabel", {
            Name                   = "Title",
            BackgroundTransparency = 1,
            Position               = UDim2.fromOffset(20, 0),
            Size                   = UDim2.new(1, -80, 1, 0),
            Font                   = Enum.Font.GothamBold,
            TextSize               = 18,
            TextColor3             = theme.Text,
            TextXAlignment         = Enum.TextXAlignment.Left,
            Text                   = tr("Community Configs") .. " — " .. (services.Storage.gameName() or tr("Universal")),
            Parent                 = header,
        })

        local closeBtn = New("TextButton", {
            Name                   = "Close",
            AnchorPoint            = Vector2.new(1, 0.5),
            Position               = UDim2.new(1, -14, 0.5, 0),
            Size                   = UDim2.fromOffset(32, 32),
            BackgroundColor3       = theme.Row,
            BorderSizePixel        = 0,
            -- plain ascii X — unicode ✕ wasn't rendering on some font/executor combos
            Text                   = "X",
            TextColor3             = theme.Text,
            Font                   = Enum.Font.GothamBold,
            TextSize               = 16,
            AutoButtonColor        = false,
            Parent                 = header,
        })
        Round(closeBtn, 6)
        Hover(closeBtn, theme.Row, theme.RowHover)
        table.insert(self.connections, closeBtn.Activated:Connect(function()
            self:Hide()
        end))

        -- border and buttons-row must be siblings of tabBar, else the horizontal UIListLayout counts the border as a slot and pushes tabs off-edge
        local tabBar = New("Frame", {
            Name             = "TabBar",
            Size             = UDim2.new(1, 0, 0, 40),
            Position         = UDim2.fromOffset(0, 56),
            BackgroundColor3 = theme.Background,
            BorderSizePixel  = 0,
            Parent           = panel,
        })
        New("Frame", {  -- bottom border (sibling of tabRow)
            Size             = UDim2.new(1, 0, 0, 1),
            Position         = UDim2.new(0, 0, 1, -1),
            BackgroundColor3 = theme.Outline,
            BorderSizePixel  = 0,
            Parent           = tabBar,
