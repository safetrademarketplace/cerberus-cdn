        local points = {}
        local nextBounce = 1
        for i = 0, samples do
            local t = horizon * (i / samples)
            -- each bounce is its own point, so a drawn path turns at the net and not a sample later
            while bounces[nextBounce] and bounces[nextBounce].time < t do
                points[#points + 1] = { t = bounces[nextBounce].time, position = bounces[nextBounce].position }
                nextBounce = nextBounce + 1
            end
            points[#points + 1] = { t = t, position = positionAt(t) }
        end

        return true, {
            origin            = positionAt(0),
            velocity          = velocityAt(0),
            gravity           = inp.g,
            gravityMultiplier = inp.gm,
            timeScale         = inp.k,
            radius            = inp.r,
            acceleration      = path.accel,
            accelTotal        = path.a,
            horizon           = horizon,
            positionAt        = positionAt,
            velocityAt        = velocityAt,
            path              = points,
            bounces           = bounces,
        }
    end

    -- the first floor contact on the predicted path, as point and real-time; (true, nil) when a ball exists but never reaches the floor
    local function landing(opts)
        if not net then return false, Errors.NO_NET end
        opts = opts or {}
        local ok, path, elapsed, inp = forecast(opts)
        if not ok then return false, path end
        local land = landingFrom(path, elapsed)
        if land then return true, land end
        if inp.floorY == nil then return false, Errors.NO_FLOOR end
        return true, nil
    end

    -- earliest real-time the predicted ball sphere enters the box {cf, size}, bounces included: scan then bisect, like Shirudo Timing.getShieldTime:40-49; (true, nil) when it never enters within the horizon.
    -- opts.boxVelocity / opts.boxAccel move the box along a ballistic path from where it is now (a hitbox riding a jump), real time
    local function timeIntoBox(cf, size, opts)
        if not net then return false, Errors.NO_NET end
        if cf == nil or size == nil then return false, Errors.BAD_ARGS end
        local ok, pred = predict(opts)
        if not ok then return false, pred end
        opts = opts or {}
        local r = pred.radius
        local horizon = tonumber(opts.horizon) or pred.horizon
        local step = math.max(1e-3, tonumber(opts.step) or (1 / 60))
