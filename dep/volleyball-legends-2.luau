    local function predict(opts)
        if not net then return false, Errors.NO_NET end
        opts = opts or {}
        local ok, path, elapsed, inp = forecast(opts)
        if not ok then return false, path end

        local function positionAt(t)
            return Trajectory.positionAt(path, elapsed + t)
