__bundle_register("Features/Volleyball/BallVisuals/Pool", function(require, _LOADED, __bundle_register, __bundle_modules)
-- drawing pool: Drawing objects of one class sharing a style, created only when first taken; take(i) shows the i-th, finish(n) hides everything past n, remove() frees them all
local Executor = require("Utility/Executor")

local Pool = {}
Pool.__index = Pool

local function drawingLib()
    local lib = Executor.get("Drawing")
    if type(lib) == "table" and type(lib.new) == "function" then return lib end
    return nil
end

function Pool.new(class, style)
    return setmetatable({ class = class, style = style, items = {}, shown = 0 }, Pool)
end

-- items 1..shown are visible and everything past shown is hidden; takes run 1, 2, 3 … each frame so that holds
function Pool:take(i)
    local items = self.items
    local item = items[i]
    if not item then
        local lib = drawingLib()
        if not lib then return nil end
        local ok, made = pcall(lib.new, self.class)
        if not ok or made == nil then return nil end
        -- executors differ on which style properties exist, so a missing one is skipped rather than fatal
        for prop, value in pairs(self.style) do
            pcall(function() made[prop] = value end)
        end
        made.Visible = false
        items[#items + 1] = made
        item = made
    end
    if i > self.shown then
        item.Visible = true
        self.shown = i
    end
    return item
end

function Pool:finish(n)
    local items = self.items
    for i = n + 1, self.shown do
        items[i].Visible = false
    end
    if n < self.shown then self.shown = n end
end

function Pool:setColor(color)
    self.style.Color = color
    for _, item in ipairs(self.items) do
        item.Color = color
    end
end

function Pool:remove()
    for i, item in ipairs(self.items) do
        pcall(item.Remove, item)
        self.items[i] = nil
    end
    self.shown = 0
end

return Pool

end)
