        if turnedDown then table.clear(refused) end
        return nil
    end

    local function pass()
        local okP, playing = Match.isPlaying()
        if not okP then return end
        if playing then
            sawPlaying = true
            table.clear(refused)
            return
        end
        if joinedAt then
            if not sawPlaying and os.clock() - joinedAt < SETTLE then return end
            joinedAt = nil
        end
        sawPlaying = false
        if not courtOpen() then return end
        local teamSlot, position = plan()
        if not teamSlot then return end
        local ok, joined = Match.join(teamSlot, position)
        if ok and joined then
            joinedAt = os.clock()
