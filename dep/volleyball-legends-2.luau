__bundle_register("UI/Topbar", function(require, _LOADED, __bundle_register, __bundle_modules)
-- topbar: floating stats strip (brand, game, fps, ping, clock) that lives outside the menu window, so it stays up while the menu is closed
local Services   = require("Services")
local References = require("References")
local Identity   = require("Utility/Identity")
local Scheduler  = require("Utility/Scheduler")

local M = {}

-- text refreshes twice a second; frames are counted every frame in between
local REFRESH = 0.5

-- fixed widths for the live readouts, so the pill doesn't jitter as digits change
local FPS_WIDTH  = 54
local PING_WIDTH = 50
local TIME_WIDTH = 40

local function readPing(item)
    if item then
        local ok, value = pcall(item.GetValue, item)
        if ok and type(value) == "number" then return math.floor(value + 0.5) end
    end
    local player = References.player
    if player and player.GetNetworkPing then
        local ok, value = pcall(player.GetNetworkPing, player)
        if ok and type(value) == "number" then return math.floor(value * 1000 + 0.5) end
    end
    return nil
end

local function findPingItem()
    local ok, item = pcall(function()
        return Services.Stats.Network.ServerStatsItem["Data Ping"]
    end)
    return ok and item or nil
end

function M.new(Library, opts)
    opts = type(opts) == "table" and opts or {}
    local Scheme = Library.Scheme

    -- scheme-bound properties go through the library registry so theme switches repaint the strip too
    local function paint(inst, props)
        local registry = {}
        for prop, key in pairs(props) do
            inst[prop] = type(key) == "function" and key() or Scheme[key]
            registry[prop] = key
        end
        Library:AddToRegistry(inst, registry)
        return inst
    end

    local function semibold()
        return Font.new(Library.Scheme.Font.Family, Enum.FontWeight.SemiBold)
    end

    local root = Instance.new("Frame")
    root.Name = "__cerb_topbar"
    root.AnchorPoint = Vector2.new(0.5, 0)
    root.AutomaticSize = Enum.AutomaticSize.X
    root.BackgroundTransparency = 0.04
    root.BorderSizePixel = 0
    root.Position = UDim2.new(0.5, 0, 0, 8)
    root.Size = UDim2.fromOffset(0, 34)
    root.Visible = false
    root.ZIndex = 50
    paint(root, { BackgroundColor3 = "BackgroundColor" })

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = root

    local stroke = Instance.new("UIStroke")
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    paint(stroke, { Color = "OutlineColor" })
    stroke.Parent = root

    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, 14)
    padding.PaddingRight = UDim.new(0, 14)
    padding.Parent = root

    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Horizontal
    layout.VerticalAlignment = Enum.VerticalAlignment.Center
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 10)
    layout.Parent = root

    -- follows the menu's dpi setting
    local scale = Instance.new("UIScale")
    scale.Scale = Library.DPIScale or 1
    scale.Parent = root
    table.insert(Library.Scales, scale)

    local order = 0
    local function nextOrder()
        order = order + 1
        return order
    end

    local function label(text, width, colorKey, transparency, font)
        local l = Instance.new("TextLabel")
        l.AutomaticSize = width and Enum.AutomaticSize.None or Enum.AutomaticSize.X
        l.BackgroundTransparency = 1
        l.LayoutOrder = nextOrder()
        l.Size = UDim2.new(0, width or 0, 1, 0)
        l.Text = text
        l.TextSize = 14
        l.TextTransparency = transparency or 0
        l.TextXAlignment = width and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left
        l.ZIndex = 51
        paint(l, { TextColor3 = colorKey or "FontColor", FontFace = font or "Font" })
        l.Parent = root
        return l
    end

    local function divider()
        local d = Instance.new("Frame")
        d.BorderSizePixel = 0
        d.LayoutOrder = nextOrder()
        d.Size = UDim2.fromOffset(1, 14)
        d.ZIndex = 51
        paint(d, { BackgroundColor3 = "OutlineColor" })
        d.Parent = root
    end

    local icon = opts.Icon and Library:GetCustomIcon(opts.Icon)
    if icon then
        local logo = Instance.new("ImageLabel")
        logo.BackgroundTransparency = 1
        logo.Image = icon.Url
        logo.ImageRectOffset = icon.ImageRectOffset or Vector2.zero
        logo.ImageRectSize = icon.ImageRectSize or Vector2.zero
        logo.LayoutOrder = nextOrder()
        logo.ScaleType = Enum.ScaleType.Fit
        logo.Size = UDim2.fromOffset(18, 18)
        logo.ZIndex = 51
        paint(logo, { ImageColor3 = "AccentColor" })
        logo.Parent = root
        layout.Padding = UDim.new(0, 8)
    end

    label(tostring(opts.Brand or "Cerberus"), nil, "AccentColor", 0, semibold)
    divider()
    label(tostring(opts.Game or References.gameName or ""), nil, "FontColor", 0.3)
    divider()
    local fpsLabel = label("-- fps", FPS_WIDTH, "FontColor", 0.3)
    divider()
    local pingLabel = label("-- ms", PING_WIDTH, "FontColor", 0.3)
    divider()
    local timeLabel = label(os.date("%H:%M"), TIME_WIDTH, "FontColor", 0.3)

    root.Parent = Library.ScreenGui
    Library:MakeDraggable(root, root, true, false)

    local handle = { Visible = false, Root = root }
    local job, pingItem
    local frames, elapsed = 0, 0

    local function refresh()
        -- a scheduler wake can run below the identity a write under the ui root needs
        Identity.elevate()
        local fps = elapsed > 0 and math.floor(frames / elapsed + 0.5) or 0
        fpsLabel.Text = string.format("%d fps", math.clamp(fps, 0, 999))
        local ms = readPing(pingItem)
        pingLabel.Text = ms and string.format("%d ms", ms) or "-- ms"
        timeLabel.Text = os.date("%H:%M")
    end

    local function bind()
        if job then return end
        pingItem = pingItem or findPingItem()
        frames, elapsed = 0, 0
        job = Scheduler.render(function(dt)
            frames = frames + 1
            elapsed = elapsed + (dt or 0)
            if elapsed >= REFRESH then
                refresh()
                frames, elapsed = 0, 0
            end
        end, { name = "Topbar", priority = 210 })
    end

    local function unbind()
        if job then
            job:Disconnect()
            job = nil
        end
    end

    function handle:SetVisible(on)
        on = on == true
        handle.Visible = on
        root.Visible = on
        if on then bind() else unbind() end
    end

    function handle:Destroy()
        unbind()
        Library:RemoveFromRegistry(root)
        if root.Parent then root:Destroy() end
    end

    Library:OnUnload(function() handle:Destroy() end)

    return handle
end

return M

end)
__bundle_register("Utility/Scheduler", function(require, _LOADED, __bundle_register, __bundle_modules)
-- shared frame scheduler: one runservice connection per lane dispatching a priority-sorted task list under an optional frame budget, so features never hold their own per-frame connections

local Services = require("Services")
local Log      = require("Utility/Log")

local RunService = Services.RunService

local DEFAULT_PRIORITY = 100
local COST_SMOOTHING   = 0.1 -- ema weight for the per-task cost estimate the budget spends against
local MAX_STRIKES      = 3   -- consecutive errors before a task is dropped instead of left to spam
local MAX_STARVES      = 2   -- a deferrable task runs regardless after this many budget skips
local PHASE_SLOTS      = 8   -- start offsets equal-interval tasks are spread across

local M = {}

local budget    = nil -- seconds of dispatch time per frame; nil = unlimited
local paused    = false
local profiling = false
local nextSeq   = 0
local lanes     = {}

-- compaction and sorting happen here, never in the dispatch loop, so the hot path only ever walks a stable array
local function compact(lane)
    local tasks = lane.tasks
    local n = 0
    for i = 1, #tasks do
        local t = tasks[i]
        if t.alive then
            n = n + 1
            tasks[n] = t
        end
    end
    for i = #tasks, n + 1, -1 do
        tasks[i] = nil
    end
    -- seq tiebreak keeps equal priorities in registration order, which table.sort alone does not guarantee
    table.sort(tasks, function(a, b)
        if a.priority ~= b.priority then return a.priority < b.priority end
        return a.seq < b.seq
    end)
    lane.dirty = false
end

local function detach(lane)
    if lane.conn then
        lane.conn:Disconnect()
        lane.conn = nil
    end
end

local function unbind(lane, t)
    if not t.alive then return end
    t.alive = false
    lane.live = lane.live - 1
    lane.dirty = true
    if lane.live > 0 then return end
    detach(lane)
    -- an idle lane would otherwise hold every dead task's closure until something rebinds it
    if not lane.running then compact(lane) end
end

local function makeDispatch(lane)
    return function(a, b)
        if paused then return end
        if lane.dirty then compact(lane) end

        local tasks   = lane.tasks
        local dt      = lane.dtSecond and b or a
        local cap     = budget
        local measure = cap ~= nil or profiling
        local now     = os.clock()
        local spent   = 0

        lane.running = true
        -- `t` may be nil: a task that triggers the unloader clears this array mid-iteration, after the numeric for fixed its bound
        for i = 1, #tasks do
            local t = tasks[i]
            if t and t.alive and now >= t.nextRun then
                if cap and t.deferrable and t.starved < MAX_STARVES and spent + t.cost > cap then
                    t.starved = t.starved + 1
                else
                    t.starved = 0
                    local started = measure and os.clock() or 0
                    local ok, err = pcall(t.fn, dt)
                    if measure then
                        local elapsed = os.clock() - started
                        t.cost = t.cost + (elapsed - t.cost) * COST_SMOOTHING
                        spent = spent + elapsed
                    end
                    -- scheduled off the frame stamp, not the post-run clock, so a slow task can't drift its own cadence
                    t.nextRun = (t.interval > 0) and (now + t.interval) or 0
                    if ok then
                        t.strikes = 0
                    else
                        t.strikes = t.strikes + 1
                        Log.devwarn("Scheduler", "%s/%s errored (%d/%d): %s",
                            lane.name, t.name, t.strikes, MAX_STRIKES, tostring(err))
                        if t.strikes >= MAX_STRIKES then
                            lane.dropped = lane.dropped + 1
                            unbind(lane, t)
                        end
                    end
                end
            end
        end
        lane.running = false

        lane.spent = spent
    end
end

local function newLane(name, signal, dtSecond)
    local lane = {
        name     = name,
        signal   = signal,
        dtSecond = dtSecond, -- Stepped passes (elapsed, delta); render and heartbeat pass delta first
        tasks    = {},
        live     = 0,
        phase    = 0,
        spent    = 0,
        dropped  = 0,
        dirty    = false,
        running  = false,
        conn     = nil,
    }
    lane.dispatch = makeDispatch(lane)
    return lane
end

lanes.render    = newLane("render", RunService.RenderStepped, false)
lanes.heartbeat = newLane("heartbeat", RunService.Heartbeat, false)
lanes.stepped   = newLane("stepped", RunService.Stepped, true)

local function attach(lane)
    if lane.conn then return end
    local ok, conn = pcall(lane.signal.Connect, lane.signal, lane.dispatch)
    if not ok or not conn then
        Log.devwarn("Scheduler", "%s lane failed to connect: %s", lane.name, tostring(conn))
        return
    end
    lane.conn = conn
end

-- Destroy mirrors Disconnect so one handle is equally valid for Mount's track() and Maid:GiveTask()
local function newHandle(lane, t)
    local handle = {}

    function handle:Disconnect()
        unbind(lane, t)
    end

    handle.Destroy = handle.Disconnect

    function handle:SetInterval(seconds)
        t.interval = math.max(0, tonumber(seconds) or 0)
        t.nextRun = 0
    end

    function handle:SetPriority(priority)
        t.priority = tonumber(priority) or DEFAULT_PRIORITY
        lane.dirty = true
    end

    -- read through to the task so Connected stays honest after a strike-out drop, not just after Disconnect
    return setmetatable(handle, {
        __index = function(_, key)
            if key == "Connected" then return t.alive end
            return nil
        end,
    })
end

function M.bind(laneName, fn, opts)
    local lane = lanes[laneName]
    if not lane then
        Log.devwarn("Scheduler", "unknown lane %s", tostring(laneName))
        return nil
    end
    if type(fn) ~= "function" then
        Log.devwarn("Scheduler", "%s bind ignored: fn is %s", lane.name, type(fn))
        return nil
    end

    opts = opts or {}
    nextSeq = nextSeq + 1

    local interval = math.max(0, tonumber(opts.interval) or 0)
    local t = {
        fn         = fn,
        name       = tostring(opts.name or ("task#" .. nextSeq)),
        priority   = tonumber(opts.priority) or DEFAULT_PRIORITY,
        interval   = interval,
        deferrable = opts.deferrable == true,
        seq        = nextSeq,
        alive      = true,
        cost       = 0,
        strikes    = 0,
        starved    = 0,
        nextRun    = 0,
    }

    -- phase-offset equal-interval tasks so they land on different frames instead of stacking on one
    if interval > 0 then
        t.nextRun = os.clock() + (lane.phase / PHASE_SLOTS) * interval
        lane.phase = (lane.phase + 1) % PHASE_SLOTS
    end

    lane.tasks[#lane.tasks + 1] = t
    lane.live = lane.live + 1
    lane.dirty = true
    attach(lane)

    return newHandle(lane, t)
end

function M.render(fn, opts) return M.bind("render", fn, opts) end
function M.heartbeat(fn, opts) return M.bind("heartbeat", fn, opts) end
function M.stepped(fn, opts) return M.bind("stepped", fn, opts) end

-- milliseconds in, seconds internally: os.clock deals in seconds but a frame budget is only ever discussed in ms
function M.setBudget(ms)
    local value = tonumber(ms)
    budget = (value and value > 0) and (value / 1000) or nil
end

function M.getBudget()
    return budget and (budget * 1000) or nil
end

function M.setPaused(on)
    paused = on == true
end

function M.isPaused()
    return paused
end

-- cost sampling rides along for free while a budget is set; this turns it on for read-only consumers like the perf hud
function M.setProfiling(on)
    profiling = on == true
end

function M.stats()
    local out = { budgetMs = M.getBudget(), paused = paused, lanes = {} }
    for name, lane in pairs(lanes) do
        out.lanes[name] = {
            tasks     = lane.live,
            connected = lane.conn ~= nil,
            spentMs   = lane.spent * 1000,
            dropped   = lane.dropped,
        }
    end
    return out
end

function M.stop()
    for _, lane in pairs(lanes) do
        detach(lane)
        for i = 1, #lane.tasks do
            lane.tasks[i].alive = false
        end
        table.clear(lane.tasks)
        lane.live = 0
        lane.dirty = false
        lane.running = false
    end
end

return M

end)
__bundle_register("UI/LocalizePatch", function(require, _LOADED, __bundle_register, __bundle_modules)
-- idempotent monkey-patch of obsidian's public surface routing every user-facing string through Localize.T at UI build time
local Jobs     = require("Utility/Jobs")
local Localize = require("Utility/Localize")
local Log      = require("Utility/Log")

local M = {}

local T = Localize.T

local function tStr(v)
    if type(v) == "string" then return T(v) end
    return v
end

-- mutating info tables in place is safe: Library:Validate clones into a fresh output table
local TEXT_FIELDS = {
    "Text", "Tooltip", "Title", "Description", "Placeholder",
    "DisabledTooltip", "Suffix", "Prefix", "Footer", "Name",
}

-- only flag translations long enough to visibly overflow obsidian's fixed-width rows
local LONG_TEXT_FLOOR = 28      -- characters; below this, no risk of overflow
local LONG_TEXT_RATIO = 1.3     -- translated/original; above this it expanded

local function translateInfo(info)
    if type(info) ~= "table" then return info end
    -- snapshot the label pre-translation so length growth can be compared for the auto-tooltip
    local origText = type(info.Text) == "string" and info.Text or nil
    for _, key in ipairs(TEXT_FIELDS) do
        local v = info[key]
        if type(v) == "string" then info[key] = T(v) end
    end
    -- dialog footer buttons carry their visible label in each button's Title
    if type(info.FooterButtons) == "table" then
        for _, btn in pairs(info.FooterButtons) do
            if type(btn) == "table" then
                if type(btn.Title) == "string" then btn.Title = T(btn.Title) end
            end
        end
    end
    -- long translations get an auto-tooltip: paired with the TextTruncate sweep, hover reveals the full label
    if origText
        and type(info.Text) == "string"
        and info.Text ~= origText
        and #info.Text > LONG_TEXT_FLOOR
        and #info.Text > #origText * LONG_TEXT_RATIO
        and (info.Tooltip == nil or info.Tooltip == "")
    then
        info.Tooltip = info.Text
    end
    -- dropdown Values deliberately untranslated: callbacks compare against literal english strings
    return info
end

local funcsPatched = false
local function patchFuncs(groupboxLike)
    if funcsPatched then return end
    local mt = getmetatable(groupboxLike)
    if not mt or type(mt.__index) ~= "table" then
        Log.warn("[Cerberus/LocalizePatch] patchFuncs: missing metatable on groupbox")
        return
    end
    local Funcs = mt.__index

    -- strict shape (self, Idx, Info): Idx is a state key, never user-visible — translate the info table only
    local function wrapStrict(name)
        local orig = Funcs[name]
        if type(orig) ~= "function" then return end
        Funcs[name] = function(self, idx, info, ...)
            if type(info) == "table" then translateInfo(info) end
            return orig(self, idx, info, ...)
        end
    end

    for _, name in ipairs({
        "AddToggle", "AddSlider", "AddDropdown", "AddInput",
        "AddKeyPicker", "AddColorPicker", "AddCheckbox",
        "AddViewport", "AddImage", "AddVideo",
    }) do
        wrapStrict(name)
    end

    -- loose shape: AddLabel/AddButton take (text,...), (info) or (idx, info) — disambiguate by the second arg's type
    local function wrapLoose(name)
        local orig = Funcs[name]
        if type(orig) ~= "function" then return end
        Funcs[name] = function(self, first, second, ...)
            if type(first) == "table" then
                translateInfo(first)
            elseif type(second) == "table" then
                -- (idx, info) shape: first is the state key, leave it alone
                translateInfo(second)
            elseif type(first) == "string" then
                first = T(first)
            end
            return orig(self, first, second, ...)
        end
    end

    wrapLoose("AddLabel")
    wrapLoose("AddButton")

    funcsPatched = true
