                    "Showing %s. %d phrases translated, %d waiting.",
                    s.locale:upper(), s.cached, s.queued
                ))
            end
            renderStatus()
            LangGroup:AddButton({
                Text = "Refresh Translations",
                Tooltip = "Throw out the saved translations and download them again. Use if some text looks wrong.",
                Func = function()
                    Localize.clearCache()
                    Library:Notify("Refreshing translations…", 4)
                end,
            })
            Jobs.interval(3, function(job)
                if not statusLabel or not statusLabel.SetText then
                    job:Cancel()
                    return
                end
                renderStatus()
            end, { name = "LocalizeStatus" })
        else
            LangGroup:AddLabel("Showing English. Click below to pick another language.", true)
        end

        -- drop the saved selection so the picker shows next launch, then unload so the user can re-run and choose
        LangGroup:AddButton({
            Text = "Change Language",
            DoubleClick = true,
            Tooltip = "Pick a different language. This will close Cerberus so you can run it again and choose.",
            Func = function()
                LanguagePicker.clear()
                Library:Notify("Language reset. Cerberus will close — run it again to pick a new language.", 5)
                task.wait(0.4)
                Library:Unload()
                Globals.set("__rbx_runtime_active", false)
            end,
        })

    end

    Library.ToggleKeybind = Options.MenuKeybind
    ThemeManager:SetLibrary(Library)
    SaveManager:SetLibrary(Library)
    SaveManager:IgnoreThemeSettings()
    -- the dashboard switch is a per-user privacy choice, so a shared config must never flip it
    SaveManager:SetIgnoreIndexes({ "Menu_Dashboard" })
    -- auto spin spends spins and overwrites a slot, so it only ever starts from a click, never from a loaded config
    SaveManager:SetIgnoreIndexes({ "VL_SpinStyle", "VL_SpinAbility" })
    ThemeManager:SetFolder("Cerberus")
    SaveManager:SetFolder("Cerberus/" .. References.gameName)
    SaveManager:SetSubFolder("Configurations")
    if SaveManager.SetConfigSecrets then
        SaveManager:SetConfigSecrets(ConfigSecrets)
    end
    SaveManager:BuildConfigSection(Tabs.Settings)
    ThemeManager:ApplyToTab(Tabs.Settings)
    -- slate is the shipped look; a saved default theme (applied inside ApplyToTab) wins
    local _, hasSavedTheme = ThemeManager:GetDefaultTheme()
    if not hasSavedTheme then
        ThemeManager:ApplyTheme("Slate")
    end
end

end)
