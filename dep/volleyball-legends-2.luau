local function makeButton(parent, opts)
    local btn = New("TextButton", {
        Name = opts.name, Text = opts.text, AutoButtonColor = false,
        Font = Enum.Font.GothamSemibold, TextSize = 13, TextColor3 = opts.textColor,
        BackgroundColor3 = opts.idle, BackgroundTransparency = opts.idleAlpha or 0,
        BorderSizePixel = 0, Size = opts.size, ZIndex = opts.zIndex or 22, Parent = parent,
