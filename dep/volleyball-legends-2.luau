    } },
    { section = "Visuals", tabs = {
        { key = "ESP",    label = "ESP",    icon = "eye",    configKeys = { "ESP", "Visuals", "BallVisuals" } },
        { key = "Camera", label = "Camera", icon = "camera", configKeys = { "Visuals", "PlayerUtils", "Misc" } },
    } },
    { section = "Misc", tabs = {
        { key = "Server", label = "Server", icon = "server",   configKeys = { "Misc", "Subplaces", "Webhook" } },
        { key = "Fun",    label = "Fun",    icon = "joystick", configKeys = { "Fun" } },
    } },
    { key = "Settings", label = "Settings", icon = "settings" },
}

-- what runs: ascending mountOrder (UISettings first so theme/save hooks land before features); configKeys all-false skips the unit, none = always runs
M.mounts = {
    { key = "Home",       mount = TabHome,       mountOrder = 2,  configKeys = { "Home" } },
    { key = "Volleyball", mount = TabVolleyball, mountOrder = 3,  configKeys = { "AutoPlay", "Assist", "Progress" } },
    { key = "Player",     mount = TabPlayer,     mountOrder = 5,  captureAs = "Movement", configKeys = { "Movement", "PlayerUtils", "Visuals" } },
    { key = "ESP",        mount = TabESP,        mountOrder = 7,  configKeys = { "ESP", "BallVisuals" } },
    { key = "Misc",       mount = TabMisc,       mountOrder = 8,  configKeys = { "Misc" } },
    -- after Misc so Subplaces sits under Server Panel and Streamer Mode on the Server tab
    { key = "Navigation", mount = TabNavigation, mountOrder = 9,  configKeys = { "Subplaces" } },
    -- the webhook box sits at the bottom of the Server tab's right column; the mount keeps its historic key
    { key = "Auto",       mount = TabAuto,       mountOrder = 10, configKeys = { "Webhook" } },
    { key = "Fun",        mount = TabFun,        mountOrder = 11, configKeys = { "Fun" } },
    { key = "UISettings", mount = TabUISettings, mountOrder = 1 },
}

local function isEnabled(def, Config)
    if not def.configKeys then return true end
    if type(Config) ~= "table" then return true end
    for _, key in ipairs(def.configKeys) do
        if Config[key] then return true end
    end
    return false
end

function M.buildTabs(Window, Config)
    local Tabs = {}
    for _, entry in ipairs(M.layout) do
        if entry.section then
            local enabled = {}
            for _, def in ipairs(entry.tabs) do
                if isEnabled(def, Config) then enabled[#enabled + 1] = def end
            end
            if #enabled > 0 then
                local section = Window:AddSection(entry.section)
                for _, def in ipairs(enabled) do
                    Tabs[def.key] = section:AddTab(def.label, def.icon)
                end
            end
        elseif isEnabled(entry, Config) then
            Tabs[entry.key] = Window:AddTab(entry.label, entry.icon)
        end
    end
    return Tabs
end

function M.mountAll(ctx, Debug)
    local ordered = {}
    for _, def in ipairs(M.mounts) do ordered[#ordered + 1] = def end
    table.sort(ordered, function(a, b)
        return (a.mountOrder or math.huge) < (b.mountOrder or math.huge)
    end)

    local captured = {}
    for _, def in ipairs(ordered) do
        if isEnabled(def, ctx.Config) then
            Debug:LoadModule(def.key, function()
                local result = def.mount(ctx)
                if def.captureAs then captured[def.captureAs] = result end
            end)
        end
    end
    return captured
end

return M

end)
__bundle_register("Tabs/UISettings", function(require, _LOADED, __bundle_register, __bundle_modules)
-- settings tab: menu/keybinds/DPI/topbar, save manager, theme and language controls
local Globals        = require("Utility/Globals")
local Jobs           = require("Utility/Jobs")
local Localize       = require("Utility/Localize")
local StartGuide     = require("UI/StartGuide")
local LanguagePicker = require("Auth/LanguagePicker")

return function(ctx)
    local Tabs         = ctx.Tabs
    local Library      = ctx.Library
    local Options      = Library.Options
    local ThemeManager = ctx.ThemeManager
    local SaveManager  = ctx.SaveManager
    local References   = ctx.References
    local Services     = ctx.Services
    local ConfigSecrets     = ctx.ConfigSecrets

    if not Tabs.Settings then return end

    local function getAutoShowDefault()
        local default = true
        if not (isfile and readfile and Services.HttpService and References.player) then
            return default
        end
        local settingsPath = string.format("Cerberus/%s/settings/Configurations", References.gameName)
        local localPlayerName = References.player.Name

        local function readJson(path)
            if not isfile(path) then return nil end
            local okRead, raw = pcall(readfile, path)
            if not okRead or type(raw) ~= "string" then return nil end
            local okDecode, decoded = pcall(Services.HttpService.JSONDecode, Services.HttpService, raw)
            if not okDecode or type(decoded) ~= "table" then return nil end
            return decoded
        end

        local function readToggleFromConfig(configName)
            if type(configName) ~= "string" or configName == "" or configName == "none" then return nil end
            local decoded = readJson(settingsPath .. "/" .. configName .. ".json")
            if not decoded or type(decoded.objects) ~= "table" then return nil end
            for _, obj in ipairs(decoded.objects) do
                if type(obj) == "table" and obj.type == "Toggle" and obj.idx == "Menu_AutoShow" then
                    if type(obj.value) == "boolean" then return obj.value end
                    return nil
                end
            end
            return nil
        end

        local configName
        local playerAutoload = readJson(settingsPath .. "/autoload_players.json")
        if playerAutoload and type(playerAutoload[localPlayerName]) == "string" and playerAutoload[localPlayerName] ~= "" then
            configName = playerAutoload[localPlayerName]
        end
        if not configName then
            local globalAutoloadPath = settingsPath .. "/autoload.txt"
            if isfile(globalAutoloadPath) then
                local okRead, raw = pcall(readfile, globalAutoloadPath)
                if okRead and type(raw) == "string" then
                    local trimmed = raw:gsub("^%s+", ""):gsub("%s+$", "")
                    if trimmed ~= "" then configName = trimmed end
                end
            end
        end

        local value = readToggleFromConfig(configName)
        if type(value) == "boolean" then return value end
        return default
    end

    local function getAutoShowState()
        if not (isfile and readfile and Services.HttpService and References.gameName) then
            return getAutoShowDefault()
        end
        local stateFile = string.format("Cerberus/%s/settings/autoshow_state.json", References.gameName)
        if not isfile(stateFile) then
            return getAutoShowDefault()
        end
        local okRead, raw = pcall(readfile, stateFile)
        if not okRead or type(raw) ~= "string" then
            return getAutoShowDefault()
        end
        local okDecode, decoded = pcall(Services.HttpService.JSONDecode, Services.HttpService, raw)
        if not okDecode or type(decoded) ~= "table" then
            return getAutoShowDefault()
        end
        if type(decoded.autoshow) == "boolean" then
            return decoded.autoshow
        end
        return getAutoShowDefault()
    end

    local function saveAutoShowState(value)
        if not (writefile and Services.HttpService and References.gameName) then return end
        local settingsDir = string.format("Cerberus/%s/settings", References.gameName)
        if makefolder and not isfolder(settingsDir) then
            pcall(function() makefolder(settingsDir) end)
        end
        local stateFile = string.format("Cerberus/%s/settings/autoshow_state.json", References.gameName)
        local data = { autoshow = value }
        local okEncode, encoded = pcall(Services.HttpService.JSONEncode, Services.HttpService, data)
        if okEncode and type(encoded) == "string" then
            pcall(function() writefile(stateFile, encoded) end)
        end
    end

    local AutoShowDefault = getAutoShowState()

    local function autoExecuteStateFile()
        return string.format("Cerberus/%s/settings/autoexecute_state.json", References.gameName)
    end

    local function getAutoExecuteState()
        if not (isfile and readfile and Services.HttpService and References.gameName) then
            return true
        end
        local stateFile = autoExecuteStateFile()
        if not isfile(stateFile) then return true end
        local okRead, raw = pcall(readfile, stateFile)
        if not okRead or type(raw) ~= "string" then return true end
        local okDecode, decoded = pcall(Services.HttpService.JSONDecode, Services.HttpService, raw)
        if not okDecode or type(decoded) ~= "table" then return true end
        if type(decoded.autoexecute) == "boolean" then return decoded.autoexecute end
        return true
    end

    local function saveAutoExecuteState(value)
        if not (writefile and Services.HttpService and References.gameName) then return end
        local settingsDir = string.format("Cerberus/%s/settings", References.gameName)
        if makefolder and not isfolder(settingsDir) then
            pcall(function() makefolder(settingsDir) end)
        end
        local data = { autoexecute = value }
        local okEncode, encoded = pcall(Services.HttpService.JSONEncode, Services.HttpService, data)
        if okEncode and type(encoded) == "string" then
            pcall(function() writefile(autoExecuteStateFile(), encoded) end)
        end
    end

    local AutoExecuteDefault = getAutoExecuteState()

    local MenuGroup = Tabs.Settings:AddLeftGroupbox("Menu", "wrench")
    MenuGroup:AddToggle("Menu_AutoShow", {
        Default = AutoShowDefault,
        Text = "Auto Show UI On Load",
        Callback = function(value)
            saveAutoShowState(value)
        end,
    })
    MenuGroup:AddToggle("Menu_AutoExecute", {
        Default = AutoExecuteDefault,
        Text = "Auto Execute",
        Tooltip = "Re-run Cerberus after a teleport",
        Callback = function(value)
            saveAutoExecuteState(value)
        end,
    })
    MenuGroup:AddToggle("KeybindMenuOpen", {
        Default = Library.KeybindFrame.Visible,
        Text = "Open Keybind Menu",
        Callback = function(value) Library.KeybindFrame.Visible = value end,
    })
    if ctx.Topbar then
        local topbarToggle = MenuGroup:AddToggle("Menu_Topbar", {
            Default = true,
            Text = "Show Topbar",
            Tooltip = "FPS, ping and clock at the top",
            Callback = function(value) ctx.Topbar:SetVisible(value) end,
        })
        -- toggles don't fire on creation, so the default is applied by hand; a loaded config re-fires the callback
        ctx.Topbar:SetVisible(topbarToggle.Value)
    end
    MenuGroup:AddDropdown("NotificationSide", {
        Values = { "Left", "Right" }, Default = "Right", Text = "Notification Side",
        Callback = function(Value) Library:SetNotifySide(Value) end,
    })
    MenuGroup:AddDropdown("DPIDropdown", {
        Values = { "50%", "75%", "100%", "125%", "150%", "175%", "200%" },
        Default = "100%", Text = "DPI Scale",
        Callback = function(Value)
            Value = Value:gsub("%%", "")
            Library:SetDPIScale(tonumber(Value))
        end,
    })
    MenuGroup:AddDivider()
    -- english-only, same as the first-run offer, since the guide's copy is not translated
    if StartGuide.isEnglish() then
        MenuGroup:AddButton({
            Text = "Replay Start Guide",
            Tooltip = "Watch the quick tour of Cerberus again.",
            Func = function()
                Jobs.spawn(function() StartGuide.run(ctx) end, { name = "StartGuide.replay" })
            end,
        })
    end
    MenuGroup:AddLabel("Menu bind"):AddKeyPicker("MenuKeybind", { Default = "LeftAlt", NoUI = true })
    MenuGroup:AddButton("Unload", function()
        Library:Unload()
        Globals.set("__rbx_runtime_active", false)
    end)

    -- hard reset nukes the entire Cerberus directory; behind a double-click, no undo
    MenuGroup:AddButton({
        Text = "Hard Reset Cerberus",
        DoubleClick = true,
        Risky = true,
        Tooltip = "Erase everything Cerberus has saved on your computer (settings, configs, themes, language). Cannot be undone.",
        Func = function()
            local function deepDelete(path)
                if isfolder and isfolder(path) and listfiles then
                    local ok, list = pcall(listfiles, path)
                    if ok and type(list) == "table" then
                        for _, child in ipairs(list) do
                            deepDelete(child)
                        end
                    end
                    if delfolder then pcall(delfolder, path) end
                elseif isfile and isfile(path) and delfile then
                    pcall(delfile, path)
                end
            end
            deepDelete("Cerberus")
            Library:Notify("Cerberus folder deleted. The script will now close.", 5)
            task.wait(0.4)
            Library:Unload()
            Globals.set("__rbx_runtime_active", false)
        end,
    })

    do
        local locale = Localize.locale()
        local LangGroup = Tabs.Settings:AddLeftGroupbox("Language", "languages")

        local statusLabel
        if locale ~= "en" then
            -- never pass the dynamic status string through AddLabel: LocalizePatch would cache-translate it, bumping the counter it displays and leaking one entry per session; empty initial text no-ops T(), then SetText bypasses the patch
            statusLabel = LangGroup:AddLabel("", true)
            local function renderStatus()
                local s = Localize.stats()
