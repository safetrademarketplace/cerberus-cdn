local Api        = require("Api")
local Errors     = require("Api/Ball/Errors")
local Physics    = require("Api/Ball/Physics")
local Trajectory = require("Api/Ball/Trajectory")

local EPSILON = 1e-9
local MIN_FIT_DT = 1 / 240 -- the ZAP buffer decodes several events in one frame, firing Streamed with an identical clock; a sub-frame gap would make Δv/Δt explode, so the fit only advances across a real interval
