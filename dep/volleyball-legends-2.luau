__bundle_register("Api/Match/Court", function(require, _LOADED, __bundle_register, __bundle_modules)
-- match court resolver: the net, the in/out courtlines part, the court bounds anchor and the position spots, read fresh from workspace.Map and the Courtlines/Teleport tags every call so the map streaming or rebuilding between matches is never served from a stale handle (never cache a miss, never memoize across a match)

local M = {}

-- (true, { net, courtlines, bounds, spots }) while the map exists, else (false, NO_MAP); any field may be nil mid-stream
function M.resolve(Services, Errors)
    local ws = Services.Workspace
    local collection = Services.CollectionService

    local map = ws:FindFirstChild("Map")
    if not map then return false, Errors.NO_MAP end

    -- the net GameController itself reads: workspace.Map.BallNoCollide.Net
    local net
    local ballNoCollide = map:FindFirstChild("BallNoCollide")
    if ballNoCollide then net = ballNoCollide:FindFirstChild("Net") end

    -- the court cframe anchor the game pivots maps and tethers to
    local bounds = map:FindFirstChild("Court")

    -- in/out rectangle: first Courtlines-tagged BasePart under the workspace
    local courtlines
    for _, part in ipairs(collection:GetTagged("Courtlines")) do
        if part:IsA("BasePart") and part:IsDescendantOf(ws) then
            courtlines = part
            break
        end
    end

    -- position spots: Teleport-tagged parts carrying a Team index and a position number in the name
    local spots = {}
    for _, part in ipairs(collection:GetTagged("Teleport")) do
        if part:IsA("BasePart") and part:IsDescendantOf(ws) then
            local team = part:GetAttribute("Team")
            local position = tonumber(string.match(part.Name, "%d+"))
            if team ~= nil and position ~= nil then
                spots[#spots + 1] = { part = part, team = team, position = position }
            end
        end
    end

    return true, { net = net, courtlines = courtlines, bounds = bounds, spots = spots }
end

return M

end)
__bundle_register("Api/Net", function(require, _LOADED, __bundle_register, __bundle_modules)
-- net api: the game's knit bus and module access, the only code in the fork that names a service, controller or game module; calls go through the game's own service proxies so the wire shape always matches the game's, and listeners are reaped by the api's maid
local Api    = require("Api")
local Errors = require("Api/Net/Errors")
local Policy = require("Api/Net/Policy")

-- a server that never answers must not hang the caller's job forever
local CALL_TIMEOUT = 20

local M = {}

function M.new(ctx)
    local base     = Api.define("Net", ctx)
    local Services = ctx.Services
    local maid     = base.maid

    local roots = {
        ReplicatedStorage = Services.ReplicatedStorage,
        ReplicatedFirst   = Services.ReplicatedFirst,
        Workspace         = Services.Workspace,
    }

    -- cached by its module instance; a miss is never remembered because Packages can stream in after we boot
    local knitInst, knitValue
    local function knit()
        if knitInst and knitInst.Parent then return true, knitValue end
        knitInst, knitValue = nil, nil
        local packages = Services.ReplicatedStorage:FindFirstChild("Packages")
        local inst = packages and packages:FindFirstChild("Knit")
        if not (inst and inst:IsA("ModuleScript")) then return false, Errors.NO_KNIT end
        local ok, value = pcall(require, inst)
        if not ok or type(value) ~= "table" then
            base.warn("could not load knit: %s", tostring(value))
            return false, Errors.NO_KNIT
        end
        knitInst, knitValue = inst, value
        return true, value
    end

    local function started(k)
        local ok, status = pcall(function() return k.OnStart():getStatus() end)
        return ok and status == "Resolved"
    end

    local function isReady()
        local ok, k = knit()
        return ok and started(k)
    end

    local function controller(name)
        if type(name) ~= "string" then return false, Errors.BAD_ARGS end
        local ok, k = knit()
        if not ok then return false, k end
        if not started(k) then return false, Errors.NOT_STARTED end
        local found, value = pcall(k.GetController, name)
        if not found or type(value) ~= "table" then return false, Errors.NO_CONTROLLER end
        return true, value
    end

    -- knit caches each proxy itself, so asking again is a table lookup
    local function service(name)
        if type(name) ~= "string" then return false, Errors.BAD_ARGS end
        local ok, k = knit()
        if not ok then return false, k end
        if not started(k) then return false, Errors.NOT_STARTED end
        local found, value = pcall(k.GetService, name)
        if not found or type(value) ~= "table" then return false, Errors.NO_SERVICE end
        return true, value
    end

    -- kind is "method" (a remote function), "signal" (a remote event) or "property" (a remote property)
    local function member(serviceName, memberName, kind)
        if type(memberName) ~= "string" then return false, Errors.BAD_ARGS end
        local ok, svc = service(serviceName)
        if not ok then return false, svc end
        local okIndex, value = pcall(function() return svc[memberName] end)
        if not okIndex or value == nil then return false, Errors.NO_MEMBER end
        local isMethod = type(value) == "function"
        local isSignal = type(value) == "table" and type(value.Connect) == "function" and type(value.Fire) == "function"
        local isProperty = type(value) == "table" and type(value.Observe) == "function" and type(value.Get) == "function"
        if (kind == "method" and not isMethod) or (kind == "signal" and not isSignal)
            or (kind == "property" and not isProperty) then
            return false, Errors.WRONG_KIND
        end
        return true, value, svc
    end

    local function refused(serviceName, memberName, allowProtected)
        if Policy.isBlocked(serviceName, memberName) then return Errors.BLOCKED end
        if not allowProtected and Policy.isProtected(serviceName, memberName) then return Errors.PROTECTED end
        return nil
    end

    -- yields until the server answers, so run it inside a job; (true, ...server returns) or (false, err)
    local function callWith(allowProtected, serviceName, method, ...)
        local stop = refused(serviceName, method, allowProtected)
        if stop then return false, stop end
        local ok, fn, svc = member(serviceName, method, "method")
        if not ok then return false, fn end
        local sent, promise = pcall(fn, svc, ...)
        if not sent then
            base.warn("call %s.%s failed: %s", serviceName, method, tostring(promise))
            return false, Errors.SEND_FAILED
        end
        if type(promise) ~= "table" or type(promise.await) ~= "function" then
            return true, promise
        end
        if type(promise.timeout) == "function" then promise = promise:timeout(CALL_TIMEOUT) end
        local result = table.pack(promise:await())
        if result[1] then return true, table.unpack(result, 2, result.n) end
        local reason = tostring(result[2])
        if string.find(reason, "Timed out", 1, true) or string.find(reason, "TimedOut", 1, true) then
            base.warn("call %s.%s timed out", serviceName, method)
            return false, Errors.TIMED_OUT
        end
        base.warn("call %s.%s rejected: %s", serviceName, method, reason)
        return false, Errors.REJECTED
    end

    -- the same request without waiting for the answer, the way the game sends its own hits; a rejection is only logged
    local function sendWith(allowProtected, serviceName, method, ...)
        local stop = refused(serviceName, method, allowProtected)
        if stop then return false, stop end
        local ok, fn, svc = member(serviceName, method, "method")
        if not ok then return false, fn end
        local sent, promise = pcall(fn, svc, ...)
        if not sent then
            base.warn("send %s.%s failed: %s", serviceName, method, tostring(promise))
            return false, Errors.SEND_FAILED
        end
        if type(promise) == "table" and type(promise.catch) == "function" then
            promise:catch(function(err) base.warn("send %s.%s rejected: %s", serviceName, method, tostring(err)) end)
        end
        return true
    end

    local function fireWith(allowProtected, serviceName, signalName, ...)
        local stop = refused(serviceName, signalName, allowProtected)
        if stop then return false, stop end
        local ok, signal = member(serviceName, signalName, "signal")
        if not ok then return false, signal end
        local sent, err = pcall(signal.Fire, signal, ...)
        if not sent then
            base.warn("fire %s.%s failed: %s", serviceName, signalName, tostring(err))
            return false, Errors.SEND_FAILED
        end
        return true
    end

    -- the handle's Destroy matters: Utility/Maid warns and skips any table task without one
    local function track(conn)
        local id = maid and maid:GiveTask(conn) or nil
        local handle = {}
        function handle:Disconnect()
            if id then
                maid[id] = nil
                id = nil
            elseif conn then
                pcall(conn.Disconnect, conn)
            end
            conn = nil
        end
        handle.Destroy = handle.Disconnect
        return handle
    end

    local function on(serviceName, signalName, fn)
        if type(fn) ~= "function" then return nil, Errors.BAD_ARGS end
        local ok, signal = member(serviceName, signalName, "signal")
        if not ok then return nil, signal end
        local okConn, conn = pcall(signal.Connect, signal, fn)
        if not okConn or conn == nil then return nil, Errors.SEND_FAILED end
        return track(conn)
    end

    -- (false, NOT_READY) until the server's first value has replicated
    local function get(serviceName, propertyName)
        local ok, prop = member(serviceName, propertyName, "property")
        if not ok then return false, prop end
        local okReady, ready = pcall(prop.IsReady, prop)
        if not okReady or not ready then return false, Errors.NOT_READY end
        local okGet, value = pcall(prop.Get, prop)
        if not okGet then return false, Errors.NOT_READY end
        return true, value
    end

    -- fires now with the current value once it is ready, then on every change
    local function observe(serviceName, propertyName, fn)
        if type(fn) ~= "function" then return nil, Errors.BAD_ARGS end
        local ok, prop = member(serviceName, propertyName, "property")
        if not ok then return nil, prop end
        local okConn, conn = pcall(prop.Observe, prop, fn)
        if not okConn or conn == nil then return nil, Errors.SEND_FAILED end
        return track(conn)
    end

    -- data modules by dotted path from a service root ("ReplicatedStorage.Configuration.Game"); cached by instance, misses never remembered
    local modules = {}
    local function module(path)
        if type(path) ~= "string" or path == "" then return false, Errors.BAD_ARGS end
        local hit = modules[path]
        if hit and hit.inst.Parent then return true, hit.value end
        modules[path] = nil
        local node
        for part in string.gmatch(path, "[^%.]+") do
            if node == nil then
                node = roots[part]
            else
                node = node:FindFirstChild(part)
            end
            if not node then return false, Errors.NO_MODULE end
        end
        if not (node and node:IsA("ModuleScript")) then return false, Errors.NO_MODULE end
        local ok, value = pcall(require, node)
        if not ok then
            base.warn("could not load %s: %s", path, tostring(value))
            return false, Errors.NO_MODULE
        end
        modules[path] = { inst = node, value = value }
        return true, value
    end

    if maid then
        maid:GiveTask(function()
            table.clear(modules)
            knitInst, knitValue = nil, nil
        end)
    end

    base.log("net api ready (%s)", isReady() and "knit running" or "knit not started yet")

    return {
        Errors = Errors,

        isReady    = isReady,
        knit       = knit,
        controller = controller,
        service    = service,

        call    = function(serviceName, method, ...) return callWith(false, serviceName, method, ...) end,
        send    = function(serviceName, method, ...) return sendWith(false, serviceName, method, ...) end,
        fire    = function(serviceName, signalName, ...) return fireWith(false, serviceName, signalName, ...) end,
        on      = on,
        get     = get,
        observe = observe,
        module  = module,

        -- protected remotes (spending, account, travel) only through these; blocked ones refuse even here
        callAllowed = function(serviceName, method, ...) return callWith(true, serviceName, method, ...) end,
        sendAllowed = function(serviceName, method, ...) return sendWith(true, serviceName, method, ...) end,
        fireAllowed = function(serviceName, signalName, ...) return fireWith(true, serviceName, signalName, ...) end,
        isProtected = Policy.isProtected,
        isBlocked   = Policy.isBlocked,
    }
end

return M

end)
__bundle_register("Api/Net/Policy", function(require, _LOADED, __bundle_register, __bundle_modules)
-- net policy: pure-data remote sets; blocked ones are never sent (robux, self-reporting, admin, telemetry), protected ones spend currency, change the account or move the player, so only the explicit Allowed calls reach them
local blockedServices = {
    BanService = true,
    ConsoleService = true,
    MonetizationService = true,
    TelemetryService = true,
}

local blockedMembers = {
    GameService = { RequestBan = true },
}

local protectedServices = {
    CodeService = true,
    CrateService = true,
    EasterService = true,
    JerseyService = true,
    LiveTournamentService = true,
    NotificationService = true,
    PackService = true,
    PartyService = true,
    PlayFabMatchmakingService = true,
    PodService = true,
    RankedService = true,
    SettingsService = true,
    ShopService = true,
    SlotService = true,
    StreakService = true,
}

local protectedMembers = {
    AbilityService = {
        InvestUnlockPoints = true, Roll = true, SelectChance = true, SelectSlot = true,
        ToggleLockSlot = true, UnlockAbility = true,
    },
    ChallengeService = { Reset = true },
    DailyRewardService = { RerollDailyTask = true },
    GameService = {
        CancelStreakBuyback = true, JoinTrainingGamemode = true, RequestJoin = true, RequestTrainingJoin = true,
        ReturnPartyToLobby = true, ReturnToLobby = true, SetFlag = true, SkipTutorial = true,
    },
    IdleService = { Rejoin = true },
    InventoryService = { SellDuplicates = true, Use = true },
    MasteryService = { RequestInvest = true, RequestSkipItemRedeem = true },
    PlayerInspectService = { SetInspectField = true },
    SeasonService = { RequestCurrencyRebirth = true, RequestRebirthReward = true },
    SpectateService = { RequestSpectateMatchId = true, RequestToSpectate = true },
    StyleService = {
        ChangeRankedSlot = true, InvestUnlockPoints = true, Roll = true, SelectChance = true, SelectSlot = true,
        ToggleLockSlot = true, ToggleTwin = true, UnlockStyle = true,
    },
}

local function inSet(services, members, service, member)
    if services[service] then return true end
    local set = members[service]
    return set ~= nil and set[member] == true
end

return {
    isBlocked = function(service, member)
        return inSet(blockedServices, blockedMembers, service, member)
    end,
    isProtected = function(service, member)
        return inSet(protectedServices, protectedMembers, service, member)
    end,
}

end)
