    dismissBtn.AutoButtonColor = false
    dismissBtn.BackgroundColor3 = BG
    dismissBtn.FontFace = FONT
    dismissBtn.Text = string.format("Dismiss in %ds", DISMISS_DELAY)
    dismissBtn.TextColor3 = TEXT
    dismissBtn.TextTransparency = 0.5
    dismissBtn.TextSize = 14
    dismissBtn.AnchorPoint = Vector2.new(1, 1)
