    return run("value", element.SetValue, element, value)
end

function M.values(element, list)
    if not (element and element.SetValues) then return false end
    return run("values", element.SetValues, element, list)
end

function M.visible(element, on)
    if not (element and element.SetVisible) then return false end
    return run("visible", element.SetVisible, element, on)
end

