            local okMine, mine = Match.myTeam()
            if not okMine then return nil, nil end
            local okTeams, list = Match.teams()
            if not okTeams then return mine, nil end
            for _, team in ipairs(list) do
                if team.Name ~= mine.Name then return mine, team end
            end
            return mine, nil
        end

        local function scoreOf(team)
            if team == nil then return nil end
            local ok, n = Match.score(team)
            if ok and type(n) == "number" then return math.floor(n) end
            return nil
        end

        local function modeText()
            local ok, c = Match.context()
            if not ok or type(c) ~= "table" then return nil end
            -- match types read like "Casual-Twos"
            local parts = {}
            for _, value in ipairs({ c.gamemode, c.matchType }) do
                local text = type(value) == "string" and (value:gsub("%-", " ")) or ""
                if text ~= "" and text ~= parts[1] then parts[#parts + 1] = text end
            end
            if #parts == 0 then return nil end
            if #parts == 1 then return parts[1] end
            return ("%s (%s)"):format(parts[1], parts[2])
        end

        local function onEnded(payload)
            local mine, theirs = sides()
            local myScore, theirScore = scoreOf(mine), scoreOf(theirs)
            local flags = type(payload) == "table" and payload.Flags or nil
            local won
            -- the results screen shows a loss for anything but Flags.Won == true (Screens.Statistics:371,380,493,511)
            if type(flags) == "table" then
                won = flags.Won == true
            elseif myScore and theirScore and myScore ~= theirScore then
                won = myScore > theirScore
            else
                return
            end
            if not won and bus.getOption("wins", false) == true then return end

            -- 0 – 0 is never a final score, only teams already reset for the next match
            local scored = myScore and theirScore and (myScore + theirScore) > 0
            local fields = {}
            local mode = modeText()
            if mode then fields[#fields + 1] = { name = "Mode", value = mode, inline = true } end
            if mine then fields[#fields + 1] = { name = "Team", value = tostring(mine.Name), inline = true } end
            bus.emit({
                title       = won and "Match Won" or "Match Lost",
                description = scored and ("Score: %d – %d"):format(myScore, theirScore) or nil,
                fields      = fields,
            })
