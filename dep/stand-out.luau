__bundle_register("Api/Combat/Info", function(require, _LOADED, __bundle_register, __bundle_modules)
-- combat skill info: a skill's ranking data read from the Skills module with its .Stands[stand] entry over the base, each field filled only where the module or the recon proves it and nil otherwise
-- damage.md §1.5 (StandInfoCatalog.lua:2260-2298, Skills.lua:6800-7039): what the move text alone tells about aim, blocks and projectiles
local RECON = {
    Barrage                 = { needsAim = false },
    ["Red Pull"]            = { needsAim = true, unblockable = false },
    ["Flaming Grasp"]       = { needsAim = true, unblockable = true },
    ["Crossfire Hurricane"] = { needsAim = true, projectile = true },
    ["Red Bind"]            = { needsAim = true, unblockable = true },
    ["Flame Breath"]        = { needsAim = false },
}

return function(S, api)
    local Errors = S.Errors

    local function list()
        local Skills = S.mod("Skills")
        local skills = Skills and Skills.skills
        return type(skills) == "table" and skills or nil
    end

    -- the raw skills[name] entry, exact name only
    function S.skillDef(name)
        local skills = list()
        if not skills or type(name) ~= "string" then return nil end
        local def = skills[name]
        return type(def) == "table" and def or nil
    end

    -- the per-stand entry wins where it sets a field (StandArchiveGuide.lua:435, HandlerHUD.lua:7946-7952)
    local function reader(def)
        local over = type(def.Stands) == "table" and def.Stands[S.standName()] or nil
        if type(over) ~= "table" then over = nil end
        return function(key)
            if over and over[key] ~= nil then return over[key] end
            return def[key]
        end
    end

    local function num(value)
        value = tonumber(value)
        if value == nil or value ~= value then return nil end
        return value
    end

    local function bool(value)
        if type(value) == "boolean" then return value end
        return nil
    end

    -- Skills:IsEXSkill (Skills.lua:8411-8420): the stand's own EXSkill flag, else the base one
    function S.isEXSkill(name)
        local def = S.skillDef(name)
        if not def then return false end
        local over = type(def.Stands) == "table" and def.Stands[S.standName()] or nil
        if type(over) == "table" and over.EXSkill ~= nil then return over.EXSkill == true end
        return def.EXSkill == true
    end

    -- a slot value may carry ";variant"; the full value is tried before the bare name, as Skills.skills is keyed
    function S.skillInfo(value)
        if type(value) ~= "string" or value == "" then return nil end
        local name = string.match(value, "^[^;]*") or value
        local def = S.skillDef(value) or S.skillDef(name)
        if not def then return nil end
        local get = reader(def)
        local recon = RECON[name] or {}

        -- HandlerHUD.lua:7947-7952: an ex move or a ShowModeCost one shows ModeCost bars, 0 when unset
        local exCost = nil
        if S.isEXSkill(name) or get("ShowModeCost") == true then exCost = num(get("ModeCost")) or 0 end

        -- the mouse-aim cast (PlayerController.lua:1044-1082) and the release-aim mode (beginAimInput, PlayerController.lua:20535-20537)
        local needsAim = recon.needsAim
        if needsAim == nil and (num(get("MouseAimRange")) or get("AimOnRelease") == true) then needsAim = true end

        local projectile = recon.projectile
        if projectile == nil and (get("ProjectileSpeed") ~= nil or get("ProjectileSize") ~= nil or get("ProjectileDuration") ~= nil) then
            projectile = true
        end

        -- Blockable (Skills.lua:84, 7374) says it outright; a chip multiplier means a block cuts the damage (Skills.lua:6807)
        local unblockable = recon.unblockable
        if unblockable == nil then
            local blockable = bool(get("Blockable"))
            if blockable ~= nil then
                unblockable = not blockable
            elseif num(get("ChipDamageMultiplier")) then
                unblockable = false
            end
        end

        local hits = num(get("Hits")) or num(get("BarrageHits"))

        return {
            name        = name,
            damage      = num(get("Damage")),
            cooldown    = num(get("Cooldown")),
            range       = num(get("Range")),
            projectile  = projectile,
            needsAim    = needsAim,
            castTime    = num(get("Windup")),
            exCost      = exCost,
            guardBreak  = bool(get("GuardBreak")),
            unblockable = unblockable,
            stun        = num(get("Stun")),
            hits        = hits,
        }
    end

    function api.skillInfo(name)
        if type(name) ~= "string" or name == "" then return false, Errors.BAD_ARGS end
        if not list() then return false, Errors.NOT_READY end
        local info = S.skillInfo(name)
        if not info then return false, Errors.NOT_FOUND end
        return true, info
    end
end

end)
__bundle_register("Api/Combat/Ex", function(require, _LOADED, __bundle_register, __bundle_modules)
-- combat ex: the ex loadout from the game's own Abilities:GetEXLoadout with refreshEXSkills' arguments and post-processing, ex access judged as hasEXAccess does, the Data.Mode bar, and the slot or name resolution resolveQueuedSkill does in ex mode
-- PlayerController.lua:21316 and HandlerHUD.lua:4926: the gauge is five bars of a fifth of Max each
local BAR_COUNT = 5
local BAR_SHARE = 0.2

return function(S, api)
    local Errors = S.Errors
    local base = S.base

    local function node(path)
        return S.Player and S.Player.node(path) or nil
    end

    -- Skills:IsKnocked (Skills.lua:8401-8404)
    function S.knocked(char)
        local hum = char and S.humanoid(char)
        return hum ~= nil and hum.Health > 0 and char:GetAttribute("PassedOut") == true
            and not char:GetAttribute("CombatLifeEnded") and not char:GetAttribute("_GripKillCommitted")
    end

    -- refreshEXSkills (PlayerController.lua:3801-3842); nil when a module or the data folders can't be reached
    function S.exLoadout(char)
        local Abilities = S.mod("Abilities")
        local Utility = S.mod("Utility")
        if not (Abilities and Utility and type(Abilities.GetEXLoadout) == "function" and type(Utility.getStandActionBinds) == "function") then
            return nil
        end
        local skillsFolder = node("Skills")
        local keybinds = node("Settings.Keybinds")
        if not (skillsFolder and keybinds) then return nil end
        -- PlayerController.lua:3803-3804: the override's definition, else the base stand's
        local def = S.standDef(char)
        -- PlayerController.lua:3809: Data.Stand first here, the reverse of the definition's order
        local stand = S.data("Stand")
        local standName = (type(stand) == "string" and stand ~= "") and stand or S.data("StandOverride")
        local okBinds, actionBinds = S.game(Utility.getStandActionBinds, Utility, keybinds)
        if not okBinds then
            base.warn("getStandActionBinds failed: %s", tostring(actionBinds))
            return nil
        end
        -- PlayerController.lua:3811-3814: true while summoned, else whether you're knocked
        local active = char:GetAttribute("Summoned") == true or S.knocked(char)
        -- PlayerController.lua:3815: GetEXLoadout(standDef, Data.SubAbility, stand, actionBinds, active, Data.Skills, Data.Settings.Keybinds)
        local ok, map, only, extra = S.game(Abilities.GetEXLoadout, Abilities, def, S.data("SubAbility"), standName, actionBinds,
            active, skillsFolder, keybinds)
        if not ok or type(map) ~= "table" then
            base.warn("GetEXLoadout failed: %s", tostring(map))
            return nil
        end
        -- PlayerController.lua:3819-3823: a locked skill never keeps a key
        local locked = def and type(def.LockedSkills) == "table" and def.LockedSkills or nil
        local binds = {}
        for key, skill in pairs(type(only) == "table" and only or {}) do
            if not (locked and locked[skill]) then binds[key] = skill end
        end
        -- PlayerController.lua:3824-3836: each slot whose value the map swaps takes that ex skill once, then the loadout's extra slots win
        local slots, taken = {}, {}
        for _, child in ipairs(skillsFolder:GetChildren()) do
            if child:IsA("ValueBase") then
                local entry = map[child.Value]
                local skill = type(entry) == "table" and entry.Skill or entry
                if type(skill) == "string" and not taken[skill] then
                    taken[skill] = true
                    slots[child.Name] = skill
                end
            end
        end
        for slot, skill in pairs(type(extra) == "table" and extra or {}) do slots[slot] = skill end
        return { def = def, map = map, binds = binds, slots = slots }
    end

    -- hasEXAccess (PlayerController.lua:3780-3799)
    function S.exAccess(char, loadout)
        if S.knocked(char) then
            local exMap = loadout.def and loadout.def.EXSkillMap
            for _, entry in pairs(type(exMap) == "table" and exMap or {}) do
                local def = S.skillDef(type(entry) == "table" and entry.Skill or entry)
                -- Skills:CanUseWhileKnocked (Skills.lua:8406-8409)
                if def and def.AllowWhileKnocked == true then return true end
            end
        end
        if char:GetAttribute("Summoned") == true then return true end
        return next(loadout.map) ~= nil or next(loadout.binds) ~= nil or next(loadout.slots) ~= nil
    end

    function S.exBar()
        local mode = tonumber(S.data("Mode")) or 0
        local max = tonumber(S.dataAttr("Mode", "Max")) or 100
        local bars = 0
        if max > 0 then bars = math.floor(math.clamp(mode / max, 0, 1) * BAR_COUNT) end
        return { mode = mode, max = max, bars = bars, barSize = max * BAR_SHARE }
    end

    -- HandlerHUD.lua:8096-8099: a move is payable when its bars fit in the gauge, or while its ActiveAttribute is on (pressing again ends it)
    function S.exPayable(name, char, bar)
        local info = S.skillInfo(name)
        local def = S.skillDef(name)
        local attr = def and def.ActiveAttribute
        if type(attr) == "string" and char:GetAttribute(attr) == true then return true end
        local cost = info and info.exCost or 0
        return bar.max > 0 and cost * bar.barSize <= bar.mode
    end

    -- useSkill (PlayerController.lua:21340-21346): an ex slot holding the sub-ability's evasive goes out through the evasive path instead
    function S.exEvasive()
        local Abilities = S.mod("Abilities")
        local Utility = S.mod("Utility")
        local player = S.References.player
        if not (Abilities and Utility and player and type(Abilities.GetEvasive) == "function" and type(Utility.getPresentedStandName) == "function") then
            return nil
        end
        local okName, presented = S.game(Utility.getPresentedStandName, Utility, player)
        if not okName then return nil end
        local ok, evasive = S.game(Abilities.GetEvasive, Abilities, S.data("SubAbility"), S.standDef(), presented)
        return ok and evasive or nil
    end

    local function slotOf(key, slots)
        if type(key) == "number" then return S.SLOTS[key] end
        if type(key) ~= "string" then return nil end
        for _, slot in ipairs(S.SLOTS) do
            if slot == key then return slot end
        end
        for _, slot in ipairs(S.SLOTS) do
            if slots[slot] == key then return slot end
        end
        return nil
    end

    -- resolveQueuedSkill (PlayerController.lua:21162-21166): with ex on and access, EXModeSlots[slot] stands in for the slot's value
    function S.exResolve(key, char, explicit)
        local loadout = S.exLoadout(char)
        if not loadout then return nil, Errors.NOT_READY end
        local access = S.exAccess(char, loadout)
        local slot = slotOf(key, loadout.slots)
        local name = slot and loadout.slots[slot] or nil
        if not name then
            if not access and (explicit or S.isEXSkill(key)) then return nil, Errors.NO_EX end
            return nil, Errors.NOT_FOUND
        end
        if not access then return nil, Errors.NO_EX end
        return { slot = slot, name = name, value = name, ex = true }
    end

    function api.ex()
        if not S.ready() then return false, Errors.NOT_READY end
        local char = S.character()
        if not char then return false, Errors.NO_CHARACTER end
        local loadout = S.exLoadout(char)
        if not loadout then return false, Errors.NOT_READY end
        local bar = S.exBar()
        local access = S.exAccess(char, loadout)
        local skills = {}
        for _, slot in ipairs(S.SLOTS) do
            local name = loadout.slots[slot]
            if name then
                local info = S.skillInfo(name)
                local left = S.cooldownLeft(name, name, S.skillDef(name))
                local payable = S.exPayable(name, char, bar)
                skills[#skills + 1] = {
                    slot = slot,
                    name = name,
                    cost = info and info.exCost or 0,
                    ready = access and payable and left <= 0,
                    cooldownLeft = left,
                }
            end
        end
        return true, {
            mode = bar.mode,
            max = bar.max,
            bars = bar.bars,
            maxBars = BAR_COUNT,
            barSize = bar.barSize,
            access = access,
            skills = skills,
            -- getEXInputMode (PlayerController.lua:2867-2871)
            alwaysOn = S.data("Settings.EXAlwaysOn") == true,
        }
    end
end

end)
