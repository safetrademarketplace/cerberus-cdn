        if S.isStunned() then
            sw.state = "closed"
        else
            setWindow(sw, L, true)
            if not pause(job, sw.active) then return end
            setWindow(sw, L, false)
        end
        if not pause(job, sw.recovery) then return end
        if sw.blocked and sw.blockedLag > 0 and not pause(job, sw.blockedLag) then return end
        L.combo = sw.index + 1
        L.swinging = false
        L.heavyHit = false
        if L.combo > sw.count then
            if not pause(job, sw.endlag) then return end
            L.combo = 1
            L.comboCooldown = { started = S.now(), duration = sw.cooldown, swing = sw }
        end
        L.swingCooldown = false
        sw.done = true
    end

    -- the Light swing (PlayerController.lua:5230-5911): Swing (or BasicAttack then Swing at the hit marker), then one hit window
    function api.lightSwing(opts)
        if opts ~= nil and type(opts) ~= "table" then return false, Errors.BAD_ARGS end
        opts = opts or {}
        local c, cerr = context()
        if not c then return false, cerr end
        local gate = meleeGate(c, false)
        if gate then return false, gate end
        if not S.canAct("Swing") then return false, Errors.BLOCKED end
        local L = S.life
        local now = S.now()
        local cd = L.comboCooldown
        if cd then
            local scale = cd.swing.landed and (tonumber(c.Weapons.M1HitWaitScale) or 0.7) or (tonumber(c.Weapons.M1MissWaitScale) or 0.85)
            if now - cd.started < cd.duration * scale then return false, Errors.COOLDOWN end
            L.comboCooldown = nil
        end
        local routed = summonedSkill(c, false, opts.aim)
        if routed then
            if routed.err then return false, routed.err end
            return true, routed.result
        end
        local def, model = c.def, c.model
        if def and def.GunConfig and def.GunConfig.ShootSkill then return false, Errors.UNSUPPORTED end
        if c.standActive and type(def.SpecialSwings) == "string" then return false, Errors.UNSUPPORTED end
        if def and def.NoStandM1 and def.UseStandAnimations and def.FinishAttackOnUnsummon and c.summoned then return false, Errors.UNSUPPORTED end
        if model and (model:GetAttribute("TandemFlankActive") == true or model:GetAttribute("PropMemoryActive")) then return false, Errors.UNSUPPORTED end
        local profile = profileOf(c)
        local info = profile and c.Weapons.weaponInfo[profile]
        if type(info) ~= "table" or type(info.SwingActiveTimes) ~= "table" or #info.SwingActiveTimes == 0 then return false, Errors.NO_PROFILE end
        if profile == "Pluck" or info.PluckTiming then return false, Errors.UNSUPPORTED end
        local count = #info.SwingActiveTimes
        -- PlayerController.lua:5330-5340: profile change, cap, then the ComboReset window
        if L.lastProfile and L.lastProfile ~= profile then
            local prev = c.Weapons.weaponInfo[L.lastProfile]
            if type(prev) ~= "table" or type(prev.SwingActiveTimes) ~= "table" or #prev.SwingActiveTimes == 0 then L.combo = 1 end
        end
        L.combo = math.min(L.combo, count)
        if L.combo ~= 1 and (tonumber(info.ComboReset) or 1.1) * L.swingMult < now - L.lastSwing then L.combo = 1 end
        local index = L.combo
        if type(info.SpecialSwings) == "table" and info.SpecialSwings[1] == index then return false, Errors.UNSUPPORTED end
        if type(info.LightExtraHits) == "table" and type(info.LightExtraHits[index]) == "table" and #info.LightExtraHits[index] > 0 then
            return false, Errors.UNSUPPORTED
        end
        -- PlayerController.lua:5346-5363: size, assist scale, offset, then the stand's widening
        local size = (type(info.M1Hitbox) == "table" and info.M1Hitbox[index]) or Vector3.new(1, 1, 1)
        local okAssist, assist = method(c.Weapons, "GetAttackAssist", def, model, c.summoned and not c.standAway, false, index)
        if okAssist and type(assist) == "table" then size = size * (tonumber(assist.HitboxScale) or 1) end
        local offset = (type(info.M1HitboxOffsets) == "table" and info.M1HitboxOffsets[index]) or CFrame.new(0, 0, -size.Z / 2)
        if c.standActive then
            local okStand, standSize, standOffset = method(c.Weapons, "StandHitbox", size, offset, false)
            if not okStand then return false, Errors.NO_PROFILE end
            size, offset = standSize, standOffset
        end
        local okMult, mult = method(c.Utility, "getAttackTimeMultiplier", c.char,
            c.standActive and math.max(tonumber(def.BaseAttackSpeed) or 1, 0.05) or 1, nil,
            { BasicAttack = "Light", BasicAttackProfile = profile, BodyAttack = false })
        mult = okMult and tonumber(mult) or 1
        local startup, active, recovery = times(info.SwingActiveTimes[index], mult)
        local sequence = L.sequence + 1
        -- PlayerController.lua:5398-5401: barrage and Grateful Dead stands hand the M1 to whoever swings
        local handoff, actor = nil, c.char
        local barrage = c.Skills.skills.Barrage
        if model and (c.standName == "The Grateful Dead" or (type(barrage) == "table" and type(barrage.Stands) == "table" and barrage.Stands[c.standName] ~= nil)) then
            handoff = { Kind = "M1Handoff", Body = not c.standActive, Sequence = sequence }
            if c.standActive then actor = model end
        end
        -- PlayerController.lua:5453-5461: which swings wait for an animation hit marker
        local bodyEvents = not c.standActive and info.BodyLightHitEvents == true
        local charEvents = bodyEvents or (info.CharacterLightHitEvents and c.summoned and model ~= nil and not model:GetAttribute("Skill"))
        local eventName = (c.standActive or charEvents) and type(info.LightHitEvents) == "table" and info.LightHitEvents[index]
        local sw = {
            heavy = false, index = index, count = count, profile = profile, finisher = index == count,
            size = size, offset = offset, actor = actor, handoff = handoff, sequence = sequence,
            startup = startup, active = active, recovery = 0, length = startup + active + recovery,
            events = type(eventName) == "string" and eventName ~= "",
            endlag = tonumber(info.Endlag) or 0, cooldown = tonumber(info.M1Cooldown) or 0,
            blockedLag = (c.standActive and tonumber(c.Weapons.StandM1BlockedEndlag)) or tonumber(info.BlockedEndlag) or 0,
            state = "startup", startedAt = now, landed = false, blocked = false, consumed = false, done = false,
        }
        local ok, err
        if sw.events then
            ok, err = S.send("BasicAttack", true, false, index, c.char)
        else
            ok, err = S.send("Swing", index, L.heavyHit, sw.length, nil, sw.finisher, handoff)
        end
        if not ok then return false, err end
        L.sequence = sequence
        L.swinging = true
        L.swingCooldown = true
        L.lastSwing = now
        L.swingMult = mult
        L.lastProfile = profile
        L.window = sw
        L.current = sw
        S.track(Jobs.spawn(function(job) runLight(job, sw, L) end, { name = "Api/Combat light swing" }))
        return true, {
            index = index, finisher = sw.finisher, profile = profile, sequence = sequence,
            opensAt = now + startup, closesAt = now + startup + active, endsAt = now + sw.length,
        }
    end

    -- heavy timeline after BasicAttack: startup, Swing, the window, BasicAttack release, endlag and HeavyCooldown (PlayerController.lua:6230-6532)
    local function runHeavy(job, sw, L)
        if not pause(job, sw.startup) then return end
        S.send("Swing", sw.index, L.heavyHit, sw.length, true, sw.finisher)
        if sw.finisher then L.heavyHit = true end
        if S.isStunned() then
            sw.state = "closed"
        else
            setWindow(sw, L, true)
            if not pause(job, sw.active) then return end
            setWindow(sw, L, false)
        end
        L.heavyHit = false
        if not pause(job, sw.recovery) then return end
        S.send("BasicAttack", false, true, nil, sw.char)
        L.heavy = sw.index + 1
        if L.heavy > sw.count then
            if not pause(job, sw.endlag) then return end
            L.heavy = 1
        end
        if sw.parried and not S.isStunned() and not pause(job, sw.parryEndlag) then return end
        L.heavySwinging = false
        L.swinging = false
        L.swingCooldown = false
        sw.done = true
        if not pause(job, sw.cooldown) then return end
        L.heavyCD = false
    end

    -- the Heavy swing (PlayerController.lua:6078-6532): BasicAttack(true, true, i), Swing(i, ..., true, finisher), one window, BasicAttack(false, true)
    function api.heavySwing(opts)
        if opts ~= nil and type(opts) ~= "table" then return false, Errors.BAD_ARGS end
        opts = opts or {}
        local c, cerr = context()
        if not c then return false, cerr end
        local gate = meleeGate(c, true)
        if gate then return false, gate end
        local L = S.life
        local routed = summonedSkill(c, true, opts.aim)
        if routed then
            if routed.err then return false, routed.err end
            return true, routed.result
        end
        if c.summoned and not c.standAway and c.def and c.def.NoStandHeavy then return false, Errors.UNSUPPORTED end
        local profile = profileOf(c)
        local info = profile and c.Weapons.weaponInfo[profile]
        if type(info) ~= "table" or type(info.HeavySwingActiveTimes) ~= "table" or #info.HeavySwingActiveTimes == 0 then return false, Errors.NO_PROFILE end
        if profile == "Pluck" or info.PluckHeavyTiming then return false, Errors.UNSUPPORTED end
        -- PlayerController.lua:6108-6134: a SkillM2 replaces the heavy with ("Skill", m2, mouseHit, groundRay, closestMouse)
        local m2 = info.SkillM2 or c.char:GetAttribute("SkillM2")
        if m2 == "Lucky Uppercut" then return false, Errors.UNSUPPORTED end
        if m2 then
            if info.SkillM2Exclusive and S.skillOnCooldown(m2) then return false, Errors.COOLDOWN end
            if not S.skillOnCooldown(m2) then
                local ray = nil
                if opts.aim ~= nil then
                    ray = S.aimRay(opts.aim)
                    if not ray then return false, Errors.NO_AIM end
                end
                local sent, err = S.sendWith(ray, "Skill", m2, S.mouseHit(ray, nil), S.groundRay(), S.closestMouse(ray))
                if not sent then return false, err end
                return true, { skill = m2 }
            end
        end
        local count = #info.HeavySwingActiveTimes
        local now = S.now()
        L.heavy = math.min(L.heavy, count)
        if L.heavy ~= 1 and (tonumber(info.ComboReset) or 1.1) * L.swingMult < now - L.lastHeavy then L.heavy = 1 end
        local index = L.heavy
        if type(info.HeavySpecialSwings) == "table" and info.HeavySpecialSwings[1] == index then return false, Errors.UNSUPPORTED end
        local size = type(info.M2Hitbox) == "table" and info.M2Hitbox[index]
        if not size then return false, Errors.NO_PROFILE end
        local okAssist, assist = method(c.Weapons, "GetAttackAssist", c.def, c.model, c.summoned and not c.standAway, true, index)
        if okAssist and type(assist) == "table" then size = size * (tonumber(assist.HitboxScale) or 1) end
        local offset = (type(info.M2HitboxOffsets) == "table" and info.M2HitboxOffsets[index]) or CFrame.new(0, 0, -size.Z / 2)
        if c.standActive and not info.HeavyOnCharacter then
            local okStand, standSize, standOffset = method(c.Weapons, "StandHitbox", size, offset, true)
            if not okStand then return false, Errors.NO_PROFILE end
            size, offset = standSize, standOffset
        end
        local okMult, mult = method(c.Utility, "getAttackTimeMultiplier", c.char, nil, nil,
            { BasicAttack = "Heavy", BasicAttackProfile = profile, BasicAttackOnCharacter = info.HeavyOnCharacter == true })
        mult = okMult and tonumber(mult) or 1
        local startup, active = times(info.HeavySwingActiveTimes[index], mult)
        local sw = {
            heavy = true, index = index, count = count, profile = profile, finisher = index == count,
            size = size, offset = offset, actor = c.char, char = c.char,
            startup = startup, active = active, recovery = 0, length = startup + active,
            endlag = tonumber(info.Endlag) or 0, cooldown = tonumber(info.HeavyCooldown) or 0,
            parryEndlag = tonumber(c.Weapons.ParryEndlag) or 0.15,
            state = "startup", startedAt = now, consumed = false, done = false, parried = false,
        }
        local ok, err = S.send("BasicAttack", true, true, index, c.char)
        if not ok then return false, err end
        L.heavySwinging = true
        L.swinging = true
        L.swingCooldown = true
        L.heavyCD = true
        L.lastHeavy = now
        L.swingMult = mult
        L.window = sw
        S.track(Jobs.spawn(function(job) runHeavy(job, sw, L) end, { name = "Api/Combat heavy swing" }))
        return true, {
            index = index, finisher = sw.finisher, profile = profile,
            opensAt = now + startup, closesAt = now + startup + active, endsAt = now + sw.length,
        }
    end

    local function isOwnModel(target, char)
        if target == char then return true end
        local model = S.standModel()
        if model and target == model then return true end
        local summoner = target:FindFirstChild("Summoner")
        local owner = summoner and summoner:IsA("ObjectValue") and summoner.Value or nil
        return owner ~= nil and owner == char
    end

    -- the game's own query: root.CFrame * GetMeleeHitboxOffset at the swing's box size (PlayerController.lua:4243-4255)
    local function inBox(sw, target)
        local actorRoot = sw.actor and sw.actor.Parent and sw.actor:FindFirstChild("HumanoidRootPart")
        if not actorRoot then return false, Errors.NO_CHARACTER end
        local Weapons = S.mod("Weapons")
        local ok, offset = method(Weapons, "GetMeleeHitboxOffset", sw.actor, sw.profile, sw.offset, sw.heavy)
        if not ok or offset == nil then return false, Errors.NO_PROFILE end
        local params = OverlapParams.new()
        params.FilterType = Enum.RaycastFilterType.Include
        params.FilterDescendantsInstances = { target }
        -- live 2026-11-18: the train roof's CrackedPanel (tagged Damageable) sits in the Default group, which the hit group never overlaps; props are queried plainly
        local okTag, prop = pcall(CollectionService.HasTag, CollectionService, target, "Damageable")
        if not ((okTag and prop) or target:GetAttribute("Vehicle")) then params.CollisionGroup = HIT_GROUP end
        params.MaxParts = HIT_MAX_PARTS
        local okQuery, parts = pcall(Workspace.GetPartBoundsInBox, Workspace, actorRoot.CFrame * offset, sw.size, params)
        if not okQuery then
            base.warn("hit query failed: %s", tostring(parts))
            return false, Errors.OUT_OF_RANGE
        end
        if type(parts) ~= "table" or #parts == 0 then return false, Errors.OUT_OF_RANGE end
        return true, actorRoot
    end

    -- PlayerController.lua:4267-4273: from behind when the two roots face within 60 degrees, never for vehicles or Damageable props
    local function fromBehind(actorRoot, target)
        if target:GetAttribute("Vehicle") or target:GetAttribute("SuperFlyDamageTarget") then return false end
        local okTag, tagged = pcall(CollectionService.HasTag, CollectionService, target, "Damageable")
        if okTag and tagged then return false end
        local troot = target:FindFirstChild("HumanoidRootPart")
        if not troot then return false end
        local diff = actorRoot.Orientation.Y - troot.Orientation.Y
        return diff > -FACING_DEGREES and diff < FACING_DEGREES
    end

    -- the Hit Character shape (PlayerController.lua:4305), once per window, only while it's open and only on a target inside the swing's box
    function api.hit(target)
        if not S.hasNet then return false, Errors.NO_NET end
        if typeof(target) ~= "Instance" or not target:IsA("Model") then return false, Errors.BAD_ARGS end
        if not target.Parent then return false, Errors.GONE end
        local char = S.character()
        if not char then return false, Errors.NO_CHARACTER end
        if not S.alive(char) then return false, Errors.DEAD end
        if isOwnModel(target, char) then return false, Errors.SELF end
        local L = S.life
        local sw = L.window
        if not sw then return false, Errors.NO_WINDOW end
        if sw.consumed then return false, Errors.ALREADY_HIT end
        if sw.state == "startup" then return false, Errors.TOO_EARLY end
        if sw.state ~= "open" or not L.hitEnabled or S.now() > sw.closesAt then return false, Errors.WINDOW_CLOSED end
        if S.isStunned(char) then return false, Errors.STUNNED end
        local ok, actorRoot = inBox(sw, target)
        if not ok then return false, actorRoot end
        local sent, err = S.send("Hit Character", target, L.combo, L.heavy, L.heavyHit, fromBehind(actorRoot, target),
            sw.heavy, false, false, false, (not sw.heavy) and sw.sequence or nil, nil)
        if not sent then return false, err end
        sw.consumed = true
        L.hitEnabled = false
        return true, { target = target, index = sw.index, heavy = sw.heavy }
    end

    -- yields: swing, hit the target the first frame it sits inside the open window, then wait out the swing so the next attack can start
    function api.attack(target, opts)
        if typeof(target) ~= "Instance" or not target:IsA("Model") then return false, Errors.BAD_ARGS end
        if opts ~= nil and type(opts) ~= "table" then return false, Errors.BAD_ARGS end
        opts = opts or {}
        local swing = opts.heavy and api.heavySwing or api.lightSwing
        local ok, info = swing({ aim = opts.aim or target })
        if not ok then return false, info end
        if info.skill then return true, info end
        local L = S.life
        local sw = L.window
        local result, reason = false, Errors.MISSED
        while S.life == L and L.window == sw do
            if sw.state == "open" and not sw.consumed then
                local hit, err = api.hit(target)
                if hit then
                    result, reason = true, err
                elseif err == Errors.GONE or err == Errors.SELF or err == Errors.DEAD then
                    result, reason = false, err
                    break
                end
            elseif sw.state == "closed" or sw.done then
                break
            end
            task.wait(WINDOW_POLL)
        end
        while S.life == L and not sw.done do
            task.wait(WINDOW_POLL)
        end
        return result, reason
    end

    -- server M1 Contact (PlayerController.lua:24033-24045): (sequence, character, true|"Blocked") marks how the swing landed
    S.on("M1 Contact", function(sequence, who, result)
        local sw = S.life.current
        if not (sw and sw.sequence == sequence and S.isMine(who)) then return end
        if result == true then sw.landed = true elseif result == "Blocked" then sw.blocked = true end
    end)

    -- PlayerController.lua:25255-25265: ("Parried", victim|nil, "M2"?) closes your open window
    S.on("Parried", function(victim, kind)
        if victim ~= nil and not S.isMine(victim) then return end
        local L = S.life
        L.hitEnabled = false
        local sw = L.window
        if sw and sw.heavy and kind == "M2" and L.heavySwinging then sw.parried = true end
    end)

    -- blockStop (PlayerController.lua:6750-6766): the repress lock unless the server dropped a block raised under 0.3 s ago
    function S.blockRelease(fromServer)
        local L = S.life
        local char = S.character()
        local was = L.blocking
        if was and not (fromServer and S.now() - L.blockRaisedAt < 0.3) then
            local Weapons = S.mod("Weapons")
            local repress = Weapons and tonumber(Weapons.BlockRepressCooldown) or 0.18
            L.blockReadyAt = S.now() + repress * (char and tonumber(char:GetAttribute("BlockStartScale")) or 1)
        end
        L.blocking = false
        L.blockCooldown = false
        if was and char and S.alive(char) then return S.send("Block", false, char) end
        return true
    end

    -- PlayerController.lua:25201
    S.on("Block Stop", function()
        if S.life.blocking then S.blockRelease(true) end
    end)

    -- blockStart (PlayerController.lua:6600-6706) sends ("Block", true, character); a stand with a BlockSkill sends that skill instead
    function api.block(on)
        if type(on) ~= "boolean" then return false, Errors.BAD_ARGS end
        if not S.hasNet then return false, Errors.NO_NET end
        local char = S.character()
        if not char then return false, Errors.NO_CHARACTER end
        local L = S.life
        if not on then
            if not L.blocking then return false, Errors.NOT_BLOCKING end
            return S.blockRelease(false)
        end
        if not S.ready() then return false, Errors.NOT_READY end
        if not S.alive(char) then return false, Errors.DEAD end
        local now = S.now()
        if now < L.blockReadyAt then return false, Errors.COOLDOWN end
        local after = L.blockAfterSkill
        if after then
            if S.data("SkillActive") == true then
                after.seen = true
                return false, Errors.SKILL_ACTIVE
            end
            if not after.seen and now < after.deadline then return false, Errors.COOLDOWN end
            L.blockAfterSkill = nil
        end
        if not S.canAct("Block", true) then return false, Errors.BLOCKED end
        local hum = S.humanoid(char)
        local ragdoll = char:FindFirstChild("IsRagdoll")
        if char:GetAttribute("BodySnatchHead") or S.flag("StandOutCustomizationOpen") or (hum and (hum.Sit or hum.SeatPart ~= nil)) then
            return false, Errors.BUSY
        end
        if (ragdoll and ragdoll.Value) or char:GetAttribute("PassedOut") or S.timeStopped(char) then return false, Errors.STUNNED end
        local duringStun = char:GetAttribute("BlockDuringStun") == true
        if S.isStunned(char) and not duringStun then return false, Errors.STUNNED end
        if char:FindFirstChild("DefenseLocks") or L.swinging or L.blocking or L.blockCooldown then return false, Errors.BUSY end
        if L.combatDisabled == true then return false, Errors.COMBAT_DISABLED end
        local model = S.standModel()
        local standSkill = model and model:GetAttribute("Skill")
        if S.piloting(char) and standSkill then return false, Errors.PILOTING end
        local def = S.standDef(char)
        if def and def.BlockSkill and char:GetAttribute("Summoned") == true and not char:GetAttribute("StandAway") and not standSkill
            and not S.skillOnCooldown(def.BlockSkill) then
            local ok, err = S.send("Skill", def.BlockSkill, S.mouseHit(nil, nil), S.shiftlocked(), nil, S.inputStates("Skill", def.BlockSkill))
            if not ok then return false, err end
            return true, { skill = def.BlockSkill }
        end
        local ok, err = S.send("Block", true, char)
        if not ok then return false, err end
        L.blocking = true
        L.blockCooldown = true
        L.blockRaisedAt = now
        return true
    end

    -- startDash (PlayerController.lua:8364-8553): ("Dash", directionVector, DashLength, true, "NormalDash", DashAudio.Predict(character), character)
    function api.dash(dir)
        local vector = DASH_DIRS[dir]
        if not vector then return false, Errors.BAD_ARGS end
        local c, cerr = context()
        if not c then return false, cerr end
        local char, L, now = c.char, S.life, S.now()
        if S.injury(char).Modifiers.DashBlocked then return false, Errors.BLOCKED end
        if char:GetAttribute("WallClimbing") or char:GetAttribute("Vaulting") then return false, Errors.BUSY end
        if not S.canAct("Dash", "Start") then return false, Errors.BLOCKED end
        for _, attr in ipairs({ "BodySnatchHead", "BecomeMyCharacterControlled", "HidingInTrash" }) do
            if char:GetAttribute(attr) then return false, Errors.BUSY end
        end
        if c.hum.Sit or c.hum.SeatPart ~= nil or c.hum.PlatformStand or S.flag("StandOutCustomizationOpen") or char:FindFirstChild("MobilityLocks") then
            return false, Errors.BUSY
        end
        if c.def and c.def.DashSkill then
            if S.isStunned(char) then return false, Errors.STUNNED end
            if L.combatDisabled == true then return false, Errors.COMBAT_DISABLED end
            local ok, err = S.send("Skill", c.def.DashSkill, S.mouseHit(nil, nil), S.shiftlocked(), S.closestMouse(nil), S.inputStates("Skill", c.def.DashSkill))
            if not ok then return false, err end
            return true, { skill = c.def.DashSkill }
        end
        if c.root:FindFirstChild("doubleJump") then return false, Errors.BUSY end
        if S.piloting(char) then return false, Errors.PILOTING end
        if S.isStunned(char) then return false, Errors.STUNNED end
        if L.combatDisabled == true then return false, Errors.COMBAT_DISABLED end
        if L.blocking or L.blockCooldown or L.swinging then return false, Errors.BUSY end
        if now < L.globalDashUntil or now < L.dashUntil then return false, Errors.COOLDOWN end
        if os.clock() < (tonumber(char:GetAttribute("ParryFreezeUntil")) or 0) then return false, Errors.STUNNED end
        local profile = profileOf(c)
        local info = profile and c.Weapons.weaponInfo[profile]
        local length = type(info) == "table" and tonumber(info.DashLength)
        if not length then return false, Errors.NO_PROFILE end
        if char:GetAttribute("VampireActive") == true then length = length * 1.4 end
        local DashAudio = S.mod("DashAudio")
