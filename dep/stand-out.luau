        if not s.closed and s.puzzle then
            Activities.incident(c.id, s.puzzle.Token, "ClosePuzzle")
            if waitProgress(c, s, before, REPLY_WAIT) then return true end
        end
        if I.fingerprint(fresh(c.id)) ~= before then return true end
        return false, "puzzle_timeout"
    end

    -- DialogueInfo.lua:164-168: the jewelry npcs answer with Talk and the npc's name
    local function talk(c, e, before)
