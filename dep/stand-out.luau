            local token = growing.token
            if action == "Close" then growing = nil end
            return Net.fire("Gardening", "GrowingInput", { Token = token, Action = action })
        end
        if (action == "Clip" or action == "Cover") and not isInt(extra and extra.Index) then return false, Errors.BAD_ARGS end
        if (action == "PourEnd" or action == "SeedDrop") and typeof(extra and extra.Offset) ~= "Vector2" then return false, Errors.BAD_ARGS end
