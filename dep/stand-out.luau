        local pos = M.holdPoint(cf.Position, cf.LookVector, o.distance)
        sroot.CFrame = CFrame.lookAt(pos, Vector3.new(cf.Position.X, pos.Y, cf.Position.Z))
        sroot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    end

    function self.stop()
        self.target = nil
        releasePilot(char())
    end

    return self
end

return M

end)
__bundle_register("Features/Combat/KillAura", function(require, _LOADED, __bundle_register, __bundle_modules)
-- kill aura: while you play, fights the nearest enemy within range through the shared engine without moving you (it only turns you to face what it hits), keeping one target until it dies or leaves; auto block runs just the engine's defensive half while you fight by hand
local Jobs      = require("Utility/Jobs")
local Log       = require("Utility/Log")
local Mount     = require("Utility/Mount")
local Scheduler = require("Utility/Scheduler")
local UiWrite   = require("Utility/UiWrite")
local Engage    = require("Features/Combat/Engage")

local LOOK_EVERY = 0.25
local REFRESH_EVERY = 0.5
local DEFAULT_RANGE = 12

return function(ctx)
    local O = Mount.orchestrator(ctx, "KillAura")
    if not O then return end
    local engine = Engage.new(ctx)
    if not engine then
        Log.devwarn("KillAura", "combat or world api missing; kill aura won't load")
        return
    end
    local Options, Library = ctx.Options, ctx.Library

    local job, guard, current = nil, nil, nil
    local status = nil

    local function range()
        local element = Options and Options.KillAura_Range
        return tonumber(element and element.Value) or DEFAULT_RANGE
    end

    -- one fight per latched target; the engine returns when it dies, walks out of range or stops taking damage
    local function loop(j)
        local skip = setmetatable({}, { __mode = "k" })
        while j.alive do
            local reach = range()
            local target = engine.pick({ maxDistance = reach }, nil, skip)
            if not target then
                status = "No enemy in range"
                if not j:sleep(LOOK_EVERY) then return end
            else
                local fight = engine.start(target, { attach = false, face = true, range = reach + 2, respawn = false, owner = "KillAura" })
                current = fight
                if not fight then
                    status = "Can't fight right now"
                    if not j:sleep(LOOK_EVERY) then return end
                else
                    while j.alive and not fight.done() do
                        status = fight.status()
                        if not j:sleep(0.1) then
                            fight.kill()
                            return
                        end
                    end
                    current = nil
                    local _, reason = fight.outcome()
                    if reason == "immune" or reason == "gone" then skip[target] = os.clock() + 60 end
                end
            end
        end
    end

    -- the fight is closed directly, since a cancelled job never reaches its own close
    local function stop()
        if job then job:Cancel() end
        job = nil
        if current then current.kill() end
        current = nil
        status = nil
    end

    local aura = ctx.Tabs.Combat:AddLeftGroupbox("Kill Aura", "swords")
    aura:AddToggle("KillAura_Enabled", {
        Text     = "Kill Aura",
        Premium  = true,
        Default  = false,
        Callback = function(on)
            if on then
                if job then return end
                job = O.track(Jobs.spawn(loop, { name = "KillAura" }))
            else
                stop()
            end
        end,
    })
    aura:AddSlider("KillAura_Range", {
        Text     = "Range",
        Default  = DEFAULT_RANGE,
        Min      = 5,
        Max      = 40,
        Rounding = 0,
        Suffix   = " studs",
    })
    local label = aura:AddLabel("", true)

    local block = ctx.Tabs.Block:AddLeftGroupbox("Auto Block", "shield")
    block:AddToggle("KillAura_AutoBlock", {
        Text     = "Auto Block",
        Default  = false,
        Tooltip  = "Blocks hits while you fight by hand",
        Callback = function(on)
            if on then
                if not guard then guard = engine.guard() end
            elseif guard then
                guard.stop()
                guard = nil
            end
        end,
    })
    block:AddToggle("Combat_AutoBlock", {
        Text    = "Block In Farms",
        Default = true,
        Tooltip = "Farms block hits while they fight",
    })

    local shown = nil
    O.track(Scheduler.heartbeat(function()
        if Library and not Library.Toggled then return end
        local text = status or ""
        if text ~= shown and UiWrite.text(label, text) then shown = text end
    end, { name = "KillAura.status", interval = REFRESH_EVERY, deferrable = true }))

    O.onUnload(function()
        stop()
        if guard then guard.stop() end
        guard = nil
        engine.destroy()
    end)
    O.finalize()
end

end)
