local BANDIT_TABLE = "BanditArmWrestling"

local function findQuest(list, id)
    for _, q in ipairs(list) do
        if q.id == id then return q end
    end
    return nil
end

local function splitCsv(raw)
    local out = {}
    if type(raw) ~= "string" then return out end
    for entry in string.gmatch(raw, "[^,]+") do out[entry] = true end
    return out
end

-- the emote wheel's csv keeps its empty slots: ",,," is four free slots
local function slotsOf(raw)
    local out = {}
    if type(raw) ~= "string" then return out end
    for entry in string.gmatch(raw .. ",", "([^,]*),") do out[#out + 1] = entry end
    return out
end

return function(Q, D, Bounties)
    local Activities = Q.Activities
    local Player     = Q.Player
    local References = Q.References
    local World      = Q.World

    local S = {}
    local errands = Errands(Q, D)
    local contracts = Contracts(Q, D)
    local armWrestle = ArmWrestle(Q, D)

    function S.titles()
        local out = {}
        for i, entry in ipairs(CATALOGUE) do out[i] = entry.title end
        return out
    end

    -- the giver's own dialogue line, said once you stand beside them
    local function sayTo(q, npc, name, arg, arg2)
        local model, err = D.reachNpc(q, npc)
        if not model then return false, err end
        Q.say("Talking to " .. npc)
        return Activities.step(name, arg, arg2)
    end

    -- ClientSideQuests.lua:806-826: one npc per attempt, skipping the ones MajorTomAsked already lists
    local function survey(q)
        local asked = splitCsv(Player.playerAttr("MajorTomAsked"))
        for _, name in ipairs(SURVEYED) do
            if not asked[name] then return sayTo(q, name, "Major Tom", "Survey", name) end
        end
        return false, "surveyed"
    end

    local function rainbowPickup(q)
        local position = D.locate(q)
        if not position then return false, "lost" end
        local ok, err = D.goTo(position, "the cauldron")
        if not ok then return false, err end
        local prompt = D.waitFor(function() return D.promptNear(position, RAINBOW_NEAR, q, {}) end, 4)
        if not prompt then return false, "no_prompt" end
        Q.say("Taking the cauldron")
        return World.firePrompt(prompt)
    end

    local function goToMarker(q, name)
        local position = D.locate(q)
        if not position then return false, "lost" end
        return D.goTo(position, name)
    end

    -- live 2026-11-17: bandit #2 (Bobert) stood in NPCs with a Talk prompt and never turned hostile, so the pack clear found nobody
    -- live 2026-11-18: bandit #4 (Usuce) waits in StoryActors, held in his crater, with the talk prompt on his root
    local function banditToTalk()
        local me = Q.References.player.UserId
        for _, folder in ipairs({ "NPCs", "StoryActors" }) do
            local parent = D.gamePath({ folder })
            for name, verb in pairs(BANDIT_TALKS) do
                local model = parent and parent:FindFirstChild(name)
                if model and model:GetAttribute("StoryOwnerUserId") == me and model:GetAttribute("StoryLocalQuest") == BANDIT_QUEST then
                    return name, verb, model, folder
                end
            end
        end
        return nil
    end

    local BANDITS = { hostileNear = true, label = "Bandits" }

    local function storyBandit()
        local actors = D.gamePath({ "StoryActors" })
        if not actors then return nil end
        for _, m in ipairs(actors:GetChildren()) do
            if m:IsA("Model") and m:GetAttribute("StoryRagdollActor") == true and m:GetAttribute("BanditIndex") ~= nil then
                local hum = m:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and not m:GetAttribute("CombatLifeEnded") then return m end
            end
        end
        return nil
    end

    -- live 2026-11-17: the line alone changed nothing; the client sends it from inside bobert's dialogue, which his Talk prompt opens
    local function talkPrompt(model)
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("ProximityPrompt") and d.Enabled and d:GetAttribute("StoryPromptAvailable") ~= false and string.find(d.Name, "Talk", 1, true) then return d end
        end
        return nil
    end

    -- live 2026-11-17: after bobert's talk his garden wants "Smash Roka pot" (StoryActors.BanditGarden_<UserId>, StoryAction=BanditGardenSmash) before he fights; any open story prompt of yours for this quest is the next thing to do
    local function banditPrompt()
        local actors = D.gamePath({ "StoryActors" })
        if not actors then return nil end
        local me = Q.References.player.UserId
        for _, d in ipairs(actors:GetDescendants()) do
            if d:IsA("ProximityPrompt") and d.Enabled and d:GetAttribute("StoryPromptAvailable") ~= false
                and d:GetAttribute("StoryPromptOwnerId") == me
                and string.find(tostring(d:GetAttribute("StoryQuestIds") or ""), BANDIT_QUEST, 1, true) then
                return d
            end
        end
        return nil
    end

    local function bandit(q, tag)
        local open = banditPrompt()
        if open then
            local spot = D.positionOf(open.Parent) or (open.Parent:IsA("Attachment") and open.Parent.WorldPosition)
            if spot then
                local ok, err = D.goTo(spot, nil, { offset = 2 })
                if not ok then return false, err end
            end
            Q.say(open.ActionText ~= "" and open.ActionText or "Using it")
            local fired, ferr = World.firePrompt(open)
            if not fired then return false, ferr end
            D.sleep(TALK_SETTLE)
        end
        local name, verb, npc, folder = banditToTalk()
        -- the talk is over once its prompt turns off (StoryPromptAvailable false), so it is never said twice
        if npc and talkPrompt(npc) then
            local model, err = npc, nil
            if folder == "NPCs" then
                model, err = D.reachNpc(q, name)
            else
                local ok, gerr = D.goTo(npc, name, { offset = 3 })
                if not ok then model, err = nil, gerr end
            end
            if not model then return false, err end
            Q.say("Talking to " .. name)
            local prompt = D.waitFor(function() return talkPrompt(model) end, TALK_SETTLE * 3)
            if prompt then World.firePrompt(prompt) end
            D.sleep(TALK_SETTLE)
            local ok, serr = Activities.step(verb)
            if not ok then return false, serr end
            D.sleep(TALK_SETTLE)
            D.closeDialogue()
        end
        -- live 2026-11-17: bandit #3 (Clarence, BanditIndex 3, lying anchored by Trackers[3]) never fights; he's beaten at the BanditArmWrestling table beside him
        local actor = storyBandit()
        if actor and actor:GetAttribute("BanditIndex") == 3 and armWrestle.table(BANDIT_TABLE) then
            local won, why = armWrestle.run(BANDIT_TABLE, "Arm wrestling " .. actor.Name)
            if not won then return false, why end
            D.sleep(TALK_SETTLE)
            return true
        end
        if actor then
            local engine = Q.engine()
            if not engine then return false, "no_engine" end
            local ok, err = D.goTo(actor, "Bandits")
            if not ok then return false, err end
            Q.say("Fighting Bandits")
            local won, reason = engine.fight(actor, { owner = Q.owner, token = Q.token })
            if won then return true end
            if not D.alive() then return false, "died" end
            return false, reason
        end
        return D.defeat(q, tag, BANDITS)
    end

    local function progressOf(id, tag)
        local q = findQuest(D.activeQuests() or {}, id)
        if not q then return nil end
        return tonumber((q.objectives or {})[tag]) or 0, tonumber((q.totals or {})[tag]) or 1
    end

    local function bubbleSlot()
        for i, name in ipairs(slotsOf(Player.value("Cosmetics.EquippedEmotes"))) do
            if name == BUBBLE_EMOTE then return i end
        end
        return nil
    end

    -- equip the granted emote on a free wheel slot (the last one when none is free), then play it, each play waiting for the count to move
    local function blowBubbles(q, tag)
        local Net = Q.Net
        if not Net then return false, "no_net" end
        if not splitCsv(Player.value("Cosmetics.Emotes"))[BUBBLE_EMOTE] then return false, "missing", "Bubble emote missing" end
        local slot = bubbleSlot()
        if not slot then
            local slots = slotsOf(Player.value("Cosmetics.EquippedEmotes"))
            local pick = math.max(#slots, 1)
            for i, name in ipairs(slots) do
                if name == "" then pick = i break end
            end
            Q.say("Equipping Blow Bubble")
            local ok, err = Net.fire("Emotes", "Change Emote", "Emote" .. pick, BUBBLE_EMOTE)
            if not ok then return false, err end
            local found, why = D.waitFor(bubbleSlot, EQUIP_WAIT)
            if not found then return false, why == "timeout" and "no_slot" or why, "Couldn't equip bubbles" end
            slot = found
        end
        local blown = 0
        for _ = 1, BUBBLE_BURST do
            local have, need = progressOf(q.id, tag)
            if not have or have >= need then break end
            Q.say(("Blowing bubbles %d/%d"):format(have, need))
            local ok, err = Net.fire("Emotes", "Emote", "Emote" .. slot)
            if not ok then return blown > 0, err end
            local moved, why = D.waitFor(function()
                local now = progressOf(q.id, tag)
                return now == nil or now > have
            end, BUBBLE_WAIT)
            if not moved then
                if why ~= "timeout" then return false, why end
                break
            end
            blown = blown + 1
        end
        if blown == 0 then return false, "no_change", "Bubbles not counting" end
        return true
    end

    -- read only: rings of rays down around you until one meets the sea before any land; (water spot, last shore point)
    function S.findWater()
        local root = References.humanoidRootPart
        local sea = Q.Workspace:FindFirstChild("Sea")
        if not (root and sea) then return nil end
        local skip = { References.character }
        local folder = Q.Workspace:FindFirstChild("Game")
        for _, name in ipairs({ "Areas", "NPCs", "Players" }) do
            local f = folder and folder:FindFirstChild(name)
            if f then skip[#skip + 1] = f end
        end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = skip
        local from = root.Position
        local down = Vector3.new(0, -600, 0)
        local function cast(radius, angle)
            local origin = Vector3.new(from.X + math.cos(angle) * radius, from.Y + 300, from.Z + math.sin(angle) * radius)
            return Q.Workspace:Raycast(origin, down, params)
        end
        for radius = WATER_STEP, WATER_RANGE, WATER_STEP do
            for k = 0, WATER_RAYS - 1 do
                local angle = k * 2 * math.pi / WATER_RAYS
                local hit = cast(radius, angle)
                if hit and hit.Instance:IsDescendantOf(sea) then
                    local out = Vector3.new(math.cos(angle), 0, math.sin(angle))
                    local spot = hit.Position + out * WATER_INTO
                    local land = radius > WATER_STEP and cast(radius - WATER_STEP, angle) or nil
                    local shore = land and not land.Instance:IsDescendantOf(sea) and land.Position or nil
                    return spot, shore
                end
            end
        end
        return nil
    end

    local function anyPrompt(model)
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("ProximityPrompt") and d.Enabled then return d end
        end
        return nil
    end

    local function carrying()
        return Player.playerAttr("BobbyHidden") == true
    end

    -- live 2026-11-17: a carried npc trails a teleport (usagi), so the trip to the water is walked
    local function bobbyWater(q)
        if not carrying() then
            local model, err = D.reachNpc(q, "Bobby", BOBBY_HOME)
            if not model then return false, err end
            Q.say("Picking up Bobby")
            -- DialogueInfo.lua:634-636 sends it from inside his dialogue, so the dialogue is opened first as for bobert
            -- live 2026-11-17: bobby's only prompt is a plain "ProximityPrompt"
            local prompt = D.waitFor(function() return talkPrompt(model) or anyPrompt(model) end, TALK_SETTLE * 3)
            if prompt then World.firePrompt(prompt) end
            D.sleep(TALK_SETTLE)
            local ok, code = Activities.step("Bobby Carry")
            D.closeDialogue()
            if not ok then return false, code end
            local held, why = D.waitFor(carrying, CARRY_WAIT)
            if not held then return false, why == "timeout" and "no_carry" or why, "Bobby won't come" end
        end
        local spot, shore = S.findWater()
        if not spot then return false, "lost", "No water nearby" end
        Q.say("Taking Bobby to water")
        if shore then
            local ok = World.walkTo(shore, { token = Q.token, sprint = true })
            if not ok and not D.alive() then return false, "died" end
        end
        local ok, err = World.walkTo(spot, { token = Q.token, sprint = true })
        if not ok then
            if not D.alive() then return false, "died" end
            return false, err, "Bobby needs you"
        end
        return true
    end

    local HUMU = { hostileNear = true, label = "the training Humu" }
    -- live 2026-11-18: the rainbow's leprechaun (Players.Leprechaun, StoryEncounterCredit, Target empty) isn't hostile until hit, so "hostile near" never found it
    -- and the quest sat on "Retrying Rainbow"; it's found by name
    local LEPRECHAUN = { prefixes = { "Leprechaun" }, label = "the Leprechaun" }

    -- the per-quest steps with a quoted payload; anything else falls through to the generic driver
    local function specFor(q, tag)
        if tag == "Defeat Bandit" then return { run = function() return bandit(q, tag) end } end
        -- a tag not shaped "Defeat <name>" gets no generic handler, so the fight is spelled out
        if tag == "Rainbow_Defeat" then return { run = function() return D.defeat(q, tag, LEPRECHAUN) end } end
        if tag == "Rainbow_Pickup" then return { run = function() return rainbowPickup(q) end } end
        if tag == "Rainbow_Capture" then
            return { run = function() return goToMarker(q, "the rainbow") end, timeout = CAPTURE_WAIT }
        end
        -- DialogueInfo.lua:226-227
        if tag == "Rainbow_Return" then return { run = function() return sayTo(q, "Blackmore", "Return Rainbow") end } end
        if tag == "Tom_Surveys" then return { run = function() return survey(q) end } end
        -- DialogueInfo.lua:1760-1777
        if tag == "Tom_Report" then return { run = function() return sayTo(q, "Major Tom", "Major Tom", "Report") end } end
        if tag == "Tom_Chip" then return { run = function() return sayTo(q, "Major Tom", "Major Tom", "Chip") end } end
        if tag == "Tom_Stab" then return { run = function() return sayTo(q, "Major Tom", "Major Tom", "Stab") end } end
        if tag == "Tom_Claim" then return { run = function() return sayTo(q, "Major Tom", "Major Tom", "Claim") end } end
        if tag == "Caesar_BlowBubble" then return { run = function() return blowBubbles(q, tag) end, timeout = BUBBLE_WAIT } end
        if tag == "Caesar_BobbyWater" then return { run = function() return bobbyWater(q) end, timeout = WATER_WAIT } end
        if tag == "Caesar_DefeatHumu" then return { run = function() return D.defeat(q, tag, HUMU) end } end
        return errands.specFor(q, tag)
    end

    -- angelo's "Complete Bounty" is any bounty off petyr's board, run by the bounty driver
    local function drivable(q, tag, need)
        if tag == "Complete Bounty" then return Bounties ~= nil and Bounties.unlocked() end
        local spec = specFor(q, tag)
        if spec and spec.waiting then return true end
        return D.handlerFor(q, tag, need, spec) ~= nil
    end

    local function manualNote(entry, tag)
        if tag == "Complete Bounty" then
            local ok, done = Activities.isCompleted(PETYR_GATE)
            if ok and not done then return "Bounties locked" end
        end
        return entry.short .. " needs you"
    end

    local function offerPosition(id)
        local ok, offers = Activities.offers()
        if not ok then return nil end
        for _, offer in ipairs(offers) do
            if offer.id == id then return offer.position end
        end
        return nil
    end

    -- an item hand-in only starts when the bag already holds enough to finish it
    local function enoughFor(def, tag)
        local item = string.match(tag, "^Has_(.+)$")
        if not item then return true end
        local need = def and type(def.Objectives) == "table" and tonumber(def.Objectives[tag]) or 1
        local ok, have = Player.count(item)
        return ok and have >= need
    end

    local function start(entry, id, def, first)
        local key = id .. "|start"
        if D.blocked(key) then return entry.short .. " won't start", false end
        local okCan, can, reason = Activities.canStart(id)
        if not okCan then return nil, false end
        if not can then return REASONS[reason] or "Can't start it", false end
        local probe = { id = id, definition = def }
        if not first or not drivable(probe, first, 1) then return manualNote(entry, first), false end
        local firstSpec = specFor(probe, first)
        if firstSpec and firstSpec.waiting then return firstSpec.waiting, false end
        if not enoughFor(def, first) then return "Missing items", false end
        local model, err = D.reachNpc(nil, entry.giver, offerPosition(id) or entry.home)
        if not model then
            if err == "died" then return "Waiting to respawn", true end
            D.failed(key, nil)
            return "Can't reach " .. entry.giver, true
        end
        Q.say("Starting " .. entry.short)
        local ok = Activities.start(id)
        if ok and D.waitFor(function() return D.isActive(id) end, START_WAIT) then
            D.succeeded(key)
            return "Started " .. entry.short, true
        end
        if not D.alive() then return "Waiting to respawn", true end
        D.failed(key, nil)
        return "Retrying " .. entry.short, true
    end

    local function picked(set, title)
        return type(set) == "table" and set[title] == true
    end

    -- a chain's active step, else its first step not yet done; (nil) once every step is done
    local function chainNext(entry, list)
        for _, id in ipairs(entry.chain) do
            local q = findQuest(list, id)
            if q then return id, q end
        end
        for _, id in ipairs(entry.chain) do
            local ok, done = Activities.isCompleted(id)
            if not ok then return nil, nil, true end
            if not done then return id, nil end
        end
        return nil
    end

    -- (status, busy) for the first ticked side quest that has something to do; status alone says why the rest were skipped
    function S.step(list, set)
        local note = nil
        if Bounties and picked(set, "Petyr's Bounties") and Bounties.running() then
            local status, busy = Bounties.step()
            if busy then return status, true end
            note = status
        end
        for _, entry in ipairs(CATALOGUE) do
            if picked(set, entry.title) then
                local id, def, first = entry.id, nil, entry.first
                local skip, q = nil, nil
                if entry.angelo then
                    local ok, job = Activities.angeloJob()
                    if ok then
                        id, def = job.id, job.definition
                        local order = def and type(def.ObjectiveOrder) == "table" and def.ObjectiveOrder or {}
                        first = order[1]
                    else
                        skip = "No job today"
                    end
                elseif entry.chain then
                    local cq, unread
                    id, cq, unread = chainNext(entry, list)
                    first = id and entry.firsts[id]
                    if unread then
                        skip = "Waiting on the server"
                    elseif not id then
                        skip = entry.short .. " done"
                    elseif not cq and not first then
                        -- a step the server starts on its own after the last one
                        skip = "Waiting on the server"
                    elseif not cq and Player.playerAttr("BobbyHidden") == true then
                        skip = "Bobby is away"
                    end
                end
                if not skip and not entry.bounties then q = findQuest(list, id) end
                -- a server-handed companion quest (the garden guide) goes before the giver's own
                for _, other in ipairs(entry.also or {}) do
                    q = q or findQuest(list, other)
                end
                if entry.contracts then
                    local status, busy = contracts.step()
                    if busy then return status, true end
                    if status ~= nil and status == Q.waiting then note = status else note = note or status end
                elseif entry.bounties then
                    if Bounties then
                        local status, busy = Bounties.step()
                        if busy then return status, true end
                        -- the board's countdown says more than another quest's idle note
                        if status ~= nil and status == Q.waiting then note = status else note = note or status end
                    end
                elseif skip then
                    note = note or skip
                elseif q then
                    local tag, _, need = D.nextObjective(q)
                    local spec = tag and specFor(q, tag) or nil
                    local finish = not tag and errands.finishFor(q) or nil
                    if spec and spec.waiting then
                        Q.waiting = spec.waiting
                        note = note or spec.waiting
                    elseif finish then
                        local ok, why = D.drive(q, "Turn in", 1, finish)
                        if ok then return "Turned in", true end
                        if why == "died" then return "Waiting to respawn", true end
                        note = note or ("Turning in " .. entry.short)
                    elseif tag == "Complete Bounty" and drivable(q, tag, need) then
                        local status, busy = Bounties.step()
                        if busy then return status, true end
                        note = note or status
                    elseif tag and drivable(q, tag, need) then
                        local ok, why, label = D.drive(q, tag, need, spec)
                        if ok then return "Step done", true end
                        if why == "died" then return "Waiting to respawn", true end
                        if why == "stopped" then return nil, true end
                        if why == "no_engine" then
                            note = note or "Fight engine missing"
                        elseif why == "blocked" then
                            note = note or label or (entry.short .. " stuck")
                        else
                            return label or ("Retrying " .. entry.short), true
                        end
                    elseif tag then
                        note = note or manualNote(entry, tag)
                    else
                        note = note or "Waiting on the server"
                    end
                else
                    local status, busy = start(entry, id, def, first)
                    if busy then return status, true end
                    note = note or status
                end
            end
        end
        return note, false
    end

    return S
end

end)
__bundle_register("Features/Auto/Quests/Errands", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto quests errands: the step-by-step side quests (lettuce trader, statue of sorrow, museum errands, clean business, space oddity's later steps, big chop's gardens, angelo's contracts) as specs over the driver; a step is a giver line, a story prompt tagged for the quest, a fight near the marker or a walk, and a step nobody can do here gets no spec so it reads as "needs you"
local Contracts = require("Features/Auto/Quests/Contracts")

local PROMPT_WAIT  = 4
-- how far past the exit zone's centre (away from the registry) the escape walk ends; still inside the 54-wide exit ring
local ESCAPE_OUT   = 15
local TALK_SETTLE  = 1
local ACTOR_RANGE  = 150
local MAX_POTS     = 2
local TRAIL_WAIT   = 90
local WALK_WAIT    = 30
-- SI:3384-3387 and the per-quest scenes: where a side quest's own prompts live
local PROMPT_HOMES = { { "StoryActors" }, { "QuestInteractables" }, { "StoryLocations" }, { "NPCs" } }

-- ClientSideQuests.lua:2028-2035 and 1915-1919: the npc each sign and briefcase line goes to first
local SIGNER   = "Jodio"
local EXPLAINER = "Jodio"

local function contains(csv, value)
    if type(csv) ~= "string" then return false end
    for entry in string.gmatch(csv, "[^,]+") do
        if entry == value then return true end
    end
    return false
end

return function(Q, D)
    local Activities = Q.Activities
    local World      = Q.World
    local Player     = Q.Player
    local Combat     = Q.Combat
    local References = Q.References

    local E = {}
    local contracts = Contracts(Q, D)
    local dailyPot = nil

    local function me() return References.player.UserId end

    local function homes()
        local out = {}
        for _, path in ipairs(PROMPT_HOMES) do
            local inst = D.gamePath(path)
            if inst then out[#out + 1] = inst end
        end
        local map = D.gamePath({ "Map" })
        if map then
            for _, child in ipairs(map:GetChildren()) do
                if string.find(child.Name, "Story", 1, true) then out[#out + 1] = child end
            end
        end
        return out
    end

    local function spotOf(prompt)
        local parent = prompt.Parent
        if not parent then return nil end
        local spot = D.positionOf(parent) or (parent:IsA("Attachment") and parent.WorldPosition) or nil
        if spot and spot.Magnitude > 5 then return spot end
        return nil
    end

    -- a prompt the server tagged for this quest and that is yours; disabled ones count, since the client only enables a story prompt in range
    local function questPrompt(q, from)
        local best, bestDistance = nil, math.huge
        for _, home in ipairs(homes()) do
            for _, d in ipairs(home:GetDescendants()) do
                if d:IsA("ProximityPrompt") and contains(d:GetAttribute("StoryQuestIds"), q.id) then
                    local owner = d:GetAttribute("StoryPromptOwnerId")
                    if (owner == nil or owner == me()) and d:GetAttribute("StoryPromptAvailable") ~= false then
                        local spot = spotOf(d)
                        if spot then
                            local distance = from and (spot - from).Magnitude or 0
                            if distance < bestDistance then best, bestDistance = d, distance end
                        end
                    end
                end
            end
        end
        return best
    end
    E.questPrompt = questPrompt

    -- MuseumHandler.lua builds your own exhibits and record stacks client-side (StoryActors.MuseumErrands.Museum<Kind>_<UserId>), untagged by quest
    -- id; the nearest enabled one (a looked-at exhibit or searched stack goes quiet)
    local function museumPrompt(from)
        local folder = D.gamePath({ "StoryActors", "MuseumErrands" })
        if not folder then return nil end
        local suffix = "_" .. tostring(me())
        local best, bestDistance = nil, math.huge
        for _, set in ipairs(folder:GetChildren()) do
            if string.sub(set.Name, -#suffix) == suffix then
                for _, d in ipairs(set:GetDescendants()) do
                    if d:IsA("ProximityPrompt") and d.Name == "MuseumPrompt" and d.Enabled then
                        local spot = spotOf(d)
                        local distance = spot and from and (spot - from).Magnitude or 0
                        if spot and distance < bestDistance then best, bestDistance = d, distance end
                    end
                end
            end
        end
        return best
    end

    local function here()
        local root = References.humanoidRootPart
        return root and root.Position or nil
    end

    local function move(position, name, walk)
        if walk then
            if name then Q.say("Walking to " .. name) end
            local ok, err = World.walkTo(position, { token = Q.token, sprint = true })
            if ok then return true end
            if not D.alive() then return false, "died" end
            return false, err
        end
        return D.goTo(position, name, { offset = 2 })
    end

    -- the nearest tagged prompt, looked for again at the marker when none has streamed in yet
    local function usePrompt(q, name, walk)
        local prompt = q.id == "MUSEUM_ERRANDS" and museumPrompt(here()) or questPrompt(q, D.locate(q) or here())
        if not prompt then
            local position = D.locate(q)
            if not position then return false, "no_prompt" end
            local ok, err = move(position, name, walk)
            if not ok then return false, err end
            prompt = D.waitFor(function() return questPrompt(q, here()) end, PROMPT_WAIT)
            if not prompt then return false, "no_prompt" end
        end
        local ok, err = move(spotOf(prompt) or D.locate(q), name, walk)
        if not ok then return false, err end
        -- live 2026-11-22: the museum's upper-floor exhibits sit above the roof line, so a ground landing put us on the roof out of reach;
        -- then stand on the floor just in front of the prompt instead
        local spot, root = spotOf(prompt), References.humanoidRootPart
        if spot and root and (spot - root.Position).Magnitude > prompt.MaxActivationDistance then
            local parent = prompt.Parent
            local facing = parent and parent:IsA("BasePart") and parent.CFrame.LookVector or Vector3.zero
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = { root.Parent }
            local floor = workspace:Raycast(spot + facing * 4 + Vector3.new(0, -1, 0), Vector3.new(0, -40, 0), params)
            if floor then World.travelTo(floor.Position + Vector3.new(0, 3, 0), { token = Q.token, offset = 0 }) end
        end
        if not D.waitFor(function() return prompt.Parent ~= nil and prompt.Enabled end, PROMPT_WAIT) then return false, "no_prompt" end
        Q.say(prompt.ActionText ~= "" and prompt.ActionText or ("Using " .. (name or "it")))
        return World.firePrompt(prompt)
    end

    local function sayTo(q, npc, verb, arg, arg2)
        local model, err = D.reachNpc(q, npc)
        if not model then return false, err end
        Q.say("Talking to " .. npc)
        local ok, code = Activities.step(verb, arg, arg2)
        D.sleep(TALK_SETTLE)
        D.closeDialogue()
        return ok, code
    end

    -- a living story actor of yours near the marker (the clean business team, ragdoll bandits); Ragdoll.lua:482 lets them be hit
    local function ownActor(near)
        local actors = D.gamePath({ "StoryActors" })
        if not actors then return nil end
        for _, m in ipairs(actors:GetDescendants()) do
            if m:IsA("Model") and m:GetAttribute("StoryOwnerUserId") == me() and not m:GetAttribute("CombatLifeEnded") then
                local hum = m:FindFirstChildOfClass("Humanoid")
                local spot = D.positionOf(m)
                if hum and hum.Health > 0 and spot and (not near or (spot - near).Magnitude <= ACTOR_RANGE) then return m end
            end
        end
        return nil
    end

    local function fight(q, tag, label, actors)
        if actors then
            local actor = ownActor(D.locate(q))
            if actor then
                local engine = Q.engine()
                if not engine then return false, "no_engine" end
                local ok, err = D.goTo(actor, label)
                if not ok then return false, err end
                Q.say("Fighting " .. label)
                local won, reason = engine.fight(actor, { owner = Q.owner, token = Q.token })
                if won then return true end
                if not D.alive() then return false, "died" end
                return false, reason
            end
        end
        return D.defeat(q, tag, { hostileNear = true, label = label })
    end

    local function walkMarker(q, name)
        local position = D.locate(q)
        if not position then return false, "lost" end
        return move(position, name, true)
    end

    local function goMarker(q, name)
        local position = D.locate(q)
        if not position then return false, "lost" end
        return D.goTo(position, name)
    end

    -- ClientSideQuests.lua:366-391, 740-761: the trail only shows (and is followed) while crouched; needs the points the server pushed and a crouch verb
    local function trailSpec(remote)
        local puzzles = Q.puzzles
        local points = puzzles and puzzles.trail(remote)
        if not (points and points[1] and Combat and Combat.crouch) then return nil end
        return { timeout = TRAIL_WAIT, run = function()
            local ok, err = Combat.crouch(true)
            if not ok then return false, err end
            Q.say("Following the trail")
            for _, point in ipairs(points) do
                if typeof(point) == "Vector3" then
                    local walked, werr = World.walkTo(point, { token = Q.token })
                    if not walked then
                        if not D.alive() then return false, "died" end
                        return false, werr
                    end
                end
            end
            return true
        end }
    end

    -- DialogueInfo.lua:1668-1689: the marker points at the next recruit, and the line is the code the server set (ShadyCoatCode)
    local function recruit(q)
        local ok, err = goMarker(q, "a recruit")
        if not ok then return false, err end
        local model = D.waitFor(function() return D.npc("Sketchy Recruit") end, PROMPT_WAIT)
        if not model then return false, "missing" end
        ok, err = D.goTo(model, "a recruit")
        if not ok then return false, err end
        Q.say("Giving the code")
        local sent, code = Activities.step("Shady Coat", "Code")
        D.sleep(TALK_SETTLE)
        D.closeDialogue()
        return sent, code
    end

    -- ======================= big chop's gardens =======================

    local function flow()
        local f = Q.garden and Q.garden()
        if f then f.token, f.job, f.say = Q.token, Q.job, Q.say end
        return f
    end

    local function potIn(f, stages)
        if dailyPot and dailyPot.Parent and stages[f.stage(dailyPot)] then return dailyPot end
        for _, pot in ipairs(f.myPots()) do
            if stages[f.stage(pot)] then return pot end
        end
        return nil
    end

    local function placeDaily()
        local f = flow()
        if not f then return false, "no_garden" end
        local before = {}
        for _, pot in ipairs(f.myPots()) do before[pot] = true end
        if f.count("Garden Pot") < 1 then f.buySupplies(true, false, false) end
        local ok, err = f.placePot(nil)
        if not ok then return false, err end
        for _, pot in ipairs(f.myPots()) do
            if not before[pot] then dailyPot = pot end
        end
        return true
    end

    local function tendDaily(stages)
        local f = flow()
        if not f then return false, "no_garden" end
        local pot = potIn(f, stages)
        if not pot then return false, "no_pot" end
        if f.stage(pot) == "Empty" and f.count("Dirt Bag") < 1 then f.buySupplies(false, true, false) end
        return f.tend(pot, nil)
    end

    local function growingNote()
        local f = flow()
        if not f then return nil end
        local pot = potIn(f, { Growing = true })
        if not pot or potIn(f, { Ready = true }) then return nil end
        return ("Ripe in %ds"):format(math.ceil(f.ripensIn(pot) or 0))
    end

    local function gardenSpec(tag)
        local f = flow()
        if not f then return nil end
        if tag == "GardenDaily_Place" then
            if #f.myPots() >= MAX_POTS then return { waiting = "Free a garden pot" } end
            return { run = placeDaily }
        end
        if tag == "GardenDaily_Dirt" then return { run = function() return tendDaily({ Empty = true }) end } end
        if tag == "GardenDaily_Seed" then return { run = function() return tendDaily({ DirtReady = true }) end } end
        if tag == "GardenDaily_Harvest" or tag == "GardenGuide_Harvest" then
            local note = growingNote()
            if note then return { waiting = note } end
            local stages = { Ready = true }
            if tag == "GardenGuide_Harvest" then stages = { Ready = true, Empty = true, DirtReady = true } end
            if not potIn(f, stages) then
                if tag == "GardenGuide_Harvest" and #f.myPots() < MAX_POTS then return { run = placeDaily } end
                return nil
            end
            return { run = function() return tendDaily(stages) end, timeout = 15 }
        end
        if tag == "GardenGuide_Sell" then return { run = function() return f.sellAll() end } end
        return nil
    end

    -- ======================= the step table =======================

    local TALK = {
        -- DialogueInfo.lua:1455-1488
        Fate_Angelo  = { npc = "Angelo", verb = "Fate Old Lady", arg = "Angelo1" },
        Fate_Report  = { npc = "Fate Old Lady", verb = "Fate Old Lady", arg = "Report1" },
        -- DialogueInfo.lua:1544-1559, ClientSideQuests.lua:2061
        Museum_Brief  = { npc = "Museum Receptionist", verb = "Museum Errands", arg = "Brief" },
        Museum_Sign   = { npc = SIGNER, verb = "Museum Errands", arg = "Sign", arg2 = SIGNER },
        Museum_Report = { npc = "Museum Receptionist", verb = "Museum Errands", arg = "Report" },
        -- DialogueInfo.lua:1623-1630, 1668-1689, ClientSideQuests.lua:1943
        Coat_Briefing = { npc = "Shady Guy", verb = "Shady Coat", arg = "Brief" },
        Coat_Explain  = { npc = EXPLAINER, verb = "Shady Coat", arg = "Briefcase", arg2 = EXPLAINER },
        Coat_Return   = { npc = "Shady Guy", verb = "Shady Coat", arg = "Return" },
    }

    -- turn-ins said once every objective reads done (DialogueInfo.lua:390-391)
    local FINISH = {
        LETTUCE_TRADER = { npc = "Lettuce Trader", verb = "Lettuce Trader", arg = "Wash" },
    }

    local PROMPTS = {
        Lettuce_Clues = "the stall", Lettuce_Note = "the note", Lettuce_Bush = "the bush", Lettuce_Key = "the key",
        Museum_Look = "the exhibits", Museum_Records = "the records", Tom_Darby = "D'Arby", Coat_Crate = "the crate",
    }

    local FIGHTS = {
        Lettuce_Thugs  = { label = "the thugs" },
        Lettuce_YoYoMa = { label = "Yo-Yo Ma" },
        Coat_Brawl     = { label = "the team", actors = true },
    }

    -- (spec or nil): nil means nobody here can do the step right now
    function E.specFor(q, tag)
        local talk = TALK[tag]
        if talk then return { run = function() return sayTo(q, talk.npc, talk.verb, talk.arg, talk.arg2) end } end
        if PROMPTS[tag] then return { run = function() return usePrompt(q, PROMPTS[tag]) end } end
        local f = FIGHTS[tag]
        if f then return { run = function() return fight(q, tag, f.label, f.actors) end } end
        if tag == "Lettuce_Trail" then return trailSpec("LettuceTrader") end
        if tag == "Fate_Trail" then return trailSpec("FateQuest") end
        -- DialogueInfo.lua:1479-1488: the challenge is accepted in his dialogue, then he fights
        if tag == "Fate_CEO" then
            return { run = function()
                local ok, err = sayTo(q, "CEO Of Fighting", "Fate Old Lady", "Fight")
                if not ok then return false, err end
                return fight(q, tag, "the CEO", true)
            end }
        end
        -- the net is the server's; only a prompt it hands us is pressed
        if tag == "Fate_Trap" then
            if not questPrompt(q, here()) then return nil end
            return { run = function() return usePrompt(q, "the net") end }
        end
        -- live 2026-11-22: the marker for this step chases you (the guard), and a long teleport away dropped the records; walking out of the
        -- LandRegistry zone into the LandRegistryExit ring around it is what counts
        if tag == "Museum_Escape" then
            return { run = function()
                local registry, exit = D.gamePath({ "QuestZones", "LandRegistry" }), D.gamePath({ "QuestZones", "LandRegistryExit" })
                local from, to = registry and D.positionOf(registry), exit and D.positionOf(exit)
                if not (from and to) then return goMarker(q, "the exit") end
                local away = (to - from) * Vector3.new(1, 0, 1)
                local target = to + (away.Magnitude > 0.1 and away.Unit or Vector3.new(1, 0, 0)) * ESCAPE_OUT
                Q.say("Walking out of the registry")
                local ok, err = World.walkTo(target, { token = Q.token, sprint = true })
                if ok then return true end
                if not D.alive() then return false, "died" end
                return false, err
            end }
        end
        if tag == "Museum_Ambush" then
            if Player.playerAttr("MuseumAmbush") then return { run = function() return fight(q, tag, "the Stand users", false) end } end
            return { run = function() return goMarker(q, "the museum") end }
        end
        -- the team follows on foot, and carried teammates trail a teleport like usagi did
        if tag == "Coat_Walk" or tag == "Coat_Leave" then return { run = function() return walkMarker(q, nil) end, timeout = WALK_WAIT } end
        if tag == "Coat_Carry" then
            return { timeout = WALK_WAIT, run = function()
                if questPrompt(q, here()) then
                    local ok, err = usePrompt(q, "a teammate", true)
                    if not ok then return false, err end
                    D.sleep(TALK_SETTLE)
                end
                return walkMarker(q, "the hospital")
            end }
        end
        if tag == "Complete Elimination" then
            local left = contracts.cooldown()
            if left then return { waiting = ("Next contract in %ds"):format(left) } end
            return { run = contracts.run, timeout = 20 }
        end
        if tag == "Coat_Recruit" then return { run = function() return recruit(q) end } end
        if string.sub(tag, 1, 6) == "Garden" then return gardenSpec(tag) end
        return nil
    end

    function E.finishFor(q)
        local fin = FINISH[q.id]
        if not fin then return nil end
        return { run = function() return sayTo(q, fin.npc, fin.verb, fin.arg) end }
    end

    return E
end

end)
__bundle_register("Features/Auto/Quests/ArmWrestle", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto quests arm wrestle: sits at an ArmWrestlingTables table and presses each round at its perfect moment; ArmWrestling.lua Angle is linear in time, so the round's target angle is a server time, sent as the press time once it has passed (QTE.ArmWrestling.lua:370-387)
local SIT_WAIT = 8
local MATCH_LIMIT = 150
local POLL = 1 / 60
-- sleep through a round's dead time up to this close to the perfect moment, then poll by frame
local NEAR = 0.04

return function(Q, D)
    local Activities = Q.Activities
    local World      = Q.World
    local A = {}

    local function session()
        local ok, s = Activities.armWrestle()
        if ok and type(s) == "table" then return s end
        return nil
    end

    local function serverNow()
        return workspace:GetServerTimeNow()
    end

    local function seatPrompt(tableModel)
        for _, d in ipairs(tableModel:GetDescendants()) do
            if d:IsA("ProximityPrompt") and d.Enabled and d.Name == "ArmWrestlingSit" then return d end
        end
        return nil
    end

    -- plain: the arm wrestling table with this name, or nil
    function A.table(name)
        return D.gamePath({ "ArmWrestlingTables", name })
    end

    -- plays the running match to its end; true with the end payload, or false and why
    function A.play(label)
        local deadline = os.clock() + MATCH_LIMIT
        while os.clock() < deadline do
            local s = session()
            if not s then return false, "no_session" end
            if s.ended then return true, s.result end
            Q.say(label)
            local wait = POLL
            if s.round and not s.pressed then
                local ok, at = Activities.armWrestlePerfectTime(s)
                if ok then
                    local now = serverNow()
                    if now >= at then
                        Activities.armWrestleInput(s.id, s.round, at)
                    elseif at - now > NEAR then
                        wait = at - now - NEAR
                    end
                end
            end
            if not D.sleep(wait) then return false, "stopped" end
        end
        return false, "timeout"
    end

    -- walks to the named table, takes a free seat and plays the match it starts
    function A.run(name, label)
        local running = session()
        if running and not running.ended then return A.play(label) end
        local tableModel = A.table(name)
        if not tableModel then return false, "no_table" end
        local prompt = seatPrompt(tableModel)
        if not prompt then return false, "table_busy" end
        local spot = D.positionOf(prompt.Parent) or D.positionOf(tableModel)
        local ok, err = D.goTo(spot, nil, { offset = 2 })
        if not ok then return false, err end
        Q.say(label)
        local fired, ferr = World.firePrompt(prompt)
        if not fired then return false, ferr end
        local started = D.waitFor(function()
            local s = session()
            return s and not s.ended
        end, SIT_WAIT)
        if not started then return false, "not_started" end
        return A.play(label)
    end

    return A
end

end)
__bundle_register("Features/Auto/Quests/Puzzles", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto quests puzzles: keeps the story puzzles the server pushes (howler id checks, staff records, the cash alteration timing, the lettuce and fate drool trails) and answers them from inside the quest job, never from the push itself
local INSPECT_TTL  = 30
local RECORD_GAP   = 1.5
local ALTER_LEAD   = 0.05
local ALTER_WINDOW = 30
-- CashInterrogation.lua:53-62 reads the cycle from HowlerCash's PresentationConfig; this is only the fallback when it can't be read
local DEFAULT_CYCLE = 2
local DEFAULT_TOLERANCE = 0.06

return function(Q)
    local Net       = Q.Net
    local Workspace = Q.Workspace
    local P = {}

    local inspection, records, recordTried, recordResult, cash = nil, nil, {}, nil, nil
    local trails = {}

    local function now() return Workspace:GetServerTimeNow() end

    -- the handles are the caller's to track; with no net api nothing is listened to
    function P.listen()
        if not Net then return {} end
        local handles = {}
        local function add(name, verb, fn)
            local h = Net.onVerb(name, verb, fn)
            if h then handles[#handles + 1] = h end
        end
        -- ItemInspection.lua:66-68: {Token, Key, ProfileId, Revision}
        add("Quest", "Inspect Driver License", function(data)
            if type(data) == "table" and data.Token ~= nil then inspection = { data = data, at = os.clock() } end
        end)
        add("Quest", "ID Inspection Result", function(data)
            if type(data) == "table" and inspection and inspection.data.Token == data.Token then inspection = nil end
        end)
        -- RecordPhone.lua:91, 280-296: four options; a wrong pick only says try again
        add("Quest", "Howler Records", function(data)
            if type(data) == "table" and type(data.Options) == "table" and data.Token ~= nil then
                records, recordTried, recordResult = data, {}, nil
            end
        end)
        add("Quest", "Howler Records Result", function(data)
            if type(data) ~= "table" or not records or data.Token ~= records.Token then return end
            if data.Accepted or data.Closed then records = nil end
            recordResult = data
        end)
        -- CashInterrogation.lua:1427-1440, 900-909: the newest State for the live token
        add("HowlerCash", "State", function(data)
            if type(data) ~= "table" then return end
            if data.Phase == "Complete" or data.Phase == "Failed" then cash = nil return end
            cash = data
        end)
        add("HowlerCash", "End", function() cash = nil end)
        -- ClientSideQuests.lua:366-375, 740-746: the trail's points, or nil once it is cleared
        for _, remote in ipairs({ "LettuceTrader", "FateQuest" }) do
            add(remote, "Trail", function(data)
                trails[remote] = type(data) == "table" and type(data.Points) == "table" and data.Points or nil
            end)
        end
        return handles
    end

    function P.trail(remote) return trails[remote] end

    -- live 2026-11-18: one Alter per bill; the State keeps repeating the same bill until the server moves on, so a bill already sent waits for the next one
    local sentBill = nil
    local function myAlter()
        local player = Q.References.player
        if cash ~= nil and cash.Phase == "Alter" and cash.OperatorUserId == player.UserId then
            if sentBill and sentBill == tostring(cash.Token) .. "|" .. tostring(cash.Bill) then return nil end
            return cash
        end
        return nil
    end

    -- live 2026-11-18: the cash test runs Intro, Threat (15 s), then 8 Alter bills inside a 60 s deadline; true while any phase of ours is live
    function P.cashLive()
        local player = Q.References.player
        if not (cash ~= nil and player ~= nil and cash.OperatorUserId == player.UserId) then return false end
        -- Departure has its own checkpoint (Let Howler check Dragona), so only the timed phases count
        return cash.Phase == "Intro" or cash.Phase == "Threat" or cash.Phase == "Alter"
    end

    function P.pending()
        if inspection and os.clock() - inspection.at > INSPECT_TTL then inspection = nil end
        return inspection ~= nil or records ~= nil or myAlter() ~= nil
    end

    -- CashInterrogation.lua:63-66: the cursor ping-pongs 0..1 once per cycle from ChallengeAt
    function P.cursor(t, at, cycle)
        local v = math.max(0, t - at) / cycle % 2
        return v <= 1 and v or 2 - v
    end

    -- the next server time at or after `from` where the cursor sits on target
    function P.nextHit(from, at, cycle, target)
        local base = math.max(from, at)
        local best = nil
        local k = math.floor((base - at) / (2 * cycle)) - 1
        for i = k, k + 3 do
            for _, frac in ipairs({ target, 2 - target }) do
                local t = at + cycle * (2 * i + frac)
                if t >= base and (not best or t < best) then best = t end
            end
        end
        return best
    end

    local function config()
        local remote = Net and Net.remote and select(2, Net.remote("HowlerCash"))
        local raw = typeof(remote) == "Instance" and remote:GetAttribute("PresentationConfig") or nil
        if type(raw) ~= "string" then return {} end
        local ok, decoded = pcall(function() return game:GetService("HttpService"):JSONDecode(raw) end)
        return ok and type(decoded) == "table" and decoded or {}
    end

    -- CashInterrogation.lua:430-448: one press, at a moment the cursor sits inside the target's tolerance
    local function alter(data, D)
        local cfg = config()
        local cycle = tonumber(data.Cycle) or tonumber(cfg.Cycle) or DEFAULT_CYCLE
        local target = tonumber(data.Target)
        local tolerance = tonumber(data.Tolerance) or tonumber(cfg.Tolerance) or DEFAULT_TOLERANCE
        local at = tonumber(data.ChallengeAt)
        if not (target and at and cycle > 0) then return false, "no_timing" end
        local deadline = os.clock() + ALTER_WINDOW
        while os.clock() < deadline do
            local live = myAlter()
            if not live or live.Token ~= data.Token then return true end
            local hit = P.nextHit(now() + ALTER_LEAD, at, cycle, target)
            if not hit then return false, "no_timing" end
            local wait = hit - now()
            if wait > 0 and not D.sleep(wait) then return false, "stopped" end
            if math.abs(P.cursor(now(), at, cycle) - target) <= tolerance * 0.8 then
                Q.say("Altering the bills")
                sentBill = tostring(data.Token) .. "|" .. tostring(data.Bill)
                return Net.fire("HowlerCash", "Alter", data.Token, data.Revision, now())
            end
            if not D.sleep(0) then return false, "stopped" end
        end
        return false, "timeout"
    end

    -- (acted, ok, why): answers whatever puzzle is open; acted false means nothing was pending
    function P.answer(D)
        if not Net then return false end
        if inspection then
            local data = inspection.data
            inspection = nil
            Q.say("Approving the ID")
            -- ItemInspection.lua:28
            return true, Net.fire("Quest", "Approve ID Inspection", data.Token, data.Key)
        end
        if records then
            local data = records
            if recordResult and recordResult.Token == data.Token then recordResult = nil end
            for _, option in ipairs(data.Options) do
                if not recordTried[option] then
                    recordTried[option] = true
                    Q.say("Checking the records")
                    -- RecordPhone.lua:196
                    local ok, err = Net.fire("Quest", "Howler Record Choice", data.Token, option)
                    D.sleep(RECORD_GAP)
                    return true, ok, err
                end
            end
            records = nil
            return true, false, "records_exhausted"
        end
        local live = myAlter()
        if live then return true, alter(live, D) end
        return false
    end

    return P
end

end)
__bundle_register("Features/Auto/Quests/Howler", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto quests howler: the howler story chapters (P9_35-P9_47) step on the server's own checkpoint (HowlerStoryCheckpoint/Key): press the checkpoint prompt and answer its dialogue, smash the floating crates with heavies, take the story boat's wheel and drive it to the marker; the id inspection and staff records pages are answered by Puzzles.lua
-- live 2026-11-18: a bare "Howler Dialogue Reply" counts for nothing until the checkpoint prompt has been pressed (the server opens the dialogue), so the reply always follows the press
local POLL = 0.25
local PROMPT_SIDE = 4
-- the client re-checks story prompt eligibility every frame; it needs a moment after you arrive
local ENABLE_WAIT = 2.5
-- the server answers a press with a dialogue (DialogueInputLocked) or an inspection/records page
local ANSWER_WAIT = 3
local ESCORT_WAIT = 40
-- crates: stand just over one and swing before sinking (a crate swung at from the water never broke); heavies are 2 s apart
local CRATE_ABOVE = 2
local CRATE_SIDE = 3.5
local SWING_GAP = 2.3
local CRATE_SWINGS = 4
-- the boat: driven until the checkpoint moves on; stopped this long it backs off for a beat
local DRIVE_LIMIT = 150
local STUCK_SPEED = 2
local STUCK_AFTER = 1.2
local REVERSE_FOR = 1.5
local SLOW_WITHIN = 25
local STEER_GAIN = 3
local DRIVE_BIND = "CerberusHowlerBoat"

local function lower(s) return type(s) == "string" and string.lower(s) or "" end

local function asPosition(value)
    local kind = typeof(value)
    if kind == "Vector3" then return value end
    if kind == "CFrame" then return value.Position end
    return nil
end

local Executor = require("Utility/Executor")

local H = {}

-- live 2026-11-18: the game drops vehicle input while the roblox window isn't focused (Vehicles.lua/Boats.lua inputBlocked); the focus event is fired again while we drive
local FOCUS_EVERY = 0.5

-- plain: which routine the checkpoint text calls for
function H.kindOf(checkpoint)
    local text = lower(checkpoint)
    if string.find(text, "crate", 1, true) and string.find(text, "smash", 1, true) then return "crates" end
    if string.find(text, "driver's seat", 1, true) or string.find(text, "drivers seat", 1, true) then return "board" end
    -- live 2026-11-18: "Stay aboard with the crew" lost the seat to auto raid and a side quest within seconds; it's the raft's seat, held until the checkpoint moves on
    if string.find(text, "stay aboard", 1, true) then return "stay" end
    -- live 2026-11-18: 47_Board "Board the escape raft" is the story raft's seat (HowlerFinaleRaft), not a spot to stand on
    if string.find(text, "board the", 1, true) and (string.find(text, "raft", 1, true) or string.find(text, "boat", 1, true)) then return "board" end
    if string.find(text, "drive to", 1, true) then return "drive" end
    -- live 2026-11-18: "Knock Key West into the pool": heavies from behind only drove her further off, but she follows you, so standing in the pool brings her in after you
    if string.find(text, "pool", 1, true) and string.find(text, "key west", 1, true) then return "pool" end
    -- live 2026-11-18: "Defeat Ningbo and Laem Chabang" has no prompt to press (it's off while the fight is on); Story fights it after this step
    if string.sub(text, 1, 7) == "defeat " then return "fight" end
    return "checkpoint"
end

-- plain: the throttle/steer for the boat this frame; state holds the stuck timers
function H.boatInput(state, now, flatTo, flatLook, speed)
    if state.reverseUntil and now < state.reverseUntil then
        local cross = flatLook.Unit:Cross(flatTo.Unit).Y
        return -1, math.clamp(cross * STEER_GAIN, -1, 1)
    end
    state.reverseUntil = nil
    if speed < STUCK_SPEED then
        state.slowAt = state.slowAt or now
        if now - state.slowAt >= STUCK_AFTER then
            state.slowAt = nil
            state.reverseUntil = now + REVERSE_FOR
            return -1, 0
        end
    else
        state.slowAt = nil
    end
    local cross = flatLook.Unit:Cross(flatTo.Unit).Y
    return flatTo.Magnitude > SLOW_WITHIN and 1 or 0.3, math.clamp(-cross * STEER_GAIN, -1, 1)
end

function H.new(Q, D)
    local Activities, World, Combat = Q.Activities, Q.World, Q.Combat
    local References, Workspace, RunService = Q.References, Q.Workspace, Q.RunService
    local R = {}
    local bound = false

    local function player() return References.player end
    local function attr(name)
        local p = player()
        return p and p:GetAttribute(name) or nil
    end

    local function unseat()
        local hum = References.humanoid
        if hum and hum.SeatPart then
            hum.Sit = false
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
            D.sleep(0.6)
        end
    end

    -- StoryActors.HowlerCheckpointAnchor_<UserId>.HowlerCheckpoint_<key> (StoryInteractions.lua:1940-1953)
    local function checkpointPrompt(key)
        local p = player()
        local gameRoot = Workspace:FindFirstChild("Game")
        local actors = gameRoot and gameRoot:FindFirstChild("StoryActors")
        local anchor = p and actors and actors:FindFirstChild("HowlerCheckpointAnchor_" .. tostring(p.UserId))
        return anchor and anchor:FindFirstChild("HowlerCheckpoint_" .. tostring(key)) or nil
    end

    local function promptPosition(prompt)
        local parent = prompt.Parent
        if parent and parent:IsA("BasePart") then return parent.Position end
        if parent and parent:IsA("Attachment") then return parent.WorldPosition end
        if parent and parent:IsA("Model") then return parent:GetPivot().Position end
        return nil
    end

    -- live 2026-11-18: from P9_44 on the steps are world prompts (Map.KeyWestArena.Markers.Track.KeyWestTrail "Inspect gap", StoryQuestIds = the quest)
    -- sitting on HowlerStoryTarget instead of a checkpoint on an actor; the nearest one for the active story quest, never an ambient talk
    local WORLD_REACH = 15
    local function worldPrompt()
        local target = asPosition(attr("HowlerStoryTarget"))
        local quest = attr("HowlerStoryQuestId")
        if not target then return nil end
        local gameRoot = Workspace:FindFirstChild("Game")
        local best, bestD = nil, WORLD_REACH
        for _, root in ipairs({ gameRoot and gameRoot:FindFirstChild("Map"), gameRoot and gameRoot:FindFirstChild("StoryActors"), gameRoot and gameRoot:FindFirstChild("QuestInteractables") }) do
            for _, d in ipairs(root and root:GetDescendants() or {}) do
                if d:IsA("ProximityPrompt") and not d:GetAttribute("HowlerAmbient") then
                    local ids = d:GetAttribute("StoryQuestIds")
                    if type(ids) == "string" and type(quest) == "string" and string.find(ids, quest, 1, true) then
                        local at = promptPosition(d)
                        local dist = at and (at - target).Magnitude
                        if dist and dist < bestD then best, bestD = d, dist end
                    end
                end
            end
        end
        return best
    end

    local function answered()
        local p = player()
        return p and (p:GetAttribute("DialogueInputLocked") == true or p:GetAttribute("ItemInspecting") == true)
    end

    -- live 2026-11-18: inside the yacht (scene YachtInterior) the checkpoint stays off until howler's client-side escort arrives (YachtEscort.lua:681-835);
    -- far away (at a side quest) his copy fell through the unstreamed yacht and sat at a waypoint for good, and the walk finished within 10 s of us waiting by the boarding spot
    local function escortWait(prompt)
        if attr("HowlerSceneName") ~= "YachtInterior" then return false end
        local gameRoot = Workspace:FindFirstChild("Game")
        local npcs = gameRoot and gameRoot:FindFirstChild("NPCs")
        local host = nil
        for _, m in ipairs(npcs and npcs:GetChildren() or {}) do
            if m.Name == "Howler" and not m:GetAttribute("ClientStoryScene") then host = m end
        end
        if not host then return false end
        Q.say("Waiting for Howler's escort")
        local ok = World.travelTo(host:GetPivot().Position + Vector3.new(0, 3, -6), { token = Q.token })
        if not ok then return false end
        return D.waitFor(function() return prompt.Parent ~= nil and prompt.Enabled end, ESCORT_WAIT) == true
    end

    -- live 2026-11-18: 46_Meet ("Rejoin the crew") has no prompt at all; standing on HowlerStoryTarget moved it on to 47_Arrest within 4 s
    local REACH_WAIT = 12
    local function reachTarget(key)
        local target = asPosition(attr("HowlerStoryTarget"))
        if not target then return false, "no_prompt" end
        unseat()
        Q.say("Going to " .. D.sanitize(attr("HowlerStoryCheckpoint") or "the marker"))
        local ok, err = World.travelTo(target + Vector3.new(0, 2, 0), { token = Q.token })
        if not ok then return false, err end
        if D.waitFor(function() return attr("HowlerStoryCheckpointKey") ~= key end, REACH_WAIT) then return true end
        return false, "no_prompt"
    end

    local function pressCheckpoint(key)
        local checkpoint = checkpointPrompt(key)
        local prompt = checkpoint or worldPrompt()
        if not prompt then return reachTarget(key) end
        local at = promptPosition(prompt)
        if not at then return false, "no_prompt" end
        unseat()
        Q.say("Going to " .. D.sanitize(attr("HowlerStoryCheckpoint") or "the checkpoint"))
        local ok, err = World.travelTo(at + Vector3.new(0, 2, PROMPT_SIDE), { token = Q.token })
        if not ok then return false, err end
        if not D.waitFor(function() return prompt.Parent ~= nil and prompt.Enabled end, ENABLE_WAIT) then
            if not escortWait(prompt) then return false, "prompt_off" end
            World.travelTo(at + Vector3.new(0, 2, PROMPT_SIDE), { token = Q.token })
            if not D.waitFor(function() return prompt.Parent ~= nil and prompt.Enabled end, ENABLE_WAIT) then return false, "prompt_off" end
        end
        -- a world prompt (KeyWestTrail) does its work on the press; there is no dialogue to answer
        if not checkpoint then
            return World.firePrompt(prompt)
        end
        -- live 2026-11-18: a press sometimes opens nothing (the first try at 38_QueenReference sat 14 s before the retry); no dialogue or page after it, it's pressed again
        local opened = false
        for _ = 1, 2 do
            local fired, ferr = World.firePrompt(prompt)
            if not fired then return false, ferr end
            opened = D.waitFor(answered, ANSWER_WAIT) == true
            if opened then break end
        end
        if not opened then return false, "no_dialogue" end
        -- a dialogue checkpoint finishes on its reply; an inspection or records page is answered by Puzzles.lua and the reply is refused harmlessly
        Activities.step("Howler Dialogue Reply", key)
        D.sleep(1)
        D.closeDialogue()
        return true
    end

    local function crates()
        local p = player()
        local scope = p and ("solo:" .. tostring(p.UserId))
        local gameRoot = Workspace:FindFirstChild("Game")
        local map = gameRoot and gameRoot:FindFirstChild("Map")
        local root = References.humanoidRootPart
        local from = root and root.Position
        local best, bestD = nil, math.huge
        for _, m in ipairs(map and map:GetChildren() or {}) do
            if m:IsA("Model") and m:GetAttribute("StoryCrateScope") == scope then
                local d = from and (m:GetPivot().Position - from).Magnitude or 0
                if d < bestD then best, bestD = m, d end
            end
        end
        if not best then return false, "no_crate" end
        unseat()
        Q.say("Smashing crates")
        local cf, size = best:GetBoundingBox()
        for _ = 1, CRATE_SWINGS do
            if not best.Parent then return true end
            World.travelTo(cf.Position + Vector3.new(0, size.Y / 2 + CRATE_ABOVE, CRATE_SIDE), { token = Q.token })
            if Combat and Combat.heavySwing then Combat.heavySwing({ aim = cf.Position }) end
            if not D.sleep(SWING_GAP) then return false, "stopped" end
        end
        return best.Parent == nil
    end

    -- Game.Vehicles model with StoryBoatScope = solo:<UserId> (StoryInteractions.lua:1418-1484)
    local function storyBoat()
        local p = player()
        local gameRoot = Workspace:FindFirstChild("Game")
        local vehicles = gameRoot and gameRoot:FindFirstChild("Vehicles")
        for _, v in ipairs(vehicles and vehicles:GetChildren() or {}) do
            if p and v:GetAttribute("StoryBoatScope") == "solo:" .. tostring(p.UserId) then return v end
        end
        return nil
    end

    local function seatedIn(boat)
        local hum = References.humanoid
        return hum and hum.SeatPart ~= nil and hum.SeatPart:IsDescendantOf(boat) and hum.SeatPart:IsA("VehicleSeat")
    end

    local function board()
        local boat = storyBoat()
        if not boat then return false, "no_boat" end
        if seatedIn(boat) then return true end
        local seat = boat:FindFirstChild("DriverSeat", true)
        local prompt = seat and seat:FindFirstChildWhichIsA("ProximityPrompt", true)
        if not prompt then return false, "no_seat" end
        Q.say("Taking the boat's wheel")
        local ok, err = World.travelTo((seat.CFrame * CFrame.new(-3, 2, 0)).Position, { token = Q.token })
        if not ok then return false, err end
        if not D.waitFor(function() return prompt.Enabled end, ENABLE_WAIT) then return false, "prompt_off" end
        World.firePrompt(prompt)
        return D.waitFor(function() return seatedIn(boat) end, 3) == true
    end

    local function stopDrive()
        if bound then
            bound = false
            pcall(RunService.UnbindFromRenderStep, RunService, DRIVE_BIND)
        end
    end

    local function drive()
        local boat = storyBoat()
        if not boat then return false, "no_boat" end
        if not seatedIn(boat) then
            local ok, err = board()
            if not ok then return false, err end
        end
        local seat = References.humanoid.SeatPart
        local state = {}
        local startKey = attr("HowlerStoryCheckpoint")
        -- Boats.lua:467-504 reads the seat's ThrottleFloat/SteerFloat at PreSimulation; written after the player module's render step it's ours
        local focusAt = -math.huge
        RunService:BindToRenderStep(DRIVE_BIND, Enum.RenderPriority.Last.Value, function() -- scheduler:allow (runs after the player module's vehicle controller)
            if not (seat.Parent and seatedIn(boat)) then return end
            if os.clock() - focusAt >= FOCUS_EVERY and Q.UserInputService then
                focusAt = os.clock()
                Executor.call("firesignal", Q.UserInputService.WindowFocused)
            end
            local target = asPosition(attr("HowlerStoryTarget"))
            if not target then return end
            local cf = boat:GetPivot()
            local flatTo = (target - cf.Position) * Vector3.new(1, 0, 1)
            local flatLook = cf.LookVector * Vector3.new(1, 0, 1)
            if flatTo.Magnitude < 1e-3 or flatLook.Magnitude < 1e-3 then return end
            local throttle, steer = H.boatInput(state, os.clock(), flatTo, flatLook, tonumber(boat:GetAttribute("BoatSpeed")) or 0)
            seat.ThrottleFloat = throttle
            seat.SteerFloat = steer
        end)
        bound = true
        Q.say("Driving to " .. D.sanitize(string.gsub(startKey or "the marker", "^[Dd]rive to ", "")))
        local moved = D.waitFor(function() return attr("HowlerStoryCheckpoint") ~= startKey end, DRIVE_LIMIT)
        stopDrive()
        if seat.Parent then seat.ThrottleFloat, seat.SteerFloat = 0, 0 end
        return moved == true, moved and nil or "drive_timeout"
    end

    -- seated in the story boat for as long as the checkpoint stays; the pass keeps the movement claim the whole time, so no other farm can move us off
    local STAY_LIMIT = 180
    local function stay()
        local boat = storyBoat()
        if not boat then return false, "no_boat" end
        if not seatedIn(boat) then
            local ok, err = board()
            if not ok then return false, err end
        end
        local key = attr("HowlerStoryCheckpointKey")
        Q.say("Staying aboard")
        local moved = D.waitFor(function()
            if attr("HowlerStoryCheckpointKey") ~= key then return true end
            if not seatedIn(boat) then board() end
            return false
        end, STAY_LIMIT)
        return moved == true, moved and nil or "stay_timeout"
    end

    -- Map.KeyWestArena.Markers.Pool (PoolSurface 28 x 26); live, she walked in within 3 s and the checkpoint moved to 46_Meet
    local POOL_WAIT = 40
    local function pool()
        local gameRoot = Workspace:FindFirstChild("Game")
        local map = gameRoot and gameRoot:FindFirstChild("Map")
        local arena = map and map:FindFirstChild("KeyWestArena")
        local markers = arena and arena:FindFirstChild("Markers")
        local marker = markers and markers:FindFirstChild("Pool")
        local at = marker and marker:IsA("BasePart") and marker.Position or asPosition(attr("HowlerStoryTarget"))
        if not at then return false, "no_pool" end
        unseat()
        Q.say("Luring Key West into the pool")
        local key = attr("HowlerStoryCheckpointKey")
        local ok, err = World.travelTo(at + Vector3.new(0, 2, 0), { token = Q.token })
        if not ok then return false, err end
        return D.waitFor(function() return attr("HowlerStoryCheckpointKey") ~= key end, POOL_WAIT) == true
    end

    -- one attempt at whatever the howler checkpoint asks for; (true) when it acted, (false, why) otherwise
    function R.run()
        local key = attr("HowlerStoryCheckpointKey")
        if type(key) ~= "string" or key == "" then return false, "no_checkpoint" end
        local kind = H.kindOf(attr("HowlerStoryCheckpoint"))
        if kind == "crates" then return crates() end
        if kind == "board" then return board() end
        if kind == "drive" then return drive() end
        if kind == "fight" then return true end
        if kind == "pool" then return pool() end
        if kind == "stay" then return stay() end
        return pressCheckpoint(key)
    end

    R.stop = stopDrive
    return R
end

return H

end)
__bundle_register("Features/Auto/Quests/Driver", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto quests driver: the generic objective driver keyed by objective tag (talk, interact, reach, defeat, hand-in, howler checkpoint), plus the waits every step shares; a step only counts once the server's quest state changes, and a step that keeps failing is parked instead of retried forever
local Executor = require("Utility/Executor")
local Identity = require("Utility/Identity")
local GameHud  = require("Utility/GameHud")

local POLL          = 0.25
local STEP_TIMEOUT  = 12
local PROMPT_WAIT   = 4
local SPAWN_WAIT    = 8
local TOUCH_AFTER   = 2.5
local TALK_GAP      = 0.5
-- the client enables a story prompt on its own eligibility pass after you arrive
local DIALOGUE_WAIT = 1.5
local TRACK_AGAIN   = 10
local TRACKER_WAIT  = 1.5
local RETRY_PAUSE   = 2
local MAX_TRIES     = 3
local BLOCK_FOR     = 90
local CLEAR_RADIUS  = 120
local HOWLER_RADIUS = 40
local NEAR_ENOUGH   = 15

-- every story talk key: the npc it is said to and each key that dialogue branch sends, in order (DialogueInfo.lua:446-537, 921-1012)
local TALKS = {
    Meryl                 = { npc = "Meryl Mei Qi", keys = { "MerylPhone", "Meryl" } },
    MerylPhone            = { npc = "Meryl Mei Qi" },
    MerylStolenItems      = { npc = "Meryl Mei Qi" },
    MerylHowlerDocuments  = { npc = "Meryl Mei Qi" },
    JodioDiamotch         = { npc = "Jodio" },
    JodioGotIt            = { npc = "Jodio" },
    JodioLandDeeds        = { npc = "Jodio" },
    JodioHospital         = { npc = "Jodio" },
    DiamotchEmployee      = { npc = "Diamotch Clerk" },
    DiamotchClerkBackRoom = { npc = "Diamotch Clerk" },
    DiamotchMistaken      = { npc = "Diamotch Clerk" },
    LandRegistryClerk     = { npc = "Land Registry Clerk" },
    DiamotchGuardAccuse   = { npc = "Diamotch Accusation" },
    DiamotchGuardDeny     = { npc = "Diamotch Accusation" },
}

local function sanitize(text)
    return (tostring(text):gsub("[<>]", ""))
end

local function contains(csv, value)
    if type(csv) ~= "string" then return false end
    for entry in string.gmatch(csv, "[^,]+") do
        if entry == value then return true end
    end
    return false
end

local function asPosition(value)
    local kind = typeof(value)
    if kind == "Vector3" then return value end
    if kind == "CFrame" then return value.Position end
    return nil
end

return function(Q)
    local Activities = Q.Activities
    local World      = Q.World
    local Player     = Q.Player
    local Combat     = Q.Combat
    local References = Q.References
    local Workspace  = Q.Workspace

    local D = { TALKS = TALKS, STEP_TIMEOUT = STEP_TIMEOUT, sanitize = sanitize }

    local tries, blockedUntil, blockedWhy = {}, {}, {}
    local trackedId, trackedAt = nil, -math.huge

    function D.sleep(seconds)
        local job = Q.job
        if not job then return false end
        return job:sleep(seconds) == true
    end

    -- plain: a live character the server still counts as alive
    function D.alive()
        local char, hum = References.character, References.humanoid
        if not (char and char.Parent and hum and hum.Health > 0) then return false end
        if Combat and Combat.alive then return Combat.alive() == true end
        return true
    end

    -- yields until cond() answers something truthy; (false, "died") the moment the character dies, (false, "stopped") on cancel
    function D.waitFor(cond, timeout)
        local deadline = os.clock() + timeout
        while true do
            local value = cond()
            if value then return value end
            if not D.alive() then return false, "died" end
            if os.clock() >= deadline then return false, "timeout" end
            if not D.sleep(POLL) then return false, "stopped" end
        end
    end

    -- one string for the whole active list and every objective count, so any server-side progress reads as a change
    function D.fingerprint()
        local ok, list = Activities.quests()
        if not ok then return nil end
        local parts = {}
        for _, q in ipairs(list) do
            local tags = {}
            for tag, n in pairs(q.objectives or {}) do tags[#tags + 1] = tag .. "=" .. tostring(n) end
            table.sort(tags)
            parts[#parts + 1] = q.id .. "{" .. table.concat(tags, ";") .. "}"
        end
        return table.concat(parts, ",")
    end

    function D.waitChange(before, timeout)
        if before == nil then return false end
        return D.waitFor(function()
            local now = D.fingerprint()
            return now ~= nil and now ~= before
        end, timeout)
    end

    function D.activeQuests()
        local ok, list = Activities.quests()
        if not ok then return nil end
        return list
    end

    function D.isActive(id)
        local list = D.activeQuests()
        if not list then return false end
        for _, q in ipairs(list) do
            if q.id == id then return true end
        end
        return false
    end

    -- the first objective still short of its total, in the quest's own reveal order
    function D.nextObjective(q)
        local def = q.definition
        local order = def and type(def.ObjectiveOrder) == "table" and def.ObjectiveOrder or nil
        if not order then
            order = {}
            for tag in pairs(q.totals or {}) do order[#order + 1] = tag end
            table.sort(order)
        end
        for _, tag in ipairs(order) do
            local need = tonumber((q.totals or {})[tag]) or 1
            local have = tonumber((q.objectives or {})[tag]) or 0
            if have < need then return tag, have, need end
        end
        return nil
    end

    function D.label(q, tag)
        local def = q.definition
        local labels = def and type(def.ObjectiveLabels) == "table" and def.ObjectiveLabels or nil
        local text = labels and labels[tag]
        if type(text) ~= "string" or text == "" then text = tag end
        return sanitize(text)
    end

    -- retry bookkeeping: a key that failed MAX_TRIES times is parked for BLOCK_FOR
    function D.blocked(key)
        local untilAt = blockedUntil[key]
        if untilAt and os.clock() < untilAt then return true, blockedWhy[key] end
        if untilAt then
            blockedUntil[key], blockedWhy[key], tries[key] = nil, nil, nil
        end
        return false
    end

    function D.failed(key, why)
        local n = (tries[key] or 0) + 1
        tries[key] = n
        if n >= MAX_TRIES then
            blockedUntil[key] = os.clock() + BLOCK_FOR
            blockedWhy[key] = why
            tries[key] = 0
            return true
        end
        return false
    end

    function D.succeeded(key)
        tries[key], blockedUntil[key], blockedWhy[key] = nil, nil, nil
    end

    function D.tries(key)
        return tries[key] or 0
    end

    function D.forget()
        tries, blockedUntil, blockedWhy = {}, {}, {}
        trackedId, trackedAt = nil, -math.huge
    end

    function D.gamePath(path)
        local node = Workspace:FindFirstChild("Game")
        for _, name in ipairs(path) do
            if not node then return nil end
            node = node:FindFirstChild(name)
        end
        return node
    end

    function D.positionOf(inst)
        if not (inst and inst.Parent) then return nil end
        if inst:IsA("BasePart") then return inst.Position end
        if inst:IsA("Model") then return inst:GetPivot().Position end
        return nil
    end

    -- live 2026-11-17: story actors spawn per player as "<Name> <n> [<scene>:<uuid>]", so an exact miss falls back to the nearest npc whose name starts with it
    function D.npc(name)
        local ok, model = World.npc(name)
        if ok then return model end
        local folder = D.gamePath({ "NPCs" })
        if not folder then return nil end
        local root = References.humanoidRootPart
        local best, bestDistance = nil, math.huge
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("Model") and string.sub(child.Name, 1, #name) == name then
                local distance = root and (child:GetPivot().Position - root.Position).Magnitude or 0
                if distance < bestDistance then best, bestDistance = child, distance end
            end
        end
        return best
    end

    -- the phone's marker for this quest (tracked first), then the definition's own static tracker
    function D.locate(q)
        local okT, tracker = Activities.tracker()
        if okT and tracker.questId ~= q.id and (trackedId ~= q.id or os.clock() - trackedAt > TRACK_AGAIN) then
            trackedId, trackedAt = q.id, os.clock()
            Activities.track(q.id)
            D.waitFor(function()
                local ok, t = Activities.tracker()
                return ok and t.questId == q.id
            end, TRACKER_WAIT)
            okT, tracker = Activities.tracker()
        end
        if okT and tracker.questId == q.id and asPosition(tracker.position) then return tracker.position end
        local def = q.definition
        local static = def and type(def.Trackers) == "table" and def.Trackers[1] or nil
        return asPosition(static)
    end

    -- yields; (false, "died") when the character dies on the way
    -- a tracker point can sit inside a wall or in the air, so landing near it counts: the world's own arrival test is strict to 4 studs
    function D.goTo(target, name, opts)
        if name then Q.say("Going to " .. name) end
        local travel = { token = Q.token }
        if opts then
            for k, v in pairs(opts) do travel[k] = v end
        end
        local ok, err = World.travelTo(target, travel)
        if ok then return true end
        if not D.alive() then return false, "died" end
        local goal = asPosition(target) or (typeof(target) == "Instance" and D.positionOf(target)) or nil
        local root = References.humanoidRootPart
        if err == "world/not_arrived" and goal and root and (root.Position - goal).Magnitude <= NEAR_ENOUGH then return true end
        return false, err
    end

    -- the npc's live model, travelling to where the quest points first when it hasn't streamed in
    function D.reachNpc(q, name, fallback)
        local model = D.npc(name)
        if not model then
            local position = (q and D.locate(q)) or fallback
            if not position then return nil, "lost" end
            local ok, err = D.goTo(position, name)
            if not ok then return nil, err end
            model = D.waitFor(function() return D.npc(name) end, SPAWN_WAIT)
            if not model then return nil, "missing" end
        end
        local ok, err = D.goTo(model, name)
        if not ok then return nil, err end
        return model
    end

    -- the game's own cleanup runs when its Dialogue gui is disabled (DialogueHandler.lua:1069-1084: clearDialogue, then DialogueInputLocked false); a direct talk step never clicks a choice, so the box it opened would otherwise lock input for good
    function D.closeDialogue()
        local player = References.player
        local gui = player and player:FindFirstChild("PlayerGui")
        local dialogue = gui and gui:FindFirstChild("Dialogue")
        if not (dialogue and dialogue:IsA("ScreenGui") and dialogue.Enabled) then return false end
        Identity.elevate()
        local ok = pcall(function() dialogue.Enabled = false end)
        -- live 2026-11-19 (user: the hp/moves/money hud sometimes vanishes): disabling the dialogue skips the close that fades the hud back in
        if ok then GameHud.restoreAfterClose(player) end
        return ok
    end

    -- live 2026-11-17: d'arby's open table holds QTEInputLocked for as long as you sit at it, and the wager is played right there
    function D.atTable()
        if not Activities.standStorage then return false end
        local ok, st = Activities.standStorage()
        return ok and type(st) == "table" and st.state ~= nil
    end

    -- input locked by nothing but a dialogue box: the only kind of busy auto quests clears itself
    function D.onlyDialogue()
        local ok, locks = Player.locks()
        if not ok or type(locks) ~= "table" or not locks.DialogueInputLocked then return false end
        for name, on in pairs(locks) do
            if on and name ~= "DialogueInputLocked" and name ~= "MenuCursorUnlocked" then return false end
        end
        return true
    end

    function D.talk(q, key, spec)
        spec = spec or TALKS[key]
        if not spec then return false, "unknown_talk" end
        local model, err = D.reachNpc(q, spec.npc)
        if not model then return false, err end
        Q.say("Talking to " .. spec.npc)
        -- live 2026-11-17: a story npc's StoryServerDialogue prompt opens the server's dialogue first, then the talk key completes the objective
        local prompt = D.waitFor(function() return D.promptUnder(model, q, { serverDialogue = true }) end, DIALOGUE_WAIT)
        if prompt and Activities.storyDialogue(prompt) and not D.sleep(TALK_GAP) then return false, "stopped" end
        for i, k in ipairs(spec.keys or { key }) do
            if i > 1 and not D.sleep(TALK_GAP) then return false, "stopped" end
            local ok, code = Activities.step("Talked", k)
            if not ok then return false, code end
        end
        D.closeDialogue()
        return true
    end

    -- the prompt the client would show for this quest: enabled, ours, and tagged for an active quest when it says which
    function D.eligible(rec, q, opts)
        local prompt = rec.prompt
        local ids = prompt:GetAttribute("StoryQuestIds")
        if ids ~= nil and q and not contains(ids, q.id) then return false end
        local owner = prompt:GetAttribute("StoryPromptOwnerId")
        if owner ~= nil and owner ~= References.player.UserId then return false end
        if prompt:GetAttribute("StoryPromptAvailable") == false then return false end
        if opts.action and prompt:GetAttribute("StoryAction") ~= opts.action then return false end
        if opts.serverDialogue and prompt:GetAttribute("StoryServerDialogue") ~= true then return false end
        if opts.parentName and not (prompt.Parent and prompt.Parent.Name == opts.parentName) then return false end
        return true
    end

    function D.promptUnder(root, q, opts)
        local ok, recs = World.prompts({ root = root })
        if not ok then return nil end
        for _, rec in ipairs(recs) do
            if D.eligible(rec, q, opts or {}) then return rec.prompt end
        end
        return nil
    end

    function D.promptNear(position, radius, q, opts)
        local ok, recs = World.prompts({ near = position, radius = radius })
        if not ok then return nil end
        for _, rec in ipairs(recs) do
            if D.eligible(rec, q, opts or {}) then return rec.prompt end
        end
        return nil
    end

    -- the client only enables a story prompt once you are inside its range, so travel first and give it a moment
    function D.fireAt(root, q, opts, name)
        local ok, err = D.goTo(root, name)
        if not ok then return false, err end
        local prompt = D.waitFor(function() return D.promptUnder(root, q, opts) end, PROMPT_WAIT)
        if not prompt then
            if not D.alive() then return false, "died" end
            return false, "no_prompt"
        end
        Q.say("Using " .. (name or "it"))
        return World.firePrompt(prompt)
    end

    local function resolveRoots(paths)
        local out = {}
        for _, path in ipairs(paths) do
            local inst = D.gamePath(path)
            if inst then out[#out + 1] = inst end
        end
        return out
    end

    -- QuestInteractables first, then the diamotch story map (HandlerQuest.lua:385-419)
    function D.interactPaths(x)
        -- live 2026-11-17: a tagged objective part can carry no prompt while its "<name>Visual" twin in the story map does (DiamotchFloorWatch)
        return { { "QuestInteractables", x }, { "Map", "DiamotchStory", x }, { "Map", "DiamotchStory", x .. "Visual" } }
    end

    -- the containers story objective prompts live in, including the per-player "[solo:<UserId>]" scene copies the client clones
    local OBJECTIVE_HOMES = { { "QuestInteractables" }, { "StoryLocations" } }

    -- each story chapter keeps its scene under Map (DiamotchStory, DiamotchStoryNodes, LandRegistryStory, ...)
    local function objectiveHomes()
        local homes = {}
        for _, path in ipairs(OBJECTIVE_HOMES) do homes[#homes + 1] = D.gamePath(path) end
        local map = D.gamePath({ "Map" })
        if map then
            for _, child in ipairs(map:GetChildren()) do
                if string.find(child.Name, "Story", 1, true) then homes[#homes + 1] = child end
            end
        end
        return homes
    end

    -- live 2026-11-17: the prompt for an objective tag can sit on a solo scene copy or a chapter's scene rather than the tagged part, so find it by its tag
    function D.objectivePrompt(q, x)
        local root = References.humanoidRootPart
        local best, bestDistance = nil, math.huge
        for _, home in ipairs(objectiveHomes()) do
            if home then
                for _, d in ipairs(home:GetDescendants()) do
                    if d:IsA("ProximityPrompt") and d.Enabled then
                        local tag = d:GetAttribute("ObjectiveTag") or (d.Parent and d.Parent:GetAttribute("ObjectiveTag"))
                        if tag == x and D.eligible({ prompt = d }, q, {}) then
                            local spot = D.positionOf(d.Parent) or (d.Parent and d.Parent:IsA("Attachment") and d.Parent.WorldPosition)
                            if spot and spot.Magnitude > 5 then
                                local distance = root and (spot - root.Position).Magnitude or 0
                                if distance < bestDistance then best, bestDistance = d, distance end
                            end
                        end
                    end
                end
            end
        end
        return best
    end

    local function fireObjective(q, x, name)
        local prompt = D.objectivePrompt(q, x)
        if not prompt then return false, "no_prompt" end
        local parent = prompt.Parent
        local spot = D.positionOf(parent) or (parent:IsA("Attachment") and parent.WorldPosition)
        local ok, err = D.goTo(spot, name, { offset = 2 })
        if not ok then return false, err end
        Q.say("Using " .. (name or "it"))
        return World.firePrompt(prompt)
    end

    function D.interact(q, x, opts)
        opts = opts or {}
        if not opts.paths then
            local ok, err = fireObjective(q, x, opts.name or x)
            if ok then return true end
            if err == "died" or err == "stopped" then return false, err end
        end
        local paths = opts.paths or D.interactPaths(x)
        local roots = resolveRoots(paths)
        if #roots == 0 then
            local position = D.locate(q)
            if not position then return false, "lost" end
            local ok, err = D.goTo(position, opts.name or x)
            if not ok then return false, err end
            roots = D.waitFor(function()
                local found = resolveRoots(paths)
                return #found > 0 and found or nil
            end, SPAWN_WAIT)
            if not roots then return false, "missing" end
        end
        local lastErr = "no_prompt"
        for _, root in ipairs(roots) do
            local ok, err = D.fireAt(root, q, opts, opts.name or x)
            if ok then return true end
            if err == "died" or err == "stopped" then return false, err end
            lastErr = err
        end
        return false, lastErr
    end

    function D.zone(x)
        local ok, list = World.destinations("quest_zone")
        if not ok then return nil end
        for _, rec in ipairs(list) do
            if rec.name == x then return rec.instance end
        end
        return nil
    end

    -- no client code touches QuestZones, so a teleport that the server's touch check missed gets one touch pair
    function D.reach(q, x, before)
        local zone = D.zone(x)
        if not zone then
            local position = D.locate(q)
            if not position then return false, "lost" end
            return D.goTo(position, D.label(q, "Reach_" .. x))
        end
        local ok, err = D.goTo(zone, x)
        if not ok then return false, err end
        if D.waitChange(before, TOUCH_AFTER) then return true end
        local root = References.humanoidRootPart
        if zone:IsA("BasePart") and root and root.Parent then
            Executor.call("firetouchinterest", root, zone, 0)
            Executor.call("firetouchinterest", root, zone, 1)
        end
        return true
    end

    local function findTarget(spec)
        if spec.attribute then
            local ok, models = World.combatants({ npcs = true, alive = true })
            if not ok then return nil end
            for _, model in ipairs(models) do
                if model:GetAttribute(spec.attribute) == (spec.value == nil and true or spec.value) then return model end
            end
            return nil
        end
        if spec.name then
            local ok, model = World.nearest({ name = spec.name, alive = true })
            if ok then return model end
        end
        -- live 2026-11-18: story fighters spawn as "<Name>_<n>" (Ningbo_2965, Laem Chabang_718) and aren't hostile until aggroed; matched by name prefix
        if spec.prefixes then
            local ok, models = World.combatants({ npcs = true, alive = true })
            if not ok then return nil end
            for _, prefix in ipairs(spec.prefixes) do
                for _, model in ipairs(models) do
                    if string.sub(model.Name, 1, #prefix) == prefix then return model end
                end
            end
        end
        return nil
    end

    -- a named or marked enemy is fought one at a time; a nameless pack near the marker is cleared
    function D.defeat(q, tag, spec)
        spec = spec or {}
        local engine = Q.engine()
        if not engine then return false, "no_engine" end
        local name = spec.label or spec.name or string.match(tag, "^Defeat (.+)$") or tag
        local look = { attribute = spec.attribute, value = spec.value, name = spec.name, prefixes = spec.prefixes }
        if not look.attribute and not spec.hostileNear and not look.name and not look.prefixes then look.name = name end
        -- a named group (prefixes) is fought one after another until none is left
        if look.prefixes then
            local wins = 0
            local target = findTarget(look)
            if not target then
                local position = D.locate(q)
                if position then
                    local ok, err = D.goTo(position, name)
                    if not ok then return false, err end
                end
                target = D.waitFor(function() return findTarget(look) end, SPAWN_WAIT)
            end
            while target do
                Q.say("Fighting " .. D.sanitize((string.gsub(target.Name, "_%d+$", ""))))
                local ok, reason = engine.fight(target, { owner = Q.owner, token = Q.token })
                if not D.alive() then return false, "died" end
                if not ok then return false, reason end
                wins = wins + 1
                target = findTarget(look)
            end
            if wins > 0 then return true end
            return false, "missing"
        end
        local target = findTarget(look)
        if not target then
            local position = D.locate(q)
            if position then
                local ok, err = D.goTo(position, name)
                if not ok then return false, err end
            end
            target = D.waitFor(function() return findTarget(look) end, SPAWN_WAIT)
            if not D.alive() then return false, "died" end
        end
        if target then
            Q.say("Fighting " .. name)
            local ok, reason = engine.fight(target, { owner = Q.owner, token = Q.token })
            if ok then return true end
            if not D.alive() then return false, "died" end
            return false, reason
        end
        if spec.hostileNear then
            Q.say("Fighting " .. name)
            local ok, reason, kills = engine.clear({ npcs = true, hostileOnly = true, alive = true, maxDistance = CLEAR_RADIUS }, { owner = Q.owner, token = Q.token })
            if ok and (tonumber(kills) or 0) > 0 then return true end
            if ok then return false, "missing" end
            if not D.alive() then return false, "died" end
            return false, reason
        end
        return false, "missing"
    end

    -- DialogueInfo.lua:1382-1386: the hand-in is said to the quest's giver with the whole amount
    function D.handIn(q, item, need)
        local okCount, have = Player.count(item)
        if not okCount then return false, have end
        if have < need then return false, "need", ("Need %d %s"):format(need, sanitize(item)) end
        local giver = q.definition and q.definition.QuestGiver
        if type(giver) == "string" then
            local model, err = D.reachNpc(q, giver)
            if not model then return false, err end
        end
        Q.say("Handing in " .. sanitize(item))
        return Activities.handIn(item)
    end

    -- the server publishes the checkpoint; a dialogue key is a reply, anything else is the checkpoint prompt at the marker
    function D.howler(q)
        local key = Player.playerAttr("HowlerStoryCheckpointKey")
        if type(key) ~= "string" or key == "" then return false, "no_checkpoint" end
        local position = D.locate(q)
        if position then
            local ok, err = D.goTo(position, "the checkpoint")
            if not ok then return false, err end
        end
        local ok, code = Activities.step("Howler Dialogue Reply", key)
        if ok then return true end
        if code ~= Activities.Errors.BAD_ARGS then return false, code end
        local here = References.humanoidRootPart
        local from = position or (here and here.Position)
        if not from then return false, "lost" end
        local prompt = D.waitFor(function()
            return D.promptNear(from, HOWLER_RADIUS, q, { action = "HowlerCheckpoint" })
        end, PROMPT_WAIT)
        if not prompt then return false, "no_prompt" end
        Q.say("Using the checkpoint")
        return World.firePrompt(prompt)
    end

    -- which generic handler a tag gets; nil means nobody here can do it
    function D.handlerFor(q, tag, need, spec)
        spec = spec or {}
        if spec.run then return spec.run end
        local key = string.match(tag, "^Talked_(.+)$")
        if key then
            if not TALKS[key] then return nil end
            return function() return D.talk(q, key) end
        end
        local x = string.match(tag, "^Interact_(.+)$")
        if x then return function() return D.interact(q, x, spec) end end
        x = string.match(tag, "^Reach_(.+)$")
        if x then return function(before) return D.reach(q, spec.zone or x, before) end end
        if string.match(tag, "^Defeat ") then return function() return D.defeat(q, tag, spec) end end
        local item = string.match(tag, "^Has_(.+)$")
        if item then return function() return D.handIn(q, item, need) end end
        if string.match(tag, "^Howler_") or string.match(tag, "^KeyWest_") then
            -- live 2026-11-18: the bare reply never moved the story; the howler steps go on the server's checkpoint (Howler.lua)
            if D.howlerSteps then return function() return D.howlerSteps.run() end end
            return function() return D.howler(q) end
        end
        return nil
    end

    -- one attempt at one objective: run it, then wait for the server to move; (true) on progress, (false, why, label) otherwise
    function D.drive(q, tag, need, spec)
        local key = q.id .. "|" .. tag
        local parked, why = D.blocked(key)
        if parked then return false, "blocked", why end
        local run = D.handlerFor(q, tag, need, spec)
        if not run then return false, "manual" end
        Q.current = q.id
        local before = D.fingerprint()
        local ok, err, label = run(before)
        if not D.alive() or err == "died" then return false, "died" end
        if err == "stopped" then return false, "stopped" end
        if ok then
            Q.say("Waiting on the server")
            if D.waitChange(before, (spec and spec.timeout) or STEP_TIMEOUT) then
                D.succeeded(key)
                return true
            end
            if not D.alive() then return false, "died" end
            err = "no_change"
        end
        local parkedNow = D.failed(key, label)
        if not parkedNow then D.sleep(RETRY_PAUSE) end
        return false, parkedNow and "blocked" or err, label
    end

    return D
end

end)
__bundle_register("Features/Auto/Quests/Bounties", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto quests bounties: petyr's board one step a pass; takes the first bounty whose steps it can drive, follows the game's own bounty marker (VisibleBountyTrackerPosition), fights the enemies stamped with your BountyId, fires your own "Bounty..._<UserId>" prompts and claims at petyr; incident puzzles go to Incidents one phase a pass
local Darby        = require("Features/Auto/Quests/Darby")
local Incidents    = require("Features/Auto/Quests/Incidents")

local GATE         = "P9_32_RETURN_TO_IKO_IKO"
local ACCEPT_WAIT  = 6
local PROMPT_WAIT  = 4
local STEP_WAIT    = 6
local SPAWN_WAIT   = 8
local CLAIM_WAIT   = 6
local ROTATION     = 3600
-- live 2026-11-17: the step prompts live on the npc (Interact), under Map.Deliveries (Delivery) and in your own BountyWorld.Party_<UserId> (Find)
local PROMPT_HOMES = { { "NPCs" }, { "BountyWorld" }, { "Map", "Deliveries" }, { "BountySpawns" } }
local FIGHTS       = { Summon = true, Defend = true }

return function(Q, D)
    local Activities = Q.Activities
    local World      = Q.World
    local References = Q.References

    local B = {}
    local I = Incidents(Q, D)
    -- live 2026-11-17: "D'ARBY'S REMATCH" is a Type=GoFish step, the same wager the story plays (StandStorage.lua:680 allows it while Wager.Bounty is set)
    local G = Darby(Q, D)

    local function myPrompt(prompt)
        local suffix = "_" .. tostring(References.player.UserId)
        local name = prompt.Name
        return string.sub(name, 1, 6) == "Bounty" and string.sub(name, -#suffix) == suffix
    end

    local function marker()
        local value = References.player:GetAttribute("VisibleBountyTrackerPosition")
        if typeof(value) == "Vector3" then return value end
        return nil
    end

    -- a step this driver can finish on its own; a Find that needs another stand's pickup skill is not one
    local function drivableStep(step)
        if type(step) ~= "table" then return false end
        if step.Type == "Incident" then return I.drivable(step) end
        if step.Type == "Find" and step.PickupSkill ~= nil then return false end
        return true
    end

    function B.drivable(definition)
        if type(definition) ~= "table" or type(definition.Steps) ~= "table" or #definition.Steps == 0 then return false end
        for _, step in ipairs(definition.Steps) do
            if not drivableStep(step) then return false end
        end
        return true
    end

    -- a taken bounty runs on a clock (TimeLimitSeconds), so it goes ahead of other side quests
    function B.running()
        local ok, active = Activities.activeBounties()
        return ok and type(active) == "table" and active[1] ~= nil
    end

    function B.unlocked()
        local ok, done = Activities.isCompleted(GATE)
        return ok and done == true
    end

    local function current()
        local okA, active = Activities.activeBounties()
        if not okA or type(active) ~= "table" or not active[1] then return nil end
        local id = active[1]
        local okP, progress = Activities.bountyProgress()
        local entry = okP and type(progress) == "table" and progress[id] or nil
        local okB, board = Activities.bountyBoard()
        local definition = nil
        if okB then
            for _, b in ipairs(board) do
                if b.id == id then definition = b.definition end
            end
        end
        return { id = id, entry = type(entry) == "table" and entry or {}, definition = definition }
    end

    -- one string per bounty state, so any server progress reads as a change
    local function fingerprint()
        local c = current()
        if not c then return "none" end
        local e = c.entry
        return table.concat({ c.id, tostring(e.StepIndex), tostring(e.Remaining), tostring(e.StageDone), tostring(e.ReadyToClaim), tostring(e.IncidentPhase), tostring(e.IncidentDone) }, "|")
    end

    local function waitChange(before, timeout)
        return D.waitFor(function() return fingerprint() ~= before end, timeout)
    end

    -- live 2026-11-17: every tier lists the same seven bounties and a finished one reads done on all of them, so only your own tier is read
    -- plain: true when a bounty has vampires to fight (Bounty.lua "Dispose of the Vampires": Summon Vampire, which Hamon's vampire lessons count)
    function B.hasVampires(definition)
        for _, step in ipairs(type(definition) == "table" and definition.Steps or {}) do
            if type(step) == "table" and step.Target == "Vampire" then return true end
        end
        return false
    end

    local function pick()
        local ok, board = Activities.bountyBoard()
        if not ok then return nil end
        local preferVampires = Q.Toggles and Q.Toggles.AutoQuest_PreferVampire and Q.Toggles.AutoQuest_PreferVampire.Value
        -- vampires first when preferred; with none listed the rest still pay xp and loot while the board waits to rotate
        local first = nil
        for _, b in ipairs(board) do
            if not b.completed and not b.active and B.drivable(b.definition) and not D.blocked("bounty|" .. b.id) then
                if not preferVampires or B.hasVampires(b.definition) then return b end
                first = first or b
            end
        end
        return first
    end

    -- Bounty.lua:784-787: the board rotates on the server hour
    local function nextBoard()
        local Workspace = Q.Workspace
        local now = Workspace and Workspace:GetServerTimeNow() or os.time()
        return math.max(1, math.ceil((ROTATION - now % ROTATION) / 60))
    end

    local function enemies(id)
        local ok, models = World.combatants({ npcs = true, alive = true })
        local out = {}
        if not ok then return out end
        for _, model in ipairs(models) do
            if model:GetAttribute("BountyId") == id then out[#out + 1] = model end
        end
        return out
    end

    local function fight(c)
        local engine = Q.engine()
        if not engine then return false, "no_engine" end
        local list = enemies(c.id)
        if #list == 0 then
            local spot = marker()
            if spot then
                local ok, err = D.goTo(spot, "the bounty")
                if not ok then return false, err end
            end
            list = D.waitFor(function()
                local found = enemies(c.id)
                return #found > 0 and found or nil
            end, SPAWN_WAIT) or {}
            if #list == 0 then return false, "missing" end
        end
        Q.say("Fighting for the bounty")
        local ok, reason = engine.fight(list[1], { owner = Q.owner, token = Q.token })
        if ok then return true end
        if not D.alive() then return false, "died" end
        return false, reason
    end

    -- your own enabled step prompt nearest the marker, across the homes bounty prompts live in
    local function stepPrompt(spot)
        local best, bestDistance = nil, math.huge
        for _, path in ipairs(PROMPT_HOMES) do
            local home = D.gamePath(path)
            if home then
                local ok, recs = World.prompts({ root = home, near = spot })
                if ok then
                    for _, rec in ipairs(recs) do
                        if myPrompt(rec.prompt) and rec.position and (rec.distance or math.huge) < bestDistance then
                            best, bestDistance = rec, rec.distance
                        end
                    end
                end
            end
        end
        return best
    end

    local function interact(c)
        local spot = marker() or (References.humanoidRootPart and References.humanoidRootPart.Position)
        if not spot then return false, "lost" end
        local rec = stepPrompt(spot)
        if not rec then
            local ok, err = D.goTo(spot, "the bounty")
            if not ok then return false, err end
            rec = D.waitFor(function() return stepPrompt(spot) end, PROMPT_WAIT)
            if not rec then return false, "no_prompt" end
        end
        local ok, err = D.goTo(rec.position, nil, { offset = 2 })
        if not ok then return false, err end
        Q.say(rec.action ~= "" and rec.action or "Using it")
        local fired, ferr = World.firePrompt(rec.prompt)
        if not fired then return false, ferr end
        return true
    end

    local function claim(c)
        -- once every step is done the marker is the reward npc (BountyHandler.lua:1053-1056)
        local target = marker() or D.npc("Petyr")
        if not target then return false, "lost" end
        local ok, err = D.goTo(target, "Petyr")
        if not ok then return false, err end
        Q.say("Claiming the bounty")
        local okC, cerr = Activities.claimBounty()
        if not okC then return false, cerr end
        if not D.waitFor(function()
            local okA, active = Activities.activeBounties()
            return okA and not (type(active) == "table" and active[1] == c.id)
        end, CLAIM_WAIT) then return false, "not_claimed" end
        return true
    end

    local function accept()
        local b = pick()
        if not b then
            Q.waiting = ("New bounties in %dm"):format(nextBoard())
            return Q.waiting, false
        end
        Q.say("Taking " .. D.sanitize(b.name or "a bounty"))
        local ok = Activities.acceptBounty(b.id)
        if ok and D.waitFor(function()
            local c = current()
            return c and c.id == b.id
        end, ACCEPT_WAIT) then
            return "Took a bounty", true
        end
        D.failed("bounty|" .. b.id, nil)
        return "Retrying the board", true
    end

    -- (status, busy) for one step of the running bounty, or taking the next one
    function B.step()
        if not B.unlocked() then return "Bounties locked", false end
        local c = current()
        if not c then return accept() end
        local e = c.entry
        if e.ReadyToClaim then
            local ok, why = claim(c)
            if ok then return "Bounty claimed", true end
            if why == "died" then return "Waiting to respawn", true end
            return "Retrying the claim", true
        end
        local step = c.definition and c.definition.Steps and c.definition.Steps[tonumber(e.StepIndex) or 1]
        if not drivableStep(step) then return "Bounty needs you", false end
        local key = "bounty|" .. c.id .. "|" .. tostring(e.StepIndex) .. "|" .. tostring(e.IncidentPhase)
        if D.blocked(key) then return "Bounty step stuck", false end
        local before = fingerprint()
        local ok, why
        if step.Type == "GoFish" then
            ok, why = G.run(nil)
        elseif step.Type == "Incident" then
            -- Incidents.run already waited for the server to move the phase on
            ok, why = I.run(c)
            if ok then
                D.succeeded(key)
                return "Incident step done", true
            end
        elseif FIGHTS[step.Type] then
            ok, why = fight(c)
        else
            ok, why = interact(c)
        end
        if ok and waitChange(before, STEP_WAIT) then
            D.succeeded(key)
            return "Bounty step done", true
        end
        if why == "died" then return "Waiting to respawn", true end
        if why == "stopped" then return nil, true end
        if fingerprint() ~= before then
            D.succeeded(key)
            return "Bounty step done", true
        end
        D.failed(key, nil)
        return "Retrying bounty step", true
    end

    return B
end

end)
__bundle_register("Features/Auto/Quests/Incidents", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto quests incidents: petyr's incident bounties (harvest, jewelry, hey ya, verity) one phase a run; presses your party's BountyIncident_* prompts, talks to the incident npc, solves the jewelry puzzles from the server's own Puzzle push and answers berity's choices; moves only through D.goTo
local Api = require("Api")

local PHASE_WAIT  = 8
-- hey ya's "spot" phase counts IncidentDone up while you stand still (IncidentHandler.lua:1996-1998)
local HOLD_WAIT   = 25
local STREAM_WAIT = 4
local OPEN_WAIT   = 4
local REPLY_WAIT  = 3
local PUZZLE_TIME = 25
-- no open puzzle seen for this long, or the same move sent this many times unanswered, closes it for a fresh try
local PUZZLE_STALE = 3
local MOVE_REPEATS = 2
-- the game's own inspection sends a keepalive every 10 s (IncidentHandler.lua:1057-1070)
local KEEPALIVE   = 8
local POLL        = 0.25
local CATCH_TRIES = 4
local ATTACH_SETTLE = 0.4
-- already standing on the target: travelling again would break a hold-still phase
local NEAR        = 5
local PREFIX      = "BountyIncident_"
-- Bounty.lua:6 names eight scenarios; only these four sit on petyr's board (Bounty.lua:670)
local SCENARIOS   = { Harvest = true, Jewelry = true, HeyYa = true, Verity = true }
-- Bounty.lua:73
local COMPONENTS  = { "Heart", "Star", "Moon", "Clasp" }

return function(Q, D)
    local Activities = Q.Activities
    local World      = Q.World
    local Player     = Q.Player
    local References = Q.References

    local I = {}

    function I.drivable(step)
        return type(step) == "table" and step.Type == "Incident" and SCENARIOS[step.Scenario] == true
    end

    local function fresh(id)
        local ok, progress = Activities.bountyProgress()
        local e = ok and type(progress) == "table" and progress[id] or nil
        return type(e) == "table" and e or nil
    end

    local function targetOf(e)
        local t = e and e.TargetPos
        if type(t) ~= "table" or type(t.x) ~= "number" or type(t.y) ~= "number" or type(t.z) ~= "number" then return nil end
        return Vector3.new(t.x, t.y, t.z)
    end

    -- any server progress on the incident reads as a change; TargetPos is left out because it can follow a moving target
    function I.fingerprint(e)
        if not e then return "gone" end
        return table.concat({
            tostring(e.StepIndex), tostring(e.IncidentPhase), tostring(e.IncidentDone), tostring(e.IncidentToken),
            tostring(e.IncidentObjective), tostring(e.IncidentNPC), tostring(e.ReadyToClaim),
        }, "|")
    end

    local function phaseOf(e)
        if not e then return "gone" end
        return tostring(e.IncidentPhase) .. "|" .. tostring(e.ReadyToClaim) .. "|" .. tostring(e.IncidentToken)
    end

    local function near(spot)
        local root = References.humanoidRootPart
        return root and root.Parent and (root.Position - spot).Magnitude <= NEAR or false
    end

    -- IncidentHandler.lua:2213-2215: a party's incident belongs to its leader, a solo player leads their own
    local function leaderId()
        local leader = tonumber(Player.value("Party.Leader")) or 0
        if leader > 0 then return leader end
        return References.player.UserId
    end

    -- live 2026-11-17: Game.BountyWorld.Party_<leader>.Incident_HeyYa, but Game.Map.Incident_Verity; either way stamped with your BountyId and leader
    local function incidentModel(id, scenario)
        local name = "Incident_" .. scenario
        local leader = leaderId()
        for _, path in ipairs({ { "BountyWorld", "Party_" .. tostring(leader), name }, { "Map", name } }) do
            local model = D.gamePath(path)
            if model and model:GetAttribute("BountyId") == id and model:GetAttribute("BountyLeaderId") == leader then return model end
        end
        return nil
    end

    -- the enabled BountyIncident_* prompt nearest the incident's target; the game hides the ones it marks BountySourceHidden (IncidentHandler.lua:2025-2030)
    -- live 2026-11-17: a harvest unit is a HarvestUnit<n> model stamped HarvestMoving while it runs, so one standing still is caught first
    local function moving(rec)
        local part = rec.prompt.Parent
        local unit = part and part.Parent
        return unit ~= nil and unit:GetAttribute("HarvestMoving") == true
    end

    -- live 2026-11-19 (user: the first box opens, the second fails every time): a box already solved can keep its prompt, and the nearest-first pick reopened it
    -- each try; a box found solved is passed over while another is left
    local spent = setmetatable({}, { __mode = "k" })
    local function promptIn(model, spot)
        local filter = { root = model }
        if spot then filter.near = spot end
        local ok, recs = World.prompts(filter)
        if not ok then return nil end
        local fallback, used = nil, nil
        for _, rec in ipairs(recs) do
            if string.sub(rec.name, 1, #PREFIX) == PREFIX and rec.position and not rec.prompt:GetAttribute("BountySourceHidden") then
                if spent[rec.prompt] then
                    used = used or rec
                elseif not moving(rec) then
                    return rec
                else
                    fallback = fallback or rec
                end
            end
        end
        return fallback or used
    end

    -- the same prompt's position now, for a target that runs
    local function relocate(model, rec)
        local ok, recs = World.prompts({ root = model, name = rec.name })
        if not ok then return nil end
        for _, r in ipairs(recs) do
            if r.prompt == rec.prompt then return r end
        end
        return nil
    end

    -- the server's pushes for this incident, held for the length of one run (IncidentHandler.lua:2191-2297)
    local function listen(id, token)
        local s = { puzzle = nil, closed = false, choice = nil }
        local Net = Api.get("Net")
        if not Net then return s end
        local handle = Net.onVerb("Bounty", "Incident", function(pushId, verb, payload)
            if pushId ~= id then return end
            if verb == "ClosePuzzle" then
                s.closed = true
            elseif type(payload) ~= "table" or payload.Token ~= token then
                return
            elseif verb == "Puzzle" then
                -- live 2026-11-19 (user: the first box opens, the second fails every time): each box starts its own Version count again, so the second box's
                -- pushes read as older than the first box's last and were dropped; a new box (another Index) always replaces the old one
                local newBox = s.puzzle and payload.Index ~= s.puzzle.Index
                if not s.puzzle or newBox or (tonumber(payload.Version) or 0) >= (tonumber(s.puzzle.Version) or 0) then
                    s.puzzle = payload
                    if payload.Open then s.closed = false end
                end
            elseif verb == "VerityDialogue" then
                s.choice = payload
            elseif verb == "VerityDialogueClose" then
                s.choice = nil
            end
        end)
        s.handle = handle
        s.live = handle ~= nil
        return s
    end

    local function stopListening(s)
        if s and s.handle then pcall(s.handle.Disconnect, s.handle) end
        if s then s.handle = nil end
    end

    -- IncidentHandler.lua:1700-1708: a pick sends the choice's own id; the first choice is taken
    local function answer(id, s)
        local p = s.choice
        if not p then return end
        s.choice = nil
        local first = type(p.Choices) == "table" and p.Choices[1]
        if type(first) ~= "table" or first.Id == nil then return end
        Q.say("Answering Berity")
        Activities.incident(id, p.Token, "VerityChoice", { Choice = first.Id })
    end

    -- waits for the incident to move on, answering berity in the meantime
    local function waitProgress(c, s, before, timeout)
        return D.waitFor(function()
            if s then answer(c.id, s) end
            return I.fingerprint(fresh(c.id)) ~= before
        end, timeout)
    end

    local function allPlaced(p)
        for _, name in ipairs(COMPONENTS) do
            if not (type(p.Placed) == "table" and p.Placed[name] == true) then return false end
        end
        return true
    end

    -- live 2026-11-19 (user: meryl's necklace sticks on grabbing it to return): with every piece fitted the necklace read as solved and was closed 3 s later,
    -- just before the server opened its Evidence stage (seen 7 s after); a fitted necklace waits for that stage and takes the evidence instead
    local function awaitingEvidence(p)
        return (p.Kind == "Assembly" or p.Index == 4) and p.Stage ~= "Evidence" and allPlaced(p)
    end

    local function puzzleDone(p)
        if p.Stage == "Evidence" then return false end
        -- the necklace is finished by taking its evidence (the incident moves on), never by its pieces alone
        if p.Kind == "Assembly" or p.Index == 4 then return false end
        for row = 1, 3 do
            if not (type(p.Values) == "table" and type(p.Target) == "table" and p.Values[row] == p.Target[row]) then return false end
        end
        return true
    end

    -- one move on an open puzzle, (sent, version) so the caller waits for the server's next update
    local function puzzleMove(c, p)
        local version = p.Version
        -- IncidentHandler.lua:475-494: the evidence button sends only the version
        if p.Stage == "Evidence" then
            Q.say("Taking the evidence")
            return Activities.incident(c.id, p.Token, "TakeEvidence", { Version = version })
        end
        -- IncidentHandler.lua:704 picks the assembly view; :655-663 fits one stone or the clasp
        if p.Kind == "Assembly" or p.Index == 4 then
            for _, name in ipairs(COMPONENTS) do
                if not (type(p.Placed) == "table" and p.Placed[name] == true) then
                    Q.say("Fitting the necklace")
                    return Activities.incident(c.id, p.Token, "FitComponent", { Component = name, Version = version })
                end
            end
            return false
        end
        -- IncidentHandler.lua:391 marks a row aligned when Values matches Target; :893-898 places one row on a notch
        if type(p.Values) ~= "table" or type(p.Target) ~= "table" then return false end
        for row = 1, 3 do
            local want = p.Target[row]
            if p.Values[row] ~= want and type(want) == "number" then
                Q.say("Sliding the clasps")
