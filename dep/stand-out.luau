                AutoDismiss = true,
                OutsideClickDismiss = true,
                FooterButtons = {
                    Cancel = { Title = "Keep My Hotkeys", Variant = "Ghost", Order = 1, Callback = function() end },
                    Confirm = { Title = "Clear All", Variant = "Destructive", Order = 2, Callback = clearAll },
                },
            })
        end,
    })

    refresh()
    refreshStops()
    showObjective()

