            local stroke = Instance.new("UIStroke", window)
            stroke.Thickness = 1
            stroke.Color     = Color3.fromRGB(32, 34, 52)

            -- drag handler; untracked UIS.InputChanged would leak a global mouse-move listener per relaunch
            local dragging, dragStart, startPos
