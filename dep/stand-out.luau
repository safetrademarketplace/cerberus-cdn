function M.departing(note, now, from, to, reason, resume)
    local out = { hops = {}, visited = {}, failed = {}, failures = note.failures or 0, lastFail = note.lastFail }
    for _, at in ipairs(note.hops or {}) do
        if now - at < 3600 then out.hops[#out.hops + 1] = at end
    end
    out.hops[#out.hops + 1] = now
    for id, at in pairs(note.visited or {}) do
        if now - at < M.VISITED_FOR then out.visited[id] = at end
    end
    for id, at in pairs(note.failed or {}) do
        if now - at < M.VISITED_FOR then out.failed[id] = at end
    end
    out.visited[from] = now
    out.from, out.to, out.at, out.reason, out.resume = from, to, now, reason, resume == true
    return out
end

-- a failed join: back off, and never pick that row again for a while
function M.failedHop(note, now, jobId)
    note.failures = (tonumber(note.failures) or 0) + 1
    note.lastFail = now
    note.failed = note.failed or {}
    if jobId then note.failed[jobId] = now end
    -- the hop never left, so it doesn't count against the hour
    if note.hops and #note.hops > 0 and note.at and note.hops[#note.hops] == note.at then table.remove(note.hops) end
    note.to, note.resume = nil, false
    return note
end

-- after the reload: "landed" (this hop's note, fresh), or nil; resume only from a fresh note this feature wrote, never a stale one
function M.arrival(note, jobId, now)
    if type(note) ~= "table" or note.to ~= jobId or type(note.at) ~= "number" then return nil, false end
    if now - note.at > M.NOTE_FRESH then return nil, false end
    return "landed", note.resume == true and not note.resumed
end

return M

end)
__bundle_register("Utility/FarmConfig", function(require, _LOADED, __bundle_register, __bundle_modules)
