        if WorldEvents.wants() then return "Paused for an event", FarmSettings.tick(IDLE_TICK) end
        if Farms.priority("Arrows") then return "Paused for " .. Farms.priority("Arrows"), FarmSettings.tick(IDLE_TICK) end
