__bundle_register("Api/Player", function(require, _LOADED, __bundle_register, __bundle_modules)
-- player api: you as an account; owns the LocalPlayer.Data reader every other api reads through, the account reads, and the item, stat, settings and menu verbs, which reach the game only through Net
local Jobs = require("Utility/Jobs")

local Api     = require("Api")
local Account = require("Api/Player/Account")
local Data    = require("Api/Player/Data")
local Errors  = require("Api/Player/Errors")
local Items   = require("Api/Player/Items")

-- the Item remote may replicate after boot; its push listeners are retried at this cadence, for this many tries
local HOOK_RETRY = 2
local HOOK_TRIES = 60

local M = {}

-- what the verbs see when Net never built: every send and module read answers NO_NET, the data reader still works
local function offlineNet()
    local function refuse() return false, Errors.NO_NET end
    local function refuseHandle() return nil, Errors.NO_NET end
    return {
        fire = refuse, invoke = refuse, fireAllowed = refuse, invokeAllowed = refuse, module = refuse,
        on = refuseHandle, onVerb = refuseHandle,
    }
end

function M.new(ctx)
    local base = Api.define("Player", ctx)
    local References = ctx.References
    local maid = base.maid

    local Net = ctx.Api and ctx.Api.Net
    local hasNet = Net ~= nil
    if not hasNet then
        base.warn("net api missing, every verb answers %s", Errors.NO_NET)
        Net = offlineNet()
    end

    local S = { base = base, Errors = Errors, Net = Net, Services = ctx.Services }

    function S.player()
        return References.player
    end

    -- read on every use: the character is respawn-scoped and a held one goes stale
    function S.character()
        local char = References.character
        if char and char.Parent then return char end
        return nil
    end

    function S.module(name)
        local ok, value = Net.module(name)
        if ok and value ~= nil then return true, value end
        return false, value
    end

    -- Utility:isPlayerFlagSet (Utility.lua:135-142): the player, its character or its PlayerGui
    function S.flag(name)
        local player = References.player
        if not player then return false end
        if player:GetAttribute(name) == true then return true end
        local char = S.character()
        if char and char:GetAttribute(name) == true then return true end
        local gui = player:FindFirstChildOfClass("PlayerGui")
        return gui ~= nil and gui:GetAttribute(name) == true
    end

    -- a caller's handle: Disconnect runs cleanup now, unload runs it through the maid, never twice
    function S.own(cleanup)
        local done = false
        local function run()
            if done then return end
            done = true
            cleanup()
        end
        local id = maid and maid:GiveTask(run) or nil
        local handle = {}
        function handle:Disconnect()
            if done then return end
            if id then
                maid[id] = nil
                id = nil
            else
                run()
            end
        end
        handle.Destroy = handle.Disconnect
        return handle
    end

    local api = { Errors = Errors }

    -- account reads need the data in, every one of them goes through this
    function S.need()
        if not References.player then return Errors.NO_PLAYER end
        if not api.ready() then return Errors.NOT_READY end
        return nil
    end

    Data(S, api)
    Account(S, api)
    Items(S, api)

    api.loaded = base.signal()
    api.levelUp = base.signal()
    api.dalasChanged = base.signal()
    api.inventoryChanged = base.signal()
    api.standChanged = base.signal()
    api.rewardAlert = base.signal()
    api.itemPickup = base.signal()

    -- a value that first appears with the tree is a load, never a level-up or a dalas change
    api.observeAttr("", "Loaded", function(loaded)
        if loaded == true then api.loaded:Fire() end
    end)
    api.observe("Stats.Level", function(level, old)
        if type(level) == "number" and type(old) == "number" and level > old then api.levelUp:Fire(level) end
    end)
    api.observe("Stats.Coins", function(coins, old)
        if type(coins) == "number" and type(old) == "number" then api.dalasChanged:Fire(coins, old) end
    end)
    api.observe("Stats.Inventory", function(raw)
        if raw ~= nil then api.inventoryChanged:Fire() end
    end)
    api.observe("Stand", function(name)
        if type(name) == "string" then api.standChanged:Fire(name) end
    end)

    -- Core.Effects.lua:1600-1613: RewardAlert carries the lines table; DroppedItemPickup's name and amount are its fourth and fifth args, and only a non-empty name is announced
    local hooks = {
        { verb = "RewardAlert", fn = function(lines)
            if type(lines) == "table" then api.rewardAlert:Fire(lines) end
        end },
        { verb = "DroppedItemPickup", fn = function(_, _, name, amount)
            if type(name) == "string" and name ~= "" then api.itemPickup:Fire(name, tonumber(amount) or 1) end
        end },
    }

    local function hookAll()
        local pending = 0
        for _, hook in ipairs(hooks) do
            if not hook.handle then
                local handle = Net.onVerb("Item", hook.verb, hook.fn)
                if handle then
                    hook.handle = handle
                    if maid then maid:GiveTask(handle) end
                else
                    pending = pending + 1
                end
            end
        end
        return pending == 0
    end

    if hasNet and not hookAll() then
        local tries = 0
        local poller = Jobs.interval(HOOK_RETRY, function(job)
            tries = tries + 1
            if hookAll() then
                job:Cancel()
            elseif tries >= HOOK_TRIES then
                base.warn("item pushes still unbound after %d tries", tries)
                job:Cancel()
            end
        end, { name = "Api/Player hooks" })
        if maid and poller then maid:GiveTask(poller) end
    end

    base.log("player api ready (data %s)", api.ready() and "loaded" or "pending")
    return api
end

return M

end)
__bundle_register("Api/Player/Items", function(require, _LOADED, __bundle_register, __bundle_modules)
-- player items: inventory, hotbar and equipment decoded through the game's own modules (tolerant json when they can't be reached), and the item, accessory, hotbar and arrow verbs gated the way the client gates them
local HOTBAR_SLOTS = 5

-- Huber.lua:102-133: no use while a layout is being edited or one of these locks is up
local LAYOUT_LOCKS = { "MobileLayoutEditing", "HUDLayoutEditing" }
local USE_LOCKS = {
    "SettingsInputLocked", "GuiNavigationLocked", "GardeningInputLocked", "DialogueInputLocked", "QTEInputLocked",
    "ArrowUseConfirmationOpen",
}

-- Arrows.lua:7-14 Variants, used when the module can't be reached
local ARROW_NAMES = {
    ["Mysterious Arrow"] = true, ["Lucky Arrow"] = true, ["Bizarre Arrow"] = true,
    ["Mysterious Arrow [Part 5]"] = true, ["Mysterious Arrow [Part 3]"] = true, ["Mysterious Rock"] = true,
}

-- the server only asks to confirm a reroll; a standless use may roll straight away, so a stand change before the ask also counts
local CONFIRM_TIMEOUT = 10
local RESULT_TIMEOUT = 30
local POLL = 0.05

return function(S, api)
    local Errors = S.Errors
    local Net = S.Net
    local HttpService = S.Services.HttpService
    local Workspace = S.Services.Workspace

    local function tableModule(name)
        local ok, value = S.module(name)
        if ok and type(value) == "table" then return value end
        return nil
    end

    -- InventoryHandler.lua:1202-1222: bare strings become {Name, Amount = 1}, anything without a string Name is skipped
    local function tolerantEntries(raw)
        local out = {}
        if type(raw) ~= "string" or raw == "" then return out end
        local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
        if not ok or type(decoded) ~= "table" then return out end
        for _, entry in ipairs(decoded) do
            if type(entry) == "string" then entry = { Name = entry, Amount = 1 } end
            if type(entry) == "table" and type(entry.Name) == "string" then out[#out + 1] = entry end
        end
        return out
    end

    -- InventoryEntries.lua:17-67: the strict decoder (aliases renamed, sparse or malformed data rejected) first, the tolerant one after
    local function rawEntries(raw)
        local entries = tableModule("InventoryEntries")
        if entries and type(entries.Decode) == "function" then
            local ok, list = pcall(entries.Decode, raw)
            if ok and type(list) == "table" then return list end
        end
        return tolerantEntries(raw)
    end

    local function shape(entry)
        return { name = entry.Name, id = entry.ID, amount = tonumber(entry.Amount) or 1, raw = entry }
    end

    local function readInventory()
        local stop = S.need()
        if stop then return nil, stop end
        local raw = api.value("Stats.Inventory")
        if type(raw) ~= "string" then return nil, Errors.NO_NODE end
        return rawEntries(raw)
    end

    function api.inventory()
        local list, err = readInventory()
        if not list then return false, err end
        local out = {}
        for i, entry in ipairs(list) do out[i] = shape(entry) end
        return true, out
    end

    -- InventoryEntries.Find (:113-128): an exact name+id match, else with no id asked the first of that name
    local function find(list, name, id)
        local first
        for _, entry in ipairs(list) do
            if entry.Name == name then
                if entry.ID == id then return entry end
                if id == nil and not first then first = entry end
            end
        end
        return first
    end

    local function validItem(name, id)
        return type(name) == "string" and name ~= "" and (id == nil or type(id) == "string")
    end

    function api.findItem(name, id)
        if not validItem(name, id) then return false, Errors.BAD_ARGS end
        local list, err = readInventory()
        if not list then return false, err end
        local entry = find(list, name, id)
        if not entry then return false, Errors.NOT_FOUND end
        return true, shape(entry)
    end

    -- InventoryEntries.Count (:149-157)
    function api.count(name, id)
        if not validItem(name, id) then return false, Errors.BAD_ARGS end
        local list, err = readInventory()
        if not list then return false, err end
        local n = 0
        for _, entry in ipairs(list) do
            if entry.Name == name and (id == nil or entry.ID == id) then n = n + (tonumber(entry.Amount) or 1) end
        end
        return true, n
    end

    -- Huber.lua:48-64 DecodeSlots, mirrored when the module can't be reached
    local function decodeSlots(raw)
        local huber = tableModule("Huber")
        if huber and type(huber.DecodeSlots) == "function" then
            local ok, slots = pcall(huber.DecodeSlots, raw)
            if ok and type(slots) == "table" then return slots end
        end
        local slots = {}
        for i = 1, HOTBAR_SLOTS do slots[i] = false end
        local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw or "[]")
        if ok and type(decoded) == "table" then
            for i = 1, HOTBAR_SLOTS do
                local v = decoded[i]
                if type(v) == "table" and type(v.Name) == "string" and #v.Name <= 100
                    and (v.ID == nil or (type(v.ID) == "string" and #v.ID <= 150)) then
                    slots[i] = { Name = v.Name, ID = v.ID }
                end
            end
        end
        return slots
    end

    local function readSlots()
        local stop = S.need()
        if stop then return nil, stop end
        local raw = api.value("Stats.QuickUseSlots")
        if type(raw) ~= "string" then return nil, Errors.NO_NODE end
        return decodeSlots(raw)
    end

    function api.hotbar()
        local slots, err = readSlots()
        if not slots then return false, err end
        local out = {}
        for i = 1, HOTBAR_SLOTS do
            local slot = slots[i]
            out[i] = type(slot) == "table" and { name = slot.Name, id = slot.ID } or false
        end
        return true, out
    end

    -- InventoryHandler.lua:1224-1239: Wearables.Read(BodyEquipment, inventory, Items.Resolve) gives slot -> {Name, ID, VanityVisible} plus .Vanity
    function api.equipment()
        local stop = S.need()
        if stop then return false, stop end
        local raw = api.value("Stats.BodyEquipment")
        if type(raw) ~= "string" then return false, Errors.NO_NODE end
        local wearables = tableModule("Modules.Items.Wearables")
        local items = tableModule("Items")
        if wearables and items and type(wearables.Read) == "function" and type(items.Resolve) == "function" then
            local ok, equipped = pcall(wearables.Read, raw, tolerantEntries(api.value("Stats.Inventory")), items.Resolve)
            if ok and type(equipped) == "table" then return true, equipped end
        end
        local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw ~= "" and raw or "{}")
        if not ok or type(decoded) ~= "table" then return false, Errors.DECODE_FAILED end
        if type(decoded.Vanity) ~= "table" then decoded.Vanity = {} end
        return true, decoded
    end

    local function isArrow(name)
        local arrows = tableModule("Arrows")
        if arrows and type(arrows.isArrow) == "function" then
            local ok, yes = pcall(arrows.isArrow, name)
            if ok and yes then return true end
        end
        local items = tableModule("Items")
        local defs = items and items.items
        local def = type(defs) == "table" and defs[name] or nil
        if type(def) == "table" and def.StandArrow == true then return true end
        return ARROW_NAMES[name] == true
    end

    local function useGate()
        local player = S.player()
        if not player then return Errors.NO_PLAYER end
        for _, name in ipairs(LAYOUT_LOCKS) do
            if player:GetAttribute(name) then return Errors.LOCKED end
        end
        for _, name in ipairs(USE_LOCKS) do
            if player:GetAttribute(name) then return Errors.LOCKED end
        end
        local char = S.character()
        local utility = tableModule("Utility")
        if char and utility and type(utility.isInItemUseWater) == "function" then
            local ok, wet = pcall(utility.isInItemUseWater, utility, char)
            if ok and wet then return Errors.IN_WATER end
        end
        return nil
    end

    -- the entry must be owned, as the client resolves it before every send
    local function owned(name, id)
        if not validItem(name, id) then return nil, Errors.BAD_ARGS end
        local list, err = readInventory()
        if not list then return nil, err end
        local entry = find(list, name, id)
        if not entry then return nil, Errors.NOT_FOUND end
        return entry
    end

    -- InventoryHandler.lua:2674 / Huber.lua:141; arrows go through useArrow so a stand roll is never a side effect
    function api.useItem(name, id)
        local entry, err = owned(name, id)
        if not entry then return false, err end
        if isArrow(entry.Name) then return false, Errors.USE_ARROW end
        local stop = useGate()
        if stop then return false, stop end
        return Net.fire("Item", "Use", entry.Name, entry.ID)
    end

    -- InventoryHandler.lua:2682
    function api.dropItem(name, id)
        local entry, err = owned(name, id)
        if not entry then return false, err end
        return Net.fireAllowed("Item", "Drop", entry.Name, entry.ID)
    end

    local function wearableSlot(slot)
        if type(slot) ~= "string" or slot == "" then return false end
        local wearables = tableModule("Modules.Items.Wearables")
        if not (wearables and type(wearables.Slots) == "table") then return true end
        for _, known in ipairs(wearables.Slots) do
            if known == slot then return true end
        end
        return false
    end

    -- InventoryHandler.lua:2734, 3267, 3319, 3353: (verb, name, id, slotName), the vanity layer has its own verbs
    local function accessory(equip, name, id, slot, vanity)
        if not wearableSlot(slot) then return false, Errors.BAD_ARGS end
        local entry, err = owned(name, id)
        if not entry then return false, err end
        local verb
        if vanity then
            verb = equip and "EquipVanityAccessory" or "UnequipVanityAccessory"
        else
            verb = equip and "EquipAccessory" or "UnequipAccessory"
        end
        return Net.fire("Item", verb, entry.Name, entry.ID, slot)
    end

    function api.equipAccessory(name, id, slot, vanity)
        return accessory(true, name, id, slot, vanity == true)
    end

    function api.unequipAccessory(name, id, slot, vanity)
        return accessory(false, name, id, slot, vanity == true)
    end

    -- Huber.lua:145
    function api.pin(name, id)
        local entry, err = owned(name, id)
        if not entry then return false, err end
        return Net.fire("Huber", "Pin", { Name = entry.Name, ID = entry.ID })
    end

    local function validSlot(slot)
        return type(slot) == "number" and slot % 1 == 0 and slot >= 1 and slot <= HOTBAR_SLOTS
    end

    -- Huber.lua:1102; entry is {name, id} (or the game's {Name, ID}), nil clears the slot, sourceSlot is the slot it was dragged from
    function api.setSlot(slot, entry, sourceSlot)
        if not validSlot(slot) then return false, Errors.BAD_ARGS end
        if sourceSlot ~= nil and not validSlot(sourceSlot) then return false, Errors.BAD_ARGS end
        local payload = { Slot = slot, Clear = entry == nil, SourceSlot = sourceSlot }
        if entry ~= nil then
            if type(entry) ~= "table" then return false, Errors.BAD_ARGS end
            local item, err = owned(entry.name or entry.Name, entry.id or entry.ID)
            if not item then return false, err end
            payload.Name = item.Name
            payload.ID = item.ID
        end
        return Net.fire("Huber", "SetSlot", payload)
    end

    -- Huber.lua:102-141; the cosmetic Held beat (HeldItem.lua:429) depends on the game's local held-model render and is not sent
    function api.useSlot(slot)
        if not validSlot(slot) then return false, Errors.BAD_ARGS end
        local slots, err = readSlots()
        if not slots then return false, err end
        local pick = slots[slot]
        if type(pick) ~= "table" then return false, Errors.NOT_FOUND end
        local list, listErr = readInventory()
        if not list then return false, listErr end
        local entry = find(list, pick.Name, pick.ID)
        if not entry then return false, Errors.NOT_FOUND end
        if isArrow(entry.Name) then return false, Errors.USE_ARROW end
        local stop = useGate()
        if stop then return false, stop end
        return Net.fire("Item", "Use", entry.Name, entry.ID)
    end

    local function rolled(before)
        return api.value("Stand") ~= before.stand or api.value("SubAbility") ~= before.sub
    end

    -- yields. Use, then the server's ConfirmArrowUse{Name, ID, Token, Stand, Rarity, SubAbility, ExpiresAt} (ArrowUse.lua:1016-1020), answered as the dialog does at :842-846; opts.cancel or opts.decide(payload) == false sends CancelUse instead
    local arrowBusy = false
    function api.useArrow(name, id, opts)
        if opts ~= nil and type(opts) ~= "table" then return false, Errors.BAD_ARGS end
        opts = opts or {}
        if opts.decide ~= nil and type(opts.decide) ~= "function" then return false, Errors.BAD_ARGS end
        if arrowBusy then return false, Errors.BUSY end
        local entry, err = owned(name, id)
        if not entry then return false, err end
        if not isArrow(entry.Name) then return false, Errors.NOT_ARROW end
        local stop = useGate()
        if stop then return false, stop end

        arrowBusy = true
        local payload
        local handle, onErr = Net.onVerb("Item", "ConfirmArrowUse", function(p)
            if payload == nil and type(p) == "table" and type(p.Token) == "string"
                and (p.Name == nil or p.Name == entry.Name) then
                payload = p
            end
        end)
        if not handle then
            arrowBusy = false
            return false, onErr
        end
        local own = S.own(function() handle:Disconnect() end)
        local function finish(...)
            own:Disconnect()
            arrowBusy = false
            return ...
        end

        local before = { stand = api.value("Stand"), sub = api.value("SubAbility") }
        local _, countBefore = api.count(entry.Name, entry.ID)
        local sent, sendErr = Net.fire("Item", "Use", entry.Name, entry.ID)
        if not sent then return finish(false, sendErr) end

        local deadline = os.clock() + CONFIRM_TIMEOUT
        while payload == nil and not rolled(before) and os.clock() < deadline do task.wait(POLL) end
        if payload == nil then
            if rolled(before) then return finish(true, api.value("Stand")) end
            return finish(false, Errors.NO_CONFIRM)
        end

        local accept = not opts.cancel
        if accept and opts.decide then
            local ok, verdict = pcall(opts.decide, payload)
            accept = ok and verdict ~= false
        end
        if not accept then
            local cancelled, cancelErr = Net.fire("Item", "CancelUse", payload.Token)
            if not cancelled then return finish(false, cancelErr) end
            return finish(false, Errors.CANCELLED)
        end
        local expires = tonumber(payload.ExpiresAt)
        if expires and Workspace:GetServerTimeNow() >= expires then return finish(false, Errors.EXPIRED) end

        local confirmName = type(payload.Name) == "string" and payload.Name or entry.Name
        local confirmId = type(payload.Name) == "string" and payload.ID or entry.ID
        local confirmed, confirmErr = Net.fireAllowed("Item", "ConfirmUse", confirmName, confirmId, payload.Token)
        if not confirmed then return finish(false, confirmErr) end

        deadline = os.clock() + RESULT_TIMEOUT
        while not rolled(before) and os.clock() < deadline do task.wait(POLL) end
        if rolled(before) then return finish(true, api.value("Stand")) end
        -- a reroll can land on the same stand; the arrow being spent is the proof it rolled
        local _, countAfter = api.count(entry.Name, entry.ID)
        if type(countBefore) == "number" and type(countAfter) == "number" and countAfter < countBefore then
            return finish(true, api.value("Stand"))
        end
        return finish(false, Errors.NO_RESULT)
    end
end

end)
