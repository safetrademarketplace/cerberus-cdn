        local ok, skill, applies = method(c.Weapons, "GetSummonedAttackSkill", c.char, def, heavy)
        if not ok or not applies or not ((c.summoned and not c.standAway) or def.AttacksWithoutSummon) then return nil end
        if not skill then return { err = Errors.UNSUPPORTED } end
        local L = S.life
        local now = S.now()
        if not heavy and def.SummonedM1Repeat then
            if L.blocking then return { err = Errors.BUSY } end
            if now < L.nextStandLight then return { err = Errors.COOLDOWN } end
