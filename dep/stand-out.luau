__bundle_register("Utility/Farms", function(require, _LOADED, __bundle_register, __bundle_modules)
-- farms: the registry every autofarm joins so the farm plan can see it; a farm registers { name, label, owner, enable(on), enabled(), active(), wants(), priority? } and asks Farms.mayAct(name) before it starts a new piece of work; every call is guarded, so a farm that never registers, or whose function throws, just reads as idle
local M = {}

local farms = {}
local order = {}
local version = 0
local gate = nil

local function call(fn, ...)
    if type(fn) ~= "function" then return nil end
    local ok, value = pcall(fn, ...)
    if not ok then return nil end
    return value
end

-- returns true when it took; registering the same name again replaces the old entry (a reload)
function M.register(def)
    if type(def) ~= "table" or type(def.name) ~= "string" or def.name == "" then return false end
    if not farms[def.name] then order[#order + 1] = def.name end
    farms[def.name] = {
        name     = def.name,
        label    = type(def.label) == "string" and def.label or def.name,
        owner    = type(def.owner) == "string" and def.owner or nil,
        priority = tonumber(def.priority),
        enable   = def.enable,
        enabled  = def.enabled,
        active   = def.active,
        wants    = def.wants,
    }
    version = version + 1
    return true
end

function M.unregister(name)
    if not farms[name] then return end
    farms[name] = nil
    for i = #order, 1, -1 do
        if order[i] == name then table.remove(order, i) end
    end
    version = version + 1
end

function M.get(name) return farms[name] end

-- registration order
function M.list()
    local out = {}
    for _, name in ipairs(order) do out[#out + 1] = farms[name] end
    return out
end

-- bumps on every register/unregister, so a menu can tell when to rebuild its lists
function M.version() return version end

-- the farm holding World movement under `owner`, or nil
function M.byOwner(owner)
    if type(owner) ~= "string" then return nil end
    for _, name in ipairs(order) do
        if farms[name].owner == owner then return farms[name] end
    end
    return nil
end

function M.enabled(name)
    local f = farms[name]
    return f ~= nil and call(f.enabled) == true
end

function M.active(name)
    local f = farms[name]
    return f ~= nil and call(f.active) == true
end

function M.wants(name)
    local f = farms[name]
    return f ~= nil and call(f.wants) == true
end

function M.enable(name, on)
    local f = farms[name]
    if not (f and type(f.enable) == "function") then return false end
    return (pcall(f.enable, on == true))
end

-- the farm control sets one gate: fn(name) -> ok, reason
function M.setGate(fn)
    gate = type(fn) == "function" and fn or nil
end

-- (ok, reason): false while the farm plan, a pause or a stop rule holds this farm back; true when nothing is in charge
function M.mayAct(name)
    if not gate then return true end
    local ok, allowed, reason = pcall(gate, name)
    if not ok then return true end
    if allowed == false then return false, type(reason) == "string" and reason or "Waiting its turn" end
    return true
end

-- farms that pause the rest while they want movement (auto raid with raid first); world events keeps its own WorldEvents.wants()
local priority = {}

-- `reason` finishes "Paused for ..." in the paused farms' status
function M.setPriority(name, on, reason)
    priority[name] = on and (reason or name) or nil
end

-- plain: why a priority farm other than `except` wants movement now ("a raid"), or nil
function M.priority(except)
    for name, reason in pairs(priority) do
        if name ~= except then return reason end
    end
    return nil
end

-- test hook
function M._reset()
    farms, order, version, gate = {}, {}, 0, nil
    priority = {}
end

return M

end)
__bundle_register("Features/Utilities/AutoEquip", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto equip: keeps your strongest wearables on, re-planned on boot and whenever the inventory or BodyEquipment changes; only the main layer is touched (never vanity), nothing is ever unequipped, a slot changes only for a strictly better loadout, and a slot we sent to is left alone for a minute so a manual pick is fought at most once a minute
local Jobs    = require("Utility/Jobs")
local Log     = require("Utility/Log")
local Mount   = require("Utility/Mount")
local UiWrite = require("Utility/UiWrite")

local Plan = require("Features/Utilities/AutoEquip/Plan")

local TICK = 2
-- with nothing changed, the plan is still re-checked this often so a slot comes off its cooldown
local RECHECK = 30
local SLOT_GAP = 60

local KINDS = { Jacket = true, Pants = true, Accessory = true }

local M = {}

-- Items.lua:654-694: a wardrobe item is {Type "Accessory", Wearable, EquipmentSlot Jacket|Pants|Accessory, BonusStats, Passives, BonusSet}
function M.piece(defs, name, id)
    local def = type(defs) == "table" and type(name) == "string" and defs[name] or nil
    if type(def) ~= "table" or def.Wearable ~= true or def.Type ~= "Accessory" or not KINDS[def.EquipmentSlot] then return nil end
    return {
        name = name,
        id = id,
        kind = def.EquipmentSlot,
        stats = type(def.BonusStats) == "table" and def.BonusStats or {},
        passives = type(def.Passives) == "table" and def.Passives or {},
        label = type(def.DisplayName) == "string" and def.DisplayName or name,
    }
end

-- owned wearables, one piece per inventory entry
function M.owned(defs, inventory)
    local out = {}
    for _, entry in ipairs(inventory or {}) do
        local p = M.piece(defs, entry.name, entry.id)
        if p then out[#out + 1] = p end
    end
    return out
end

-- InventoryHandler.lua:1224-1239 / Wearables.lua:199-229: slot -> {Name, ID}; the Vanity layer is skipped on purpose
function M.current(defs, equipment)
    local out = {}
    for _, slot in ipairs(Plan.SLOTS) do
        local e = type(equipment) == "table" and equipment[slot] or nil
        if type(e) == "table" and type(e.Name) == "string" then
            out[slot] = M.piece(defs, e.Name, e.ID) or { name = e.Name, id = e.ID, kind = "Unknown", stats = {}, passives = {}, label = e.Name }
        end
    end
    return out
end

function M.mount(ctx)
    local O = Mount.orchestrator(ctx, "AutoEquip")
    if not O then return end
    local Player = ctx.Api and ctx.Api.Player
    local Net = ctx.Api and ctx.Api.Net
    if not (Player and Net and Player.inventory and Player.equipment and Player.equipAccessory and Player.observe and Player.inventoryChanged) then
        Log.devwarn("AutoEquip", "player or net api missing; auto equip won't load")
        return
    end
    local Toggles, Library = ctx.Toggles, ctx.Library

    local dirty = true
    local lastPlan = -math.huge
    local sentAt = {}

    local function enabled()
        local t = Toggles and Toggles.AutoEquip_Enabled
        return t ~= nil and t.Value == true
    end

    local function tableModule(name)
        local ok, value = Net.module(name)
        if ok and type(value) == "table" then return value end
        return nil
    end

    -- AccessoryBonuses.lua:4-43 Caps, :126-137 Sets, applied as Aggregate does at :287-329; without the module there are no caps and no set bonus
    local function bonusOpts()
        local bonuses = tableModule("Modules.Items.AccessoryBonuses")
        return {
            sets = bonuses and type(bonuses.Sets) == "table" and bonuses.Sets or {},
            caps = bonuses and type(bonuses.Caps) == "table" and bonuses.Caps or nil,
        }
    end

    local function pass()
        if not enabled() then return end
        local now = os.clock()
        if not dirty and now - lastPlan < RECHECK then return end
        if Player.isBusy and Player.isBusy() then return end
        if Player.spawnReady and not Player.spawnReady() then return end
        local items = tableModule("Items")
        local defs = items and items.items
        if type(defs) ~= "table" then return end
        local okInv, inventory = Player.inventory()
        local okEq, equipment = Player.equipment()
        if not (okInv and okEq) then return end
        dirty, lastPlan = false, now

        local decision = Plan.decide(M.owned(defs, inventory), M.current(defs, equipment), bonusOpts())
        for _, change in ipairs(decision.changes) do
            if now - (sentAt[change.slot] or -math.huge) >= SLOT_GAP then
                sentAt[change.slot] = now
                -- the next change goes out on the next pass, once this one has had time to replicate
                dirty = true
                -- InventoryHandler.lua:2696-2734: EquipAccessory(name, id, slotName), an occupied slot is replaced as the equip button does for a jacket
                local ok, err = Player.equipAccessory(change.name, change.id, change.slot)
                if ok then
                    local p = M.piece(defs, change.name, change.id)
                    UiWrite.notify(Library, ("Equipped %s."):format(p and p.label or change.name), 4)
                else
                    Log.devwarn("AutoEquip", "equip %s in %s refused: %s", change.name, change.slot, tostring(err))
                end
                return
            end
        end
    end

    local function markDirty() dirty = true end
    O.track(Player.inventoryChanged:Connect(markDirty))
    local watch = Player.observe("Stats.BodyEquipment", markDirty)
    if watch then O.track(watch) end
    O.track(Jobs.interval(TICK, pass, { name = "AutoEquip", immediate = true }))

    local box = ctx.Tabs.GameCharacter:AddRightGroupbox("Gear", "shirt")
    box:AddToggle("AutoEquip_Enabled", {
        Text     = "Auto Equip Gear",
        Default  = true,
        Tooltip  = "Wears your strongest jacket, pants and accessories",
        Callback = markDirty,
    })

    O.finalize()
end

return M

end)
__bundle_register("Features/Utilities/AutoEquip/Plan", function(require, _LOADED, __bundle_register, __bundle_modules)
