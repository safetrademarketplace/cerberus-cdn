local RESULT_TIMEOUT = 15
local COMMUNITY_KINDS = { Favorite = "CommunityFavoriteClaimed", Group = "CommunityGroupClaimed", Invite = "CommunityInviteClaimed" }
-- Crafting.lua:682-687, 960, 1126, 860
local CRAFT_ACTIONS = { Place = true, Craft = true, Again = true, Browse = true, Sync = true }
