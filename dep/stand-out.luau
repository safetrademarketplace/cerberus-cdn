            pos = base + look * state.distance + Vector3.new(0, state.height, 0)
        elseif state.mode == "above" then
            pos = base + Vector3.new(0, state.distance + state.height, 0)
        elseif state.mode == "below" then
            pos = base - Vector3.new(0, state.distance - state.height, 0)
        else
            pos = base - look * state.distance + Vector3.new(0, state.height, 0)
