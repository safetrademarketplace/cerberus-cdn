__bundle_register("Features/Visuals/ESP/Sources", function(require, _LOADED, __bundle_register, __bundle_modules)
-- stand out esp sources: the game's own groups (players, enemies, bosses, quest givers, your story, items, your pots) read from the few small Game folders by GetChildren at each group's rescan rate, every row labelled with the attributes worth seeing; pure, so it runs offline and in a live probe

local SUFFIX_ID   = "_%d+$"            -- Seal_3448, DIO_5898, Bobby Jean_12
local SUFFIX_TAG  = "%s*%[.-%]$"       -- "Jodio Bag Scene [solo:<UserId>]"
local GIVER_RANGE = 15                 -- an offer's Vector3 sits on its giver
-- story fights with no boss attribute the client can see (enemies.md §2)
local STORY_BOSSES = {
    ["Charming Man"] = true, ["Bobby Jean"] = true, ["Ningbo"] = true, ["Laem Chabang"] = true,
    ["Yo-Yo Ma"] = true, ["Leprechaun"] = true, ["CEO of Fighting"] = true, ["Jotaro"] = true, ["DIO"] = true,
}
-- an idle model in Game.Players never fights (Abilities.lua:1507)
local IDLE_ATTRS = { "TrainingDummy", "Stand", "StandName", "Vehicle", "SummonFamily", "SummonSkill" }
-- pot stages (Gardening recon) in words
local STAGE_TEXT = { Empty = "Needs dirt", DirtReady = "Needs a seed", Ready = "Ready to harvest" }

local COLOURS = {
    players = Color3.fromRGB(255, 60, 60),
    enemies = Color3.fromRGB(255, 150, 40),
    bosses  = Color3.fromRGB(190, 80, 255),
    givers  = Color3.fromRGB(255, 220, 80),
    story   = Color3.fromRGB(90, 200, 255),
    items   = Color3.fromRGB(120, 255, 140),
    pots    = Color3.fromRGB(160, 230, 90),
}

local function cleanName(name)
    return (name:gsub(SUFFIX_TAG, ""):gsub(SUFFIX_ID, ""))
end

local function join(parts, sep)
    return table.concat(parts, sep or ", ")
end

local function clock(seconds)
    seconds = math.max(0, math.floor(seconds + 0.5))
    if seconds >= 3600 then return ("%dh %02dm"):format(seconds // 3600, (seconds % 3600) // 60) end
    return ("%d:%02d"):format(seconds // 60, seconds % 60)
end

local M = { COLOURS = COLOURS, cleanName = cleanName, clock = clock }

-- env: Workspace, Players, player (the local Player, possibly a cloneref), serverNow(), bounty() -> playerBounty state or nil, defaultConfig(accent), partTargets
function M.build(env)
    local Workspace, Players = env.Workspace, env.Players

    local function gameFolder(name)
        local root = Workspace:FindFirstChild("Game")
        return root and root:FindFirstChild(name) or nil
    end

    local function children(folder)
        if not folder then return {} end
        return folder:GetChildren()
    end

    local function me()
        local p = env.player
        if not p then return nil, nil end
        return p.UserId, p.Name
    end

    -- the old engine reads PrimaryPart off any non-player target, which throws on a bare part
    local function drawable(inst)
        if inst:IsA("Model") then return inst end
        if env.partTargets and inst:IsA("BasePart") then return inst end
        return nil
    end

    local function row(inst, label, kind)
        return { instance = inst, kind = kind or "object", label = label }
    end

    -- the elimination contract you hold: a player's UserId, or the npc fallback's model name
    local function contract()
        local s = env.bounty and env.bounty()
        if type(s) ~= "table" or s.State ~= "Active" then return nil, nil end
        local userId = type(s.UserId) == "number" and s.UserId or nil
        local npcName = type(s.CharacterName) == "string" and s.CharacterName ~= "" and s.CharacterName or nil
        if s.Kind == "NPC" then return nil, npcName end
        return userId, npcName
    end

    local function isPlayerModel(model)
        local ok, plr = pcall(Players.GetPlayerFromCharacter, Players, model)
        return ok and plr ~= nil
    end

    local function isBoss(model)
        if model:GetAttribute("BossNPC") == true or model:GetAttribute("WorldEventBoss") == true then return true end
        if STORY_BOSSES[cleanName(model.Name)] then return true end
        for key, value in pairs(model:GetAttributes()) do
            if value == true and key:sub(-9) == "StoryBoss" then return true end
        end
        return false
    end

    -- a combat npc: not a player, not a summon or idle prop, and a story mob only when it is pinned to you
    local function isFoe(model, myName)
        if not model:IsA("Model") or isPlayerModel(model) then return false end
        if model:FindFirstChild("Summoner") or model:FindFirstChildOfClass("Humanoid") == nil then return false end
        for _, attr in ipairs(IDLE_ATTRS) do
            if model:GetAttribute(attr) then return false end
        end
        local forced = model:GetAttribute("ForcedTargetName")
        if type(forced) == "string" and forced ~= "" and forced ~= myName then return false end
        if model:GetAttribute("CombatLifeEnded") == true then return false end
        return true
    end

    local function onYou(model, myName)
        local target = model:GetAttribute("Target")
        if type(target) == "string" and target ~= "" then return target == myName end
        local value = model:FindFirstChild("NPCCombatTarget")
        local v = value and value:IsA("ObjectValue") and value.Value
        return v ~= nil and v ~= false and v.Name == myName
    end

    local function foeTags(model, myName, contractNpc)
        local tags = {}
        if contractNpc and model.Name == contractNpc then tags[#tags + 1] = "Contract" end
        local tier = model:GetAttribute("BountyScaledTier")
        if type(tier) == "number" then
            tags[#tags + 1] = "Bounty T" .. tier
        elseif model:GetAttribute("BountyId") ~= nil or model:GetAttribute("Bounty") ~= nil then
            tags[#tags + 1] = "Bounty"
        end
        if model:GetAttribute("PassedOut") == true then tags[#tags + 1] = "Knocked" end
        if onYou(model, myName) then tags[#tags + 1] = "On you" end
        return tags
    end

    local function value(folder, name)
        local v = folder and folder:FindFirstChild(name)
        if v and v:IsA("ValueBase") then return v.Value end
        return nil
    end

    -- players: stand, level, gang mate and your elimination target, read off the replicated Data folder and attributes
    local function players()
        local myId = me()
        local mine = env.player and env.player:GetAttribute("GangId")
        local targetId = contract()
        local out = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.UserId ~= myId then
                local data = plr:FindFirstChild("Data")
                local stats = data and data:FindFirstChild("Stats")
                local level = value(stats, "Level")
                local stand = value(data, "Stand")
                local info = {}
                if type(stand) == "string" and stand ~= "" and stand ~= "None" then info[#info + 1] = stand end
                if type(level) == "number" then info[#info + 1] = "Lv " .. level end
                local gang = plr:GetAttribute("GangId")
                if mine and gang == mine then info[#info + 1] = "Gang" end
                if targetId == plr.UserId then info[#info + 1] = "TARGET" end
                local name = plr.DisplayName ~= "" and plr.DisplayName or plr.Name
                out[#out + 1] = row(plr, #info > 0 and (name .. "\n" .. join(info)) or name, "player")
            end
        end
        return out
    end

    local function enemies()
        local _, myName = me()
        local _, contractNpc = contract()
        local out = {}
        for _, model in ipairs(children(gameFolder("Players"))) do
            if isFoe(model, myName) and not isBoss(model) then
                local tags = foeTags(model, myName, contractNpc)
                local name = cleanName(model.Name)
                out[#out + 1] = row(model, #tags > 0 and (name .. "\n" .. join(tags)) or name, "entity")
            end
        end
        return out
    end

    local function bosses()
        local _, myName = me()
        local _, contractNpc = contract()
        local out = {}
        for _, model in ipairs(children(gameFolder("Players"))) do
            if isFoe(model, myName) and isBoss(model) then
                local head = cleanName(model.Name)
                local level = model:GetAttribute("BossLevel")
                if type(level) == "number" then head = head .. " Lv " .. level end
                local tags = foeTags(model, myName, contractNpc)
                if model:GetAttribute("WorldEventBoss") == true or model:GetAttribute("CommandBoss") == true then
                    table.insert(tags, 1, "World boss")
                end
                local party = model:GetAttribute("RecommendedPartySize")
                if type(party) == "number" and party > 1 then tags[#tags + 1] = "Party of " .. party end
                out[#out + 1] = row(model, #tags > 0 and (head .. "\n" .. join(tags)) or head, "entity")
            end
        end
        return out
    end

    -- quest givers: each offer the server lists for you (a Vector3Value on the giver) matched to the dialogue npc standing on it
    local function givers()
        local points = env.player and env.player:FindFirstChild("AvailableQuestPoints")
        local npcs = children(gameFolder("NPCs"))
        local offers = {}
        for _, point in ipairs(children(points)) do
            if point:IsA("Vector3Value") and point:GetAttribute("Available") ~= false then
                local best, bestD = nil, GIVER_RANGE
                for _, npc in ipairs(npcs) do
                    if npc:IsA("Model") then
                        local d = (npc:GetPivot().Position - point.Value).Magnitude
                        if d < bestD then best, bestD = npc, d end
                    end
                end
                if best then
                    local list = offers[best]
                    if not list then list = {}; offers[best] = list end
                    -- "Bobby: Bubble Practice" on Bobby reads as just the quest
                    local title = point:GetAttribute("DisplayName")
                    if type(title) == "string" and title ~= "" then
                        local prefix = best.Name .. ": "
                        if title:sub(1, #prefix) == prefix then title = title:sub(#prefix + 1) end
                    else
                        title = point.Name:gsub("^AvailableQuest_", "")
                    end
                    list[#list + 1] = title
                end
            end
        end
        local out = {}
        for npc, list in pairs(offers) do
            table.sort(list)
            local shown = list[1]
            if #list > 1 then shown = shown .. " +" .. (#list - 1) end
            out[#out + 1] = row(npc, npc.Name .. "\n" .. shown)
        end
        return out
    end

    -- your story: actors and prompts the server made for you, and your bounty party's scene
    local function story()
        local myId = me()
        if not myId then return {} end
        local idText = tostring(myId)
        local out = {}
        local function ownedByMe(inst)
            if inst:GetAttribute("StoryOwnerUserId") == myId or inst:GetAttribute("StoryPromptOwnerId") == myId then return true end
            local name = inst.Name
            return name:sub(-#idText - 1) == "_" .. idText or name:find(":" .. idText .. "]", 1, true) ~= nil
        end
        for _, inst in ipairs(children(gameFolder("StoryActors"))) do
            local target = ownedByMe(inst) and drawable(inst)
            if target then out[#out + 1] = row(target, cleanName(inst.Name)) end
        end
        local party = gameFolder("BountyWorld")
        party = party and party:FindFirstChild("Party_" .. idText)
        for _, inst in ipairs(children(party)) do
            local target = drawable(inst)
            if target then out[#out + 1] = row(target, "Bounty: " .. cleanName(inst.Name)) end
        end
        return out
    end

    -- items: world spawns (arrows and the like) and world-event drops
    local function items()
        local out = {}
        local function add(inst, prefix)
            local target = drawable(inst)
            if not target then return end
            local name = inst:GetAttribute("ItemName")
            name = type(name) == "string" and name ~= "" and name or cleanName(inst.Name)
            out[#out + 1] = row(target, prefix and (prefix .. name) or name)
        end
        for _, inst in ipairs(children(gameFolder("SpawnedItems"))) do add(inst) end
        for _, inst in ipairs(children(gameFolder("WorldEventDrops"))) do add(inst, "Event: ") end
        return out
    end

    -- your pots: what grows, its stage and the time left on the server clock
    local function pots()
        local myId = me()
        local gardening = gameFolder("Gardening")
        local folder = gardening and gardening:FindFirstChild("Pots")
        local now = env.serverNow()
        local out = {}
        for _, pot in ipairs(children(folder)) do
            if pot:IsA("Model") and pot:GetAttribute("OwnerUserId") == myId then
                local stage = pot:GetAttribute("Stage")
                local crop = pot:GetAttribute("Contains")
                local line
                if stage == "Growing" then
                    local ends = pot:GetAttribute("GrowthEndsAt")
                    line = type(ends) == "number" and ("Growing " .. clock(ends - now)) or "Growing"
                else
                    line = STAGE_TEXT[stage] or (type(stage) == "string" and stage) or "Pot"
                end
                local head = type(crop) == "string" and crop ~= "" and crop:gsub(" Seed$", "") or "Pot"
                out[#out + 1] = row(pot, head .. "\n" .. line)
            end
        end
        return out
    end

    local function bodyConfig(accent, cap)
        local config = env.defaultConfig(accent)
        config.distance.enabled = true
        config.maxTracked = cap
        return config
    end

    -- a marked spot: no box, the label and distance carry the accent
    local function pointConfig(accent, cap, interval)
        local config = env.defaultConfig(accent)
        config.box.enabled = false
        config.health.bar = false
        config.name.color = accent
        config.distance.enabled = true
        config.maxTracked = cap
        config.refreshInterval = interval or 1.0
        return config
    end

    local playersConfig = env.defaultConfig(COLOURS.players)
    playersConfig.distance.enabled = true

    return {
        { key = "Players",   label = "Players",      config = playersConfig,                   source = players },
        { key = "Entities",  label = "Enemies",      config = bodyConfig(COLOURS.enemies, 40),  source = enemies },
        { key = "Bosses",    label = "Bosses",       config = bodyConfig(COLOURS.bosses, 10),   source = bosses },
        { key = "Givers",    label = "Quest Givers", config = pointConfig(COLOURS.givers, 20, 2.0), source = givers },
        { key = "Story",     label = "Your Story",   config = pointConfig(COLOURS.story, 20),  source = story },
        { key = "Items",     label = "Items",        config = pointConfig(COLOURS.items, 30),  source = items },
        { key = "Pots",      label = "Your Pots",    config = pointConfig(COLOURS.pots, 4),    source = pots },
    }
end

return M

end)
__bundle_register("Tabs/Combat", function(require, _LOADED, __bundle_register, __bundle_modules)
-- combat tab: mounts Kill Aura + Auto Block, the shared attack/defense settings and the Stand tab, plus Aimbot; subCtx propagates Unloader since each sub-feature registers root cleanup itself
local Mount          = require("Utility/Mount")
local Aimbot         = require("Features/Combat/Aimbot")
local CombatSettings = require("Features/Combat/Settings")
local KillAura       = require("Features/Combat/KillAura")
local Stand          = require("Features/Combat/Stand")

return function(ctx)
    local O = Mount.orchestrator(ctx, "Combat")
    if not O then return end

    local subCtx = O.subCtx({ Unloader = ctx.Unloader })

    if ctx.Config.Combat then
        O.mount(KillAura, subCtx)
        O.mount(CombatSettings, subCtx)
        O.mount(Stand, subCtx)
    end
    if ctx.Config.Aimbot then O.mount(Aimbot, subCtx) end

    O.finalize()
end

end)
__bundle_register("Features/Combat/Stand", function(require, _LOADED, __bundle_register, __bundle_modules)
-- stand tab: infinite pilot range and auto pilot (left, Pilot), attach stand and attack while attached (left, Attach), projectile redirect with aim at head (right, Projectiles), auto summon and auto skills (right, Skills)
local Jobs       = require("Utility/Jobs")
local Log        = require("Utility/Log")
local Mount      = require("Utility/Mount")
local Scheduler  = require("Utility/Scheduler")
local Engage     = require("Features/Combat/Engage")
local Attach     = require("Features/Combat/Stand/Attach")
local PilotRange = require("Features/Combat/Stand/PilotRange")
local Redirect   = require("Features/Combat/Stand/Redirect")
local Skills     = require("Features/Combat/Stand/Skills")

local STEP = 0.1
local SKILL_STEP = 0.25
local RANGE_STEP = 0.5
local REDIRECT_RANGE = 200
local REDIRECT_REFRESH = 0.1

return function(ctx)
    local O = Mount.orchestrator(ctx, "Stand")
    if not O then return end
    local apis = ctx.Api or {}
    local Combat, World, Net = apis.Combat, apis.World, apis.Net
    local engine = Engage.new(ctx)
    if not (Combat and World and Net and engine) then
        Log.devwarn("Stand", "combat, world or net api missing; the stand tab won't load")
        return
    end
    local Toggles, Options, References = ctx.Toggles, ctx.Options, ctx.References
    local Workspace = ctx.Services.Workspace
    local UserInputService = ctx.Services.UserInputService

    local function toggle(id)
        local element = Toggles and Toggles[id]
        return element ~= nil and element.Value == true
    end

    local function option(id, default)
        local element = Options and Options[id]
        if element == nil or element.Value == nil then return default end
        return element.Value
    end

    local function wants(id, key)
        local value = option(id, nil)
        return type(value) == "table" and value[key] == true
    end

    local function character()
        return References.character
    end

    local function standModel()
        local ok, info = Combat.stand()
        if ok and info.model and info.model.Parent then return info.model end
        return nil
    end

    -- the stand's static data row (Stands.lua stands[name]); only its PilotRange / Range are read
    local function standDef()
        local ok, info = Combat.stand()
        if not ok then return nil end
        local okMod, Stands = Net.module("Stands")
        local stands = okMod and type(Stands) == "table" and Stands.stands
        return type(stands) == "table" and stands[info.name] or nil
    end

    -- a farm that owns movement, or kill aura, is already fighting with the stand
    local function paused()
        if toggle("KillAura_Enabled") then return true end
        local ok, owner = World.owner()
        return ok and owner ~= nil
    end

    local function valid(model, players)
        return engine.valid(model, { players = players == true })
    end

    -- ======================= pilot + attach =======================

    local range = PilotRange.new(standModel)
    local attach = Attach.new({
        Combat = Combat, World = World, character = character, standDef = standDef, valid = valid,
        serverRange = range.serverValue, paused = paused, now = os.clock,
        opts = function()
            return {
                attach = toggle("Stand_Attach"), autoPilot = toggle("Stand_AutoPilot"), attack = toggle("Stand_AttachAttack"),
                distance = tonumber(option("Stand_AttachDistance", 3)) or 3, infinite = toggle("Stand_InfiniteRange"),
                players = toggle("Stand_AttachPlayers"),
            }
        end,
    })

    O.track(Jobs.interval(RANGE_STEP, function() range.tick() end, { name = "Stand.range" }))
    O.track(Jobs.interval(STEP, function()
        local ok, err = pcall(attach.step)
        if not ok then Log.devwarn("Stand", "attach step failed: %s", tostring(err)) end
    end, { name = "Stand.attach" }))
    O.track(Scheduler.stepped(attach.frame, { name = "Stand.attachFrame" }))

    local pilot = ctx.Tabs.Stand:AddLeftGroupbox("Pilot", "gamepad-2")
    pilot:AddToggle("Stand_InfiniteRange", {
        Text     = "Infinite Pilot Range",
        Default  = false,
        Callback = function(on) range.set(on) end,
    })
    pilot:AddToggle("Stand_AutoPilot", {
        Text    = "Auto Pilot",
        Default = false,
        Tooltip = "Pilots your stand for Attach Stand",
    })

    local hold = ctx.Tabs.Stand:AddLeftGroupbox("Attach", "magnet")
    hold:AddToggle("Stand_Attach", {
        Text    = "Attach Stand",
        Default = false,
        Tooltip = "While you pilot, your stand sticks behind the nearest enemy",
    })
    hold:AddSlider("Stand_AttachDistance", {
        Text     = "Distance",
        Default  = 3,
        Min      = 1,
        Max      = 8,
        Rounding = 1,
        Suffix   = " studs",
    })
    hold:AddToggle("Stand_AttachAttack", { Text = "Attack While Attached", Default = false })
    hold:AddToggle("Stand_AttachPlayers", { Text = "Attach To Players", Default = false })

    -- ======================= projectiles =======================

    local okUtil, Utility = Net.module("Utility")
    local redirect = Redirect.new(okUtil and Utility or nil, Ray.new, function() return Workspace.CurrentCamera end)
    local candidates, refreshedAt = {}, -math.huge

    local function refresh()
        local out = {}
        local mobs, players = wants("Stand_RedirectTo", "Mobs"), wants("Stand_RedirectTo", "Players")
        if not (mobs or players) then return out end
        local ok, list = World.combatants({ alive = true, maxDistance = REDIRECT_RANGE, players = players, npcs = mobs })
        if not ok then return out end
        for _, model in ipairs(list) do
            if valid(model, players) then out[#out + 1] = model end
        end
        return out
    end

    O.track(Scheduler.render(function()
        if not toggle("Stand_Redirect") then
            redirect.point = nil
            return
        end
        local cam = Workspace.CurrentCamera
        if not cam then
            redirect.point = nil
            return
        end
        local now = os.clock()
        if now - refreshedAt >= REDIRECT_REFRESH then
            refreshedAt = now
            candidates = refresh()
        end
        local head = toggle("Stand_AimHead")
        local list = {}
        for _, model in ipairs(candidates) do
            local part = model.Parent and Redirect.aimPart(model, head)
            if part then
                local pos, onScreen = cam:WorldToViewportPoint(part.Position)
                if onScreen and pos.Z > 0 then
                    list[#list + 1] = { model = model, part = part, screen = Vector2.new(pos.X, pos.Y) }
                end
            end
        end
        local best = Redirect.pick(list, UserInputService:GetMouseLocation())
        local point = nil
        for _, c in ipairs(list) do
            if c.model == best then point = c.part.Position end
        end
        redirect.point = point
    end, { name = "Stand.redirect", priority = 60 }))

    local shots = ctx.Tabs.Stand:AddRightGroupbox("Projectiles", "crosshair")
    shots:AddToggle("Stand_Redirect", {
        Text     = "Projectile Redirect",
        Default  = false,
        Tooltip  = "Your shots fly at the enemy nearest your cursor",
        Callback = function(on)
            if on then
                if not redirect.install() then Log.devwarn("Stand", "couldn't reach the game's aim ray") end
            else
                redirect.uninstall()
            end
        end,
    })
    shots:AddToggle("Stand_AimHead", { Text = "Aim At Head", Default = false })
    shots:AddDropdown("Stand_RedirectTo", {
        Text    = "Targets",
        Values  = { "Mobs", "Players" },
        Default = { "Mobs" },
        Multi   = true,
    })

    -- ======================= skills =======================

    local auto = Skills.new({
        Combat = Combat, paused = paused, now = os.clock,
        pick = function(reach, players)
            return engine.pick({ maxDistance = reach }, { players = players })
        end,
        picked = function()
            local value = option("Combat_UseSkills", nil)
            if type(value) ~= "table" then return nil end
            return value
        end,
        distanceTo = function(model)
            local ok, info = World.info(model)
            return ok and info.distance or nil
        end,
        opts = function()
            return {
                summon = toggle("Stand_AutoSummon"), skills = toggle("Stand_AutoSkills"),
                range = tonumber(option("Stand_SkillRange", 20)) or 20, players = toggle("Stand_SkillPlayers"),
            }
        end,
    })

    O.track(Jobs.spawn(function(job)
        local function sleep(seconds) return job:sleep(seconds) end
        while job.alive do
            local ok, err = pcall(auto.step, sleep)
            if not ok then Log.devwarn("Stand", "skills step failed: %s", tostring(err)) end
            if not job:sleep(SKILL_STEP) then return end
        end
    end, { name = "Stand.skills" }))

    local skills = ctx.Tabs.Stand:AddRightGroupbox("Skills", "zap")
    skills:AddToggle("Stand_AutoSummon", { Text = "Auto Summon", Default = false })
    skills:AddToggle("Stand_AutoSkills", {
        Text    = "Auto Skills",
        Default = false,
        Tooltip = "Uses the skills picked in Attack Settings",
    })
    skills:AddSlider("Stand_SkillRange", {
        Text     = "Range",
        Default  = 20,
        Min      = 5,
        Max      = 60,
        Rounding = 0,
        Suffix   = " studs",
    })
    skills:AddToggle("Stand_SkillPlayers", { Text = "Target Players", Default = false })

    O.onUnload(function()
        attach.stop()
        range.stop()
        redirect.uninstall()
        engine.destroy()
    end)
    O.finalize()
end

end)
__bundle_register("Features/Combat/Stand/Skills", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto summon and auto skills: keeps your stand out, and while you fight by hand casts the skills picked in Attack Settings at the nearest enemy in range, one at a time, held as long as the engine holds them; auto skills stands aside while Kill Aura or a farm fights
-- a key tap or a hold, then the release the game sends on key-up (PlayerController.lua:21590); holds match the engine's hints
local TAP = 0.1
local HOLDS = { Barrage = 2.5, ["Flame Breath"] = 3 }
-- a skill with no range in its data is melee (Engage.lua SKILL_MELEE_RANGE)
local MELEE_RANGE = 9
local SUMMON_EVERY = 1
local REFUSE_FOR = 1
local UNSUPPORTED_FOR = 300

local M = {}

function M.hold(name)
    return HOLDS[name] or TAP
end

-- the first bar entry that is picked, off cooldown, not refused and reaches the target
function M.choose(bar, picked, ready, refused, rangeOf, distance)
    for _, entry in ipairs(bar) do
        local name = entry.name
        if name ~= "" and (picked == nil or picked[name]) and not refused(name) and ready(entry.slot) then
            local range = rangeOf(name) or MELEE_RANGE
            if distance <= range + 1 then return entry end
        end
    end
    return nil
end

-- deps: Combat, pick(range, players) -> model|nil, picked() -> set|nil, opts() -> { summon, skills, range, players }, paused() -> bool, distanceTo(model) -> number|nil, now(); step(sleep) takes the caller's job sleep
function M.new(deps)
    local Combat = deps.Combat
    local E = Combat.Errors or {}
    local self = {}
    local refusedUntil = {}
    local summonAt = 0

    local function refused(name)
        return deps.now() < (refusedUntil[name] or 0)
    end

    local function rangeOf(name)
        if type(Combat.skillInfo) ~= "function" then return nil end
        local ok, info = Combat.skillInfo(name)
        return ok and type(info) == "table" and tonumber(info.range) or nil
    end

    local function summon()
        local t = deps.now()
        if t < summonAt then return end
        summonAt = t + SUMMON_EVERY
        local ok, stand = Combat.stand()
        if not ok or stand.summoned then return end
        local state = Combat.state()
        if not state.alive or state.piloting then return end
        Combat.summon(true)
    end

    -- one cast per pass; true when something was cast
    local function cast(o, sleep)
        local target = deps.pick(o.range, o.players)
        if not target then return false end
        local distance = deps.distanceTo(target)
        if not distance then return false end
        local ok, bar = Combat.skills()
        if not ok then return false end
        local entry = M.choose(bar, deps.picked(), Combat.skillReady, refused, rangeOf, distance)
        if not entry then return false end
        local used, code = Combat.useSkill(entry.slot, target)
        if not used then
            refusedUntil[entry.name] = deps.now() + (code == E.UNSUPPORTED and UNSUPPORTED_FOR or REFUSE_FOR)
            return false
        end
        local alive = sleep(M.hold(entry.name))
        Combat.releaseSkill(entry.slot, target)
        return alive
    end

    function self.step(sleep)
        local o = deps.opts()
        if o.summon then summon() end
        if o.skills and not deps.paused() then cast(o, sleep) end
    end

    return self
end

return M

end)
__bundle_register("Features/Combat/Stand/Redirect", function(require, _LOADED, __bundle_register, __bundle_modules)
-- projectile redirect: points the game's own aim ray at the enemy nearest your cursor, the way its lock-on branch does (Utility.lua:2408-2414); every aim the client sends reads that ray (ProjectileAim packet :2519-2526, mouse hit :2514-2517, closestMouse direction :2809-2812), so your casts fly at the target without the camera moving; it swaps the getAimRay field on the game's Utility table while on and puts the original back when off, and a centred ray always goes to the original as the lock-on branch does
local M = {}

-- the aimed point: the head when asked and present, else the root
function M.aimPart(model, head)
    if head then
        local h = model:FindFirstChild("Head")
        if h and h:IsA("BasePart") then return h end
    end
    local root = model:FindFirstChild("HumanoidRootPart")
    if root and root:IsA("BasePart") then return root end
    return nil
end

-- candidates are { model, screen = Vector2|nil }; the on-screen one nearest the cursor
function M.pick(candidates, mouse)
    local best, bestDist = nil, math.huge
    for _, c in ipairs(candidates) do
        if c.screen then
            local d = (c.screen - mouse).Magnitude
            if d < bestDist then best, bestDist = c.model, d end
        end
