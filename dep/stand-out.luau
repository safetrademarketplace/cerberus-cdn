        if not knock or knock.answered then return false, Errors.NO_SESSION end
        if token ~= knock.token then return false, Errors.STALE end
        if S.now() >= knock.payload.ExpiresAt then return false, Errors.EXPIRED end
        knock.answered = true
        return Net.fire("FoodSafety", "Answer", { Token = knock.token, Choice = choice })
    end

