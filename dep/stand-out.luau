    end

    -- the first floor between you and the stuck waypoint that differs from yours is costed; the one you stand on never is, since every way out crosses it
    local function blame(probe, trip, waypoints, index)
        local from, to = trip.root.Position, waypoints[index].Position
        local standing = trip.hum.FloorMaterial
        local standingName = standing and standing.Name
        local samples = math.clamp(math.ceil(flat(from, to) / BLAME_STEP), 1, BLAME_SAMPLES)
        for i = 1, samples do
            local t = i / samples
            local material = probe.material(Vector3.new(from.X + (to.X - from.X) * t, to.Y, from.Z + (to.Z - from.Z) * t))
            if material and material ~= "Air" and material ~= standingName then return material end
        end
        return nil
    end

    local function reached(trip, goal)
        local p = trip.root.Position
        return flat(p, goal) <= trip.tolerance and math.abs(p.Y - goal.Y) <= HEIGHT_SLACK
    end

    local function walkBody(trip, goal, opts)
        if opts.sprint then holdSprint(trip) end
        trip.cleanup[#trip.cleanup + 1] = function()
            trip.steerTarget = nil
            if trip.root.Parent then trip.hum:MoveTo(trip.root.Position) end
        end
        steer(trip, opts)
        if opts.stream ~= false then
            shared.streamAround(goal, STREAM_WAIT)
            if not going(trip) then return false, trip.stopped end
        end
        -- opts.direct: straight at the goal the way a player runs a known route, no path planned (live 2026-11-22: the planner found no way up the
        -- rings hall's west ramp the user ran in 11 s); gives up once it stops gaining ground
        if opts.direct then
            local best, bestAt = flat(trip.root.Position, goal), os.clock()
            while going(trip) do
                if reached(trip, goal) then return settle(trip, opts) end
                headFor(trip, goal)
                task.wait(DIRECT_STEP)
                local left = flat(trip.root.Position, goal)
                if left < best - 0.5 then best, bestAt = left, os.clock() end
                if os.clock() - bestAt > DIRECT_STALL then return false, Errors.BLOCKED end
            end
            return false, trip.stopped
