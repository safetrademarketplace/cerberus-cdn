        if not Q then return false, stats end
        for _, id in ipairs(active()) do
            local def = Q.Quests[id]
            local consume = def and def.ConsumeItems
            local amount = type(consume) == "table" and consume[item] or nil
            if type(amount) == "number" and (n == nil or n == amount) then
