    local jackets, pants, accessories = {}, {}, {}
    for _, p in ipairs(owned or {}) do
        if p.kind == "Jacket" then jackets[#jackets + 1] = p
        elseif p.kind == "Pants" then pants[#pants + 1] = p
        elseif p.kind == "Accessory" then accessories[#accessories + 1] = p end
    end
    jackets, pants, accessories = sortedPieces(jackets, isCurrent), sortedPieces(pants, isCurrent), sortedPieces(accessories, isCurrent)
