end

-- HandlerQuest.lua:243-257: a lone object is one quest's entry, wrapped into the array
local function asArray(decoded)
    if type(decoded) ~= "table" then return {} end
    if next(decoded) ~= nil and decoded[1] == nil then return { decoded } end
    return decoded
end

return function(S)
    local Errors     = S.Errors
    local Net        = S.Net
    local Player     = S.Player
    local World      = S.World
    local References = S.References
    local base       = S.base

    local questsChanged = base.signal()
    local questCompleted = base.signal()
