local Executor = require("Utility/Executor")
local Globals  = require("Utility/Globals")
local Log      = require("Utility/Log")
local UiWrite  = require("Utility/UiWrite")
local AuthGate = require("Auth/Gate")

local M = {}

M.NAME = "cerbfarm"

local DEV_RELOAD = 'if not game:IsLoaded() then game.Loaded:Wait() end task.wait(3) loadstring(readfile("Bundled.lua"))()'

-- dev only: after a teleport nothing re-runs the script unless luarmor's queue does (TeleportQueue.lua), so a farm that leaves the server queues the local bundle once per session
function M.queueDevReload()
    if AuthGate.isLuarmor() then return false end
    if Globals.get("__rbx_runtime_hop_queued") then return true end
    local ok = Executor.call("queue_on_teleport", DEV_RELOAD)
    if ok then Globals.set("__rbx_runtime_hop_queued", true) end
    return ok == true
end

-- plain: (true) when cerbfarm was saved and is the autoload, (false, why) when it was left alone or failed
function M.ensure(SaveManager)
    if type(SaveManager) ~= "table" or type(SaveManager.Save) ~= "function" then return false, "no_save_manager" end
    -- live 2026-11-18: saved mid-autoload, cerbfarm caught the raid picker at its default (The Train) and every load after started a Train; a config still settling is never saved over it
    local lib = rawget(SaveManager, "Library")
    if type(lib) == "table" and lib.QuietUntil and os.clock() < lib.QuietUntil then return false, "loading" end
    local okGet, current, set = pcall(SaveManager.GetAutoloadConfig, SaveManager)
    local mine = okGet and set == true and current == M.NAME
    if okGet and set == true and not mine then return false, "own_autoload" end
    local okSave, saved, err = pcall(SaveManager.Save, SaveManager, M.NAME)
    if not okSave or saved == false then
        Log.devwarn("FarmConfig", "cerbfarm not saved: %s", tostring(okSave and err or saved))
        return false, "save_failed"
    end
    if mine then return true end
    local okAuto, auto, autoErr = pcall(SaveManager.SaveAutoloadConfig, SaveManager, M.NAME)
    if not okAuto or auto == false then
        Log.devwarn("FarmConfig", "cerbfarm not set to autoload: %s", tostring(okAuto and autoErr or auto))
        return false, "autoload_failed"
    end
    return true
end

-- plain: true when a toggle change came from the user's click, not from our own write (UiWrite) or a config being applied (SaveManager's quiet window)
function M.byHand(Library)
    if UiWrite.writing > 0 then return false end
    if type(Library) == "table" and Library.QuietUntil and os.clock() < Library.QuietUntil then return false end
    return true
end

-- live 2026-11-18 (user): switching a server-leaving farm off by hand means stop farming, so the cerbfarm autoload goes with it; (true) when it was cleared
function M.release(SaveManager)
    if type(SaveManager) ~= "table" or type(SaveManager.DeleteAutoLoadConfig) ~= "function" then return false, "no_save_manager" end
    local okGet, current, set = pcall(SaveManager.GetAutoloadConfig, SaveManager)
    if not (okGet and set == true and current == M.NAME) then return false, "not_ours" end
    local ok, cleared = pcall(SaveManager.DeleteAutoLoadConfig, SaveManager)
    if not ok or cleared == false then return false, "delete_failed" end
    return true
end

return M

end)
__bundle_register("Features/Auto/ServerIntel/ArrowHunt", function(require, _LOADED, __bundle_register, __bundle_modules)
