-- auto raid plan: the raid table, the difficulty pick off the board's per-member cooldowns, target ranking (adds before the boss), which raid npcs count as enemies, which prompts are safe to press and when a suspect is accused; pure, no game reads beyond model attributes
local Plan = {}

-- TrainRaidClient.Raids.lua:3-50 (77 Rings: Stages 6, MinLevel 40; user 2026-11-19 at level 40: add it)
Plan.RAIDS = {
    Train       = { key = "Train", label = "The Train", minLevel = 20, unit = "Car" },
    HighwayStar = { key = "HighwayStar", label = "Highway Star", minLevel = 30, unit = "Stage" },
    Rings       = { key = "Rings", label = "77 Rings", minLevel = 40, unit = "Stage" },
}
Plan.ORDER = { "Train", "HighwayStar", "Rings" }
Plan.CHOICES = {}
Plan.BY_LABEL = {}
for _, key in ipairs(Plan.ORDER) do
    local raid = Plan.RAIDS[key]
    Plan.CHOICES[#Plan.CHOICES + 1] = raid.label
    Plan.BY_LABEL[raid.label] = key
end

-- user 2026-11-19: the raid picker is a multi-select; (keys) in raid order from its value, which an older config saved as one label
function Plan.pickedKeys(value)
    local out = {}
    if type(value) == "string" then
        if Plan.BY_LABEL[value] then out[1] = Plan.BY_LABEL[value] end
        return out
    end
    if type(value) ~= "table" then return out end
    -- obsidian holds a multi pick as a set ({ [label] = true }); a default is given as a list of labels
    local set = {}
    for k, v in pairs(value) do
        if v == true then set[k] = true elseif type(v) == "string" then set[v] = true end
    end
    for _, key in ipairs(Plan.ORDER) do
        if set[Plan.RAIDS[key].label] then out[#out + 1] = key end
    end
    return out
end

-- (key to start, nil) for the next picked raid after `last` that's off cooldown, or (nil, soonest key, seconds) when every one is cooling down; readyAt maps key -> clock
function Plan.nextRaid(keys, readyAt, now, last)
    local n = #keys
    if n == 0 then return nil end
    local start = 1
    for i, key in ipairs(keys) do
        if key == last then start = i % n + 1 end
    end
    local soonest, soonestAt = nil, math.huge
    for step = 0, n - 1 do
        local key = keys[(start - 1 + step) % n + 1]
        local at = readyAt[key] or 0
        if at <= now then return key end
        if at < soonestAt then soonest, soonestAt = key, at end
    end
    return nil, soonest, soonestAt - now
end

-- TrainRaidClient.lua:1085 ("Regular", "Hard"); "Best Ready" takes hard while it is off cooldown, else regular
Plan.DIFFICULTIES = { "Regular", "Hard", "Best Ready" }
local TRY_ORDER = {
    Regular       = { "Regular" },
    Hard          = { "Hard" },
    ["Best Ready"] = { "Hard", "Regular" },
}

Plan.POSITIONS = { "Combat Settings", "Behind", "Front", "Above" }

-- a prompt whose text reads like any of these is never pressed inside a raid
local UNSAFE = { "leave", "exit", "quit", "spectate", "abandon", "give up", "cancel", "shop", "invade" }

local function lower(s) return type(s) == "string" and string.lower(s) or "" end

-- "Pesci_2632" reads as "Pesci"; live 2026-11-18: raid npcs carry the run's id in front ("TR5e8f9122_Alphonse_3")
function Plan.baseName(name)
    if type(name) ~= "string" then return "" end
    name = string.gsub(name, "^TR%x+_", "")
    return (string.gsub(name, "_%d+$", ""))
end

function Plan.keyFor(label) return Plan.BY_LABEL[label] or "Train" end

-- the run counts as live from the server's own state push (TrainRaidClient.lua:6040-6046 sets TrainRaidActive the same way)
function Plan.inRaid(state)
    return type(state) == "table" and state.Active == true
end

-- (locked line) or nil: TrainRaidClient.Donatello.lua:2092-2105 plus the raid's own MinLevel
function Plan.locked(raidKey, access, level)
    local raid = Plan.RAIDS[raidKey]
    if not raid then return "Pick a raid" end
    if access ~= true then return "Raids aren't unlocked" end
    if (tonumber(level) or 0) < raid.minLevel then return ("Needs level %d"):format(raid.minLevel) end
    return nil
end

function Plan.member(board, userId)
    if type(board) ~= "table" or type(board.Members) ~= "table" then return nil end
    for _, m in ipairs(board.Members) do
        if type(m) == "table" and m.UserId == userId then return m end
    end
    return nil
end

-- seconds left on one member's cooldown, read the way renderBoard does (TrainRaidClient.lua:735-736)
function Plan.cooldown(member, board, raidKey, difficulty)
    if type(member) ~= "table" then return 0 end
    local per = type(member.Cooldowns) == "table" and member.Cooldowns[raidKey]
    local left = type(per) == "table" and tonumber(per[difficulty]) or nil
    if left == nil and type(board) == "table" and board.Raid == raidKey then left = tonumber(member[difficulty]) end
    return math.max(0, left or 0)
end

-- { difficulty } to start now, or { wait = seconds } when every allowed difficulty cools down, or { line } when the board says no
function Plan.pickDifficulty(board, userId, raidKey, choice)
    if type(board) ~= "table" or board.Raid ~= raidKey then return { line = "Raid board didn't open" } end
    local me = Plan.member(board, userId)
    if me and me.Allowed == false then return { line = "This raid is closed for now" } end
    if me and type(board.MinLevel) == "number" and (tonumber(me.Level) or 0) < board.MinLevel and not board.Studio then
        return { line = ("Needs level %d"):format(board.MinLevel) }
    end
    local order = TRY_ORDER[choice] or TRY_ORDER.Regular
    local soonest = nil
    for _, difficulty in ipairs(order) do
        local offered = type(board.Difficulties) ~= "table" or board.Difficulties[difficulty] ~= nil
        if offered then
            local left = Plan.cooldown(me, board, raidKey, difficulty)
            if left <= 0 then return { difficulty = difficulty } end
            if not soonest or left < soonest then soonest = left end
        end
    end
    if soonest then return { wait = soonest } end
    return { line = "That difficulty isn't offered" }
end

-- "4:05"
function Plan.clock(seconds)
    local s = math.max(0, math.floor(tonumber(seconds) or 0))
    return ("%d:%02d"):format(s // 60, s % 60)
end

