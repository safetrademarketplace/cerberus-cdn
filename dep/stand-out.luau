    function api.state()
        local char = S.character()
        local hum = S.humanoid(char)
        local L = S.life
        local ragdoll = char and char:FindFirstChild("IsRagdoll")
        local modifiers = {}
        for key, value in pairs(S.injury(char).Modifiers) do modifiers[key] = value end
        return {
            alive        = S.alive(char),
            health       = hum and hum.Health or 0,
            maxHealth    = hum and hum.MaxHealth or 0,
            stunned      = S.isStunned(char),
            passedOut    = char ~= nil and char:GetAttribute("PassedOut") == true,
            ragdolled    = char ~= nil and (char:GetAttribute("Ragdolled") == true
                or (ragdoll ~= nil and ragdoll:IsA("BoolValue") and ragdoll.Value == true)),
            injury       = modifiers,
            skillActive  = S.data("SkillActive") == true,
            combatTagged = S.data("CombatTagged") == true,
            pvpTagged    = S.data("PvPCombatTagged") == true,
            pveTagged    = S.data("PvECombatTagged") == true,
            summoned     = char ~= nil and char:GetAttribute("Summoned") == true,
            piloting     = S.piloting(char),
            standAway    = char ~= nil and char:GetAttribute("StandAway") == true,
            blocking     = L.blocking,
            combatDisabled = L.combatDisabled == true,
            timeStopped  = S.timeStopped(char),
            mode         = tonumber(S.data("Mode")) or 0,
            maxMode      = tonumber(S.dataAttr("Mode", "Max")) or 100,
        }
    end

    function api.stand()
        if not S.ready() then return false, Errors.NOT_READY end
        local name = S.standName()
        if name == "" then return false, Errors.NO_STAND end
        local char = S.character()
        local model = S.standModel()
        return true, {
            name     = name,
            model    = model,
            deployed = model ~= nil and model:GetAttribute("Deployed") == true,
            stunned  = model ~= nil and model:GetAttribute("Stunned") == true,
            summoned = char ~= nil and char:GetAttribute("Summoned") == true,
        }
    end

    -- PlayerController.lua:11540-11632: Combat("Summon", bool) behind the client's own gates and 0.75 s debounce
    function api.summon(on)
        if on ~= nil and type(on) ~= "boolean" then return false, Errors.BAD_ARGS end
        if not S.ready() then return false, Errors.NOT_READY end
        local char = S.character()
        if not char then return false, Errors.NO_CHARACTER end
        if not S.alive(char) then return false, Errors.DEAD end
        if S.standName() == "" then return false, Errors.NO_STAND end
        local def = S.standDef(char)
        if not def then return false, Errors.NO_STAND end
        local L = S.life
        if S.now() < L.summonUntil then return false, Errors.COOLDOWN end
        local summoned = char:GetAttribute("Summoned") == true
        local want = on
        if want == nil then want = not summoned end
        if S.flag("StandOutCustomizationOpen") and want then return false, Errors.BUSY end
        if char:GetAttribute("NoSummon") or (def.ForceSummon and not want and summoned) then return false, Errors.BLOCKED end
        local model = S.standModel()
        if model and model:GetAttribute("Skill") and not want then return false, Errors.SKILL_ACTIVE end
        if char:FindFirstChild("Throwable") or (model and model:FindFirstChild("Throwable")) then return false, Errors.BUSY end
        if S.piloting(char) and not def.UnsummonedPilot then return false, Errors.PILOTING end
        if S.data("SkillActive") == true and not want then return false, Errors.SKILL_ACTIVE end
        if not want and char:GetAttribute("HarvestAmbushTrapsActive") then return false, Errors.BLOCKED end
        local ok, err = S.send("Summon", want)
        if not ok then return false, err end
        L.summonUntil = S.now() + SUMMON_DEBOUNCE
        return true, want
    end

    api.stunned = base.signal()
    api.died = base.signal()
    api.respawned = base.signal()
    api.damaged = base.signal()

    -- the stunned signal fires on edges of the combined event + attribute state
    local lastStun = false
    function S.refreshStun(kind)
        local now = S.isStunned()
        if now == lastStun then return end
        lastStun = now
        if now then
            api.stunned:Fire(true, kind)
        else
            api.stunned:Fire(false)
        end
    end

    local conns = {}
    local function release()
        for i = #conns, 1, -1 do
            conns[i]:Disconnect()
            conns[i] = nil
        end
    end

    local function bindCharacter(char)
        release()
        endLife()
        lastStun = false
        if not char then return end
        local dead = false
        local function died()
            if dead then return end
            dead = true
            api.died:Fire()
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            local last = hum.Health
            conns[#conns + 1] = hum.HealthChanged:Connect(function(health)
                if type(health) ~= "number" then return end
                if health < last then api.damaged:Fire(last - health) end
                last = health
                if health <= 0 then died() end
            end)
            conns[#conns + 1] = hum.Died:Connect(died)
        end
        conns[#conns + 1] = char:GetAttributeChangedSignal("CombatLifeEnded"):Connect(function()
            if char:GetAttribute("CombatLifeEnded") == true then died() end
        end)
        conns[#conns + 1] = char:GetAttributeChangedSignal("Stunned"):Connect(function()
            S.refreshStun()
        end)
        S.refreshStun()
        api.respawned:Fire(char)
    end

    local unsubAdd = References.onCharacter(function(char)
        base.safe("bind character", bindCharacter, char)
    end)
    local unsubRemove = References.onCharacterRemoving(function()
        release()
        endLife()
    end)
    if S.maid then
        S.maid:GiveTask(function()
            unsubAdd()
            unsubRemove()
            release()
            endLife()
        end)
    end

    -- PlayerController.lua:24115 / 25016: ("Stunned", character, kind) and ("Unstun", character)
    S.on("Stunned", function(_, kind)
        S.life.stunned = true
        S.life.hitEnabled = false
        S.refreshStun(kind)
    end)
    S.on("Unstun", function()
        S.life.stunned = false
        S.refreshStun()
    end)
    -- PlayerController.lua:25450: ("Ragdoll", true|"Enable"|"Pose"|false|"Disable")
    S.on("Ragdoll", function(mode)
        S.life.ragdolled = mode == true or mode == "Enable" or mode == "Pose"
    end)
    -- PlayerController.lua:25032 ("DisableCombat", bool) and 25185 ("Disable Combat", disabled, canShift)
    S.on("DisableCombat", function(disabled)
        S.life.combatDisabled = disabled
    end)
    S.on("Disable Combat", function(disabled, canShift)
        S.life.combatDisabled = disabled
        S.life.canShift = canShift
    end)
    -- PlayerController.lua:24110-24113
    S.on("Reset Combo", function()
        S.life.combo = 1
        S.life.heavy = 1
    end)
end

end)
__bundle_register("Api/Combat/Skills", function(require, _LOADED, __bundle_register, __bundle_modules)
-- combat skills: the ten-slot skill bar read from Data.Skills, cooldowns tracked from the server's Cooldown push, and the slot or ex Skill / ReleasedSkill / BarrageCancel sends in the game's own shapes
local SLOTS = { "Skill1", "Skill2", "Skill3", "Skill4", "Skill5", "Skill6", "Skill7", "Skill8", "Skill9", "Skill0" }
-- these open an aim, grapple, command or platform-pick mode before anything is sent, so a straight Skill send isn't their shape
local SPECIAL_INPUT = { ["Super Leap"] = true, ["Double Trouble"] = true, Hypnosis = true }

return function(S, api)
    local Errors = S.Errors
    local base = S.base
    local Workspace = S.Services.Workspace

    S.SLOTS = SLOTS

    -- skill name -> os.clock the server's last Cooldown push runs out
    local cooldownUntil = {}
    api.cooldown = base.signal()

    local function split(value)
        local name = string.match(value, "^[^;]*") or ""
        local variant = string.match(value, ";(.*)$")
        return name, variant
    end

    local definition = S.skillDef

    -- skills[name].Cooldown, or the per-stand entry under .Stands (Skills.lua:4395-4450)
    local function staticCooldown(def)
        if not def then return nil end
        local perStand = type(def.Stands) == "table" and def.Stands[S.standName()]
        return (type(perStand) == "table" and tonumber(perStand.Cooldown)) or tonumber(def.Cooldown)
    end

    -- the server push, the TimeStop player stamp (PlayerController.lua:23908) and a skill's own character attribute (HandlerHUD.lua:1300-1306)
    local function cooldownLeft(name, value, def)
        local now = S.now()
        local left = 0
        for _, key in ipairs({ name, value }) do
            local stamp = cooldownUntil[key]
            if stamp then left = math.max(left, stamp - now) end
        end
        if def and def.TimeStop then
            local stamp = tonumber(S.playerAttr("TimeStopCooldownUntil")) or 0
            left = math.max(left, stamp - Workspace:GetServerTimeNow())
        end
        if def and type(def.CooldownAttribute) == "string" then
            local char = S.character()
            left = math.max(left, tonumber(char and char:GetAttribute(def.CooldownAttribute)) or 0)
        end
        return math.max(0, left)
    end
    S.cooldownLeft = cooldownLeft

    -- u1.OnCooldown[name] as the controller keeps it, for skills that sit on no slot (SkillM2, BlockSkill)
    function S.skillOnCooldown(name)
        return cooldownLeft(name, name, definition(name)) > 0
    end

    local function entry(slot)
        local path = "Skills." .. slot
        local value = S.data(path)
        if type(value) ~= "string" then value = "" end
        local name, variant = split(value)
        local def = definition(value) or definition(name)
        local left = name ~= "" and cooldownLeft(name, value, def) or 0
        local bind = S.dataAttr(path, "Bind")
        return {
            slot         = slot,
            key          = bind ~= nil and tostring(bind) or nil,
            name         = name,
            variant      = variant,
            value        = value,
            onCooldown   = S.dataAttr(path, "OnCooldown") == true or left > 0,
            inUse        = S.dataAttr(path, "InUse") == true,
            cooldownLeft = left,
            cooldown     = staticCooldown(def),
            info         = name ~= "" and S.skillInfo(value) or nil,
        }
    end

    function api.skills()
        if not S.ready() then return false, Errors.NOT_READY end
        local out = {}
        for i, slot in ipairs(SLOTS) do out[i] = entry(slot) end
        return true, out
    end

    -- a slot name, a slot number 1-10, or the skill's name or full value
    local function resolve(key)
        if type(key) == "number" then
            local slot = SLOTS[key]
            return slot and entry(slot) or nil
        end
        if type(key) ~= "string" or key == "" then return nil end
        for _, slot in ipairs(SLOTS) do
            if slot == key then return entry(slot) end
        end
        for _, slot in ipairs(SLOTS) do
            local e = entry(slot)
            if e.name ~= "" and (e.name == key or e.value == key) then return e end
        end
        return nil
    end

    local function skillActive()
        return S.data("SkillActive") == true
    end

    function api.skillReady(key)
        if not S.ready() then return false end
        local e = resolve(key)
        if not e or e.name == "" or e.onCooldown then return false end
        local def = definition(e.value) or definition(e.name)
        return not skillActive() or (def ~= nil and def.canUseDuringSkills == true)
    end

    -- PlayerController.lua:25205-25221: ("Cooldown", skillName, seconds); TimeStop skills are timed by the player stamp instead
    S.on("Cooldown", function(name, seconds)
        if type(name) ~= "string" then return end
        local def = definition(name)
        if def and def.TimeStop then return end
        if type(seconds) == "number" and seconds > 0 then
            cooldownUntil[name] = S.now() + seconds
        else
            cooldownUntil[name] = nil
        end
        api.cooldown:Fire(name, seconds)
    end)

    -- blockStopForSkill (PlayerController.lua:6825-6832): a raised block drops before the cast and stays down a ping-scaled moment
    local function dropBlockForSkill()
        local L = S.life
        local player = S.References.player
        local okPing, ping = pcall(player.GetNetworkPing, player)
        local wait = math.clamp((okPing and tonumber(ping) or 0) * 2 + 0.15, 0.2, 0.8)
        L.blockAfterSkill = { deadline = S.now() + wait, seen = false }
        if L.blocking then S.blockRelease(false) end
    end

    -- a normal slot first; a name no slot holds, or opts.ex, goes through the ex slots
    local function target(key, char, opts)
        if opts.ex then return S.exResolve(key, char, true) end
        local e = resolve(key)
        if e then return e end
        if type(key) == "string" and key ~= "" then return S.exResolve(key, char, false) end
        return nil, Errors.NOT_FOUND
    end

    -- the ex branch's own gates (PlayerController.lua:21712-21737): no Hiding exception, BlockedWhileDashing, the evasive path, and the bar
    local function exGate(e, def, char)
        if char:GetAttribute("Hiding") then return Errors.BUSY end
        if def and def.BlockedWhileDashing and S.now() < S.life.dashingUntil then return Errors.BUSY end
        if e.value == S.exEvasive() then return Errors.UNSUPPORTED end
        if not S.exPayable(e.value, char, S.exBar()) then return Errors.NO_EX end
        return nil
    end

    -- the slot-input Skill shape (PlayerController.lua:21873-21901), which the ex slot path shares (PlayerController.lua:21784): (value, mouseHit, groundRay, closestMouse, inputStates), ProjectileAim first
    function api.useSkill(key, aim, opts)
        if opts ~= nil and type(opts) ~= "table" then return false, Errors.BAD_ARGS end
        opts = opts or {}
        if not S.hasNet then return false, Errors.NO_NET end
        if not S.ready() then return false, Errors.NOT_READY end
        local char = S.character()
        if not char then return false, Errors.NO_CHARACTER end
        if not S.alive(char) then return false, Errors.DEAD end
        local e, why = target(key, char, opts)
        if not e then return false, why or Errors.NOT_FOUND end
        if e.name == "" then return false, Errors.EMPTY_SLOT end
        local fullDef = definition(e.value)
        local def = fullDef or definition(e.name)
        if SPECIAL_INPUT[e.name] or (def and (def.AimOnRelease or def.GrappleInput or def.CommandSelection)) then
            return false, Errors.UNSUPPORTED
        end
        -- in ex the queue skips the slot's OnCooldown attribute and reads the skill's own cooldown (PlayerController.lua:21970)
        local onCooldown = e.onCooldown
        if e.ex then onCooldown = cooldownLeft(e.value, e.value, def) > 0 end
        if onCooldown then return false, Errors.COOLDOWN end
        if skillActive() and not (def and def.canUseDuringSkills) then return false, Errors.SKILL_ACTIVE end
        local L = S.life
        if L.combatDisabled == true then return false, Errors.COMBAT_DISABLED end
        if L.hitEnabled or L.heavySwinging or S.now() < L.summonUntil then return false, Errors.BUSY end
        if S.isStunned(char) and not (def and def.canUseWhileStunned) then return false, Errors.STUNNED end
        if char:GetAttribute("HidingInTrash") and e.value == "Sunlight Yellow Overdrive" then return false, Errors.BUSY end
        if e.ex then
            local stop = exGate(e, def, char)
            if stop then return false, stop end
        else
            if char:GetAttribute("Hiding") and e.value ~= "Rain Transport" then return false, Errors.BUSY end
            local stand = S.standDef(char)
            if stand and stand.UnsummonedPilotSkill == e.name and char:GetAttribute("Summoned") ~= true then
                return false, Errors.NEED_SUMMON
            end
        end
        local ray = nil
        if aim ~= nil then
            ray = S.aimRay(aim)
            if not ray then return false, Errors.NO_AIM end
        end
        if not S.canAct("Skill", e.value) then return false, Errors.BLOCKED end
        dropBlockForSkill()
        local ground = S.groundRay()
        local mouseHit = S.mouseHit(ray, fullDef and fullDef.MouseAimRange)
        local closest = S.closestMouse(ray)
        local ok, err = S.sendWith(ray, "Skill", e.value, mouseHit, ground, closest, S.inputStates("Skill", e.value, true))
        if not ok then return false, err end
        L.holding = e.value
        return true, { slot = e.slot, name = e.name, value = e.value, ex = e.ex == true }
    end

    -- PlayerController.lua:21590: ("ReleasedSkill", value, mouseHit, Shiftlocked, closestMouse, inputStates) when the held key comes up
    function api.releaseSkill(key, aim)
        if not S.hasNet then return false, Errors.NO_NET end
        if not S.character() then return false, Errors.NO_CHARACTER end
        local value
        local e = S.ready() and resolve(key) or nil
        if e and e.name ~= "" then
            value = e.value
        elseif type(key) == "string" and key ~= "" then
            value = key
        else
            return false, Errors.NOT_FOUND
        end
        local ray = nil
        if aim ~= nil then
            ray = S.aimRay(aim)
            if not ray then return false, Errors.NO_AIM end
        end
        local fullDef = definition(value)
        local L = S.life
        if L.holding == value then L.holding = nil end
        local ok, err = S.sendWith(ray, "ReleasedSkill", value, S.mouseHit(ray, fullDef and fullDef.MouseAimRange),
            S.shiftlocked(), S.closestMouse(ray), S.inputStates("ReleasedSkill", value))
        if not ok then return false, err end
        return true, value
    end

    -- u2.cancelBarrage (PlayerController.lua:21293-21307): BarrageCancel(skill, token) once per token, only while the character marks that barrage cancellable
    function api.barrageCancel(name)
        if not S.hasNet then return false, Errors.NO_NET end
        local char = S.character()
        if not char then return false, Errors.NO_CHARACTER end
        if not S.alive(char) then return false, Errors.DEAD end
        local token = char:GetAttribute("BarrageCancelToken")
        local cancellable = char:GetAttribute("CancellableBarrage")
        if not token then return false, Errors.NO_TOKEN end
        name = name or cancellable
        if type(name) ~= "string" or cancellable ~= name then return false, Errors.NOT_FOUND end
        local L = S.life
        if L.barrageSent == token then return true end
        local ok, err = S.Net.fire("BarrageCancel", name, token)
        if not ok then return false, err end
        L.barrageSent = token
        return true
    end
end

end)
__bundle_register("Api/Combat/Pilot", function(require, _LOADED, __bundle_register, __bundle_modules)
-- combat pilot: piloting your stand and its pilot-mode light swing through the game's own controller (the character's Core.PlayerController, which Core.lua:33-40 requires and Inits and DialogueHandler.lua:802-803 requires again), plus the dash cooldown as the game shipped it
-- Weapons.lua:1249
local SHIPPED_DASH = 1.4

return function(S, api)
    local Errors = S.Errors
    local base = S.base
    local shippedDash = nil

    local function controller()
        local char = S.character()
        local core = char and char:FindFirstChild("Core")
        local module = core and core:FindFirstChild("PlayerController")
        if not (module and module:IsA("ModuleScript")) then return nil end
        local ok, value = S.game(require, module)
        if ok and type(value) == "table" then return value end
