    -- a hit that lands shortly after an attack track started tunes that track's lead, so parry timing follows each enemy's real swing;
    -- with no listed track in the window, every unlisted one there shares the credit
    local function learnFromHit()
        local now = os.clock()
        local unknown = {}
        for i = #recentAnims, 1, -1 do
            local rec = recentAnims[i]
            local delay = now - rec.started
            if delay >= LEARN_MIN and delay <= LEARN_MAX then
                if not rec.unknown then
                    local old = animLead[rec.id] or rec.lead
