    end

    -- DialogueInfo.lua:255-271: a party member who isn't the leader can't claim the shared reward
    local function claimBounty()
        local B, err = need()
        if not B then return false, err end
        local pending = B.GetPendingRewardId(References.player)
        if not pending then return false, Errors.NOT_FOUND end
        local leader = tonumber(Player.value("Party.Leader")) or 0
        local player = References.player
        if leader > 0 and leader ~= player.UserId and player:GetAttribute("PersonalBountyReward") ~= pending then
            return false, Errors.PARTY_LEADER
        end
        return Net.fire("Bounty", "ClaimAtPetyr", pending)
    end

    -- IncidentHandler.lua:92-99: extra fields plus Id, Token and Action; id and token default to the running incident (Bounty.GetIncidentProgress)
    local function incident(id, token, action, extra)
        if type(action) ~= "string" or action == "" then return false, Errors.BAD_ARGS end
        if extra ~= nil and type(extra) ~= "table" then return false, Errors.BAD_ARGS end
        local B, err = need()
        if not B then return false, err end
        local progress = decodedList("Stats.BountyProgress")
        if id == nil then
            id = B.GetIncidentProgress(References.player)
            if not id then return false, Errors.NO_SESSION end
        end
        local entry = progress[id]
        if type(entry) ~= "table" or not entry.IncidentScenario or entry.ReadyToClaim then return false, Errors.NO_SESSION end
        token = token == nil and entry.IncidentToken or token
        if token ~= entry.IncidentToken then return false, Errors.STALE end
        local payload = {}
        for k, v in pairs(extra or {}) do payload[k] = v end
        payload.Id = id
        payload.Token = token
        payload.Action = action
        return Net.fire("Bounty", "Incident", payload)
    end

    -- BountyHandler.lua:1618-1620: answered once, for the call that is still current
    local function callFinished(id, token)
        if not call then return false, Errors.NO_SESSION end
        if (id ~= nil and id ~= call.id) or (token ~= nil and token ~= call.token) then return false, Errors.STALE end
        local current = call
        call = nil
        return Net.fire("Bounty", "CallFinished", { Id = current.id, Token = current.token })
    end

    local function playerBounty()
        return true, playerState
    end

    -- PlayerBountiesApp.lua:1229, 1559-1573 (not while Active or Completing, one press a second), 1575-1587
    local function playerBountySync() return Net.fire("PlayerBounties", "Sync") end
    local lastStart = -math.huge
    local function startPlayerBounty()
        if playerState and (playerState.State == "Active" or playerState.State == "Completing") then return false, Errors.ALREADY_ACTIVE end
        if os.clock() - lastStart < 1 then return false, Errors.COOLDOWN end
        lastStart = os.clock()
        return Net.fire("PlayerBounties", "Start")
    end
    local function cancelPlayerBounty()
        if not (playerState and (playerState.State == "Searching" or playerState.State == "Active")) then return false, Errors.NO_SESSION end
        return Net.fire("PlayerBounties", "Cancel")
    end

    S.push("Bounty", "Call", function(id, payload)
        if type(payload) ~= "table" or type(payload.Config) ~= "table" then return end
        call = { id = id, token = payload.Token, config = payload.Config }
        bountyCall:Fire(id, payload.Token, payload.Config)
    end)
    S.push("Bounty", "CancelCall", function(id, token)
        if call and call.id == id and call.token == token then call = nil end
    end)
    -- the push carries only the table, so the router hands it over as the "verb"
    S.push("PlayerBounties", nil, function(state)
        if type(state) ~= "table" or type(state.State) ~= "string" then return end
        playerState = state
        playerBountyChanged:Fire(state)
    end)

    return {
        bountyBoard = bountyBoard, activeBounties = activeBounties, bountyProgress = bountyProgress,
        acceptBounty = acceptBounty, claimBounty = claimBounty, incident = incident, callFinished = callFinished,
        playerBounty = playerBounty, playerBountySync = playerBountySync,
        startPlayerBounty = startPlayerBounty, cancelPlayerBounty = cancelPlayerBounty,
        bountyCall = bountyCall, playerBountyChanged = playerBountyChanged,
    }
end

end)
__bundle_register("Api/Combat", function(require, _LOADED, __bundle_register, __bundle_modules)
-- combat api: your fighting (state, skill bar, skill info, ex bar and loadout, stand, swings and hits, skills, block, dash, aim, tells); every send goes out through one sendCombat mirror (canStartAction gate, ProjectileAim first, whitelisted input table) and per-life state resets with the character
local Identity = require("Utility/Identity")
local Jobs     = require("Utility/Jobs")

local Api     = require("Api")
local Aim     = require("Api/Combat/Aim")
local Attacks = require("Api/Combat/Attacks")
local Errors  = require("Api/Combat/Errors")
local Ex      = require("Api/Combat/Ex")
local Info    = require("Api/Combat/Info")
local Pilot   = require("Api/Combat/Pilot")
local Skills  = require("Api/Combat/Skills")
local State   = require("Api/Combat/State")
local Tells   = require("Api/Combat/Tells")

-- the Combat remote may replicate after boot; the listener is retried at this cadence, for this many tries
local HOOK_RETRY = 2
local HOOK_TRIES = 60

-- PlayerController.lua:1097 u10: these verbs fire ProjectileAim before the Combat send
local AIM_VERBS = { Skill = true, ReleasedSkill = true, PressedSkill = true, LightAttack = true, UseItem = true }

local M = {}

local function offlineNet()
    local function refuse() return false, Errors.NO_NET end
    local function refuseHandle() return nil, Errors.NO_NET end
    return {
        fire = refuse, invoke = refuse, fireAllowed = refuse, invokeAllowed = refuse, module = refuse,
        on = refuseHandle, onVerb = refuseHandle,
    }
end

function M.new(ctx)
    local base = Api.define("Combat", ctx)
    local maid = base.maid
    local References = ctx.References

    local Net = ctx.Api and ctx.Api.Net
    local hasNet = Net ~= nil
    if not hasNet then
        base.warn("net api missing, every combat verb answers %s", Errors.NO_NET)
        Net = offlineNet()
    end
    local Player = ctx.Api and ctx.Api.Player
    if not Player then base.warn("player api missing, data reads answer %s", Errors.NOT_READY) end
    local World = ctx.Api and ctx.Api.World

    local S = {
        base = base, Errors = Errors, Net = Net, hasNet = hasNet, Player = Player, World = World,
        Services = ctx.Services, References = References, Jobs = Jobs, maid = maid, handlers = {},
        -- every call into a game module function goes through this: game code does its own require(), which dies above identity 2
        game = Identity.asGame,
    }

    -- never memoized here: Net caches hits and re-resolves a module whose instance went away
    function S.mod(name)
        local ok, value = Net.module(name)
        if ok and value ~= nil then return value end
        return nil
    end

    -- respawn-scoped, so read on every use
    function S.character()
        local char = References.character
        if char and char.Parent then return char end
        return nil
    end

    function S.root(char)
        char = char or S.character()
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root and root:IsA("BasePart") then return root end
        return nil
    end

    function S.humanoid(char)
        char = char or S.character()
        return char and char:FindFirstChildOfClass("Humanoid") or nil
    end

    function S.ready()
        return Player ~= nil and Player.ready() == true
    end

    function S.data(path)
        if not Player then return nil end
        return Player.value(path)
    end

    function S.dataAttr(path, name)
        if not Player then return nil end
        return Player.attr(path, name)
    end

    function S.playerAttr(name)
        if Player then return Player.playerAttr(name) end
        local player = References.player
        return player and player:GetAttribute(name)
    end

    -- Utility:isPlayerFlagSet (Utility.lua:135-142): the player, its character or its PlayerGui
    function S.flag(name)
        local player = References.player
        if not player then return false end
        if player:GetAttribute(name) == true then return true end
        local char = S.character()
        if char and char:GetAttribute(name) == true then return true end
        local gui = player:FindFirstChildOfClass("PlayerGui")
        return gui ~= nil and gui:GetAttribute(name) == true
    end

    -- a remote arg naming a character: the one we hold, or a twin by name when the instance came back unwrapped
    function S.isMine(inst)
        local char = S.character()
        if not char or inst == nil then return false end
        if inst == char then return true end
        return typeof(inst) == "Instance" and inst:IsA("Model") and inst.Name == char.Name and inst.Parent == char.Parent
    end

    function S.on(verb, fn)
        local list = S.handlers[verb]
        if not list then
            list = {}
            S.handlers[verb] = list
        end
        list[#list + 1] = fn
    end

    local api = { Errors = Errors }
    api.combatEvent = base.signal()

    State(S, api)
    Aim(S, api)

    -- the sendCombat mirror (PlayerController.lua:1130-1243): gate, aim packet, then the Combat send; the caller builds the whitelisted input table
    function S.sendWith(ray, verb, ...)
        if not hasNet then return false, Errors.NO_NET end
        local args = table.pack(...)
        local isRelease = (verb == "BasicAttack" and args[2] == true) or (verb == "Swing" and args[4] == true)
            or (verb == "Hit Character" and args[6] == true)
        if not S.character() then return false, Errors.NO_CHARACTER end
        if not S.canAct(verb, args[1], isRelease) then return false, Errors.BLOCKED end
        if AIM_VERBS[verb] then S.sendAim(ray) end
        local ok, err = Net.fire("Combat", verb, table.unpack(args, 1, args.n))
        if not ok then return false, err or Errors.SEND_FAILED end
        return true
    end

    function S.send(verb, ...)
        return S.sendWith(nil, verb, ...)
    end

    Info(S, api)
    Ex(S, api)
    Skills(S, api)
    Attacks(S, api)
    Pilot(S, api)
    Tells(S, api)

    -- one listener for the whole Combat remote: mapped verbs reach their owners, then everything goes out raw
    local function dispatch(verb, ...)
        local list = S.handlers[verb]
        if list then
            for _, fn in ipairs(list) do base.safe("Combat " .. tostring(verb), fn, ...) end
        end
        api.combatEvent:Fire(verb, ...)
    end

    local hooked = false
    local function hook()
        if hooked then return true end
        local handle = Net.on("Combat", dispatch)
        if not handle then return false end
        hooked = true
        if maid then maid:GiveTask(handle) end
        return true
    end

    if hasNet and not hook() then
        local tries = 0
        local poller = Jobs.interval(HOOK_RETRY, function(job)
            tries = tries + 1
            if hook() then
                job:Cancel()
            elseif tries >= HOOK_TRIES then
                base.warn("combat events still unbound after %d tries", tries)
                job:Cancel()
            end
        end, { name = "Api/Combat hook" })
        if maid and poller then maid:GiveTask(poller) end
    end

    base.log("combat api ready")
    return api
end

return M

end)
__bundle_register("Api/Combat/Tells", function(require, _LOADED, __bundle_register, __bundle_modules)
-- combat tells: server hitboxes in workspace.Game.Effects tracked by ChildAdded/ChildRemoved and their HitboxActive attribute only, plus the parry and damage-number pushes
return function(S, api)
    local base = S.base
    local Workspace = S.Services.Workspace

    api.incoming = base.signal()
    api.parried = base.signal()
    api.parrySuccess = base.signal()
    api.damageVisual = base.signal()

    -- inst -> { conn, active }
    local tracked = {}
    local folderConns = {}
    local boundFolder = nil

    -- Core.lua:1004-1008: a Hitbox or Projectile_* part, or a model marked ShowAsHitbox
    local function isHitbox(inst)
        if inst:IsA("Model") then return inst:GetAttribute("ShowAsHitbox") ~= nil and inst:GetAttribute("ShowAsHitbox") ~= false end
        return inst:IsA("BasePart") and (inst.Name == "Hitbox" or string.match(inst.Name, "^Projectile_") ~= nil)
    end

    -- Core.lua:1019: only an explicit false switches a hitbox off
    local function isActive(inst)
        return inst:GetAttribute("HitboxActive") ~= false
    end

    local function unwatch(inst)
        local entry = tracked[inst]
        if not entry then return end
        tracked[inst] = nil
        entry.conn:Disconnect()
    end

    local function watch(inst)
        if tracked[inst] or inst.Parent ~= boundFolder or not isHitbox(inst) then return end
        local entry = { active = isActive(inst) }
        entry.conn = inst:GetAttributeChangedSignal("HitboxActive"):Connect(function()
            local now = isActive(inst)
            local was = entry.active
            entry.active = now
            if now and not was then api.incoming:Fire(inst) end
        end)
        tracked[inst] = entry
        if entry.active then api.incoming:Fire(inst) end
    end

    local function releaseFolder()
        for i = #folderConns, 1, -1 do
            folderConns[i]:Disconnect()
            folderConns[i] = nil
        end
        for inst in pairs(tracked) do unwatch(inst) end
        boundFolder = nil
    end

    -- attributes land a moment after the part is parented, so a new child is judged on the next resumption cycle, as Core.lua:1050-1052 does
    local function bindEffects(folder)
        if folder == boundFolder then return end
        releaseFolder()
        boundFolder = folder
        if not folder then return end
        folderConns[#folderConns + 1] = folder.ChildAdded:Connect(function(child)
            task.defer(watch, child)
        end)
        folderConns[#folderConns + 1] = folder.ChildRemoved:Connect(unwatch)
        for _, child in ipairs(folder:GetChildren()) do watch(child) end
    end

    -- Game and Game.Effects may each arrive or be replaced after boot; only those two direct children are watched
    local gameConns = {}
    local function releaseGame()
        for i = #gameConns, 1, -1 do
            gameConns[i]:Disconnect()
            gameConns[i] = nil
        end
    end

    local function bindGame(gameFolder)
        releaseGame()
        if not gameFolder then
            bindEffects(nil)
            return
        end
        gameConns[#gameConns + 1] = gameFolder.ChildAdded:Connect(function(child)
            if child.Name == "Effects" then bindEffects(child) end
        end)
        gameConns[#gameConns + 1] = gameFolder.ChildRemoved:Connect(function(child)
            if child == boundFolder then bindEffects(gameFolder:FindFirstChild("Effects")) end
        end)
        bindEffects(gameFolder:FindFirstChild("Effects"))
    end

    local rootConns = {}
    rootConns[#rootConns + 1] = Workspace.ChildAdded:Connect(function(child)
        if child.Name == "Game" then bindGame(child) end
    end)
    bindGame(Workspace:FindFirstChild("Game"))
    if S.maid then
        S.maid:GiveTask(function()
            for i = #rootConns, 1, -1 do
                rootConns[i]:Disconnect()
                rootConns[i] = nil
            end
            releaseGame()
            releaseFolder()
        end)
    end

    local function describe(inst)
        local part = inst
        if inst:IsA("Model") then part = inst.PrimaryPart end
        if not part then return nil end
        local viewer = inst:GetAttribute("HitboxViewerUserId")
        return {
            instance = inst,
            part = part,
            kind = inst:IsA("Model") and "model" or (inst.Name == "Hitbox" and "hitbox" or "projectile"),
            cframe = part.CFrame,
            position = part.Position,
            size = part.Size,
            viewerUserId = type(viewer) == "number" and viewer or nil,
        }
    end

    function api.hitboxes()
        local out = {}
        for inst, entry in pairs(tracked) do
            if not inst.Parent then
                unwatch(inst)
            elseif entry.active then
                local info = describe(inst)
                if info then out[#out + 1] = info end
            end
        end
        return true, out
    end

    -- PlayerController.lua:25255: ("Parried", victim|nil, "M2"?)
    S.on("Parried", function(victim, kind)
        api.parried:Fire(victim, kind)
    end)
    -- PlayerController.lua:25222-25227: ("ParrySuccess", character|nil) for your own parry
    S.on("ParrySuccess", function(who)
        if who ~= nil and not S.isMine(who) then return end
        api.parrySuccess:Fire()
    end)
    -- Core.lua:3101-3106: ("DamageVisual", target, amount, isHeal), finite positive amounts only
    S.on("DamageVisual", function(target, amount, isHeal)
        if typeof(target) ~= "Instance" or not target.Parent then return end
        if type(amount) ~= "number" or amount ~= amount or amount <= 0 or amount == math.huge then return end
        api.damageVisual:Fire(target, amount, isHeal == true)
    end)
end

end)
