        local hold = prompt.HoldDuration
        if hold > 0 then
            -- a scripted hold only reaches the prompt the game has focused (OneGlobally exclusivity), so a hold that never triggered falls through to the executor helper (live 2026-11-17: Rohan's dropped diamond)
            local triggered = false
            local okConn, conn = pcall(prompt.Triggered.Connect, prompt.Triggered, function() triggered = true end)
            holding, holdingUntil = prompt, os.clock() + hold + HOLD_SLACK + TRIGGER_WAIT + 0.5
            local began = pcall(prompt.InputHoldBegin, prompt)
            if began then
                task.wait(hold + HOLD_SLACK)
                if prompt.Parent then pcall(prompt.InputHoldEnd, prompt) end
                task.wait(TRIGGER_WAIT)
            end
            holding = nil
            if okConn and conn then conn:Disconnect() end
            if not prompt.Parent then return true end
            if triggered then return true end
            if hold > LONG_HOLD then return false, Errors.HOLD_FAILED end
            if Executor.call("fireproximityprompt", prompt) then return true end
            if not began then return false, Errors.UNAVAILABLE end
            return true
        end
        local fired = Executor.call("fireproximityprompt", prompt)
        if fired then return true end
        -- no executor helper: a zero-length hold is the same press
        local began = pcall(prompt.InputHoldBegin, prompt)
        if not began then return false, Errors.UNAVAILABLE end
        pcall(prompt.InputHoldEnd, prompt)
        return true
    end
    shared.firePrompt = firePrompt
    shared.prompts = prompts

    return {
        prompts    = prompts,
        firePrompt = firePrompt,
    }
end

end)
__bundle_register("Api/World/Places", function(require, _LOADED, __bundle_register, __bundle_modules)
-- world places: named destinations read fresh from the game's own containers on every call (spawns, npcs, quest offers, phone map points, quest locations, quest zones, interactables, huber stops, areas), the quest tracker target and the weather flags
local WEATHER = { rain = "Rain", fog = "Fog", thunderstorm = "Thunderstorm", lahainaNoon = "LahainaNoon" }

return function(ctx, shared)
    local Services   = ctx.Services
    local References = ctx.References
    local Workspace  = Services.Workspace
    local RS         = Services.ReplicatedStorage
    local base       = shared.base
    local Errors     = shared.Errors

    local weatherChanged = base.signal()

    local function pointOf(inst)
        if inst:IsA("BasePart") then return inst.Position end
        if inst:IsA("Model") then return inst:GetPivot().Position end
        if inst:IsA("Attachment") then return inst.WorldPosition end
        if inst:IsA("Vector3Value") then return inst.Value end
        return nil
    end

    local function gameChild(name)
        local root = Workspace:FindFirstChild("Game")
        return root and root:FindFirstChild(name) or nil
    end

    local function children(folder)
        if not folder then return {} end
        return folder:GetChildren()
    end

    local function fromFolder(out, kind, folder)
        for _, inst in ipairs(children(folder)) do
            local position = pointOf(inst)
            if position then
                out[#out + 1] = { name = inst.Name, kind = kind, position = position, instance = inst }
            end
        end
    end

    -- the Vector3Value markers the phone shows only while Available (PointsController.lua:325)
    local function fromMarkers(out, kind, folder)
        for _, inst in ipairs(children(folder)) do
            if inst:IsA("Vector3Value") and inst:GetAttribute("Available") == true then
                local display = inst:GetAttribute("DisplayName")
                local detail = inst:GetAttribute("Detail")
                local mapKind = inst:GetAttribute("Kind")
                out[#out + 1] = {
                    name     = type(display) == "string" and display or inst.Name,
                    id       = inst.Name,
                    kind     = kind,
                    position = inst.Value,
                    detail   = type(detail) == "string" and detail or nil,
                    mapKind  = type(mapKind) == "string" and mapKind or nil,
                    instance = inst,
                }
            end
        end
    end

    local readers = {}

    function readers.spawn(out) fromFolder(out, "spawn", gameChild("Spawns")) end
    function readers.quest_zone(out) fromFolder(out, "quest_zone", gameChild("QuestZones")) end
    function readers.interactable(out) fromFolder(out, "interactable", gameChild("QuestInteractables")) end
    function readers.quest_location(out) fromMarkers(out, "quest_location", RS:FindFirstChild("QuestLocations")) end
    function readers.map(out) fromMarkers(out, "map", RS:FindFirstChild("PhoneMapPoints")) end

    function readers.quest_offer(out)
        local player = References.player
        fromMarkers(out, "quest_offer", player and player:FindFirstChild("AvailableQuestPoints"))
    end

    -- streamed npc models first, then the phone's NPC markers for the ones streamed out, as NpcTracking.Position does (NpcTracking.lua:14-37)
    function readers.npc(out)
        local seen = {}
        for _, model in ipairs(children(gameChild("NPCs"))) do
            if model:IsA("Model") then
                seen[model.Name] = true
                out[#out + 1] = { name = model.Name, kind = "npc", position = model:GetPivot().Position, instance = model }
            end
        end
        for _, inst in ipairs(children(RS:FindFirstChild("PhoneMapPoints"))) do
            local display = inst:GetAttribute("DisplayName")
            if inst:IsA("Vector3Value") and inst:GetAttribute("Kind") == "NPC" and type(display) == "string" and not seen[display] then
                seen[display] = true
                out[#out + 1] = { name = display, kind = "npc", position = inst.Value, detail = "map", instance = inst }
            end
        end
    end

    -- the server's own stop list once Huber has pushed one, else the Stops folder
    function readers.huber_stop(out)
        local stops = shared.huberStops and shared.huberStops()
        if stops and #stops > 0 then
            for _, stop in ipairs(stops) do
                if type(stop) == "table" and stop.Id ~= nil and typeof(stop.Position) == "Vector3" then
                    out[#out + 1] = {
                        name = tostring(stop.Id), id = stop.Id, kind = "huber_stop", position = stop.Position,
                        detail = type(stop.Description) == "string" and stop.Description or nil,
                    }
                end
            end
            return
        end
        local huber = gameChild("Huber")
        fromFolder(out, "huber_stop", huber and huber:FindFirstChild("Stops"))
    end

    function readers.area(out)
        for _, area in ipairs(shared.areaList()) do
            out[#out + 1] = { name = area.title, id = area.id, kind = "area", position = area.position, detail = area.subtitle, instance = area.source }
        end
    end

    local ORDER = { "spawn", "npc", "quest_offer", "map", "quest_location", "quest_zone", "interactable", "huber_stop", "area" }

    local function destinations(kind)
        local out = {}
        if kind == nil then
            for _, name in ipairs(ORDER) do readers[name](out) end
            return true, out
        end
        local reader = readers[kind]
        if not reader then return false, Errors.BAD_ARGS end
        reader(out)
        return true, out
    end

    local function npc(name)
        if type(name) ~= "string" or name == "" then return false, Errors.BAD_ARGS end
        local folder = gameChild("NPCs")
        local model = folder and folder:FindFirstChild(name)
        if not (model and model:IsA("Model")) then return false, Errors.NOT_FOUND end
        return true, model
    end

    -- the phone's tracked-quest marker (PointsController.lua:190-198)
    local function trackerTarget()
        local position = shared.playerAttr("VisibleQuestTrackerPosition")
        if typeof(position) ~= "Vector3" then return false, Errors.NO_TRACKER end
        local name = shared.playerAttr("VisibleQuestTrackerName")
        return true, { name = type(name) == "string" and name or nil, position = position }
    end

    local function snapshot()
        local out = {}
        for key, attr in pairs(WEATHER) do out[key] = Workspace:GetAttribute(attr) == true end
        return out
    end

    for _, attr in pairs(WEATHER) do
        shared.track(Workspace:GetAttributeChangedSignal(attr):Connect(function()
            weatherChanged:Fire(snapshot())
        end))
    end

    return {
        destinations   = destinations,
        npc            = npc,
        trackerTarget  = trackerTarget,
        weather        = function() return true, snapshot() end,
        weatherChanged = weatherChanged,
    }
end

end)
__bundle_register("Api/World/Movement", function(require, _LOADED, __bundle_register, __bundle_modules)
-- world movement: the one sanctioned mover, one claimed owner at a time; travelTo (the default) is one PivotTo then a bounded stream and ViewZones wait, walkTo follows a fresh path per compute with a stuck check and a replan that must change the path, glideTo wraps Helpers.MoveToPos, attach holds you on a target every heartbeat; the travel verbs yield and answer (true) on arrival or (false, code)
local Executor = require("Utility/Executor")
local Scheduler = require("Utility/Scheduler")

local DIRECT_STEP = 0.1
local DIRECT_STALL = 1.5
local SPRINT_AGAIN = 0.5
local TOLERANCE       = 4
local HEIGHT_SLACK    = 8      -- a walk arrives level with the goal, not on the roof above it
local POLL            = 0.1
local TRAVEL_OFFSET   = 3      -- a travel lands this far above the target so the root clears the floor
local GROUND_UP       = 250    -- a ground landing looks for the floor from this far above the spot
local GROUND_DEPTH    = 600    -- down to this far below that
local STREAM_WAIT     = 2
local WAYPOINT_RADIUS = 3
local REISSUE_AFTER   = 5      -- Humanoid:MoveTo gives up by itself after 8 s
local STUCK_AFTER     = 2.5
local PROGRESS        = 0.75
local JUMP_AFTER      = 1
local JUMP_EVERY      = 0.8
local LEG_LENGTH      = 200    -- a leg stays inside what has streamed in around you
local PATH_END_SLACK  = 6      -- a Success path that stops further than this from its goal is no path
local PATH_END_RISE   = 8
local REPLANS         = 4
local REPLAN_PAUSE    = 0.5
local AVOID_COST      = 50
local SAME_PATH       = 1.5    -- two paths whose first waypoints all sit this close are the same path
local SAME_PATH_SPAN  = 6
local DETOUR_SIDE     = 8
local BLAME_STEP      = 1.5
local BLAME_SAMPLES   = 20
local PROBE_UP        = 3      -- probes start just above the target: from higher up a roof is the first hit
local PROBE_DEPTH     = 40
local LEG_PROBE_UP    = 12
local LEG_PROBE_DEPTH = 80
local GLIDE_REACH     = 3.5    -- MoveToPos lets go at 3 studs
local GLIDE_STUCK     = 3
local DEFAULT_SPEED   = 16
local DEFAULT_SPRINT  = 15
local AGENT           = { AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 6 }

local function flat(a, b)
