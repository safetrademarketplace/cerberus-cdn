-- attach movers: the interchangeable ways to hold the character on a placement cframe, so a fork that cannot afford cframe writes can swap the pin instead of forking the engine

local Str = require("Utility/Helpers/Str")

local M = {}

local function zeroVelocity(part)
    part.AssemblyLinearVelocity = Vector3.zero
    part.AssemblyAngularVelocity = Vector3.zero
end

local function pinCFrame(hrp, cf)
    hrp.CFrame = cf
    zeroVelocity(hrp)
end

-- a mover def is { key, label, available() -> bool, new(deps) -> { hold, release } }; hold runs every tick and owns its own change detection
function M.new(deps)
    local NewMaid = deps.NewMaid

    -- hrp children replicate to the server, so the constraint names carry no brand string
    local moverName = "_at" .. Str.randomHex(8)

    local defs, order = {}, {}

    local function register(def)
        if type(def) ~= "table" then return false end
        if type(def.key) ~= "string" or def.key == "" then return false end
        if type(def.new) ~= "function" then return false end
        if not defs[def.key] then order[#order + 1] = def.key end
        defs[def.key] = {
            key       = def.key,
            label     = tostring(def.label or def.key),
            available = (type(def.available) == "function") and def.available or function() return true end,
            new       = def.new,
        }
        return true
    end

    -- the target owns our physics rep, so the server reads a carried player rather than a teleporting one
    register({
        key   = "physics",
        label = "Physics Rep",
        available = function() return type(sethiddenproperty) == "function" end,
        new = function()
            local pinnedRoot, pinnedHrp = nil, nil
            return {
                hold = function(hrp, cf, targetRoot)
                    pinCFrame(hrp, cf)
                    if not targetRoot then return end
                    -- the property lives on our root, so a respawn needs it set again even for the same target
                    if pinnedRoot ~= targetRoot or pinnedHrp ~= hrp then
                        pcall(sethiddenproperty, hrp, "PhysicsRepRootPart", targetRoot)
                        pinnedRoot, pinnedHrp = targetRoot, hrp
                    end
                    pcall(zeroVelocity, targetRoot)
                end,
                release = function(hrp)
                    if hrp and hrp.Parent and pinnedRoot then
                        pcall(sethiddenproperty, hrp, "PhysicsRepRootPart", nil)
                    end
                    pinnedRoot, pinnedHrp = nil, nil
                end,
            }
        end,
    })

    -- the same pin without the hidden property, for executors that do not expose it
    register({
        key   = "cframe",
        label = "Direct",
        new = function()
            return {
                hold = function(hrp, cf) pinCFrame(hrp, cf) end,
                release = function() end,
            }
        end,
    })

    -- no cframe writes at all: constraints drag the character there, for games that watch for position jumps
    register({
        key   = "align",
        label = "Constraints",
        new = function()
            local bound, bin, position, orientation = nil, nil, nil, nil

            local function teardown()
                if bin then bin:DoCleaning() end
                bound, bin, position, orientation = nil, nil, nil, nil
            end

            local function build(hrp)
                teardown()
                bin = NewMaid()

                for _, child in ipairs(hrp:GetChildren()) do
                    if child.Name == moverName then child:Destroy() end
                end

                local attachment = Instance.new("Attachment")
                attachment.Name = moverName
                attachment.Parent = hrp
                bin:GiveTask(attachment)

                position = Instance.new("AlignPosition")
                position.Name = moverName
                position.Mode = Enum.PositionAlignmentMode.OneAttachment
                position.Attachment0 = attachment
                position.ApplyAtCenterOfMass = true
                position.Responsiveness = 200
                -- finite constants rather than math.huge: an infinite-force constraint is a known anti-cheat heuristic
                position.MaxForce = 1e7
                position.MaxVelocity = 1e4
                position.Parent = hrp
                bin:GiveTask(position)

                orientation = Instance.new("AlignOrientation")
                orientation.Name = moverName
                orientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
                orientation.Attachment0 = attachment
                orientation.Responsiveness = 200
                orientation.RigidityEnabled = true
                orientation.MaxTorque = 1e7
                orientation.Parent = hrp
                bin:GiveTask(orientation)

                bound = hrp
            end

            return {
                hold = function(hrp, cf)
                    if bound ~= hrp or not (position and position.Parent) then build(hrp) end
                    position.Position = cf.Position
                    orientation.CFrame = cf
                end,
                release = teardown,
            }
        end,
    })

    local function get(key)
        return (type(key) == "string") and defs[key] or nil
    end

    -- takes a key or a display label; an unknown or unsupported one degrades to the best supported mover
    local function resolve(keyOrLabel)
        local def = get(keyOrLabel)
        if not def and type(keyOrLabel) == "string" then
            for _, key in ipairs(order) do
                if defs[key].label == keyOrLabel then
                    def = defs[key]
                    break
                end
            end
        end
        if def and def.available() then return def end
        for _, other in ipairs(order) do
            if defs[other].available() then return defs[other] end
        end
        return nil
    end

    local function create(key)
        local def = resolve(key)
        if not def then return nil end
        return def.new({ NewMaid = NewMaid }), def
    end

    local function list()
        local out = {}
        for _, key in ipairs(order) do
            local def = defs[key]
            if def.available() then out[#out + 1] = { key = key, label = def.label } end
        end
        return out
    end

    return {
        Register = register,
        Get      = get,
        Resolve  = resolve,
        Create   = create,
        List     = list,
    }
end

return M

end)
__bundle_register("Api/Attach/Groups", function(require, _LOADED, __bundle_register, __bundle_modules)
-- attach groups: named sources of attach candidates; players and entities ship universal, forks register their own

local M = {}

-- a group def is { key, label?, gather = function(def) -> candidates, options? }; gather reads def.options to narrow itself
function M.new(targeting)
    local defs, order = {}, {}

    local function register(def)
        if type(def) ~= "table" then return false end
        if type(def.key) ~= "string" or def.key == "" then return false end
        if type(def.gather) ~= "function" then return false end
        if not defs[def.key] then order[#order + 1] = def.key end
        defs[def.key] = {
            key     = def.key,
            label   = tostring(def.label or def.key),
            gather  = def.gather,
            options = (type(def.options) == "table") and def.options or {},
        }
        return true
    end

    register({ key = "Players",  label = "Players",  gather = function(def) return targeting.gatherPlayers(def) end })
    register({ key = "Entities", label = "Entities", gather = function(def) return targeting.gatherEntities(def) end })

    local function get(key)
        return (type(key) == "string") and defs[key] or nil
    end

    -- takes either a key or the display label, so a ui dropdown can hand back whichever it happens to hold
    local function resolve(keyOrLabel)
        if type(keyOrLabel) ~= "string" then return nil end
        if defs[keyOrLabel] then return keyOrLabel end
        for _, key in ipairs(order) do
            if defs[key].label == keyOrLabel then return key end
        end
        return nil
    end

    local function list()
        local out = table.create(#order)
        for i, key in ipairs(order) do
            out[i] = { key = key, label = defs[key].label }
        end
        return out
    end

    local function setOptions(key, options)
        local def = get(key)
        if not (def and type(options) == "table") then return false end
        def.options = options
        return true
    end

    return {
        Register   = register,
        Get        = get,
        Resolve    = resolve,
        List       = list,
        SetOptions = setOptions,
        First      = function() return order[1] end,
    }
end

return M

end)
__bundle_register("Api/Attach/Engine", function(require, _LOADED, __bundle_register, __bundle_modules)
-- attach engine: the tick loop that resolves a target, holds the character on it through the active mover, and reports every transition as a signal

local Scheduler = require("Utility/Scheduler")

local M = {}

local REFRESH_SECONDS = 0.5  -- candidate list rebuild cadence
local DEFAULT_MOVER   = "physics"

function M.new(deps)
    local Movers     = deps.Movers
    local Placement  = deps.Placement
    local References = deps.References
    local Runtime    = deps.Runtime
    local Selection  = deps.Selection
    local Targeting  = deps.Targeting
    local base       = deps.base
    local maid       = deps.maid

    local signals = {
        Started        = base.signal(),
        Stopped        = base.signal(),
        Attached       = base.signal(),
        Lost           = base.signal(),
        TargetChanged  = base.signal(),
        TargetsChanged = base.signal(),
    }

    local running, autoRefresh = false, false
    local active, attached = nil, false
    local mover, moverKey = nil, nil
    local tickHandle = nil

    -- SessionLifecycle owns these handles, so read through and revalidate rather than writing them back
    local function localRoot()
        local hrp = References.humanoidRootPart
        if hrp and hrp.Parent then return hrp end
        local char = References.player and References.player.Character
        hrp = char and char:FindFirstChild("HumanoidRootPart")
        return (hrp and hrp.Parent) and hrp or nil
    end

    local function setMover(key)
        local def = Movers.Resolve(key)
        if not def then return false end
        if def.key == moverKey and mover then return true end
        if mover then mover.release(localRoot()) end
        local instance = Movers.Create(def.key)
        if not instance then
            mover, moverKey = nil, nil
            return false
        end
        mover, moverKey = instance, def.key
        return true
    end

    -- release is for a target going away, never for one switching: every mover rebinds itself inside hold
    local function clearTarget(hrp, release)
        local name = active and Targeting.getName(active) or nil
        active, attached = nil, false
        if release and mover then mover.release(hrp) end
        return name
    end

    local function tick(dt)
        local hrp = localRoot()
        if not hrp then
            -- mid-respawn: keep the target in mind so the next character picks it straight back up
            if active then Selection.Remember(active) end
            return
        end
        if not mover then return end

        Placement.Step(dt)

        local target, lost = Selection.Resolve(hrp, active)
        if lost then signals.Lost:Fire(lost.name, lost.reason) end

        if not target then
            local previous = clearTarget(hrp, true)
            if previous then signals.TargetChanged:Fire(previous, nil, nil) end
            return
        end

        if not Targeting.same(active, target) then
            local previous = clearTarget(hrp, false)
            active = target
            Placement.Reset()
            Selection.Forget()
            local name = Targeting.getName(target)
            base.log("target -> %s", name)
            signals.TargetChanged:Fire(previous, name, target)
        end

        -- selection hands back an invalid target while its grace window runs; hold the slot but do not pin to a corpse
        if Selection.InvalidReason(active) then
            attached = false
            return
        end

        local desired = Placement.Desired(active)
        if not desired then return end

        mover.hold(hrp, desired, Targeting.getRoot(active))
        if not attached then
            attached = true
            signals.Attached:Fire(Targeting.getName(active), active)
        end
    end

    local function start()
        if running then return false end
        running = true
        Placement.Reset()
        Runtime.Start()
        base.log("start")

        -- the outer xpcall keeps the traceback and stops a transient step error from striking the task out
        tickHandle = Scheduler.heartbeat(function(dt)
            local ok, err = xpcall(tick, function(e) return debug.traceback(tostring(e), 2) end, dt)
            if not ok then base.warn("tick failed: %s", tostring(err)) end
        end, { name = "AttachStep", priority = 50 })

        signals.Started:Fire()
        return true
    end

    local function stop()
        if not running then return false end
        running = false
        if tickHandle then
            tickHandle:Disconnect()
            tickHandle = nil
        end
        clearTarget(localRoot(), true)
        Runtime.Stop()
        base.log("stop")
        signals.Stopped:Fire()
        return true
    end

    -- one deferrable low-priority task covers both the ui list and the engine's own candidate pool
    maid:GiveTask(Scheduler.heartbeat(function()
        if not (running or autoRefresh) then return end
        local ok, names, changed = pcall(Selection.Refresh)
        if not ok then
            base.warn("target refresh failed: %s", tostring(names))
            return
        end
        if changed then signals.TargetsChanged:Fire(names) end
    end, { name = "AttachTargets", priority = 200, interval = REFRESH_SECONDS, deferrable = true }))

    maid:GiveTask(References.onCharacterRemoving(function()
        if running and active then Selection.Remember(active) end
        clearTarget(nil, false)
        if mover then mover.release(nil) end
    end))

    maid:GiveTask(function() stop() end)

    setMover(DEFAULT_MOVER)
    Selection.Refresh()

    return {
        Started        = signals.Started,
        Stopped        = signals.Stopped,
        Attached       = signals.Attached,
        Lost           = signals.Lost,
        TargetChanged  = signals.TargetChanged,
        TargetsChanged = signals.TargetsChanged,

        Start     = start,
        Stop      = stop,
        IsRunning = function() return running end,

        SetMover = setMover,
        GetMover = function() return moverKey end,

        -- the ui turns this on while it is mounted; off, the list only rebuilds while attach is actually running
        SetAutoRefresh = function(on) autoRefresh = on == true end,

        -- rebuilds and announces unconditionally, for when the groups themselves changed rather than the world
        PublishTargets = function()
            local names = Selection.Refresh()
            signals.TargetsChanged:Fire(names)
            return names
        end,

        GetActiveTarget = function() return active end,

        GetStatus = function()
            local target = nil
            if active then
                local inst = Targeting.token(active)
                target = {
                    name     = Targeting.getName(active),
                    instance = (typeof(inst) == "Instance") and inst or nil,
                    group    = active.group,
                }
            end
            return {
                running       = running,
                attached      = running and attached and Placement.HasFix(),
                target        = target,
                group         = Selection.GetGroup(),
                retarget      = Selection.GetRetarget(),
                followNearest = Selection.FollowsNearest(),
                mover         = moverKey,
                offset        = Placement.GetOffset(),
            }
        end,
    }
end

return M

end)
__bundle_register("Api/Activities", function(require, _LOADED, __bundle_register, __bundle_modules)
-- activities api: things you do (quests, bounties, raids, world events, minigame sessions, gardening, codes, crafting, storage, hamon); every push listener binds at construction so session state is already held when a feature asks
local Jobs = require("Utility/Jobs")

local Api       = require("Api")
local Bounties  = require("Api/Activities/Bounties")
local Economy   = require("Api/Activities/Economy")
local Errors    = require("Api/Activities/Errors")
local Events    = require("Api/Activities/Events")
local Gardening = require("Api/Activities/Gardening")
local Minigames = require("Api/Activities/Minigames")
local Quests    = require("Api/Activities/Quests")
local Raids     = require("Api/Activities/Raids")

-- remotes can replicate after boot; unbound push listeners are retried at this cadence, for this many tries
local HOOK_RETRY = 2
local HOOK_TRIES = 60
local POLL = 0.05

local M = {}

local function offlineNet()
    local function refuse() return false, Errors.NO_NET end
    local function refuseHandle() return nil, Errors.NO_NET end
    return {
        fire = refuse, invoke = refuse, fireAllowed = refuse, invokeAllowed = refuse, module = refuse,
        on = refuseHandle, onVerb = refuseHandle,
    }
end

-- without Player there is no Data tree to read; every read answers nil and S.need refuses
local function offlinePlayer()
    local function none() return nil end
    return {
        ready = function() return false end,
        node = none, value = none, attr = none, json = none, playerAttr = none,
        csv = function() return {} end,
        observe = none, observePlayerAttr = none,
        findItem = function() return false, Errors.NO_PLAYER end,
    }
end

function M.new(ctx)
    local base       = Api.define("Activities", ctx)
    local maid       = base.maid
    local References = ctx.References
    local Workspace  = ctx.Services.Workspace

    local Net = ctx.Api and ctx.Api.Net
    local hasNet = Net ~= nil
    if not hasNet then
        base.warn("net api missing, every verb answers %s", Errors.NO_NET)
        Net = offlineNet()
    end

    local Player = ctx.Api and ctx.Api.Player
    local hasPlayer = Player ~= nil
    if not hasPlayer then
        base.warn("player api missing, every read answers %s", Errors.NO_PLAYER)
        Player = offlinePlayer()
    end

    local World = ctx.Api and ctx.Api.World
    if not World then base.warn("world api missing, offers and tracker positions are unavailable") end

    local S = {
        base = base, Errors = Errors, Net = Net, Player = Player, World = World,
        Services = ctx.Services, References = References, hasNet = hasNet,
    }

    function S.need()
        if not hasPlayer or not References.player then return Errors.NO_PLAYER end
        if not Player.ready() then return Errors.NOT_READY end
        return nil
    end

    function S.now()
        return Workspace:GetServerTimeNow()
    end

    -- the game's own cached module, or nil when it can't be reached
    function S.module(name)
        local ok, value = Net.module(name)
        if ok and value ~= nil then return value end
        return nil
    end

    -- the Data.Stats folder the game's quest and bounty helpers take as their first argument
    function S.stats()
        return Player.node("Stats")
    end

    -- read on every use: the character is respawn-scoped
    function S.root()
        local char = References.character
        if not (char and char.Parent) then return nil end
        return char:FindFirstChild("HumanoidRootPart")
    end

    function S.track(conn)
        if conn and maid then maid:GiveTask(conn) end
        return conn
    end

    -- a caller's handle: Disconnect runs cleanup now, unload runs it through the maid, never twice
    function S.own(cleanup)
        local done = false
        local function run()
            if done then return end
            done = true
            cleanup()
        end
        local id = maid and maid:GiveTask(run) or nil
        local handle = {}
        function handle:Disconnect()
            if done then return end
            if id then
                maid[id] = nil
                id = nil
            else
                run()
            end
        end
        handle.Destroy = handle.Disconnect
        return handle
    end

    -- yields until cond() holds or timeout passes; the caller runs inside its own job
    function S.waitFor(cond, timeout)
        local deadline = os.clock() + timeout
        while not cond() do
            if os.clock() >= deadline then return false end
            task.wait(POLL)
        end
        return true
    end

    -- a push listener bound once the remote exists; verb nil listens to every message as fn(verb, ...)
    local hooks = {}
    function S.push(remote, verb, fn, onBound)
        hooks[#hooks + 1] = { remote = remote, verb = verb, fn = fn, onBound = onBound }
    end

    local api = { Errors = Errors }
    for _, build in ipairs({ Quests, Bounties, Raids, Events, Minigames, Gardening, Economy }) do
        for name, member in pairs(build(S)) do
            if api[name] ~= nil then error("activities: two builders export " .. name) end
            api[name] = member
        end
    end

    local function bindAll()
        local pending = 0
        for _, hook in ipairs(hooks) do
            if not hook.handle then
                local handle
                if hook.verb == nil then
                    handle = Net.on(hook.remote, hook.fn)
                else
                    handle = Net.onVerb(hook.remote, hook.verb, hook.fn)
                end
                if handle then
                    hook.handle = handle
                    S.track(handle)
                    if hook.onBound then base.safe("bound " .. hook.remote, hook.onBound) end
                else
                    pending = pending + 1
                end
            end
        end
        return pending == 0
    end

    if hasNet and not bindAll() then
        local tries = 0
        local poller = Jobs.interval(HOOK_RETRY, function(job)
            tries = tries + 1
            if bindAll() then
                job:Cancel()
            elseif tries >= HOOK_TRIES then
                base.warn("activity pushes still unbound after %d tries", tries)
                job:Cancel()
            end
        end, { name = "Api/Activities hooks" })
        if maid and poller then maid:GiveTask(poller) end
    end

    base.log("activities api ready (%d push listeners)", #hooks)
    return api
end

return M

end)
