        if ok and type(list) == "table" then return list end
        return { Player.value("Stand") }
    end

    -- a cancelled ask leaves the game's own dialog up until it expires (ArrowUse.lua:820-860, :1005-1010), and its open flag locks every item use
    local function dismissDialog()
        local player = References.player
        if not player then return end
        pcall(function()
            local gui = player:FindFirstChildOfClass("PlayerGui")
            local dialog = gui and gui:FindFirstChild("ArrowUseConfirmation")
            if dialog then dialog.Enabled = false end
            player:SetAttribute("ArrowUseConfirmationOpen", nil)
        end)
    end

    local function cinematicDone(j)
        local deadline = os.clock() + CINEMATIC_WAIT
        while os.clock() < deadline do
            local char = References.character
            if not (char and char:GetAttribute("ArrowUseToken") ~= nil) then return true end
            if not j:sleep(0.25) then return false end
        end
        return true
    end

    local function arrowsLeft(arrow)
        local ok, n = Player.count(arrow)
        return ok and tonumber(n) or 0
    end

