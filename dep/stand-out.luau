            local okJob, job = pcall(Q.GetAngeloJob, References.player.UserId, stats, now)
            if not okJob or job ~= id then return true, false, "not_today" end
            local okTaken, taken = pcall(Q.AngeloJobTakenToday, stats, id, now)
            if okTaken and taken then return true, false, "not_today" end
        end
        if type(def.StartCheck) == "function" then
            local okCheck, passes = pcall(def.StartCheck, References.player)
            if not okCheck or not passes then return true, false, "start_check" end
        end
        return true, true, nil
    end

