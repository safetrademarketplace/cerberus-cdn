    local offerConns = {}
    local function unbindOffers()
        for i = #offerConns, 1, -1 do
            offerConns[i]:Disconnect()
            offerConns[i] = nil
        end
    end
    local function bindOffers(folder)
        unbindOffers()
        if not folder then return end
        offerConns[#offerConns + 1] = folder.ChildAdded:Connect(function() offersChanged:Fire() end)
        offerConns[#offerConns + 1] = folder.ChildRemoved:Connect(function() offersChanged:Fire() end)
    end
    local player = References.player
    if player then
        bindOffers(player:FindFirstChild("AvailableQuestPoints"))
        S.track(player.ChildAdded:Connect(function(child)
            if child.Name == "AvailableQuestPoints" then
                bindOffers(child)
                offersChanged:Fire()
            end
        end))
        S.own(unbindOffers)
    end

    -- PlayerScripts.Core.HowlerCases.lua:114-119: a case's prompt sends ("Hold", id) when the hold starts and ("Open", id) when it completes (0.8 s,
    -- HowlerCases.lua HoldDuration); only those two verbs, only a case id
    local CASE_VERBS = { Hold = true, Open = true }
    local function howlerCase(verb, id)
        if not CASE_VERBS[verb] then return false, Errors.NOT_ALLOWED end
        if type(id) ~= "string" or not string.match(id, "^case_%d%d$") then return false, Errors.BAD_ARGS end
        return Net.fire("HowlerCases", verb, id)
    end

    return {
        howlerCase = howlerCase,
        quests = quests, completed = completed, isCompleted = isCompleted, canStart = canStart,
        offers = offers, tracker = tracker, angeloJob = angeloJob,
        start = start, track = track, store = store, handIn = handIn, storyDialogue = storyDialogue,
        step = step, tutorialProgress = tutorialProgress, finishTutorial = finishTutorial,
        questsChanged = questsChanged, questCompleted = questCompleted, offersChanged = offersChanged,
    }
end

end)
__bundle_register("Api/Activities/Minigames", function(require, _LOADED, __bundle_register, __bundle_modules)
-- activities minigames: the latest server push per minigame (qte, arm wrestling, karaoke, beachcombing, lockpicking, bags' groove, food safety) and the exact input verbs, each gated the way its client gates it; no solver lives here
local KARAOKE_KEYS = { X = true, A = true, Y = true, B = true }   -- Rhythm.lua:4
local BAGS_QUEST = "P9_29_EXTRACT_BAGS_GROOVE"

return function(S)
    local Errors     = S.Errors
    local Net        = S.Net
    local Player     = S.Player
    local References = S.References
    local base       = S.base

    local minigame = base.signal()

    local function emit(kind, phase, payload)
        minigame:Fire(kind, phase, payload)
    end

    local function copy(t)
        local out = {}
        for k, v in pairs(t) do out[k] = v end
        return out
    end

    local qte          -- QTE.lua:785 {Id, Sequence, Progress} plus the start payload
    local armWrestle   -- QTE.ArmWrestling.lua:401-415 session, rounds from :726-744

    local function startArmWrestle(payload)
        armWrestle = {
            id = payload.Id, side = payload.Side, variant = payload.Variant, focus = payload.Focus == true,
            readyAt = payload.ReadyAt, config = payload, ended = false,
        }
        emit("ArmWrestling", "Start", payload)
    end

    -- QTE.lua:748-785: a legacy bare array is wrapped, ArmWrestling mode hands over, tokens are stringified
    local function startQte(payload)
        if type(payload) == "table" and payload.Sequence == nil and payload[1] ~= nil then
            payload = { SessionId = "legacy", Sequence = payload, Theme = "Default" }
        end
        if type(payload) ~= "table" then return end
        if payload.Mode == "ArmWrestling" then
            startArmWrestle(payload)
            return
        end
        local tokens = payload.Sequence or payload.Tokens
        if type(tokens) ~= "table" or #tokens == 0 then return end
        local sequence = {}
        for i, token in ipairs(tokens) do sequence[i] = tostring(token) end
        qte = {
            sessionId = tostring(payload.SessionId or payload.Id), sequence = sequence, progress = 0,
            mode = payload.Mode, theme = payload.Theme, title = payload.Title, config = payload, ended = false,
            pendingAt = nil,
        }
        emit("QTE", "Start", payload)
    end

    -- QTE.lua:932-950 and Update at :845-866
    S.push("QTE", nil, function(verb, a, b)
        if verb == "Start" then
            startQte(a)
            return
        end
        local sessionId, progress = a, b
        if type(a) == "number" then
            sessionId, progress = nil, a
        end
        if verb == "End" and b == nil then sessionId = nil end
        if not qte or (sessionId ~= nil and tostring(sessionId) ~= qte.sessionId) then return end
        if verb == "Progress" or verb == "Miss" then
            qte.progress = math.clamp(tonumber(progress) or qte.progress, 0, #qte.sequence)
            qte.pendingAt = nil
        elseif verb == "End" then
            qte.ended = true
        end
        emit("QTE", verb, { sessionId = qte.sessionId, progress = qte.progress })
    end)

    local function qteState() return true, qte end

    -- QTE.lua:716-744: one input in flight until the server answers or a second passes, and only a token the session shows; `ahead` sends without
    -- waiting for that answer, as the client does for a PredictProgress session (QTE.lua:723), for prompts whose time won't cover a round trip a key
    local function qteInput(sessionId, token, ahead)
