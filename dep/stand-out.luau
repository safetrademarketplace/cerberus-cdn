    end

    -- Gardening.ShopController.lua:2173-2205: an offer of the held snapshot, the amount inside its remaining stock
    local function shopTrade(offerId, amount, selling)
        if offerId == nil or not isInt(amount) or amount < 1 then return false, Errors.BAD_ARGS end
        local stop = shopGate()
        if stop then return false, stop end
        local offer
        for _, entry in ipairs(shop.snapshot.Offers or {}) do
            if entry.Id == offerId then offer = entry end
        end
        if not offer then return false, Errors.NOT_FOUND end
        if (offer.Kind == "Sell") ~= selling then return false, Errors.BAD_ARGS end
        local remaining = tonumber(offer.Remaining)
        if remaining and amount > remaining then return false, Errors.NOT_ENOUGH end
        local action = selling and "ShopSell" or "ShopBuy"
        local request = {
            Token = shop.token, RequestId = nextRequestId(), Id = offer.Id, Rotation = shop.snapshot.Rotation,
            Amount = amount, Action = action,
            Name = selling and offer.Name or nil, Quality = selling and offer.Quality or nil,
        }
        shop.pending = request
        local ok, err = Net.fireAllowed("Gardening", action, request)
        if not ok then shop.pending = nil end
        return ok, err
    end

