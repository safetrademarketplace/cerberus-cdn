__bundle_register("Tabs/Player", function(require, _LOADED, __bundle_register, __bundle_modules)
-- player mount: Movement/PlayerUtils/Visuals onto the Movement, Utilities, Camera and ESP tabs; returns the Movement module so Cerberus.lua can re-arm it on respawn
local Movement    = require("Features/Player/Movement")
local PlayerUtils = require("Features/Player/Utils")
local Visuals     = require("Features/Visuals/Visuals")

local function buildBase(ctx)
    return {
        Api         = ctx.Api,
        Services    = ctx.Services,
        Tabs        = ctx.Tabs,
        References  = ctx.References,
        Library     = ctx.Library,
        Options     = ctx.Library.Options,
        Toggles     = ctx.Library.Toggles,
        Helpers     = ctx.Helpers,
        Unloader    = ctx.Unloader,
        Maid        = ctx.Maid,
        NewMaid     = ctx.NewMaid,
    }
end

return function(ctx)
    local Config = ctx.Config
    local movementInst

    -- one camera box shared by two orchestrators: Zoom comes from PlayerUtils, FOV/Freecam/InfiniteCamera from Visuals
    local cameraGroup
    if (Config.PlayerUtils or Config.Visuals) and ctx.Tabs.Camera then
        cameraGroup = ctx.Tabs.Camera:AddLeftGroupbox("Camera", "camera")
    end

    if Config.Movement then
        movementInst = Movement(buildBase(ctx))
    end
    if Config.PlayerUtils then
        local sub = buildBase(ctx)
        sub.quickReset  = ctx.Helpers.quickReset
        sub.startNoclip = ctx.Helpers.startNoclip
        sub.stopNoclip  = ctx.Helpers.stopNoclip
        sub.CameraGroup = cameraGroup
        PlayerUtils(sub)
    end
    if Config.Visuals then
        local sub = buildBase(ctx)
        sub.CameraGroup = cameraGroup
        Visuals(sub)
    end

    return movementInst
end

end)
__bundle_register("Features/Visuals/Visuals", function(require, _LOADED, __bundle_register, __bundle_modules)
-- visuals orchestrator: wires Radar (esp tab), InfiniteCamera/FOV/Freecam into the shared camera box and Fullbright/NoFog/XRay into lighting (camera tab)
local Mount          = require("Utility/Mount")
local Radar          = require("Features/Visuals/Visuals/Radar")
local InfiniteCamera = require("Features/Visuals/Visuals/InfiniteCamera")
local NoFog          = require("Features/Visuals/Visuals/NoFog")
local XRay           = require("Features/Visuals/Visuals/XRay")
local Fullbright     = require("Features/Visuals/Visuals/Fullbright")
local FOV            = require("Features/Visuals/Visuals/FOV")
local Freecam        = require("Features/Visuals/Visuals/Freecam")

return function(ctx)
    local O = Mount.orchestrator(ctx, "Visuals")
    if not O then return end

    local radarCtx = O.subCtx()
    O.mount(Radar, radarCtx)

    -- the camera box is created by the player mount and shared with Zoom; lighting is this module's own
    local Tab = ctx.Tabs.Camera
    local cameraGroup = ctx.CameraGroup or Tab:AddLeftGroupbox("Camera", "camera")
    local cameraCtx = O.subCtx({ VisualsGroup = cameraGroup })
    local lightingCtx = O.subCtx({ VisualsGroup = Tab:AddRightGroupbox("Lighting", "sun") })
    O.mount(InfiniteCamera, cameraCtx)
    O.mount(FOV, cameraCtx)
    O.mount(Freecam, cameraCtx)
    O.mount(Fullbright, lightingCtx)
    O.mount(NoFog, lightingCtx)
    O.mount(XRay, lightingCtx)

    O.finalize()
end

end)
