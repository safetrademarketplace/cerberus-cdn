-- Gardening.lua:973-1049, 1199, 1277, 1738, 1911, 3063: these carry the session version, Again/Close/Sync carry only the token
local GROW_VERSIONED = { PourStart = true, PourEnd = true, PourCancel = true, SeedDrop = true, Clip = true, Cover = true, ClipAll = true }
local GROW_BARE = { Again = true, Close = true, Sync = true }
-- per-target actions skip the session's one-in-flight rule (Gardening.lua:987-1037)
local GROW_TARGETED = { Clip = true, Cover = true, ClipAll = true }
-- Gardening.ProcessingController.lua:6443, 6567, 6657, 6974, 7333
local PROCESS_ACTIONS = { Drop = true, Pack = true, Reset = true, Seal = true, Sync = true }

return function(S)
    local Errors     = S.Errors
    local Net        = S.Net
    local Player     = S.Player
    local References = S.References
    local base       = S.base

    local gardenEvent = base.signal()

    local growing, processing, uprootAsk, shop
    -- the open counter mirrors the controller's Generation and the purchase counter its PurchaseSequence (Gardening.ShopController.lua:1627, 2173)
    local shopWaiting, openSeq, purchaseSeq = nil, 0, 0

    local function isInt(n) return type(n) == "number" and n % 1 == 0 end

    local function garden()
        local stop = S.need()
