            end
        end
        if not self.target then
            local ok, list = World.combatants({ alive = true, maxDistance = reach, players = o.players == true })
            if ok then
                local from = rootOf(stand) or body
                self.target = M.nearest(list, from.Position, math.huge, valid)
            end
        end
        local now = deps.now()
        if self.target then lastSeen = now end
        local pilotNow = piloting(c)
        if o.autoPilot then
            if self.target and not pilotNow and not startedPilot then
                if not c:GetAttribute("Summoned") then
                    Combat.summon(true)
                elseif togglePilot(true) then
                    startedPilot = true
                end
            elseif not self.target and now - lastSeen > IDLE_RELEASE then
                releasePilot(c)
            end
        else
            releasePilot(c)
        end
        if o.attack and self.target and pilotNow and now - lastSwing >= SWING_EVERY
            and type(Combat.pilotSwing) == "function" then
            local sroot, troot = rootOf(stand), rootOf(self.target)
            if sroot and troot and (sroot.Position - troot.Position).Magnitude <= SWING_REACH then
                lastSwing = now
                Combat.pilotSwing()
            end
        end
    end

    -- every physics step while you pilot and hold a target: the stand sits behind it, facing it, at rest
    function self.frame()
        local t = self.target
        if not t then return end
        local o = deps.opts()
        local c = char()
        if not (o.attach and c and piloting(c)) then return end
        local stand = standModel()
        local sroot, troot = rootOf(stand), rootOf(t)
        if not (sroot and troot) or sroot.Anchored then return end
