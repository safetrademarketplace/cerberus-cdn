local function schemeColor(Library, key, fallback)
    local s = Library.Scheme
    local v = s and s[key]
    return typeof(v) == "Color3" and v or fallback
end

local function schemeFont(Library)
    local f = Library.Scheme and Library.Scheme.Font
    if typeof(f) == "Font" then return f end
