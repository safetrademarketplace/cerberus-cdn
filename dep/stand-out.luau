            and r.players and r.capacity and r.players >= (opts.minPlayers or 0) and r.players <= r.capacity - M.SEAT_SPARE then
            ok[#ok + 1] = { row = r, age = age }
        end
    end
    if #ok == 0 then return nil end
    local prefer = opts.prefer or "Youngest"
    table.sort(ok, function(a, b)
        if prefer == "Most players" and a.row.players ~= b.row.players then return a.row.players > b.row.players end
        if prefer == "Fewest players" and a.row.players ~= b.row.players then return a.row.players < b.row.players end
        return a.age < b.age
    end)
