local LIST_WAIT   = 15     -- :2107 gives up after 15 s
local LIST_GAP    = 2      -- :2089 refreshes at most every 2 s
local JOIN_WAIT   = 20     -- :1765 gives up after 20 s
local POLL        = 0.1
-- our request numbers sit far from the menu's own counter, which starts at 0, so neither side takes the other's reply
local SEQ_BASE    = 900000

return function(ctx, shared)
    local Net    = shared.Net
    local Errors = shared.Errors

    local nextSeq = SEQ_BASE
    local listReplies = {}
    local travels = {}
    local lastList, lastListAt, records = nil, -math.huge, {}

    local listening = false
    local function ensureListener()
        if listening then return true end
        local handle = Net.on("ServerDirectory", function(verb, a2, a3, a4, a5)
            if verb == "List" then
                if listReplies[a2] == false and type(a3) == "table" then listReplies[a2] = a3 end
            elseif verb == "Travel" then
                local travel = travels[a5]
                if travel then travel.events[#travel.events + 1] = { id = a2, phase = a3, message = a4 } end
            end
        end)
        if not handle then return false end
        shared.track(handle)
        listening = true
        return true
    end
    ensureListener()

    local function newSeq()
        nextSeq = nextSeq + 1
        return nextSeq
    end

    -- the row's own Join rule (:1886-1891): a Normal server below Capacity that isn't this one
    local function normalize(raw)
        local players, capacity = tonumber(raw.Players), tonumber(raw.Capacity)
