        if type(sale) ~= "table" or (tonumber(sale.Count) or 0) < 1 then return false, Errors.NOT_FOUND end
        local request = { Token = shop.token, RequestId = nextRequestId(), Expect = sale.Coins, ExpectCount = sale.Count, Action = "ShopSellAll" }
        shop.pending = request
        local ok, err = Net.fireAllowed("Gardening", "ShopSellAll", request)
        if not ok then shop.pending = nil end
        return ok, err
    end

    -- Gardening.ShopController.lua:1352-1353
    local function gardenShopClose()
        if not shop and not shopWaiting then return false, Errors.NO_SESSION end
        local token, waiting = shop and shop.token, shopWaiting
        shop, shopWaiting = nil, nil
        return Net.fire("Gardening", "ShopClose", { Token = token, RequestId = waiting })
    end

    return {
        garden = garden, growingInput = growingInput, processingInput = processingInput,
        selectSeed = selectSeed, uproot = uproot,
        gardenShop = gardenShop, gardenShopOpen = gardenShopOpen, gardenShopBuy = gardenShopBuy,
        gardenShopSell = gardenShopSell, gardenShopSellAll = gardenShopSellAll, gardenShopClose = gardenShopClose,
        gardenEvent = gardenEvent,
    }
end

end)
__bundle_register("Api/Activities/Events", function(require, _LOADED, __bundle_register, __bundle_modules)
-- activities world events: the live event table rebuilt from the WorldEvents State and Snapshot pushes with the client's own revision rule, asking for one Snapshot when the listener binds
return function(S)
    local Net  = S.Net
    local base = S.base

    local worldEvent = base.signal()

    local events = {}      -- EventId -> latest event table
    local revisions = {}   -- EventId -> highest revision applied
    local weather = {}

    -- WorldEvents.lua:140-151: a revision at or below the last one applied is stale
    local function apply(ev)
        if type(ev) ~= "table" or type(ev.EventId) ~= "string" then return end
        local last = revisions[ev.EventId]
        local revision = tonumber(ev.Revision)
        if last and revision and revision <= last then return end
        revisions[ev.EventId] = revision or last
        if ev.Phase == "Cleanup" then
            events[ev.EventId] = nil
        else
            events[ev.EventId] = ev
        end
        worldEvent:Fire(ev)
    end

    local function worldEvents()
        local out = {}
        for _, ev in pairs(events) do out[#out + 1] = ev end
        table.sort(out, function(a, b) return a.EventId < b.EventId end)
        return true, out, weather
    end

    -- WorldEvents.lua:297-315
    S.push("WorldEvents", "State", apply)
    S.push("WorldEvents", "Snapshot", function(list, weatherList)
        if type(list) ~= "table" then return end
        weather = type(weatherList) == "table" and weatherList or weather
        for _, ev in ipairs(list) do apply(ev) end
    end, function()
        -- the game's own loop asked at its boot (WorldEvents.lua:316-327), long before this listener existed; one ask fills the table
        Net.fire("WorldEvents", "Snapshot")
    end)

    return { worldEvents = worldEvents, worldEvent = worldEvent }
end

end)
