-- DialogueInfo.lua:544-555: these bandits have to be talked to before they fight; each is your own copy, owned by you for Bandit Problem
local BANDIT_TALKS = { Bobert = "BanditGardenLicense", Rupert = "BanditSummitTalked", Usuce = "BanditCraterTalked" }
local BANDIT_QUEST = "BUKAY_BANDIT_PROBLEM"
