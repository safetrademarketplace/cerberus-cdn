        return Net.fire("TrainRaid", "Accuse", { Index = index, Token = token })
    end

    -- TrainRaidClient.Purse.lua:2281-2286 through fire (TrainRaidClient.lua:94-98): takes the paper clip from the "Purse" push {Token}; the client never sends it sooner than 3.2 s after the purse opens
    local function raidPurseTake(token)
        if type(token) ~= "string" or token == "" then return false, Errors.BAD_ARGS end
        return Net.fire("TrainRaid", "Purse", { Step = "Take", Token = token })
    end

    -- yields. TrainRaidClient.Donatello.lua:1230-1242: the player's own weekly rank table
