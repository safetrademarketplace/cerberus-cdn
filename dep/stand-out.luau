    root.Name = "__cerb_topbar"
    root.AnchorPoint = Vector2.new(0.5, 0)
    root.AutomaticSize = Enum.AutomaticSize.XY
    root.BackgroundTransparency = 0.04
    root.BorderSizePixel = 0
    root.Position = UDim2.new(0.5, 0, 0, 8)
    root.Size = UDim2.fromOffset(0, 0)
    root.Visible = false
    root.ZIndex = 50
    paint(root, { BackgroundColor3 = "BackgroundColor" })

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = root

    local stroke = Instance.new("UIStroke")
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    paint(stroke, { Color = "OutlineColor" })
    stroke.Parent = root

    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, 14)
    padding.PaddingRight = UDim.new(0, 14)
    padding.Parent = root

    -- two rows: the stats strip, and under it the autofarm status, which only shows while a farm has something to say
    local rows = Instance.new("UIListLayout")
    rows.FillDirection = Enum.FillDirection.Vertical
    rows.HorizontalAlignment = Enum.HorizontalAlignment.Center
    rows.SortOrder = Enum.SortOrder.LayoutOrder
    rows.Parent = root

    local strip = Instance.new("Frame")
    strip.AutomaticSize = Enum.AutomaticSize.X
    strip.BackgroundTransparency = 1
    strip.LayoutOrder = 1
    strip.Size = UDim2.fromOffset(0, 34)
    strip.Parent = root

    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Horizontal
    layout.VerticalAlignment = Enum.VerticalAlignment.Center
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 10)
    layout.Parent = strip

