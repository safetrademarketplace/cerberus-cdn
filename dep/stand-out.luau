        local stop = S.need()
        if stop then return false, stop end
        return true, decodedList("Stats.ActiveBounties")
    end

    local function bountyProgress()
        local stop = S.need()
        if stop then return false, stop end
        return true, decodedList("Stats.BountyProgress")
    end

