    end

    local function scanHitboxes()
        local now = os.clock()
        local root = myRoot()
        if not root or ownCastRunning(now) then return end
        local ok, list = Combat.hitboxes()
        if not ok then return end
        for _, info in ipairs(list) do judgeHitbox(info, root, now) end
    end

    -- aggro and stand casts: npcs that name you, and any nearby stand whose Skill attribute just appeared (enemies.md 4.2, 4.4)
    local function scanAggro()
        local now = os.clock()
        local root = myRoot()
        local ok, list = World.combatants({ alive = true, maxDistance = AGGRO_RADIUS })
        local seen = {}
        if ok then
            for _, model in ipairs(list) do
                local modelRoot = rootOf(model)
                if root and modelRoot and (modelRoot.Position - root.Position).Magnitude <= WATCH_RADIUS then
                    seen[model] = true
                    hookAnimator(model)
                end
                if targetsMe(model) == true then
                    seen[model] = true
                    if not aggro[model] then
                        aggro[model] = true
                        hookAnimator(model)
                        aggroChanged:Fire(model, true)
                    end
                end
                local okStand, stand = World.standOf(model)
                local skill = okStand and stand:GetAttribute("Skill") or nil
                local was = standSkill[model]
                standSkill[model] = skill
                if skill ~= nil and skill ~= was and root and targetsMe(model) ~= false then
                    local modelRoot = rootOf(model)
                    if modelRoot and (modelRoot.Position - root.Position).Magnitude <= REACH * 2 then
                        add({ from = model, kind = "skill", at = now + STAND_SKILL_LEAD, ends = now + STAND_SKILL_LEAD + ACTIVE,
                            heavy = false, guardBreak = false, unblockable = false, big = true, skill = tostring(skill) })
                    end
                elseif skill ~= nil then
                    -- a running cast keeps its tell open until the attribute clears
                    for _, t in ipairs(threats) do
                        if t.from == model and t.kind == "skill" then t.ends = math.max(t.ends, now + SCAN_EVERY * 2) end
                    end
                end
            end
        end
        for model in pairs(aggro) do
            if not seen[model] then
                aggro[model] = nil
                aggroChanged:Fire(model, false)
            end
        end
        for model in pairs(animHooks) do
            if not seen[model] then unhookAnimator(model) end
        end
    end

    -- earliest hit that lands within horizon and hasn't finished; plain
    function T.pressure(horizon)
        horizon = tonumber(horizon) or 0.6
        local now = os.clock()
        prune(now)
        local best = nil
        for _, t in ipairs(threats) do
            if t.ends >= now and t.at <= now + horizon and (not best or t.at < best.at) then best = t end
        end
        if not best then return nil end
        return {
            id = best.id, from = best.from, kind = best.kind, at = best.at, ends = best.ends, lead = best.at - now,
            heavy = best.heavy, guardBreak = best.guardBreak, unblockable = best.unblockable, big = best.big,
        }
    end

    -- plain: a hit lands on you within seconds
    function T.busyWithin(seconds)
        return T.pressure(seconds) ~= nil
    end

    -- plain: the models whose Target or NPCCombatTarget is you
    function T.aggro()
        local out = {}
        for model in pairs(aggro) do
            if model.Parent then out[#out + 1] = model end
        end
        return out
    end

    function T.targetsMe(model)
        if typeof(model) ~= "Instance" then return nil end
        return targetsMe(model)
    end

    -- the engine marks its own casts so their hitboxes don't read as incoming
    function T.selfCast(seconds)
        selfCastUntil = math.max(selfCastUntil, os.clock() + (tonumber(seconds) or 1))
    end

    function T.clear()
        table.clear(threats)
    end

    T.tell = tell
    T.aggroChanged = aggroChanged

    local function destroy()
        if not T.alive then return end
        T.alive = false
        if hookJob then hookJob:Cancel() end
        hookJob = nil
        if saveJob then saveJob:Cancel() end
        saveJob = nil
        pcall(saveLearned)
        for i = #handles, 1, -1 do
            handles[i]:Disconnect()
            handles[i] = nil
        end
        for i = #conns, 1, -1 do
            conns[i]:Disconnect()
            conns[i] = nil
        end
        if scanHandle then scanHandle:Disconnect() end
        if aggroHandle then aggroHandle:Disconnect() end
        scanHandle, aggroHandle = nil, nil
        for model in pairs(animHooks) do unhookAnimator(model) end
        if unbindCharacter then unbindCharacter() end
        unbindCharacter = nil
        table.clear(recentAnims)
        table.clear(threats)
        table.clear(aggro)
    end
    T.destroy = destroy

    -- the Effects remote can replicate after boot
    if not hook() then
        local tries = 0
        hookJob = Jobs.interval(HOOK_RETRY, function(job)
            tries = tries + 1
            if hook() then
                job:Cancel()
            elseif tries >= HOOK_TRIES then
                Log.devwarn("Threats", "swing tells still unbound after %d tries", tries)
                job:Cancel()
            end
        end, { name = "Combat/Threats hook" })
    end
    conns[#conns + 1] = Combat.incoming:Connect(function(inst)
        local root = myRoot()
        if not root or ownCastRunning(os.clock()) or typeof(inst) ~= "Instance" or not inst.Parent then return end
        local ok, list = Combat.hitboxes()
        if not ok then return end
        for _, info in ipairs(list) do
            if info.instance == inst then judgeHitbox(info, root, os.clock()) end
        end
    end)
    bindHealth(References.character)
    unbindCharacter = References.onCharacter(function(char) bindHealth(char) end)
    scanHandle = Scheduler.heartbeat(scanHitboxes, { name = "Combat/Threats hitboxes", interval = SCAN_EVERY })
    aggroHandle = Scheduler.heartbeat(scanAggro, { name = "Combat/Threats aggro", interval = AGGRO_EVERY })
    saveJob = Jobs.interval(SAVE_EVERY, function() pcall(saveLearned) end, { name = "Combat/Threats save" })
    return T
end

-- a view on the shared detector; release() drops this holder, and the last release tears it down
function M.acquire(ctx)
    local apis = type(ctx) == "table" and ctx.Api
    if type(apis) ~= "table" or not (apis.Net and apis.Combat and apis.World) then return nil end
    local T = live[apis]
    if not (T and T.alive) then
        T = build(ctx)
        live[apis] = T
    end
    T.refs = T.refs + 1
    local released = false
    local view = setmetatable({}, { __index = T })
    function view.release()
        if released then return end
        released = true
        T.refs = T.refs - 1
        if T.refs <= 0 then
            T.destroy()
            if live[apis] == T then live[apis] = nil end
        end
    end
    view.Destroy = view.release
    view.Disconnect = view.release
    return view
end

return M

