local Scheduler = require("Utility/Scheduler")

return function(ctx)
    local Library    = ctx.Library
    local Toggles    = ctx.Toggles
    local References = ctx.References
    local UtilsGroup = ctx.UtilsGroup
    local track      = ctx.track

    -- tools replicate per :Activate(); 60hz spam gets flagged, 10hz matches a fast human click rate
    local ACTIVATE_INTERVAL = 0.1

    local function getTool()
        if not References.character or not References.character.Parent then return nil end
        for _, inst in ipairs(References.character:GetChildren()) do
            if inst:IsA("Tool") then
                return inst
            end
        end
    end

