__bundle_register("Api/Player/Data", function(require, _LOADED, __bundle_register, __bundle_modules)
-- player data: the LocalPlayer.Data reader every api uses; dotted paths resolve fresh on every read so a miss is never cached, and shared watchers follow every step from LocalPlayer down so a node replaced or created after Loaded rebinds
return function(S, api)
    local Errors = S.Errors
    local base = S.base
    local HttpService = S.Services.HttpService

    -- the split of a path string is pure data, so caching it is safe; nil means the path itself is malformed
    local segmentCache = {}
    local function segments(path)
        if path == nil then path = "" end
        if type(path) ~= "string" then return nil end
        local hit = segmentCache[path]
        if hit then return hit end
        local names = {}
        for name in string.gmatch(path, "[^%.]+") do names[#names + 1] = name end
        segmentCache[path] = names
        return names
    end

    local function root()
        local player = S.player()
        if not player then return nil end
        return player:FindFirstChild("Data")
    end

    local function resolve(names)
        local node = root()
        for _, name in ipairs(names) do
            if not node then return nil end
            node = node:FindFirstChild(name)
        end
        return node
    end

    function api.ready()
        local data = root()
        return data ~= nil and data:GetAttribute("Loaded") == true
    end

    function api.node(path)
        local names = segments(path)
        if not names then return nil end
        return resolve(names)
    end

    function api.value(path)
        local node = api.node(path)
        if node and node:IsA("ValueBase") then return node.Value end
        return nil
    end

    function api.attr(path, name)
        if type(name) ~= "string" then return nil end
        local node = api.node(path)
        if not node then return nil end
        return node:GetAttribute(name)
    end

    function api.json(path)
        local raw = api.value(path)
        if type(raw) ~= "string" or raw == "" then return nil end
        local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
        if ok and type(decoded) == "table" then return decoded end
        return nil
    end

    -- HandlerQuest.lua:229-241: split on commas and drop the empty entries, nothing trimmed
    function api.csv(path)
        local out = {}
        local raw = api.value(path)
        if type(raw) ~= "string" then return out end
        for entry in string.gmatch(raw, "[^,]+") do out[#out + 1] = entry end
        return out
    end

    function api.playerAttr(name)
        if type(name) ~= "string" then return nil end
        local player = S.player()
        if not player then return nil end
        return player:GetAttribute(name)
    end

    -- one watcher per (path, attribute), shared by every subscriber and torn down with the last one
    local watchers = {}

    local function release(w)
        for _, conn in ipairs(w.conns) do conn:Disconnect() end
        table.clear(w.conns)
    end

    local function current(w)
        local node = w.node
        if not node then return nil end
        if w.attr then return node:GetAttribute(w.attr) end
        if node:IsA("ValueBase") then return node.Value end
        return nil
    end

    local function deliver(w, value)
        if not w.alive then return end
        local old = w.last
        w.last = value
        local handlers = {}
        for _, fn in pairs(w.subs) do handlers[#handlers + 1] = fn end
        for _, fn in ipairs(handlers) do base.safe(w.label, fn, value, old) end
    end

    -- a replace lands as a remove and an add in one frame; one deferred rebind answers both, so no nil blip reaches subscribers
    local bind
    local function rebindSoon(w)
        if w.queued or not w.alive then return end
        w.queued = true
        task.defer(function()
            w.queued = false
            if not w.alive then return end
            bind(w)
            local value = current(w)
            if value ~= w.last then deliver(w, value) end
        end)
    end

    bind = function(w)
        release(w)
        w.node = nil
        local player = S.player()
        if not player then return end
        local conns = w.conns
        local parent = player
        for _, name in ipairs(w.steps) do
            conns[#conns + 1] = parent.ChildAdded:Connect(function(child)
                if child.Name == name then rebindSoon(w) end
            end)
            conns[#conns + 1] = parent.ChildRemoved:Connect(function(child)
                if child.Name == name then rebindSoon(w) end
            end)
            local child = parent:FindFirstChild(name)
            if not child then return end
            parent = child
        end
        local leaf = parent
        w.node = leaf
        if w.attr then
            local attrName = w.attr
            conns[#conns + 1] = leaf:GetAttributeChangedSignal(attrName):Connect(function()
                deliver(w, leaf:GetAttribute(attrName))
            end)
        elseif leaf:IsA("ValueBase") then
            conns[#conns + 1] = leaf.Changed:Connect(function()
                deliver(w, leaf.Value)
            end)
        end
    end

    local function watch(path, attrName, fn)
        local names = segments(path)
        if not names or type(fn) ~= "function" then return nil, Errors.BAD_ARGS end
        if attrName ~= nil and type(attrName) ~= "string" then return nil, Errors.BAD_ARGS end
        local key = table.concat(names, ".") .. "\0" .. (attrName or "")
        local w = watchers[key]
        if not w then
            local steps = { "Data" }
            for _, name in ipairs(names) do steps[#steps + 1] = name end
            w = {
                steps = steps, attr = attrName, subs = {}, conns = {}, alive = true, queued = false,
                label = "observe " .. key:gsub("%z", "@"),
            }
            watchers[key] = w
            bind(w)
            w.last = current(w)
        end
        local token = {}
        w.subs[token] = fn
        return S.own(function()
            w.subs[token] = nil
            if next(w.subs) ~= nil or watchers[key] ~= w then return end
            w.alive = false
            watchers[key] = nil
            release(w)
        end)
    end

    -- fn(value, old) on every change, including the node appearing, being replaced with a new value, or going away (nil)
    function api.observe(path, fn)
        return watch(path, nil, fn)
    end

    function api.observeAttr(path, name, fn)
        if type(name) ~= "string" then return nil, Errors.BAD_ARGS end
        return watch(path, name, fn)
    end

    function api.observePlayerAttr(name, fn)
        if type(name) ~= "string" or type(fn) ~= "function" then return nil, Errors.BAD_ARGS end
        local player = S.player()
        if not player then return nil, Errors.NO_PLAYER end
        local conn = player:GetAttributeChangedSignal(name):Connect(function()
            base.safe("observePlayerAttr " .. name, fn, player:GetAttribute(name))
        end)
        return S.own(function() conn:Disconnect() end)
    end

    -- fires once: now when already loaded, otherwise the first time Data.Loaded turns true (the folder may replicate late)
    function api.onReady(fn)
        if type(fn) ~= "function" then return nil, Errors.BAD_ARGS end
        if api.ready() then
            base.safe("onReady", fn)
            return S.own(function() end)
        end
        local handle
        local fired = false
        handle = watch("", "Loaded", function(loaded)
            if loaded ~= true or fired then return end
            fired = true
            handle:Disconnect()
            base.safe("onReady", fn)
        end)
        return handle
    end
end

end)
__bundle_register("Api/Player/Account", function(require, _LOADED, __bundle_register, __bundle_modules)
-- player account: level, dalas, stats, stand, gauges, settings, entitlements, input locks and spawn readiness read off the data tree and LocalPlayer attributes, plus the stat, settings and main-menu verbs sent through Net
local STAT_NAMES = { Damage = true, Ability = true, Health = true }

-- Utility.lua:9150-9168 (StatScaling), used when the module can't be reached
local LEVEL_CAP = 75
local XP_PER_LEVEL = 100

local ENTITLEMENTS = {
    "OwnsPass_PrivateServer", "OwnsPass_EmoteSlots", "OwnsPass_KillSound", "OwnsPass_PogoStick",
    "OwnsPass_Builder", "OwnsPass_Guitar", "HasTrainRaidAccess", "SpawnLocationUnlocked", "PaidRandomItemsAllowed",
}

-- net_state §6 input locks; GameUIHidden is left out because it is the hide-the-ui toggle (Core.lua:800-802), not a lock
local LOCKS = {
    "QTEInputLocked", "DialogueInputLocked", "GardeningInputLocked", "GardenEffectInputLocked", "SettingsInputLocked",
    "PhoneInputLocked", "KaraokeInputLocked", "SpiritPhotoInputLocked", "GuiNavigationLocked", "HUDLayoutEditing",
    "MobileLayoutEditing", "ItemInspecting", "JewelryInspecting", "ArrowUseConfirmationOpen", "QuickUseInventoryOpen",
    "MenuCursorUnlocked", "FreecamActive",
}

local CINEMATICS = {
    "TutorialCinematic", "StoryCinematic", "EndingCinematic", "HuberRiding", "VehicleSeated", "TrainRaidActive", "GangWarMatch",
}

-- the owner token each GardeningInputLocked setter stamps beside it, and the camera owners the game itself checks (ProcessingController.lua:4768)
local LOCK_OWNERS = { "GrowingInputOwner", "ProcessingInputOwner", "CraftingInputOwner", "TabletopInputOwner" }
local CAMERA_OWNERS = { "GrowingCameraOwner", "ProcessingCameraOwner", "CraftingCameraOwner", "TabletopCameraOwner", "TutorialCameraOwner", "SpiritPhotoCameraOwner", "ItemInspectionOwner", "EndingOwner" }

-- SettingsHandler.lua:90-166: the server answers Request with Prepare, the client covers the screen and answers Ready
local PREPARE_TIMEOUT = 15
local COVER_WAIT = 1.5
local FAILED_WAIT = 20
local POLL = 0.05

return function(S, api)
    local Errors = S.Errors
    local Net = S.Net

    local function scaling()
        local ok, utility = S.module("Utility")
        if ok and type(utility) == "table" and type(utility.StatScaling) == "table" then return utility.StatScaling end
        return nil
    end

    local function experienceFormula(level)
        local lvl = math.max(1, math.floor(level))
        return XP_PER_LEVEL * lvl * (lvl >= 70 and 1.25 or 1)
    end

    function api.level()
        local stop = S.need()
        if stop then return false, stop end
        local level = tonumber(api.value("Stats.Level"))
        if not level then return false, Errors.NO_NODE end
        local xp = tonumber(api.value("Experience")) or 0
        local needed, cap
        local scale = scaling()
        if scale then
            if type(scale.GetExperienceRequired) == "function" then
                local ok, n = pcall(scale.GetExperienceRequired, level)
                if ok and type(n) == "number" then needed = n end
            end
            cap = tonumber(scale.LevelCap)
        end
        needed = needed or experienceFormula(level)
        cap = cap or LEVEL_CAP
        return true, { level = level, xp = xp, needed = needed, cap = cap, maxed = level >= cap }
    end

    function api.dalas()
        local stop = S.need()
        if stop then return false, stop end
        local coins = tonumber(api.value("Stats.Coins"))
        if not coins then return false, Errors.NO_NODE end
        return true, coins
    end

    function api.stats()
        local stop = S.need()
        if stop then return false, stop end
        local points = tonumber(api.value("Stats.Points"))
        if not points then return false, Errors.NO_NODE end
        return true, {
            points = points,
            Damage = tonumber(api.value("Stats.Damage")) or 1,
            Health = tonumber(api.value("Stats.Health")) or 1,
            Ability = tonumber(api.value("Stats.Ability")) or 1,
        }
    end

    -- HandlerMenus.lua:75 reads AccessoryBonuses.EffectiveStat(Data.Stats, name); without the module it is the allocated value, floored at 1 like allocatedStat
    function api.effectiveStat(name)
        if type(name) ~= "string" then return false, Errors.BAD_ARGS end
        local stop = S.need()
        if stop then return false, stop end
        local statsNode = api.node("Stats")
        if not statsNode then return false, Errors.NO_NODE end
        local ok, bonuses = S.module("Modules.Items.AccessoryBonuses")
        if ok and type(bonuses) == "table" and type(bonuses.EffectiveStat) == "function" then
            local called, n = pcall(bonuses.EffectiveStat, statsNode, name)
            if called and type(n) == "number" then return true, n end
        end
        local allocated = tonumber(api.value("Stats." .. (name == "Strength" and "Damage" or name)))
        if not allocated then return false, Errors.NO_NODE end
        return true, math.max(1, allocated)
    end

    function api.stand()
        local stop = S.need()
        if stop then return false, stop end
        local name = api.value("Stand")
        if type(name) ~= "string" then return false, Errors.NO_NODE end
        return true, {
            name = name,
            override = api.value("StandOverride") or "",
            subAbility = api.value("SubAbility") or "",
            weapon = api.value("Weapon") or "",
            weaponOverride = api.value("WeaponOverride") or "",
            unlocked = api.csv("Stats.UnlockedStands"),
        }
    end

    function api.gauges()
        local stop = S.need()
        if stop then return false, stop end
        local stamina = tonumber(api.value("Stamina"))
        if not stamina then return false, Errors.NO_NODE end
        return true, {
            stamina = stamina,
            maxStamina = tonumber(api.attr("Stamina", "Max")),
            mode = tonumber(api.value("Mode")) or 0,
            maxMode = tonumber(api.attr("Mode", "Max")),
        }
    end

    local function readFolder(folder)
        local out = {}
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("ValueBase") then
                out[child.Name] = child.Value
            elseif child:IsA("Folder") then
                out[child.Name] = readFolder(child)
            end
        end
        return out
    end

    -- Keybinds comes back nested as its own table of KeyCode names
    function api.settings()
        local stop = S.need()
        if stop then return false, stop end
        local folder = api.node("Settings")
        if not folder then return false, Errors.NO_NODE end
        return true, readFolder(folder)
    end

    local function leaf(path)
        local stop = S.need()
        if stop then return false, stop end
        local node = api.node(path)
        if not (node and node:IsA("ValueBase")) then return false, Errors.NO_NODE end
        return true, node.Value
    end

    function api.setting(key)
        if type(key) ~= "string" or key == "" then return false, Errors.BAD_ARGS end
        return leaf("Settings." .. key)
    end

    function api.keybind(name)
        if type(name) ~= "string" or name == "" then return false, Errors.BAD_ARGS end
        return leaf("Settings.Keybinds." .. name)
    end

    -- the named set plus any OwnsPass_* the game adds later; only the ones that are true
    function api.entitlements()
        local player = S.player()
        if not player then return false, Errors.NO_PLAYER end
        local set = {}
        for _, name in ipairs(ENTITLEMENTS) do
            if player:GetAttribute(name) == true then set[name] = true end
        end
        for name, value in pairs(player:GetAttributes()) do
            if value == true and string.sub(name, 1, 9) == "OwnsPass_" then set[name] = true end
        end
        return true, set
    end

    function api.locks()
        if not S.player() then return false, Errors.NO_PLAYER end
        local set = {}
        for _, name in ipairs(LOCKS) do
            if S.flag(name) then set[name] = true end
        end
        return true, set
    end

    -- live 2026-11-17: MenuCursorUnlocked only frees the mouse (Effects16.lua:9425 sets it for a panel) and can stay set after the panel closes, so it never counts as busy
    -- every setter of GardeningInputLocked stamps its owner token first (Gardening.lua:2713, ProcessingController.lua:4720, Crafting.lua:257, Tabletop.lua:1964);
    -- live 2026-11-18: a reload mid-session left the lock on with every owner cleared, which froze the farms for good
    local function staleGardenLock()
        local player = S.player()
        if not player or player:GetAttribute("GardeningInputLocked") ~= true then return false end
        for _, owner in ipairs(LOCK_OWNERS) do
            if player:GetAttribute(owner) ~= nil then return false end
        end
        return true
    end

    function api.isBusy()
        if not S.player() then return false end
        local stale = staleGardenLock()
        for _, name in ipairs(LOCKS) do
            if name ~= "MenuCursorUnlocked" and not (stale and name == "GardeningInputLocked") and S.flag(name) then return true end
        end
        for _, name in ipairs(CINEMATICS) do
            if S.flag(name) then return true end
        end
        return false
    end

    -- plain: clears a garden lock nothing owns and hands back a scripted camera nothing owns, as the game's own teardown would have; true when it fixed something
    function api.repairLocks()
        local player = S.player()
        if not player then return false end
        local fixed = false
        if staleGardenLock() then
            player:SetAttribute("GardeningInputLocked", false)
            fixed = true
        end
        local camera = workspace and workspace.CurrentCamera
        if camera and camera.CameraType == Enum.CameraType.Scriptable then
            for _, owner in ipairs(CAMERA_OWNERS) do
                if camera:GetAttribute(owner) ~= nil then return fixed end
            end
            for _, name in ipairs(CINEMATICS) do
                if S.flag(name) then return fixed end
            end
            if S.flag("PhoneInputLocked") or S.flag("FreecamActive") then return fixed end
            camera.CameraType = Enum.CameraType.Custom
            local hum = S.character() and S.character():FindFirstChildOfClass("Humanoid")
            if hum then camera.CameraSubject = hum end
            fixed = true
        end
        return fixed
    end

    -- LoadingBootstrap.lua:111-150 and :170-184: the menu gate on the player, then the streaming and controller flags on the character
    function api.spawnReady()
        local player = S.player()
        if not player or player:GetAttribute("StandOutMenuGateReady") ~= true then return false end
        local char = S.character()
        if not char then return false end
        return char:GetAttribute("StreamingSpawnReady") == true and char:GetAttribute("ClientControllerReady") == true
    end

    -- PartyHandler.lua:1305-1314 trims each member; a Leader of 0 means no party
    function api.party()
        local stop = S.need()
        if stop then return false, stop end
        local leader = tonumber(api.value("Party.Leader"))
        if leader == nil then return false, Errors.NO_NODE end
        local members = {}
        local raw = api.value("Party.Members")
        if type(raw) == "string" then
            for entry in string.gmatch(raw, "[^,]+") do
                local trimmed = string.match(entry, "^%s*(.-)%s*$")
                if trimmed ~= "" then members[#members + 1] = trimmed end
            end
        end
        return true, { leader = leader ~= 0 and leader or nil, members = members }
    end

    -- HandlerHUD.lua:5588-5612 reads each booster value as seconds left
    function api.boosters()
        local stop = S.need()
        if stop then return false, stop end
        local folder = api.node("Boosters")
        if not folder then return false, Errors.NO_NODE end
        local out = {}
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("ValueBase") and type(child.Value) == "number" then out[child.Name] = child.Value end
        end
        return true, out
    end

    -- yields (invoke). HandlerMenus.lua:114: Data:InvokeServer("Stats", stat, amount)
    function api.spendStat(stat, n)
        if not STAT_NAMES[stat] then return false, Errors.BAD_ARGS end
        if type(n) ~= "number" or n % 1 ~= 0 or n < 1 then return false, Errors.BAD_ARGS end
        local ok, stats = api.stats()
        if not ok then return false, stats end
        if n > stats.points then return false, Errors.NO_POINTS end
        return Net.invokeAllowed("Data", "Stats", stat, n)
    end

    -- yields (invoke). HandlerMenus.lua:163; the server's second return is the status text the menu shows
    function api.resetStats()
        local stop = S.need()
        if stop then return false, stop end
        return Net.invokeAllowed("Data", "Reset Stats", true)
    end

    -- yields (invoke). SettingsHandler.lua:887 and the other call sites in net_state §2.6
    function api.setSetting(key, value)
        if type(key) ~= "string" or key == "" then return false, Errors.BAD_ARGS end
        local stop = S.need()
        if stop then return false, stop end
        return Net.invoke("Data", "Settings", key, value)
    end

    local function coverActive()
        local player = S.player()
        local gui = player and player:FindFirstChildOfClass("PlayerGui")
        return gui ~= nil and gui:GetAttribute("MainMenuReturnCoverActive") == true
    end

    -- yields. the game's own SettingsHandler answers every Prepare itself (cover, then Ready two frames later), so Ready is only sent here when its cover never shows, which keeps it to one Ready per request
    local returning = false
    function api.returnToMenu()
        if returning then return false, Errors.BUSY end
        if not S.player() then return false, Errors.NO_PLAYER end
        returning = true
        local requestId, failed, failMessage
        local handle, err = Net.on("MainMenuReturn", function(verb, a2, a3)
            if verb == "Prepare" and type(a2) == "string" and requestId == nil then
                requestId = a2
            elseif verb == "Failed" and (a2 == nil or a2 == requestId) then
                failed = true
                failMessage = a3
            end
        end)
        if not handle then
            returning = false
            return false, err
        end
        local own = S.own(function() handle:Disconnect() end)
        local function finish(...)
            own:Disconnect()
            returning = false
            return ...
        end

        local coverBefore = coverActive()
        local sent, sendErr = Net.fireAllowed("MainMenuReturn", "Request")
        if not sent then return finish(false, sendErr) end

        local deadline = os.clock() + PREPARE_TIMEOUT
        while requestId == nil and not failed and os.clock() < deadline do task.wait(POLL) end
        if failed then return finish(false, Errors.MENU_FAILED, failMessage) end
        if requestId == nil then return finish(false, Errors.NO_PREPARE) end

        deadline = os.clock() + COVER_WAIT
        while not failed and os.clock() < deadline and (coverBefore or not coverActive()) do task.wait(POLL) end
        if failed then return finish(false, Errors.MENU_FAILED, failMessage) end
        if coverBefore or not coverActive() then
            local ready, readyErr = Net.fireAllowed("MainMenuReturn", "Ready", requestId)
            if not ready then return finish(false, readyErr) end
        end

        deadline = os.clock() + FAILED_WAIT
        while not failed and os.clock() < deadline do task.wait(POLL) end
        if failed then return finish(false, Errors.MENU_FAILED, failMessage) end
        return finish(true, requestId)
    end
end

end)
__bundle_register("Api/Net", function(require, _LOADED, __bundle_register, __bundle_modules)
-- net api: the game's loose remotes and its data modules; the only code in the fork that names a remote or requires a game module, so every send passes the remote+verb policy and every listener is reaped by the api's maid
local Api    = require("Api")
local Errors = require("Api/Net/Errors")
local Jobs   = require("Utility/Jobs")
local Policy = require("Api/Net/Policy")

-- a server that never answers must not hang the caller's job forever
local INVOKE_TIMEOUT = 20
local INVOKE_POLL = 0.05

local M = {}

function M.new(ctx)
    local base     = Api.define("Net", ctx)
    local Services = ctx.Services
    local maid     = base.maid

    local function isRemote(inst)
        return inst:IsA("RemoteEvent") or inst:IsA("UnreliableRemoteEvent") or inst:IsA("RemoteFunction")
    end

    -- a bare name is ReplicatedStorage.Remotes.<name> (or a ReplicatedStorage child like MenuLoadingReady); a dotted one walks from ReplicatedStorage
    local remotes = {}
    local function remote(name)
        if type(name) ~= "string" or name == "" then return false, Errors.BAD_ARGS end
        local hit = remotes[name]
        if hit and hit.Parent then return true, hit end
        remotes[name] = nil
        local RS = Services.ReplicatedStorage
        local node
        if string.find(name, ".", 1, true) then
            node = RS
            for part in string.gmatch(name, "[^%.]+") do
                node = node:FindFirstChild(part)
                if not node then return false, Errors.NO_REMOTE end
            end
        else
            local folder = RS:FindFirstChild("Remotes")
            node = (folder and folder:FindFirstChild(name)) or RS:FindFirstChild(name)
        end
        if not (node and isRemote(node)) then return false, Errors.NO_REMOTE end
        remotes[name] = node
        return true, node
    end

    local function refused(name, verb, allowProtected)
        if Policy.isBlocked(name, verb) then return Errors.BLOCKED end
        if not allowProtected and Policy.isProtected(name, verb) then return Errors.PROTECTED end
        return nil
    end

    -- the verb is the remote's first argument, exactly as the game sends it; policy is judged on it
    local function fireWith(allowProtected, name, verb, ...)
        local stop = refused(name, verb, allowProtected)
        if stop then return false, stop end
        local ok, inst = remote(name)
        if not ok then return false, inst end
        if inst:IsA("RemoteFunction") then return false, Errors.WRONG_KIND end
        local sent, err = pcall(inst.FireServer, inst, verb, ...)
        if not sent then
            base.warn("fire %s %s failed: %s", name, tostring(verb), tostring(err))
            return false, Errors.SEND_FAILED
        end
        return true
    end

    -- yields until the server answers or INVOKE_TIMEOUT passes, so run it inside a job; (true, ...server returns) or (false, err)
    local function invokeWith(allowProtected, name, verb, ...)
        local stop = refused(name, verb, allowProtected)
        if stop then return false, stop end
        local ok, inst = remote(name)
        if not ok then return false, inst end
        if not inst:IsA("RemoteFunction") then return false, Errors.WRONG_KIND end
        local args = table.pack(verb, ...)
        local result
        local worker = Jobs.spawn(function()
            result = table.pack(pcall(inst.InvokeServer, inst, table.unpack(args, 1, args.n)))
        end, { name = "Net.invoke " .. name })
        local deadline = os.clock() + INVOKE_TIMEOUT
        while result == nil and os.clock() < deadline do
            task.wait(INVOKE_POLL)
        end
        if result == nil then
            worker:Cancel()
            base.warn("invoke %s %s timed out", name, tostring(verb))
            return false, Errors.TIMED_OUT
        end
        if not result[1] then
            base.warn("invoke %s %s failed: %s", name, tostring(verb), tostring(result[2]))
            return false, Errors.SEND_FAILED
        end
        return true, table.unpack(result, 2, result.n)
    end

    -- the handle's Destroy matters: Utility/Maid warns and skips any table task without one
    local function handleFor(remove)
        local handle = {}
        function handle:Disconnect()
            if remove then remove() end
            remove = nil
        end
        handle.Destroy = handle.Disconnect
        return handle
    end

    -- one OnClientEvent connection per remote, shared by every listener; verb listeners get the args after the verb
    local routers = {}
    local function router(name)
        local ok, inst = remote(name)
        if not ok then return nil, inst end
        if inst:IsA("RemoteFunction") then return nil, Errors.WRONG_KIND end
        local r = routers[name]
        if r and r.inst == inst then return r end
        if r then pcall(r.conn.Disconnect, r.conn) end
        r = { inst = inst, all = {}, verbs = {} }
        local function dispatch(verb, ...)
            for _, fn in pairs(r.all) do base.safe(name, fn, verb, ...) end
            local set = r.verbs[verb]
            if set then
                for _, fn in pairs(set) do base.safe(name .. " " .. tostring(verb), fn, ...) end
            end
        end
        -- held in routers and disconnected by the maid task below
        local okConn, conn = pcall(inst.OnClientEvent.Connect, inst.OnClientEvent, dispatch)
        if not okConn or conn == nil then return nil, Errors.SEND_FAILED end
        r.conn = conn
        routers[name] = r
        return r
    end

    local function on(name, fn)
        if type(fn) ~= "function" then return nil, Errors.BAD_ARGS end
        local r, err = router(name)
        if not r then return nil, err end
        local token = {}
        r.all[token] = fn
        return handleFor(function() r.all[token] = nil end)
    end

    local function onVerb(name, verb, fn)
        if verb == nil or type(fn) ~= "function" then return nil, Errors.BAD_ARGS end
        local r, err = router(name)
        if not r then return nil, err end
        local set = r.verbs[verb]
        if not set then
            set = {}
            r.verbs[verb] = set
        end
        local token = {}
        set[token] = fn
        return handleFor(function() set[token] = nil end)
    end

    -- the game's own data modules: a bare name is ReplicatedStorage.Modules.<name>, a dotted one walks from ReplicatedStorage; require returns the game's cached copy (verified live 2026-11-17)
    local modules = {}
    local function module(name)
        if type(name) ~= "string" or name == "" then return false, Errors.BAD_ARGS end
        local hit = modules[name]
        if hit and hit.inst.Parent then return true, hit.value end
        modules[name] = nil
        local RS = Services.ReplicatedStorage
        local node
        if string.find(name, ".", 1, true) then
            node = RS
            for part in string.gmatch(name, "[^%.]+") do
                node = node:FindFirstChild(part)
                if not node then return false, Errors.NO_MODULE end
            end
        else
            local folder = RS:FindFirstChild("Modules")
            node = folder and folder:FindFirstChild(name)
        end
        if not (node and node:IsA("ModuleScript")) then return false, Errors.NO_MODULE end
        local ok, value = pcall(require, node)
        if not ok then
            base.warn("could not load %s: %s", name, tostring(value))
            return false, Errors.NO_MODULE
        end
        modules[name] = { inst = node, value = value }
        return true, value
    end

    if maid then
        maid:GiveTask(function()
            for _, r in pairs(routers) do pcall(r.conn.Disconnect, r.conn) end
            table.clear(routers)
            table.clear(modules)
            table.clear(remotes)
        end)
    end

    local okFolder = Services.ReplicatedStorage:FindFirstChild("Remotes") ~= nil
    base.log("net api ready (%s)", okFolder and "remotes found" or "remotes folder missing")

    return {
        Errors = Errors,

        remote = remote,
        fire   = function(name, verb, ...) return fireWith(false, name, verb, ...) end,
        invoke = function(name, verb, ...) return invokeWith(false, name, verb, ...) end,
        on     = on,
        onVerb = onVerb,
        module = module,

        -- protected verbs (spending, account-changing, leaving the server) only through these; blocked ones refuse even here
        fireAllowed   = function(name, verb, ...) return fireWith(true, name, verb, ...) end,
        invokeAllowed = function(name, verb, ...) return invokeWith(true, name, verb, ...) end,
        isProtected   = Policy.isProtected,
        isBlocked     = Policy.isBlocked,
    }
end

return M

end)
