__bundle_register("Features/Combat/Stand/PilotRange", function(require, _LOADED, __bundle_register, __bundle_modules)
-- infinite pilot range: holds a huge PilotRange attribute on your stand on this client only; the controller reads that attribute before the stand's data range in its move clamp, flight clamp and range recovery (PlayerController.lua:9093, 10790, 10919, 16952-16953), and the server's own value comes back when off
local ATTR = "PilotRange"
-- finite on purpose: the move clamp squares it (PlayerController.lua:10798)
local HUGE = 100000

local M = {}
M.ATTR = ATTR
M.HUGE = HUGE

-- the attribute to hold: ours while on, else the server's own value (nil = none)
function M.wanted(on, server)
    if on then return HUGE end
    return server
end

-- the stand's real reach while piloting: its attribute, else PilotRange, else Range * 2 (PlayerController.lua:9093)
function M.reach(server, def)
    if type(server) == "number" then return server end
    if type(def) ~= "table" then return nil end
    if type(def.PilotRange) == "number" then return def.PilotRange end
    if type(def.Range) == "number" then return def.Range * 2 end
    return nil
end

-- getStand() answers your stand model or nil; tick() follows a new stand (respawn, re-summon) and puts the old one back
function M.new(getStand)
    local on = false
    local stand, conn = nil, nil
    -- server: the value that isn't ours; ours: the last value written, so any other change is the server's
    local server, ours = nil, nil

    local function write(model, value)
        pcall(model.SetAttribute, model, ATTR, value)
    end

    local function apply()
        if not (stand and stand.Parent) then return end
        local target = M.wanted(on, server)
        ours = target
        if stand:GetAttribute(ATTR) ~= target then write(stand, target) end
    end

    local function onChange()
        if not stand then return end
        local value = stand:GetAttribute(ATTR)
        if value == ours then return end
        server = type(value) == "number" and value or nil
        ours = value
        apply()
    end

    local function unbind()
        if conn then
            conn:Disconnect()
            conn = nil
        end
        if stand and stand.Parent and stand:GetAttribute(ATTR) == ours and ours ~= server then write(stand, server) end
        stand, server, ours = nil, nil, nil
    end

    local function bind(model)
        unbind()
        stand = model
        local value = model:GetAttribute(ATTR)
        server = type(value) == "number" and value or nil
        ours = value
        conn = model:GetAttributeChangedSignal(ATTR):Connect(onChange)
        apply()
    end

    local self = {}

    function self.tick()
        local model = getStand()
        if not on then
            if stand then unbind() end
            return
        end
        if model ~= stand then
            if model then bind(model) else unbind() end
        else
            apply()
        end
    end

    function self.set(value)
        on = value == true
        self.tick()
    end

    -- the server's reach for the stand we hold, whatever we wrote over it
    function self.serverValue()
        return server
    end

    function self.stop()
        on = false
        unbind()
    end

    return self
end

return M

end)
__bundle_register("Features/Combat/Stand/Attach", function(require, _LOADED, __bundle_register, __bundle_modules)
-- attach stand: while you pilot, your stand holds behind one latched enemy (written every physics step; a piloted stand with no move input stays put, PlayerController.lua:17488-17497), auto pilot presses the pilot key for you while there's a target, and attack while attached swings through the game's own pilot-mode light swing; the stand's physics is yours and ClientPositionReporter.lua:27-60 reports its root to the server
local PilotRange = require("Features/Combat/Stand/PilotRange")

-- with infinite range the target search still stops here (streaming keeps far models empty)
local FAR_REACH = 250
-- a target is let go a little past where it was picked
local KEEP_SLACK = 6
-- the stand's swing reaches about this far, so swings start only this close
local SWING_REACH = 7
local SWING_EVERY = 0.15
-- after a pilot toggle the server's Piloting attribute lags, so the next toggle waits
local PILOT_EVERY = 1.5
-- auto pilot lets go after this long with nothing to hold
local IDLE_RELEASE = 2

local M = {}

local function rootOf(model)
    local root = model and model:FindFirstChild("HumanoidRootPart")
    if root and root:IsA("BasePart") then return root end
    return nil
end
M.rootOf = rootOf

-- behind the target along its flat facing; a target looking straight up or down keeps the last direction
function M.holdPoint(targetPos, targetLook, distance)
    local flat = Vector3.new(targetLook.X, 0, targetLook.Z)
    if flat.Magnitude < 0.01 then flat = Vector3.new(0, 0, -1) end
    return targetPos - flat.Unit * distance
end

-- the nearest valid model to origin within reach
function M.nearest(list, origin, reach, valid)
    local best, bestDist = nil, math.huge
    for _, model in ipairs(list) do
        local root = rootOf(model)
        if root and valid(model) then
            local d = (root.Position - origin).Magnitude
            if d <= reach and d < bestDist then best, bestDist = model, d end
        end
    end
    return best, bestDist
end

-- how far from your body the stand may go: huge with infinite range on, else the stand's own reach less a margin
function M.reach(infinite, serverValue, def)
    if infinite then return FAR_REACH end
    local r = PilotRange.reach(serverValue, def)
    if not r then return nil end
    return math.max(r - 2, 0)
end

-- deps: Combat, World, character(), standDef(), valid(model, players) -> bool, opts() -> { attach, autoPilot, attack, distance, infinite, players }, serverRange() -> number|nil, paused() -> bool, now()
function M.new(deps)
    local Combat, World = deps.Combat, deps.World
    local self = { target = nil }
    local startedPilot = false
    local lastPilot, lastSwing, lastSeen = -math.huge, -math.huge, -math.huge

    local function char()
        local c = deps.character()
        if c and c.Parent then return c end
        return nil
    end

    local function piloting(c)
        local active = c:GetAttribute("ActivePiloting")
        if type(active) == "boolean" then return active end
        return c:GetAttribute("Piloting") == true
    end

    local function standModel()
        local ok, info = Combat.stand()
        if ok and info.model and info.model.Parent then return info.model, info end
        return nil, ok and info or nil
    end

    local function togglePilot(on)
        if type(Combat.pilot) ~= "function" then return false end
        local t = deps.now()
        if t - lastPilot < PILOT_EVERY then return false end
        lastPilot = t
        local ok = Combat.pilot(on)
        return ok == true
    end

    -- auto pilot only lets go of a pilot it started
    local function releasePilot(c)
        if startedPilot and c and piloting(c) then togglePilot(false) end
        if not (c and piloting(c)) then startedPilot = false end
    end

    function self.step()
        local o = deps.opts()
        local c = char()
        if not o.attach or not c or deps.paused() then
            self.target = nil
            releasePilot(c)
            return
        end
        local body = rootOf(c)
        local stand = standModel()
        if not body then
            self.target = nil
            return
        end
        local def = deps.standDef()
        local reach = M.reach(o.infinite, deps.serverRange(), def) or FAR_REACH
        local valid = function(model) return deps.valid(model, o.players) end
        local t = self.target
        if t then
            local troot = rootOf(t)
            if not (t.Parent and troot and valid(t) and (troot.Position - body.Position).Magnitude <= reach + KEEP_SLACK) then
