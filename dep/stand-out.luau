        if S.flag("StandOutCustomizationOpen") or S.playerAttr("HowlerCashActive") == true then return Errors.BUSY end
        for _, attr in ipairs({ "SuperFlyZipline", "BodySnatchHead", "HeavensDoorWritingToken", "BecomeMyCharacterPending",
            "BecomeMyCharacterControlled", "GrabbingItem", "Hiding", "HoldingItem" }) do
            if char:GetAttribute(attr) then return Errors.BUSY end
        end
