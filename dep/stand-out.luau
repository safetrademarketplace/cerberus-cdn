    local function setWindow(sw, L, open)
        if open then
            sw.state = "open"
            sw.opensAt = S.now()
            sw.closesAt = sw.opensAt + sw.active
            L.hitEnabled = true
        else
            sw.state = "closed"
            L.hitEnabled = false
