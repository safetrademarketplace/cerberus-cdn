            return why, false
        end
        if not D.alive() then
            if waitRespawn(j) then return "Back in action", true end
            return "Waiting to respawn", false
        end
        if Player.isBusy() and not D.atTable() then
            if not (D.onlyDialogue() and D.closeDialogue()) then return "Waiting for a scene", false end
        end
        if not ensureClaim() then return "Movement is busy", false end
        local list = D.activeQuests() or {}

        local note, busy = T.step()
        if busy then return note, true end
        if toggleOn("AutoQuest_Story", true) then
            local s, b = S.step(list)
            if b then
                storyAt = os.clock()
                return s or note, true
            end
            note = note or s
        end
        local s, b = Sd.step(list, pickedSides())
        if b then return s or note, true end
        -- a side quest's own wait ("Next contract in 30s") says more than the story's idle line ("Story complete")
        return s or note or "Nothing to do", false
    end

    local function loop(j)
        Q.job = j
        while j.alive and enabled do
            local ok, line, busy = pcall(pass, j)
            holdForStory()
            if ok then
                if not gated then work = busy == true end
                -- a countdown a step marked through Q.waiting is worth showing; any other idle line is not
                if line then post(line, busy and Status.ACTING or ((gated or line == Q.waiting) and Status.WAITING) or Status.IDLE) end
                -- every pass lets go of movement: a pass is a whole step, and a quest stuck on retries would otherwise starve auto garden and cash cases (live 2026-11-17)
                releaseClaim()
            else
                Log.devwarn("AutoQuests", "pass failed: %s", tostring(line))
            end
            if not j:sleep(FarmSettings.tick(TICK)) then return end
        end
    end

    local function stop()
        enabled = false
        if job then job:Cancel() end
        job = nil
        if engine then engine.destroy() end
        Q.job = nil
        releaseClaim()
        D.forget()
        Q.current = nil
        gated, work = false, false
        storyAt = -math.huge
        Farms.setPriority(FARM, false)
        Status.clear(OWNER)
    end

    local box = ctx.Tabs.Quests:AddLeftGroupbox("Auto Quests", "scroll")
    box:AddToggle("AutoQuest_Enabled", {
        Text     = "Auto Quests",
        Default  = false,
        Callback = function(on)
            if on then
                if enabled then return end
                enabled = true
                job = O.track(Jobs.spawn(loop, { name = "AutoQuests" }))
            else
                stop()
            end
        end,
    })
    Farms.register({
        name    = FARM,
        label   = "Quests",
        owner   = OWNER,
        enable  = function(on) UiWrite.value(Toggles.AutoQuest_Enabled, on) end,
        enabled = function() return enabled end,
        active  = function() return Q.token ~= nil end,
        wants   = function() return enabled and work end,
    })
    box:AddToggle("AutoQuest_Story", {
        Text    = "Include Story",
        Default = true,
    })
    local sides = ctx.Tabs.Quests:AddLeftGroupbox("Side Quests", "map")
    sides:AddDropdown("AutoQuest_Side", {
        Text    = "Side Quests",
        Values  = Sd.titles(),
        Default = {},
        Multi   = true,
    })

    local info = ctx.Tabs.Quests:AddRightGroupbox("Quest Info", "list-checks")
    local questLabel = info:AddLabel("No quest", true)
    local objectiveLabel = info:AddLabel("", true)

    local options = ctx.Tabs.Quests:AddRightGroupbox("Quest Options", "settings")
    options:AddToggle("AutoQuest_StoryXp", {
        Text    = "Level Up For Story",
        Tooltip = "Takes elimination contracts when the story asks for a level",
        Default = true,
    })
    options:AddToggle("AutoQuest_PreferVampire", {
        Text    = "Prefer Vampire Bounties",
        Tooltip = "For Hamon's vampire lessons",
        Default = false,
    })
    options:AddToggle("AutoQuest_Puzzles", {
        Text    = "Solve Story Puzzles",
        Tooltip = "ID checks, staff records and the cash timing",
        Default = true,
    })

    -- the quest being driven, else the tracked one, else the first active
    local function shown()
        local list = D.activeQuests()
        if not list or #list == 0 then return nil end
        local pick = nil
        for _, q in ipairs(list) do
            if q.id == Q.current then return q end
            if not pick and q.tracked then pick = q end
        end
        return pick or list[1]
    end

    O.track(Scheduler.heartbeat(function()
        if Library and not Library.Toggled then return end
        local q = shown()
        if not q then
            UiWrite.text(questLabel, "No quest")
            UiWrite.text(objectiveLabel, "")
            return
        end
        UiWrite.text(questLabel, D.sanitize(q.title))
        local tag, have, need = D.nextObjective(q)
        if tag then
            UiWrite.text(objectiveLabel, ("%s %d/%d"):format(D.label(q, tag), have, need))
        else
            UiWrite.text(objectiveLabel, "Turning in")
        end
    end, { name = "AutoQuests.info", interval = REFRESH, deferrable = true }))

    O.onUnload(stop)
    O.onUnload(function() D.howlerSteps.stop() end)
    O.onUnload(function() Farms.unregister(FARM) end)
    O.finalize()
end

end)
__bundle_register("Features/Auto/Garden/Flow", function(require, _LOADED, __bundle_register, __bundle_modules)
-- garden flow: one pot from bag to harvest, shared by auto garden and auto quests; place, dirt, seed and harvest are the game's own server prompts, and the dirt and seed steps are its bag minigame, played through the game's own grab and release (your cursor can't knock it off; the client cancels any pour it didn't start, Gardening.lua:2502); every session it opens it closes
local Executor = require("Utility/Executor")
local FarmSettings = require("Utility/FarmSettings")
local Identity = require("Utility/Identity")

-- live 2026-11-17: Gardening.Rules PourSeconds 0.65 and DropRadius 0.85; the drag lands well inside, then holds past the pour
local DRAG_STEPS = 60
local DRAG_GAIN = 0.6
local DRAG_CLOSE = 0.3
local POUR_HOLD = 1.6
local SEED_HOLD = 0.4
local GARDEN_SCRIPT = "PlayerScripts.Core.Gardening"
local DRAG_TRIES = 3
local LOCK_WAIT = 130
local SESSION_WAIT = 6
local STEP_WAIT = 6
local INPUT_GAP = 0.25
local SHOP_WAIT = 6
-- live 2026-11-17: a trade sent 0.1 s after ShopOpened gets "Please wait a moment", one 1.5 s after goes through
local SHOP_SETTLE = 1.5
local SHOP_TRIES = 3
local PLACE_WAIT = 5
local NEAR_POT = 2.5
local MAX_POTS = 2
local GRADES = { F = 1, E = 2, D = 3, C = 4, B = 5, A = 6, S = 7, SS = 8, SSS = 9 }
-- apple and tomato are the 50-base crops, everything else 75 (gardening.md, CAT.SeedPrice)
local LOW_BASE = { Apple = true, Tomato = true }
local SEED_RESERVE = 500
local BIG_CHOP = "Big Chop"
local WALK_RANGE = 200
local WALK_SLACK = 2

local Flow = {}

local function flat(v) return Vector3.new(v.X, 0, v.Z) end

function Flow.new(ctx, owner)
    local apis = ctx.Api or {}
    local World, Activities, Player = apis.World, apis.Activities, apis.Player
    if not (World and Activities and Player) then return nil end
    local References = ctx.References
    local Services = ctx.Services
    local Workspace = Services.Workspace

    local F = { token = nil, say = function() end }

    local function sleep(seconds)
        if F.job then return F.job:sleep(seconds) end
        task.wait(seconds)
        return true
    end

    local function waitFor(check, timeout)
        local waited = 0
        while waited < timeout do
            local value = check()
            if value then return value end
            if not sleep(0.1) then return nil end
            waited = waited + 0.1
        end
        return check()
    end

    local function gardenFolder()
        local root = Workspace:FindFirstChild("Game")
        return root and root:FindFirstChild("Gardening")
    end

    function F.myPots()
        local out = {}
        local folder = gardenFolder()
        local pots = folder and folder:FindFirstChild("Pots")
        if not pots then return out end
        local me = References.player.UserId
        for _, pot in ipairs(pots:GetChildren()) do
            if pot:GetAttribute("OwnerUserId") == me then out[#out + 1] = pot end
        end
        return out
    end

    function F.stage(pot) return pot:GetAttribute("Stage") end

    local function count(name)
        local ok, n = Player.count(name)
        return ok and n or 0
    end

    -- seeds you own, as inventory entries; a story seed asked for by name wins
    function F.seeds()
        local out = {}
        local ok, list = Player.inventory()
        if not ok then return out end
        for _, entry in ipairs(list) do
            if type(entry.name) == "string" and string.sub(entry.name, -5) == " Seed" and (entry.amount or 1) > 0 then out[#out + 1] = entry end
        end
        return out
    end

    -- a seed's grade rank (F 1 .. SSS 9) and its crop's base price; a higher grade sells for up to 4x (reward_rate.md, CAT:197-209)
    function F.grade(entry)
        local q = entry and (entry.quality or (type(entry.raw) == "table" and entry.raw.Quality))
        return GRADES[q] or 1
    end

    local function seedValue(entry)
        local crop = string.gsub(entry.name or "", " Seed$", "")
        return F.grade(entry) * 100 + (LOW_BASE[crop] and 50 or 75)
    end

    -- the best seed you own, by grade then by crop value; a name asked for (a story seed) narrows it to that seed. with no name a rokaka seed is never the pick:
    -- it grows 48 min into fruit that can't be sold (gardening.md, GM:374-381), so it's only planted when asked for (Grow Roka, or Rokaka in the seed list)
    function F.bestSeed(name)
        local best, bestValue = nil, -1
        for _, entry in ipairs(F.seeds()) do
            if (name and entry.name == name) or (not name and entry.name ~= F.ROKA_SEED) then
                local v = seedValue(entry)
                if v > bestValue then best, bestValue = entry, v end
            end
        end
        return best
    end

    F.ROKA_SEED = "Rokaka Seed"

    local function seedNamed(name) return F.bestSeed(name) end

    local function positionOf(target)
        if typeof(target) == "Vector3" then return target end
        if typeof(target) == "Instance" then
            if target:IsA("BasePart") then return target.Position end
            if target:IsA("Model") then return target:GetPivot().Position end
        end
        return nil
    end

    -- the pots, spots and big chop sit close together, so a trip inside the garden is run on foot like a player; a far one (coming back from elsewhere) teleports, and so does a walk the path can't finish
    local function travel(target, opts)
        local options = { token = F.token }
        for k, v in pairs(opts or {}) do options[k] = v end
        local goal = positionOf(target)
        local root = References.humanoidRootPart
        if goal and root and root.Parent and (root.Position - goal).Magnitude <= FarmSettings.walkRange(WALK_RANGE) then
            local ok = World.walkTo(goal, { token = F.token, sprint = true, tolerance = (tonumber(options.offset) or 0) + WALK_SLACK })
            if ok then return true end
        end
        return World.travelTo(target, options)
    end

    -- ============================== big chop's shop ==============================

    -- the cheapest seed on today's rotation, for when you own none
    -- the best seed offer you can afford while keeping a reserve: highest grade, then the dearer crop, then the cheaper price; above minGrade when given
    local function bestSeedOffer(minGrade)
        local okS, s = Activities.gardenShop()
        local offers = okS and s and s.snapshot and s.snapshot.Offers or {}
        local okD, dalas = Player.dalas()
        local budget = (okD and tonumber(dalas) or 0) - SEED_RESERVE
        local best, bestValue = nil, -math.huge
        for _, offer in ipairs(offers) do
            local coins = tonumber(offer.Coins) or math.huge
            local grade = GRADES[offer.Quality] or 1
            if offer.Kind == "Seed" and coins <= budget and grade > (minGrade or 0) then
                local v = seedValue({ name = offer.Name, quality = offer.Quality }) - coins / 10000
                if v > bestValue then best, bestValue = offer, v end
            end
        end
        return best and best.Id
    end

    local function cheapestSeedOffer() return bestSeedOffer(nil) end

    local function shopTrade(buys, sell)
        local okN, chop = World.npc(BIG_CHOP)
        if not okN then return false, "no_shop" end
        F.say("Going to Big Chop")
        local ok, err = travel(chop, { offset = 3 })
        if not ok then return false, err end
        -- right after the teleport the server may not see you beside him yet ("Stand by Big Chop to shop"), so the open gets a second go
        local opened
        for _ = 1, 2 do
            Activities.gardenShopOpen()
            opened = waitFor(function()
                local okS, s = Activities.gardenShop()
                return okS and s and s.snapshot and s
            end, SHOP_WAIT / 2)
            if opened or not sleep(SHOP_SETTLE) then break end
        end
        if not opened then return false, "shop_closed" end
        -- the server turns away a trade that comes too soon, so each one waits a beat and only counts on a ShopResult
        local function trade(send)
            for _ = 1, SHOP_TRIES do
                if not sleep(SHOP_SETTLE) then return false end
                if not send() then return false end
                local answered = waitFor(function()
                    local okS, s = Activities.gardenShop()
                    return okS and s and not s.pending and s.result
                end, SHOP_WAIT)
                if answered and answered.verb == "ShopResult" and answered.payload.Success ~= false then return true end
                local message = answered and tostring(answered.payload.Message or "") or ""
                if not message:lower():find("wait") then return false end
            end
            return false
        end
        local done = true
        for _, buy in ipairs(buys or {}) do
            F.say("Buying " .. buy.label)
            -- a seed offer id carries today's rotation, so it is picked off the open shop
            local id = buy.id or (buy.pick and buy.pick())
            if not (id and trade(function() return Activities.gardenShopBuy(id, buy.amount or 1) end)) then done = false end
        end
        if sell then
            F.say("Selling the harvest")
            if not trade(Activities.gardenShopSellAll) then done = false end
        end
        Activities.gardenShopClose()
        return done
    end

    -- one trip for a seed better than the best you own; (true) bought, (false) nothing better or affordable
    function F.upgradeSeed()
        local best = F.bestSeed(nil)
        local minGrade = best and F.grade(best) or 0
        return shopTrade({ { pick = function() return bestSeedOffer(minGrade) end, label = "a better seed" } }, false)
    end

    function F.buySupplies(needPot, needDirt, needSeed)
        local buys = {}
        if needPot then buys[#buys + 1] = { id = "supply:pot", label = "a pot" } end
        if needDirt then buys[#buys + 1] = { id = "supply:dirt", label = "dirt" } end
        if needSeed then buys[#buys + 1] = { pick = cheapestSeedOffer, label = "a seed" } end
        if #buys == 0 then return true end
        return shopTrade(buys, false)
    end

    function F.sellAll()
        return shopTrade(nil, true)
    end

    -- ============================== placing ==============================

    local function freeSpots(near)
        local folder = gardenFolder()
        local out = {}
        if not folder then return out end
        for _, spot in ipairs(folder:GetChildren()) do
            if spot.Name == "GardenSpot" and spot:IsA("BasePart") and spot:FindFirstChild("GardenPlace", true) then
                out[#out + 1] = { spot = spot, distance = near and (spot.Position - near).Magnitude or 0 }
            end
        end
        table.sort(out, function(a, b) return a.distance < b.distance end)
        return out
    end

    -- the place prompt only turns on beside a spot nobody uses (the client's eligibility pass), so spots are tried nearest first
    function F.placePot(near)
        if #F.myPots() >= MAX_POTS then return false, "too_many" end
        if count("Garden Pot") < 1 then return false, "no_pot" end
        local before = #F.myPots()
        for i, entry in ipairs(freeSpots(near)) do
            if i > 6 then break end
            F.say("Placing a pot")
            travel(entry.spot.Position, { offset = 3 })
            local prompt = entry.spot:FindFirstChild("GardenPlace", true)
            if prompt and World.firePrompt(prompt) then
                if waitFor(function() return #F.myPots() > before end, PLACE_WAIT) then return true end
            end
        end
        return false, "no_spot"
    end

    -- ============================== sessions ==============================

    local function growing()
        local ok, g = Activities.garden()
        return ok and g and g.growing or nil
    end

    -- the game holds GardeningInputLocked while any of your sessions is open, and keeps the pot's prompt off until it ends
    -- a lock nothing owns (a reload mid-session) is cleared here, else the pot's prompt stays dead
    local function waitUnlocked()
        Player.repairLocks()
        return waitFor(function() return References.player:GetAttribute("GardeningInputLocked") ~= true end, LOCK_WAIT) == true
    end

    local function openSession(pot, kind)
        local current = growing()
        if current and current.Kind == kind and current.Phase ~= "Complete" then return current end
        if current then Activities.growingInput("Close") end
        if not waitUnlocked() then return nil, "locked" end
        local center = pot:GetPivot().Position
        local ok, err = travel(center + Vector3.new(NEAR_POT, 0, 0), { offset = 2, face = center })
        if not ok then return nil, err end
        local work = pot:FindFirstChild("GardenWork", true)
        if not work then return nil, "no_prompt" end
        if not World.firePrompt(work) then return nil, "prompt_off" end
        local session = waitFor(function()
            local g = growing()
            return g and g.Kind == kind and g
        end, SESSION_WAIT)
        if not session then return nil, "no_session" end
        return session
    end

    local function closeSession()
        if growing() then Activities.growingInput("Close") end
    end

    -- the game's local scene under the camera: the bag (or seed) you drag and the pour target over the pot
    local function scene()
        local camera = Workspace.CurrentCamera
        local root = camera and camera:FindFirstChild("GrowingLocal")
        local pot = root and root:FindFirstChild("GrowingPot")
        local bag = pot and pot:FindFirstChild("GrowingBag")
        if not bag then return nil end
        local target = pot:FindFirstChild("PourTarget") or pot:FindFirstChild("Garden Pot")
        local goal = target and (target:IsA("BasePart") and target.Position or target:GetPivot().Position) or pot:GetPivot().Position
        return camera, bag, goal
    end

    -- live 2026-11-17: a mouse-driven drag lost to the player's own cursor, so the bag is placed through the game's own controls instead:
    -- pourStart(session, true) is the gamepad grab (Gardening.lua:1665, 2807), the session's BagPose CFrameValue moves the bag (:2100-2107),
    -- the render loop then pours dirt and sends PourEnd itself (:3012-3033), and the drag-end handler drops a seed with SeedDrop (:1814-1913)
    local controls = nil

    local function findControls()
        local getgc = Executor.get("getgc")
        local dbg = debug
        local getconstants = dbg.getconstants or Executor.get("getconstants")
        if not (getgc and dbg.getupvalue and getconstants) then return nil end
        local found = {}
        for _, f in ipairs(getgc(false)) do
            if type(f) == "function" then
                local okS, src = pcall(dbg.info, f, "s")
                if okS and type(src) == "string" and string.sub(src, -#GARDEN_SCRIPT) == GARDEN_SCRIPT then
                    local okN, name = pcall(dbg.info, f, "n")
                    if okN and name == "pourStart" then
                        found.grab = f
                    elseif okN and (name == nil or name == "") then
                        local okC, consts = pcall(getconstants, f)
                        if okC and type(consts) == "table" then
                            local set = {}
                            for _, c in pairs(consts) do if type(c) == "string" then set[c] = true end end
                            if set.DropBusy and set.DragAt and set.TouchDropRadius then found.release = f end
                        end
                    end
                end
            end
        end
        if not (found.grab and found.release) then return nil end
        found.session = function()
            local ok, v = pcall(dbg.getupvalue, found.grab, 1)
            if ok and type(v) == "table" and v.Bag and v.Goal and v.BagPose then return v end
            return nil
        end
        return found
    end

    local function sessionControls()
        if controls and controls.session() then return controls end
        controls = findControls()
        return controls
    end

    -- the game's own grab and release; (true) once the bag sat over the target for holdFor, (nil) when its controls can't be found
    local function placeBag(holdFor, releaseAfter)
        local c = waitFor(function()
            local found = sessionControls()
            return found and found.session() and found
        end, SESSION_WAIT)
        if not c then return nil end
        local session = c.session()
        Identity.asGame(c.grab, session, true)
        if not session.Dragging then return nil end
        local deadline = os.clock() + holdFor
        repeat
            local bag = session.Bag
            if not (bag and bag.Parent and session.BagPose) then break end
            session.BagPose.Value = bag:GetPivot().Rotation + session.Goal
            if not sleep(0.1) then break end
        until os.clock() >= deadline or c.session() ~= session
        if releaseAfter and c.session() == session then Identity.asGame(c.release, session) end
        return true
    end

    -- the old mouse drag, kept only for when the game's controls can't be found; it never hides any ui
    local function mouseDrag(holdFor)
        if not waitFor(function() return scene() ~= nil end, SESSION_WAIT) then return false, "no_scene" end
        local camera, bag, goal = scene()
        if not camera then return false, "no_scene" end
        sleep(0.6)
        Identity.elevate()
        local VIM = Services.VirtualInputManager
        local ok, err = pcall(function()
            local start = camera:WorldToViewportPoint(bag:GetPivot().Position)
            local mx, my = start.X, start.Y
            VIM:SendMouseMoveEvent(mx, my, game)
            sleep(0.1)
            VIM:SendMouseButtonEvent(mx, my, 0, true, game, 1)
            sleep(0.15)
            for _ = 1, DRAG_STEPS do
                local here = bag:GetPivot().Position
                if (flat(here) - flat(goal)).Magnitude < DRAG_CLOSE then break end
                local s = camera:WorldToViewportPoint(here)
                local g = camera:WorldToViewportPoint(Vector3.new(goal.X, here.Y, goal.Z))
                mx = mx + (g.X - s.X) * DRAG_GAIN
                my = my + (g.Y - s.Y) * DRAG_GAIN
                VIM:SendMouseMoveEvent(mx, my, game)
                if not sleep(0.05) then break end
            end
            sleep(holdFor or POUR_HOLD)
            VIM:SendMouseButtonEvent(mx, my, 0, false, game, 1)
        end)
        if not ok then return false, tostring(err) end
        return true
    end

    -- dirt is held over the pot until the game's own loop pours it; a seed is held a moment, then released to drop
    function F.drag(holdFor, kind)
        local placed = placeBag(holdFor or POUR_HOLD, kind == "Seed")
        if placed then return true end
        return mouseDrag(holdFor)
    end

    -- ============================== steps ==============================

    function F.fillDirt(pot)
        if count("Dirt Bag") < 1 then return false, "no_dirt" end
        F.say("Filling with dirt")
        local session, err = openSession(pot, "Dirt")
        if not session then return false, err end
        -- live 2026-11-17: your own clicks during the drag can knock the bag off the pot, so a missed pour is played again in the same session
        for _ = 1, DRAG_TRIES do
            F.drag(POUR_HOLD, "Dirt")
            if waitFor(function() return pot:GetAttribute("HasDirt") == true end, STEP_WAIT) then return true end
            if not growing() then break end
        end
        closeSession()
        return false, "no_dirt_filled"
    end

    function F.plant(pot, seedName)
        local entry = seedName and seedNamed(seedName) or F.bestSeed(nil)
        if not entry then return false, "no_seed" end
        F.say("Planting " .. string.gsub(entry.name, " Seed$", ""))
        Activities.selectSeed(entry.name, entry.id)
        local session, err = openSession(pot, "Seed")
        if not session then return false, err end
        if session.Phase == "Pour" then
            local dropped = false
            for _ = 1, DRAG_TRIES do
                F.drag(SEED_HOLD, "Seed")
                dropped = waitFor(function()
                    local g = growing()
                    return g and (g.Phase == "Cover" or g.Phase == "Complete") and g
                end, STEP_WAIT)
                if dropped or not growing() then break end
            end
            -- the seed never landed: close cleanly so the next pass opens a fresh session instead of covering nothing
            if not dropped then
                closeSession()
                return false, "not_dropped"
            end
        end
        for index = 1, 4 do
            Activities.growingInput("Cover", { Index = index })
            waitFor(function()
                local g = growing()
                return not g or g.Phase == "Complete" or not g.pending
            end, 2)
            if not sleep(INPUT_GAP) then break end
        end
        local planted = waitFor(function() return F.stage(pot) == "Growing" or F.stage(pot) == "Ready" end, STEP_WAIT)
        closeSession()
        if planted then return true end
        return false, "not_planted"
    end

    function F.harvest(pot)
        F.say("Harvesting")
        local session, err = openSession(pot, "Harvest")
        if not session then return false, err end
        for index = 1, session.Count or 4 do
            Activities.growingInput("Clip", { Index = index })
            if not sleep(INPUT_GAP + 0.15) then break end
        end
        local done = waitFor(function() return F.stage(pot) ~= "Ready" end, STEP_WAIT)
        closeSession()
        if done then return true end
        return false, "not_harvested"
    end

    -- seconds until a growing pot ripens, from its server-clock stamp
    function F.ripensIn(pot)
        local ends = tonumber(pot:GetAttribute("GrowthEndsAt"))
        if not ends then return nil end
        return math.max(0, ends - Workspace:GetServerTimeNow())
    end

    -- one step on one pot: whatever its stage needs next; answers (done, reason) and never waits out a growth
    function F.tend(pot, seedName)
        local stage = F.stage(pot)
        if stage == "Empty" then return F.fillDirt(pot) end
        if stage == "DirtReady" then return F.plant(pot, seedName) end
        if stage == "Ready" then return F.harvest(pot) end
        return false, "growing"
    end

    F.closeSession = closeSession
    F.count = count
    return F
end

return Flow

end)
__bundle_register("Features/Auto/Quests/Tutorial", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto quests tutorial: finishes the server-side tutorial from the EX step on (cast the EX move, push progress one step at a time, then finish), waiting on the server's TutorialProgress after every send; the earlier steps are fights and an arrow the player does

-- TutorialHandler.lua:340-364 builds nine steps and sends index + 1; index 7 is STEP_EX, 8 is STEP_7 (stats), 9 is STEP_8 (go see meryl)
local EX_STEP       = 7
local STATS_STEP    = 8
local MERYL_STEP    = 9
local LAST          = 10
local EX_WAIT       = 6
local PROGRESS_WAIT = 6
local FINISH_WAIT   = 8
-- the stats step asks for one point spent; only spent after the server has refused the plain send once
local TUTORIAL_STAT = "Damage"
-- live 2026-11-17: step 10 is refused unless you stand at meryl; Quests.lua:640 is her static tracker for when she is streamed out
local MERYL         = "Meryl Mei Qi"
local MERYL_AT      = Vector3.new(-484.366, 22.99, 1844.438)

return function(Q, D)
    local Activities = Q.Activities
    local Player     = Q.Player
    local Combat     = Q.Combat

    local T = {}

    local function progress()
        return tonumber(Player.value("Stats.TutorialProgress")) or 0
    end

    local function finished()
        return Player.value("Stats.TutorialFinished") == true
    end

    function T.finished()
        return finished()
    end

    -- TutorialHandler.lua:2437: the EX step passes once Data's TutorialEXUsed is set
    local function castEx(key)
        local name = Player.attr("", "TutorialEXMove")
        if type(name) ~= "string" or name == "" then return false, "no_ex" end
        if not (Combat and Combat.useSkill) then return false, "no_combat" end
        Q.say("Using EX move")
        local ok, err = Combat.useSkill(name)
        if not ok then
            D.failed(key, "Can't use EX")
            return false, err
        end
        local used = D.waitFor(function() return Player.attr("", "TutorialEXUsed") == true end, EX_WAIT)
        if not used then
            D.failed(key, "Can't use EX")
            return false, "ex_unused"
        end
        return true
    end

    local function spendPoint()
        local ok, stats = Player.stats()
        if not ok or stats.points < 1 then return false end
        Q.say("Spending a stat point")
        return Player.spendStat(TUTORIAL_STAT, 1) == true
    end

    -- (status, busy): busy means it acted this pass; a nil status means the tutorial is done
    function T.step()
        if finished() then return nil, false end
        if Q.References.player:GetAttribute("TutorialProgressReady") ~= true then return "Waiting for tutorial", false end
        local p = progress()
        local key = "tutorial|" .. p
        local parked, why = D.blocked(key)
        if parked then return why or "Tutorial needs you", false end

        -- the game's own handler sends Finish Tutorial once step 10 lands (TutorialHandler.lua:2479-2480), so ours is only the fallback
        if p >= LAST then
            Q.say("Finishing tutorial")
            if D.waitFor(finished, FINISH_WAIT) then
                D.succeeded(key)
                return "Tutorial done", true
            end
            local ok, err = Activities.finishTutorial()
            if (ok or err == Activities.Errors.ALREADY_DONE) and D.waitFor(finished, FINISH_WAIT) then
                D.succeeded(key)
                return "Tutorial done", true
            end
            if not D.alive() then return "Waiting to respawn", true end
            D.failed(key, "Tutorial needs you")
            return "Finishing tutorial", true
        end

        if p < EX_STEP then return "Tutorial needs you", false end

        if p == EX_STEP and Player.attr("", "TutorialEXUsed") ~= true then
            local ok = castEx(key)
            if not ok then
                if not D.alive() then return "Waiting to respawn", true end
                return "Can't use EX", true
            end
        end

        if p == STATS_STEP and D.tries(key) >= 1 then spendPoint() end

        if p == MERYL_STEP then
            local model, err = D.reachNpc(nil, MERYL, MERYL_AT)
            if not model then
                if err == "died" or not D.alive() then return "Waiting to respawn", true end
                D.failed(key, "Can't reach Meryl")
                return "Can't reach Meryl", true
            end
        end

        Q.say("Finishing tutorial")
        local sent, err = Activities.tutorialProgress(p + 1)
        if (sent or finished()) and D.waitFor(function() return progress() > p or finished() end, PROGRESS_WAIT) then
            D.succeeded(key)
            return "Finishing tutorial", true
        end
        if not D.alive() then return "Waiting to respawn", true end
        Q.log("tutorial step %d refused: %s", p + 1, tostring(err))
        D.failed(key, "Tutorial needs you")
        return "Finishing tutorial", true
    end

    return T
end

end)
