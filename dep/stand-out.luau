local Highway = {}

-- live 2026-11-18: Vehicles.lua drops every drive input while the roblox window isn't focused (inputBlocked: WindowFocusReleased sets its flag, WindowFocused
-- clears it); with the window in the background the chase car sat still and the swarm caught it, so the focus event is fired again while we drive
local FOCUS_EVERY = 0.5

-- live 2026-11-18: the tunnel door's prompt wakes once you're near it, and the room behind the wall once you're about 30 studs past it (the tunnel runs along X, its wall door faces Z)
local DOOR_FRONT = 8
local DOOR_BEHIND = 40
local TRAVEL_EVERY = 3
local SEAT_SIDE = 4
-- facing +X, steering right moves toward +Z; aim back at the lane, damped by the heading
local LANE_GAIN = 1 / 12
-- live 2026-11-18: at 3 a lane change overshot the lane by 5 studs into the next one's traffic
local HEADING_GAIN = 4
local DRIVE_BIND = "CerberusHighwayDrive"
-- farther than this from the lane, the car has been moved and the lane is taken again
local LANE_RELATCH = 60

-- live 2026-11-18: the chase road has three lanes 16 studs apart around the chase Origin's Z, and its traffic (Game.Vehicles with HighwayRaid = the raid id) drives at us
-- at about 45 studs/s while we do about 60; every hit shrinks the gap to the swarm and a few swarm catches end the raid
-- live 2026-11-18: the guard rails sit about 23 studs out, and every "Watch the road!" crash (Crash Id=0, Gap=120) had the car at +15 or -18, so ours are pulled in
local LANES = { -13, 0, 13 }
-- a car this close to a lane's line blocks it (two cars are about 9 wide; at 7 the hits came head-on, 1-5 studs off); looking this far ahead, and a lane change has
-- to win by this much room
local LANE_HALF = 10
local LOOK = 240
local SWITCH_MARGIN = 40
-- one lane over at a time, or two when the lane between has this much room to cross through (live 2026-11-18: with the middle taken and the far lane clear,
-- one lane at a time left the car in its outer lane until an oncoming car or a swerver hit it, five of seven hits)
local LANE_STEP = 14
local CROSS_ROOM = 120
-- live 2026-11-18: a pothole only slows the car (Bump, Slow=0.45), it never counts as a crash; fed in as stopped cars they kept the car swerving into traffic, so their
-- room only weighs this much against a car's
local HOLE_WEIGHT = 0.25
-- live 2026-11-18: re-picking every frame swept the car across the road (-17 to +15 in a second) into traffic; a new lane waits until we're within this of the
-- old one, unless the car ahead in it is closer than this
local SETTLED = 4
local URGENT_ROOM = 90
-- a swerver's sideways drift is followed for at most this long
local DRIFT_FOR = 1.5

-- live 2026-11-18: after a traffic hit the car sat still for 8 s (x -2677 to -2674) while the swarm caught it three times; stopped this long it backs off for a beat,
-- and lying on its side this long it's set back on its wheels
local STUCK_SPEED = 6
local STUCK_AFTER = 0.8
local REVERSE_FOR = 0.7
local FLIPPED_UP = 0.3
local FLIPPED_AFTER = 0.5

local function lower(s) return type(s) == "string" and string.lower(s) or "" end

-- plain: the recovery to make this frame; state holds the timers, now the clock, vx our forward speed, upY the car's up-vector Y; "drive", "reverse" or "upright"
function Highway.recover(state, now, vx, upY)
    if upY < FLIPPED_UP then
        state.flippedAt = state.flippedAt or now
        if now - state.flippedAt >= FLIPPED_AFTER then
            state.flippedAt = nil
            return "upright"
        end
    else
        state.flippedAt = nil
    end
    if state.reverseUntil then
        if now < state.reverseUntil then return "reverse" end
        state.reverseUntil, state.slowAt = nil, nil
    end
    -- the chase starts from a standstill; a stop only counts once the car has got going
    if vx > 30 then state.moving = true end
    -- live 2026-11-18: a hit bounces the car back at up to -72 studs/s; counted as stuck it reversed on top of the bounce and lost about a second to the swarm,
    -- so only a car that's actually still has stalled
    if math.abs(vx) < STUCK_SPEED and state.moving then
        state.slowAt = state.slowAt or now
        if now - state.slowAt >= STUCK_AFTER then
            state.reverseUntil = now + REVERSE_FOR
            return "reverse"
        end
    else
        state.slowAt = nil
    end
    return "drive"
end

-- plain: room (studs ahead) left in a lane at z, given traffic { x, z, vx, vz, lo?, hi? } and us { x, vx }; a swerver's lo..hi band blocks every lane in it
function Highway.laneRoom(z, traffic, me)
    local room = LOOK
    for _, t in ipairs(traffic) do
        local dx = t.x - me.x
        if dx > -10 and dx < LOOK then
            local closing = math.max(1, me.vx - t.vx)
            local at = math.min(DRIFT_FOR, math.max(0, dx) / closing)
            local blocked = math.abs(t.z + t.vz * at - z) < LANE_HALF
            if t.lo and z > t.lo - LANE_HALF and z < t.hi + LANE_HALF then blocked = true end
            if blocked then room = math.min(room, math.max(0, dx)) end
        end
    end
    return room
end

-- live 2026-11-18 (tracks from hw_traffic.lua): swervers weave between the middle lane and one outer lane at 15-20 studs/s sideways, turning back about every
-- second, so a straight-line guess caught them heading the wrong way; a car seen moving sideways this much is a swerver, and its band spans the middle and its side
local SWERVE_SPAN = 5
local OUTER = 16
local SWERVE_WINDOW = 2
local SWERVE_HEADING = 0.5
-- a car that moved this far between two looks was put somewhere new
local JUMP = 40

-- plain: a swerver's band (lo, hi) around the road centre, from the range of z it has been seen at and its sideways speed; nil when it holds its lane
function Highway.swerveBand(center, zmin, zmax, z, vz)
    -- live 2026-11-19: a 1-stud wobble over 0.1 s read as 10 studs/s sideways and flagged a straight car, whose band then blocked our clear lane; only the span counts
    if zmax - zmin < SWERVE_SPAN then return nil end
    local lo, hi = math.min(zmin, z + vz, center), math.max(zmax, z + vz, center)
    if lo < center - SWERVE_SPAN then lo = math.min(lo, center - OUTER) end
    if hi > center + SWERVE_SPAN then hi = math.max(hi, center + OUTER) end
    return lo, hi
end

-- plain: a lane's score, the room before traffic plus a little for the room before a pothole
local function laneScore(z, traffic, me, holes)
    return Highway.laneRoom(z, traffic, me) + (holes and HOLE_WEIGHT * Highway.laneRoom(z, holes, me) or 0)
end

-- plain: whether a lane change to picked may start now; z is where the car is, room the room left in the current lane
function Highway.mayChange(current, picked, z, room)
    if picked == current or not current then return true end
    return math.abs(z - current) <= SETTLED or room < URGENT_ROOM
end

-- plain: the lane z to hold; the current one unless another has clearly more room; holes (optional) are potholes, which only nudge the choice
function Highway.pickLane(lanes, current, traffic, me, holes)
    local full = LOOK + (holes and HOLE_WEIGHT * LOOK or 0)
    local currentRoom = current and laneScore(current, traffic, me, holes) or -1
    if currentRoom >= full then return current end
    local best, bestRoom = current, currentRoom
    for _, z in ipairs(lanes) do
        local between = current and (z + current) / 2
        if not current or math.abs(z - current) <= LANE_STEP or Highway.laneRoom(between, traffic, me) >= CROSS_ROOM then
            local room = laneScore(z, traffic, me, holes)
            if room > bestRoom then best, bestRoom = z, room end
        end
    end
    if best ~= current and bestRoom < currentRoom + SWITCH_MARGIN then return current end
    return best
end

-- live 2026-11-19 (user: predict longer routes): the one-step picker only looked 240 studs (1.8 s at 135 closing) and judged lanes one at a time, so it waited out
-- traps (cars side by side in two lanes) and crossed a lane with too little room; the planner predicts every car PLAN_HORIZON seconds ahead and searches lane
-- sequences (stay, or one lane over taking CHANGE_TIME, both lanes clear meanwhile) for the one that survives longest, then has the fewest changes and holes
local PLAN_HORIZON = 3
local PLAN_STEP = 0.1
local CHANGE_TIME = 0.5
-- a car this close along the road at the same moment is a hit; a hole this close is driven over
local CAR_REACH = 16
local HOLE_REACH = 6
-- one clean change (0.2) beats a hole (about 0.3), two changes to duck one don't
local CHANGE_COST = 0.2
-- charged per planning step spent on a hole; at 90 studs/s one hole covers about two steps, so about 0.3 a hole
local HOLE_COST = 0.15

-- plain: a swerver's z after t seconds, moving at vz and turning back at the edges of its band lo..hi
function Highway.bounce(z, vz, lo, hi, t)
    local span = hi - lo
    if span <= 0 then return z end
    local p = (math.clamp(z, lo, hi) - lo + vz * t) % (2 * span)
    if p > span then p = 2 * span - p end
    return lo + p
end

-- plain: true when the lane at z holds one of things at t seconds from now, given us { x, vx }; reach is how close along the road counts
function Highway.occupied(z, t, things, me, reach)
    local ourX = me.x + me.vx * t
    for _, c in ipairs(things) do
        local dx = c.x + c.vx * t - ourX
        if dx > -reach and dx < reach then
            -- live 2026-11-19: a swerver's whole band, blocked for the full horizon, boxed us in front of an oncoming car while the swerver was already
            -- heading for the far lane; it's followed along its path instead
            local cz = c.lo and Highway.bounce(c.z, c.vz, c.lo, c.hi, t) or c.z + c.vz * math.min(t, DRIFT_FOR)
            if math.abs(cz - z) < LANE_HALF then return true end
        end
    end
    return false
end

-- plain: (lane z to head for, seconds survived) from a search over lane sequences; current is the lane we hold, holes (optional) only cost
function Highway.plan(lanes, current, traffic, me, holes)
    local n = math.floor(PLAN_HORIZON / PLAN_STEP + 0.5)
    local change = math.max(1, math.floor(CHANGE_TIME / PLAN_STEP + 0.5))
    local start, gap = 1, math.huge
    for i, z in ipairs(lanes) do
        if math.abs(z - current) < gap then start, gap = i, math.abs(z - current) end
    end
    -- only what we can meet inside the horizon is checked each step (the road holds about 280 holes)
    local function reachable(list, reach)
        local out = {}
        for _, c in ipairs(list or {}) do
            local closing = me.vx - c.vx
            local dx = c.x - me.x
            if dx > -reach and dx - math.max(0, closing) * PLAN_HORIZON < reach then out[#out + 1] = c end
        end
        return out
    end
    traffic, holes = reachable(traffic, CAR_REACH), holes and reachable(holes, HOLE_REACH) or nil
    local occ, pot = {}, {}
    for i, z in ipairs(lanes) do
        occ[i], pot[i] = {}, {}
        for k = 0, n do
            occ[i][k] = Highway.occupied(z, k * PLAN_STEP, traffic, me, CAR_REACH)
            pot[i][k] = holes and Highway.occupied(z, k * PLAN_STEP, holes, me, HOLE_REACH) or false
        end
    end
    local memo = {}
    -- (steps survived, cost, first lane moved to or nil)
    local function best(i, k)
        if k > n then return n, 0, nil end
        if occ[i][k] then return k, 0, nil end
        local key = i * 1000 + k
        local hit = memo[key]
        if hit then return hit[1], hit[2], hit[3] end
        local here = pot[i][k] and HOLE_COST or 0
        local bs, bc = best(i, k + 1)
        bc = bc + here
        local bfirst = nil
        for j = i - 1, i + 1, 2 do
            if lanes[j] then
                local s, c = nil, 0
                for m = k, math.min(n, k + change - 1) do
                    if occ[i][m] or occ[j][m] then s = m break end
                    if pot[j][m] then c = c + HOLE_COST end
                end
                if not s then
                    local s2, c2 = best(j, k + change)
                    -- a change costs more the later it comes, so a move the plan needs anyway is made now rather than at the last moment
                    s, c = s2, c + c2 + CHANGE_COST * (1 + k / n)
                end
                if s > bs or (s == bs and c + here < bc) then bs, bc, bfirst = s, c + here, j end
            end
        end
        memo[key] = { bs, bc, bfirst }
        return bs, bc, bfirst
    end
    local survived, _, first = best(start, 0)
    return lanes[first or start], survived * PLAN_STEP
end

function Highway.new(d)
    local World, References = d.World, d.References
    local Workspace, RunService = d.Services.Workspace, d.Services.RunService
    local H = {}
    local bound, laneZ, centerZ, chaseLane, raidId, travelAt = false, nil, nil, nil, nil, -math.huge
    local recovery = {}

    local function raidRoot(st)
        local gameRoot = Workspace:FindFirstChild("Game")
        local map = gameRoot and gameRoot:FindFirstChild("Map")
        return map and map:FindFirstChild("HighwayStarRaid_" .. tostring(st.Id)) or nil
    end

    -- live 2026-11-18: the door swings 88 degrees when it opens, so its own facing can't say which way is through; the tunnel side is the side the raid's spawn is on
    local function wallSide(st, door)
        local root = raidRoot(st)
        local spawn = nil
        for _, c in ipairs(root and root:GetChildren() or {}) do
            if c:IsA("SpawnLocation") then spawn = c end
        end
        if not spawn then return nil end
        local away = door.Position - spawn.Position
        away = Vector3.new(0, 0, away.Z)
        if away.Magnitude < 1e-3 then return nil end
        return away.Unit
    end

    local function tunnelDoor(st)
        local root = raidRoot(st)
        local tunnel = root and root:FindFirstChild("Tunnel")
        for _, p in ipairs(tunnel and tunnel:GetDescendants() or {}) do
            if p:IsA("ProximityPrompt") and p.Parent and p.Parent:IsA("BasePart") then return p, p.Parent end
        end
        return nil
    end

    -- Highway.lua:565-576 findCar
    local function chaseCar(st)
        local gameRoot = Workspace:FindFirstChild("Game")
        local vehicles = gameRoot and gameRoot:FindFirstChild("Vehicles")
        for _, car in ipairs(vehicles and vehicles:GetChildren() or {}) do
            if car:GetAttribute("HighwayRaidCar") == tostring(st.Id) then return car end
        end
        return nil
    end

    local function drivingSeat()
        local hum = References.humanoid
        local seat = hum and hum.SeatPart
        if not (seat and seat:IsA("VehicleSeat")) then return nil end
        local car = seat:FindFirstAncestorWhichIsA("Model")
        while car and not car:GetAttribute("HighwayRaidCar") do car = car.Parent and car.Parent:FindFirstAncestorWhichIsA("Model") end
        return car and seat or nil, car
    end

    -- per car: the z range it has been seen at and its last position, so sideways speed comes from movement (a replicated velocity can read zero)
    local seen = setmetatable({}, { __mode = "k" })
    local function traffic(own, center)
        local gameRoot = Workspace:FindFirstChild("Game")
        local vehicles = gameRoot and gameRoot:FindFirstChild("Vehicles")
        local out = {}
        local now = os.clock()
        for _, car in ipairs(vehicles and vehicles:GetChildren() or {}) do
            -- live 2026-11-18: matched on == raidId the picker saw no traffic at all (it steered into oncoming cars); a raid server holds one raid, so any tagged car is ours
            if car ~= own and car:GetAttribute("HighwayRaid") ~= nil then
                local part = car.PrimaryPart
                if part then
                    local pos, v = part.Position, part.AssemblyLinearVelocity
                    local h = seen[car]
                    -- live 2026-11-18: traffic cars are reused (moved back up the road), so a lifetime z range covered the whole road and every car read as a
                    -- swerver blocking every lane; a car that jumps starts a fresh history, and the range only covers the last SWERVE_WINDOW seconds
                    if h and (math.abs(pos.X - h.x) > JUMP or math.abs(pos.Z - h.z) > JUMP) then h = nil end
                    if not h then
                        h = { x = pos.X, z = pos.Z, at = now, vx = v.X, vz = v.Z, samples = {} }
                        seen[car] = h
                    elseif now - h.at >= 0.1 then
                        local dt = now - h.at
                        h.vx, h.vz = (pos.X - h.x) / dt, (pos.Z - h.z) / dt
                        h.x, h.z, h.at = pos.X, pos.Z, now
                    end
                    local samples = h.samples
                    samples[#samples + 1] = { now, pos.Z }
                    while samples[1] and now - samples[1][1] > SWERVE_WINDOW do table.remove(samples, 1) end
                    local zmin, zmax = pos.Z, pos.Z
                    for _, sample in ipairs(samples) do zmin, zmax = math.min(zmin, sample[2]), math.max(zmax, sample[2]) end
                    -- sideways speed over the whole window, so a stud of wobble between two looks isn't read as a lane change
                    local first = samples[1]
                    if first and now - first[1] >= 0.3 then h.vz = (pos.Z - first[2]) / (now - first[1]) else h.vz = 0 end
                    -- a swerver turns about every second, so its heading comes from the last half second only
                    local recent = nil
                    for _, sample in ipairs(samples) do
                        if now - sample[1] <= SWERVE_HEADING then recent = sample break end
                    end
                    local heading = (recent and now - recent[1] >= 0.15) and (pos.Z - recent[2]) / (now - recent[1]) or h.vz
                    local entry = { x = pos.X, z = pos.Z, vx = h.vx, vz = h.vz }
                    if center then
                        entry.lo, entry.hi = Highway.swerveBand(center, zmin, zmax, pos.Z, h.vz)
                        if entry.lo then entry.vz = heading end
                    end
                    out[#out + 1] = entry
                end
            end
        end
        return out
    end

    -- the road's PotHoles folder: about 280 non-colliding Hole pads (5-8 studs) and Rubble in clusters across the lanes; each Hole slows the car (Bump)
    local holes, holesFrom = {}, nil
    local function potholes()
        local root = raidId and raidRoot({ Id = raidId })
        local props = root and root:FindFirstChild("Props")
        local road = props and props:FindFirstChild("ChaseRoad")
        local folder = road and road:FindFirstChild("PotHoles")
        if folder ~= holesFrom then
            holesFrom, holes = folder, {}
            for _, part in ipairs(folder and folder:GetChildren() or {}) do
                if part.Name == "Hole" and part:IsA("BasePart") then holes[#holes + 1] = { x = part.Position.X, z = part.Position.Z, vx = 0, vz = 0 } end
            end
        end
        return holes
    end

    local focusAt = -math.huge
    local function keepFocus()
        if os.clock() - focusAt < FOCUS_EVERY then return end
        focusAt = os.clock()
        local uis = d.Services.UserInputService
        if uis then Executor.call("firesignal", uis.WindowFocused) end
    end

    local function drive()
        local seat, car = drivingSeat()
        if not seat then return end
        keepFocus()
        local root = car.PrimaryPart or seat
        local cf = root.CFrame
        -- live 2026-11-18: the car is sat in at the tunnel and then moved to the chase road; a lane taken there steered it into the verge for good
        if not centerZ or math.abs(centerZ - cf.Position.Z) > LANE_RELATCH then
            centerZ = chaseLane or cf.Position.Z
            laneZ = centerZ
        end
        local lanes = {}
        for i, off in ipairs(LANES) do lanes[i] = centerZ + off end
        local hazards = traffic(car, centerZ)
        local vx = root.AssemblyLinearVelocity.X
        local me = { x = cf.Position.X, vx = math.max(vx, 40) }
        -- live 2026-11-19: planned from the lane we were steering for, half a change already counted as done, so it planned the next change from there and swept
        -- across two lanes into traffic; the plan starts from the lane the car is actually in
        local picked = Highway.plan(lanes, cf.Position.Z, hazards, me, potholes())
        if Highway.mayChange(laneZ, picked, cf.Position.Z, Highway.laneRoom(laneZ, hazards, me)) then laneZ = picked end
        local steer = math.clamp((laneZ - cf.Position.Z) * LANE_GAIN - cf.LookVector.Z * HEADING_GAIN, -1, 1)
        local action = Highway.recover(recovery, os.clock(), vx, cf.UpVector.Y)
        if action == "upright" then
            -- we drive it (DriverUserId), so its frame is ours to set: back on its wheels, facing down the road, where it lay
            pcall(function() car:PivotTo(CFrame.new(cf.Position + Vector3.new(0, 3, 0), cf.Position + Vector3.new(10, 3, 0))) end)
            return
        elseif action == "reverse" then
            -- backing off the car we're wedged on; steering reversed so the nose swings toward the open lane
            local other = nil
            for _, z in ipairs(lanes) do
                if z ~= laneZ and math.abs(z - laneZ) <= LANE_STEP and (not other or Highway.laneRoom(z, hazards, { x = cf.Position.X, vx = 40 }) > Highway.laneRoom(other, hazards, { x = cf.Position.X, vx = 40 })) then other = z end
            end
            if other then laneZ = other end
            seat.ThrottleFloat = -1
            seat.SteerFloat = -math.clamp((laneZ - cf.Position.Z) * LANE_GAIN, -1, 1)
            return
        end
        seat.ThrottleFloat = 1
        seat.SteerFloat = steer
    end

    function H.stop()
        if bound then
            bound = false
            pcall(RunService.UnbindFromRenderStep, RunService, DRIVE_BIND)
        end
        laneZ, centerZ = nil, nil
        recovery = {}
    end

    local function travel(spot)
        if os.clock() - travelAt < TRAVEL_EVERY then return end
        travelAt = os.clock()
        World.travelTo(spot, { token = d.token() })
    end

    -- plain: true while it acted on a highway star stage this tick
    function H.step(st)
        if st.Raid ~= "HighwayStar" then return false end
        raidId = tostring(st.Id)
        -- Highway.lua:881-939: the state's Chase carries the road's Origin; its Z is the lane
        local chase = type(st.Chase) == "table" and st.Chase or nil
        local origin = chase and chase.Origin
        local okZ, z = pcall(function() return origin.Z end)
        chaseLane = okZ and tonumber(z) or nil
        if drivingSeat() then
            if not bound then
                bound = true
                -- live 2026-11-18: the seat's input is rewritten by the player module every render step and sent at PreSimulation; ours has to land after the module's, and Scheduler's render lane has no ordering against it
                RunService:BindToRenderStep(DRIVE_BIND, Enum.RenderPriority.Last.Value, drive) -- scheduler:allow (runs after the player module's vehicle controller)
            end
            d.say("Driving away")
            return true
        end
        H.stop()
        local objective = lower(st.Objective)
        if string.find(objective, "search the tunnel", 1, true) then
            local prompt, door = tunnelDoor(st)
            if not prompt or prompt.Enabled then return false end
            local through = wallSide(st, door)
            if not through then return false end
            d.say("Searching the tunnel")
            travel(door.Position - through * DOOR_FRONT)
            return true
        elseif string.find(objective, "behind the tunnel wall", 1, true) then
            local prompt, door = tunnelDoor(st)
            local through = door and wallSide(st, door)
            if not through then return false end
            -- live 2026-11-18: nearing the door moves the objective on but leaves it shut; it has to be opened before the room behind counts
            if prompt.Enabled then
                d.say("Opening the tunnel door")
                local spot = door.Position - through * DOOR_FRONT
                local from = d.myPosition()
                if not from or (from - spot).Magnitude > prompt.MaxActivationDistance - 2 then
                    travelAt = -math.huge
                    travel(spot)
                else
                    World.firePrompt(prompt)
                    -- the walk through follows at once
                    travelAt = -math.huge
                end
                return true
            end
            d.say("Going through the wall")
            travel(door.Position + through * DOOR_BEHIND)
            return true
        elseif string.find(objective, "car", 1, true) and not string.find(objective, "fight", 1, true) then
            local car = chaseCar(st)
            local seat = car and car:FindFirstChild("DriverSeat", true)
            local prompt = seat and seat:FindFirstChildWhichIsA("ProximityPrompt", true)
            if not prompt then return false end
            d.say("Getting in the car")
            local from = d.myPosition()
            local spot = seat.Position - seat.CFrame.RightVector * SEAT_SIDE
            if not from or (from - spot).Magnitude > prompt.MaxActivationDistance - 2 then
                travelAt = -math.huge
                travel(spot)
                return true
            end
            if prompt.Enabled then World.firePrompt(prompt) end
            return true
        end
        return false
    end

    return H
end

return Highway

end)
__bundle_register("Features/Auto/Lockpick", function(require, _LOADED, __bundle_register, __bundle_modules)
-- lockpick: plays the game's lockpicking (QTE.Lockpicking.lua) to its hidden sweet spot; a partial turn's allowance maps back to its distance from the spot (Lockpicking.lua Allowance), so two or three turns pin it; a stepper the caller ticks, which lets go of every partial turn at once so no pick strains
local Lock = {}

-- ReplicatedStorage.Modules.Lockpicking.lua: PickRange, MinAllowance, MaxPartial and the difficulty table
local PICK_RANGE = 90
local MIN_ALLOWANCE = 0.06
local MAX_PARTIAL = 0.92
local DIFFICULTIES = {
    Novice = { Window = 18, Partial = 75 }, Apprentice = { Window = 13, Partial = 62 }, Adept = { Window = 9, Partial = 52 },
    Expert = { Window = 6, Partial = 42 }, Master = { Window = 4, Partial = 34 },
}
-- RandomSweet keeps the spot this far inside the range
local SWEET_MARGIN = 6
-- a reading matches a candidate spot within this much allowance
local MATCH = 0.02
local REPLY_WAIT = 1
local HOLD_WAIT = 2.5
-- a fresh probe when the readings contradict every spot
local SWEEP = { 0, -45, 45, -70, 70, -20, 20 }

function Lock.difficulty(name)
    return DIFFICULTIES[name] or DIFFICULTIES.Apprentice
end

-- Lockpicking.lua Allowance: full inside the window, then falling off over Partial degrees
function Lock.allowance(distance, diff)
    if distance <= diff.Window then return 1 end
    local raw = 1 - (distance - diff.Window) / diff.Partial
    return math.clamp(raw * MAX_PARTIAL, MIN_ALLOWANCE, MAX_PARTIAL)
end

local function consistent(spot, readings, diff)
    for _, r in ipairs(readings) do
        local predicted = Lock.allowance(math.abs(spot - r.angle), diff)
        if r.allowance <= MIN_ALLOWANCE + 1e-6 then
            if predicted > MIN_ALLOWANCE + MATCH then return false end
        elseif math.abs(predicted - r.allowance) > MATCH then
            return false
        end
    end
    return true
end

-- plain: the next angle worth turning at, given every { angle, allowance } read so far
function Lock.nextAngle(readings, diff)
    if #readings == 0 then return 0 end
    local bound = PICK_RANGE - diff.Window - SWEET_MARGIN
    -- runs of whole-degree spots every reading agrees with; the first run's middle is turned next
    local runs, run = {}, nil
    for spot = -bound, bound do
        if consistent(spot, readings, diff) then
            if run and run.last == spot - 1 then
                run.last = spot
            else
                run = { first = spot, last = spot }
                runs[#runs + 1] = run
            end
        end
    end
    local tried = {}
    for _, r in ipairs(readings) do tried[math.floor(r.angle + 0.5)] = true end
    for _, r in ipairs(runs) do
        local mid = math.floor((r.first + r.last) / 2 + 0.5)
        if not tried[mid] then return mid end
    end
    for _, angle in ipairs(SWEEP) do
        if not tried[angle] then return angle end
    end
    return 0
end

-- a stepper over Activities' lockpick verbs; tick() answers true while a session is being played
function Lock.new(Activities)
    local L = { readings = {}, id = nil, phase = "idle", at = 0, angle = nil }

    -- live 2026-11-18: a session whose End push was missed read as live forever and the raid "picked the lock" while taking 139 damage;
    -- past its own Expires (server time) it's over
    local function live()
        local ok, s = Activities.lockpick()
        if not (ok and type(s) == "table") or s.ended then return nil end
        local expires = tonumber(s.expires)
        if expires and workspace:GetServerTimeNow() > expires then return nil end
        return s
    end

    function L.active()
        return live() ~= nil
    end

    function L.tick()
        local s = live()
        if not s then
            L.id, L.phase = nil, "idle"
            return false
        end
        if s.id ~= L.id then
            L.id, L.readings, L.phase = s.id, {}, "idle"
        end
        local diff = Lock.difficulty(s.config and s.config.Difficulty)
        local now = os.clock()
        if L.phase == "idle" then
            local angle = Lock.nextAngle(L.readings, diff)
            local ok = Activities.lockpickTurn(s.id, angle)
            if ok then L.phase, L.at, L.angle = "turning", now, angle end
        elseif L.phase == "turning" then
            if s.allowance ~= nil then
                if s.allowance >= 0.999 then
                    L.phase, L.at = "holding", now
                else
                    L.readings[#L.readings + 1] = { angle = L.angle, allowance = s.allowance }
                    Activities.lockpickRelease(s.id)
                    L.phase = "idle"
                end
            elseif now - L.at > REPLY_WAIT or not s.turning then
                -- no reading (a broken pick ends the turn): try the same spot again
                if s.turning then Activities.lockpickRelease(s.id) end
                L.phase = "idle"
            end
        elseif L.phase == "holding" then
            if now - L.at > HOLD_WAIT or not s.turning then
                if s.turning then Activities.lockpickRelease(s.id) end
                L.phase = "idle"
            end
        end
        return true
    end

    return L
end

return Lock

end)
__bundle_register("Utility/GameHud", function(require, _LOADED, __bundle_register, __bundle_modules)
-- game hud: puts the game's MainHUD (hp, moves, money) back after we force-close its dialogue; the dialogue fades the hud out on open and only its own close fades it back (DialogueHandler.lua:355-405, 496-513), which disabling the Dialogue gui skips
local Identity = require("Utility/Identity")

local M = {}

-- plain: what a hud panel's transparency should return to; the game keeps a skill-driven target on the panel, else it's fully shown
function M.target(group)
    local wanted = group:GetAttribute("SkillVisibilityTarget")
    if type(wanted) == "number" then return wanted end
    return 0
end

-- true when the hud was hidden and has been shown again
function M.restore(player)
    local gui = player and player:FindFirstChild("PlayerGui")
    local hud = gui and gui:FindFirstChild("MainHUD")
    if not (hud and hud:IsA("ScreenGui")) then return false end
    Identity.elevate()
    local changed = false
    pcall(function()
        if not hud.Enabled then
            hud.Enabled = true
            changed = true
        end
        for _, child in ipairs(hud:GetChildren()) do
            if child:IsA("CanvasGroup") and child.GroupTransparency > 0.99 then
                child.GroupTransparency = M.target(child)
                changed = true
            end
        end
    end)
    return changed
end

-- the dialogue's fade-out runs 0.6 s, so a close mid-fade is restored again once it has finished
local FADE = 0.7
function M.restoreAfterClose(player)
    M.restore(player)
    task.delay(FADE, function() M.restore(player) end) -- leak:allow a one-shot re-show that neither loops nor waits again
end

return M

end)
__bundle_register("Features/Auto/Keys", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto keys: answers the game's key-sequence prompts (QTE.lua sessions: Hamon's breathing and glass, raid struggles, story prompts) through Activities.qte / qteInput, keys sent in order a short gap apart without waiting for each answer; shared by Auto Hamon and Auto Raid
local Keys = {}

-- the first key goes this long after a prompt shows, then one every GAP, at most AHEAD past what the server has confirmed; with no progress for
-- RESYNC the count falls back to the server's (live 2026-11-22: a key per round trip, ~0.5 s, ran Caesar's 5-key seventh wave out of time)
Keys.REACT = 0.15
Keys.GAP = 0.18
Keys.AHEAD = 3
Keys.RESYNC = 1
Keys.TICK = 0.03

-- one sender at a time: two loops each sending the next key would double it, and a doubled key reads as a miss
local owner = nil

-- runs until the job dies or `wanted()` says stop
function Keys.loop(j, Activities, wanted)
    local session, sent, sentAt, progress, progressAt = nil, 0, 0, 0, 0
    while j.alive and wanted() do
