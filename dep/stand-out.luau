__bundle_register("Api/Activities/Bounties", function(require, _LOADED, __bundle_register, __bundle_modules)
-- activities bounties: petyr's board generated by the game's own Bounty module, the accept/claim/incident/call verbs with the board's own gates, and the phone's player-bounty state held from its push
local BOARD_GATE = "P9_32_RETURN_TO_IKO_IKO"

return function(S)
    local Errors     = S.Errors
    local Net        = S.Net
    local Player     = S.Player
    local References = S.References
    local base       = S.base

    local bountyCall = base.signal()
    local playerBountyChanged = base.signal()

    local call          -- BountyHandler.lua:1606-1611: the last "Call" {Id, Token, Config}
    local playerState   -- PlayerBountiesApp.lua:1182-1189: the last pushed state table

    local function need()
        local stop = S.need()
        if stop then return nil, stop end
        local B = S.module("Bounty")
        if not B then return nil, Errors.NO_MODULE end
        return B
    end

    local function level()
        return tonumber(Player.value("Stats.Level")) or 0
    end

    local function decodedList(path)
        local list = Player.json(path)
        return type(list) == "table" and list or {}
    end

    local function contains(list, value)
        for _, v in ipairs(list) do
            if v == value then return true end
        end
        return false
    end

    -- BountyHandler.lua:1559-1562: (serverNow, selected tier, level); the selector never goes past the unlocked tier (:1708)
    local function board(B, tier)
        local unlocked = B.GetUnlockedTier(level())
        tier = tier or unlocked
        if type(tier) ~= "number" or tier % 1 ~= 0 or tier < 1 or tier > unlocked then return nil, Errors.LOCKED end
        local ok, list = pcall(B.GetCurrentBounties, math.floor(S.now()), tier, B.GetPlayerLevel(References.player))
