            if arg2 ~= nil then return false, Errors.BAD_ARGS end
            -- DialogueInfo.lua:1625-1630 sends an explicit nil third argument
            return Net.fire("Quest", name, arg, nil)
        end
        if name == "Major Tom" and arg == "Survey" then
            -- ClientSideQuests.lua:806-826: once per npc while the stage is Surveys
            if attr("MajorTomStage") ~= "Surveys" then return false, Errors.NOT_AVAILABLE end
            if not SURVEYED[arg2] then return false, Errors.BAD_ARGS end
            if contains(splitCsv(attr("MajorTomAsked")), arg2) then return false, Errors.ALREADY_DONE end
            return Net.fire("Quest", name, arg, arg2)
        end
        if arg2 ~= nil then return false, Errors.BAD_ARGS end
        return Net.fire("Quest", name, arg)
    end

    -- TutorialHandler.lua:45: the extra argument is Data's TutorialResetVersion attribute (0 when unset), read once by the handler; it is not a token
    local function resetVersion()
        return tonumber(Player.attr("", "TutorialResetVersion")) or 0
    end

    local function tutorialGate()
        local stop = S.need()
        if stop then return stop end
        if Player.value("Stats.TutorialFinished") == true then return Errors.ALREADY_DONE end
        -- TutorialHandler.lua:50-52 waits for this before it sends anything
        if References.player:GetAttribute("TutorialProgressReady") ~= true then return Errors.NOT_READY end
        return nil
    end

    -- TutorialHandler.lua:2378, 2429, 2440: ("Tutorial Progress", index + 1, resetVersion), always past the saved progress
    local function tutorialProgress(stepNumber)
        local stop = tutorialGate()
        if stop then return false, stop end
        local progress = tonumber(Player.value("Stats.TutorialProgress")) or 0
        local target = stepNumber == nil and progress + 1 or stepNumber
        if type(target) ~= "number" or target % 1 ~= 0 then return false, Errors.BAD_ARGS end
        if target <= progress or target < 2 or target > TUTORIAL_LAST then return false, Errors.OUT_OF_WINDOW end
        return Net.fire("Quest", "Tutorial Progress", target, resetVersion())
    end

    -- TutorialHandler.lua:2479-2480: sent once every step has been passed
    local function finishTutorial()
        local stop = tutorialGate()
        if stop then return false, stop end
        local progress = tonumber(Player.value("Stats.TutorialProgress")) or 0
        if progress < TUTORIAL_LAST then return false, Errors.NOT_AVAILABLE end
        return Net.fire("Quest", "Finish Tutorial", resetVersion())
    end

    -- HandlerQuest.lua:1695-1703 refreshes on these five; a burst in one frame becomes one signal
    local queued = false
    local function changed()
        if queued then return end
        queued = true
        task.defer(function()
            queued = false
            questsChanged:Fire()
        end)
    end
    for _, key in ipairs({ "ActiveQuest", "QuestObjectives", "QuestObjectivesTotal", "TrackedQuest", "DailyQuestState" }) do
        S.track(Player.observe("Stats." .. key, changed))
    end

    -- only a change from a known list counts, so the tree loading in never reads as completions
    S.track(Player.observe("Stats.CompletedQuests", function(value, old)
        if type(value) ~= "string" or type(old) ~= "string" then return end
        local before = {}
        for _, id in ipairs(splitCsv(old)) do before[id] = true end
        for _, id in ipairs(splitCsv(value)) do
            if not before[id] then questCompleted:Fire(id) end
        end
    end))

