    end

    local function step(name, arg, arg2)
        local rule = STEPS[name]
        if rule == nil then return false, Errors.NOT_ALLOWED end
        local stop = S.need()
        if stop then return false, stop end
        if rule == true then
            if arg ~= nil or arg2 ~= nil then return false, Errors.BAD_ARGS end
            return Net.fire("Quest", name)
