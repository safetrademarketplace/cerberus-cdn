    function self.uninstall()
        self.point = nil
        if not wrapper then return end
        if rawget(utility, "getAimRay") == wrapper then utility.getAimRay = original end
        original, wrapper = nil, nil
    end

    function self.installed()
        return wrapper ~= nil
    end

    return self
end

