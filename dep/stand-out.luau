__bundle_register("Api/World/Combatants", function(require, _LOADED, __bundle_register, __bundle_modules)
-- world combatants: the models in workspace.Game.Players plus Damageable-tagged models that aren't your summons, indexed by ChildAdded/ChildRemoved and the tag signals only; every read re-checks Parent so a streamed-out model drops instead of lingering
local TAG = "Damageable"
local FILTER_KEYS = {
    players = "boolean", npcs = "boolean", hostileOnly = "boolean", alive = "boolean",
    maxDistance = "number", name = "string", excludeSelf = "boolean", trackable = "boolean",
}
-- Abilities:IsIdleNPC treats these as never fighting (Abilities.lua:1507)
local IDLE_ATTRS = { "TrainingDummy", "Stand", "StandName", "Vehicle", "SummonFamily", "SummonSkill" }
-- Utility:canTrackTarget drops anyone carrying one of these (Utility.lua:1928-1932)
local HIDDEN_ATTRS = { "Hiding", "HidingInTrash", "UnderWorldBurrowed", "CombatLifeEnded" }

return function(ctx, shared)
    local Services   = ctx.Services
    local References = ctx.References
    local Workspace  = Services.Workspace
    local Players    = Services.Players
    local CS         = Services.CollectionService
    local Errors     = shared.Errors

    local fromFolder, tagged = {}, {}
    local boundFolder = nil
    local folderReleases = {}

    local function myName()
        local player = References.player
        return player and player.Name
    end

    local function releaseFolder()
        for i = #folderReleases, 1, -1 do
            folderReleases[i]()
            folderReleases[i] = nil
        end
    end

    -- the folder is re-resolved on every read, so a Game.Players that appears or is replaced later rebinds
    local function ensureFolder()
        local root = Workspace:FindFirstChild("Game")
        local folder = root and root:FindFirstChild("Players") or nil
        if folder == boundFolder then return folder end
        releaseFolder()
        table.clear(fromFolder)
        boundFolder = folder
        if not folder then return nil end
        folderReleases[#folderReleases + 1] = shared.track(folder.ChildAdded:Connect(function(model)
            if model:IsA("Model") then fromFolder[model] = true end
        end))
        folderReleases[#folderReleases + 1] = shared.track(folder.ChildRemoved:Connect(function(model)
            fromFolder[model] = nil
        end))
        for _, model in ipairs(folder:GetChildren()) do
            if model:IsA("Model") then fromFolder[model] = true end
        end
        return folder
    end

    shared.track(CS:GetInstanceAddedSignal(TAG):Connect(function(model)
        if model:IsA("Model") then tagged[model] = true end
    end))
    shared.track(CS:GetInstanceRemovedSignal(TAG):Connect(function(model) tagged[model] = nil end))
    for _, model in ipairs(CS:GetTagged(TAG)) do
        if model:IsA("Model") then tagged[model] = true end
    end
    ensureFolder()
    shared.own(function()
        releaseFolder()
        table.clear(fromFolder)
        table.clear(tagged)
    end)

    local function myRoot()
        local root = References.humanoidRootPart
        if root and root.Parent then return root end
        return nil
    end

    local function positionOf(model)
        local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
        if root and root:IsA("BasePart") then return root.Position end
        return model:GetPivot().Position
    end

    local function playerOf(model)
        local ok, player = pcall(Players.GetPlayerFromCharacter, Players, model)
        if ok then return player end
        return nil
    end

    -- your own summons are skipped the way partHitDetect skips them (Utility.lua:5924-5929)
    local function isMine(model)
        local name = myName()
        if model.Name == name and model.Parent == boundFolder then return true end
        local summoner = model:FindFirstChild("Summoner")
        local owner = summoner and summoner:IsA("ObjectValue") and summoner.Value
        return owner ~= nil and owner ~= false and owner.Name == name
    end

    -- live 2026-11-18 (user): a knocked-out npc (PassedOut at 0-1 hp) is still finished, so it counts as living until its life ends (CombatLifeEnded or 0 hp);
    -- that moment, not the model's removal seconds later, is when fights and pickers move on
    local function livingOf(model, player, health)
        return model:GetAttribute("CombatLifeEnded") ~= true and health > 0
    end

    local function hostileOf(model, player)
        if player or model.Name == "Dummy" or model:FindFirstChild("Summoner") then return false, nil end
        for _, attr in ipairs(IDLE_ATTRS) do
            if model:GetAttribute(attr) then return false, nil end
        end
        local value = model:FindFirstChild("NPCCombatTarget")
        local target = value and value:IsA("ObjectValue") and value.Value or nil
        return target ~= nil, target
    end

    local function trackableOf(model)
        if model:GetAttribute("BMSABlended") == true then return false end
        for _, attr in ipairs(HIDDEN_ATTRS) do
            if model:GetAttribute(attr) then return false end
        end
        local mine = References.character
        local myMatch = mine and mine:GetAttribute("GangWarMatch")
        local theirMatch = model:GetAttribute("GangWarMatch")
        if (myMatch or theirMatch) and (myMatch ~= theirMatch or mine:GetAttribute("GangWarTeam") == model:GetAttribute("GangWarTeam")) then
            return false
        end
        return true
    end

    local function standOf(who)
        local name = who
        if typeof(who) == "Instance" then name = who.Name end
        if type(name) ~= "string" or name == "" then return false, Errors.BAD_ARGS end
        local root = Workspace:FindFirstChild("Game")
        local stands = root and root:FindFirstChild("Stands")
        local value = stands and stands:FindFirstChild(name)
        local model = value and value:IsA("ObjectValue") and value.Value or nil
        if not (model and model.Parent) then return false, Errors.NOT_FOUND end
        return true, model
    end

    local function info(model)
        if typeof(model) ~= "Instance" or not model:IsA("Model") then return false, Errors.BAD_ARGS end
        if not model.Parent then return false, Errors.GONE end
        local hum = model:FindFirstChildOfClass("Humanoid")
        local health = hum and hum.Health or 0
        local player = playerOf(model)
        local hostile, target = hostileOf(model, player)
        local position = positionOf(model)
        local root = myRoot()
        local ragdoll = model:FindFirstChild("IsRagdoll")
        local hasStand, stand = standOf(model.Name)
        local tier = model:GetAttribute("BountyScaledTier")
        return true, {
            name       = model.Name,
            model      = model,
            isPlayer   = player ~= nil,
            player     = player,
            health     = health,
            maxHealth  = hum and hum.MaxHealth or 0,
            alive      = livingOf(model, player, health),
            hostile    = hostile,
            target     = target,
            stunned    = model:GetAttribute("Stunned") == true,
            passedOut  = model:GetAttribute("PassedOut") == true,
            ragdolled  = model:GetAttribute("Ragdolled") == true or (ragdoll ~= nil and ragdoll:IsA("BoolValue") and ragdoll.Value == true),
            blocking   = model:GetAttribute("ProjectileBlockActive") == true,
            trackable  = trackableOf(model),
            stand      = hasStand and stand or nil,
            position   = position,
            distance   = root and (position - root.Position).Magnitude or nil,
            bountyTier = type(tier) == "number" and tier or nil,
        }
    end

    local function validFilter(filter)
        if filter == nil then return true end
        if type(filter) ~= "table" then return false end
        for key, value in pairs(filter) do
            if FILTER_KEYS[key] == nil or type(value) ~= FILTER_KEYS[key] then return false end
        end
        return true
    end

    local function passes(model, filter, root)
        local player = playerOf(model)
        if filter.players == false and player then return false end
        if filter.npcs == false and not player then return false end
        if filter.name and model.Name ~= filter.name then return false end
        if filter.hostileOnly and not hostileOf(model, player) then return false end
        if filter.alive ~= nil then
            local hum = model:FindFirstChildOfClass("Humanoid")
            local alive = hum ~= nil and livingOf(model, player, hum.Health)
            if alive ~= filter.alive then return false end
        end
        if filter.trackable ~= nil and trackableOf(model) ~= filter.trackable then return false end
        return true
    end

    -- nearest first when you have a root; a model whose Parent went nil is dropped from the index here
    local function collect(filter)
        if not validFilter(filter) then return nil, Errors.BAD_ARGS end
        filter = filter or {}
        ensureFolder()
        local root = myRoot()
        local excludeSelf = filter.excludeSelf ~= false
        local seen, out = {}, {}
        for _, set in ipairs({ fromFolder, tagged }) do
            for model in pairs(set) do
                if not model.Parent then
                    set[model] = nil
                elseif not seen[model] then
                    seen[model] = true
                    local skip = (excludeSelf and isMine(model)) or (set == tagged and not model:IsDescendantOf(Workspace))
                    if not skip and passes(model, filter, root) then
                        local distance = root and (positionOf(model) - root.Position).Magnitude or math.huge
                        if not filter.maxDistance or distance <= filter.maxDistance then
                            out[#out + 1] = { model = model, distance = distance }
                        end
                    end
                end
            end
        end
        table.sort(out, function(a, b) return a.distance < b.distance end)
        return out
    end

    local function combatants(filter)
        local found, err = collect(filter)
        if not found then return false, err end
        local models = {}
        for i, entry in ipairs(found) do models[i] = entry.model end
        return true, models
    end

    local function nearest(filter)
        local found, err = collect(filter)
        if not found then return false, err end
        local first = found[1]
        if not first then return false, Errors.NOT_FOUND end
        return true, first.model, first.distance
    end

    return {
        combatants = combatants,
        nearest    = nearest,
        info       = info,
        standOf    = standOf,
    }
end

end)
__bundle_register("Api/World/Areas", function(require, _LOADED, __bundle_register, __bundle_modules)
-- world areas: the game's AreaTransition box test rebuilt over AreaTransitionZone parts plus workspace.Game.Areas (AreaTransition.lua:363-521, 681-721), with its priority clamp, the 4-stud pad for the area you're in, the 0.4 s commit and the id tie-break; leaving every box keeps the last area, as the game does
local Biomes    = require("Api/World/Biomes")
local Scheduler = require("Utility/Scheduler")

local TAG      = "AreaTransitionZone"
local TICK     = 0.2    -- :716-721
local COMMIT   = 0.4    -- :513
local PAD      = 4      -- :440
local CLAMP    = 10000  -- :413

return function(ctx, shared)
    local Services   = ctx.Services
    local References = ctx.References
    local Workspace  = Services.Workspace
    local CS         = Services.CollectionService
    local base       = shared.base
    local Errors     = shared.Errors

    local areaChanged = base.signal()

    local zones = {}
    local areasFolder = nil
    local folderReleases = {}
    local current, pendingKey, pendingAt, trackedChar = nil, nil, nil, nil

    -- BiomeInformation:getBiomeFromName, in the table's own order
    local function biomeFromName(name)
        if type(name) ~= "string" or name == "" then return nil end
        local lower = string.lower(name)
        for _, biome in ipairs(Biomes) do
            if string.lower(biome.Name) == lower or (biome.Id and string.lower(biome.Id) == lower) then return biome end
            for _, alias in ipairs(biome.Aliases or {}) do
                if string.lower(alias) == lower then return biome end
            end
        end
        return nil
    end

    -- AreaMusicChange.resolveBiome (:783-793)
    local function resolveBiome(part, top)
        for _, inst in ipairs({ part, top }) do
            for _, attr in ipairs({ "BiomeName", "AreaId" }) do
                local biome = biomeFromName(inst:GetAttribute(attr))
                if biome then return biome end
            end
        end
        return biomeFromName(top.Name) or biomeFromName(part.Name)
    end

    -- areaFor (:363-425): attributes from the part, else from its top-level ancestor inside the Areas folder
    local function areaFor(part)
        local top = part
        local inFolder = areasFolder ~= nil and part:IsDescendantOf(areasFolder)
        while inFolder and top.Parent ~= areasFolder do top = top.Parent end
        local function attribute(name)
            local value = part:GetAttribute(name)
            if value == nil and top ~= part then value = top:GetAttribute(name) end
            return value
        end
        if attribute("AreaEnabled") == false then return nil end
        local biome = resolveBiome(part, top)
        local title = attribute("AreaTitle")
        if type(title) ~= "string" or title == "" then
            title = (biome and biome.Name) or (inFolder and top.Name) or nil
        end
        if type(title) ~= "string" or title == "" then return nil end
        local id = attribute("AreaId")
        local subtitle = attribute("AreaSubtitle")
        local priority = attribute("AreaPriority")
        local keySource = (biome and (biome.Id or biome.Name)) or (inFolder and top.Name) or title
        local key = string.lower(tostring(keySource)):gsub("^%s+", ""):gsub("%s+$", "")
        if type(priority) == "number" and priority == priority then
            priority = math.clamp(priority, -CLAMP, CLAMP)
        else
            priority = inFolder and 1 or 0
        end
        return {
            key      = key,
            id       = (type(id) == "string" and id ~= "" and id) or (biome and biome.Id) or top.Name,
            title    = title,
            subtitle = (type(subtitle) == "string" and subtitle) or (biome and biome.Description) or "",
            priority = priority,
            source   = part,
        }
    end

    -- contains (:427-431): an oriented box with an even pad on every axis
    local function contains(part, pos, pad)
        local rel = part.CFrame:PointToObjectSpace(pos)
        local half = part.Size * 0.5 + Vector3.new(pad, pad, pad)
        return math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z
    end

    -- areaAt (:433-447): highest priority wins, a tie goes to the lower id
    local function areaAt(pos)
        local best = nil
        for part in pairs(zones) do
            if part:IsDescendantOf(Workspace) then
                local area = areaFor(part)
                local pad = (area and current and area.key == current.key) and PAD or 0
                if area and contains(part, pos, pad)
                    and (not best or best.priority < area.priority or (area.priority == best.priority and area.id < best.id)) then
                    best = area
                end
            end
        end
        return best
    end

    local function public(area)
        if not area then return nil end
        return { id = area.id, key = area.key, title = area.title, subtitle = area.subtitle, priority = area.priority, source = area.source }
    end

    local function reset()
        local had = current ~= nil
        current, pendingKey, pendingAt = nil, nil, nil
        if had then areaChanged:Fire(nil) end
    end

    local function addZone(part)
        if part:IsA("BasePart") then zones[part] = true end
    end

    local function releaseFolder()
        for i = #folderReleases, 1, -1 do
            folderReleases[i]()
            folderReleases[i] = nil
        end
    end

    -- ConfigureAreas (:559-602): rebinding drops untagged parts of the old folder and resets the current area
    local function bindFolder(folder)
        releaseFolder()
        for part in pairs(zones) do
            if not CS:HasTag(part, TAG) then zones[part] = nil end
        end
        areasFolder = folder
        reset()
        if not folder then return end
        folderReleases[#folderReleases + 1] = shared.track(folder.DescendantAdded:Connect(addZone))
        folderReleases[#folderReleases + 1] = shared.track(folder.DescendantRemoving:Connect(function(inst)
            if not CS:HasTag(inst, TAG) then zones[inst] = nil end
        end))
        for _, inst in ipairs(folder:GetDescendants()) do addZone(inst) end
    end

    local function gameFolder()
        return Workspace:FindFirstChild("Game")
    end

    local function ensureFolder()
        local root = gameFolder()
        local folder = root and root:FindFirstChild("Areas") or nil
        if folder ~= areasFolder then bindFolder(folder) end
    end

    -- tickArea (:449-521) uses the Game.Players model first, else LocalPlayer.Character
    local function myCharacter()
        local root = gameFolder()
        local players = root and root:FindFirstChild("Players")
        local player = References.player
        local model = players and player and players:FindFirstChild(player.Name)
        return model or References.character
    end

    local function tick()
        ensureFolder()
        local char = myCharacter()
        if char ~= trackedChar then
            trackedChar = char
            reset()
        end
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not hum or hum.Health <= 0 or not root then
            reset()
            return
        end
        local now = os.clock()
        local found = areaAt(root.Position)
        if not found then
            pendingKey, pendingAt = nil, nil
        elseif not current or current.key ~= found.key then
            if pendingKey ~= found.key then
                pendingKey, pendingAt = found.key, now
            elseif now - pendingAt >= COMMIT then
                current = found
                pendingKey, pendingAt = nil, nil
                areaChanged:Fire(public(found))
            end
        else
            pendingKey, pendingAt = nil, nil
        end
    end

    shared.track(CS:GetInstanceAddedSignal(TAG):Connect(addZone))
    shared.track(CS:GetInstanceRemovedSignal(TAG):Connect(function(inst)
        if not areasFolder or not inst:IsDescendantOf(areasFolder) then zones[inst] = nil end
    end))
    for _, inst in ipairs(CS:GetTagged(TAG)) do addZone(inst) end
    ensureFolder()
    shared.track(Scheduler.heartbeat(function() base.try("area tick", tick) end, { name = "World.areas", interval = TICK }))
    shared.own(function()
        releaseFolder()
        table.clear(zones)
    end)

    local function currentArea()
        if not current then return false, Errors.NO_AREA end
        return true, public(current)
    end

    -- one record per area key, at the first zone part found for it
    local function areaList()
        ensureFolder()
        local byKey, out = {}, {}
        for part in pairs(zones) do
            if part:IsDescendantOf(Workspace) then
                local area = areaFor(part)
                if area and not byKey[area.key] then
                    byKey[area.key] = true
                    local entry = public(area)
                    entry.position = part.Position
                    out[#out + 1] = entry
                end
            end
        end
        table.sort(out, function(a, b) return a.title < b.title end)
        return out
    end
    shared.areaList = areaList

    return {
        currentArea = currentArea,
        areas       = function() return true, areaList() end,
        areaChanged = areaChanged,
    }
end

end)
