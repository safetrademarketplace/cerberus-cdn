        elseif verb == "Board" then
            held.board = payload
        elseif verb == "Shop" and type(payload) == "table" then
            held.shop = payload
        elseif verb == "Ready" and type(payload) == "table" then
            held.ready = payload
        elseif verb == "Travel" and type(payload) == "table" then
            held.travel = payload
        elseif verb == "TravelFailed" then
            held.travel = nil
        elseif verb == "Results" and type(payload) == "table" then
            held.results = payload
            raidResults:Fire(payload)
        end
        raidMessage:Fire(verb, payload)
    end)

    return {
