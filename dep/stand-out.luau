    CosmeticRoll = { Coins = true },
    Data = { Stats = true, ["Reset Stats"] = true },
    Gardening = { ShopBuy = true, ShopSell = true, ShopSellAll = true },
    HamonTraining = { Purchase = true, StartPath = true },
    Huber = { Call = true },
    Item = { Drop = true, ConfirmUse = true },
    ServerDirectory = { Join = true },
