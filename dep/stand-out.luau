__bundle_register("Features/Auto/ServerIntel/ArrowPlan", function(require, _LOADED, __bundle_register, __bundle_modules)
-- arrow plan: pure arrow-route choices; the best visible drop first (rare arrows ahead of plain ones, then nearest), then the nearest occupied node not yet looked at, with a node seen empty skipped until it frees up; no instances
local M = {}

-- a drop this close to a node belongs to it (live 2026-11-17: a drop lands on its node)
M.NODE_RADIUS = 20
M.MAX_TRIES = 2

local function dist(a, b)
    return (a - b).Magnitude
end

-- each drop gets the id of the node it sits on, and each node learns whether a drop is visible on it
function M.link(nodes, drops)
    for _, node in ipairs(nodes) do node.drop = nil end
    for _, drop in ipairs(drops) do
        local best, bestDistance = nil, M.NODE_RADIUS
        for _, node in ipairs(nodes) do
            local d = dist(node.position, drop.position)
            if d <= bestDistance then best, bestDistance = node, d end
        end
        drop.node = best and best.id or nil
        if best then best.drop = drop end
    end
end

-- a node that freed up may be looked at again next time it fills
function M.forget(state, nodes)
    for _, node in ipairs(nodes) do
        if not node.occupied then
            state.hidden[node.id] = nil
            state.tries[node.id] = nil
        end
    end
end

-- { kind = "drop", drop } or { kind = "node", node } or nil; from is your position
function M.choose(nodes, drops, from, state)
    local best, bestRank, bestDistance = nil, -1, math.huge
    for _, drop in ipairs(drops) do
        if (state.tries[drop.id] or 0) < M.MAX_TRIES then
            local rank = drop.rank or 0
            local d = from and dist(from, drop.position) or 0
            if rank > bestRank or (rank == bestRank and d < bestDistance) then
                best, bestRank, bestDistance = drop, rank, d
            end
        end
    end
    if best then return { kind = "drop", drop = best } end
    local look, lookDistance = nil, math.huge
    for _, node in ipairs(nodes) do
        if node.occupied and not node.drop and not state.hidden[node.id] and (state.tries[node.id] or 0) < M.MAX_TRIES then
            local d = from and dist(from, node.position) or 0
            if d < lookDistance then look, lookDistance = node, d end
        end
    end
    if look then return { kind = "node", node = look } end
    return nil
end

-- pickups in the last hour, the number the cap is measured against
function M.lastHour(times, now)
    local n = 0
    for _, at in ipairs(times) do
        if now - at < 3600 then n = n + 1 end
    end
    return n
end

return M

end)
__bundle_register("Features/Auto/Raid", function(require, _LOADED, __bundle_register, __bundle_modules)
