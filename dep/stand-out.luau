local RAIDS = { Train = 20, HighwayStar = 30, Rings = 40 }   -- TrainRaidClient.Raids.lua:3-47 MinLevel
local DIFFICULTIES = { Regular = true, Hard = true }       -- TrainRaidClient.lua:1085

-- TrainRaidClient.Highway.lua:406, 436, TrainRaidClient.Rings.lua:1651, Core.Climbing.lua:49, 386
local PLAY_ACTIONS = { KnockBegin = true, Knock = true, RingsGuideSeen = true, RingsClimbStart = true, RingsClimbStop = true }

return function(S)
    local Errors     = S.Errors
    local Net        = S.Net
    local Player     = S.Player
    local References = S.References
    local base       = S.base

    local raidMessage = base.signal()
    local raidResults = base.signal()

    local held = { state = nil, board = nil, shop = nil, ready = nil, travel = nil, results = nil }

    -- TrainRaidClient.Donatello.lua:2092-2105 CanRaid, plus the raid's own minimum level
    local function gate(raid)
