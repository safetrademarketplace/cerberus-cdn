local DEFAULT_ROOTS = {
    "NPCs", "QuestInteractables", "QuestZones", "Interactables", "SpawnedItems", "Vehicles", "StoryLocations",
    "StoryActors", "WorldEventDrops", "Gardening", "ArmWrestlingTables", "GoFishTables", "KaraokeStations", "BountySpawns",
}

