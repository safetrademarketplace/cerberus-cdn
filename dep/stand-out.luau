    local Waypoints  = deps.Waypoints
    local categories = deps.categories
    local track      = deps.track

    local function notify(text) UiWrite.notify(Library, text, 4) end

    local Teleports  = Tabs.Travel:AddLeftGroupbox("Teleports", "move-3d")
    local Quick      = Tabs.Travel:AddRightGroupbox("Quick Travel", "zap")
    local Huber      = Tabs.Travel:AddRightGroupbox("Huber", "car")
    local WaypointsBox = Tabs.Travel:AddRightGroupbox("Waypoints Editor", "pencil")

    -- ===== teleports =====

    local labels, byLabel = {}, {}
    for _, category in ipairs(categories) do
        labels[#labels + 1] = category.label
        byLabel[category.label] = category
    end
    local current = categories[1]
    local records, recordByLabel, recordByKey = {}, {}, {}
    local pickedKey = nil
    local shown = nil

    local ddCat = Teleports:AddDropdown("TP_Category", {
        Text = "Category", Values = labels, Default = current.label,
    })
    local ddLoc = Teleports:AddDropdown("TP_Location", {
        Text = "Destination", Values = {}, Searchable = true,
    })

    local function picked()
        return pickedKey and recordByKey[pickedKey] or nil
    end

    -- the dropdown is only rewritten when its labels changed, so a refresh never rebuilds it under the cursor for nothing
    local function refresh()
        records = Places.build(current.key)
        recordByLabel, recordByKey = {}, {}
        local names = {}
        for _, record in ipairs(records) do
            names[#names + 1] = record.label
            recordByLabel[record.label] = record
            recordByKey[record.key] = record
        end
        if not recordByKey[pickedKey] then pickedKey = records[1] and records[1].key or nil end
        local joined = table.concat(names, "\n")
        if joined ~= shown then
            shown = joined
            UiWrite.values(ddLoc, names)
        end
        local record = picked()
        local want = record and record.label or nil
        if ddLoc.Value ~= want then UiWrite.value(ddLoc, want) end
    end

    local function isWaypoints() return current.key == "waypoints" end

    ddCat:OnChanged(function(value)
        local category = byLabel[value]
        if not category or category == current then return end
        current = category
        pickedKey = nil
        refresh()
    end)

    local function settings()
        local avoid = Toggles.TP_SafetyMode
        local range = Options.TP_SafetyRange
        return {
            avoid = avoid ~= nil and avoid.Value == true,
            range = tonumber(range and range.Value) or 50,
        }
    end

    Teleports:AddButton({
        Text = "Teleport",
        Func = function() Travel.go(picked(), settings()) end,
    })

    Teleports:AddToggle("TP_SafetyMode", {
        Text = "Avoid Players",
        Default = false,
        Tooltip = "Won't send you where another player stands close by.",
    })
    local avoidBox = Teleports:AddDependencyBox()
    avoidBox:AddSlider("TP_SafetyRange", {
        Text = "Avoid Range",
        Default = 50, Min = 10, Max = 250, Rounding = 0, Suffix = " studs",
    })
    avoidBox:SetupDependencies({
        { Toggles.TP_SafetyMode, true },
    })

    onOpen(ddLoc, track, refresh)

    -- ===== quick travel =====

    local objectiveLabel = Quick:AddLabel("Objective: none", true)

    local function showObjective()
        local record = Places.objective()
        UiWrite.text(objectiveLabel, "Objective: " .. (record.name and record.name:gsub("[<>]", "") or "none"))
    end

    Quick:AddButton({
        Text = "Quest Objective",
        Func = function() Travel.go(Places.objective(), settings()) end,
    }):AddButton({
        Text = "Bounty Marker",
        Func = function() Travel.go(Places.bounty(), settings()) end,
    })
    Quick:AddButton({
        Text = "My Garden",
        Func = function() Travel.go(Places.garden(), settings()) end,
    })

    -- ===== huber =====

    local stops, stopByLabel = {}, {}
    local ddStop = Huber:AddDropdown("TP_HuberStop", {
        Text = "Stop", Values = {}, Searchable = true,
    })

    local function refreshStops()
        stops = Places.huberStops()
        stopByLabel = {}
        local names = {}
        for _, stop in ipairs(stops) do
            names[#names + 1] = stop.label
            stopByLabel[stop.label] = stop
        end
        local keep = ddStop.Value
        UiWrite.values(ddStop, names)
        if keep and stopByLabel[keep] then
            UiWrite.value(ddStop, keep)
        else
            UiWrite.value(ddStop, names[1])
        end
    end
    onOpen(ddStop, track, refreshStops)

    Huber:AddButton({
        Text = "Ride There",
        Tooltip = "Rides a Huber car like a normal player. Costs 50 dalas.",
        Func = function() Travel.ride(stopByLabel[ddStop.Value]) end,
    }):AddButton({
        Text = "Cancel Ride",
        Func = function() Travel.cancelRide() end,
    })

    -- ===== waypoints editor =====

    WaypointsBox:AddInput("TP_WP_Name", {
        Text = "Waypoint Name",
        Placeholder = "My Waypoint",
        ClearTextOnFocus = false,
        Finished = false,
    })

    local function pickedWaypoint()
        local record = picked()
        return isWaypoints() and record and record.waypoint or nil
    end

    WaypointsBox:AddButton({
        Text = "Add Waypoint",
        Tooltip = "Saves where you stand.",
        Func = function()
            local root = References.humanoidRootPart
            if not root then return notify("Your character isn't in the world right now.") end
            local base = Str.trim(tostring(Options.TP_WP_Name.Value or ""))
            if base == "" then base = "Waypoint" end
            local name = base
            if Waypoints.list[name] ~= nil then
                local used = {}
                for _, n in ipairs(Waypoints.order) do used[n] = true end
                name = uniq(used, base)
            end
            Waypoints.list[name] = root.Position
            Waypoints.order[#Waypoints.order + 1] = name
            Waypoints.save()
            if isWaypoints() then
                pickedKey = "waypoint:" .. name
                refresh()
            end
            notify("Added waypoint: " .. name)
        end,
    })

    WaypointsBox:AddButton({
        Text = "Remove Waypoint",
        Tooltip = "Removes the waypoint picked under Teleports.",
        Func = function()
            local name = pickedWaypoint()
            if not name then return notify("Switch Category to Waypoints and pick one.") end
            Waypoints.list[name] = nil
            Waypoints.keybinds[name] = nil
            for i = #Waypoints.order, 1, -1 do
                if Waypoints.order[i] == name then table.remove(Waypoints.order, i) end
            end
            Waypoints.save()
            refresh()
            notify("Removed waypoint: " .. name)
        end,
    })

    WaypointsBox:AddDivider()

    WaypointsBox:AddToggle("TP_EnableKeybinds", {
        Text = "Waypoint Hotkeys",
        Default = true,
    })

    WaypointsBox:AddLabel("Key to Set"):AddKeyPicker("TP_Binder", {
        Default = "None",
        SyncToggleState = false,
        Mode = "Toggle",
        Text = "Waypoint Hotkey",
        NoUI = true,
    })

    local function bindLine()
        local name = pickedWaypoint()
        local key = name and Waypoints.keybinds[name]
        return "Current Bind: " .. (key and tostring(bindName(key)) or "None")
    end
    local bindLabel = WaypointsBox:AddLabel(bindLine())

    ddLoc:OnChanged(function(value)
        local record = value and recordByLabel[value] or nil
        if record then pickedKey = record.key end
        UiWrite.text(bindLabel, bindLine())
    end)

    WaypointsBox:AddButton({
        Text = "Set Hotkey",
        Func = function()
            local name = pickedWaypoint()
            if not name then return notify("Switch Category to Waypoints and pick one.") end
            local key = bindName(Options.TP_Binder.Value)
            if key == nil or key == "None" then return notify("Choose a key above first.") end
            Waypoints.keybinds[name] = key
            Waypoints.save()
            UiWrite.text(bindLabel, bindLine())
            notify(("%s now takes you to %s."):format(key, name))
        end,
    }):AddButton({
        Text = "Clear Hotkey",
        Func = function()
            local name = pickedWaypoint()
            if name and Waypoints.keybinds[name] then
                Waypoints.keybinds[name] = nil
                Waypoints.save()
                UiWrite.text(bindLabel, bindLine())
                notify("Cleared the hotkey for " .. name)
            end
        end,
    })

    local function clearAll()
        if next(Waypoints.keybinds) == nil then return notify("No hotkeys to clear.") end
        for k in pairs(Waypoints.keybinds) do Waypoints.keybinds[k] = nil end
        Waypoints.save()
        UiWrite.text(bindLabel, bindLine())
        notify("Every waypoint hotkey has been cleared.")
    end

    WaypointsBox:AddButton({
        Text = "Clear All Hotkeys",
        Func = function()
            if next(Waypoints.keybinds) == nil then return notify("No hotkeys to clear.") end
            if not (Window and Window.AddDialog) then return clearAll() end
            Window:AddDialog("WaypointsClearAllKeybindsDialog", {
