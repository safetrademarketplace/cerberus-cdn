__bundle_register("Features/Utilities/StandRoller", function(require, _LOADED, __bundle_register, __bundle_modules)
-- stand roller: uses the arrow you pick one at a time until your stand is one you picked (by name or rarity), then stops; a picked stand is never rerolled, and it stops on its own when the arrows or the limit run out or the arrow can't give what you picked
local Jobs    = require("Utility/Jobs")
local Log     = require("Utility/Log")
local Mount   = require("Utility/Mount")
local Status  = require("Utility/Status")
local UiWrite = require("Utility/UiWrite")

local OWNER = "StandRoller"
-- after a roll the arrow cinematic holds the character (Character attr ArrowUseToken, ArrowUse.lua:1032-1050)
local CINEMATIC_WAIT = 20
local ROLL_GAP = 1
local LOCK_TRIES = 15
local FAIL_TRIES = 3

local M = {}

-- every stand the arrow pool can give, its rarity, and the rarities in pool order (Arrows.Rates Pool)
function M.catalog(pool)
    local stands, rarityOf, rarities = {}, {}, {}
    for _, tier in ipairs(type(pool) == "table" and pool or {}) do
        if type(tier) == "table" and type(tier.rarity) == "string" and type(tier.items) == "table" then
            rarities[#rarities + 1] = tier.rarity
            for _, item in ipairs(tier.items) do
                if type(item) == "table" and type(item.name) == "string" and not rarityOf[item.name] then
                    rarityOf[item.name] = tier.rarity
                    stands[#stands + 1] = item.name
                end
            end
        end
    end
    table.sort(stands)
    return { stands = stands, rarityOf = rarityOf, rarities = rarities }
end

function M.wanted(stand, pickStands, pickRarities, rarityOf)
    if type(stand) ~= "string" or stand == "" then return false end
    if pickStands[stand] then return true end
    local rarity = rarityOf[stand]
    return rarity ~= nil and pickRarities[rarity] == true
end

-- the stands this arrow can roll for you now, mirroring Arrows.getRollPool (Arrows.lua:272-306): a part arrow rolls its own list,
-- the others drop the heaviest Variants[arrow] tiers (excludedRarities :24-41); excluded holds your stand, the previous one and story locks
function M.rollable(arrow, arrows, pool, excluded, banned)
    local skip = {}
    for _, name in ipairs(excluded or {}) do skip[name] = true end
    for name in pairs(banned or {}) do skip[name] = true end
    local out = {}
    local part = type(arrows.PartPools) == "table" and arrows.PartPools[arrow]
    if type(part) == "table" and type(part.Stands) == "table" then
        -- getPartPool (:189-270); the game leaves the story lock out of excluded for a part arrow (:152-169, :183-186)
        for _, name in ipairs(part.Stands) do
            if not skip[name] then out[#out + 1] = name end
        end
        return out
    end
    local drop = tonumber(type(arrows.Variants) == "table" and arrows.Variants[arrow]) or 0
    local tiers = {}
    for i, tier in ipairs(pool) do
        if tier.weight > 0 and #tier.items > 0 then tiers[#tiers + 1] = { tier = tier, index = i } end
    end
    table.sort(tiers, function(a, b)
        if a.tier.weight == b.tier.weight then return a.index < b.index end
        return a.tier.weight > b.tier.weight
    end)
    local dropped = {}
    for i = 1, math.min(drop, #tiers) do dropped[tiers[i].tier.rarity] = true end
    for _, tier in ipairs(pool) do
        if not dropped[tier.rarity] then
            for _, item in ipairs(tier.items) do
                if not skip[item.name] then out[#out + 1] = item.name end
            end
        end
    end
    return out
end

function M.canReach(rollable, pickStands, pickRarities, rarityOf)
    for _, name in ipairs(rollable) do
        if M.wanted(name, pickStands, pickRarities, rarityOf) then return true end
    end
    return false
end

local function count(set)
    local n = 0
    for _, on in pairs(set) do
        if on then n = n + 1 end
    end
    return n
end

function M.mount(ctx)
    local O = Mount.orchestrator(ctx, "StandRoller")
    if not O then return end
    local Api = ctx.Api or {}
    local Player, Net = Api.Player, Api.Net
    if not (Player and Net) then
        Log.devwarn("StandRoller", "player or net api missing; stand roller won't load")
        return
    end
    local okRates, Rates = Net.module("Modules.Arrows.Rates")
    local okArrows, Arrows = Net.module("Arrows")
    if not (okRates and type(Rates) == "table" and type(Rates.Pool) == "table" and okArrows and type(Arrows) == "table") then
        Log.devwarn("StandRoller", "arrow modules unreachable; stand roller won't load")
        return
    end
    local Errors = Player.Errors
    local Options, Toggles, Library, References = ctx.Options, ctx.Toggles, ctx.Library, ctx.References
    local catalog = M.catalog(Rates.Pool)
    local banned = type(Rates.ExcludedStands) == "table" and Rates.ExcludedStands or {}

    local arrowNames = {}
    for name in pairs(type(Arrows.Variants) == "table" and Arrows.Variants or {}) do arrowNames[#arrowNames + 1] = name end
    table.sort(arrowNames, function(a, b)
        if a == "Mysterious Arrow" or b == "Mysterious Arrow" then return a == "Mysterious Arrow" end
        return a < b
    end)
    if #arrowNames == 0 then arrowNames = { "Mysterious Arrow" } end

    local enabled, job = false, nil

    local function picks()
        local s = Options.StandRoller_Stands and Options.StandRoller_Stands.Value
        local r = Options.StandRoller_Rarities and Options.StandRoller_Rarities.Value
        return type(s) == "table" and s or {}, type(r) == "table" and r or {}
    end

