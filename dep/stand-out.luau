    local out = {}
    if type(ev.Meteors) == "table" then
        for _, m in ipairs(ev.Meteors) do
            if type(m) == "table" and typeof(m.Position) == "Vector3" then out[#out + 1] = m.Position end
        end
    end
    if #out == 0 and typeof(ev.Position) == "Vector3" then out[1] = ev.Position end
    if #out == 0 and siteSpot then
        local spot = siteSpot(ev.Site)
        if spot then out[1] = spot end
    end
    return out
end

function Plan.bossName(ev)
    if type(ev.BossName) == "string" and ev.BossName ~= "" then return (string.gsub(ev.BossName, "[<>]", "")) end
    return NATURAL[ev.Id] or "the boss"
end

-- the event's boss: a model the game marks WorldEventBoss, or one named after the boss ("DIO_8912", enemies.md 1)
function Plan.isBoss(model, ev)
    if model:GetAttribute("WorldEventBoss") == true then return true end
    local base = string.gsub(model.Name, "_%d+$", "")
    if type(ev.BossName) == "string" and base == ev.BossName then return true end
    return NATURAL[ev.Id] ~= nil and base == NATURAL[ev.Id]
end

-- Core.lua:1414, :3350: event loot prompts carry WorldEventDrop; a plain dropped item is WorldItemPickup
function Plan.isLoot(prompt)
    return prompt:GetAttribute("WorldEventDrop") ~= nil or prompt.Name == "WorldItemPickup"
end

return Plan

