    local function finish(text)
        if text then UiWrite.notify(Library, text, 6) end
        enabled = false
        Status.clear(OWNER)
        if not finishing then
            finishing = true
            UiWrite.value(Toggles.StandRoller_Enabled, false)
            finishing = false
        end
    end

    local function loop(j)
        local arrow = Options.StandRoller_Arrow and Options.StandRoller_Arrow.Value or "Mysterious Arrow"
        local limit = math.max(1, math.floor(tonumber(Options.StandRoller_Max and Options.StandRoller_Max.Value) or 1))
        local start = arrowsLeft(arrow)
        local rolls, fails = 0, 0
        while j.alive and enabled do
            local stand = Player.value("Stand")
            if isWanted(stand) then return finish("You got " .. tostring(stand) .. "!") end
            local left = arrowsLeft(arrow)
            local used = math.max(rolls, start - left)
            if used >= limit then return finish("Used " .. used .. " arrows, no match") end
            if left < 1 then return finish("Out of " .. arrow .. "s") end
            local s, r = picks()
            if not M.canReach(M.rollable(arrow, Arrows, Rates.Pool, excludedFor(arrow), banned), s, r, catalog.rarityOf) then
                return finish("That arrow can't give what you picked")
            end
            if not cinematicDone(j) then return end
