        local ray = nil
        if aim ~= nil then
            ray = S.aimRay(aim)
            if not ray then return { err = Errors.NO_AIM } end
        end
        local sent, err = S.sendWith(ray, "Skill", skill, S.mouseHit(ray, nil), S.shiftlocked(), S.closestMouse(ray), S.inputStates("Skill", skill))
        if not sent then return { err = err } end
        if not heavy and def.SummonedM1Repeat then
            local sdef = c.Skills.skills[skill]
            L.nextStandLight = now + math.max(0.1, type(sdef) == "table" and tonumber(sdef.Cooldown) or 0.45)
        end
        return { result = { skill = skill } }
    end

    local function times(row, mult)
        return (tonumber(row[1]) or 0) * mult, (tonumber(row[2]) or 0) * mult, (tonumber(row[3]) or 0) * mult
    end

