        swing(actor, lead, heavy, profile, opts)
    end

    -- live 2026-11-17: npc melee sends no swing push; its tell is the attack track, Assets.Animations.<style>.Light.<n> or .Heavy, which starts 0.41-0.51 s before the hit lands (Charming Man, recon/tells_charming_live.txt)
    local animIndex = nil
    local animLead = {}
    -- track id -> { plays, hits, lead }, kept across sessions
    local learned = {}
    local learnedDirty = false
    do
        local saved = Store.read(STORE_NS, "learned_tells", nil)
        if type(saved) == "table" then
            for id, rec in pairs(saved) do
                if type(id) == "string" and type(rec) == "table" and tonumber(rec.plays) and tonumber(rec.hits) and tonumber(rec.lead) then
