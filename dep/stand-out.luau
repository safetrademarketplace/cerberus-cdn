        label   = "Arrow Hunt",
        owner   = OWNER,
        enable  = function(on) UiWrite.value(Toggles.ArrowHunt_Enabled, on) end,
        enabled = function() return enabled end,
        active  = function() return token ~= nil end,
        wants   = function() return enabled and not capped() and nextStop() ~= nil end,
    })
