    statusLabel.TextYAlignment = Enum.TextYAlignment.Top
    statusLabel.Visible = false
    statusLabel.ZIndex = 51
    paint(statusLabel, { TextColor3 = "AccentColor", FontFace = "Font" })
    statusLabel.Parent = root

