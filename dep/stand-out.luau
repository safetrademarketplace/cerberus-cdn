            return
        end
        if info.kind ~= "projectile" then return end
        local last = projectiles[info.instance]
        projectiles[info.instance] = { gap = gap, at = now }
        if not last or now - last.at <= 0 then return end
        local closing = (last.gap - gap) / (now - last.at)
        if closing < CLOSING_SPEED then return end
        local eta = gap / closing
        if eta > PROJECTILE_HORIZON then return end
        add({ from = info.instance, kind = "projectile", at = now + eta, ends = now + eta + ACTIVE,
