        local stop = S.need()
        if stop then return stop end
        if not (shop and shop.snapshot) then return Errors.NO_SESSION end
        if shop.pending then return Errors.BUSY end
        if References.player:GetAttribute("GardenPurchasePending") then return Errors.BUSY end
