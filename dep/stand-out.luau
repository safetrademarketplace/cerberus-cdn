function M.pick(rows, opts, now, note, rng)
    local visited, failed = note.visited or {}, note.failed or {}
    local ok = {}
    for _, r in ipairs(rows or {}) do
        local age = type(r.startedAt) == "number" and now - r.startedAt or nil
        local fresh = r.updatedAt == nil or (now - r.updatedAt) <= M.STALE_ROW
        local seen = visited[r.jobId] and now - visited[r.jobId] < M.VISITED_FOR
        local bad = failed[r.jobId] and now - failed[r.jobId] < M.VISITED_FOR
