        qte = qteState, qteInput = qteInput,
        armWrestle = armWrestleState, armWrestleInput = armWrestleInput, armWrestlePerfectTime = armWrestlePerfectTime,
        armWrestleFocus = armWrestleFocus, armWrestleLeave = armWrestleLeave,
