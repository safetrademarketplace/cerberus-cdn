__bundle_register("Features/Navigation/Teleports", function(require, _LOADED, __bundle_register, __bundle_modules)
-- teleports: travel to places, npcs, quest givers, huber stops, spawns, world events, players and your waypoints, your quest objective, bounty marker and garden, or ride a huber; every trip goes through the world api's movers under its claim
local Jobs      = require("Utility/Jobs")
local Log       = require("Utility/Log")
local Mount     = require("Utility/Mount")
local PlacesMod = require("Features/Navigation/Teleports/Places")
local TravelMod = require("Features/Navigation/Teleports/Travel")
local Ui        = require("Features/Navigation/Teleports/Ui")
local WaypointsMod = require("Features/Navigation/Teleports/Waypoints")

-- a burst of streaming or marker changes becomes one list refresh
local SETTLE = 1

return function(ctx)
    local O = Mount.orchestrator(ctx, "Teleports")
    if not O then return end

    local Api = ctx.Api or {}
    local World, Activities = Api.World, Api.Activities
    if not World then
        Log.devwarn("Teleports", "world api missing; teleports won't load")
        return
    end

    local Services   = ctx.Services
    local References = ctx.References
    local Library    = ctx.Library

    local waypoints = WaypointsMod.new({
        HttpService = Services.HttpService,
        path        = References.gameDir .. "/waypoints.json",
    })

    local places = PlacesMod.new({
        World      = World,
        Activities = Activities,
        Services   = Services,
        References = References,
        Waypoints  = waypoints,
    })

    -- the first other player standing within range of a spot, by shown name
    local function nearby(spot, range, skipUserId)
        local me = References.player
        for _, player in ipairs(Services.Players:GetPlayers()) do
            if player.UserId ~= (me and me.UserId) and player.UserId ~= skipUserId then
                local char = player.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root and (root.Position - spot).Magnitude <= range then
                    return player.DisplayName ~= "" and player.DisplayName or player.Name
                end
            end
        end
        return nil
    end

    local travel = TravelMod.new({
        World  = World,
        notify = function(text) Library:Notify(text, 4) end,
        track  = O.track,
        nearby = nearby,
    })
    O.onUnload(travel.kill)

    local ui = Ui({
        Tabs       = ctx.Tabs,
        Library    = Library,
        Options    = ctx.Options,
        Toggles    = ctx.Toggles,
        References = References,
        Window     = ctx.Window,
        Places     = places,
        Travel     = travel,
        Waypoints  = waypoints,
        categories = PlacesMod.CATEGORIES,
        track      = O.track,
    })

    -- lists follow the game's own data as it streams and changes, settled into one refresh
    local pending = nil
    local function refreshSoon()
        if pending and pending.alive then return end
        pending = O.track(Jobs.delay(SETTLE, function() ui.refresh() end, { name = "Teleports.refresh" }))
    end
    local function watchFolder(folder)
        if not folder then return end
        O.track(folder.ChildAdded:Connect(refreshSoon))
        O.track(folder.ChildRemoved:Connect(refreshSoon))
    end

    local RS = Services.ReplicatedStorage
    local root = Services.Workspace:FindFirstChild("Game")
    watchFolder(RS:FindFirstChild("PhoneMapPoints"))
    watchFolder(root and root:FindFirstChild("NPCs"))
    watchFolder(References.player and References.player:FindFirstChild("AvailableQuestPoints"))
    O.track(Services.Players.PlayerAdded:Connect(refreshSoon))
    O.track(Services.Players.PlayerRemoving:Connect(refreshSoon))
    if Activities and Activities.worldEvent then O.track(Activities.worldEvent:Connect(refreshSoon)) end

    local player = References.player
    if player then
        O.track(player:GetAttributeChangedSignal("VisibleQuestTrackerName"):Connect(ui.showObjective))
    end

    O.track(Services.UserInputService.InputBegan:Connect(function(input, processed)
        if processed or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        ui.hotkey(input.KeyCode.Name)
    end))

    O.finalize()
    return {}
end

end)
__bundle_register("Features/Navigation/Teleports/Waypoints", function(require, _LOADED, __bundle_register, __bundle_modules)
-- persistent { name -> Vector3 } waypoint store with ordering + keybinds, serialized to gameDir/waypoints.json

local Fs = require("Utility/Helpers/Fs")

local M = {}

local function v3_to_tbl(v) return { x = v.X, y = v.Y, z = v.Z } end

local function tbl_to_v3(t)
    if typeof(t) == "Vector3" then return t end
    if type(t) == "table" then
        local x = t.x or t.X or t[1]
        local y = t.y or t.Y or t[2]
        local z = t.z or t.Z or t[3]
        if tonumber(x) and tonumber(y) and tonumber(z) then
            return Vector3.new(tonumber(x), tonumber(y), tonumber(z))
        end
    end
    return nil
end

M.v3_to_tbl = v3_to_tbl
M.tbl_to_v3 = tbl_to_v3

function M.new(opts)
    local HttpService = opts.HttpService
    local path        = opts.path

    local state = { list = {}, order = {}, keybinds = {} }

    local function load()
        if not (isfile and isfile(path)) then return end
        local ok, data = pcall(readfile, path)
        if not (ok and data and #data > 0) then return end
        local okDec, obj = pcall(function() return HttpService:JSONDecode(data) end)
        if not (okDec and type(obj) == "table") then return end

        local L   = obj.list or {}
        local Ord = obj.order or {}
        local K   = obj.keybinds or {}
        state.list, state.order, state.keybinds = {}, {}, {}

        for name, posObj in pairs(L) do
            local v = tbl_to_v3(posObj)
            if v then state.list[name] = v end
        end
        for i = 1, #Ord do
            local nm = Ord[i]
            if state.list[nm] then state.order[#state.order + 1] = nm end
        end
        for name, key in pairs(K) do
            if state.list[name] then state.keybinds[name] = tostring(key) end
        end

        if #state.order == 0 then
            for nm in pairs(state.list) do state.order[#state.order + 1] = nm end
            table.sort(state.order)
        end
    end

    local function save()
        local enc = { list = {}, order = state.order, keybinds = state.keybinds }
        for name, v in pairs(state.list) do
            if typeof(v) == "Vector3" then
                enc.list[name] = v3_to_tbl(v)
            elseif type(v) == "table" then
                enc.list[name] = v
            end
        end
        Fs.safeWrite(path, HttpService:JSONEncode(enc), "Teleports")
    end

    load()

    return {
        list     = state.list,
        order    = state.order,
        keybinds = state.keybinds,
        save     = save,
        setKeybinds = function(k) state.keybinds = k; return state.keybinds end,
    }
end

return M

end)
__bundle_register("Features/Navigation/Teleports/Ui", function(require, _LOADED, __bundle_register, __bundle_modules)
-- teleports ui: the destination picker, quick travel, huber ride and waypoint editor boxes on the travel tab; the picked destination is held by key so a refresh that relabels it keeps it picked
local Str     = require("Utility/Helpers/Str")
local UiWrite = require("Utility/UiWrite")

local function bindName(value)
    if typeof(value) == "EnumItem" then return value.Name end
    if value == nil then return nil end
    return tostring(value)
end

local function uniq(used, base)
    local k, n = base, 1
    while used[k] do
        n = n + 1
        k = ("%s (%d)"):format(base, n)
    end
    used[k] = true
    return k
end

-- runs fn each time the dropdown's list opens; obsidian shows its menu frame on open (Library.lua AddContextMenu Open)
local function onOpen(dropdown, track, fn)
    local menu = dropdown and dropdown.Menu
    local frame = type(menu) == "table" and menu.Menu or nil
    if typeof(frame) ~= "Instance" then return end
    track(frame:GetPropertyChangedSignal("Visible"):Connect(function()
        if frame.Visible then fn() end
    end))
end

return function(deps)
    local Tabs       = deps.Tabs
    local Library    = deps.Library
    local Options    = deps.Options
    local Toggles    = deps.Toggles
    local References = deps.References
