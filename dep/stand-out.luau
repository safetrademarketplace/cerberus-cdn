        if filter.root then return { filter.root } end
        local out = {}
        local gameRoot = Workspace:FindFirstChild("Game")
        if not gameRoot then return out end
        for _, name in ipairs(DEFAULT_ROOTS) do
            local folder = gameRoot:FindFirstChild(name)
            if folder then out[#out + 1] = folder end
        end
