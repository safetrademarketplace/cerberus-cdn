            if not (def and def.Pilot) then return false, Errors.UNSUPPORTED end
            if char:GetAttribute("Summoned") ~= true and not def.UnsummonedPilot then return false, Errors.NEED_SUMMON end
            if S.isStunned(char) then return false, Errors.STUNNED end
