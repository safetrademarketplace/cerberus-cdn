local function sortedPieces(list, isCurrent)
    local out = {}
    for _, p in ipairs(list) do out[#out + 1] = p end
    table.sort(out, function(a, b)
        local ca, cb = isCurrent(a), isCurrent(b)
        if ca ~= cb then return ca end
        if a.name ~= b.name then return a.name < b.name end
        return tostring(a.id) < tostring(b.id)
    end)
    return out
end

-- best jacket+pants pair (sets need the pair) and then up to four accessories by marginal gain; ties keep what you wear
