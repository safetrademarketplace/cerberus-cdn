        if not PROCESS_ACTIONS[action] then return false, Errors.NOT_ALLOWED end
        if action ~= "Sync" then
            if processing.pending then return false, Errors.BUSY end
            processing.pending = true
        end
        local payload = {}
        for k, v in pairs(extra or {}) do payload[k] = v end
