        Text = "AutoUse Tool",
        Default = false,
        Tooltip = "Automatically activates your equipped tool",
    }):AddKeyPicker("AutoUseKey", {
        Default = nil,
        SyncToggleState = true,
        Mode = "Toggle",
    })

    local activateConn = nil

    local function stop()
        if activateConn then
            activateConn:Disconnect()
            activateConn = nil
            local tool = getTool()
            if tool then pcall(function() tool:Deactivate() end) end
        end
    end

    local function start()
        if activateConn then return end
        activateConn = track(Scheduler.heartbeat(function()
            local tool = getTool()
            if tool then pcall(function() tool:Activate() end) end
        end, { name = "AutoUseTool", interval = ACTIVATE_INTERVAL }))
    end

    Toggles.AutoUseTool:OnChanged(function()
        local on = Toggles.AutoUseTool.Value == true
        Library:Notify(on and "AutoUse enabled." or "AutoUse disabled.", 2)
        if on then start() else stop() end
