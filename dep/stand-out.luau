            guardOnly = opts.guardOnly == true, forceBlock = opts.forceBlock == true,
            owner = type(opts.owner) == "string" and opts.owner or "Combat",
            conns = {}, jobs = {}, def = newDefence(), peers = {}, lastFace = -math.huge,
        }
        if opts.face == nil then S.face = not S.attach and not S.guardOnly else S.face = opts.face == true end
        if S.attach or S.face then
            if opts.token ~= nil then
                S.token = opts.token
            else
                local _, current = World.owner()
                local ok, token = World.claim(S.owner)
                if ok then
                    S.token = token
                    S.ownsClaim = current ~= S.owner
                elseif S.attach then
                    return nil, "busy"
                end
            end
        end
        S.threats = Threats.acquire(ctx)
        if not S.threats then
            if S.ownsClaim then World.release(S.token) end
            return nil, "no_api"
        end
        hookSignals(S)
        S.heartbeat = Scheduler.heartbeat(function() defend(S) end, { name = "Combat/Engage defend", priority = 5 })
        -- a guard session stands down while a fight from this engine runs its own defence
        for other in pairs(sessions) do
            if other.guardOnly and not S.guardOnly then other.peers[S] = true end
            if S.guardOnly and not other.guardOnly then S.peers[other] = true end
        end
        sessions[S] = true
        return S
    end

    local function close(S)
        if S.closed then return end
        guardDown(S)
        dodgeDone(S)
        S.closed = true
        sessions[S] = nil
        for other in pairs(sessions) do other.peers[S] = nil end
        if S.heartbeat then S.heartbeat:Disconnect() end
        S.heartbeat = nil
        for i = #S.conns, 1, -1 do
            S.conns[i]:Disconnect()
            S.conns[i] = nil
        end
        for i = #S.jobs, 1, -1 do
            S.jobs[i]:Cancel()
            S.jobs[i] = nil
        end
        if S.attachHandle then S.attachHandle.stop() end
        S.attachHandle = nil
        if S.ownsClaim and S.token then World.release(S.token) end
        S.ownsClaim = false
        if S.threats then S.threats.release() end
    end

    -- ======================= positioning =======================

    local function place(S, target)
        if not S.attach then return true end
        local want = attachWanted(S.opts)
        local h = S.attachHandle
        if h and not h.active() then
            S.attachHandle, h = nil, nil
        end
        if not h then
            local ok, result = World.attach(target, { mode = want.mode, distance = want.distance, height = want.height, token = S.token, confine = S.opts.confine })
            if not ok then
                if result == WE.NOT_OWNER or result == WE.BUSY then return false, "busy" end
                return true
            end
            S.attachHandle = result
            S.placed = want
            return true
        end
        if h.target() ~= target then h.setTarget(target) end
        local placed = S.placed
        if not S.def.dodge and (placed.mode ~= want.mode or placed.distance ~= want.distance or placed.height ~= want.height) then
            if h.set(want) then S.placed = want end
        end
        return true
    end

    -- without attach you're only turned to face the target, through World's own mover (a zero-offset travel), never a CFrame write here
    local function face(S, target)
        if not (S.face and S.token) then return end
        local t = now()
        if t - S.lastFace < FACE_EVERY then return end
        local root = ctx.References.humanoidRootPart
        local troot = rootOf(target)
        if not (root and root.Parent and troot) then return end
        local look = root.CFrame.LookVector
        local delta = troot.Position - root.Position
        local flat = Vector3.new(delta.X, 0, delta.Z)
        if flat.Magnitude < 0.5 then return end
        local lookFlat = Vector3.new(look.X, 0, look.Z)
        if lookFlat.Magnitude > 1e-3 and lookFlat.Unit:Dot(flat.Unit) >= FACE_DOT then return end
        S.lastFace = t
        World.travelTo(root.Position, { offset = 0, face = troot.Position, stream = false, token = S.token })
    end

    -- ======================= offence =======================

    local function ensureSummon()
        if not toggle("Combat_Summon", true) then return end
        local t = now()
        if t < summonRetryAt then return end
        local ok, stand = Combat.stand()
        if not ok then
            -- live 2026-11-18: right after a respawn the stand reads as missing; a 30 s no_stand back-off left a raid fight standless and idle
            summonRetryAt = t + math.min(backoff(stand), SUMMON_RETRY_MAX)
            return
        end
        if stand.summoned then
            summonRetryAt = t + SUMMON_EVERY
            return
        end
        local okSummon, code = Combat.summon(true)
        summonRetryAt = t + (okSummon and SUMMON_EVERY or math.min(backoff(code), SUMMON_RETRY_MAX))
    end

    local function stringNeeded()
        return math.max(2, (comboCount or 5) - 1)
    end

    -- damage per cooldown, then the rotation rules; nil means not now
    local function score(c, life, info)
        local i, h = c.info, HINTS[c.name] or NO_HINT
        local damage = i.damage > 0 and i.damage or math.max(i.cooldown, 1) * 0.3
        local s = damage / math.max(i.cooldown, 1)
        local range = i.range or SKILL_MELEE_RANGE
        if (info.distance or 0) > range + 1 then return nil end
        local ratio = info.maxHealth > 0 and info.health / info.maxHealth or 1
        if h.never then return nil end
        -- an execute is a bonus inside its window; outside it the skill still goes on cooldown (holding it idled flaming grasp, the kit's biggest hit, on every 300+ hp target)
        local exec = i.execute or h.execute
        if exec and ratio <= exec then s = s + 2000 end
        if h.opener and not life.opened then s = s + 1000 end
        if h.afterString and life.string < stringNeeded() then return nil end
        if info.blocking then
            if i.unblockable or i.guardBreak or h.punish then
                s = s * 1.5 + 50
            elseif not i.projectile then
                s = s * 0.5
            end
        end
        if h.onDown and info.ragdolled then s = s * 1.5 end
        if h.afterKnock and now() - life.knockAt <= 2 then s = s * 1.25 end
        -- live 2026-11-19 (tarkus): a vampire heals off its VampireBlood, and fire (Flaming Grasp's 22.5 hit) put Status_AntiHeal on it; while it isn't
        -- anti-healed, a fire skill comes first
        if info.vampire and not info.antiHealed and (h.antiHeal or i.antiHeal) then s = s + 1500 end
        -- live 2026-11-19: barrage's 2.5 s did 0.2-0.4 a hit to tarkus against 12.5 expected; a skill's real share of its damage on this target scales it
        local real = life.dealt and life.dealt[c.name]
        if real then s = s * math.clamp(real, 0.05, 1.5) end
        return s + i.cooldown * 1e-4
    end

    local function chooseSkill(S, life, info)
        local t = now()
        if t - life.skillLook < SKILLS_EVERY then return nil end
        life.skillLook = t
        local picked = pickedSkills()
        local list = {}
        local ok, bar = Combat.skills()
        if ok then
            for _, entry in ipairs(bar) do
                local name = entry.name
                if name ~= "" and (not picked or picked[name]) and allowed(name) and Combat.skillReady(entry.slot) then
                    list[#list + 1] = { name = name, key = entry.slot, info = infoOf(name, entry) }
                end
            end
        end
        if toggle("Combat_UseEX", true) then
            local ex = exState()
            if ex and ex.access ~= false and type(ex.skills) == "table" then
                local reserve = (toggle("Combat_StunEscape", true) and evasiveOnBar()) and 1 or 0
                local bars = tonumber(ex.bars) or 0
                for _, s in ipairs(ex.skills) do
                    local name = s.name
                    local cost = tonumber(s.cost) or 1
                    if type(name) == "string" and name ~= "" and s.ready ~= false and (not picked or picked[name])
                        and allowed(name) and cost <= bars - reserve then
                        list[#list + 1] = { name = name, key = name, ex = true, info = infoOf(name, nil) }
                    end
                end
            end
        end
        local best, bestScore = nil, -math.huge
        for _, c in ipairs(list) do
            local s = score(c, life, info)
            if s and s > bestScore then best, bestScore = c, s end
        end
        return best
    end

    local function cast(S, target, life, c)
        local ok, code = Combat.useSkill(c.key, target)
        if not ok then
            refuse(c.name, code)
            -- ex moves and some skills need the stand out
            if code == E.NEED_SUMMON or code == E.NO_EX then summonRetryAt = 0 end
            return false
        end
        local h = HINTS[c.name] or NO_HINT
        local hold = h.hold and math.min(h.hold, HOLD_MAX) or TAP
        life.opened = true
        life.sends = life.sends + 1
        -- the throttle is for empty looks; ready skills chain without an m1 between them
        life.skillLook = -math.huge
        S.status = "Using " .. c.name
        S.threats.selfCast(hold + (c.info.castTime or 0.5))
        if h.afterString then
            life.knockAt = now()
            life.string = 0
            life.cut = true
        end
        local hum = target:FindFirstChildOfClass("Humanoid")
        local before = hum and hum.Health
        sleepFor(S, hold)
        Combat.releaseSkill(c.key, target)
        -- what it really took off, against what it should have, kept for this target (a regen tick or another hit only nudges it)
        local expected = tonumber(c.info.damage)
        if hum and before and expected and expected > 0 then
            task.delay(DEALT_WAIT, function() -- leak:allow a one-shot read that neither loops nor waits again
                local share = math.max(0, before - hum.Health) / expected
                local was = life.dealt[c.name]
                life.dealt[c.name] = was and (was + share) / 2 or share
            end)
        end
        return true
    end

    local function melee(S, target, life, info)
        if not S.attach and (info.distance or math.huge) > MELEE_REACH then
            S.status = "Out of reach"
            task.wait(TICK)
            return
        end
        face(S, target)
        local heavyOk = toggle("Combat_Heavy", true) and allowed("heavy")
        local lightOk = allowed("light")
        local wantHeavy = heavyOk and (life.lockout or info.blocking or (comboCount ~= nil and life.string >= comboCount - 1))
        if not wantHeavy and not lightOk then
            if not heavyOk then
                task.wait(TICK)
                return
            end
            wantHeavy = true
        end
        S.status = "Fighting " .. displayName(target)
        local ok, result = Combat.attack(target, { heavy = wantHeavy })
        if wantHeavy then
            if ok or result == E.MISSED then
                life.sends = life.sends + 1
                life.lockout = false
                life.string = 0
                life.cut = true
            else
                refuse("heavy", result)
            end
            return
        end
        if ok then
            life.sends = life.sends + 1
            life.lockout = false
            life.string = (type(result) == "table" and tonumber(result.index)) or life.string + 1
        elseif result == E.MISSED then
            life.sends = life.sends + 1
            life.string = life.string + 1
        elseif result == E.COOLDOWN then
            -- the post-combo lockout: the string that just ended was the full combo unless a heavy or skill cut it
            if life.string > 0 and not life.cut then comboCount = math.min(COMBO_MAX, math.max(comboCount or 0, life.string)) end
            life.string, life.cut, life.lockout = 0, false, true
            refuse("light", result, 0.1)
        else
            refuse("light", result)
        end
    end

    -- verdict on the target: won / knocked / gone / immune / far, or nil to keep fighting
    local function judge(S, target, life, info)
        if not info then
            if life.sawDeath or life.lastRatio <= GONE_WON_RATIO then return "won" end
            return "gone"
        end
        life.lastRatio = info.maxHealth > 0 and info.health / info.maxHealth or 1
        if not info.alive then
            life.sawDeath = true
            return "won"
        end
        local t = now()
        if info.passedOut then
            life.knockedAt = life.knockedAt or t
            if t - life.knockedAt >= KNOCK_GRACE then return "knocked" end
        else
            life.knockedAt = nil
        end
        if info.health < life.best - 1e-3 then
            life.best, life.progressAt, life.sends = info.health, t, 0
        elseif t - life.progressAt >= (tonumber(S.opts.stallAfter) or STALL_AFTER) and life.sends >= STALL_SENDS then
            return "immune"
        end
        if not S.attach and S.opts.range and (info.distance or math.huge) > S.opts.range then return "far" end
        return nil
    end

    local function waitRespawn(S)
        if S.opts.respawn == false then return false end
        S.status = "Waiting to respawn"
        guardDown(S)
        S.def.dodge = nil
        if S.attachHandle then S.attachHandle.stop() end
        S.attachHandle = nil
        local deadline = now() + (tonumber(S.opts.respawnTimeout) or RESPAWN_TIMEOUT)
        while now() < deadline do
            if S.stopped then return false end
            local ready = Combat.alive() and (not (Player and Player.spawnReady) or Player.spawnReady() == true)
            if ready then
                S.threats.clear()
                summonRetryAt = 0
                -- live 2026-11-18: died while stunned, no Unstun ever came for the new body, and the fight waited on it for minutes
                S.def.stunned, S.def.guard = false, nil
                return sleepFor(S, RESPAWN_SETTLE)
            end
            task.wait(0.25)
        end
        return false
    end

    local function newLife(target)
        local ok, info = World.info(target)
        local health = ok and info.health or math.huge
        return {
            target = target, opened = false, string = 0, cut = false, lockout = false, sends = 0,
            best = health, progressAt = now(), lastRatio = 1, sawDeath = false, knockedAt = nil,
            knockAt = -math.huge, skillLook = -math.huge,
            -- what each skill really did to this target against what it should (see cast)
            dealt = {},
        }
    end

    -- fights one target until a verdict; yields
    local function engage(S, target)
        local life = newLife(target)
        local deadline = now() + (tonumber(S.opts.targetTimeout) or tonumber(S.opts.timeout) or FIGHT_TIMEOUT)
        while true do
            if S.stopped then return false, "stopped" end
            if S.target ~= target and S.target ~= nil then
                target = S.target
                life = newLife(target)
            end
            if now() > deadline or (S.deadline and now() > S.deadline) then return false, "timeout" end
            if not Combat.alive() then
                if not waitRespawn(S) then return false, S.stopped and "stopped" or "died" end
            else
                local ok, info = World.info(target)
                local verdict = judge(S, target, life, ok and info or nil)
                if verdict then return verdict == "won" or verdict == "knocked", verdict end
                local placed, why = place(S, target)
                if not placed then return false, why end
                local D = S.def
                local want = defenceWanted(S)
                local guarding = D.guard ~= nil or D.dodge ~= nil
                -- only a melee or skill tell holds the swing for a parry: a gunner fires nonstop, and gating on bullets would stop the attack for good
                local coming = nil
                if want.block or want.dodge then coming = S.threats.pressure(GATE) end
                local gated = coming ~= nil and coming.kind ~= "projectile" and coming.kind ~= "hitbox"
                local parried = S.parriedAt and now() - S.parriedAt < 0.4
                -- a stun the character no longer shows is over, whatever push was missed
                if D.stunned and now() - (D.stunnedAt or 0) > STUN_TRUST then
                    local char = ctx.References and ctx.References.character
                    if not (char and char:GetAttribute("Stunned") == true) then D.stunned = false end
                end
                if guarding or gated or parried or D.stunned then
                    S.status = guarding and (D.dodge and "Dodging" or "Blocking") or ("Fighting " .. displayName(target))
                    task.wait(TICK)
                elseif Player and Player.value("SkillActive") == true then
                    task.wait(TICK)
                else
                    ensureSummon()
                    -- live 2026-11-18: a knocked-out npc is finished by the server 5.0 s after it drops however it's hit (DIO, Bobby Jean); skills spent on it are
                    -- cooldowns lost for the next enemy, so it only gets the m1 string until its life ends
                    info.vampire = target:GetAttribute("VampireBlood") ~= nil
                    info.antiHealed = target:GetAttribute("Status_AntiHeal") ~= nil
                    local c = not info.passedOut and chooseSkill(S, life, info) or nil
                    if not (c and cast(S, target, life, c)) then melee(S, target, life, info) end
                end
            end
        end
    end

    -- ======================= public verbs =======================

    -- yields until (true, "won"|"knocked") or (false, "gone"|"died"|"timeout"|"stopped"|"busy"|"immune"|"far"|"no_api")
    function engine.fight(target, opts, _session)
        if typeof(target) ~= "Instance" or not target:IsA("Model") then return false, "gone" end
        local S, err = _session, nil
        if not S then
            S, err = open(target, opts)
            if not S then return false, err end
        end
        local ok, reason = engage(S, target)
        if not _session then close(S) end
        return ok, reason
    end

    -- yields: fights every valid model a World filter finds, one latched target at a time; (true, "cleared", kills) or (false, reason, kills)
    function engine.clear(filter, opts, _session)
        opts = opts or {}
        local S, err = _session, nil
        if not S then
            S, err = open(nil, opts)
            if not S then return false, err, 0 end
        end
        S.deadline = now() + (tonumber(opts.timeout) or CLEAR_TIMEOUT)
        local skip = setmetatable({}, { __mode = "k" })
        local kills = 0
        local ok, reason = true, "cleared"
        while true do
            if S.stopped then
                ok, reason = false, "stopped"
                break
            end
            if now() > S.deadline then
                ok, reason = false, "timeout"
                break
            end
            if not Combat.alive() then
                if not waitRespawn(S) then
                    ok, reason = false, S.stopped and "stopped" or "died"
                    break
                end
            end
            local target = S.target
            if not engine.valid(target, opts) then
                target = engine.pick(filter, opts, skip)
                S.target = target
            end
            if not target then break end
            local won, why = engage(S, target)
            if won then
                kills = kills + 1
                S.target = nil
            elseif why == "stopped" or why == "timeout" or why == "died" or why == "busy" then
                ok, reason = false, why
                break
            else
                skip[target] = now() + SKIP_FOR
                S.target = nil
            end
        end
        S.status = ok and "Area clear" or S.status
        if not _session then close(S) end
        return ok, reason, kills
    end

    local function handleFor(S, body)
        local h = { result = nil }
        local job = Jobs.spawn(function()
            h.result = table.pack(body())
            close(S)
        end, { name = "Combat/Engage " .. S.owner })
        S.jobs[#S.jobs + 1] = job
        function h.stop()
            S.stopped = true
            return true
        end
        function h.status() return S.status end
        function h.target() return S.target end
        function h.setTarget(model)
            if typeof(model) ~= "Instance" or not model:IsA("Model") then return false end
            S.target = model
            return true
        end
        function h.done() return h.result ~= nil or S.closed end
        function h.outcome()
            if not h.result then return nil end
            return table.unpack(h.result, 1, h.result.n)
        end
        function h.kill()
            S.stopped = true
            close(S)
            job:Cancel()
        end
        h.Destroy = h.kill
        h.Disconnect = h.kill
        return h
    end

    -- non-yielding: runs fight (or clear when opts.clear is a filter) on its own job
    function engine.start(target, opts)
        opts = opts or {}
        local S, err = open(target, opts)
        if not S then return nil, err end
        if opts.clear ~= nil then
            return handleFor(S, function() return engine.clear(opts.clear, opts, S) end)
        end
        return handleFor(S, function() return engine.fight(target, opts, S) end)
    end

    -- only the defensive half while you fight by hand: block on tells, dodge, stun escape; stands down while a fight from this engine runs
    function engine.guard(opts)
        opts = opts or {}
        local S, err = open(nil, { guardOnly = true, forceBlock = opts.forceBlock ~= false, owner = opts.owner, face = false })
        if not S then return nil, err end
        S.status = "Watching for hits"
        local h = {}
        function h.stop() close(S) return true end
        function h.status()
            local D = S.def
            if D.guard then return "Blocking" end
            if D.dodge then return "Dodging" end
            return S.status
        end
        h.Destroy = h.stop
        h.Disconnect = h.stop
        return h
    end

    function engine.stats()
        return { parries = stats.parries, guards = stats.guards, dodges = stats.dodges, escapes = stats.escapes,
            lead = engine.parryLead(), comboCount = comboCount }
    end

    function engine.destroy()
        for S in pairs(sessions) do
            S.stopped = true
            close(S)
        end
    end

    Log.dev("Engage", "combat engine ready")
    return engine
end

return Engage

end)
__bundle_register("Features/Combat/Threats", function(require, _LOADED, __bundle_register, __bundle_modules)
-- threats: shared incoming-attack detection for every fighting feature, refcounted per api set; swing tells from the server's SwingVFX/PunchTrail pushes (each carries its own lead to the hit), live hitboxes and projectiles near you, stand Skill casts and npcs aimed at you, merged into one pressure() answer
local Api       = require("Api")
local Jobs      = require("Utility/Jobs")
local Log       = require("Utility/Log")
local Scheduler = require("Utility/Scheduler")
local Store     = require("Utility/Store")

-- Effects3.lua:4597: a swing tell with no delay arg draws 0.15 s after the push
local DEFAULT_LEAD = 0.15
-- damage.md 1.2: every profile's hit window is open about 0.2 s
local ACTIVE = 0.2
-- an attacker further than this can't reach you with a swing (the biggest npc m1 box is 7 deep, plus a stand's step ahead)
local REACH = 14
-- an attacker that isn't known to be aiming at someone must face within about 80 degrees of you
local FACING_DOT = 0.17
-- a hitbox counts once your root is this far inside its outer edge
local HITBOX_MARGIN = 3
-- a hitbox this big is a skill you can't stand in, so it reads as a big hit
local BIG_HITBOX = 12
-- a projectile closing at least this fast is tracked toward you
local CLOSING_SPEED = 4
local PROJECTILE_HORIZON = 1.2
-- live-only: how long after a stand Skill attribute appears its first hit lands
local STAND_SKILL_LEAD = 0.3
local AGGRO_RADIUS = 60
local SCAN_EVERY = 0.05
local AGGRO_EVERY = 0.1
-- a tell is kept this long after its hit window closes
local KEEP = 0.3
-- two tells from one attacker landing this close together are the same swing (SwingVFX and PunchTrail both fire)
local SAME_SWING = 0.12
-- attack tracks live under these folders in Assets.Animations (live 2026-11-17: "Big Mouth Strikes Again.Light.1".."4")
local ATTACK_FOLDERS = { Light = "light", M1 = "light", Lights = "light", Heavy = "heavy", M2 = "heavy", Heavies = "heavy" }
local LIGHT_ANIM_LEAD = 0.42
local HEAVY_ANIM_LEAD = 0.6
local LEARN_MIN = 0.15
local LEARN_MAX = 0.9
local LEARN_RATE = 0.3
-- live 2026-11-18: dio's swings use tracks outside Assets.Animations and aim at whoever he named, yet hit everyone beside him; any track a hit keeps following is learned as a tell
local LEARN_HITS = 3
local LEARN_RATIO = 0.35
-- a learned tell counts from this close whoever the attacker names
local LEARN_REACH = 12
-- every fighter this close has its tracks watched, aggro or not
local WATCH_RADIUS = 25
local RECENT_KEEP = 48
local SAVE_EVERY = 60
local STORE_NS = Store.GAME .. "/combat"
local HOOK_RETRY = 2
local HOOK_TRIES = 60

local M = {}

-- one detector per api set, shared by every feature that acquires it
local live = setmetatable({}, { __mode = "k" })

local function flatUnit(v)
    local flat = Vector3.new(v.X, 0, v.Z)
    if flat.Magnitude < 1e-3 then return nil end
    return flat.Unit
end

local function rootOf(model)
    if typeof(model) ~= "Instance" or not model:IsA("Model") then return nil end
    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    if root and root:IsA("BasePart") then return root end
    return nil
end

local function build(ctx)
    local Net, Combat, World, Player = ctx.Api.Net, ctx.Api.Combat, ctx.Api.World, ctx.Api.Player
    local References = ctx.References

    local T = { refs = 0, alive = true }
    local threats = {}
    local aggro = {}
    local standSkill = setmetatable({}, { __mode = "k" })
    local projectiles = setmetatable({}, { __mode = "k" })
    local selfCastUntil = -math.huge
    local nextId = 0
    local handles, conns = {}, {}
    local hookJob, scanHandle, aggroHandle, saveJob = nil, nil, nil, nil
    local unbindCharacter = nil

    local tell = Api.signal()
    local aggroChanged = Api.signal()

    local function myName()
        local player = References.player
        return player and player.Name
    end

    local function myRoot()
        local root = References.humanoidRootPart
        if root and root.Parent then return root end
        return nil
    end

    -- the pushed instances aren't cloneref'd, so you and your stand are matched by name and parent
    local function isMine(model)
        local name = myName()
        if not name or typeof(model) ~= "Instance" then return false end
        if model.Name == name then return true end
        local parent = model.Parent
        return parent ~= nil and parent.Name == name and parent:IsA("Model")
    end

    -- a stand swings for whoever it's parented under (Utility.lua:5907)
    local function attackerOf(model)
        if typeof(model) ~= "Instance" or not model:IsA("Model") then return nil end
        local parent = model.Parent
        if parent and parent:IsA("Model") and parent:FindFirstChildOfClass("Humanoid") then return parent end
        return model
    end

    -- true / false when the npc names its target (enemies.md 1: Target string, NPCCombatTarget value), nil when it doesn't say
    local function targetsMe(model)
        local name = myName()
        if not name then return nil end
        local target = model:GetAttribute("Target")
        if type(target) == "string" and target ~= "" then return target == name end
        local value = model:FindFirstChild("NPCCombatTarget")
        local who = value and value:IsA("ObjectValue") and value.Value or nil
        if who then return who.Name == name end
        return nil
    end

    local function facesMe(attackerRoot, root)
        local look = flatUnit(attackerRoot.CFrame.LookVector)
        local toMe = flatUnit(root.Position - attackerRoot.Position)
        if not (look and toMe) then return true end
        return look:Dot(toMe) >= FACING_DOT
    end

    local function prune(now)
        for i = #threats, 1, -1 do
            if threats[i].ends < now - KEEP then table.remove(threats, i) end
        end
    end

    local function add(record)
        local now = os.clock()
        prune(now)
        for _, existing in ipairs(threats) do
            if existing.from == record.from and existing.kind == record.kind and math.abs(existing.at - record.at) <= SAME_SWING then
                existing.heavy = existing.heavy or record.heavy
                existing.guardBreak = existing.guardBreak or record.guardBreak
                return existing
            end
        end
        nextId = nextId + 1
        record.id = nextId
        record.seenAt = now
        threats[#threats + 1] = record
        tell:Fire(record)
        return record
    end

    -- a swing tell counts when its attacker can reach you and is aiming at you (or, when it doesn't say, is facing you)
    local function swing(actor, lead, heavy, profile, opts, loose)
        if isMine(actor) then return end
        local attacker = attackerOf(actor)
        if not attacker or isMine(attacker) then return end
        local root = myRoot()
        local attackerRoot = rootOf(actor) or rootOf(attacker)
        if not (root and attackerRoot) then return end
        local distance = (attackerRoot.Position - root.Position).Magnitude
        if distance > REACH then return end
        if not (loose and distance <= LEARN_REACH) then
            local aimed = targetsMe(attacker)
            if aimed == false then return end
            if aimed == nil and not facesMe(attackerRoot, root) then return end
        end
        local atContact = type(opts) == "table" and opts.AtContact == true
        local now = os.clock()
        local at = now + (atContact and 0 or lead)
        local active = type(opts) == "table" and tonumber(opts.ActiveDuration) or ACTIVE
        add({
            from = attacker, kind = "swing", at = at, ends = at + math.max(0.05, active),
            heavy = heavy == true, guardBreak = heavy == true, unblockable = false, big = false,
            profile = type(profile) == "string" and profile or nil,
        })
    end

    -- Effects3.lua:4554 SwingVFX(verb, attacker, profile, comboIndex, isHeavy, delay, speedMult, opts): drawn delay x speedMult after the push
    local function onSwingVfx(actor, profile, _, heavy, delay, speedMult, opts)
        local lead = math.max(0, tonumber(delay) or DEFAULT_LEAD) * (tonumber(speedMult) or 1)
        swing(actor, lead, heavy, profile, opts)
    end

    -- Effects3.lua:5165-5208 PunchTrail(verb, attacker, comboIndex, limb, start, length, profile, isHeavy, speedMult, opts): the hit starts start x speedMult after the push
    local function onPunchTrail(actor, _, _, start, _, profile, heavy, speedMult, opts)
