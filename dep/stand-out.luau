function M.new(utility, makeRay, getCamera)
    local self = { point = nil }
    local original, wrapper = nil, nil

    local function wrapped(u, camera, centered)
        local point = self.point
        local cam = camera or getCamera()
        if centered or not point or not cam then return original(u, camera, centered) end
        local origin, direction = M.ray(cam.CFrame.Position, point)
        if not origin then return original(u, camera, centered) end
        return makeRay(origin, direction)
    end

    function self.install()
        if wrapper or type(utility) ~= "table" then return wrapper ~= nil end
        local current = rawget(utility, "getAimRay")
        if type(current) ~= "function" then return false end
        original = current
        wrapper = wrapped
        utility.getAimRay = wrapper
        return true
    end

