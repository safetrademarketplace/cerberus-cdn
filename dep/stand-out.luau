        local since = mark()
        if not ride then
            local called, err = huberCall()
            if not called then return false, err end
            local ok, code, text = waitFor(function()
                return stateIs("AwaitingBoard") or stateIs("ChoosingDestination")
            end, CALL_WAIT, since)
            if not ok then return false, code, text end
        end
        if stateIs("AwaitingBoard") then
            local boarded, err = huberBoard(opts)
            if not boarded then return false, err end
            local ok, code, text = waitFor(function() return stateIs("ChoosingDestination") end, BOARD_WAIT, since)
            if not ok then return false, code, text end
        end
        if not stateIs("ChoosingDestination") then return false, Errors.WRONG_STATE end
        since = mark()
        local id = ride.Id
        local chose, err = huberChoose(stopId)
        if not chose then return false, err end
        local ok, code, text = waitFor(function()
            return seq.disembark > since.disembark and lastDisembark.id == id
        end, RIDE_WAIT, since)
        if not ok then return false, code, text end
        shared.waitViewZones(opts.viewZonesTimeout)
        return true, lastDisembark.cframe
    end

    return {
        huber          = huber,
        huberCall      = huberCall,
        huberBoard     = huberBoard,
        huberChoose    = huberChoose,
        huberCancel    = huberCancel,
        huberRide      = huberRide,
        huberRideEvent = rideSignal,
        huberDisembark = disembarkSignal,
    }
end

