__bundle_register("Features/Navigation/Teleports/Travel", function(require, _LOADED, __bundle_register, __bundle_modules)
-- teleport travel: one trip at a time through the world api's own movers (travelTo, or huberRide for a paid ride); takes the world claim for the trip and gives it back right after, and never takes it from a feature already moving you
local Jobs = require("Utility/Jobs")

local OWNER = "Teleports"
-- a marker can sit inside geometry; landing within this of it still counts as arrived
local TOLERANCE = 15

-- the claim owner names other features use, in menu words
local FEATURES = {
    AutoQuest   = "Auto Quests",
    AutoGarden  = "Auto Garden",
    Combat      = "Auto Fight",
    KillAura    = "Kill Aura",
    StandRoller = "Stand Roller",
}

local M = {}
M.OWNER = OWNER

function M.busyLine(owner)
    local name = FEATURES[owner]
    if name then return ("%s is moving you right now. Turn it off first."):format(name) end
    return "Another feature is moving you right now. Turn it off first."
end

function M.new(deps)
    local World   = deps.World
    local notify  = deps.notify
    local track   = deps.track or function(x) return x end
    local nearby  = deps.nearby
    local Errors  = World.Errors or {}

    local travel = {}
    local job, token, riding = nil, nil, false

    -- keyed by the api's Errors names, so a code the api lacks is just skipped
    local WORDS = {
        NO_CHARACTER = "Your character isn't in the world right now.",
        DIED         = "You died, so the trip stopped.",
        TIMED_OUT    = "The trip took too long, so it stopped.",
        BAD_ARGS     = "Couldn't work out where that is. Pick it again.",
        GONE         = "That place is gone. Pick another one.",
        CANT_AFFORD  = "You need 50 dalas for a Huber ride.",
        WRONG_STATE  = "A Huber ride is already going.",
        NO_RIDE      = "No Huber ride is going.",
        UNKNOWN_STOP = "Huber doesn't stop there right now.",
        ENDED        = "The Huber ride ended early.",
        NO_PATH      = "Couldn't walk to the Huber car.",
        BLOCKED      = "Couldn't walk to the Huber car.",
    }
    local LINES = {}
    for name, line in pairs(WORDS) do
        if Errors[name] ~= nil then LINES[Errors[name]] = line end
    end

    local function explain(code, text)
        if type(text) == "string" and text ~= "" then return (text:gsub("[<>]", "")) end
        return LINES[code] or "Something went wrong on the way."
    end

    local function letGo()
        if token then pcall(World.release, token) end
        token = nil
    end

    function travel.busy()
        return job ~= nil and job.alive
    end

    function travel.riding()
        return riding and travel.busy()
    end

    -- asks for the claim; another feature's claim is never taken
    local function claim()
        local okOwner, owner = World.owner()
        if okOwner and owner ~= nil and owner ~= OWNER then return false, M.busyLine(owner) end
        local ok, result, holder = World.claim(OWNER)
        if not ok then return false, M.busyLine(holder) end
        token = result
        return true
    end

    local function start(name, body)
        if travel.busy() then
            notify(riding and "You're on a Huber ride. Cancel it first." or "Already on the way.")
            return false
        end
        job = track(Jobs.spawn(function(self)
            local ok, err = pcall(body, self)
            letGo()
            riding = false
            if not ok then notify("Something went wrong on the way.") end
            if job == self then job = nil end
            return err
        end, { name = name }))
        return true
    end

    -- record.resolve answers (position, opts) or (nil, why); settings.avoid / settings.range keep you off other players
    function travel.go(record, settings)
        if type(record) ~= "table" or type(record.resolve) ~= "function" then
            notify("Pick somewhere to go first.")
            return false
        end
        settings = settings or {}
        return start("Teleports.go", function(self)
            local okOwner, owner = World.owner()
            if okOwner and owner ~= nil and owner ~= OWNER then return notify(M.busyLine(owner)) end
            local okSpot, spot, opts = pcall(record.resolve)
            if not self.alive then return end
            if not okSpot or typeof(spot) ~= "Vector3" then
                return notify(type(opts) == "string" and opts or ("Can't find %s right now."):format(record.label))
            end
            opts = type(opts) == "table" and opts or {}
            if settings.avoid and nearby then
                local who = nearby(spot, settings.range, record.userId)
                if who then
                    return notify(("%s is within %d studs of there, so you weren't sent."):format(who, settings.range))
                end
            end
            local claimed, why = claim()
            if not claimed then return notify(why) end
            local arrived, code = World.travelTo(spot, {
                token     = token,
                offset    = opts.offset,
                face      = opts.face,
                tolerance = TOLERANCE,
            })
            letGo()
            if not self.alive then return end
            if arrived then return notify(("Arrived at %s."):format(record.label)) end
            -- the pivot happened; only the settle check missed
            if code == Errors.NOT_ARRIVED or code == Errors.VIEWZONES then
                return notify(("Landed near %s."):format(record.label))
            end
            notify(explain(code))
        end)
    end

    -- a paid huber ride: the api calls the car, walks you to it, boards and picks the stop
    function travel.ride(stop)
        if type(stop) ~= "table" or type(stop.id) ~= "string" then
            notify("Pick a stop first.")
            return false
        end
        return start("Teleports.huber", function(self)
            local claimed, why = claim()
            if not claimed then return notify(why) end
            riding = true
            notify(("Calling a Huber to %s."):format(stop.label))
            local ok, code, text = World.huberRide(stop.id, { token = token, sprint = true })
            letGo()
            riding = false
            if not self.alive then return end
            if ok then return notify(("Arrived at %s."):format(stop.label)) end
            notify(explain(code, text))
        end)
    end

    function travel.cancelRide()
        if not travel.riding() then
            notify("You're not on a Huber ride.")
            return false
        end
        travel.kill()
        notify("Huber ride cancelled.")
        return true
    end

    -- for unload: ends the trip and gives the claim back without a word
    function travel.kill()
        local current = job
        job = nil
        if current then pcall(current.Cancel, current) end
        if riding then pcall(World.huberCancel) end
        riding = false
        letGo()
    end

    return travel
end

return M

end)
__bundle_register("Features/Navigation/Teleports/Places", function(require, _LOADED, __bundle_register, __bundle_modules)
-- teleport places: every destination list read fresh from the game's own data (world api destinations, phone map points, quest offers, world events, pots, players, saved waypoints); a record only says where to land, it never moves you
local EventAlerts = require("Features/Utilities/EventAlerts")

-- you land this far in front of an npc, facing them, and this far behind a player
local NPC_GAP = 4
local PLAYER_GAP = 4
local POT_GAP = 4
-- an area with no landmark inside is landed on by a ray from above its box, after a bounded stream request
local STREAM_WAIT = 2
local RAY_ABOVE = 60
local RAY_DEPTH = 400
-- the filler road zones carry this title; they aren't places anyone travels to
local FILLER_AREA = "O‘ahu"

local CATEGORIES = {
    { key = "places",  label = "Places" },
    { key = "npcs",    label = "NPCs" },
    { key = "quests",  label = "Quest Givers" },
    { key = "huber",   label = "Huber Stops" },
    { key = "spawns",  label = "Spawns" },
    { key = "events",  label = "World Events" },
    { key = "players", label = "Players" },
    { key = "waypoints", label = "Waypoints" },
}

local M = {}
M.CATEGORIES = CATEGORIES

-- "IkoJodio" -> "Iko Jodio", "MarketCrossing" -> "Market Crossing"
function M.pretty(name)
    if type(name) ~= "string" then return "" end
    return (name:gsub("(%l)(%u)", "%1 %2"))
end

-- labels must be unique for the dropdown; a repeat gets a number
local function labeller()
    local used = {}
    return function(base)
        local label, n = base, 1
        while used[label] do
            n = n + 1
            label = ("%s (%d)"):format(base, n)
        end
        used[label] = true
        return label
    end
end

local function flatLook(cframe)
    local look = cframe.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    if flat.Magnitude < 1e-3 then return Vector3.new(0, 0, -1) end
    return flat.Unit
end

local function inside(part, point)
    local ok, rel = pcall(function() return part.CFrame:PointToObjectSpace(point) end)
    if not ok then return false end
    local half = part.Size / 2
    return math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z
end

local function sortByLabel(list)
    table.sort(list, function(a, b) return a.label:lower() < b.label:lower() end)
    return list
end

function M.new(deps)
    local World      = deps.World
    local Activities = deps.Activities
    local Services   = deps.Services
    local References = deps.References
    local Waypoints  = deps.Waypoints

    local Workspace = Services.Workspace
    local RS        = Services.ReplicatedStorage

    local places = {}

    local function read(kind)
        local ok, list = World.destinations(kind)
        if ok and type(list) == "table" then return list end
        return {}
    end

    local function gameChild(name)
        local root = Workspace:FindFirstChild("Game")
        return root and root:FindFirstChild(name) or nil
    end

    local function playerAttr(name)
        local player = References.player
        return player and player:GetAttribute(name)
    end

    -- the phone's own role line for an npc ("Bounties", "Garden shop"), keyed by its display name
    local function npcRoles()
        local roles = {}
        for _, entry in ipairs(read("map")) do
            if entry.mapKind == "NPC" and entry.detail then roles[entry.name] = entry.detail end
        end
        return roles
    end

    -- a marker instance is re-read when you go, so a moved marker is followed
    local function markerResolve(entry, gone)
        local inst, fallback = entry.instance, entry.position
        return function()
            if inst and inst.Parent and inst:IsA("Vector3Value") then return inst.Value, {} end
            if inst and not inst.Parent then return nil, gone end
            return fallback, {}
        end
    end

    -- ===== npcs =====

    local function npcSpot(name)
        local ok, model = World.npc(name)
        if ok and model and model.Parent then
            local root = model:FindFirstChild("HumanoidRootPart")
            local frame = root and root.CFrame or model:GetPivot()
            local at = frame.Position
            return at + flatLook(frame) * NPC_GAP, { face = at, offset = 0 }
        end
        -- streamed out: the phone's marker for them, as NpcTracking.lua:14-37 falls back to
        for _, entry in ipairs(read("npc")) do
            if entry.name == name then return entry.position, {} end
        end
        return nil, ("Can't find %s right now."):format(name)
    end

    function places.npcRecord(name, role)
        return {
            key     = "npc:" .. name,
            label   = role and ("%s - %s"):format(name, role) or name,
            name    = name,
            resolve = function() return npcSpot(name) end,
        }
    end

    local builders = {}

    function builders.npcs()
        local roles = npcRoles()
        local out, seen = {}, {}
        for _, entry in ipairs(read("npc")) do
            if not seen[entry.name] then
                seen[entry.name] = true
                out[#out + 1] = places.npcRecord(entry.name, roles[entry.name])
            end
        end
        return sortByLabel(out)
    end

    -- ===== places: the phone's named locations, then any named area none of them sits in =====

    local function areaSpot(part, title)
        if not (part and part.Parent) then return nil, ("Can't find %s right now."):format(title) end
        -- a known landing spot inside the zone beats guessing at its middle
        for _, kind in ipairs({ "huber_stop", "spawn" }) do
            for _, entry in ipairs(read(kind)) do
                if inside(part, entry.position) then return entry.position, {} end
            end
        end
        local center = part.Position
        World.streamAround(center, STREAM_WAIT)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { References.character }
        pcall(function() params.RespectCanCollide = true end)
        local top = center.Y + part.Size.Y / 2 + RAY_ABOVE
        local ok, hit = pcall(Workspace.Raycast, Workspace, Vector3.new(center.X, top, center.Z), Vector3.new(0, -RAY_DEPTH, 0), params)
        if ok and hit then return hit.Position, {} end
        return nil, ("%s hasn't loaded in yet. Try again in a moment."):format(title)
    end

    function builders.places()
        local out, label = {}, labeller()
        local points = {}
        for _, entry in ipairs(read("map")) do
            if entry.mapKind == "Location" then
                points[#points + 1] = entry.position
                out[#out + 1] = {
                    key     = "place:" .. tostring(entry.id or entry.name),
                    label   = label(entry.name),
                    resolve = markerResolve(entry, ("%s isn't on the map right now."):format(entry.name)),
                }
            end
        end
        -- live: the phone's hospital, school, museum and police points sit just outside their zones, so a same-named zone is dropped too
        local areas = {}
        for _, record in ipairs(out) do areas[record.label:lower()] = true end
        for _, entry in ipairs(read("area")) do
            local part = entry.instance
            if entry.name ~= FILLER_AREA and part and not areas[entry.name:lower()] then
                local covered = false
                for _, point in ipairs(points) do
                    if inside(part, point) then covered = true break end
                end
                if not covered then
                    areas[entry.name:lower()] = true
                    local title = entry.name
                    out[#out + 1] = {
                        key     = "area:" .. title,
                        label   = label(title),
                        resolve = function() return areaSpot(part, title) end,
                    }
                end
            end
        end
        return sortByLabel(out)
    end

    function builders.quests()
        local out, label = {}, labeller()
        for _, entry in ipairs(read("quest_offer")) do
            out[#out + 1] = {
                key     = "quest:" .. tostring(entry.id or entry.name),
                label   = label(entry.name),
                resolve = markerResolve(entry, ("%s isn't offered any more."):format(entry.name)),
            }
        end
        return sortByLabel(out)
    end

    -- the stop model's own DisplayName, else the server's id spelled out
    local function stopName(id)
        local huber = gameChild("Huber")
        local stops = huber and huber:FindFirstChild("Stops")
        local model = stops and stops:FindFirstChild(tostring(id))
        local display = model and model:GetAttribute("DisplayName")
        if type(display) == "string" and display ~= "" then return display end
        return M.pretty(tostring(id))
    end

    -- the stop's road pad is where the game's own riders stand
    local function stopSpot(id, fallback)
        local huber = gameChild("Huber")
        local stops = huber and huber:FindFirstChild("Stops")
        local model = stops and stops:FindFirstChild(tostring(id))
        local pad = model and model:FindFirstChild("RoadStop")
        if pad and pad:IsA("BasePart") then return pad.Position, {} end
        if model then return model:GetPivot().Position, {} end
        if fallback then return fallback, {} end
        return nil, "That Huber stop isn't loaded in."
    end

    -- { id, label } per stop for the ride picker
    function places.huberStops()
        local out, label = {}, labeller()
        for _, entry in ipairs(read("huber_stop")) do
            local id = entry.id ~= nil and entry.id or entry.name
            out[#out + 1] = { id = tostring(id), label = label(stopName(id)), position = entry.position }
        end
        table.sort(out, function(a, b) return a.label:lower() < b.label:lower() end)
        return out
    end

    function builders.huber()
        local out = {}
        for _, stop in ipairs(places.huberStops()) do
            local id, fallback = stop.id, stop.position
            out[#out + 1] = {
                key     = "huber:" .. id,
                label   = stop.label,
                resolve = function() return stopSpot(id, fallback) end,
            }
        end
        return out
    end

    function builders.spawns()
        local out, label = {}, labeller()
        for _, entry in ipairs(read("spawn")) do
            local inst, name = entry.instance, entry.name
            out[#out + 1] = {
                key     = "spawn:" .. name,
                label   = label(M.pretty(name)),
                resolve = function()
                    if inst and inst.Parent then return inst.Position, {} end
                    return nil, ("Can't find the %s spawn right now."):format(M.pretty(name))
                end,
            }
        end
        return sortByLabel(out)
    end

    -- ===== world events: the live ones with a place, then the fixed event sites =====

    local function siteSpot(site)
        local folder = gameChild("WorldEventSites")
        if not (folder and type(site) == "string") then return nil end
        local part = folder:FindFirstChild(site) or folder:FindFirstChild((site:gsub("%s", "")))
        if part and part:IsA("BasePart") then return part.Position end
        return nil
    end

    local function eventSpot(ev)
        if typeof(ev.Position) == "Vector3" then return ev.Position end
        return siteSpot(ev.Site)
    end

    local function liveEvents()
        if not (Activities and Activities.worldEvents) then return {} end
        local ok, list = Activities.worldEvents()
        if ok and type(list) == "table" then return list end
        return {}
    end

    function builders.events()
        local out, label = {}, labeller()
        for _, ev in ipairs(liveEvents()) do
            if type(ev) == "table" and type(ev.EventId) == "string" and ev.Phase ~= "Cleanup" and eventSpot(ev) then
                local name = EventAlerts.label(ev.Id) or M.pretty(tostring(ev.Id))
                if type(ev.Site) == "string" then name = ("%s at %s"):format(name, M.pretty(ev.Site)) end
                local id = ev.EventId
                out[#out + 1] = {
                    key     = "event:" .. id,
                    label   = label(name),
                    resolve = function()
                        for _, now in ipairs(liveEvents()) do
                            if now.EventId == id and now.Phase ~= "Cleanup" then
                                local spot = eventSpot(now)
                                if spot then return spot, {} end
                            end
                        end
                        return nil, "That event is over."
                    end,
                }
            end
        end
        local folder = gameChild("WorldEventSites")
        local sites = {}
        for _, part in ipairs(folder and folder:GetChildren() or {}) do
            if part:IsA("BasePart") then
                sites[#sites + 1] = {
                    key     = "site:" .. part.Name,
                    label   = label(("%s (event site)"):format(M.pretty(part.Name))),
                    resolve = function()
                        if part.Parent then return part.Position, {} end
                        return nil, "That event site is gone."
                    end,
                }
            end
        end
        sortByLabel(sites)
        for _, site in ipairs(sites) do out[#out + 1] = site end
        return out
    end

    -- ===== players =====

    local function playerSpot(userId, shown)
        local player = Services.Players:GetPlayerByUserId(userId)
        if not player then return nil, ("%s left the server."):format(shown) end
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not (root and root:IsA("BasePart")) then
            return nil, ("%s is too far away to see. Get closer first."):format(shown)
        end
        local frame = root.CFrame
        return frame.Position - flatLook(frame) * PLAYER_GAP, { face = frame.Position, offset = 0 }
    end

    function builders.players()
        local out, label = {}, labeller()
        local me = References.player
        for _, player in ipairs(Services.Players:GetPlayers()) do
            if player ~= me and (not me or player.UserId ~= me.UserId) then
                local shown = player.DisplayName ~= "" and player.DisplayName or player.Name
                if shown ~= player.Name then shown = ("%s (@%s)"):format(shown, player.Name) end
                local userId = player.UserId
                out[#out + 1] = {
                    key     = "player:" .. tostring(userId),
                    label   = label(shown),
                    resolve = function() return playerSpot(userId, shown) end,
                }
            end
        end
        return sortByLabel(out)
    end

    function places.waypointRecord(name)
        return {
            key      = "waypoint:" .. name,
            label    = name,
            waypoint = name,
            resolve  = function()
                local point = Waypoints.list[name]
                if typeof(point) == "Vector3" then return point, {} end
                return nil, ("The waypoint %s is gone."):format(name)
            end,
        }
    end

    function builders.waypoints()
        local out = {}
        for _, name in ipairs(Waypoints.order) do
            if Waypoints.list[name] then out[#out + 1] = places.waypointRecord(name) end
        end
        return out
    end

    -- a broken reader leaves its list empty rather than the menu half-built
    function places.build(categoryKey)
        local builder = builders[categoryKey]
        if not builder then return {} end
        local ok, list = pcall(builder)
        if ok and type(list) == "table" then return list end
        return {}
    end

    -- ===== quick spots =====

    -- the quest tracker's marker (PointsController.lua:190-198)
    function places.objective()
        local name = playerAttr("VisibleQuestTrackerName")
        name = type(name) == "string" and name ~= "" and name or nil
        return {
            key     = "objective",
            label   = name or "your quest objective",
            name    = name,
            resolve = function()
                local point = playerAttr("VisibleQuestTrackerPosition")
                if typeof(point) == "Vector3" then return point, {} end
                return nil, "You have no quest objective right now."
            end,
        }
    end

    -- the bounty's marker; it moves to petyr once the bounty is ready to claim
    function places.bounty()
        return {
            key     = "bounty",
            label   = "your bounty marker",
            resolve = function()
                local point = playerAttr("VisibleBountyTrackerPosition")
                if typeof(point) == "Vector3" then return point, {} end
                return nil, "You have no bounty marker right now."
            end,
        }
    end

    -- beside your first pot, else big chop's garden on the phone map
    function places.garden()
        return {
            key     = "garden",
            label   = "your garden",
            resolve = function()
                local folder = gameChild("Gardening")
                local pots = folder and folder:FindFirstChild("Pots")
                local me = References.player and References.player.UserId
                for _, pot in ipairs(pots and pots:GetChildren() or {}) do
                    if me and pot:GetAttribute("OwnerUserId") == me then
                        local frame = pot:GetPivot()
                        return frame.Position + flatLook(frame) * POT_GAP, { face = frame.Position }
                    end
                end
                for _, entry in ipairs(read("map")) do
                    if entry.id == "gardens" then return entry.position, {} end
                end
                return nil, "You have no garden pots yet."
            end,
        }
    end

    return places
end

return M

end)
__bundle_register("Features/Navigation/Subplaces", function(require, _LOADED, __bundle_register, __bundle_modules)
-- lists every place in the current universe and TPs to one; develop.roblox.com via Http.client() (executor forwards .ROBLOSECURITY)
local Http    = require("Utility/Helpers/Http")
local Mount   = require("Utility/Mount")
local UiWrite = require("Utility/UiWrite")

return function(ctx)
    local O = Mount.orchestrator(ctx, "Subplaces")
    if not O then return end

    local Services   = ctx.Services
    local Tabs       = ctx.Tabs
    local Library    = ctx.Library
    local References = ctx.References

    local SubplacesGroup = Tabs.Travel:AddLeftGroupbox("Subplaces", "map")

    local statusLabel = SubplacesGroup:AddLabel({ Text = "Idle.", DoesWrap = true })

    local subplaceDD = SubplacesGroup:AddDropdown("SubplaceTarget", {
        Text       = "Destination",
        Values     = {},
        Default    = nil,
        Multi      = false,
        Searchable = true,
    })

    local labelToPlaceId = {}
    local fetching = false
    local cancelled = false

    O.onUnload(function() cancelled = true end)

    local function setStatus(text)
        if cancelled then return end
        UiWrite.text(statusLabel, text)
    end

    local function fetchSubplaces()
        if fetching then return end
        fetching = true
        setStatus("Fetching subplaces…")

        task.spawn(function()
            local httpRequest = Http.client()
            if not httpRequest then
                setStatus("HTTP request unavailable on this executor.")
                fetching = false
                return
            end

            local universeId = Services.Game.GameId
            if not universeId or universeId == 0 then
                setStatus("No universe ID available.")
                fetching = false
                return
            end

            local collected = {}
            local cursor = nil
            local errMsg = nil
            local MAX_PAGES = 5

            for page = 1, MAX_PAGES do
                if cancelled then fetching = false; return end
                local url = ("https://develop.roblox.com/v1/universes/%d/places?isUniverseCreation=false&limit=100&sortOrder=Asc"):format(universeId)
                if cursor and cursor ~= "" then
                    url = url .. "&cursor=" .. Services.HttpService:UrlEncode(cursor)
                end

                local okCall, res = pcall(httpRequest, {
                    Url = url,
                    Method = "GET",
                    Headers = { ["Content-Type"] = "application/json" },
                })

                if not okCall or type(res) ~= "table" then
                    errMsg = "request failed"
                    break
                end

                local status = res.StatusCode or res.status_code or res.Status
                local ok2xx = type(status) == "number" and status >= 200 and status < 300
                if status == nil and res.Success ~= nil then ok2xx = res.Success == true end
                if not ok2xx then
                    errMsg = "HTTP " .. tostring(status or "error")
                    break
                end

                local body = res.Body or res.body
                if type(body) ~= "string" or body == "" then
                    errMsg = "empty response"
                    break
                end

                local okDec, data = pcall(Services.HttpService.JSONDecode, Services.HttpService, body)
                if not okDec or type(data) ~= "table" or type(data.data) ~= "table" then
                    errMsg = "decode failed"
                    break
                end

                for _, entry in ipairs(data.data) do
                    if entry.id and entry.name then
                        collected[#collected + 1] = { id = entry.id, name = entry.name }
                    end
                end

                cursor = data.nextPageCursor
                if not cursor or cursor == "" then break end
            end

            if #collected == 0 then
                if errMsg == "HTTP 401" or errMsg == "HTTP 403" then
                    setStatus("API rejected request — Roblox only lists subplaces for users with developer access to this universe.")
                elseif errMsg then
                    setStatus("Failed to fetch subplaces: " .. errMsg)
                else
                    setStatus("No subplaces found for this universe.")
                end
                fetching = false
                return
            end

            table.sort(collected, function(a, b)
                return a.name:lower() < b.name:lower()
            end)

            local labels = {}
            local mapping = {}
            local currentPlaceId = Services.Game.PlaceId
            for _, p in ipairs(collected) do
                local label = p.name
                if p.id == currentPlaceId then
                    label = label .. "  (current)"
                end
                -- disambiguate duplicate names by appending the placeId
                if mapping[label] then
                    label = ("%s [%d]"):format(label, p.id)
                end
                labels[#labels + 1] = label
                mapping[label] = p.id
            end

            if cancelled then fetching = false; return end

            labelToPlaceId = mapping
            UiWrite.values(subplaceDD, labels)
            setStatus(("Loaded %d subplace%s."):format(#collected, #collected == 1 and "" or "s"))
            fetching = false
        end)
    end

    SubplacesGroup:AddButton({
        Text = "Teleport",
        Func = function()
            local label = subplaceDD.Value
            local placeId = label and labelToPlaceId[label]
            if not placeId then
                Library:Notify("Pick a subplace first.", 3)
                return
            end
            local ok, err = pcall(function()
                Services.TeleportService:Teleport(placeId, References.player)
            end)
            if not ok then
                Library:Notify("Teleport failed: " .. tostring(err), 4)
            end
        end,
    })

    task.spawn(fetchSubplaces)

    O.finalize()
    return {}
end

end)
__bundle_register("Tabs/Main", function(require, _LOADED, __bundle_register, __bundle_modules)
-- main mount: Instakill (Combat tab)
local Instakill  = require("Features/Main/Instakill")

local function buildBase(ctx)
    return {
