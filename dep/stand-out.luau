        end

        local function updateRingLabels()
            for _, r in ipairs(radar.rings) do
                r.Label.Text = string.format("%d studs", math.floor(r.Percent * radar.range + 0.5))
                r.Label.TextSize = 10 * radar.scale
                r.Label.Position = UDim2.new(0.5, 0, 1, 2 * radar.scale)
            end
        end

        buildRings()
        updateRingLabels()

        do
            local dragging, dragStart, startPos
            track(holder.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                    dragging = true; dragStart = i.Position; startPos = holder.Position
                    -- self-disconnects on drag end; deliberately not tracked — bound to this single InputObject's lifetime
                    local c
                    c = i.Changed:Connect(function()
                        if i.UserInputState == Enum.UserInputState.End then
                            dragging = false
                            if c then c:Disconnect(); c = nil end
                        end
                    end)
                end
            end))
            track(holder.InputChanged:Connect(function(i)
                if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                    Identity.elevate()
                    local d = i.Position - dragStart
                    holder.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale,
                        startPos.Y.Offset + d.Y)
                end
            end))
        end

        local function makeBlip()
            local blip = Instance.new("Frame")
            blip.Name = "Blip"
            blip.AnchorPoint = Vector2.new(0.5, 0.5)
            blip.BorderSizePixel = 0
            blip.ZIndex = 10
            blip.Parent = holder
            local bc = Instance.new("UICorner", blip); bc.CornerRadius = UDim.new(1, 0)
            return blip
        end

        local seen = {}
        radar.conn = track(Scheduler.heartbeat(function()
            -- every wake, because a scheduler callback runs below the identity a frame write or Instance.new needs
            Identity.elevate()
            local root = References.humanoidRootPart
            if not root then
                for _, blip in pairs(radar.blips) do blip.Visible = false end
                return
            end

            local size = holder.AbsoluteSize
            local cx, cy = size.X / 2, size.Y / 2
            local radius = math.min(size.X, size.Y) / 2 - (12 * radar.scale)
            local rangeSqr = radar.range * radar.range
            local invRange = 1 / radar.range
            local blipSize = 8 * radar.scale

            local teamsAvailable = Services.Teams and #Services.Teams:GetChildren() > 0
            local myTeam = Services.Players.LocalPlayer.Team

            local cam = Services.Workspace.CurrentCamera
            local camRight = cam and cam.CFrame.RightVector
            local camForward = cam and cam.CFrame.LookVector
            local cameraMode = (radar.mode == "Camera") and camRight and camForward

            table.clear(seen)
            local rootPos = root.Position
            -- References.player is cloneref'd so `~=` against raw GetPlayers entries is always true; compare UserIds
            local localUserId = References.player and References.player.UserId

            for _, pl in ipairs(Services.Players:GetPlayers()) do
                if pl.UserId ~= localUserId and pl.Character then
                    local hrp = pl.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local d2 = VMath.distanceSqr3(hrp.Position, rootPos)
                        if d2 <= rangeSqr then
                            local rel = hrp.Position - rootPos
                            local rx, rz
                            if cameraMode then
                                rx = rel:Dot(camRight)
                                rz = -rel:Dot(camForward)
                            else
                                rx = rel.X; rz = rel.Z
                            end

                            local px = cx + rx * invRange * radius
                            local py = cy + rz * invRange * radius
                            local isFriendly = teamsAvailable and
                                (pl.Team ~= nil and myTeam ~= nil and pl.Team == myTeam)

                            local blip = radar.blips[pl]
                            if not blip or not blip.Parent then
                                blip = makeBlip()
                                radar.blips[pl] = blip
                            end
                            blip.Size = UDim2.fromOffset(blipSize, blipSize)
                            blip.Position = UDim2.fromOffset(px, py)
                            blip.BackgroundColor3 = isFriendly and Color3.fromRGB(55, 235, 120) or
                                Color3.fromRGB(235, 55, 55)
                            blip.Visible = true
                            seen[pl] = true
                        end
                    end
                end
            end

            -- hide unseen blips; destroy blips for players that left
            for pl, blip in pairs(radar.blips) do
                if not seen[pl] then
                    if not pl.Parent then
                        blip:Destroy()
                        radar.blips[pl] = nil
                    else
                        blip.Visible = false
                    end
                end
            end
        end, { name = "Radar", priority = 200, deferrable = true }))

        radar._holder = holder
        radar._centerIcon = centerIcon
        radar.buildRings = buildRings
        radar.updateRings = updateRingLabels
    end

    RadarGroup:AddToggle("Radar_Enable", {
        Text = "Enable Radar",
        Default = false,
        Callback = function(v) if v then createRadar() else destroyRadar() end end
    })

    local RadarBox = RadarGroup:AddDependencyBox()

    RadarBox:AddSlider("Radar_Range", {
        Text = "Range",
        Default = 500,
        Min = 100,
        Max = 2000,
        Rounding = 0,
        Suffix = " studs",
        Callback = function(v)
            radar.range = v
            if radar.updateRings then
                Identity.elevate()
                radar.updateRings()
            end
        end
    })

    RadarBox:AddSlider("Radar_Scale", {
        Text = "HUD Scale",
        Default = 100,
        Min = 50,
        Max = 200,
        Rounding = 0,
        Suffix = "%",
        Callback = function(v)
            radar.scale = v / 100
            if radar.gui and radar._holder then
                Identity.elevate()
                local h = radar._holder
                h.Size = UDim2.fromOffset(200 * radar.scale, 200 * radar.scale)
                if radar._centerIcon then
                    radar._centerIcon.Size = UDim2.fromOffset(22 * radar.scale, 22 * radar.scale)
                end
                for _, r in ipairs(radar.rings) do
                    r.Label.TextSize = 10 * radar.scale
                    r.Label.Position = UDim2.new(0.5, 0, 1, 2 * radar.scale)
                end
            end
        end
    })

    RadarBox:AddDropdown("Radar_Mode", {
        Text = "Rotation Mode",
        Values = { "Camera", "North" },
        Default = "Camera",
        Callback = function(v) radar.mode = v end
    })

    RadarBox:SetupDependencies({
        { Toggles.Radar_Enable, true },
    })

    return { cleanup = destroyRadar }
end

end)
__bundle_register("Features/Player/Utils", function(require, _LOADED, __bundle_register, __bundle_modules)
-- utils orchestrator: wires the player utility sub-modules (NoClip, Desync, ReplicationLag, AutoUseTool, Zoom, PerformanceMode, RemoveKillBricks, ModSafety, AutoRejoin, AntiAFK, AntiKick, FPSCap, QuickReset)
local Mount            = require("Utility/Mount")
local NoClip           = require("Features/Player/Utils/NoClip")
local Desync           = require("Features/Player/Utils/Desync")
local ReplicationLag   = require("Features/Player/Utils/ReplicationLag")
local AutoUseTool      = require("Features/Player/Utils/AutoUseTool")
local Zoom             = require("Features/Player/Utils/Zoom")
local PerformanceMode  = require("Features/Player/Utils/PerformanceMode")
local RemoveKillBricks = require("Features/Player/Utils/RemoveKillBricks")
local ModSafety        = require("Features/Player/Utils/ModSafety")
local AutoRejoin       = require("Features/Player/Utils/AutoRejoin")
local AntiAFK          = require("Features/Player/Utils/AntiAFK")
local AntiKick         = require("Features/Player/Utils/AntiKick")
local FPSCap           = require("Features/Player/Utils/FPSCap")
local QuickReset       = require("Features/Player/Utils/QuickReset")

return function(ctx)
    local O = Mount.orchestrator(ctx, "Utils")
    if not O then return end

    -- every sub-module still writes to ctx.UtilsGroup; which box that is decides where it lands (character tools on Movement, protection and performance on Server)
    local function groupCtx(group)
        return O.subCtx({
            UtilsGroup  = group,
            quickReset  = ctx.quickReset,
            startNoclip = ctx.startNoclip,
            stopNoclip  = ctx.stopNoclip,
        })
    end

    local characterCtx  = groupCtx(ctx.Tabs.Movement:AddLeftGroupbox("Character", "person-standing"))
    local toolsCtx      = groupCtx(ctx.Tabs.Movement:AddRightGroupbox("Tools", "hammer"))
    local protectionCtx = groupCtx(ctx.Tabs.Server:AddLeftGroupbox("Protection", "shield-check"))
    local performCtx    = groupCtx(ctx.Tabs.Server:AddLeftGroupbox("Performance", "cpu"))
    local cameraCtx     = ctx.CameraGroup and groupCtx(ctx.CameraGroup) or toolsCtx

    -- O.mount registers returned cleanup/destroy with the unloader; direct calls silently leak teardown
    -- original mount order kept so boot-time hooks still install in the sequence they always have
    O.mount(NoClip, characterCtx)
    O.mount(Desync, characterCtx)
    O.mount(ReplicationLag, characterCtx)
    O.mount(AutoUseTool, toolsCtx)
    O.mount(Zoom, cameraCtx)
    O.mount(PerformanceMode, performCtx)
    O.mount(RemoveKillBricks, characterCtx)
    O.mount(ModSafety, protectionCtx)
    O.mount(AutoRejoin, protectionCtx)
    O.mount(AntiAFK, protectionCtx)
    O.mount(AntiKick, protectionCtx)
    O.mount(FPSCap, performCtx)
    O.mount(QuickReset, toolsCtx)

    O.finalize()
    return {}
end

end)
