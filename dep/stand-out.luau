            if rec then
                local delay = now - entry.started
                local weight = rec.hits <= 0 and 1 or math.min(1, share * LEARN_RATE * 2)
                rec.hits = rec.hits + share
                rec.lead = math.max(LEARN_MIN, math.min(LEARN_MAX, rec.lead * (1 - weight) + delay * weight))
