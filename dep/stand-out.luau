    local function module()
        return S.module("Quests")
    end

    local function active()
        return Player.csv("Stats.ActiveQuest")
    end

    local function needQuests()
        local stop = S.need()
        if stop then return nil, stop end
        local Q = module()
        if not Q or type(Q.Quests) ~= "table" then return nil, Errors.NO_MODULE end
        local stats = S.stats()
        if not stats then return nil, Errors.NOT_READY end
        return Q, stats
    end

    local function quests()
        local Q, stats = needQuests()
        if not Q then return false, stats end
        local list = active()
        local objectives = asArray(Player.json("Stats.QuestObjectives"))
        local totals = asArray(Player.json("Stats.QuestObjectivesTotal"))
        local okTracked, tracked = pcall(Q.GetTrackedQuest, stats, list)
        local player = References.player
        local out = {}
        for i, id in ipairs(list) do
            local def = Q.Quests[id]
            local have = type(objectives[i]) == "table" and objectives[i] or {}
            local need = type(totals[i]) == "table" and next(totals[i]) ~= nil and totals[i]
                or (def and type(def.Objectives) == "table" and def.Objectives) or {}
            local title = def and def.Title or id
            if def and type(def.TitleAttribute) == "string" then
                local custom = player:GetAttribute(def.TitleAttribute)
                if type(custom) == "string" and custom ~= "" then title = custom end
            end
            local okPct, percent = pcall(Q.GetQuestPercent, have, need)
            local okCat, category = pcall(Q.GetQuestCategory, id)
            out[i] = {
                id = id, title = title, objectives = have, totals = need,
                percent = okPct and percent or 0,
                tracked = okTracked and tracked == id,
                category = okCat and category or nil,
                definition = def,
            }
        end
        return true, out
    end

    local function completedSet()
        local out = {}
        for _, id in ipairs(Player.csv("Stats.CompletedQuests")) do out[id] = true end
        return out
    end

    local function completed()
        local stop = S.need()
        if stop then return false, stop end
        return true, completedSet()
    end

    local function isCompleted(id)
        if type(id) ~= "string" then return false, Errors.BAD_ARGS end
        local stop = S.need()
        if stop then return false, stop end
        return true, completedSet()[id] == true
    end

    -- the gates the dialogue checks before it offers a quest; (true, ok, reason)
    local function canStart(id)
        if type(id) ~= "string" or id == "" then return false, Errors.BAD_ARGS end
        local Q, stats = needQuests()
        if not Q then return false, stats end
        local def = Q.Quests[id]
        if not def then return true, false, "unknown" end
        if def.ServerOnly then return true, false, "server_only" end
        if contains(active(), id) then return true, false, "active" end
        local now = math.floor(S.now())
        local okRepeat, canRepeat = pcall(Q.CanRepeatQuest, stats, id, now)
        if not okRepeat or not canRepeat then return true, false, "repeat" end
        local level = tonumber(Player.value("Stats.Level")) or 0
        local minimum = tonumber(def.MinimumLevel) or tonumber(def.RequiredLevel)
        if minimum and level < minimum then return true, false, "level" end
        if type(def.Prerequisites) == "table" then
            local done = completedSet()
            for _, pre in ipairs(def.Prerequisites) do
                if not done[pre] then return true, false, "prerequisite" end
            end
        end
        if type(def.RequiredWeather) == "string" and Q.WeatherMatches then
            local okWeather, matches = pcall(Q.WeatherMatches, def.RequiredWeather)
            if not okWeather or not matches then return true, false, "weather" end
        end
