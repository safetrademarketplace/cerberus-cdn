__bundle_register("Features/Auto/Quests/Elimination", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto quests elimination: P9_33B's one contract through the eliminations app verbs (PlayerBountiesApp.lua:1573 start, :1587 cancel) fought by the shared combat engine; only the npc fallback is taken, a real player's contract is cancelled and asked for again later
local SEARCH_WAIT = 20
local SPAWN_WAIT  = 8
local NPC_KIND    = "NPC"   -- PlayerBountiesApp.lua:341, 764

return function(Q, D)
    local Activities = Q.Activities

    local M = {}

    local function current()
        local ok, s = Activities.playerBounty()
        if ok and type(s) == "table" then return s end
        return nil
    end

    -- PlayerBountiesApp.lua:764-765: the pushed Character, else the model named CharacterName under Game.Players
    local function npcModel(s)
        if type(s) ~= "table" then return nil end
        local char = s.Character
        if typeof(char) == "Instance" and char.Parent then return char end
        if type(s.CharacterName) == "string" and s.CharacterName ~= "" then
            return D.gamePath({ "Players", s.CharacterName })
        end
        return nil
    end

    function M.run()
        local engine = Q.engine()
        if not engine then return false, "no_engine" end
        local s = current()
        if not (s and s.State == "Active") then
            if not (s and (s.State == "Searching" or s.State == "Completing")) then
                Q.say("Taking a contract")
                local ok, err = Activities.startPlayerBounty()
                if not ok and err ~= Activities.Errors.ALREADY_ACTIVE then return false, err end
            end
            -- PlayerBountiesApp.lua:1187-1196: a failed search or a cancel ends it
            s = D.waitFor(function()
                local c = current()
                if c and (c.State == "Active" or c.SearchFailed or c.State == "Cancelled" or c.State == "Idle") then return c end
                return nil
            end, SEARCH_WAIT)
            if not s then
                if not D.alive() then return false, "died" end
                return false, "no_target", "No elimination target"
            end
            if s.State ~= "Active" then return false, "no_target", "No elimination target" end
        end
        if s.Kind ~= NPC_KIND then
            Activities.cancelPlayerBounty()
            return false, "player_target", "Only player targets now"
        end
        local model = npcModel(s)
        if not model and typeof(s.Position) == "Vector3" then
            local ok, err = D.goTo(s.Position, "the target")
            if not ok then return false, err end
            model = D.waitFor(function() return npcModel(current() or s) end, SPAWN_WAIT)
        end
        if not model then
            if not D.alive() then return false, "died" end
            return false, "missing"
        end
        Q.say("Fighting the target")
        local ok, reason = engine.fight(model, { owner = Q.owner, token = Q.token })
        if ok then return true end
        if not D.alive() then return false, "died" end
        return false, reason
    end

    return M
end

end)
__bundle_register("Features/Auto/Quests/Darby", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto quests darby: plays d'arby's go fish wager for P9_33A over the StandStorage verbs the client sends (GoFish.lua:299-312, 2489-2602, 2841); asks first for a suit he is known to hold, never one he just denied, else your biggest stack; a loss is retried by the driver
local SYMBOLS = { "Jelly", "Fish", "Beyond", "Humu", "Shark", "Frog", "Seal", "Bass" }   -- Modules.StandStorage.lua:12
-- Modules.StandStorage.lua:40-51: the client plays each event this long before it lets you act (GoFish.lua:2361-2397)
local TIMING = { Deal = 2.2, Ask = 0.9, Give = 1, GoFish = 0.8, Draw = 1.1, Book = 1.3, Refill = 0.9, Turn = 0.45, Warn = 0.4, End = 1.2 }
local PROMPT = "StandStorageOpen"   -- StandStorage.lua:1437 on darby's HumanoidRootPart
local PROMPT_WAIT = 4
local OPEN_WAIT = 6
local INTRO_WAIT = 3
local START_WAIT = 8
-- GoFish.lua:3234: the client re-arms its controls when no events came back in 5 s
local REPLY_WAIT = 5
local RESULT_WAIT = 4
local CLOSE_WAIT = 3
local GAME_LIMIT = 300
local POLL = 0.1

-- what you can know of darby's hand from the event log alone: a suit he asked for, cards you gave him, a lucky draw he showed; a "go fish" he answered holds until he draws an unseen card
local function newBrain()
    local B = { known = {}, absent = {}, asked = nil }
    for _, s in ipairs(SYMBOLS) do
        B.known[s], B.absent[s] = 0, false
    end

    local function forgetAbsent()
        for s in pairs(B.absent) do B.absent[s] = false end
    end

    -- GoFish.lua:1854-2358 event shapes: Kind, By, Symbol, Count, From, Lucky
    function B.event(e)
        local kind, mine, sym = e.Kind, e.By == "You", e.Symbol
        if sym ~= nil and B.known[sym] == nil then sym = nil end
        if kind == "Ask" then
            if mine then
                B.asked = sym
            elseif sym then
                B.known[sym] = math.max(B.known[sym], 1)
                B.absent[sym] = false
            end
        elseif kind == "Give" and sym then
            if e.From == "You" then
                B.known[sym] = B.known[sym] + (tonumber(e.Count) or 1)
            else
                B.known[sym], B.absent[sym] = 0, true
            end
        elseif kind == "GoFish" and mine then
            local s = sym or B.asked
            if s then B.known[s], B.absent[s] = 0, true end
        elseif kind == "Draw" and not mine then
            if e.Lucky and sym then
                B.known[sym] = B.known[sym] + 1
            else
                forgetAbsent()
            end
        elseif kind == "Refill" and not mine then
            forgetAbsent()
        elseif kind == "Book" and sym then
            B.known[sym], B.absent[sym] = 0, false
        end
    end

    -- a known suit always hits; otherwise the biggest stack he hasn't just denied, which wins ~58% against a random or memory asker (offline sim)
    function B.pick(hand)
        local best, bestScore = nil, nil
        for _, s in ipairs(SYMBOLS) do
            local n = type(hand) == "table" and tonumber(hand[s]) or 0
            if n and n > 0 then
                local score
                if B.known[s] > 0 then
                    score = 10 + n
                elseif B.absent[s] then
                    score = -1 + n * 0.01
                else
                    score = n
                end
                if bestScore == nil or score > bestScore then best, bestScore = s, score end
            end
        end
        return best
    end

    return B
end

return function(Q, D)
    local Activities = Q.Activities
    local World      = Q.World
    local Net        = Q.Net

    local M = { newBrain = newBrain, SYMBOLS = SYMBOLS }

    local function symbolIndex(sym)
        local ok, Storage = Net.module("StandStorage")
        local list = ok and type(Storage) == "table" and type(Storage.Fish) == "table" and Storage.Fish.Symbols or SYMBOLS
        for i, s in ipairs(list) do
            if s == sym then return i end
        end
        return nil
    end

    local function openState()
        local ok, st = Activities.standStorage()
        if not ok or type(st) ~= "table" or type(st.state) ~= "table" then return nil end
        return st.state
    end

    local function darbyPrompt(model)
        local root = model:FindFirstChild("HumanoidRootPart")
        local prompt = root and root:FindFirstChild(PROMPT)
        if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled then return prompt end
        return nil
    end

    -- one wager at the table; g holds what the pushes said so far
    local function session(model, inbox)
        local g = { view = nil, started = false, denied = nil, ended = nil, result = nil, closed = false, readyAt = 0, waiting = nil }
        local brain = newBrain()

        local function send(verb, arg)
            g.waiting = os.clock()
            return Net.fireAllowed("StandStorage", verb, arg)
        end

        -- StandStorage.lua:1869-1880 and GoFish.lua:3125-3204
        local function drain()
            while #inbox > 0 do
                local msg = table.remove(inbox, 1)
                local verb, p = msg.verb, msg.payload
                if verb == "Close" then
                    g.closed = true
                elseif verb == "FishResult" and type(p) == "table" then
                    g.result = p
                elseif verb == "Fish" and type(p) == "table" then
                    if type(p.Denied) == "string" then
                        g.denied, g.waiting = p.Denied, nil
                    end
                    if p.Started then g.started = true end
                    if type(p.Events) == "table" then
                        g.waiting = nil
                        local pace = 0
                        local fast = #p.Events > 8
                        for _, e in ipairs(p.Events) do
                            if type(e) == "table" then
                                brain.event(e)
                                pace = pace + (TIMING[e.Kind] or 0.5) * (fast and 0.4 or 1)
                                if type(e.View) == "table" and type(e.View.Hand) == "table" then g.view = e.View end
                                if e.Kind == "End" then g.ended = e end
                            end
                        end
                        g.readyAt = math.max(g.readyAt, os.clock()) + pace
                    end
                end
            end
        end

        -- GoFish.lua:1113-1161 canAsk/canDraw/canGive, then the matching send
        local function act()
            local v = g.view
            if not v or g.ended or os.clock() < g.readyAt then return end
            if g.waiting and os.clock() - g.waiting < REPLY_WAIT then return end
            local action = v.Action
            if type(action) == "table" then
                if action.Kind == "Give" then return send("FishGive", action.Id) end
                if action.Kind == "Draw" then return send("FishDraw", action.Id) end
                return
            end
            if v.Turn ~= "You" then return end
            local sym = brain.pick(v.Hand)
            local index = sym and symbolIndex(sym)
            if index then send("FishAsk", index) end
        end

        -- GoFish.lua:2596-2602 then StandStorage.lua:884-891; the server's Close push restores the game's camera
        local function leave()
            drain()
            if g.started then Net.fireAllowed("StandStorage", "FishLeave") end
            if openState() then Activities.standStorageClose() end
            D.waitFor(function()
                drain()
                return g.closed or openState() == nil
            end, CLOSE_WAIT)
        end

        local state = openState()
        if not state then
            local prompt = D.waitFor(function() return darbyPrompt(model) end, PROMPT_WAIT)
            if not prompt then
                if not D.alive() then return false, "died" end
                return false, "no_prompt"
            end
            Q.say("Opening Darby's table")
            local ok, err = World.firePrompt(prompt)
            if not ok then return false, err end
            state = D.waitFor(openState, OPEN_WAIT)
            if not state then
                if not D.alive() then return false, "died" end
                -- live 2026-11-17: after rejoins the server answered the prompt with nothing at all
                return false, "not_open", "Darby's table won't open"
            end
            if not D.sleep(INTRO_WAIT) then
                leave()
                return false, "stopped"
            end
        end

        -- StandStorage.lua:680: slot 1 is a challenge only while the story wager is unwon and a seat is free
        local wager = type(state.State) == "table" and state.State.Wager or nil
        if type(wager) ~= "table" then
            leave()
            return false, "no_wager", "Darby won't play"
        end
        if wager.SeatsFull then
            leave()
            return false, "seats_full", "Darby's table is full"
        end
        if not (wager.Story and not wager.Won) and not wager.Bounty then
            leave()
            return false, "no_wager", "Darby won't play"
        end

        Q.say("Playing Go Fish")
        drain()
        send("FishStart", nil)
        local started = D.waitFor(function()
            drain()
            return g.started or g.denied ~= nil
        end, START_WAIT)
        if not started or not g.started then
            leave()
            if not D.alive() then return false, "died" end
            return false, "denied", "Darby refused the game"
        end

        local deadline = os.clock() + GAME_LIMIT
        while not g.ended and not g.closed and not g.result do
            drain()
            act()
            if not D.alive() then
                leave()
                return false, "died"
            end
            if os.clock() >= deadline then
                leave()
                return false, "timeout"
            end
            if not D.sleep(POLL) then
                leave()
                return false, "stopped"
            end
        end
        D.waitFor(function()
            drain()
            return g.result ~= nil or g.closed
        end, RESULT_WAIT)

        local winner = (g.result and g.result.Winner) or (g.ended and g.ended.Winner)
        local practice = g.result and g.result.Practice == true
        leave()
        if winner == "You" and not practice then
            Q.say("Beat Darby")
            return true
        end
        if not D.alive() then return false, "died" end
        return false, "lost", "Lost to Darby"
    end

    function M.run(q)
        if not Net then return false, "no_net", "Card game needs you" end
        -- already seated at an open table: moving could end it, so play where you are
        local model, err
        if openState() then
            model = D.npc("Darby")
        else
            model, err = D.reachNpc(q, "Darby")
        end
        if not model then return false, err or "missing" end
        local inbox = {}
        local handle = Net.on("StandStorage", function(verb, payload)
            inbox[#inbox + 1] = { verb = verb, payload = payload }
        end)
        if not handle then return false, "no_remote" end
        -- the listener lives only for this one call, so it is always dropped here, even when the session throws
        local results = table.pack(pcall(session, model, inbox))
        handle:Disconnect()
        if not results[1] then
            Q.log("darby wager failed: %s", tostring(results[2]))
            return false, "error"
        end
        return table.unpack(results, 2, results.n)
    end

    return M
end

end)
__bundle_register("Features/Auto/Quests/Contracts", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto quests contracts: elimination contracts taken back to back for xp (Bounty.lua:254-256, a fifth of a level bar each), npc targets only; a player target is cancelled and the next ask waits out a back-off, since the server's own cooldown isn't visible on the client (PlayerBountiesApp.lua:1559-1587 only gates presses for 1-5 s)
local Elimination = require("Features/Auto/Quests/Elimination")

-- the client holds a cancel press for 5 s (PlayerBountiesApp.lua:1576-1585); a few more keep us off the server's edge
local AFTER_PLAYER   = 15
local AFTER_EMPTY    = 30
local AFTER_FAIL     = 20
local MAX_BACKOFF    = 120
local FINISH_WAIT    = 10

return function(Q, D)
    -- one runner per quest job, so the story and the side pass share its back-off
    if Q.contractRunner then return Q.contractRunner end
    local Activities = Q.Activities
    local elimination = Elimination(Q, D)

    local C = { done = 0 }
    local waitUntil, misses = -math.huge, 0

    local function state()
        local ok, s = Activities.playerBounty()
        return ok and type(s) == "table" and s or nil
    end

    local function backOff(seconds)
        misses = misses + 1
        waitUntil = os.clock() + math.min(MAX_BACKOFF, seconds * misses)
    end

    -- seconds until the next ask, or nil when one may go now; an open contract never waits
    function C.cooldown()
        local s = state()
        if s and (s.State == "Active" or s.State == "Searching") then return nil end
        local left = waitUntil - os.clock()
        if left > 0 then return math.ceil(left) end
        return nil
    end

    -- (done, why, label): one contract taken, fought and seen finished; never retried inside one call
    function C.run()
        local left = C.cooldown()
        if left then return false, "cooldown", ("Next contract in %ds"):format(left) end
        local ok, why, label = elimination.run()
        if ok then
            -- PlayerBountiesApp.lua:1187-1189: Completed (then Idle) is the server's word that it counted
            D.waitFor(function()
                local s = state()
                return not s or s.State ~= "Active"
            end, FINISH_WAIT)
            misses = 0
            C.done = C.done + 1
            return true
        end
        if why == "died" or why == "stopped" or why == "no_engine" then return false, why, label end
        if why == "player_target" then
            backOff(AFTER_PLAYER)
        elseif why == "no_target" then
            backOff(AFTER_EMPTY)
        else
            backOff(AFTER_FAIL)
        end
        return false, why, label
    end

    -- (status, busy) for a pass that only farms contracts
    function C.step()
        local ok, why, label = C.run()
        if ok then return "Contract done", true end
        if why == "died" then return "Waiting to respawn", true end
        if why == "stopped" then return nil, true end
        if why == "no_engine" then return "Fight engine missing", false end
        if why == "cooldown" then
            Q.waiting = label
            return label, false
        end
        if why == "player_target" then return "Only player targets", false end
        if why == "no_target" then return "No contract targets", false end
        return label or "Contract failed", false
    end

    Q.contractRunner = C
    return C
end

end)
__bundle_register("Features/Auto/Quests/Side", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto quests side: the side quests, dailies, bobby's hamon training, petyr's bounties and repeat elimination contracts you tick, each started at its giver once the game's own gates allow it (level, weather, prerequisites, CanRepeatQuest) and then driven objective by objective; a quest whose next step nobody can automate is skipped with a short status
local ArmWrestle = require("Features/Auto/Quests/ArmWrestle")
local Contracts = require("Features/Auto/Quests/Contracts")
local Errands   = require("Features/Auto/Quests/Errands")

local PETYR_GATE = "P9_32_RETURN_TO_IKO_IKO"
local START_WAIT = 8
local RAINBOW_NEAR = 25
local CAPTURE_WAIT = 30
local TALK_SETTLE = 1

-- bobby's hamon line (Quests.lua:91-157); bubbles, bounty and water start at bobby, the humu fight starts itself after the water
