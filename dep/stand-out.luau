    -- loadCombatValues (PlayerController.lua:4050-4058): the override's definition, else the base stand's
    function S.standDef(char)
        char = char or S.character()
        local Stands = S.mod("Stands")
        if not (char and Stands and type(Stands.GetDefinition) == "function") then return nil end
        local name = S.standName()
        if name == "" then return nil end
        local ok, def = S.game(Stands.GetDefinition, Stands, char, name)
        if ok and type(def) == "table" then return def end
        local okBase, baseDef = S.game(Stands.GetDefinition, Stands, char, S.data("Stand"))
        if okBase and type(baseDef) == "table" then return baseDef end
        return nil
    end

    -- workspace.Game.Stands[<name>] is an ObjectValue whose Value is the stand model (Utility.lua:2762)
    function S.standModel()
        local player = References.player
        if not player then return nil end
        if S.World and S.World.standOf then
            local ok, model = S.World.standOf(player.Name)
            if ok then return model end
            return nil
        end
        local root = Workspace:FindFirstChild("Game")
        local stands = root and root:FindFirstChild("Stands")
        local value = stands and stands:FindFirstChild(player.Name)
        local model = value and value:IsA("ObjectValue") and value.Value or nil
        if model and model.Parent then return model end
        return nil
    end

    -- Utility:isActivelyPiloting (Utility.lua:6739-6748)
    function S.piloting(char)
        char = char or S.character()
        if not char then return false end
        local active = char:GetAttribute("ActivePiloting")
        if type(active) == "boolean" then return active end
        return char:GetAttribute("Piloting") == true
    end

    function S.isStunned(char)
        char = char or S.character()
        return S.life.stunned or (char ~= nil and char:GetAttribute("Stunned") == true)
    end

    function S.timeStopped(char)
        char = char or S.character()
        return char ~= nil and not char:GetAttribute("TimestopImmune") and char:GetAttribute("TimeStopped") == true
    end

