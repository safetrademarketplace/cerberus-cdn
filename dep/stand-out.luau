__bundle_register("Utility/Helpers/Move", function(require, _LOADED, __bundle_register, __bundle_modules)
-- physics-driven move-to-position via AlignPosition/AlignOrientation, noclip-refcount aware
local Str       = require("Utility/Helpers/Str")
local Scheduler = require("Utility/Scheduler")

return function(ctx, Helpers)
    local References = ctx.References
    local NewMaid    = ctx.NewMaid

    -- random per-session name: HRP children replicate to the server, so no brand string
    local MOVER_NAME = "_mv" .. Str.randomHex(8)

    function Helpers.MoveToPos(targetPos, studsPerSecond, dynamicTargetFunc)
        studsPerSecond = math.max(0, tonumber(studsPerSecond) or 0)
        if studsPerSecond == 0 then
            Helpers.stopNoclip()
            return function() end
        end

        Helpers.startNoclip()
        local maid = NewMaid()

        local hrp = References.humanoidRootPart
        local hum = References.humanoid

        for _, v in ipairs(hrp:GetChildren()) do
            if v.Name == MOVER_NAME then
                v:Destroy()
            end
        end

        if hum then hum.AutoRotate = false end
        hrp.AssemblyAngularVelocity = Vector3.zero

        local a0 = Instance.new("Attachment")
        a0.Name = MOVER_NAME
        a0.Parent = hrp
        maid:GiveTask(a0)

        local ap = Instance.new("AlignPosition")
        ap.Name = MOVER_NAME
        ap.Mode = Enum.PositionAlignmentMode.OneAttachment
        ap.Attachment0 = a0
        ap.ApplyAtCenterOfMass = true
        ap.Responsiveness = 200
        -- finite 1e7, not math.huge: avoids the infinite-force-constraint anti-cheat heuristic
        ap.MaxForce = 1e7
        ap.MaxVelocity = studsPerSecond
        ap.Position = targetPos
        ap.Parent = hrp
        maid:GiveTask(ap)

        local ao = Instance.new("AlignOrientation")
        ao.Name = MOVER_NAME
        ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
        ao.Attachment0 = a0
        ao.Responsiveness = 100
        ao.RigidityEnabled = true
        ao.MaxTorque = 1e7
        ao.Parent = hrp
        maid:GiveTask(ao)

        local alive = true
        local startT = os.clock()
        local isDynamic = type(dynamicTargetFunc) == "function"

        local function cleanup()
            if not alive then return end
            alive = false

            maid:DoCleaning()

            if hum then hum.AutoRotate = true end
            Helpers.stopNoclip()
        end

        local conn = Scheduler.heartbeat(function()
            if not alive then return end

            if not (hrp and hrp.Parent) then
                cleanup()
                return
            end

            local targetNow = isDynamic and dynamicTargetFunc() or targetPos
            if not targetNow then
                cleanup()
                return
            end

            ap.Position = targetNow

            -- flatten orientation so the character stays upright
            local flatTarget = Vector3.new(targetNow.X, hrp.Position.Y, targetNow.Z)
            if (flatTarget - hrp.Position).Magnitude > 0.001 then
                ao.CFrame = CFrame.lookAt(hrp.Position, flatTarget)
            end

            if (hrp.Position - targetNow).Magnitude <= 3 then
                cleanup()
                return
            end

            -- timeout only applies to static points
            if not isDynamic and (os.clock() - startT) > 15 then
                cleanup()
            end
        end, { name = "MoveToPos", priority = 50 })
        maid:GiveTask(conn)

        return cleanup
    end
end

end)
__bundle_register("Utility/Helpers/Noclip", function(require, _LOADED, __bundle_register, __bundle_modules)
-- refcounted noclip: the stepped-lane task persists until every start is matched by a stop
local Scheduler = require("Utility/Scheduler")

return function(ctx, Helpers)
    local References = ctx.References

    local noclipConn
    local refCount = 0
    local prior = setmetatable({}, { __mode = "k" })

    -- BasePart cache kept current by DescendantAdded/Removing so the stepped loop never re-walks GetDescendants
    local partSet = setmetatable({}, { __mode = "k" })
    local charConns = {}

    local function disconnectCharConns()
        for i = #charConns, 1, -1 do
            local c = charConns[i]
            charConns[i] = nil
            pcall(function() c:Disconnect() end)
        end
    end

    local function addPart(part)
        if part:IsA("BasePart") then partSet[part] = true end
    end

    local function rebuildCache()
        table.clear(partSet)
        disconnectCharConns()
        local char = References.character
        if not char then return end
        for _, d in ipairs(char:GetDescendants()) do addPart(d) end
        charConns[#charConns + 1] = char.DescendantAdded:Connect(addPart)
        charConns[#charConns + 1] = char.DescendantRemoving:Connect(function(inst)
            partSet[inst] = nil
        end)
    end

    local function clearPrior()
        prior = setmetatable({}, { __mode = "k" })
        rebuildCache()
    end
    References.onCharacter(clearPrior)
    References.onCharacterRemoving(function()
        prior = setmetatable({}, { __mode = "k" })
        table.clear(partSet)
        disconnectCharConns()
    end)

    function Helpers.startNoclip()
        refCount = refCount + 1
        if noclipConn then return end
        if next(partSet) == nil then rebuildCache() end

        noclipConn = Scheduler.stepped(function()
            if not References.character then return end
            for part in pairs(partSet) do
                if part.Parent then
                    if prior[part] == nil then prior[part] = part.CanCollide end
                    part.CanCollide = false
                else
                    partSet[part] = nil
                end
            end
        end, { name = "Noclip", priority = 50 })
    end

    function Helpers.stopNoclip()
        refCount = math.max(0, refCount - 1)
        if refCount > 0 or not noclipConn then return end
        noclipConn:Disconnect()
        noclipConn = nil
        for part, value in pairs(prior) do
            pcall(function() part.CanCollide = value end)
        end
        prior = setmetatable({}, { __mode = "k" })
    end
end

end)
__bundle_register("Utility/BuildStamp", function(require, _LOADED, __bundle_register, __bundle_modules)
-- build age: turns Meta.builtAt (stamped by build.sh) into the phrase the boot notification reads, "last updated 3 hours ago"

local Meta = require("Meta")

local MINUTE = 60
local HOUR   = 60 * MINUTE
local DAY    = 24 * HOUR
local WEEK   = 7 * DAY

local M = {}

local function count(n, unit)
    n = math.floor(n)
    return ("%d %s%s"):format(n, unit, n == 1 and "" or "s")
end

-- builtAt is unix seconds and the real answer; the date-only `updated` is the fallback for a
-- bundle built before the stamp existed, and noon keeps that guess inside a day of the truth
local function stampedAt()
    local epoch = tonumber(Meta.builtAt)
    if epoch and epoch > 0 then return epoch end

    local y, m, d = tostring(Meta.updated or ""):match("^(%d%d%d%d)%-(%d%d)%-(%d%d)$")
    if not y then return nil end
    local ok, guess = pcall(os.time, { year = tonumber(y), month = tonumber(m), day = tonumber(d), hour = 12 })
    return ok and guess or nil
end

-- how long ago this build was made, in plain english. weeks is the largest unit on purpose:
-- past that the number is the point, not the calendar. a clock skewed ahead reads as "just now"
function M.relative(now)
    local at = stampedAt()
    if not at then return nil end

    local delta = (now or os.time()) - at
    if delta < 0      then delta = 0 end
    if delta < MINUTE then return "just now" end
    if delta < HOUR   then return count(delta / MINUTE, "minute") .. " ago" end
    if delta < DAY    then return count(delta / HOUR,   "hour")   .. " ago" end
    if delta < WEEK   then return count(delta / DAY,    "day")    .. " ago" end
    return count(delta / WEEK, "week") .. " ago"
end

-- the boot line itself; with no stamp to work from it degrades to whatever date Meta carries
function M.describe()
    local rel = M.relative()
    if rel then return "Last updated " .. rel end
    return "Last updated " .. tostring(Meta.updated or "unknown")
end

return M

end)
__bundle_register("Utility/Maid", function(require, _LOADED, __bundle_register, __bundle_modules)
-- quenty nevermore Maid, forked: luau types stripped for luabundler and every task dispatched under pcall, because upstream lets one throwing task abort the rest of DoCleaning
local Log = require("Utility/Log")

local Maid = {}
Maid.ClassName = "Maid"

-- one task's failure is logged and skipped, never allowed to abort the sweep
local function runTask(job)
	local ok, err = pcall(function()
		if typeof(job) == "function" then
			job()
		elseif typeof(job) == "table" then
			if type(job.Destroy) == "function" then
				job:Destroy()
			end
		elseif typeof(job) == "Instance" then
			job:Destroy()
		elseif typeof(job) == "thread" then
			local cancelled
			if coroutine.running() ~= job then
				cancelled = pcall(function()
					task.cancel(job)
				end)
			end

			if not cancelled then
				task.defer(function()
					task.cancel(job)
				end)
			end
		elseif typeof(job) == "RBXScriptConnection" then
			job:Disconnect()
		end
	end)
	if not ok then
		Log.devwarn("Maid", "task failed during cleanup: %s", tostring(err))
	end
end

function Maid.new()
	return setmetatable({ _tasks = {} }, Maid)
end

function Maid.isMaid(value)
	return type(value) == "table" and value.ClassName == "Maid"
end

function Maid.__index(self, index)
	if Maid[index] then
		return Maid[index]
	else
		return self._tasks[index]
	end
end

function Maid.__newindex(self, index, newTask)
	if Maid[index] ~= nil then
		error(string.format("Cannot use '%s' as a Maid key", tostring(index)), 2)
	end

	local tasks = self._tasks
	local job = tasks[index]

	if job == newTask then
		return
	end

	tasks[index] = newTask

	if job then
		runTask(job)
	end
end

function Maid:Add(taskItem)
	if not taskItem then
		error("Task cannot be false or nil", 2)
	end

	self[#self._tasks + 1] = taskItem

	if type(taskItem) == "table" and not taskItem.Destroy then
		Log.warn("[Maid.Add] - Gave table task without .Destroy\n\n" .. debug.traceback())
	end

	return taskItem
end

function Maid:GiveTask(taskItem)
	if not taskItem then
		error("Task cannot be false or nil", 2)
	end

	local taskId = #self._tasks + 1
	self[taskId] = taskItem

	if type(taskItem) == "table" and not taskItem.Destroy then
		Log.warn("[Maid.GiveTask] - Gave table task without .Destroy\n\n" .. debug.traceback())
	end

	return taskId
end

function Maid:GivePromise(promise)
	if not promise:IsPending() then
		return promise
	end

	local newPromise = promise.resolved(promise)
	local id = self:GiveTask(newPromise)

	newPromise:Finally(function()
		self[id] = nil
	end)

	return newPromise
end

-- second fork delta: upstream drains with `next()`, so unwinding GiveTask's ascending integer keys in reverse is what gives callers LIFO
function Maid:DoCleaning()
	local tasks = self._tasks

	-- connections first, so a watcher can't fire on a state-restoring task and undo it
	for index, job in pairs(tasks) do
		if typeof(job) == "RBXScriptConnection" then
			tasks[index] = nil
			runTask(job)
		end
	end

	local highest = 0
	for index in pairs(tasks) do
		if type(index) == "number" and index > highest then highest = index end
	end
	for i = highest, 1, -1 do
		local job = tasks[i]
		if job ~= nil then
			tasks[i] = nil
			runTask(job)
		end
	end

	local index, job = next(tasks)
	while job ~= nil do
		tasks[index] = nil
		runTask(job)
		index, job = next(tasks)
	end
end

Maid.Destroy = Maid.DoCleaning

return Maid

end)
