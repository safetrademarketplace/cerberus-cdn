-- server intel: one watcher of this server's rare spawns feeding the discord alerts (Misc → Server), auto server hop (Misc → Server) and the arrow hunt route (Auto → Gathering); needs ctx.ConfigSecrets and ctx.SaveManager passed through
local Log       = require("Utility/Log")
local Mount     = require("Utility/Mount")
local Alerts    = require("Features/Auto/ServerIntel/Alerts")
local ArrowHunt = require("Features/Auto/ServerIntel/ArrowHunt")
local Hop       = require("Features/Auto/ServerIntel/Hop")
