__bundle_register("Features/Auto/MobFarm", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto mob farm: fights the world's respawning mobs you pick (models with NPCSpawnPivot) through the shared combat engine, latching one target and taking the nearest next, cycling the spawn camps it has learned when the area is empty, picking up drops and learning which mobs take no damage and how much xp each gives; it claims World movement for one pass at a time and yields to world events
local Jobs    = require("Utility/Jobs")
local Log     = require("Utility/Log")
local Mount   = require("Utility/Mount")
local Status  = require("Utility/Status")
local Store   = require("Utility/Store")
local UiWrite = require("Utility/UiWrite")
local Farms   = require("Utility/Farms")
local FarmSettings = require("Utility/FarmSettings")
local Engage  = require("Features/Combat/Engage")
local WorldEvents = require("Features/Auto/WorldEvents")
local Catalog = require("Features/Auto/MobFarm/Catalog")

local OWNER = "AutoMobFarm"
local FARM = "MobFarm"
local ACT_TICK = 0.1
local IDLE_TICK = 1
local SCAN_EVERY = 3
local SAVE_EVERY = 30
local FIGHT_POLL = 0.2
local FIGHT_TIMEOUT = 120
-- a target the engine gave up on is left alone this long
local SKIP_FOR = 90
-- two no-damage verdicts on one type and it is dropped for the session
local IMMUNE_LIMIT = 2
-- a camp found empty is not checked again for this long
local EMPTY_COOLDOWN = 45
-- after a trip, streaming needs a moment before the mobs there exist on the client
local ARRIVE_SETTLE = 1.5
-- a mob wanders this far from its spawn point (live 2026-11-17: beach seals sat 20-40 studs off their pivots)
local WANDER = 40
local WALK_RANGE = 200
local NEAR_ENOUGH = 15
-- the server's xp push can trail the kill
local XP_WAIT = 2
local LOOT_SETTLE = 0.6
local LOOT_RADIUS = 30
local LOOT_MAX = 4
local REST_RESUME = 90
local REST_STALL = 15
local STORE_NS = Store.GAME .. "/mobfarm"
local STORE_KEY = "spawns"

local M = {}

local enabled, acting, wanting = false, false, false
-- true while the farm is on and fighting or walking right now; the farm controller's view
function M.active() return enabled and acting end
-- true while the farm is on and has mobs or camps to go to
function M.wants() return enabled and wanting end

function M.mount(ctx)
    local O = Mount.orchestrator(ctx, "AutoMobFarm")
    if not O then return end
    local Api = ctx.Api or {}
    local World, Player, Combat = Api.World, Api.Player, Api.Combat
    if not (World and World.combatants and World.claim and Player) then
        Log.devwarn("AutoMobFarm", "world or player api missing; auto mob farm won't load")
        return
    end
    local Options, Toggles, References, Library = ctx.Options, ctx.Toggles, ctx.References, ctx.Library
    local Players = ctx.Services.Players
    local WE = World.Errors or {}

    local job, token, current = nil, nil, nil
    local latched, visiting = nil, nil
    local skip = setmetatable({}, { __mode = "k" })
    local checked, immuneHits, immune = {}, {}, {}
    local resting = nil
    -- per type: kills and xp counted since load
    local tally = {}
    local spawns, dirty, savedAt = {}, false, -math.huge
    local mobsBox = nil

    local function post(text, level) Status.set(OWNER, text, level) end
    local function say(text) post(text, Status.ACTING) end

    local function toggleOn(id, default)
        local element = Toggles[id]
        if element == nil then return default end
        return element.Value == true
    end

    local function optionNumber(id, default)
        local element = Options[id]
        return tonumber(element and element.Value) or default
    end

    -- the picked types the farm still fights
    local function picks()
        local element = Options.MobFarm_Mobs
        local value = element and element.Value
        local out, any = {}, false
        if type(value) == "table" then
            for kind, on in pairs(value) do
                if on == true and not immune[kind] then
                    out[kind] = true
                    any = true
                end
            end
        end
        return out, any
    end

    local function me()
        local player = References.player
        return { name = player and player.Name or "", userId = player and player.UserId or 0 }
    end

    -- cloneref breaks == on instances, so you are told apart by UserId
    local function others()
        local mine = me().userId
        local out = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            local char = plr.UserId ~= mine and plr.Character
            if char and char.Parent then out[#out + 1] = { name = plr.Name, position = char:GetPivot().Position } end
        end
        return out
    end

    local function myPosition()
        local root = References.humanoidRootPart
        return root and root.Parent and root.Position or nil
    end

    local function alive()
        local hum = References.humanoid
        if not (hum and hum.Parent and hum.Health > 0) then return false end
        if Combat and Combat.alive then return Combat.alive() == true end
        return true
    end

    -- ======================= spawn memory =======================

    local function knownTypes()
        local list = {}
        for kind in pairs(spawns) do list[#list + 1] = kind end
        table.sort(list)
        return list
    end

    local function save(force)
        if not dirty then return end
        if not force and os.clock() - savedAt < SAVE_EVERY then return end
        dirty, savedAt = false, os.clock()
        Store.write(STORE_NS, STORE_KEY, Catalog.toSaved(spawns))
    end

    for kind, points in pairs(Catalog.SEEDS) do
        for _, p in ipairs(points) do Catalog.learn(spawns, kind, Vector3.new(p[1], p[2], p[3])) end
    end
    Catalog.fromSaved(Store.read(STORE_NS, STORE_KEY, nil), spawns, Vector3.new)

    -- every streamed spawner mob teaches its type and spawn point; a new type joins the dropdown
    local function scan()
        local ok, list = World.combatants({ players = false })
        if not ok then return end
        local who = me()
        local fresh = false
        for _, model in ipairs(list) do
            local farm, kind = Catalog.farmable(model, who)
            if farm then
                local isNewType = spawns[kind] == nil
                if Catalog.learn(spawns, kind, Catalog.spawnOf(model)) then dirty = true end
                fresh = fresh or isNewType
            end
        end
        if fresh and mobsBox then UiWrite.values(mobsBox, knownTypes()) end
        save(false)
    end

    -- ======================= movement =======================

    -- holding the claim is what M.active reports
    local function ensureClaim()
        if token then
            local ok, owner = World.owner()
            if ok and owner == OWNER then
                acting = true
                return true
            end
            token = nil
        end
        local ok, got = World.claim(OWNER)
        if not ok then return false end
        token = got
        acting = true
        return true
    end

    local function releaseClaim()
        if token then World.release(token) end
        token = nil
    end

    -- a short hop runs on foot like a player; a far one, or a walk the path can't finish, teleports
    local function go(position)
        local from = myPosition()
        if from and (from - position).Magnitude <= FarmSettings.walkRange(WALK_RANGE) then
            if World.walkTo(position, { token = token, sprint = true }) then return true end
        end
        local ok, err = World.travelTo(position, { token = token })
        if ok then return true end
        from = myPosition()
        if err == WE.NOT_ARRIVED and from and (from - position).Magnitude <= NEAR_ENOUGH then return true end
        return false, err
    end

    -- ======================= targets =======================

    local engine, engineTried = nil, false
    local function getEngine()
        if engine or engineTried then return engine end
        engineTried = true
        local ok, built = pcall(Engage.new, ctx)
        if ok and built then engine = built else Log.devwarn("AutoMobFarm", "combat engine failed to build: %s", tostring(built)) end
        return engine
    end

    -- (model, type) or nil: the latched target while it stays fair game, else a mob aimed at you, else the nearest
    local function choose(eng, wanted)
        local who, crowd = me(), others()
        local skipTaken = toggleOn("MobFarm_SkipTaken", true)
        local t = os.clock()
        local function fair(model)
            local farm, kind = Catalog.farmable(model, who)
            if not (farm and wanted[kind]) then return nil end
            if (skip[model] or 0) > t or not eng.valid(model) then return nil end
            if skipTaken and Catalog.takenBy(model, who, crowd, model:GetPivot().Position) then return nil end
            return kind
        end
        if latched then
            local kind = fair(latched)
            if kind then return latched, kind end
            latched = nil
        end
        local ok, list = World.combatants({ players = false, alive = true, maxDistance = optionNumber("MobFarm_Range", 150) })
        if not ok then return nil end
        local first, firstKind = nil, nil
        for _, model in ipairs(list) do
            local kind = fair(model)
            if kind then
                if Catalog.aimedAt(model) == who.name then return model, kind end
                if not first then first, firstKind = model, kind end
            end
        end
        return first, firstKind
    end

    local function readLevel()
        if not Player.level then return nil end
        local ok, value = Player.level()
        if ok and type(value) == "table" then return value end
        return nil
    end

    local function xpSince(j, before)
        if not before then return nil end
        local waited = 0
        while waited < XP_WAIT do
            local gained = Catalog.xpGained(before, readLevel())
            if gained and gained > 0 then return gained end
            if not j:sleep(0.25) then return nil end
            waited = waited + 0.25
        end
        return Catalog.xpGained(before, readLevel())
    end

    -- presses each drop near the kill, nearest first, walking into its prompt's reach
    local function loot(j, spot)
        if not (World.items and World.prompts and World.firePrompt) then return end
        if not j:sleep(LOOT_SETTLE) then return end
        local tried = {}
        for _ = 1, LOOT_MAX do
            local ok, list = World.items()
            if not ok then return end
            local best, bestDistance = nil, math.huge
            for _, entry in ipairs(list) do
                local distance = (entry.position - spot).Magnitude
                if not entry.putAway and not tried[entry.model] and distance <= FarmSettings.lootRadius(LOOT_RADIUS) and distance < bestDistance then
                    best, bestDistance = entry, distance
                end
            end
            if not best then return end
            tried[best.model] = true
            local okPrompts, prompts = World.prompts({ root = best.model })
            local p = okPrompts and prompts[1]
            if p then
                say("Picking up drops")
                if not p.distance or p.distance > p.maxDistance - 1 then go(p.position or best.position) end
                local fired, err = World.firePrompt(p.prompt)
                if not fired then Log.dev("AutoMobFarm", "pickup refused: %s", tostring(err)) end
            end
        end
    end

    -- one fight to a verdict; (line, level)
    local function fight(j, eng, target, kind)
        latched = target
        local before = readLevel()
        local spot = target:GetPivot().Position
        say("Fighting " .. kind)
        local handle = eng.start(target, { owner = OWNER, token = token, timeout = FIGHT_TIMEOUT })
        if not handle then
            skip[target] = os.clock() + SKIP_FOR
            latched = nil
            return "Fight didn't start", Status.IDLE
        end
        current = handle
        while not handle.done() do
            if not j:sleep(FIGHT_POLL) then
                handle.kill()
                current = nil
                return nil
            end
        end
        current = nil
        latched = nil
        local won, reason = handle.outcome()
        if won then
            local gained = xpSince(j, before)
            local row = tally[kind] or { kills = 0, xp = 0 }
            tally[kind] = row
            row.kills = row.kills + 1
            row.xp = row.xp + (gained or 0)
            if toggleOn("MobFarm_Loot", true) then loot(j, spot) end
            if gained and gained > 0 then return ("%s down, +%d XP"):format(kind, gained), Status.ACTING end
            return kind .. " down", Status.ACTING
        end
        skip[target] = os.clock() + SKIP_FOR
        if reason == "immune" then
            immuneHits[kind] = (immuneHits[kind] or 0) + 1
            if immuneHits[kind] >= IMMUNE_LIMIT then
                immune[kind] = true
                UiWrite.notify(Library, Catalog.plural(kind) .. " take no damage, skipping them.", 6)
                return Catalog.plural(kind) .. " take no damage", Status.IDLE
            end
            return kind .. " took no damage", Status.ACTING
        end
        if reason == "died" or not alive() then return "Waiting to respawn", Status.WAITING end
        return "Next target", Status.ACTING
    end

    -- between fights: wait out low health without moving, if the user asked for it; a mob on you still gets fought
    local function restLine()
        local below = optionNumber("MobFarm_RestBelow", 0)
        local hum = References.humanoid
        if below <= 0 or not (hum and hum.MaxHealth and hum.MaxHealth > 0) then
            resting = nil
            return nil
        end
        local pct = hum.Health / hum.MaxHealth * 100
        local resume = math.max(below, REST_RESUME)
        local t = os.clock()
        if resting then
            if hum.Health > resting.best then resting.best, resting.at = hum.Health, t end
            -- no regen for a while means waiting won't help
            if pct >= resume or t - resting.at >= REST_STALL then
                resting = nil
                return nil
            end
        elseif pct < below then
            resting = { best = hum.Health, at = t }
        else
            return nil
        end
        return ("Resting to %d%% HP"):format(resume)
    end

    -- ======================= pass =======================

    -- (line, level, acted)
    local function pass(j)
        if not Player.ready() then return "Waiting for your save", Status.IDLE, false end
        if WorldEvents.wants() then return "Paused for an event", Status.IDLE, false end
        if Farms.priority("MobFarm") then return "Paused for " .. Farms.priority("MobFarm"), Status.IDLE, false end
        -- a held pass leaves wanting as the last pass that ran set it
        local may, why = Farms.mayAct(FARM)
        if not may then return why, Status.WAITING, false end
        if not alive() then return "Waiting to respawn", Status.WAITING, false end
        if Player.isBusy and Player.isBusy() then return "Waiting for a scene", Status.IDLE, false end
        local wanted, any = picks()
        if not any then
            wanting = false
            return "Pick a mob to farm", Status.IDLE, false
        end
        local eng = getEngine()
        if not eng then return "Fighting is unavailable", Status.IDLE, false end
        wanting = true
        local target, kind = choose(eng, wanted)
        local onMe = target and Catalog.aimedAt(target) == me().name
        if not onMe then
            local rest = restLine()
            if rest then return rest, Status.WAITING, false end
        end
        if not ensureClaim() then return "Waiting for movement", Status.IDLE, false end
        if target then
            visiting = nil
            local line, level = fight(j, eng, target, kind)
            return line, level, true
        end
        -- nothing in range: every camp the search reached is empty, so go to the next one
        local from = myPosition()
        local camps = Catalog.camps(spawns, wanted)
        local t = os.clock()
        local covered = math.max(optionNumber("MobFarm_Range", 150) - WANDER, WANDER)
        for _, camp in ipairs(camps) do
            if (visiting and camp.key == visiting.key) or (from and (camp.spot - from).Magnitude <= covered) then
                checked[camp.key] = t
            end
        end
        visiting = nil
        if not toggleOn("MobFarm_Roam", true) then return "No mobs in range", Status.IDLE, false end
        if #camps == 0 then return "No spawns known yet", Status.IDLE, false end
        local camp = Catalog.nextCamp(camps, from, checked, t, EMPTY_COOLDOWN)
        if not camp then
            local left = Catalog.soonest(camps, checked, t, EMPTY_COOLDOWN)
            return ("Checking spawns in %ds"):format(math.ceil(left or EMPTY_COOLDOWN)), Status.WAITING, false
        end
        local names = {}
        for k in pairs(camp.kinds) do names[#names + 1] = k end
        table.sort(names)
        say("Going to " .. Catalog.plural(names[1]))
        local okGo = go(camp.spot)
        if not okGo then
            checked[camp.key] = t
            return "Couldn't reach the spawn", Status.IDLE, false
        end
        visiting = camp
        if not j:sleep(ARRIVE_SETTLE) then return nil, nil, false end
        return "Looking for " .. Catalog.plural(names[1]), Status.ACTING, true
    end

    local function loop(j)
        while j.alive and enabled do
            local ok, line, level, acted = pcall(pass, j)
            acting = false
            if ok then
                if line then post(line, level) end
            else
                Log.devwarn("AutoMobFarm", "pass failed: %s", tostring(line))
            end
            -- claim per pass: a fight or a trip holds movement, the gap between passes lets other farms in
            releaseClaim()
            if not j.alive then return end
            if not j:sleep((ok and acted) and ACT_TICK or FarmSettings.tick(IDLE_TICK)) then return end
        end
    end

    local function stop()
        enabled, acting, wanting = false, false, false
        if job then job:Cancel() end
        job = nil
        if current then current.kill() end
        current = nil
        if engine then engine.destroy() end
        releaseClaim()
        latched, visiting, resting = nil, nil, nil
        table.clear(checked)
        Status.clear(OWNER)
        save(true)
    end

    O.track(Jobs.interval(SCAN_EVERY, scan, { name = "AutoMobFarm scan" }))

    local farmBox = ctx.Tabs.Fights:AddRightGroupbox("Mob Farm", "skull")
    farmBox:AddToggle("MobFarm_Enabled", {
        Text     = "Auto Mob Farm",
        Premium  = true,
        Default  = false,
        Callback = function(on)
            if on then
                if enabled then return end
                enabled = true
                job = O.track(Jobs.spawn(loop, { name = "AutoMobFarm" }))
            else
                stop()
            end
        end,
    })
    Farms.register({
        name    = FARM,
        label   = "Mobs",
        owner   = OWNER,
        enable  = function(on) UiWrite.value(Toggles.MobFarm_Enabled, on) end,
        enabled = function() return enabled end,
        active  = M.active,
        wants   = M.wants,
    })
    farmBox:AddToggle("MobFarm_Roam", {
        Text    = "Roam Spawns",
        Default = true,
        Tooltip = "Goes to the next spawn when the area is empty",
    })
    farmBox:AddToggle("MobFarm_Loot", {
        Text    = "Pick Up Drops",
        Default = true,
    })
    farmBox:AddSlider("MobFarm_RestBelow", {
        Text     = "Rest Below HP",
        Default  = 0,
        Min      = 0,
        Max      = 90,
        Rounding = 0,
        Suffix   = "%",
        Tooltip  = "Waits to heal between fights, 0 is off",
    })

    local targetBox = ctx.Tabs.Fights:AddRightGroupbox("Mob Targets", "crosshair")
    mobsBox = targetBox:AddDropdown("MobFarm_Mobs", {
        Text       = "Mobs",
        Values     = knownTypes(),
        Default    = {},
        Multi      = true,
        Searchable = true,
    })
    targetBox:AddSlider("MobFarm_Range", {
        Text     = "Search Range",
        Default  = 150,
        Min      = 50,
        Max      = 500,
        Rounding = 0,
        Suffix   = " studs",
    })
    targetBox:AddToggle("MobFarm_SkipTaken", {
        Text    = "Skip Others' Mobs",
        Default = true,
        Tooltip = "Leaves mobs another player is fighting",
    })

    -- kills and xp per type since load, for the farm controller and diagnostics
    function M.tally()
        local out = {}
        for kind, row in pairs(tally) do out[kind] = { kills = row.kills, xp = row.xp, immune = immune[kind] == true } end
        return out
    end

    O.onUnload(stop)
    O.onUnload(function() Farms.unregister(FARM) end)
    O.finalize()
end

return M

end)
__bundle_register("Features/Auto/MobFarm/Catalog", function(require, _LOADED, __bundle_register, __bundle_modules)
-- mob farm catalog: which models in Game.Players are farmable spawner mobs (they carry NPCSpawnPivot), what type each is, whether another player is on it, and the per-type spawn points learned from their pivots and grouped into camps; pure, so it runs offline
local M = {}

-- a respawning world mob carries the cframe it spawned at (live 2026-11-17: every beach Seal); quest, bounty, incident and event spawns never do
M.SPAWN_ATTR = "NPCSpawnPivot"
-- spawn points closer than this are one point; points closer than CAMP_RADIUS are one trip
M.MERGE = 12
M.CAMP_RADIUS = 90
-- a seal respawns at a fresh pivot each time (live 2026-11-17), so a type keeps at most this many
M.MAX_POINTS = 40
-- another player this close to a mob is taken to be fighting it
M.CROWD = 14

-- live 2026-11-17, the beach seals' NPCSpawnPivot positions; seeds the list before the first scan
M.SEEDS = {
    Seal = {
        { -661.6, 27.4, 2657.0 }, { -660.3, 10.4, 2763.0 }, { -333.1, 14.1, 2709.7 },
        { -541.7, 41.8, 2592.7 }, { -403.3, 35.4, 2565.8 }, { -538.5, 36.5, 2486.6 },
    },
}

-- story fights the client gives no boss attribute (enemies.md 2), same list as the esp
local STORY_BOSSES = {
    ["Charming Man"] = true, ["Bobby Jean"] = true, ["Ningbo"] = true, ["Laem Chabang"] = true,
    ["Yo-Yo Ma"] = true, ["Leprechaun"] = true, ["CEO of Fighting"] = true, ["Jotaro"] = true, ["DIO"] = true,
}
-- Abilities:IsIdleNPC's exclusions (Abilities.lua:1502-1512)
local IDLE_ATTRS = { "TrainingDummy", "Stand", "StandName", "Vehicle", "SummonFamily", "SummonSkill" }
-- a bounty or incident enemy belongs to whoever runs it; auto quests fights your own (BountyHandler.lua:767, 1016-1018; IncidentHandler.lua:2099, 2122)
local BOUNTY_ATTRS = { "BountyId", "Bounty", "BountyLeaderId" }
-- live 2026-11-18: raid npcs carry NPCSpawnPivot too, and the train's grunts, highway star's nurses and yuya were learned as farm targets; their raid tags and Config names give them away
local RAID_ATTRS = { "TrainRaidNPC", "TrainRaidAmbient", "TrainRaidBoss", "HighwayRaidNPC", "RingsRaidNPC" }
local RAID_PREFIXES = { "TrainRaid", "HighwayRaid", "RingsRaid" }

-- plain: true for a type name that only exists inside a raid
function M.raidType(kind)
    if type(kind) ~= "string" then return false end
    for _, prefix in ipairs(RAID_PREFIXES) do
        if string.sub(kind, 1, #prefix) == prefix then return true end
    end
    return false
end

-- "Seal_2632" and "Wild Cat Size_12" read as their type; Config wins when the server set one
function M.typeOf(model)
    local config = model:GetAttribute("Config")
    if type(config) == "string" and config ~= "" then return config end
    local name = string.gsub(model.Name, "%s*%[.-%]$", "")
    name = string.gsub(name, "_%d+$", "")
    return name
end

function M.isBoss(model)
    if model:GetAttribute("BossNPC") == true or model:GetAttribute("WorldEventBoss") == true then return true end
    local party = model:GetAttribute("RecommendedPartySize")
    if type(party) == "number" and party > 1 then return true end
    if STORY_BOSSES[M.typeOf(model)] then return true end
    for key, value in pairs(model:GetAttributes()) do
        if value == true and string.sub(key, -9) == "StoryBoss" then return true end
    end
    return false
end

-- the spot a spawner mob came from, or nil when it isn't one
function M.spawnOf(model)
    local pivot = model:GetAttribute(M.SPAWN_ATTR)
    if typeof(pivot) == "CFrame" then return pivot.Position end
    if typeof(pivot) == "Vector3" then return pivot end
    return nil
end

-- (true, type) for a respawning world mob nobody owns; (false, why) otherwise
function M.farmable(model, me)
    if typeof(model) ~= "Instance" or not model:IsA("Model") or not model.Parent then return false, "gone" end
    if model:FindFirstChild("Summoner") then return false, "summon" end
    for _, attr in ipairs(IDLE_ATTRS) do
        if model:GetAttribute(attr) then return false, "idle" end
    end
    if M.spawnOf(model) == nil then return false, "not a spawner" end
    for _, attr in ipairs(RAID_ATTRS) do
        if model:GetAttribute(attr) ~= nil then return false, "raid" end
    end
    if M.raidType(M.typeOf(model)) then return false, "raid" end
    local forced = model:GetAttribute("ForcedTargetName")
    if type(forced) == "string" and forced ~= "" and forced ~= me.name then return false, "pinned" end
    for _, attr in ipairs(BOUNTY_ATTRS) do
        if model:GetAttribute(attr) ~= nil then return false, "owned" end
    end
    local owner = model:GetAttribute("StoryOwnerUserId")
    if owner ~= nil and owner ~= me.userId then return false, "owned" end
    if string.sub(model.Name, 1, 9) == "Incident_" then return false, "owned" end
    if M.isBoss(model) then return false, "boss" end
    return true, M.typeOf(model)
end

-- the name a mob is aimed at, from the Target string or the NPCCombatTarget value (enemies.md 1)
function M.aimedAt(model)
    local target = model:GetAttribute("Target")
    if type(target) == "string" and target ~= "" then return target end
    local value = model:FindFirstChild("NPCCombatTarget")
    local v = value and value:IsA("ObjectValue") and value.Value
    if v then return v.Name end
    return nil
end

-- the other player fighting this mob, or nil; others: { { name, position } } for every other player's character
function M.takenBy(model, me, others, position)
    local aimed = M.aimedAt(model)
    if aimed and aimed ~= me.name then
        for _, other in ipairs(others) do
            if other.name == aimed then return aimed end
        end
    end
    if aimed == me.name or not position then return nil end
    for _, other in ipairs(others) do
        if other.position and (other.position - position).Magnitude <= M.CROWD then return other.name end
    end
    return nil
end

-- ======================= spawn memory =======================

-- spawns[type] = { Vector3, ... }; true when the point was new
function M.learn(spawns, kind, point)
    local list = spawns[kind]
    if not list then
        list = {}
        spawns[kind] = list
    end
    for _, known in ipairs(list) do
        if (known - point).Magnitude <= M.MERGE then return false end
    end
    if #list >= M.MAX_POINTS then return false end
    list[#list + 1] = point
    return true
end

function M.fromSaved(saved, spawns, makeVector)
    if type(saved) ~= "table" then return spawns end
    for kind, points in pairs(saved) do
        if type(kind) == "string" and type(points) == "table" and not M.raidType(kind) then
            for _, p in ipairs(points) do
                if type(p) == "table" and tonumber(p[1]) and tonumber(p[2]) and tonumber(p[3]) then
                    M.learn(spawns, kind, makeVector(tonumber(p[1]), tonumber(p[2]), tonumber(p[3])))
                end
            end
        end
    end
    return spawns
end

function M.toSaved(spawns)
    local out = {}
    for kind, points in pairs(spawns) do
        local list = {}
        for i, p in ipairs(points) do list[i] = { math.floor(p.X * 10 + 0.5) / 10, math.floor(p.Y * 10 + 0.5) / 10, math.floor(p.Z * 10 + 0.5) / 10 } end
        out[kind] = list
    end
    return out
end

-- every picked type's points grouped greedily into camps; a camp's spot is its first point, so a trip lands on real ground
function M.camps(spawns, picks)
    local camps = {}
    local kinds = {}
    for kind in pairs(picks) do kinds[#kinds + 1] = kind end
    table.sort(kinds)
    for _, kind in ipairs(kinds) do
        for _, point in ipairs(spawns[kind] or {}) do
            local home = nil
            for _, camp in ipairs(camps) do
                if (camp.spot - point).Magnitude <= M.CAMP_RADIUS then
                    home = camp
                    break
                end
            end
            if home then
                home.kinds[kind] = true
                home.size = home.size + 1
            else
                camps[#camps + 1] = { spot = point, kinds = { [kind] = true }, size = 1, key = kind .. "@" .. #camps + 1 }
            end
        end
    end
    return camps
end

-- the nearest camp not checked empty in the last `cooldown` seconds; checked[key] = os.clock() it was found empty
function M.nextCamp(camps, from, checked, now, cooldown)
    local best, bestDistance = nil, math.huge
    for _, camp in ipairs(camps) do
        local at = checked[camp.key]
        if not (at and now - at < cooldown) then
            local distance = from and (camp.spot - from).Magnitude or 0
            if distance < bestDistance then best, bestDistance = camp, distance end
        end
    end
    return best, bestDistance
end

-- the soonest a checked camp opens up again, in seconds, or nil
function M.soonest(camps, checked, now, cooldown)
    local best = nil
    for _, camp in ipairs(camps) do
        local at = checked[camp.key]
        if at then
            local left = cooldown - (now - at)
            if left > 0 and (not best or left < best) then best = left end
        end
    end
    return best
end

-- xp gained between two Player.level reads, across a level-up
function M.xpGained(before, after)
    if type(before) ~= "table" or type(after) ~= "table" then return nil end
    local b, a = tonumber(before.xp), tonumber(after.xp)
    if not (b and a) then return nil end
    if after.level == before.level then return math.max(a - b, 0) end
    if (tonumber(after.level) or 0) > (tonumber(before.level) or 0) then
        return math.max((tonumber(before.needed) or b) - b, 0) + a
    end
    return nil
end

function M.plural(kind)
    if string.sub(kind, -1) == "s" then return kind end
    return kind .. "s"
end

return M

end)
__bundle_register("Features/Auto/Control", function(require, _LOADED, __bundle_register, __bundle_modules)
-- farm control: the auto → control tab; a farm plan that switches farms on in your order and lets only the first one with work (plus any above it) start new work, the settings every farm shares, stop rules, and a loot and stats log with per-hour rates that posts a summary and the big moments (boss kills, raid clears, rare drops) to your webhook, never one post per kill
local Jobs         = require("Utility/Jobs")
local Log          = require("Utility/Log")
local Mount        = require("Utility/Mount")
local Scheduler    = require("Utility/Scheduler")
local Status       = require("Utility/Status")
local Store        = require("Utility/Store")
local UiWrite      = require("Utility/UiWrite")
local Farms        = require("Utility/Farms")
local FarmSettings = require("Utility/FarmSettings")
local Plan         = require("Features/Auto/Control/Plan")
local Tracker      = require("Features/Auto/Control/Tracker")
local Watch        = require("Features/Auto/Control/Watch")

local OWNER = "FarmControl"
local TICK = 1
local REFRESH = 1
local SAVE_EVERY = 60
-- moments that land together (a raid clear and its rare loot) go out as one post
local MOMENT_GATHER = 15
local MOMENT_GAP = 60
local MOMENT_CAP = 10
-- a gain this soon after a farm let go of movement still counts as that farm's
local OWNER_GRACE = 20
local NAMESPACE = Store.GAME .. "/farms"
local KEY = "totals"
local EVENT = "FarmReport"
local TRAVEL = { "Walk Short Trips", "Teleport" }
local SLOT_TEXT = { "First", "Second", "Third", "Fourth" }

local M = {}

function M.mount(ctx)
    local O = Mount.orchestrator(ctx, "FarmControl")
    if not O then return end
    local Api = ctx.Api or {}
    local World, Player = Api.World, Api.Player
    if not (World and Player and ctx.Tabs and ctx.Tabs.Control) then
        Log.devwarn("FarmControl", "world or player api, or the control tab, missing; farm control won't load")
        return
    end
    local Options, Toggles, Library = ctx.Options, ctx.Toggles, ctx.Library
    local Http = ctx.Services and ctx.Services.HttpService
    local hook = Api.Webhook
    local function now() return os.clock() end

    local tracker = Tracker.new(Store.read(NAMESPACE, KEY, nil))
    local savedChanges, savedTime = tracker.changes, tracker.total.time

    -- the plan drives a registered farm through the registry, and a catalogue farm that never registered through its own toggle
    local function shimToggle(name)
        if Farms.get(name) then return nil end
        local known = Plan.known(name)
        return known and known.toggle and Toggles[known.toggle] or nil
    end
    local function isOn(name)
        if Farms.get(name) then return Farms.enabled(name) end
        local t = shimToggle(name)
        return t ~= nil and t.Value == true
    end
    local function wants(name)
        return Farms.get(name) ~= nil and Farms.wants(name)
    end
    local function setOn(name, on)
        if Farms.get(name) then return Farms.enable(name, on) end
        local t = shimToggle(name)
        if not t or (t.Value == true) == on then return false end
        return UiWrite.value(t, on)
    end
    local function allNames()
        local out, seen = {}, {}
        for _, entry in ipairs(Plan.CATALOGUE) do out[#out + 1] = entry.name; seen[entry.name] = true end
        for _, f in ipairs(Farms.list()) do
            if not seen[f.name] then out[#out + 1] = f.name end
        end
        return out
    end
    local function anyOn()
        for _, name in ipairs(allNames()) do
            if isOn(name) then return true end
        end
        return false
    end

    local labels, toName, toLabel = Plan.choices(Farms.list())
    local listVersion = Farms.version()
    local function labelOf(name) return toLabel[name] or name end

    -- who earned it: the farm holding movement now, else the one that just let go
    local lastOwner, lastOwnerAt = nil, -math.huge
    local function noteOwner()
        local ok, owner = World.owner()
        if ok and owner then lastOwner, lastOwnerAt = owner, now() end
        return ok and owner or nil
    end
    local function farmOf()
        local owner = noteOwner()
        if not owner and now() - lastOwnerAt <= OWNER_GRACE then owner = lastOwner end
        if not owner then return Tracker.OTHER end
        local reg = Farms.byOwner(owner)
        if reg then return reg.label end
        for _, entry in ipairs(Plan.CATALOGUE) do
            if entry.owner == owner then return entry.label end
        end
        return owner
    end

    -- webhook: one registered event; its options render in the webhook box when this mounts first
    if hook and hook.RegisterEvent then
        hook.RegisterEvent({
            key = EVENT,
            label = "Farm Reports",
            default = false,
            options = {
                { key = "every",   kind = "slider", label = "Report Every (min)", default = 30, min = 5, max = 120 },
                { key = "moments", kind = "toggle", label = "Big Moments",        default = true },
                { key = "alltime", kind = "toggle", label = "Include All-Time",   default = false },
            },
        })
    end
    local function hookOption(key, default)
        if not (hook and hook.GetEventOption) then return default end
        local value = hook.GetEventOption(EVENT, key, default)
        if value == nil then return default end
        return value
    end
    local function post(spec)
        if spec and hook and hook.Emit then hook.Emit(EVENT, spec) end
    end

    local moments, firstMomentAt, lastMomentPost = {}, nil, -math.huge
    local function moment(title, text)
        if #moments >= MOMENT_CAP then return end
        moments[#moments + 1] = { title = title, text = text }
        firstMomentAt = firstMomentAt or now()
    end

    -- stop rules count from when farming starts and reset once every farm is off
    local runTime, runDeaths = 0, 0
    local planOn = false
    local planDirty = false
    local startedByPlan = {}
    local playerNear = false

    local function decode(raw)
        if type(raw) ~= "string" or raw == "" or not Http then return nil end
        local ok, value = pcall(Http.JSONDecode, Http, raw)
        return ok and value or nil
    end

    local function optionValue(id, default)
        local element = Options[id]
        if element == nil or element.Value == nil then return default end
        return element.Value
    end
    local function toggleOn(id)
        local element = Toggles[id]
        return element ~= nil and element.Value == true
    end

    local function order()
        local out = {}
        for i = 1, Plan.SLOTS do
            local name = toName[optionValue("Control_Slot" .. i, Plan.NONE)]
            if name then out[#out + 1] = name end
        end
        return out
    end
    local function interrupts()
        local out = {}
        local value = optionValue("Control_Interrupts", {})
        if type(value) == "table" then
            for label, on in pairs(value) do
                local name = toName[label]
                if on and name then out[name] = true end
            end
        end
        return out
    end
    local function queue() return Plan.queue(order(), interrupts()) end

    -- every registered farm asks this before it starts new work
    Farms.setGate(function(name)
        if playerNear then return false, "Paused, player nearby" end
        if not planOn then return true end
        local q = queue()
        local lead = Plan.lead(q, isOn, wants)
        if Plan.allowed(name, q, lead) then return true end
        if not lead then return false, "Not in the farm plan" end
        return false, ("Waiting for %s"):format(labelOf(lead))
    end)

    local function applyPlan()
        planDirty = false
        if not planOn then
            for name in pairs(startedByPlan) do setOn(name, false) end
            table.clear(startedByPlan)
            return
        end
        local q = queue()
        local inPlan = {}
        for _, name in ipairs(q) do
            inPlan[name] = true
            if not isOn(name) and setOn(name, true) then startedByPlan[name] = true end
        end
        -- farms outside the plan would fight it for movement
        for _, name in ipairs(allNames()) do
            if not inPlan[name] and isOn(name) then
                setOn(name, false)
                startedByPlan[name] = nil
            end
        end
    end

    local function stopAll(reason)
        if planOn then UiWrite.value(Toggles.Control_Plan, false) end
        planOn = false
        table.clear(startedByPlan)
        for _, name in ipairs(allNames()) do
            if isOn(name) then setOn(name, false) end
        end
        runTime, runDeaths = 0, 0
        UiWrite.notify(Library, ("Farming stopped: %s."):format(reason), 8)
        moment("Farming Stopped", reason .. ".")
    end

    local watch = Watch.new({
        Player = Player, World = World, Combat = Api.Combat, Activities = Api.Activities,
        tracker = tracker, farmOf = farmOf, moment = moment, decode = decode, now = now,
        onDeath = function() runDeaths = runDeaths + 1 end,
    })
    O.onUnload(watch.destroy)

    local function partyIds()
        local out = {}
        local ok, party = Player.party()
        if ok and type(party) == "table" then
            for _, member in ipairs(party.members or {}) do out[tostring(member)] = true end
        end
        return out
    end

    -- cloneref breaks ==, so party members are matched by UserId or name
    local function checkPlayers()
        if not toggleOn("Control_PauseNear") then return false end
        local range = tonumber(optionValue("Control_PauseRange", 100)) or 100
        local ok, models = World.combatants({ npcs = false, maxDistance = range })
        if not ok then return false end
        local party = nil
        for _, model in ipairs(models) do
            local okInfo, info = World.info(model)
            local who = okInfo and info.player
            if who then
                party = party or partyIds()
                if not (party[tostring(who.UserId)] or party[who.Name]) then return true end
            end
        end
        return false
    end

    local function checkStops(dt)
        if not anyOn() then
            runTime, runDeaths = 0, 0
            return
        end
        runTime = runTime + dt
        tracker.add("time", dt)
        local stopLevel = tonumber(optionValue("Control_StopLevel", 0)) or 0
        local stopMinutes = tonumber(optionValue("Control_StopMinutes", 0)) or 0
        local stopDeaths = tonumber(optionValue("Control_StopDeaths", 0)) or 0
        if stopLevel > 0 and tracker.level and tracker.level >= stopLevel then
            stopAll(("reached level %d"):format(tracker.level))
        elseif stopMinutes > 0 and runTime >= stopMinutes * 60 then
            stopAll(("farmed for %s"):format(Tracker.duration(runTime)))
        elseif stopDeaths > 0 and runDeaths >= stopDeaths then
            stopAll(("died %d times"):format(runDeaths))
        end
    end

    local lastReportAt, reportedChanges = now(), tracker.changes
    local lastSaveAt = now()
    local function save()
        if tracker.changes == savedChanges and tracker.total.time == savedTime then return end
        savedChanges, savedTime = tracker.changes, tracker.total.time
        Store.write(NAMESPACE, KEY, tracker.export())
    end

    local function webhookTick()
        local t = now()
        if #moments > 0 and t - firstMomentAt >= MOMENT_GATHER and t - lastMomentPost >= MOMENT_GAP then
            if hookOption("moments", true) == true then post(Tracker.moments(moments)) end
            table.clear(moments)
            firstMomentAt, lastMomentPost = nil, t
        end
        local every = math.max(5, tonumber(hookOption("every", 30)) or 30) * 60
        if t - lastReportAt >= every then
            lastReportAt = t
            -- a quiet interval sends nothing
            if tracker.changes ~= reportedChanges then
                reportedChanges = tracker.changes
                post(Tracker.report(tracker, { allTime = hookOption("alltime", false) == true }))
            end
        end
        if t - lastSaveAt >= SAVE_EVERY then
            lastSaveAt = t
            save()
        end
    end

    local lastTick = now()
    local function tick()
        local t = now()
        local dt = math.min(t - lastTick, TICK * 5)
        lastTick = t
        noteOwner()
        if Farms.version() ~= listVersion then
            listVersion = Farms.version()
            labels, toName, toLabel = Plan.choices(Farms.list())
            local slotValues = { Plan.NONE }
            for _, label in ipairs(labels) do slotValues[#slotValues + 1] = label end
            for i = 1, Plan.SLOTS do UiWrite.values(Options["Control_Slot" .. i], slotValues) end
            UiWrite.values(Options.Control_Interrupts, labels)
        end
        if planDirty then applyPlan() end
        playerNear = checkPlayers()
        if playerNear and anyOn() then
            Status.set(OWNER, "Paused, player nearby", Status.WAITING)
        else
            Status.clear(OWNER)
        end
        local okScan, err = pcall(watch.scan)
        if not okScan then Log.devwarn("FarmControl", "scan failed: %s", tostring(err)) end
        checkStops(dt)
        webhookTick()
    end
    O.track(Jobs.interval(TICK, function()
        local ok, err = pcall(tick)
        if not ok then Log.devwarn("FarmControl", "tick failed: %s", tostring(err)) end
    end, { name = "FarmControl", period = function() return FarmSettings.tick(TICK) end }))

    -- farm plan
    local planBox = ctx.Tabs.Control:AddLeftGroupbox("Farm Plan", "list-ordered")
    local applyingPreset = false
    planBox:AddToggle("Control_Plan", {
        Text     = "Run Farm Plan",
        Default  = false,
        Tooltip  = "Runs the farms below in order and turns the rest off",
        Callback = function(on)
            planOn = on == true
            planDirty = true
        end,
    })
    local slotValues = { Plan.NONE }
    for _, label in ipairs(labels) do slotValues[#slotValues + 1] = label end
    planBox:AddDropdown("Control_Preset", {
        Text     = "Preset",
        Values   = Plan.presetLabels(),
        Default  = "Custom",
        Callback = function(label)
            local preset = Plan.preset(label)
            if not (preset and preset.order) then return end
            applyingPreset = true
            for i = 1, Plan.SLOTS do
                local name = preset.order[i]
                UiWrite.value(Options["Control_Slot" .. i], name and labelOf(name) or Plan.NONE)
            end
            local picked = {}
            for _, name in ipairs(preset.interrupts or {}) do picked[labelOf(name)] = true end
            UiWrite.value(Options.Control_Interrupts, picked)
            applyingPreset = false
            planDirty = true
        end,
    })
    local function customised()
        planDirty = true
        if applyingPreset then return end
        local preset = Options.Control_Preset
        if preset and preset.Value ~= "Custom" then UiWrite.value(preset, "Custom") end
    end
    for i = 1, Plan.SLOTS do
        planBox:AddDropdown("Control_Slot" .. i, {
            Text     = SLOT_TEXT[i],
            Values   = slotValues,
            Default  = Plan.NONE,
            Callback = customised,
        })
    end
    planBox:AddDropdown("Control_Interrupts", {
        Text     = "Interrupt For",
        Values   = labels,
        Default  = {},
        Multi    = true,
        Tooltip  = "These jump the queue whenever they have work",
        Callback = customised,
    })

    -- settings every farm shares
    local setBox = ctx.Tabs.Control:AddLeftGroupbox("Farm Settings", "settings-2")
    local function mirror(key, value) FarmSettings.set(key, value) end
    setBox:AddDropdown("Control_Travel", {
        Text     = "Travel",
        Values   = TRAVEL,
        Default  = TRAVEL[1],
        Tooltip  = "Short trips on foot look less like a bot",
        Callback = function(v) mirror("travel", v) end,
    })
    setBox:AddSlider("Control_LootRadius", {
        Text     = "Loot Radius",
        Default  = 70, Min = 20, Max = 150, Rounding = 0, Suffix = " studs",
        Callback = function(v) mirror("lootRadius", v) end,
    })
    setBox:AddDropdown("Control_Scan", {
        Text     = "Scan Speed",
        Values   = FarmSettings.SCAN_CHOICES,
        Default  = "Normal",
        Tooltip  = "Light saves FPS, Fast reacts sooner",
        Callback = function(v) mirror("scan", v) end,
    })
    setBox:AddToggle("Control_PauseNear", { Text = "Pause Near Players", Default = false })
    setBox:AddSlider("Control_PauseRange", { Text = "Player Distance", Default = 100, Min = 30, Max = 300, Rounding = 0, Suffix = " studs" })
    setBox:AddSlider("Control_StopLevel", { Text = "Stop At Level", Default = 0, Min = 0, Max = 75, Rounding = 0, Tooltip = "0 means off" })
    setBox:AddSlider("Control_StopMinutes", { Text = "Stop After", Default = 0, Min = 0, Max = 720, Rounding = 0, Suffix = " min", Tooltip = "0 means off" })
    setBox:AddSlider("Control_StopDeaths", { Text = "Stop After Deaths", Default = 0, Min = 0, Max = 20, Rounding = 0, Tooltip = "0 means off" })
    mirror("travel", optionValue("Control_Travel", TRAVEL[1]))
    mirror("lootRadius", optionValue("Control_LootRadius", 70))
    mirror("scan", optionValue("Control_Scan", "Normal"))

    -- stats
    local statsBox = ctx.Tabs.Control:AddRightGroupbox("Session Stats", "chart-line")
    local statLabels = {}
    for i, line in ipairs(Tracker.lines(tracker, false)) do statLabels[i] = statsBox:AddLabel(line, true) end
    statsBox:AddToggle("Control_StatsAllTime", { Text = "Show All-Time", Default = false })
    statsBox:AddButton({
        Text = "Reset Session",
        Func = function()
            tracker.resetSession()
            reportedChanges = tracker.changes
        end,
    })
    statsBox:AddButton({
        Text = "Reset All-Time",
        DoubleClick = true,
        Func = function()
            tracker.resetTotal()
            save()
        end,
    })
    O.track(Scheduler.heartbeat(function()
        if Library and not Library.Toggled then return end
        for i, line in ipairs(Tracker.lines(tracker, toggleOn("Control_StatsAllTime"))) do
            UiWrite.text(statLabels[i], line)
        end
    end, { name = "FarmControl.stats", interval = REFRESH, deferrable = true }))

    O.onUnload(function()
        Farms.setGate(nil)
        playerNear = false
        Status.clear(OWNER)
        save()
    end)
    O.finalize()
end

return M

end)
__bundle_register("Features/Auto/Control/Watch", function(require, _LOADED, __bundle_register, __bundle_modules)
-- farm watch: turns the game's own data changes into tracker gains (dalas, xp and level from Data, loot from inventory diffs that weren't bought, kills from your damage numbers, raids, harvests, quests and the bounty ledger) and hands the big moments on; only `scan` does any polling
local Tracker = require("Features/Auto/Control/Tracker")

local M = {}

-- a gain this soon after dalas were spent is a purchase, not loot
local SPEND_WINDOW = 3
-- a knocked npc counts as beaten after the same grace the combat engine gives it (Engage.lua KNOCK_GRACE)
local KNOCK_GRACE = 6
-- a target that vanished this low was killed, not despawned (Engage.lua GONE_WON_RATIO)
local GONE_RATIO = 0.15
-- a target we stopped hitting is forgotten after this long
local FORGET_AFTER = 30
-- story fights with no boss attribute the client can see (enemies.md §2, Sources.lua STORY_BOSSES)
local STORY_BOSSES = {
    ["Charming Man"] = true, ["Bobby Jean"] = true, ["Ningbo"] = true, ["Laem Chabang"] = true,
    ["Yo-Yo Ma"] = true, ["Leprechaun"] = true, ["CEO of Fighting"] = true, ["Jotaro"] = true, ["DIO"] = true,
}
-- a level that's a multiple of this is worth a post
local LEVEL_STEP = 5

function M.cleanName(name)
    return (tostring(name or ""):gsub("%s*%[.-%]$", ""):gsub("_%d+$", ""))
end

function M.isBoss(model)
    if model:GetAttribute("BossNPC") == true or model:GetAttribute("WorldEventBoss") == true or model:GetAttribute("CommandBoss") == true then
        return true
    end
    if STORY_BOSSES[M.cleanName(model.Name)] then return true end
    local ok, attrs = pcall(model.GetAttributes, model)
    if ok and type(attrs) == "table" then
        for key, value in pairs(attrs) do
            if value == true and type(key) == "string" and key:sub(-9) == "StoryBoss" then return true end
        end
    end
    return false
end

-- d = { Player, World, Combat?, Activities?, tracker, farmOf(), moment(title, text), decode(json), now(), onDeath?() }; returns { scan(), destroy() }
function M.new(d)
    local Player, World, Combat, Activities = d.Player, d.World, d.Combat, d.Activities
    local tracker, now = d.tracker, d.now
    local conns = {}
    local lastSpendAt = -math.huge
    local prevLevel = nil
    local stock = nil
    local stockDirty = true
    local hits = setmetatable({}, { __mode = "k" })
    local counted = setmetatable({}, { __mode = "k" })

    local function on(signal, fn)
        if signal and signal.Connect then conns[#conns + 1] = signal:Connect(fn) end
    end
    local function farm() return d.farmOf() end

    on(Player.dalasChanged, function(coins, old)
        local delta = (tonumber(coins) or 0) - (tonumber(old) or 0)
        if delta > 0 then
            tracker.add("dalas", delta, farm())
        elseif delta < 0 then
            tracker.add("spent", -delta)
            lastSpendAt = now()
        end
    end)

    on(Player.levelUp, function(level)
        tracker.add("levels", 1, farm())
        tracker.seeLevel(level)
        if tonumber(level) and level % LEVEL_STEP == 0 then d.moment("Level Up", ("Reached level %d."):format(level)) end
    end)

    on(Player.inventoryChanged, function() stockDirty = true end)

    on(Combat and Combat.damageVisual, function(target, _, isHeal)
        if isHeal or typeof(target) ~= "Instance" then return end
        local model = target:IsA("Model") and target or target:FindFirstAncestorOfClass("Model")
        if not model or counted[model] then return end
        local entry = hits[model]
        if entry then
            entry.at = now()
            return
        end
        local ok, info = World.info(model)
        if not ok or info.isPlayer then return end
        hits[model] = { at = now(), name = M.cleanName(model.Name), boss = M.isBoss(model), ratio = 1, knockAt = nil }
    end)

    on(Combat and Combat.died, function()
        tracker.add("deaths", 1, farm())
        if d.onDeath then d.onDeath() end
    end)

    on(Activities and Activities.raidResults, function(payload)
        if type(payload) ~= "table" then return end
        if not payload.Cleared then
            tracker.add("raidsFailed", 1, farm())
            return
        end
        tracker.add("raids", 1, farm())
        local loot = {}
        for _, line in ipairs(type(payload.Loot) == "table" and payload.Loot or {}) do loot[#loot + 1] = Tracker.stripRich(line) end
        local text = ("%s %s in %s."):format(tostring(payload.Raid or "Raid"), tostring(payload.Difficulty or ""), Tracker.duration(payload.Time))
        if #loot > 0 then text = text .. " Loot: " .. table.concat(loot, ", ") end
        d.moment("Raid Cleared", (text:gsub("%s+", " ")))
    end)

    on(Activities and Activities.gardenEvent, function(verb, payload)
        if verb == "GrowingComplete" and type(payload) == "table" and payload.Kind == "Harvest" then
            tracker.add("harvests", 1, farm())
        end
    end)

    on(Activities and Activities.questCompleted, function()
        tracker.add("quests", 1, farm())
    end)

    if Player.observe then
        local handle = Player.observe("Stats.BountyCompletions", function(value, old)
            local n = Tracker.ledgerDelta(d.decode(old), d.decode(value))
            if n > 0 then tracker.add("bounties", n, farm()) end
        end)
        if handle then conns[#conns + 1] = handle end
    end

    local function readLevel()
        local ok, info = Player.level()
        if not ok or type(info) ~= "table" then return end
        if prevLevel then
            local gain = Tracker.xpGain(prevLevel, info)
            if gain > 0 then tracker.add("xp", gain, farm()) end
        end
        tracker.seeLevel(info.level)
        prevLevel = { level = info.level, xp = info.xp, needed = info.needed }
    end

    local function readStock()
        if not stockDirty then return end
        local ok, list = Player.inventory()
        if not ok or type(list) ~= "table" then return end
        stockDirty = false
        local counts = {}
        for _, entry in ipairs(list) do
            if type(entry.name) == "string" then counts[entry.name] = (counts[entry.name] or 0) + (tonumber(entry.amount) or 1) end
        end
        local before = stock
        stock = counts
        if not before then return end
        if now() - lastSpendAt <= SPEND_WINDOW then return end
        for name, n in pairs(counts) do
            local gained = n - (before[name] or 0)
            if gained > 0 then
                tracker.loot(name, gained, farm())
                if Tracker.isRare(name) then d.moment("Rare Drop", ("%s ×%d"):format(name, gained)) end
            end
        end
    end

    local function kill(model, entry)
        counted[model] = true
        hits[model] = nil
        local f = farm()
        tracker.add("kills", 1, f)
        if entry.boss then
            tracker.add("bosses", 1, f)
            d.moment("Boss Defeated", entry.name .. ".")
        end
    end

    local function readKills()
        local t = now()
        for model, entry in pairs(hits) do
            local ok, info = World.info(model)
            if not ok then
                if entry.ratio <= GONE_RATIO then kill(model, entry) else hits[model] = nil end
            elseif not info.alive then
                kill(model, entry)
            else
                entry.ratio = info.maxHealth > 0 and info.health / info.maxHealth or 1
                if info.passedOut then
                    entry.knockAt = entry.knockAt or t
                    if t - entry.knockAt >= KNOCK_GRACE then kill(model, entry) end
                else
                    entry.knockAt = nil
                    if t - entry.at > FORGET_AFTER then hits[model] = nil end
                end
            end
        end
    end

    local watch = {}

    function watch.destroy()
        for i = #conns, 1, -1 do
            pcall(function() conns[i]:Disconnect() end)
            conns[i] = nil
        end
    end

    function watch.scan()
        if not Player.ready() then return end
        readLevel()
        readStock()
        readKills()
    end

    -- test hook
    function watch.tracking(model) return hits[model] end

    return watch
end

return M

end)
__bundle_register("Features/Auto/Control/Tracker", function(require, _LOADED, __bundle_register, __bundle_modules)
-- farm tracker: pure session and all-time counters for what farming earned (dalas, xp, kills, bosses, raids, bounties, quests, harvests, arrows, loot), split by the farm that earned it, with per-hour rates, the stats lines and the webhook report embeds
local M = {}

M.KEYS = { "dalas", "spent", "xp", "levels", "kills", "bosses", "raids", "raidsFailed", "bounties", "quests", "harvests", "arrows", "items", "deaths", "time" }
-- the raid results screen paints these gold (TrainRaidClient.lua:1736)
M.RARE = { "Arrow", "Mask", "Chip" }
M.OTHER = "Other"

local TOP_ITEMS = 5
local TOP_FARMS = 4

local function blank()
    local c = { loot = {}, farms = {} }
    for _, key in ipairs(M.KEYS) do c[key] = 0 end
    return c
end

-- a saved table from an older build (or a hand-edited file) can miss keys or hold junk; keep only numbers
local function sanitize(saved)
    local c = blank()
    if type(saved) ~= "table" then return c end
    for _, key in ipairs(M.KEYS) do
        local v = tonumber(saved[key])
        if v and v == v and v >= 0 then c[key] = v end
    end
    if type(saved.loot) == "table" then
        for name, n in pairs(saved.loot) do
            if type(name) == "string" and tonumber(n) then c.loot[name] = tonumber(n) end
        end
    end
    if type(saved.farms) == "table" then
        for label, f in pairs(saved.farms) do
            if type(label) == "string" and type(f) == "table" then
                local entry = {}
                for key, n in pairs(f) do
                    if type(key) == "string" and tonumber(n) then entry[key] = tonumber(n) end
                end
                c.farms[label] = entry
            end
        end
    end
    return c
end

function M.new(saved)
    local T = { session = blank(), total = sanitize(saved), changes = 0, startLevel = nil, level = nil }

    local function bump(c, key, n, farm)
        c[key] = (c[key] or 0) + n
        if farm and key ~= "time" then
            local f = c.farms[farm]
            if not f then f = {}; c.farms[farm] = f end
            f[key] = (f[key] or 0) + n
        end
    end

    -- time doesn't count as news for the report; everything else does
    function T.add(key, n, farm)
        n = tonumber(n) or 1
        if n <= 0 then return end
        bump(T.session, key, n, farm)
        bump(T.total, key, n, farm)
        if key ~= "time" then T.changes = T.changes + 1 end
    end

    function T.loot(name, n, farm)
        n = tonumber(n) or 1
        if type(name) ~= "string" or name == "" or n <= 0 then return end
        for _, c in ipairs({ T.session, T.total }) do
            c.loot[name] = (c.loot[name] or 0) + n
        end
        T.add("items", n, farm)
        -- "Arrow Part" is a crafting material, not an arrow
        if string.find(name, "Arrow$") or string.find(name, "Arrow %[") then T.add("arrows", n, farm) end
    end

    function T.seeLevel(level)
        level = tonumber(level)
        if not level then return end
        if not T.startLevel then T.startLevel = level end
        T.level = level
    end

    function T.resetSession()
        T.session = blank()
        T.startLevel = T.level
        T.changes = T.changes + 1
    end

    function T.resetTotal()
        T.total = blank()
        T.changes = T.changes + 1
    end

    function T.export() return T.total end

    return T
end

function M.isRare(name)
    if type(name) ~= "string" then return false end
    for _, word in ipairs(M.RARE) do
        if string.find(name, word, 1, true) then return true end
    end
    return false
end

-- raid loot lines are rich text
function M.stripRich(s)
    return (tostring(s or ""):gsub("<[^>]->", ""))
end

-- xp earned between two level reads; a level-up adds what was left of the old bar
function M.xpGain(prev, cur)
    if type(prev) ~= "table" or type(cur) ~= "table" then return 0 end
    local pl, cl = tonumber(prev.level), tonumber(cur.level)
    local px, cx = tonumber(prev.xp) or 0, tonumber(cur.xp) or 0
    if not (pl and cl) or cl < pl then return 0 end
    if cl == pl then return math.max(0, cx - px) end
    return math.max(0, (tonumber(prev.needed) or px) - px) + cx
end

-- Bounty.lua:412-426, 521-524: the ledger maps a completion key to its latest rotation, so a new key or a higher rotation is one finished bounty
function M.ledgerDelta(old, new)
    if type(new) ~= "table" then return 0 end
    if type(old) ~= "table" then return 0 end
    local n = 0
    for key, value in pairs(new) do
        local before = old[key]
        if before == nil then
            n = n + 1
        elseif tonumber(value) and tonumber(before) and tonumber(value) > tonumber(before) then
            n = n + 1
        end
    end
    return n
end

function M.comma(n)
    n = math.floor((tonumber(n) or 0) + 0.5)
    local s = tostring(math.abs(n))
    local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
    if out:sub(1, 1) == "," then out = out:sub(2) end
    return (n < 0 and "-" or "") .. out
end

function M.short(n)
    n = tonumber(n) or 0
    local a = math.abs(n)
    if a >= 1e6 then return ("%.1fm"):format(n / 1e6) end
    if a >= 1e4 then return ("%.1fk"):format(n / 1e3) end
    return M.comma(n)
end

function M.duration(seconds)
    seconds = math.max(0, math.floor(tonumber(seconds) or 0))
    local h, m = math.floor(seconds / 3600), math.floor(seconds % 3600 / 60)
    if h > 0 then return ("%dh %02dm"):format(h, m) end
    if m > 0 then return ("%dm"):format(m) end
    return ("%ds"):format(seconds)
end

-- per hour of farming; nil under a minute, where a rate is noise
function M.rate(value, seconds)
    seconds = tonumber(seconds) or 0
    if seconds < 60 then return nil end
    return (tonumber(value) or 0) * 3600 / seconds
end

local function withRate(value, seconds)
    local r = M.rate(value, seconds)
    if not r then return "+" .. M.comma(value) end
    return ("+%s (%s/h)"):format(M.comma(value), M.short(r))
end

local function sortedPairs(map, limit)
    local list = {}
    for k, v in pairs(map) do list[#list + 1] = { k, v } end
    table.sort(list, function(a, b)
        if a[2] ~= b[2] then return a[2] > b[2] end
        return a[1] < b[1]
    end)
    while #list > limit do table.remove(list) end
    return list
end

-- the five stats lines for the menu
function M.lines(T, allTime)
    local c = allTime and T.total or T.session
    local levelText
    if allTime then
        levelText = ("Levels +%d"):format(c.levels)
    elseif T.level then
        levelText = ("Level %d (+%d)"):format(T.level, T.level - (T.startLevel or T.level))
    else
        levelText = "Level ?"
    end
    return {
        ("%s %s farmed"):format(allTime and "All-time:" or "Session:", M.duration(c.time)),
        "Dalas " .. withRate(c.dalas, c.time),
        ("XP %s, %s"):format(withRate(c.xp, c.time), levelText),
        ("Kills %s, Bosses %d, Raids %d"):format(M.comma(c.kills), c.bosses, c.raids),
        ("Bounties %d, Quests %d, Harvests %d"):format(c.bounties, c.quests, c.harvests),
        ("Items %s, Arrows %d"):format(M.comma(c.items), c.arrows),
    }
end

local function farmLine(label, f)
    local parts = {}
    if (f.dalas or 0) > 0 then parts[#parts + 1] = M.comma(f.dalas) .. " dalas" end
    if (f.xp or 0) > 0 then parts[#parts + 1] = M.comma(f.xp) .. " xp" end
    if (f.kills or 0) > 0 then parts[#parts + 1] = M.comma(f.kills) .. " kills" end
    if (f.bosses or 0) > 0 then parts[#parts + 1] = f.bosses .. " bosses" end
    if (f.raids or 0) > 0 then parts[#parts + 1] = f.raids .. " raids" end
    if (f.items or 0) > 0 then parts[#parts + 1] = M.comma(f.items) .. " items" end
    if #parts == 0 then return nil end
    return ("**%s**: %s"):format(label, table.concat(parts, ", "))
end

local function countsField(c)
    local parts = {}
    local function add(n, word) if n > 0 then parts[#parts + 1] = ("%s %s"):format(M.comma(n), word) end end
    add(c.kills, "kills"); add(c.bosses, "bosses"); add(c.raids, "raids cleared"); add(c.bounties, "bounties")
    add(c.quests, "quests"); add(c.harvests, "harvests"); add(c.arrows, "arrows"); add(c.deaths, "deaths")
    return #parts > 0 and table.concat(parts, ", ") or "Nothing yet"
end

-- the summary embed; nil when nothing was earned yet
function M.report(T, opts)
    opts = opts or {}
    local c = T.session
    if T.changes == 0 and c.time == 0 then return nil end
    local fields = {
        { name = "Dalas", value = withRate(c.dalas, c.time), inline = true },
        { name = "XP", value = withRate(c.xp, c.time), inline = true },
    }
    if T.level then
        fields[#fields + 1] = { name = "Level", value = ("%d → %d"):format(T.startLevel or T.level, T.level), inline = true }
    end
    fields[#fields + 1] = { name = "Progress", value = countsField(c), inline = false }
    local items = sortedPairs(c.loot, TOP_ITEMS)
    if #items > 0 then
        local parts = {}
        for _, kv in ipairs(items) do parts[#parts + 1] = ("%s ×%s"):format(kv[1], M.comma(kv[2])) end
        fields[#fields + 1] = { name = "Top Loot", value = table.concat(parts, "\n"), inline = false }
    end
    local farmRank = {}
    for label, f in pairs(c.farms) do farmRank[label] = (f.dalas or 0) + (f.xp or 0) + (f.kills or 0) * 10 + (f.items or 0) * 10 end
    local farmLines = {}
    for _, kv in ipairs(sortedPairs(farmRank, TOP_FARMS)) do
        local line = farmLine(kv[1], c.farms[kv[1]])
        if line then farmLines[#farmLines + 1] = line end
    end
    if #farmLines > 0 then
        fields[#fields + 1] = { name = "By Farm", value = table.concat(farmLines, "\n"), inline = false }
    end
    if opts.allTime then
        local t = T.total
        fields[#fields + 1] = {
            name = "All-Time",
            value = ("%s farmed, %s dalas, %s xp, %s kills, %d bosses, %d raids"):format(
                M.duration(t.time), M.short(t.dalas), M.short(t.xp), M.comma(t.kills), t.bosses, t.raids),
            inline = false,
        }
    end
    return {
        title = "Farm Report",
        description = ("%s of farming this session."):format(M.duration(c.time)),
        fields = fields,
        timestamp = true,
    }
end

-- one embed for the big moments gathered since the last post
function M.moments(list)
    if type(list) ~= "table" or #list == 0 then return nil end
    if #list == 1 then
        return { title = list[1].title, description = list[1].text, timestamp = true }
    end
    local lines = {}
    for _, m in ipairs(list) do lines[#lines + 1] = ("**%s**: %s"):format(m.title, m.text) end
    return { title = "Big Moments", description = table.concat(lines, "\n"), timestamp = true }
end

return M

end)
__bundle_register("Features/Auto/Control/Plan", function(require, _LOADED, __bundle_register, __bundle_modules)
-- farm plan: the pure rules behind the farm control; a queue (interrupts first, then the picked order) and a lead (the first switched-on farm in it that has work), where the lead and every farm above it may start work and every farm below it, or outside the plan, waits
local M = {}

M.NONE = "None"

-- every farm the menu offers, in default priority; toggle and owner let the plan drive a farm that hasn't joined Utility/Farms yet
M.CATALOGUE = {
    { name = "WorldEvents",  label = "Bosses and Events", toggle = "AutoWorldEvents_Enabled", owner = "AutoWorldEvents" },
    { name = "Arrows",       label = "Arrow Hunt",        toggle = "ArrowHunt_Enabled",       owner = "ArrowHunt" },
    { name = "Raids",        label = "Raids",             toggle = "AutoRaid_Enabled",        owner = "AutoRaid" },
    { name = "MobFarm",      label = "Mobs",              toggle = "MobFarm_Enabled",         owner = "AutoMobFarm" },
    { name = "Quests",       label = "Quests",            toggle = "AutoQuest_Enabled",       owner = "AutoQuest" },
    { name = "Garden",       label = "Garden",            toggle = "AutoGarden_Enabled",      owner = "AutoGarden" },
    { name = "Cases",        label = "Cash Cases",        toggle = "CashCases_Enabled",       owner = "CashCases" },
    { name = "Beachcombing", label = "Beachcombing",      toggle = "Beachcombing_Enabled",    owner = "AutoBeachcombing" },
}

M.SLOTS = 4

-- picking a preset fills the order and the interrupts; "Custom" leaves them alone
M.PRESETS = {
    { label = "Custom" },
    { label = "Bosses, Raids, Mobs", order = { "WorldEvents", "Raids", "MobFarm" }, interrupts = { "Arrows" } },
    { label = "Story and Garden",    order = { "Quests", "Garden", "Cases" },        interrupts = { "WorldEvents" } },
    { label = "Money",               order = { "WorldEvents", "Cases", "Garden", "Beachcombing" }, interrupts = {} },
    { label = "Arrows",              order = { "Arrows", "MobFarm", "Garden" },      interrupts = {} },
}

function M.presetLabels()
    local out = {}
    for _, p in ipairs(M.PRESETS) do out[#out + 1] = p.label end
    return out
end

function M.preset(label)
    for _, p in ipairs(M.PRESETS) do
        if p.label == label then return p end
    end
    return nil
end

function M.known(name)
    for _, entry in ipairs(M.CATALOGUE) do
        if entry.name == name then return entry end
    end
    return nil
end

-- (labels, labelToName, nameToLabel) for the catalogue plus any registered farm it doesn't list
function M.choices(registered)
    local labels, toName, toLabel = {}, {}, {}
    local function add(name, label)
        if toLabel[name] or toName[label] then return end
        labels[#labels + 1] = label
        toName[label], toLabel[name] = name, label
    end
    for _, entry in ipairs(M.CATALOGUE) do add(entry.name, entry.label) end
    for _, f in ipairs(registered or {}) do add(f.name, f.label or f.name) end
    return labels, toName, toLabel
end

-- interrupts first (in plan order, then any not in the order), then the order; no repeats
function M.queue(order, interrupts)
    local out, seen = {}, {}
    local function push(name)
        if type(name) == "string" and name ~= M.NONE and not seen[name] then
            seen[name] = true
            out[#out + 1] = name
        end
    end
    interrupts = interrupts or {}
    for _, name in ipairs(order or {}) do
        if interrupts[name] then push(name) end
    end
    local extra = {}
    for name, on in pairs(interrupts) do
        if on and not seen[name] then extra[#extra + 1] = name end
    end
    table.sort(extra)
    for _, name in ipairs(extra) do push(name) end
    for _, name in ipairs(order or {}) do push(name) end
    return out
end

-- the first switched-on farm in the queue that has work, or nil
function M.lead(queue, isOn, wants)
    for _, name in ipairs(queue) do
        if isOn(name) and wants(name) then return name end
    end
    return nil
end

local function position(queue, name)
    for i, n in ipairs(queue) do
        if n == name then return i end
    end
    return nil
end

-- farms above the lead still get their passes, so one whose work flag went stale while it waited can find its work again
function M.allowed(name, queue, lead)
    if not lead then return true end
    local mine = position(queue, name)
    if not mine then return false end
    return mine <= position(queue, lead)
end

return M

end)
__bundle_register("Features/Auto/Cases", function(require, _LOADED, __bundle_register, __bundle_modules)
-- cash cases: opens howler's ten hidden cash cases (1000 dalas and exp each, HowlerCases.lua:4-9); the server reveals a case only within 200 studs, so every case seen is remembered across sessions and an optional search visits the map's landmarks; it moves only while no other farm holds movement
local Jobs   = require("Utility/Jobs")
local Log    = require("Utility/Log")
local Mount  = require("Utility/Mount")
local Status = require("Utility/Status")
local Store  = require("Utility/Store")
local UiWrite = require("Utility/UiWrite")
local Farms  = require("Utility/Farms")
local FarmSettings = require("Utility/FarmSettings")
local WorldEvents = require("Features/Auto/WorldEvents")

local OWNER = "CashCases"
local FARM = "Cases"
local TICK = 1
local TOTAL = 10
-- HowlerCases.lua:13-15: reveal at 200 studs, hide past 240
-- live 2026-11-19 (user: sweep quicker): the reveal lands right after arrival, so a search stop waits this long, not the 3 s a known spot gets
local REVEAL_WAIT = 3
local SEARCH_REVEAL = 1.5
-- search stops taken in one pass while movement is free, ending early on a case to open
local SEARCH_BATCH = 6
local OPEN_WAIT = 4
-- HowlerCases.lua HoldDuration 0.8, plus slack
local CASE_HOLD = 1.1
local SEARCH_GAP = 250
local RETRY_AFTER = 600
local MAX_TRIES = 3
local RESEARCH_AFTER = 1800
local NAMESPACE = Store.GAME .. "/cases"
local KEY = "spots"
-- every landmark kind the travel menu knows, minus zones and story props
local SEARCH_KINDS = { "spawn", "npc", "quest_offer", "map", "quest_location", "huber_stop", "area" }

local M = {}

-- points at least `gap` studs apart on the ground plane, first come first kept
function M.spread(points, gap)
    local kept = {}
    for _, p in ipairs(points) do
        local far = true
        for _, k in ipairs(kept) do
            local dx, dz = p.X - k.X, p.Z - k.Z
            if dx * dx + dz * dz < gap * gap then far = false break end
        end
        if far then kept[#kept + 1] = p end
    end
    return kept
end

-- live 2026-11-19 (user: howler crates don't all get grabbed): cases 05, 06 and 09 never revealed, because the search only stood at landmarks 250 apart while a
-- case shows within 200 (HowlerCases.lua RevealRange); a grid this far apart over the landmarks' box leaves no ground more than 200 from a stop (270 / sqrt 2 = 191)
M.GRID_STEP = 270
-- a grid stop farther than this from every landmark is open water or off the map, where no case sits
M.GRID_NEAR = 500

-- grid stops over the box around `points` (padded by `pad`), each at the height of its nearest landmark so it lands near the ground
function M.grid(points, step, pad)
    if #points == 0 then return {} end
    local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
    for _, p in ipairs(points) do
        minX, maxX = math.min(minX, p.X), math.max(maxX, p.X)
        minZ, maxZ = math.min(minZ, p.Z), math.max(maxZ, p.Z)
    end
    local out = {}
    for x = minX - pad, maxX + pad, step do
        for z = minZ - pad, maxZ + pad, step do
            local nearest, nearestD = points[1], math.huge
            for _, p in ipairs(points) do
                local d = (p.X - x) ^ 2 + (p.Z - z) ^ 2
                if d < nearestD then nearest, nearestD = p, d end
            end
            out[#out + 1] = Vector3.new(x, nearest.Y, z)
        end
    end
    return out
end

-- the stops within `radius` of any of `points` (on the ground plane)
function M.near(stops, points, radius)
    local out = {}
    for _, g in ipairs(stops) do
        for _, p in ipairs(points) do
            if (g.X - p.X) ^ 2 + (g.Z - p.Z) ^ 2 <= radius * radius then out[#out + 1] = g break end
        end
    end
    return out
end

-- a nearest-next tour from `from`
function M.tour(points, from)
    local left, out, at = {}, {}, from
    for i, p in ipairs(points) do left[i] = p end
    while #left > 0 do
        local best, bestD = 1, math.huge
        for i, p in ipairs(left) do
            local d = (p - at).Magnitude
            if d < bestD then best, bestD = i, d end
        end
        at = table.remove(left, best)
        out[#out + 1] = at
    end
    return out
end

function M.mount(ctx)
    local O = Mount.orchestrator(ctx, "CashCases")
    if not O then return end
    local Api = ctx.Api or {}
    local Player, World, Activities = Api.Player, Api.World, Api.Activities
    if not (Player and World) then
        Log.devwarn("CashCases", "player or world api missing; cash cases won't load")
        return
    end
    local References, Workspace, Toggles = ctx.References, ctx.Services.Workspace, ctx.Toggles

    local enabled, job, token = false, nil, nil
    local spots = Store.read(NAMESPACE, KEY, {})
    if type(spots) ~= "table" then spots = {} end
    local tries, skipUntil = {}, {}
    local route, routeAt = nil, 1
    local searchDoneAt = nil

    local function post(text, level) Status.set(OWNER, text, level) end

    local function alive()
        local hum = References.humanoid
        return References.character ~= nil and hum ~= nil and hum.Health > 0
    end

    local function opened()
        local out = {}
        for _, id in ipairs(Player.csv("Stats.HowlerCasesOpened")) do out[id] = true end
        return out
    end

    local function count(set)
        local n = 0
        for _ in pairs(set) do n = n + 1 end
        return n
    end

    -- the game client builds each revealed case into workspace.LocalProps as "Case" with HowlerCaseId (HowlerCases.lua:72-120)
    local function liveCases()
        local out = {}
        local props = Workspace:FindFirstChild("LocalProps")
        if not props then return out end
        for _, child in ipairs(props:GetChildren()) do
            local id = child.Name == "Case" and child:GetAttribute("HowlerCaseId")
            if type(id) == "string" and child:IsA("Model") then
                local prompt = child:FindFirstChild("HowlerCaseOpen", true)
                if prompt and prompt:IsA("ProximityPrompt") then out[id] = { model = child, prompt = prompt } end
            end
        end
        return out
    end

    -- remember where each case sits so a later session goes straight there
    local function remember(live)
        local changed = false
        for id, case in pairs(live) do
            local p = case.model:GetPivot().Position
            local known = spots[id]
            if type(known) ~= "table" or math.abs((known[1] or 0) - p.X) > 1 or math.abs((known[3] or 0) - p.Z) > 1 then
                spots[id] = { p.X, p.Y, p.Z }
                changed = true
            end
        end
        if changed then Store.write(NAMESPACE, KEY, spots) end
    end

    local function skipped(id)
        return skipUntil[id] ~= nil and os.clock() < skipUntil[id]
    end

    local function failed(id)
        tries[id] = (tries[id] or 0) + 1
        if tries[id] >= MAX_TRIES then
            tries[id] = 0
            skipUntil[id] = os.clock() + RETRY_AFTER
        end
    end

    -- movement is taken only when nobody holds it, and handed back after every trip
    local function claim()
        local ok, owner = World.owner()
        if ok and owner ~= nil and owner ~= OWNER then return false end
        local okC, t = World.claim(OWNER)
        if not okC then return false end
        token = t
        return true
    end

    local function release()
        if token then World.release(token) end
        token = nil
    end

    local function waitFor(j, cond, timeout)
        local deadline = os.clock() + timeout
        while j.alive do
            local value = cond()
            if value then return value end
            if os.clock() >= deadline then return nil end
            if not j:sleep(0.25) then return nil end
        end
        return nil
    end

    local function open(j, id, case)
        post("Opening a cash case", Status.ACTING)
        -- the prompt sits on its own small part with an 8 stud range (HowlerCases.lua PromptRange); travel there rather than 3 over the model's pivot
        local at = case.prompt.Parent
        local target = (at and at:IsA("BasePart")) and at.Position or case.model
        local ok = World.travelTo(target, { token = token, offset = 3 })
        -- live 2026-11-19 (user: the first open always fails): an unfocused window's scripted hold falls back to an instant fire, which sends Open without the
        -- Hold the server wants first; the prompt's own two sends go out directly, Hold then Open after the hold time, with the prompt press as the fallback
        if ok and Activities and Activities.howlerCase then
            Activities.howlerCase("Hold", id)
            j:sleep(CASE_HOLD)
            Activities.howlerCase("Open", id)
            if waitFor(j, function() return opened()[id] end, OPEN_WAIT) then
                tries[id] = nil
                return true
            end
        end
        if ok then ok = World.firePrompt(case.prompt) end
        if ok and waitFor(j, function() return opened()[id] end, OPEN_WAIT) then
            tries[id] = nil
            return true
        end
        failed(id)
        return false
    end

    local function nextRoutePoint()
        if not route then
            local okD, list = true, {}
            for _, kind in ipairs(SEARCH_KINDS) do
                local ok, part = World.destinations(kind)
                if ok then
                    for _, d in ipairs(part) do list[#list + 1] = d end
                else
                    okD = false
                end
            end
            if not okD and #list == 0 then return nil end
            local points = {}
            for _, d in ipairs(list) do
                if typeof(d.position) == "Vector3" then points[#points + 1] = d.position end
            end
            local root = References.humanoidRootPart
            local from = root and root.Position or Vector3.new()
            -- the grid alone covers every spot within reveal range, so landmark stops would only repeat it; grid stops far from any landmark are dropped
            route = M.tour(M.near(M.grid(points, M.GRID_STEP, M.GRID_STEP / 2), points, M.GRID_NEAR), from)
            routeAt = 1
        end
        local p = route[routeAt]
        if p then routeAt = routeAt + 1 end
        return p
    end

    -- (line, level)
    -- gated: the farm plan held this pass back; found: this pass had a case or a search stop to go to; work: found on the last pass that ran
    local gated, found, work = false, false, false
    local function pass(j)
        gated, found = false, false
        if not Player.ready() then return "Waiting for your save", Status.IDLE end
        local done = opened()
        local have = count(done)
        if have >= TOTAL then return "All cases opened", Status.IDLE end
        local live = liveCases()
        remember(live)
        if not alive() then return "Waiting to respawn", Status.IDLE end
        if Player.isBusy() then return "Waiting for a scene", Status.IDLE end

        -- a revealed case still closed
        local pickId, pick = nil, nil
        for id, case in pairs(live) do
            if not done[id] and not skipped(id) and case.prompt.Enabled then pickId, pick = id, case break end
        end
        -- else a remembered spot, where the case reveals itself again on arrival
        local spotId, spot = nil, nil
        if not pick then
            for id, p in pairs(spots) do
                if not done[id] and not skipped(id) and type(p) == "table" then
                    spotId, spot = id, Vector3.new(p[1] or 0, p[2] or 0, p[3] or 0)
                    break
                end
            end
        end
        local searching = not pick and not spot and Toggles.CashCases_Search ~= nil and Toggles.CashCases_Search.Value == true
        if not (pick or spot or searching) then
            return ("%d of %d opened"):format(have, TOTAL), Status.IDLE
        end
        found = true
        -- a world event the user put first gets movement before a case does
        if WorldEvents.wants() then return "Movement is busy", Status.IDLE end
        if Farms.priority("Cases") then return "Paused for " .. Farms.priority("Cases"), Status.IDLE end
        local may, why = Farms.mayAct(FARM)
        if not may then
            gated = true
            return why, Status.WAITING
        end
        if not claim() then return "Movement is busy", Status.IDLE end

        if pick then
            local ok = open(j, pickId, pick)
            release()
            return ok and "Opened a cash case" or "Case didn't open", Status.ACTING
        end
        if spot then
            post("Going to a cash case", Status.ACTING)
            local ok = World.travelTo(spot, { token = token, ground = true })
            local case = ok and waitFor(j, function() return liveCases()[spotId] end, REVEAL_WAIT)
            local opened1 = case and open(j, spotId, case)
            if not case then failed(spotId) end
            release()
            return opened1 and "Opened a cash case" or "Case not there", Status.ACTING
        end
        local point = nextRoutePoint()
        if not point then
            found = false
            release()
            -- a finished sweep starts over after a while, rather than never looking again
            searchDoneAt = searchDoneAt or os.clock()
            if os.clock() - searchDoneAt >= RESEARCH_AFTER then route, searchDoneAt = nil, nil end
            return "Search done", Status.IDLE
        end
        -- several stops per pass while nothing else wants movement; a closed case found ends the batch so the next pass opens it
        local function unopenedHere()
            local live, doneNow = liveCases(), opened()
            remember(live)
            for id in pairs(live) do
                if not doneNow[id] and not skipped(id) then return true end
            end
            return false
        end
        for stop = 1, SEARCH_BATCH do
            if stop > 1 then
                point = nextRoutePoint()
                if not point or not j.alive or WorldEvents.wants() or Farms.priority("Cases") then break end
            end
            post(("Searching %d of %d"):format(routeAt - 1, #route), Status.ACTING)
            -- live 2026-11-19 (user: falling and hurt between stops): a grid stop's height is a guess, so it lands on the floor found under it
            World.travelTo(point, { token = token, ground = true })
            if waitFor(j, unopenedHere, SEARCH_REVEAL) then break end
        end
        release()
        return ("Searching %d of %d"):format(math.max(routeAt - 1, 0), #route), Status.ACTING
    end

    local function loop(j)
        while j.alive and enabled do
            local ok, line, level = pcall(pass, j)
            if ok then
                if not gated then work = found end
                if line then post(line, level) end
            else
                release()
                Log.devwarn("CashCases", "pass failed: %s", tostring(line))
            end
            if not j:sleep(FarmSettings.tick(TICK)) then return end
        end
    end

    local function stop()
        enabled = false
        if job then job:Cancel() end
        job = nil
        release()
        route = nil
        gated, found, work = false, false, false
        Status.clear(OWNER)
    end

    local box = ctx.Tabs.Gathering:AddLeftGroupbox("Cash Cases", "briefcase")
    box:AddToggle("CashCases_Enabled", {
        Text     = "Open Cash Cases",
        Default  = false,
        Callback = function(on)
            if on then
                if enabled then return end
                enabled = true
                job = O.track(Jobs.spawn(loop, { name = "CashCases" }))
            else
                stop()
            end
        end,
    })
    Farms.register({
        name    = FARM,
        label   = "Cash Cases",
        owner   = OWNER,
        enable  = function(on) UiWrite.value(Toggles.CashCases_Enabled, on) end,
        enabled = function() return enabled end,
        active  = function() return token ~= nil end,
        wants   = function() return enabled and work end,
    })
    box:AddToggle("CashCases_Search", {
        Text    = "Search the Map",
        Default = false,
        Tooltip = "Visits each landmark to find hidden cases",
    })

    O.onUnload(stop)
    O.onUnload(function() Farms.unregister(FARM) end)
    O.finalize()
end

return M

end)
__bundle_register("Features/Auto/Stats", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto stats: spends your stat points on a build as they come in, steering the allocated Damage / Health / Ability toward the build's split; one point batch per pass, through Player.spendStat (Data "Stats", the menu's own call)
local Jobs      = require("Utility/Jobs")
local Log       = require("Utility/Log")
local Mount     = require("Utility/Mount")

local TICK = 2
local SPEND_WAIT = 3
-- recon/damage.md 1.4: every Magician's Red skill but Barrage scales 90% on Ability, Barrage 80% on Strength (the Damage stat), m1s on Damage; Health is your max health
local BUILDS = {
    ["Skills"]   = { Ability = 0.6, Health = 0.3, Damage = 0.1 },
    ["Balanced"] = { Ability = 0.4, Health = 0.3, Damage = 0.3 },
    ["Tank"]     = { Ability = 0.3, Health = 0.6, Damage = 0.1 },
    ["Melee"]    = { Ability = 0.1, Health = 0.3, Damage = 0.6 },
}
local BUILD_NAMES = { "Skills", "Balanced", "Tank", "Melee" }
local ORDER = { "Ability", "Health", "Damage" }

local M = {}

-- how many of `points` each stat gets so the allocated totals land as close to the split as whole points allow
function M.plan(stats, split, points)
    local total = points
    for _, name in ipairs(ORDER) do total = total + (stats[name] or 1) end
    local out, left = {}, points
    for _, name in ipairs(ORDER) do
        local want = math.floor(total * (split[name] or 0) + 0.5) - (stats[name] or 1)
        local give = math.max(0, math.min(left, want))
        out[name] = give
        left = left - give
    end
    -- rounding leftovers go to the build's biggest share
    if left > 0 then
        local top, share = ORDER[1], -1
        for _, name in ipairs(ORDER) do
            if (split[name] or 0) > share then top, share = name, split[name] or 0 end
        end
        out[top] = out[top] + left
    end
    return out
end

function M.mount(ctx)
    local O = Mount.orchestrator(ctx, "AutoStats")
    if not O then return end
    local Player = ctx.Api and ctx.Api.Player
    if not Player then
        Log.devwarn("AutoStats", "player api missing; auto stats won't load")
        return
    end
    local Options = ctx.Options

    local enabled, job = false, nil

    local function build()
        local element = Options.AutoStats_Build
        return BUILDS[element and element.Value] or BUILDS.Skills
    end

    local function pass()
        local ok, stats = Player.stats()
        if not ok then return nil end
        if stats.points < 1 then return nil end
        local plan = M.plan(stats, build(), stats.points)
        for _, name in ipairs(ORDER) do
            local n = plan[name]
            if n > 0 then
                local spent, err = Player.spendStat(name, n)
                if not spent then
                    Log.devwarn("AutoStats", "spend %d %s failed: %s", n, name, tostring(err))
                    return "Couldn't spend points"
                end
            end
        end
        return "Spent " .. stats.points .. " points"
    end

    local function loop(j)
        while j.alive and enabled do
            local ok, line = pcall(pass)
            if not ok then Log.devwarn("AutoStats", "pass failed: %s", tostring(line)) end
            if not j:sleep(line and SPEND_WAIT or TICK) then return end
        end
    end

    local function stop()
        enabled = false
        if job then job:Cancel() end
        job = nil
    end

    local box = ctx.Tabs.GameCharacter:AddRightGroupbox("Auto Stats", "chart-bar")
    box:AddToggle("AutoStats_Enabled", {
        Text     = "Auto Stats",
        Default  = false,
        Callback = function(on)
            if on then
                if enabled then return end
                enabled = true
                job = O.track(Jobs.spawn(loop, { name = "AutoStats" }))
            else
                stop()
            end
        end,
    })
    box:AddDropdown("AutoStats_Build", {
        Text    = "Build",
        Values  = BUILD_NAMES,
        Default = "Skills",
        Tooltip = "Skills suits Magician's Red",
    })

    O.onUnload(stop)
    O.finalize()
end

return M

end)
__bundle_register("Features/Auto/Quests", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto quests: one job that finishes the tutorial, then drives the story and the side quests you tick, teleporting under its own movement claim, waiting on the server after every step, sitting out deaths and parking what it can't do with a short status
local Jobs      = require("Utility/Jobs")
local Log       = require("Utility/Log")
local Mount     = require("Utility/Mount")
local Scheduler = require("Utility/Scheduler")
local Status    = require("Utility/Status")
local UiWrite   = require("Utility/UiWrite")
local Farms     = require("Utility/Farms")
local FarmSettings = require("Utility/FarmSettings")
local Engage    = require("Features/Combat/Engage")
local Bounties  = require("Features/Auto/Quests/Bounties")
local Driver    = require("Features/Auto/Quests/Driver")
local Howler    = require("Features/Auto/Quests/Howler")
local Puzzles   = require("Features/Auto/Quests/Puzzles")
local Side      = require("Features/Auto/Quests/Side")
local Story     = require("Features/Auto/Quests/Story")
local Tutorial  = require("Features/Auto/Quests/Tutorial")
local Flow      = require("Features/Auto/Garden/Flow")
local WorldEvents = require("Features/Auto/WorldEvents")

local OWNER = "AutoQuest"
local FARM = "Quests"
local TICK = 0.5
local RESPAWN_POLL = 0.5
local RESPAWN_WAIT = 30
local REFRESH = 0.5

return function(ctx)
    local O = Mount.orchestrator(ctx, "AutoQuests")
    if not O then return end
    local Api        = ctx.Api or {}
    local Activities = Api.Activities
    local World      = Api.World
    local Player     = Api.Player
    if not (Activities and World and Player) then
        Log.devwarn("AutoQuests", "activities, world or player api missing; auto quests won't load")
        return
    end
    local Options, Toggles, Library = ctx.Options, ctx.Toggles, ctx.Library

    local Q = {
        Activities = Activities, World = World, Player = Player, Combat = Api.Combat, Net = Api.Net,
        References = ctx.References, Workspace = ctx.Services.Workspace, RunService = ctx.Services.RunService, UserInputService = ctx.Services.UserInputService,
        owner = OWNER, job = nil, token = nil, current = nil, Toggles = Toggles,
    }
    -- every line goes to the topbar (Utility/Status); a line said mid-step is the action under way
    local function post(text, level) Status.set(OWNER, text, level) end
    function Q.say(text) post(text, Status.ACTING) end
    function Q.log(fmt, ...) Log.dev("AutoQuests", fmt, ...) end

    -- the shared combat engine is built once, on the first fight that needs it
    local engine, engineTried = nil, false
    function Q.engine()
        if engine or engineTried then return engine end
        engineTried = true
        local ok, built = pcall(Engage.new, ctx)
        if ok and built then
            engine = built
        else
            Log.devwarn("AutoQuests", "combat engine failed to build: %s", tostring(built))
        end
        return engine
    end

    -- the garden flow for Jodio's crop, built once on first use
    local gardenFlow = nil
    function Q.garden()
        if gardenFlow == nil then gardenFlow = Flow.new(ctx, OWNER) or false end
        return gardenFlow or nil
    end

    -- the story puzzles the server pushes are kept from load, so one that arrives mid-step is still there to answer
    Q.puzzles = Puzzles(Q)
    for _, handle in ipairs(Q.puzzles.listen()) do O.track(handle) end

    local D = Driver(Q)
    D.howlerSteps = Howler.new(Q, D)
    local T = Tutorial(Q, D)
    local S = Story(Q, D)
    local Sd = Side(Q, D, Bounties(Q, D))

    local enabled, job = false, nil
    -- gated: the farm plan held this pass back; work: the last pass that ran acted
    local gated, work = false, false

    local function toggleOn(id, default)
        local element = Toggles[id]
        if element == nil then return default end
        return element.Value == true
    end

    function Q.storyXp() return toggleOn("AutoQuest_StoryXp", true) end
    function Q.solvePuzzles() return toggleOn("AutoQuest_Puzzles", true) end

    local function pickedSides()
        local element = Options.AutoQuest_Side
        local value = element and element.Value
        return type(value) == "table" and value or {}
    end

    -- the claim is taken once and re-taken only if another owner held it when we last asked
    local function ensureClaim()
        if Q.token then
            local ok, owner = World.owner()
            if ok and owner == OWNER then return true end
            Q.token = nil
        end
        local ok, token = World.claim(OWNER)
        if not ok then return false end
        Q.token = token
        return true
    end

    local function releaseClaim()
        if Q.token then World.release(Q.token) end
        Q.token = nil
    end

    -- a death mid-step ends the step; the next pass waits here for the new character, then the same objective resumes
    local function waitRespawn(j)
        post("Waiting to respawn", Status.WAITING)
        local waited = 0
        while j.alive and waited < RESPAWN_WAIT do
            if D.alive() and Player.spawnReady() then return true end
            if not j:sleep(RESPAWN_POLL) then return false end
            waited = waited + RESPAWN_POLL
        end
        return D.alive()
    end

    -- live 2026-11-18 (user): auto garden's trips cut into the story; while the story is moving the other farms wait for it (Farms.priority), and a story
    -- that hasn't acted for STORY_HOLD lets them back in, so a stuck step still can't starve the garden
    local STORY_HOLD = 30
    local storyAt = -math.huge
    local function holdForStory()
        Farms.setPriority(FARM, enabled and os.clock() - storyAt < STORY_HOLD or false, "the story")
    end

    -- (line, busy): busy when this pass acted
    local function pass(j)
        Q.waiting = nil
        gated = false
        if not Player.ready() then return "Waiting for your save", false end
        -- events first: a live world event the user put ahead of everything gets movement at the start of a pass, never mid-step
        if WorldEvents.wants() then return "Paused for an event", false end
        if Farms.priority("Quests") then return "Paused for " .. Farms.priority("Quests"), false end
