__bundle_register("Api/World", function(require, _LOADED, __bundle_register, __bundle_modules)
-- world api: everything outside you (areas, destinations, combatants, items, prompts, streaming, the one sanctioned mover, huber, the server list, weather); stream-scoped models are re-read on every call, never cached as a miss
local Api        = require("Api")
local Areas      = require("Api/World/Areas")
local Combatants = require("Api/World/Combatants")
local Errors     = require("Api/World/Errors")
local Huber      = require("Api/World/Huber")
local Items      = require("Api/World/Items")
local Movement   = require("Api/World/Movement")
local Places     = require("Api/World/Places")
local Prompts    = require("Api/World/Prompts")
local Servers    = require("Api/World/Servers")
local Streaming  = require("Api/World/Streaming")

local M = {}

-- without Net every verb that reaches the game answers no_net, while the instance readers keep working
local function offlineNet()
    local function refuse() return false, Errors.NO_NET end
    return {
        fire          = refuse,
        fireAllowed   = refuse,
        invoke        = refuse,
        invokeAllowed = refuse,
        module        = refuse,
        on            = function() return nil, Errors.NO_NET end,
        onVerb        = function() return nil, Errors.NO_NET end,
    }
end

function M.new(ctx)
    local base       = Api.define("World", ctx)
    local maid       = base.maid
    local References = ctx.References

    local Net = ctx.Api and ctx.Api.Net
    if not Net then
        base.warn("net api missing; every world verb that reaches the game answers %s", Errors.NO_NET)
        Net = offlineNet()
    end

    -- Player owns the LocalPlayer.Data reader; without it World reads LocalPlayer attributes itself and has no Data at all
    local Player = ctx.Api and ctx.Api.Player
    if not Player then base.warn("player api missing; data reads fall back to defaults") end

    local function dataValue(path)
        if not Player then return nil end
        return Player.value(path)
    end

    local function playerAttr(name)
        if Player then return Player.playerAttr(name) end
        local player = References.player
        return player and player:GetAttribute(name)
    end

    -- hands a connection or job to the api maid; the returned release lets it go early
    local function track(conn)
        if not conn then return function() end end
        local id = maid and maid:GiveTask(conn)
        return function()
            if id then
                maid[id] = nil
                id = nil
            elseif conn then
                pcall(conn.Disconnect, conn)
            end
            conn = nil
        end
    end

    local function own(fn)
        if maid then maid:GiveTask(fn) end
    end

    local shared = {
        base       = base,
        Net        = Net,
        Errors     = Errors,
        track      = track,
        own        = own,
        dataValue  = dataValue,
        playerAttr = playerAttr,
        hasPlayer  = Player ~= nil,
    }

    -- build order matters: each builder may read helpers the ones before it left on shared
    local surface = { Errors = Errors }
    for _, build in ipairs({ Areas, Places, Combatants, Items, Prompts, Streaming, Movement, Huber, Servers }) do
        for name, member in pairs(build(ctx, shared)) do
            if surface[name] ~= nil then error("world: two builders export " .. name) end
            surface[name] = member
        end
    end

    base.log("world api ready")
    return surface
end

return M

end)
__bundle_register("Api/World/Streaming", function(require, _LOADED, __bundle_register, __bundle_modules)
-- world streaming: RequestStreamAroundAsync on its own job with a bounded wait (it can hang past its own timeout, and later calls queue behind a hung one, so a second request is refused while one is out), and the ViewZones wait for LocalPlayer.ViewZonesLoading to clear
local Jobs = require("Utility/Jobs")

local POLL = 0.05
local STREAM_TIMEOUT = 3
local VIEWZONES_TIMEOUT = 10

return function(ctx, shared)
    local References = ctx.References
    local Errors     = shared.Errors

    local inFlight = nil

    -- yields up to timeout; (true) once the request returns, (false, code) otherwise
    local function streamAround(position, timeout)
        if typeof(position) ~= "Vector3" then return false, Errors.BAD_ARGS end
        timeout = tonumber(timeout) or STREAM_TIMEOUT
        if timeout <= 0 then return false, Errors.BAD_ARGS end
        if inFlight and inFlight.job.alive then return false, Errors.STREAM_BUSY end
        local player = References.player
        if not player then return false, Errors.NO_CHARACTER end
        local request = { done = false, ok = false }
        -- the game asks with the same call (PlayerController.lua:20321)
        request.job = Jobs.spawn(function()
            request.ok = pcall(player.RequestStreamAroundAsync, player, position, timeout)
            request.done = true
        end, { name = "World.streamAround" })
        if not request.done then inFlight = request end
        local deadline = os.clock() + timeout + 0.5
        while not request.done and os.clock() < deadline do
            task.wait(POLL)
        end
        if not request.done then return false, Errors.TIMED_OUT end
        if inFlight == request then inFlight = nil end
        return request.ok, (not request.ok) and Errors.UNAVAILABLE or nil
    end

    local function waitViewZones(timeout)
        timeout = tonumber(timeout) or VIEWZONES_TIMEOUT
        local deadline = os.clock() + timeout
        while shared.playerAttr("ViewZonesLoading") == true do
            if os.clock() >= deadline then return false, Errors.TIMED_OUT end
            task.wait(POLL)
        end
        return true
    end

    shared.own(function()
        if inFlight then inFlight.job:Cancel() end
        inFlight = nil
    end)

    shared.streamAround = streamAround
    shared.waitViewZones = waitViewZones

    return {
        streamAround  = streamAround,
        waitViewZones = waitViewZones,
    }
end

end)
__bundle_register("Api/World/Servers", function(require, _LOADED, __bundle_register, __bundle_modules)
