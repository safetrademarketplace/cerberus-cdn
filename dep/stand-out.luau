            local ok, result = Player.useArrow(arrow, nil, {
                decide = function(payload) return not isWanted(payload.Stand) end,
            })
            if ok then
                rolls, fails = rolls + 1, 0
                Status.set(OWNER, "Rolled " .. tostring(result), Status.ACTING)
                if not j:sleep(ROLL_GAP) then return end
            elseif result == Errors.CANCELLED then
                dismissDialog()
            elseif result == Errors.LOCKED or result == Errors.BUSY or result == Errors.IN_WATER then
                fails = fails + 1
                if fails >= LOCK_TRIES then return finish(result == Errors.IN_WATER and "Get out of the water to roll" or "Can't use arrows right now") end
