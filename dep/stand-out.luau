                end
            end
        end
    end

    -- Combat_LearnSwings (block tab); on unless the box is mounted and switched off
    local function learningOn()
        local toggles = ctx.Toggles
        local element = toggles and toggles.Combat_LearnSwings
        return element == nil or element.Value == true
    end

    local function isLearned(rec)
        return rec ~= nil and rec.hits >= LEARN_HITS and rec.hits / math.max(rec.plays, 1) >= LEARN_RATIO
    end
    local animHooks = setmetatable({}, { __mode = "k" })
    local recentAnims = {}

    local function indexAnimations()
        if animIndex then return animIndex end
        animIndex = {}
        local RS = ctx.Services.ReplicatedStorage
        local assets = RS and RS:FindFirstChild("Assets")
        local root = assets and assets:FindFirstChild("Animations")
        if not root then return animIndex end
        for _, anim in ipairs(root:GetDescendants()) do
            if anim:IsA("Animation") then
                local kind = nil
                local node = anim.Parent
                while node and node ~= root and not kind do
                    kind = ATTACK_FOLDERS[node.Name]
                    node = node.Parent
                end
                kind = kind or ATTACK_FOLDERS[anim.Name]
                local id = string.match(anim.AnimationId, "%d+")
                if kind and id then animIndex[id] = kind end
            end
