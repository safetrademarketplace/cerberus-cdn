        local handle = {}
        function handle.setTarget(model)
            if typeof(model) ~= "Instance" or not model:IsA("Model") then return false, Errors.BAD_ARGS end
            if trip.stopped then return false, trip.stopped end
            state.target = model
            state.lost = false
            return true
        end
        function handle.set(newOpts)
            if type(newOpts) ~= "table" then return false, Errors.BAD_ARGS end
            if trip.stopped then return false, trip.stopped end
            local probe = { mode = state.mode, distance = state.distance, height = state.height, side = state.side }
            if not attachSettings(probe, newOpts) then return false, Errors.BAD_ARGS end
            state.mode, state.distance, state.height, state.side = probe.mode, probe.distance, probe.height, probe.side
            return true
        end
        function handle.target() return state.target end
        function handle.lost() return state.lost end
        function handle.active() return trip.stopped == nil end
        function handle.reason() return trip.stopped end
        function handle.stop()
            if trip.stopped == nil then stopTrip(trip, Errors.STOPPED) end
            return true
        end
        handle.Destroy = handle.stop
        handle.Disconnect = handle.stop
        return true, handle
    end

    local function claim(owner)
        if type(owner) ~= "string" or owner == "" then return false, Errors.BAD_ARGS end
        if claimed then
            if claimed.owner == owner then return true, claimed.token end
            return false, Errors.BUSY, claimed.owner
        end
        claimSeq = claimSeq + 1
        claimed = { owner = owner, token = ("%s#%d"):format(owner, claimSeq) }
        -- a trip nobody owned was never protected; the new owner starts from a still character
        if active and active.token == nil then stopTrip(active, Errors.PREEMPTED) end
        return true, claimed.token
    end

    -- standing down ends only your own claim and your own trip; a stale token never touches the next owner's
    local function release(token)
        if not claimed or token ~= claimed.token then return false, Errors.NOT_OWNER end
        claimed = nil
        if active and active.token == token then stopTrip(active, Errors.RELEASED) end
        return true
    end

    local function owner()
        return true, claimed and claimed.owner or nil
    end

    local function stop(token)
        local ok, err = authorize(token)
        if not ok then return false, err end
        if not active then return true, false end
        stopTrip(active, Errors.STOPPED)
        return true, true
    end

    shared.walkTo = walkTo
    shared.travelTo = travelTo
    shared.own(function()
        if active then stopTrip(active, Errors.STOPPED) end
        claimed = nil
    end)

    return {
        claim    = claim,
        release  = release,
        owner    = owner,
        travelTo = travelTo,
        walkTo   = walkTo,
        glideTo  = glideTo,
        teleport = teleport,
        attach   = attach,
        stop     = stop,
    }
end

end)
__bundle_register("Api/World/Items", function(require, _LOADED, __bundle_register, __bundle_modules)
-- world items: dropped world items in workspace.Game.SpawnedItems plus the ones the client put away in ReplicatedStorage.WorldItemsPutAway while capped, skipping any spawned before LocalPlayer.WorldItemsSince the way WorldItemVisibility does (WorldItemVisibility.lua:15-24)
return function(ctx, shared)
    local Services  = ctx.Services
    local Workspace = Services.Workspace
    local RS        = Services.ReplicatedStorage
    local base      = shared.base

    local itemAdded = base.signal()
    local boundFolder = nil
    local releaseAdded = nil

    local function stale(model)
        local spawnedAt = model:GetAttribute("WorldItemSpawnedAt")
        local since = shared.playerAttr("WorldItemsSince")
        return type(spawnedAt) == "number" and type(since) == "number" and spawnedAt < since
    end

    local function spawnedFolder()
        local root = Workspace:FindFirstChild("Game")
        return root and root:FindFirstChild("SpawnedItems") or nil
    end

    local function ensureFolder()
        local folder = spawnedFolder()
        if folder == boundFolder then return end
        if releaseAdded then releaseAdded() end
        releaseAdded = nil
        boundFolder = folder
        if not folder then return end
        releaseAdded = shared.track(folder.ChildAdded:Connect(function(model)
            if not stale(model) then itemAdded:Fire(model) end
        end))
    end
    ensureFolder()

    local function positionOf(inst)
        if inst:IsA("BasePart") then return inst.Position end
        if inst:IsA("Model") then return inst:GetPivot().Position end
        return nil
    end

    local function items()
        ensureFolder()
        local out = {}
        for _, pair in ipairs({ { boundFolder, false }, { RS:FindFirstChild("WorldItemsPutAway"), true } }) do
            local folder, putAway = pair[1], pair[2]
            if folder then
                for _, model in ipairs(folder:GetChildren()) do
                    local position = positionOf(model)
                    if position and not stale(model) then
                        out[#out + 1] = { model = model, name = model.Name, position = position, putAway = putAway }
                    end
                end
            end
        end
        return true, out
    end

    return {
        items     = items,
        itemAdded = itemAdded,
    }
end

end)
