-- plain: the recorded route ({ Vector3 }) for a rings objective and whether it's hopped by teleport instead of run, or nil
function Plan.ringsRoute(objective)
    local text = lower(objective)
    for _, r in ipairs(Plan.RINGS_ROUTES) do
        if string.find(text, r.phrase, 1, true) then return r.points, r.teleport == true end
    end
    return nil
end

-- plain: where to pick a route up from `pos`: the point after the nearest one (so a resumed run never doubles back), 1 when far from it all
function Plan.routeResume(points, pos, near)
    local best, bestD = nil, math.huge
    for i, p in ipairs(points) do
        local d = (p - pos).Magnitude
        if d < bestD then best, bestD = i, d end
    end
    if not best or bestD > (near or 25) then return 1, false end
    return math.min(#points, best + 1), true
end

-- plain: the waypoints ({ Vector3 }, tried in order) for a rings objective and which of them are walked to from the one before ({ [i] = true }), or nil
function Plan.ringsWaypoint(objective)
    local text = lower(objective)
    for _, w in ipairs(Plan.RINGS_WAYPOINTS) do
        if string.find(text, w.phrase, 1, true) then
            -- a single point has an X; a list of candidates doesn't
            if w.at.X ~= nil then return { w.at }, w.walk or {} end
            return w.at, w.walk or {}
        end
    end
    return nil
end

-- plain: the names in the state's EncounterTargets ({ { Name, Position } }, TrainRaidClient.Rings.lua:1399-1466), the knights a rings arena wants killed
function Plan.targetNames(state)
    local out = {}
    local list = type(state) == "table" and state.EncounterTargets
    if type(list) ~= "table" then return out end
    for _, t in ipairs(list) do
        if type(t) == "table" and type(t.Name) == "string" then out[t.Name] = true end
    end
    return out
end

function Plan.isEnemy(model, bossName, targets)
    if model:GetAttribute("TrainRaidDisguised") == true or model:GetAttribute("TrainRaidDormant") == true then return false end
    if targets and targets[model.Name] then return true end
    -- live 2026-11-18: the mist car's aged passengers (TrainRaidAmbient) were fought instead of iced
    if model:GetAttribute("TrainRaidAmbient") ~= nil and model:GetAttribute("TrainRaidAmbient") ~= false then return false end
    if Plan.isBoss(model, bossName) then return true end
    if model:GetAttribute("FightableNPC") == true then return true end
    local target = model:FindFirstChild("NPCCombatTarget")
    return target ~= nil and target:IsA("ObjectValue") and target.Value ~= nil
end

-- the boss the state names ({ Boss = { Name } }, TrainRaidClient.lua:1629-1633), or a BossNPC-tagged model
function Plan.isBoss(model, bossName)
    if model:GetAttribute("BossNPC") == true then return true end
    if type(bossName) ~= "string" or bossName == "" then return false end
    local base = lower(Plan.baseName(model.Name))
    local boss = lower(bossName)
    return base == boss or (#boss >= 3 and string.find(base, boss, 1, true) ~= nil)
end

-- lower is better: anything aimed at you first, hurt ones a little sooner, nearer first, and the boss last while it still has adds (adds that buff or shield it go down first)
-- live 2026-11-18: in "Protect Coco Jumbo" the agents hitting the turtle (Target = CocoJumbo_<id>) sat 60 studs off while we traded with the one on us and the turtle fell to 12%; whatever is attacking what you protect goes first
function Plan.score(entry, hasAdds)
    local score = tonumber(entry.distance) or 999
    if entry.protects then score = score - 200 end
    -- live 2026-11-18: agents with Beach Boy hook you from 70-175 studs and the tear-out killed us twice; the angler goes down before anyone near
    if entry.angler then score = score - 120 end
    if entry.aggro then score = score - 40 end
    score = score + (tonumber(entry.ratio) or 1) * 15
    if entry.boss and hasAdds then score = score + 1000 end
    return score
end

function Plan.rank(entries)
    local hasAdds = false
    for _, e in ipairs(entries) do
        if not e.boss then hasAdds = true break end
    end
    table.sort(entries, function(a, b) return Plan.score(a, hasAdds) < Plan.score(b, hasAdds) end)
    return entries[1]
end

-- only a real reason moves the fight: off the boss onto an add, or onto something hitting you while the current target isn't
function Plan.shouldSwitch(current, best)
    if not best or not current then return best ~= nil end
    if best.model == current.model then return false end
    if current.boss and not best.boss then return true end
    if best.protects and not current.protects then return true end
    if best.angler and not current.angler and not current.protects then return true end
    if best.aggro and not current.aggro and (tonumber(best.distance) or 999) < (tonumber(current.distance) or 999) then return true end
    return false
end

-- live 2026-11-18: car 1's way out is "Pick the lock" on an object named "Exit", so only the action and the prompt's name are read
-- live 2026-11-18: car 8 says "Leave Coco Jumbo"; a prompt the objective names by its action is the way on, whatever the word
function Plan.safePrompt(p, objective)
    local action = lower(p.action)
    -- TrainRaidClient.Rings.lua:1371-1389: a spare ring you've claimed carries Claimed_<UserId> (the client only hides it), so it isn't pressed again
    if p.claimed then return false end
    if action ~= "" and objective ~= nil and string.find(lower(objective), action, 1, true) then return true end
    -- live 2026-11-18: coco jumbo's "Enter, or tap to carry him" held through drops you into his room; it's only for an objective that says to enter
    if string.find(action, "enter", 1, true) then return objective ~= nil and string.find(lower(objective), "enter", 1, true) ~= nil end
    -- live 2026-11-19 (user): car 5's front exit "Unlock" is enabled from the start, and we tried it during "Find the door key"; it waits for an objective that says unlock
    if string.find(action, "unlock", 1, true) then return objective ~= nil and string.find(lower(objective), "unlock", 1, true) ~= nil end
    local text = action .. " " .. lower(p.name)
    for _, word in ipairs(UNSAFE) do
        if string.find(text, word, 1, true) then return false end
    end
    return true
end

-- live 2026-11-18: the spy is the passenger whose Config is TrainRaidHidden_<stand> (BossNPC, a stand of its own); every innocent reads TrainRaidAccused
function Plan.isSpy(model)
    if type(model) ~= "userdata" and type(model) ~= "table" then return false end
    local ok, spy = pcall(function()
        if model:GetAttribute("TrainRaidDisguised") == true then return true end
        local config = model:GetAttribute("Config")
        return model:GetAttribute("TrainRaidPassenger") ~= nil and type(config) == "string" and string.sub(config, 1, 15) == "TrainRaidHidden"
    end)
    return ok and spy == true
end

-- TrainRaidClient.lua:1848-1909: a suspect page can be accused only when the server allows it
function Plan.shouldAccuse(push)
    if type(push) ~= "table" or push.NoAccuse == true then return false end
    if push.Index == nil or type(push.Token) ~= "string" then return false end
    return Plan.isSpy(push.Model)
end

-- a short line for the topbar: "Car 3/7", "Stage 2/4"
function Plan.progress(state)
    if type(state) ~= "table" then return "" end
    local raid = Plan.RAIDS[state.Raid] or Plan.RAIDS.Train
    local car, cars = tonumber(state.Car), tonumber(state.Cars)
    if car and cars and cars > 0 then return ("%s %d/%d"):format(raid.unit, car, cars) end
    return ""
end

-- the run limit: 0 is no limit
function Plan.limitReached(runs, limit)
    limit = tonumber(limit) or 0
    return limit > 0 and (tonumber(runs) or 0) >= limit
end

-- plain: true when the raid server holds more players than the user allows; a limit of 0 is off
function Plan.tooCrowded(count, limit)
    limit = tonumber(limit) or 0
    return limit > 0 and (tonumber(count) or 0) > limit
end

return Plan

