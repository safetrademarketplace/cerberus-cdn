        elseif verb == "GrowingClosed" then
            if not (growing and type(payload) == "table" and payload.Token == growing.token) then return end
            growing = nil
        elseif (verb == "ProcessingStart" or verb == "GardenUseStart") and type(payload) == "table" then
            processing = { token = payload.Token, payload = payload, pending = false, use = verb == "GardenUseStart" }
        elseif verb == "ProcessingUpdate" then
            if not newer(processing, payload) then return end
            processing.payload, processing.pending = payload, false
