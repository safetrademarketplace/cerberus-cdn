        local B, err = need()
        if not B then return false, err end
        if not contains(Player.csv("Stats.CompletedQuests"), BOARD_GATE) then return false, Errors.LOCKED end
        if B.GetPendingRewardId(References.player) then return false, Errors.PENDING_REWARD end
        if B.HasCompleted(References.player, id) then return false, Errors.ALREADY_DONE end
        if contains(decodedList("Stats.ActiveBounties"), id) then return false, Errors.ALREADY_ACTIVE end
