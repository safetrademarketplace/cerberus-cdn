        P9_29_EXTRACT_BAGS_GROOVE        = function(q) return { run = function() return bags(q) end } end,
        P9_33A_DARBY_WAGER               = function(q) return { run = function() return darby.run(q) end, timeout = 15 } end,
        P9_33B_COMPLETE_ELIMINATION      = function() return { run = elimination.run, timeout = 20 } end,
    }

    -- live 2026-11-17: the diamond can end up dropped as Effects.DroppedRohanDiamond (owned by you, hold 1 s "Pick Up"); the escape only counts while you carry it, and teleporting with it held is fine
    local function escapeWithDiamond(q, before)
        local effects = D.gamePath({ "Effects" })
        local dropped = effects and effects:FindFirstChild("DroppedRohanDiamond")
        if dropped and dropped:GetAttribute("OwnerUserId") == References.player.UserId then
            local ok, err = D.fireAt(dropped, q, {}, "the diamond")
            if not ok then return false, err end
            if not D.waitFor(function() return not dropped.Parent end, HOLD_WAIT) then return false, "not_picked_up" end
        end
        return D.reach(q, "EscapeExit", before)
    end

    function S.specFor(q, tag)
        local special = SPECIAL[q.id]
        if special then return special(q) end
        if string.match(tag, "^Howler_") or string.match(tag, "^KeyWest_") then
            -- Quests.lua:2447-2451 and 2504-2520: ningbo's pair and key west are fought once their checkpoint starts the encounter
            local fightAfter = nil
            if tag == "Howler_NingboDefeated" then fightAfter = { prefixes = { "Ningbo", "Laem Chabang" }, label = "Ningbo" } end
            if Player.playerAttr("HowlerStoryCheckpointKey") == "45_Weaken" then fightAfter = { hostileNear = true, label = "Key West" } end
            return { run = function()
                return howlerStep(q, fightAfter and function() return D.defeat(q, tag, fightAfter) end)
            end }
        end
        if tag == "Escape_RohanHouse" then
            return { run = function(before) return escapeWithDiamond(q, before) end }
        end
        if tag == "Interact_Usagi" then return usagiSpec() end
        if string.sub(tag, 1, 6) == "Reach_" and References.player:GetAttribute("CarryingUsagi") == true then
            local x = string.sub(tag, 7)
            return { run = function(before) return carryReach(q, x, before) end }
        end
        return INTERACT[tag] or DEFEAT[tag]
    end

    -- P9_01 has no giver and no client Start Quest; meryl's StoryServerDialogue prompt is the only path the client has (DialogueHandler.lua:1641-1643)
    local function startMeryl()
        local key = FIRST .. "|start"
        local parked = D.blocked(key)
        if parked then return "Meryl not ready", false end
        local fallback = MERYL_AT
        local okOffers, offers = Activities.offers()
        if okOffers then
            for _, offer in ipairs(offers) do
                if offer.id == FIRST and offer.position then fallback = offer.position end
            end
        end
        local model, err = D.reachNpc(nil, MERYL, fallback)
        if not model then
            if err == "died" then return "Waiting to respawn", true end
            D.failed(key, "Meryl not ready")
            return "Can't reach Meryl", true
        end
        local prompt = D.waitFor(function() return D.promptUnder(model, nil, { serverDialogue = true }) end, PROMPT_WAIT)
        if prompt then
            Q.say("Talking to Meryl")
            local ok = Activities.storyDialogue(prompt)
            if ok and D.waitFor(function() return D.isActive(FIRST) end, START_WAIT) then
                D.succeeded(key)
                return "Story started", true
            end
        end
        if not D.alive() then return "Waiting to respawn", true end
        D.failed(key, "Meryl not ready")
        return "Meryl not ready", true
    end

    local function statusFor(ok, why, label)
        if ok then return "Step done", true end
        if why == "died" then return "Waiting to respawn", true end
        if why == "stopped" then return nil, true end
        if why == "no_engine" then return "Fight engine missing", false end
        if why == "manual" then return "Story needs you", false end
        if why == "blocked" then return label or "Story step stuck", false end
        if label then return label, true end
        return "Retrying story step", true
    end

    -- (status, busy): busy means it acted this pass, otherwise status says why the story was skipped
    function S.step(list)
        if Player.value("Stats.TutorialFinished") ~= true then return nil, false end
        local okDone, done = Activities.completed()
        if not okDone then return nil, false end
        if done[FINAL] then return "Story complete", false end
        local q = pickStory(list)
        if not q then
            if not done[FIRST] then return startMeryl() end
            return "Waiting on story", false
        end
        local tag, _, need = D.nextObjective(q)
        -- P9_33: the map line is one cheap send, so it goes first; each elimination contract is a side activity (Quests.lua:1278-1282), and bounties also count when the side pass gets to them
        if q.id == SIDE_JOBS then
            if (tonumber((q.objectives or {}).Open_SideQuestMap) or 0) < 1 then
                return statusFor(D.drive(q, "Open_SideQuestMap", 1, { run = sideMap.run }))
            end
            if tag == "Complete Side Activity" then
                -- a running bounty is a side activity too, and the side quests pass drives it
                local okB, active = Activities.activeBounties()
                if okB and type(active) == "table" and active[1] then return "Bounty under way", false end
                local ok, why, label = D.drive(q, tag, need, { run = elimination.run, timeout = 20 })
                -- no npc contract right now is nothing done, so the side quests pass still gets its turn
                if not ok and (why == "no_target" or why == "player_target") then return label, false end
                return statusFor(ok, why, label)
            end
        end
        -- the level grind: elimination contracts (Bounty.lua:254-256), only when the menu allows it, and never over a running bounty
        if q.id == LEVEL_STEP then
            if not (Q.storyXp and Q.storyXp()) then return "Reach level 25 first", false end
            local okB, active = Activities.activeBounties()
            if okB and type(active) == "table" and active[1] then return "Bounty under way", false end
            return contracts.step()
        end
        if not tag then return "Waiting on story", false end
        if MANUAL[tag] then return MANUAL[tag], false end
        local key = Player.playerAttr("HowlerStoryCheckpointKey")
        if MANUAL_KEYS[key] then return MANUAL_KEYS[key], false end
        local ok, why, label = D.drive(q, tag, need, S.specFor(q, tag))
        return statusFor(ok, why, label)
    end

    return S
end

end)
