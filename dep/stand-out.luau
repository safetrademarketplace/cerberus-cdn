    local free = {}
    for _, slot in ipairs(M.ACCESSORY_SLOTS) do
        if not placed[slot] and not current[slot] then free[#free + 1] = slot end
    end
    local taken = {}
    for _, slot in ipairs(M.ACCESSORY_SLOTS) do
        if not placed[slot] and current[slot] then taken[#taken + 1] = slot end
    end
    table.sort(taken, function(a, b)
        local sa = M.loadoutScore({ Accessory1 = current[a] }, opts)
        local sb = M.loadoutScore({ Accessory1 = current[b] }, opts)
        if sa ~= sb then return sa < sb end
        return a < b
    end)
    for _, slot in ipairs(taken) do free[#free + 1] = slot end
    for i, a in ipairs(toPlace) do
        local slot = free[i]
        if slot then result[slot] = a end
    end
    return result
end

-- the whole decision: changes only when the planned loadout is strictly better than what you wear; each change is {slot, name, id}
function M.decide(owned, current, opts)
    current = current or {}
    local now = M.loadoutScore(current, opts)
    local best = M.best(owned, current, opts)
    local result = M.assign(best, current, opts)
    local after = M.loadoutScore(result, opts)
    local changes = {}
    if after > now + EPSILON then
        for _, slot in ipairs(M.SLOTS) do
            local want, have = result[slot], current[slot]
            if want and not (have and key(have) == key(want)) then
                changes[#changes + 1] = { slot = slot, name = want.name, id = want.id }
            end
        end
    end
    return { changes = changes, score = after, current = now, result = result }
end

return M

end)
__bundle_register("Features/Utilities/ArrowCrafting", function(require, _LOADED, __bundle_register, __bundle_modules)
-- arrow crafting: one click turns spare mysterious arrows into bizarre and lucky arrows at big chop's workbench; the craft is begun through the game's own crafting controller (its client closes any session it didn't request, Crafting.lua:805-806), then placed and finished through Activities, and the session is always closed
local Executor = require("Utility/Executor")
local Identity = require("Utility/Identity")
local Jobs     = require("Utility/Jobs")
local Log      = require("Utility/Log")
local Mount    = require("Utility/Mount")
local Status   = require("Utility/Status")
local UiWrite  = require("Utility/UiWrite")

local OWNER = "ArrowCrafting"
local SOURCE = "Mysterious Arrow"
-- Crafting.Recipes.lua:38-39 (Arrows.UpgradeCosts), used when the recipe module can't be read
local COSTS = { ["Bizarre Arrow"] = 9, ["Lucky Arrow"] = 3 }
local MODES = { "Bizarre and Lucky", "Bizarre", "Lucky" }
-- Crafting.lua:12
local MAX_QUANTITY = 20
-- live 2026-11-17: Game.Gardening.ProcessingStations.Crafting (StationId SpawnGarden_Crafting), its prompt GardenCraft
local STATION_AT = Vector3.new(-1777.39, 28.13, 851.94)
local CONTROLLER_SOURCE = "PlayerScripts%.Core%.Crafting$"
local WALK_RANGE = 200
local BESIDE = 5
local OPEN_WAIT = 6
local START_WAIT = 8
local STEP_WAIT = 4
local FINISH_WAIT = 8
-- Crafting.lua:248 refuses a drop under 0.15 s after the last action
local ACTION_GAP = 0.3

local M = {}

-- what to craft from have arrows, keeping keep: Bizarre first, then Lucky from what is left; each a list of { recipe, quantity }
function M.plan(have, keep, mode, costs)
    costs = costs or COSTS
    local spare = math.max(0, math.floor(tonumber(have) or 0) - math.max(0, math.floor(tonumber(keep) or 0)))
    local out = {}
    local function take(recipe)
        local cost = costs[recipe]
        if not cost or cost < 1 then return end
        local n = math.min(MAX_QUANTITY, math.floor(spare / cost))
        if n > 0 then
            out[#out + 1] = { recipe = recipe, quantity = n }
            spare = spare - n * cost
        end
    end
    if mode ~= "Lucky" then take("Bizarre Arrow") end
    if mode ~= "Bizarre" then take("Lucky Arrow") end
    return out
end

-- Crafting.lua:8-10, where the client drops ingredient index of count
function M.slot(index, count)
    return Vector3.new(0.1, 3.13, (index - (count + 1) / 2) * math.min(1.65, 6 / math.max(1, count - 1)))
end

function M.describe(done)
    local parts = {}
    for _, step in ipairs(done) do
        parts[#parts + 1] = ("%d %s%s"):format(step.quantity, step.recipe, step.quantity == 1 and "" or "s")
    end
    return table.concat(parts, " and ")
end

function M.mount(ctx)
    local O = Mount.orchestrator(ctx, OWNER)
    if not O then return end
    local Api = ctx.Api or {}
    local World, Player, Activities, Net = Api.World, Api.Player, Api.Activities, Api.Net
    if not (World and Player and Activities and Activities.crafting and Activities.craftAction) then
        Log.devwarn("ArrowCrafting", "world, player or activities api missing; arrow crafting won't load")
        return
    end
    local Options, Library = ctx.Options, ctx.Library
    local References = ctx.References
    local Workspace = ctx.Services.Workspace

    local running, job, token = false, nil, nil
    local controller = nil

    local function notify(text) UiWrite.notify(Library, text, 6) end
    local function say(text) Status.set(OWNER, text, Status.ACTING) end

    local function sleep(seconds)
        if job then return job:sleep(seconds) end
        task.wait(seconds)
        return true
    end

    local function waitFor(check, timeout)
        local waited = 0
        while waited < timeout do
            local value = check()
            if value then return value end
            if not sleep(0.1) then return nil end
            waited = waited + 0.1
        end
        return check()
    end

    local function count(name)
        local ok, n = Player.count(name)
        return ok and n or 0
    end

    -- Crafting.Recipes.lua:38-39 through the game's own module
    local function costs()
        local out = {}
        for recipe, fallback in pairs(COSTS) do out[recipe] = fallback end
        if not Net then return out end
        local ok, mod = Net.module("Modules.Crafting.Recipes")
        local list = ok and type(mod) == "table" and mod.crafting
        if type(list) ~= "table" then return out end
        for recipe in pairs(COSTS) do
            local def = list[recipe]
            local first = type(def) == "table" and type(def.Ingredients) == "table" and def.Ingredients[1]
            if type(first) == "table" and first.Name == SOURCE and tonumber(first.Amount) then out[recipe] = tonumber(first.Amount) end
        end
        return out
    end

    local function slot(index, n)
        if Net then
            local ok, mod = Net.module("Crafting")
            if ok and type(mod) == "table" and type(mod.Slot) == "function" then
                local okS, v = pcall(mod.Slot, index, n)
                if okS and typeof(v) == "Vector3" then return v end
            end
        end
        return M.slot(index, n)
    end

    -- the game's crafting controller (PlayerScripts.Core.Crafting), the first upvalue of its own event handlers
    local function findController()
        if controller then return controller end
        local getgc = Executor.get("getgc")
        local dbg = debug
        if not (getgc and dbg.getupvalue and dbg.info) then return nil end
        for _, f in ipairs(getgc(false)) do
            if type(f) == "function" then
                local okS, src = pcall(dbg.info, f, "s")
                if okS and type(src) == "string" and string.find(src, CONTROLLER_SOURCE) then
                    local okU, v = pcall(dbg.getupvalue, f, 1)
                    if okU and type(v) == "table" and type(v.Request) == "function" and type(v.Close) == "function"
                        and type(v.CloseBrowser) == "function" then
                        controller = v
                        return v
                    end
                end
            end
        end
        return nil
    end

    local function station()
        local folder = Workspace:FindFirstChild("Game")
        folder = folder and folder:FindFirstChild("Gardening")
        folder = folder and folder:FindFirstChild("ProcessingStations")
        if not folder then return nil end
        for _, model in ipairs(folder:GetChildren()) do
            if model:GetAttribute("ProcessingKind") == "Crafting" then
                local prompt = model:FindFirstChild("GardenCraft", true)
                if prompt and prompt:IsA("ProximityPrompt") then return model, prompt end
            end
        end
        return nil
    end

    -- floor beside the bench, not on it: the client ends a session once you're 12 studs off it (Crafting.lua:1199)
    local function besideSpot(model)
        local center = model:GetPivot().Position
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local list = { model }
        if References.character then list[#list + 1] = References.character end
        params.FilterDescendantsInstances = list
        for _, offset in ipairs({ Vector3.new(0, 0, BESIDE), Vector3.new(0, 0, -BESIDE), Vector3.new(BESIDE, 0, 0), Vector3.new(-BESIDE, 0, 0) }) do
            local from = center + offset + Vector3.new(0, 6, 0)
            local hit = Workspace:Raycast(from, Vector3.new(0, -16, 0), params)
            if hit and hit.Position.Y <= center.Y + 1 and hit.Position.Y >= center.Y - 8 then return hit.Position, center end
        end
        return center + Vector3.new(0, 0, BESIDE), center
    end

    local function travel(goal, face)
        local root = References.humanoidRootPart
        if root and root.Parent and (root.Position - goal).Magnitude <= WALK_RANGE then
            if World.walkTo(goal, { token = token, sprint = true, tolerance = 2 }) then return true end
        end
        return World.travelTo(goal, { token = token, face = face })
    end

    local function crafting()
        local ok, state = Activities.crafting()
        return ok and state or {}
    end

    local function ownsBrowser()
        local browser = crafting().browser
        return browser ~= nil and References.player:GetAttribute("CraftingInputOwner") == browser.Token
    end

    -- the game's own close when its client holds the session (it also gives the camera back), else the plain Close through Activities
    local function closeAll(c)
        if c and c.Session then
            Identity.asGame(c.Close, c, true)
        elseif crafting().session then
            Activities.craftClose()
        end
        if c and c.Browser then
            Identity.asGame(c.CloseBrowser, c, true)
        elseif crafting().browser then
            Activities.craftClose()
        end
    end

    -- the bench's prompt makes the server push OpenStation, and the game's client opens its recipe browser
    local function openStation()
        local model, prompt = station()
        if not model then
            say("Going to the workbench")
            travel(STATION_AT + Vector3.new(0, 0, BESIDE))
            model, prompt = station()
            if not model then return false, "Couldn't find the workbench." end
        end
        if model:GetAttribute("InUse") == true then return false, "Someone is using the workbench." end
        local spot, center = besideSpot(model)
        local root = References.humanoidRootPart
        if not (root and root.Parent) then return false, "Couldn't reach the workbench." end
        if (root.Position - spot).Magnitude > 6 then
            say("Going to the workbench")
            if not travel(spot, center) then return false, "Couldn't reach the workbench." end
        end
        say("Opening the workbench")
        if ownsBrowser() then return true end
        World.firePrompt(prompt)
        if not waitFor(ownsBrowser, OPEN_WAIT) then return false, "The workbench didn't open." end
        return true
    end

    -- one recipe, begun by the game's own Request, every ingredient placed on its slot, then crafted
    local function craftOne(c, recipe, quantity)
        local opened, why = openStation()
        if not opened then return false, why end
        say("Crafting " .. recipe)
        local okCall, sent = Identity.asGame(c.Request, c, recipe, quantity)
        if not (okCall and sent) then return false, "The workbench wasn't ready." end
        local session = waitFor(function()
            local s = crafting().session
            return s and s.Recipe == recipe and s
        end, START_WAIT)
        if not session then return false, "Crafting didn't start." end
        local ingredients = type(session.Ingredients) == "table" and session.Ingredients or {}
        for index = 1, #ingredients do
            local placed = type(session.Placed) == "table" and session.Placed[index]
            if not placed then
                if not sleep(ACTION_GAP) then return false end
                Activities.craftAction("Place", { Index = index, Position = slot(index, #ingredients) })
                local ok = waitFor(function()
                    local s = crafting().session
                    return not s or (type(s.Placed) == "table" and s.Placed[index]) or nil
                end, STEP_WAIT)
                session = crafting().session
                if not (ok and session) then return false, "Crafting stopped." end
            end
        end
        if not waitFor(function()
            local s = crafting().session
            return s and s.Phase == "Ready"
        end, STEP_WAIT) then
            return false, "Crafting stopped."
        end
        if not sleep(ACTION_GAP) then return false end
        local before = count(recipe)
        Activities.craftAction("Craft")
        local finished = waitFor(function()
            local s = crafting().session
            return (s and s.Phase == "Success") or count(recipe) > before
        end, FINISH_WAIT)
        if not finished then return false, "Crafting didn't finish." end
        return true
    end

    local function run(j)
        job = j
        local mode = Options.ArrowCrafting_Mode and Options.ArrowCrafting_Mode.Value or MODES[1]
        local keep = Options.ArrowCrafting_Keep and Options.ArrowCrafting_Keep.Value or 0
        local plan = M.plan(count(SOURCE), keep, mode, costs())
        if #plan == 0 then
            notify("Not enough Mysterious Arrows.")
            return
        end
        local c = findController()
        if not c then
            notify("Couldn't reach the game's workbench.")
            return
        end
        local okClaim, claimed, holder = World.claim(OWNER)
        if not okClaim then
            notify((holder and tostring(holder) or "Another farm") .. " is moving you. Try again later.")
            return
        end
        token = claimed
        local done = {}
        local failure
        for _, step in ipairs(plan) do
            if not j.alive then break end
            local ok, why = craftOne(c, step.recipe, step.quantity)
            closeAll(c)
            if not ok then
                failure = why
                break
            end
            done[#done + 1] = step
            sleep(1)
        end
        World.release(token)
        token = nil
        Status.clear(OWNER)
        if #done > 0 then notify("Crafted " .. M.describe(done) .. ".") end
        if failure then notify(failure) end
    end

    local function start()
        if running then return end
        running = true
        O.track(Jobs.spawn(function(j)
            local ok, err = pcall(run, j)
            if not ok then
                Log.devwarn("ArrowCrafting", "craft failed: %s", tostring(err))
                if token then World.release(token) end
                token = nil
                Status.clear(OWNER)
                notify("Crafting failed.")
            end
            running = false
            job = nil
        end, { name = "ArrowCrafting" }))
    end

    local box = ctx.Tabs.Gathering:AddRightGroupbox("Arrow Crafting", "hammer")
    box:AddDropdown("ArrowCrafting_Mode", { Text = "Make", Values = MODES, Default = MODES[1] })
    box:AddSlider("ArrowCrafting_Keep", { Text = "Keep Mysterious Arrows", Default = 0, Min = 0, Max = 30, Rounding = 0 })
    box:AddButton({ Text = "Craft Arrows", Func = start })

    O.onUnload(function()
        if job then job:Cancel() end
        if crafting().session or crafting().browser then pcall(closeAll, controller) end
        if token then World.release(token) end
        token = nil
        Status.clear(OWNER)
    end)
    O.finalize()
end

return M

end)
