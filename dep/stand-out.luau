            base.warn("GetCurrentBounties failed: %s", tostring(list))
            return nil, Errors.NO_MODULE
        end
        return list
    end

    local function bountyBoard(tier)
        local B, err = need()
        if not B then return false, err end
        local list, boardErr = board(B, tier)
        if not list then return false, boardErr end
        local activeIds = decodedList("Stats.ActiveBounties")
        local out = {}
        for i, entry in ipairs(list) do
            out[i] = {
                id = entry.Id, name = entry.Name, tier = entry.Tier, minLevel = entry.MinLevel,
                completed = B.HasCompleted(References.player, entry.Id) == true,
                active = contains(activeIds, entry.Id),
                definition = entry,
            }
        end
