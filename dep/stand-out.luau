__bundle_register("Features/Auto/ServerIntel/Intel", function(require, _LOADED, __bundle_register, __bundle_modules)
-- server intel: one watcher over the game's world event pushes and the dropped-item folder that keeps what rare things are live on this server and tells each listener once per new spawn; drops spawned before you joined are invisible by design (WorldItemVisibility.lua:15-24), so only post-join drops are ever seen
local Log       = require("Utility/Log")
local Sightings = require("Features/Auto/ServerIntel/Sightings")

local M = {}

function M.new(O, Api)
    local Activities, World = Api.Activities, Api.World
    local self = { live = {}, drops = setmetatable({}, { __mode = "k" }) }
    local listeners = {}

    -- a listener's own error never stops the others
    local function emit(record)
        for _, fn in ipairs(listeners) do
            local ok, err = pcall(fn, record)
            if not ok then Log.devwarn("ServerIntel", "listener failed: %s", tostring(err)) end
        end
    end

    function self.onSighting(fn)
        listeners[#listeners + 1] = fn
    end

    local function seeEvent(ev)
        if type(ev) ~= "table" or type(ev.EventId) ~= "string" then return end
        local key = "event:" .. ev.EventId
        if ev.Phase == "Cleanup" then
            self.live[key] = nil
            return
        end
        local record = Sightings.fromEvent(ev)
        if not record then return end
        local fresh = self.live[key] == nil
        record.event = ev
        self.live[key] = record
        if fresh then emit(record) end
    end

    local function seeItem(model)
        if self.drops[model] or not model.Parent then return end
        local record = Sightings.fromItem(model:GetAttribute("ItemName"), model:GetAttribute("SpawnNode"), model:GetAttribute("WorldItemSpawnedAt"))
        if not record then return end
        record.model = model
        self.drops[model] = record
        self.live[record.key] = record
        O.track(model.AncestryChanged:Connect(function(_, parent)
            if parent == nil and self.live[record.key] == record then self.live[record.key] = nil end
        end))
        emit(record)
    end

    -- ItemName lands a moment after the model replicates, the way the game's own visibility pass waits for it (WorldItemVisibility.lua:27-37)
    local function considerItem(model)
        if model:GetAttribute("ItemName") ~= nil then
            seeItem(model)
            return
        end
        local conn
        conn = O.track(model:GetAttributeChangedSignal("ItemName"):Connect(function()
            if conn then conn:Disconnect() end
            seeItem(model)
        end))
    end

    function self.start()
        if Activities and Activities.worldEvent then
            O.track(Activities.worldEvent:Connect(seeEvent))
            local ok, list = Activities.worldEvents()
            if ok then
                for _, ev in ipairs(list) do seeEvent(ev) end
            end
        end
        if World and World.itemAdded then
            O.track(World.itemAdded:Connect(considerItem))
            local ok, list = World.items()
            if ok then
                for _, entry in ipairs(list) do
                    if not entry.putAway then considerItem(entry.model) end
                end
            end
        end
    end

    -- live records of a pick ("Meteors", "Lucky Arrows", …)
    function self.livePick(pick)
        for _, record in pairs(self.live) do
            if record.pick == pick and (not record.model or record.model.Parent) then return record end
        end
        return nil
    end

    -- the best rare arrow lying on this server right now, or nil
    function self.rareDrop()
        local best = nil
        for _, record in pairs(self.live) do
            if record.model and record.model.Parent and (record.rank or 0) >= 2 and (not best or record.rank > best.rank) then best = record end
        end
        return best
    end

    return self
end

return M

end)
__bundle_register("Features/Auto/ServerIntel/Hop", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto server hop: leaves a server whose events stopped, that is about to close, that sits empty, or (hunting) that has no meteor, through the game's own ServerDirectory join (never TeleportService); waits for a safe moment, keeps per-hour limits in a note that survives the reload, and resumes your farms from a temp config only when that fresh note says so
local Services    = require("Services")
local FarmConfig  = require("Utility/FarmConfig")
local Globals     = require("Utility/Globals")
local Jobs        = require("Utility/Jobs")
local Log         = require("Utility/Log")
local Status      = require("Utility/Status")
local Store       = require("Utility/Store")
local UiWrite     = require("Utility/UiWrite")
local AuthGate    = require("Auth/Gate")
local WorldEvents = require("Features/Auto/WorldEvents")
local HopPlan     = require("Features/Auto/ServerIntel/HopPlan")

local OWNER = "AutoServerHop"
local NOTE_KEY = "server_hop"
local RESUME_CONFIG = "__hop_resume"
local TICK = 15
-- the directory is asked at most this often while nothing is wrong
local LIST_EVERY = 60
local BOOT_WAIT = 60
-- a join the server accepted but that never teleported us counts as failed after this
local LANDING_WAIT = 60

local M = {}

function M.mount(ctx, O, intel)
    local Api = ctx.Api or {}
    local World, Player, Combat = Api.World, Api.Player, Api.Combat
    if not (World and World.servers and World.hop and World.currentServer) then
        Log.devwarn("ServerHop", "world servers api missing; server hop won't load")
        return
    end
    local Options, Toggles, Library, SaveManager = ctx.Options, ctx.Toggles, ctx.Library, ctx.SaveManager
    local jobId = game.JobId
    local now = os.time

    local note = Store.read(Store.GAME, NOTE_KEY, {})
    if type(note) ~= "table" then note = {} end
    local arrivedAt = now()
    local lastList = -math.huge
    local emptySince = nil
    local unsafeSince = nil
    local hopping = false
    local job = nil

    local function toggleOn(id)
        local element = Toggles[id]
        return element ~= nil and element.Value == true
    end

    local function option(id, default)
        local element = Options[id]
        local value = element and element.Value
        if value == nil then return default end
        return value
    end

    local function saveNote() Store.write(Store.GAME, NOTE_KEY, note) end

    local function say(text, level) Status.set(OWNER, text, level or Status.IDLE) end

    local Players = Services.Players
    local hopStarted, hopTarget, hopToken = nil, nil, nil

    local function othersHere()
        local n = 0
        for _, p in ipairs(Players:GetPlayers()) do
            if p.UserId ~= (Players.LocalPlayer and Players.LocalPlayer.UserId) then n = n + 1 end
        end
        return n
    end

    -- this server's age from its own directory row; nil until a listing came back
    local function serverAge()
        local row = World.currentServer()
        if row and type(row.startedAt) == "number" then return now() - row.startedAt end
        return nil
    end

    local function refresh(force)
        if not force and now() - lastList < LIST_EVERY then return true end
        local ok, err = World.servers()
        if ok then lastList = now() end
        return ok, err
    end

    local function situation()
        local others = othersHere()
        if others > 0 then emptySince = nil elseif not emptySince then emptySince = now() end
        return {
            stopped = Services.Workspace:GetAttribute("ServerWorldEventsStopped") == true,
            cutoff = tonumber(Services.Workspace:GetAttribute("ServerWorldEventCutoffAgeSeconds")),
            shutdown = tonumber(Services.Workspace:GetAttribute("ServerShutdownAgeSeconds")),
            age = serverAge(),
            others = others,
            emptySince = emptySince,
            now = now(),
            arrivedAt = arrivedAt,
            meteorLive = intel.livePick("Meteors") ~= nil,
            rareHere = intel.rareDrop() ~= nil,
        }
    end

    local function gate()
        local _, owner = World.owner()
        local state = Combat and Combat.state and Combat.state() or {}
        local hum = ctx.References.humanoid
        return {
            owner = owner,
            eventLive = WorldEvents.wants(),
            busy = Player and Player.isBusy and Player.isBusy() or false,
            combat = state.combatTagged == true,
            rareHere = intel.rareDrop() ~= nil or intel.livePick("Meteors") ~= nil,
            dead = not (hum and hum.Parent and hum.Health > 0),
        }
    end

    -- dev only: nothing re-runs the script after a teleport unless luarmor's queue does (TeleportQueue.lua), so a dev hop queues the local bundle once per session
    local function queueDevReload()
        if toggleOn("ServerHop_DevReload") then FarmConfig.queueDevReload() end
    end

    local function saveResume()
        if not (SaveManager and toggleOn("ServerHop_Resume")) then return false end
        local ok, err = pcall(SaveManager.Save, SaveManager, RESUME_CONFIG)
        if not ok or err == false then
            Log.devwarn("ServerHop", "resume config not saved: %s", tostring(err))
            return false
        end
        return true
    end

    -- one hop: pick, note, then the game's own join; a refused or timed-out join backs off and remembers that row
    local function hopNow(reason)
        if hopping then return false end
        hopping = true
        local ok, err = refresh(true)
        if not ok then
            hopping = false
            say("Server list unavailable")
            return false, err
        end
        local _, list = World.servers()
        local rows = type(list) == "table" and list.servers or {}
        local target = HopPlan.pick(rows, {
            maxAge = (tonumber(option("ServerHop_MaxAge", 8)) or 8) * 3600,
            minPlayers = tonumber(option("ServerHop_MinPlayers", 3)) or 3,
            prefer = option("ServerHop_Prefer", "Youngest"),
        }, now(), note, function(n) return math.random(1, n) end)
        if not target then
            hopping = false
            say("No server fits")
            return false
        end
        -- movement is held only for the instant of the join, so no farm starts a trip mid-hop
        local claimed, token = World.claim(OWNER)
        if not claimed then
            hopping = false
            say("Movement is busy")
            return false
        end
        -- the next server boots the farms straight from autoload, even with resume off or no note to read
        FarmConfig.ensure(SaveManager)
        local resume = saveResume()
        note = HopPlan.departing(note, now(), jobId, target.jobId, reason, resume)
        saveNote()
        queueDevReload()
        say("Hopping: " .. reason, Status.ACTING)
        Log.dev("ServerHop", "hop %s -> %s (%s)", jobId, tostring(target.jobId), reason)
        local joined, code, text = World.hop(target.jobId)
        if joined then
            -- the teleport takes over from here; keep the claim so nothing moves while it lands
            hopStarted, hopTarget, hopToken = now(), target.jobId, token
            return true
        end
        World.release(token)
        note = HopPlan.failedHop(note, now(), target.jobId)
        saveNote()
        hopping = false
        Log.devwarn("ServerHop", "hop refused: %s %s", tostring(code), tostring(text))
        if (note.failures or 0) >= HopPlan.MAX_FAILURES then
            UiWrite.notify(Library, "Server hop failed 3 times.", 8)
        end
        say("Hop failed, retrying")
        return false, code
    end

    local function pass()
        if hopping then
            if hopStarted and now() - hopStarted >= LANDING_WAIT then
                World.release(hopToken)
                note = HopPlan.failedHop(note, now(), hopTarget)
                saveNote()
                hopping, hopStarted, hopTarget, hopToken = false, nil, nil, nil
                say("Hop didn't land")
            end
            return
        end
        refresh(false)
        local reason = HopPlan.reason(situation(), option("ServerHop_When", {}))
        if not reason then
            unsafeSince = nil
            Status.clear(OWNER)
            return
        end
        local allowed, why, wait = HopPlan.allowed(note, now(), tonumber(option("ServerHop_PerHour", 4)) or 4)
        if not allowed then
            say(wait and ("%s (%ds)"):format(why, math.ceil(wait)) or why, wait and Status.WAITING or Status.IDLE)
            return
        end
        local safe, waitingOn = HopPlan.safe(gate())
        if not safe then
            unsafeSince = unsafeSince or now()
            local overdue = HopPlan.urgent(reason) and now() - unsafeSince >= HopPlan.SAFE_WAIT
            if not overdue then
                say(waitingOn)
                return
            end
        end
        unsafeSince = nil
        hopNow(reason)
    end

    local function start()
        if job then return end
        job = O.track(Jobs.interval(TICK, function() pcall(pass) end, { name = "ServerHop", immediate = true }))
    end

    local function stop()
        if job then job:Cancel() end
        job = nil
        unsafeSince = nil
        Status.clear(OWNER)
    end

    -- boot side: a fresh note that points at this server is our own landing
    local landed, resume = HopPlan.arrival(note, jobId, now())
    if landed then
        note.failures, note.lastFail = 0, nil
        note.visited = note.visited or {}
        note.visited[jobId] = now()
        note.resumed = true
        saveNote()
        Log.dev("ServerHop", "landed from %s (%s)", tostring(note.from), tostring(note.reason))
    end
    if resume and SaveManager then
        -- after the boot's own autoload, so the resume config wins over it and every feature's elements exist
        O.track(Jobs.spawn(function(j)
            local waited = 0
            while not Globals.get("__rbx_runtime_active") and waited < BOOT_WAIT do
                if not j:sleep(1) then return end
                waited = waited + 1
            end
            local ok, err = pcall(SaveManager.Load, SaveManager, RESUME_CONFIG)
            if not ok then Log.devwarn("ServerHop", "resume load failed: %s", tostring(err)) end
            pcall(SaveManager.Delete, SaveManager, RESUME_CONFIG)
            UiWrite.notify(Library, "Hopped servers. Farms resumed.", 6)
        end, { name = "ServerHop resume" }))
    end

    local box = ctx.Tabs.Server:AddLeftGroupbox("Server Hop", "shuffle")
    box:AddToggle("ServerHop_Enabled", {
        Text     = "Auto Server Hop",
        Default  = false,
        Callback = function(on)
            if on then start() else
                stop()
                -- live 2026-11-18 (user): switched off by hand, the hop farm stops coming back after a rejoin
                if FarmConfig.byHand(Library) and FarmConfig.release(SaveManager) then
                    UiWrite.notify(Library, "Autoload cleared", 4)
                end
            end
        end,
    })
    box:AddDropdown("ServerHop_When", {
        Text    = "Hop When",
        Values  = HopPlan.REASONS,
        Default = HopPlan.DEFAULT_REASONS,
        Multi   = true,
    })
    box:AddDropdown("ServerHop_Prefer", { Text = "Prefer", Values = HopPlan.PREFER, Default = "Youngest" })
    box:AddSlider("ServerHop_MaxAge", { Text = "Max Server Age (h)", Default = 8, Min = 1, Max = 9, Rounding = 0 })
    box:AddSlider("ServerHop_MinPlayers", { Text = "Min Players", Default = 3, Min = 0, Max = 16, Rounding = 0 })
    box:AddSlider("ServerHop_PerHour", { Text = "Hops Per Hour", Default = 4, Min = 1, Max = 20, Rounding = 0 })
    box:AddToggle("ServerHop_Resume", {
        Text    = "Resume Farms",
        Default = true,
        Tooltip = "Turns your farms back on after a hop",
    })
    if not AuthGate.isLuarmor() then
        box:AddToggle("ServerHop_DevReload", { Text = "Reload After Hop (dev)", Default = true })
    end
    box:AddButton({
        Text = "Hop Now",
        Func = function()
            O.track(Jobs.spawn(function()
                local ok = hopNow("Hop Now")
                if not ok then UiWrite.notify(Library, "Couldn't hop right now.", 5) end
            end, { name = "ServerHop now" }))
        end,
    })

    O.onUnload(stop)
end

return M

end)
__bundle_register("Features/Auto/ServerIntel/HopPlan", function(require, _LOADED, __bundle_register, __bundle_modules)
-- hop plan: pure server-hop rules (when to leave, whether now is safe, which server to take, the per-hour limits and the hop note read back after the reload); no instances, so it is tested offline
local M = {}

M.REASONS = { "Events stopped", "Server closing", "Server empty", "No meteor here" }
M.DEFAULT_REASONS = { "Events stopped", "Server closing" }
M.PREFER = { "Youngest", "Most players", "Fewest players" }

-- server attributes read live 2026-11-17: ServerWorldEventCutoffAgeSeconds 34200, ServerShutdownAgeSeconds 36000
M.CUTOFF_SLACK = 300
M.CLOSING_SLACK = 600
M.EMPTY_FOR = 300
-- a fresh server needs a moment for the WorldEvents Snapshot before "no meteor" means anything
M.HUNT_SETTLE = 45
M.MIN_GAP = 90
M.VISITED_FOR = 1800
M.NOTE_FRESH = 300
M.MAX_FAILURES = 3
M.BACKOFF = { 30, 60, 120, 300 }
M.SAFE_WAIT = 300
-- a row can fill between the list and the join
M.SEAT_SPARE = 2
M.STALE_ROW = 60

-- the first reason to leave this server, or nil; s = { stopped, age, cutoff, shutdown, others, emptySince, now, arrivedAt, meteorLive, rareHere }
function M.reason(s, picks)
    picks = picks or {}
    local age = s.age
    if picks["Server closing"] and age and s.shutdown and age >= s.shutdown - M.CLOSING_SLACK then return "Server closing" end
    if picks["Events stopped"] and (s.stopped == true or (age and s.cutoff and age >= s.cutoff - M.CUTOFF_SLACK)) then return "Events stopped" end
    if picks["Server empty"] and s.others == 0 and s.emptySince and s.now - s.emptySince >= M.EMPTY_FOR then return "Server empty" end
    if picks["No meteor here"] and not s.meteorLive and not s.rareHere and s.arrivedAt and s.now - s.arrivedAt >= M.HUNT_SETTLE then
        return "No meteor here"
    end
    return nil
end

-- closing is the one reason that may cut through a busy moment, and only after waiting SAFE_WAIT
function M.urgent(reason)
    return reason == "Server closing"
end

-- g = { owner, eventLive, busy, combat, rareHere, dead }; true or (false, why)
function M.safe(g)
    if g.rareHere then return false, "Rare spawn here" end
    if g.owner then return false, "Waiting for " .. tostring(g.owner) end
    if g.eventLive then return false, "Waiting for the event" end
    if g.combat then return false, "Waiting out combat" end
    if g.busy then return false, "Waiting for a scene" end
    if g.dead then return false, "Waiting to respawn" end
    return true
end

-- note = { hops = {times}, failures, lastFail, visited = {jobId = time}, failed = {jobId = time} }; true or (false, why, waitSeconds)
function M.allowed(note, now, perHour)
    local hops = 0
    local last = nil
    for _, at in ipairs(note.hops or {}) do
        if now - at < 3600 then
            hops = hops + 1
            if not last or at > last then last = at end
        end
    end
    if hops >= perHour then return false, "Hop limit this hour" end
    if last and now - last < M.MIN_GAP then return false, "Hop cooldown", M.MIN_GAP - (now - last) end
    local failures = tonumber(note.failures) or 0
    if failures >= M.MAX_FAILURES then
        if note.lastFail and now - note.lastFail < 3600 then return false, "Hops keep failing" end
    elseif failures > 0 and note.lastFail then
        local wait = M.BACKOFF[math.min(failures, #M.BACKOFF)]
        if now - note.lastFail < wait then return false, "Retrying soon", wait - (now - note.lastFail) end
    end
    return true
end

