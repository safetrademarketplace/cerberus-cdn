            jobId     = raw.JobId,
            name      = raw.Name,
            region    = raw.Region,
            type      = raw.Type,
            players   = players,
            capacity  = capacity,
            current   = raw.Current == true,
            startedAt = raw.StartedAt,
            -- unix seconds the directory last heard from that server (live 2026-11-17: 1-10 s old)
            updatedAt = tonumber(raw.UpdatedAt),
            war       = type(raw.War) == "table" and raw.War or nil,
            joinable  = raw.Current ~= true and raw.Type == "Normal" and players ~= nil and capacity ~= nil and players < capacity,
