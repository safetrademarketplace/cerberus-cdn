    local lastKey = nil
    local boardAt = -math.huge

    local function post(text, level) Status.set(OWNER, text, level) end
    local function say(text) post(text, Status.ACTING) end
    local function waitLine(text) post(text, Status.WAITING) end

    local function toggleOn(id, default)
        local element = Toggles[id]
        if element == nil then return default end
        return element.Value == true
    end

    local function option(id, default)
        local element = Options[id]
        if element == nil or element.Value == nil then return default end
        return element.Value
    end

    local function pickedRaids() return Plan.pickedKeys(option("AutoRaid_Raid", { [Plan.CHOICES[1]] = true })) end

    local engine, engineTried = nil, false
    local function getEngine()
        if engine or engineTried then return engine end
        engineTried = true
        local ok, built = pcall(Engage.new, ctx)
        if ok and built then engine = built else Log.devwarn("AutoRaid", "combat engine failed to build: %s", tostring(built)) end
        return engine
    end

    -- the claim is never taken from another owner
    local function ensureClaim()
        if token then
            local ok, owner = World.owner()
            if ok and owner == OWNER then return true end
            token = nil
        end
        local ok, got = World.claim(OWNER)
        if not ok then return false end
        token = got
        return true
    end

    local function releaseClaim()
        if token then World.release(token) end
        token = nil
    end

    local function alive()
        local hum = References.humanoid
        if not (hum and hum.Parent and hum.Health > 0) then return false end
        if Combat and Combat.alive then return Combat.alive() == true end
        return true
    end

    local function state()
        local ok, st = Activities.raidState()
        return ok and st or nil
    end

    local runner = Run.new({
        Activities = Activities, World = World, Combat = Combat, References = References, Services = ctx.Services,
        getEngine = getEngine, token = function() return token end, option = option, alive = alive,
        say = say, wait = waitLine,
    })

    local function myPosition()
        local root = References.humanoidRootPart
        return root and root.Parent and root.Position or nil
    end

    local function donatello()
        local gameRoot = ctx.Services.Workspace:FindFirstChild("Game")
        local npcs = gameRoot and gameRoot:FindFirstChild("NPCs")
        local npc = npcs and npcs:FindFirstChild("Donatello")
        local root = npc and npc:FindFirstChild("HumanoidRootPart")
        return root and root.Position or nil
    end

    -- lands a few studs in front of him, facing him; the talk prompt reaches 7 studs
    local function goToDonatello()
        local at = donatello()
        if not at then return false, "Can't find Donatello" end
        local from = myPosition()
        if from and (from - at).Magnitude <= NPC_RANGE then return true end
        say("Going to Donatello")
        local away = from and (from - at) or nil
        local dir = (away and away.Magnitude > 0.1) and away.Unit or Vector3.new(1, 0, 0)
        local spot = at + Vector3.new(dir.X, 0, dir.Z) * 4
        local ok, err = World.travelTo(spot, { token = token, face = at })
        if not ok then
            Log.dev("AutoRaid", "trip to donatello failed: %s", tostring(err))
            return false, "Couldn't reach Donatello"
        end
        return true
    end

    -- yields: asks for the raid's board and waits for a fresh push of it
    local function freshBoard(j, key)
        local asked = os.clock()
        local ok, err = Activities.openRaidBoard(key)
        if not ok then return nil, err end
        local waited = 0
        while waited < BOARD_WAIT do
            if boardAt >= asked then
                local _, board = Activities.raidBoard()
                if type(board) == "table" and board.Raid == key then return board end
            end
            if not j:sleep(IDLE_STEP) then return nil end
            waited = waited + IDLE_STEP
        end
        return nil
    end

    local function myUserId()
        local plr = References.player
        return plr and plr.UserId
    end

    -- a party led by someone else starts its raids from the leader's board (Player.party: Leader 0 is no party)
    local function partyLeaderElse()
        if not Player.party then return false end
        local ok, party = Player.party()
        return ok and type(party) == "table" and party.leader ~= nil and party.leader ~= myUserId()
    end

    -- yields until the start lands in a live raid, or it is called off
    local function waitStart(j)
        local waited = 0
        while waited < START_WAIT do
            if Plan.inRaid(state()) then return true end
            if not j:sleep(0.5) then return false end
            waited = waited + 0.5
        end
        return Plan.inRaid(state())
    end

    -- after the results: back out of the raid, then a short grace so the board reads the new cooldown
    local function waitHome(j)
        local waited = 0
        while waited < HOME_WAIT and Plan.inRaid(state()) do
            if not j:sleep(0.5) then return false end
            waited = waited + 0.5
        end
        return true
    end

    local function finishRun(j, cleared, line)
        local waited = 0
        while not runner.result() and waited < RESULTS_WAIT do
            if not j:sleep(0.5) then break end
            waited = waited + 0.5
        end
        local res = runner.result()
        if res then cleared = res.Cleared == true end
        runs = runs + 1
        if cleared then
            clears = clears + 1
            failStreak = 0
        else
            failStreak = failStreak + 1
            if failStreak >= FAIL_LIMIT then
                retryAt = os.clock() + math.min(FAIL_BACKOFF_MAX, FAIL_BACKOFF * 2 ^ (failStreak - FAIL_LIMIT))
            end
        end
        local key = res and res.Raid or lastKey or Plan.ORDER[1]
        local name = (Plan.RAIDS[key] or Plan.RAIDS.Train).label
        local loot = res and type(res.Loot) == "table" and #res.Loot or 0
        if res and ctx.Library then
            UiWrite.notify(ctx.Library, ("%s %s: %d item%s"):format(name, cleared and "cleared" or "failed", loot, loot == 1 and "" or "s"), 5)
        end
        waitHome(j)
        -- the board's cooldown is read fresh before this raid's next start; the cycle moves on to the next picked raid first
        readyAt[key] = 0
        return (cleared and "Cleared %d of %d" or "Raid failed, %d of %d cleared"):format(clears, runs), line
    end

    -- live 2026-11-18: a script loaded on the raid server after its State push held no state at all and sat idle in the tunnel; with none held it's asked for
    local askedAt = -math.huge
    local function askState()
        if state() ~= nil or os.clock() - askedAt < 10 then return end
        askedAt = os.clock()
        Activities.refreshRaid()
    end

    -- (line, level, keep the claim)
    local function pass(j)
        gated = false
        askState()
        local st = state()
        if Plan.inRaid(st) then
            inRaid = true
            -- the raid sends you home on a teleport too; dev queues the bundle for that trip as well
            FarmConfig.queueDevReload()
            setWanting(true)
            if not ensureClaim() then return "Waiting for movement", Status.IDLE, false end
            runner.reset()
            local cleared, line = runner.loop(j)
            if not j.alive then return nil, nil, false end
            local summary = finishRun(j, cleared, line)
            inRaid = false
            setWanting(false)
            return summary, Status.ACTING, false
        end
        inRaid = false
        setWanting(false)
        -- live 2026-11-18: twice a Train started with Highway Star picked; the autoload turns Auto Raid on before its deferred loads reach the raid picker,
        -- whose default is The Train, so no raid is chosen until the config has settled (SaveManager's quiet window)
        local lib = ctx.Library
        -- live 2026-11-18 (user): on every load the other farms set off on a trip during that window and the raid queued only after it; holding priority
        -- through the window keeps them waiting until the raid decides (the next pass clears it at the top)
        if type(lib) == "table" and lib.QuietUntil and os.clock() < lib.QuietUntil then
            setWanting(true)
            return "Loading your setup", Status.IDLE, false
        end
        if Plan.limitReached(runs, option("AutoRaid_Runs", 0)) then return "All raid runs done", Status.IDLE, false end
        local replay = toggleOn("AutoRaid_Replay", true)
        if not replay and runs >= 1 then return "Raid done, replay is off", Status.IDLE, false end
        if failStreak >= FAIL_LIMIT then
            if not replay then return ("Stopped after %d fails"):format(FAIL_LIMIT), Status.IDLE, false end
            local wait = retryAt - os.clock()
            if wait > 0 then return ("%d fails, retrying in %ds"):format(failStreak, math.ceil(wait)), Status.WAITING, false end
        end
        if WorldEvents.wants() then return "Paused for an event", Status.IDLE, false end
        -- the plan is asked only before a new raid, never mid-raid
        local may, why = Farms.mayAct(FARM)
        if not may then
            gated = true
            return why, Status.WAITING, false
        end
        if not Player.ready() then return "Waiting for your save", Status.IDLE, false end
        -- user 2026-11-19: of the picked raids you can enter, the next one after the last run that's off cooldown (each keeps its own wait)
        local open, firstLocked = {}, nil
        for _, k in ipairs(pickedRaids()) do
            local locked = Plan.locked(k, References.player and References.player:GetAttribute("HasTrainRaidAccess"), Player.value("Stats.Level"))
            if locked then firstLocked = firstLocked or locked else open[#open + 1] = k end
        end
        if #open == 0 then return firstLocked or "Pick a raid", Status.IDLE, false end
        local key, soonest, left = Plan.nextRaid(open, readyAt, os.clock(), lastKey)
        if not key then
            local name = #open > 1 and Plan.RAIDS[soonest].label .. " " or "Raid "
            return name .. "ready in " .. Plan.clock(left), Status.WAITING, false
        end
        if partyLeaderElse() then
            if toggleOn("AutoRaid_Party", true) then return "Waiting for your party leader", Status.IDLE, false end
            return "Your party leader starts raids", Status.IDLE, false
        end
        if not alive() then
            local waited = 0
            while waited < RESPAWN_WAIT and not (alive() and Player.spawnReady()) do
                if not j:sleep(0.5) then return nil, nil, false end
                waited = waited + 0.5
            end
            if not alive() then return "Waiting to respawn", Status.WAITING, false end
        end
        if Player.isBusy() then return "Waiting for a scene", Status.IDLE, false end
        -- a ready raid outranks the farms that can run any time (garden, quests, cases, mobs); only a world event outranks it
        setWanting(true)
        if not ensureClaim() then return "Waiting for movement", Status.IDLE, false end
        local reached, why = goToDonatello()
        if not reached then return why, Status.IDLE, false end
        local board = freshBoard(j, key)
        if not j.alive then return nil, nil, false end
        local pick = Plan.pickDifficulty(board, myUserId(), key, option("AutoRaid_Difficulty", "Regular"))
        if pick.wait then
            readyAt[key] = os.clock() + pick.wait + COOLDOWN_SLACK
            setWanting(false)
            return "Raid ready in " .. Plan.clock(pick.wait), Status.WAITING, false
        end
        if not pick.difficulty then
            readyAt[key] = os.clock() + START_RETRY
            return pick.line, Status.IDLE, false
        end
        if board.Active then return "Your party's raid is running", Status.IDLE, false end
        if board.Leader == false then return "Your party leader starts raids", Status.IDLE, false end
        if board.Pending then return "Waiting for your party", Status.WAITING, true end
        inRaid = true
        -- a raid can drop you back on a fresh server; autoload brings the farm back up there
        FarmConfig.ensure(ctx.SaveManager)
        FarmConfig.queueDevReload()
        say(("Starting %s (%s)"):format(Plan.RAIDS[key].label, pick.difficulty))
        local ok, err = Activities.startRaid(key, pick.difficulty)
        if not ok then
            inRaid = false
            readyAt[key] = os.clock() + START_RETRY
            Log.dev("AutoRaid", "start refused: %s", tostring(err))
            return "Raid didn't start", Status.IDLE, false
        end
        if waitStart(j) then
            lastKey = key
            return "Raid starting", Status.ACTING, true
        end
        inRaid = false
        readyAt[key] = os.clock() + START_RETRY
        return "Raid didn't start", Status.IDLE, false
    end

    local function idle(j)
        woken = false
        local waited, most = 0, FarmSettings.tick(IDLE_MAX)
        while waited < most do
            if not j:sleep(IDLE_STEP) then return false end
            if woken then return true end
            waited = waited + IDLE_STEP
        end
        return true
    end

    local function loop(j)
        while j.alive and enabled do
            local ok, line, level, keep = pcall(pass, j)
            if ok then
                if not gated then work = inRaid or keep == true or level == Status.ACTING end
                if line then post(line, level) end
                if not keep then releaseClaim() end
            else
                Log.devwarn("AutoRaid", "pass failed: %s", tostring(line))
                runner.stop()
                releaseClaim()
            end
            if not j.alive then return end
            if ok and keep and level == Status.ACTING then
                if not j:sleep(IDLE_STEP) then return end
            elseif not idle(j) then
                return
            end
        end
    end

    local function stop()
        enabled = false
        inRaid = false
        if keyJob then keyJob:Cancel() end
        keyJob = nil
        setWanting(false)
        if job then job:Cancel() end
        job = nil
        runner.stop()
        if engine then engine.destroy() end
        releaseClaim()
        runs, clears, failStreak, retryAt = 0, 0, 0, 0
        readyAt, lastKey = {}, nil
        gated, work = false, false
        Status.clear(OWNER)
    end

    -- the ready check answers itself only while auto raid runs and party raids are on (TrainRaidClient.lua:6237-6256, 1660-1670)
    O.track(Activities.raidMessage:Connect(function(verb, payload)
        if verb == "Board" then
            boardAt = os.clock()
            return
        end
        if not enabled then return end
        if verb == "Ready" and toggleOn("AutoRaid_Party", true) then
            local ok, err = Activities.raidReady(true)
            if not ok then Log.dev("AutoRaid", "ready refused: %s", tostring(err)) end
        elseif verb == "State" then
            woken = true
        end
        runner.onMessage(verb, payload)
    end))

    -- user 2026-11-19: a raid server with more players than the slider allows is left for the lobby (the main place); 0 is off
    local crowdHopAt = -math.huge
    O.track(Jobs.interval(CROWD_EVERY, function()
        if not enabled or not Plan.inRaid(state()) then return end
        local players = ctx.Services and ctx.Services.Players
        local count = players and #players:GetPlayers() or 0
        local limit = option("AutoRaid_MaxPlayers", 0)
        if not Plan.tooCrowded(count, limit) or os.clock() - crowdHopAt < CROWD_RETRY then return end
        crowdHopAt = os.clock()
        say(("%d players here, going back to the lobby"):format(count))
        if ctx.Library then UiWrite.notify(ctx.Library, ("Raid has %d players (max %d), leaving"):format(count, limit), 5) end
        FarmConfig.queueDevReload()
        local ok, err = pcall(function() ctx.Services.TeleportService:Teleport(ctx.Services.Game.PlaceId, References.player) end)
        if not ok then Log.devwarn("AutoRaid", "lobby hop failed: %s", tostring(err)) end
    end, { name = "AutoRaidCrowd" }))

    local box = ctx.Tabs.Fights:AddLeftGroupbox("Auto Raid", "train-front")
    box:AddToggle("AutoRaid_Enabled", {
        Text     = "Auto Raid",
        Premium  = true,
        Default  = false,
        Callback = function(on)
            if on then
                if enabled then return end
                enabled = true
                job = O.track(Jobs.spawn(loop, { name = "AutoRaid" }))
                -- user 2026-11-22: a key prompt in the tarkus fight went unanswered as we died; raids answer their own prompts
                keyJob = O.track(Jobs.spawn(function(j) Keys.loop(j, Activities, function() return enabled end) end, { name = "AutoRaid.keys" }))
            else
                stop()
                -- live 2026-11-18 (user): switched off by hand, the farm stops coming back after a rejoin
                if FarmConfig.byHand(ctx.Library) and FarmConfig.release(ctx.SaveManager) then
                    UiWrite.notify(ctx.Library, "Autoload cleared", 4)
                end
            end
        end,
    })
    Farms.register({
        name    = FARM,
        label   = "Raids",
        owner   = OWNER,
        enable  = function(on) UiWrite.value(Toggles.AutoRaid_Enabled, on) end,
        enabled = function() return enabled end,
        active  = M.active,
        wants   = function() return enabled and (inRaid or work) end,
    })
    box:AddDropdown("AutoRaid_Raid", { Premium = true, Text = "Raids", Values = Plan.CHOICES, Default = { Plan.CHOICES[1] }, Multi = true, Tooltip = "Picks several and takes turns as each comes off cooldown" })
    box:AddDropdown("AutoRaid_Difficulty", {
        Text    = "Difficulty",
        Premium = true,
        Values  = Plan.DIFFICULTIES,
        Default = "Regular",
        Tooltip = "Best Ready plays Hard when it's off cooldown",
    })
    box:AddToggle("AutoRaid_Replay", {
        Text    = "Auto Replay",
        Premium = true,
        Default = true,
        Tooltip = "Starts the next run when one ends",
    })
    box:AddSlider("AutoRaid_Runs", { Premium = true, Text = "Runs (0 = no limit)", Default = 0, Min = 0, Max = 50, Rounding = 0 })

    local settings = ctx.Tabs.Fights:AddLeftGroupbox("Raid Settings", "settings")
    settings:AddToggle("AutoRaid_Party", { Premium = true, Text = "Join Party Raids", Default = true })
    settings:AddDropdown("AutoRaid_Position", { Premium = true, Text = "Position", Values = Plan.POSITIONS, Default = "Combat Settings" })
    settings:AddSlider("AutoRaid_Distance", { Premium = true, Text = "Distance", Default = 3, Min = 1, Max = 10, Rounding = 1 })
    settings:AddSlider("AutoRaid_MaxPlayers", {
        Text     = "Max Players In Raid",
        Premium  = true,
        Default  = 0,
        Min      = 0,
        Max      = 20,
        Rounding = 0,
        Tooltip  = "More than this and you go back to the lobby (0 = off)",
    })

    O.onUnload(stop)
    O.onUnload(function() Farms.unregister(FARM) end)
    O.finalize()
end

return M

end)
__bundle_register("Features/Auto/Raid/Run", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto raid run: drives one raid from the inside, fighting the best-ranked enemy with the shared engine (adds before the boss), answering the train's suspect and purse pushes and highway star's latch, pressing the raid's own prompts when nothing is left to hit, and sitting out a spectate until the results land
local Executor = require("Utility/Executor")
local Identity = require("Utility/Identity")
local GameHud  = require("Utility/GameHud")
local Jobs     = require("Utility/Jobs")
local Log      = require("Utility/Log")
local Lockpick = require("Features/Auto/Lockpick")
local Highway  = require("Features/Auto/Raid/Highway")
local Hazards  = require("Features/Auto/Raid/Hazards")
local Plan     = require("Features/Auto/Raid/Plan")

local OWNER = "AutoRaid"
local TICK = 0.25
-- a lockpick turn is read and let go within a frame or two, before the pick strains
local LOCK_TICK = 0.05
local ENEMY_RADIUS = 220
local FAR_RADIUS = 700
local PROMPT_RADIUS = 60
local PROMPT_TRIES = 2
-- live 2026-11-18: a press that went nowhere (lock before the clip, purse out of reach) used up both tries for good and the car stalled; tries now lapse and are tried again
local PROMPT_RETRY = 20
local KEY_RETRY = 3
local PICKUP_RADIUS = 40
local ADVANCE_AFTER = 6
local ADVANCE_EVERY = 8
local FIGHT_TIMEOUT = 240
local RUN_TIMEOUT = 45 * 60
-- the client sends the clip no sooner than 3.2 s after the purse opens (TrainRaidClient.Purse.lua:2282)
-- Purse.lua:2281-2286: the client sends Take 3.2 s after the purse opens; a hair over that is the fastest the server accepts
local PURSE_DELAY = 3.4
local KNOCK_SLACK = 0.15
local RESULTS_GRACE = 90

local Run = {}

function Run.new(env)
    local Activities, World, References = env.Activities, env.World, env.References
    local Combat = env.Combat
    local CollectionService = env.Services and env.Services.CollectionService
    local R = {}
    local queue = {}
    local tries = setmetatable({}, { __mode = "k" })
    -- live 2026-11-18: car 1's exit is "Pick the lock", which opens the game's lockpicking
    local lockpicker = Lockpick.new(Activities)
    local handle, current = nil, nil
    local latch = nil
    local purse = nil
    local result = nil

    function R.reset()
        table.clear(queue)
        handle, current, latch, purse, result = nil, nil, nil, nil, nil
    end

    function R.result() return result end

    -- pushes arrive on the remote's thread; they are only queued here and acted on in the run's own loop
    -- live-unverified (Rings.lua:1209-1221, 1748-1758): RingsChain {On, Need, Progress} chains you to tarkus; the struggle is sent at the client's 0.2 s pace until it's off
    local STRUGGLE_EVERY = 0.2
    local struggling = nil
    local function stopStruggle()
        if struggling then struggling:Cancel() end
        struggling = nil
    end
    local function startStruggle()
        if struggling or not Activities.raidStruggle then return end
        struggling = Jobs.interval(STRUGGLE_EVERY, function() Activities.raidStruggle() end, { name = "AutoRaid struggle", immediate = true })
    end

    -- live-unverified (RingsHazards.lua:252-320, Telegraph.lua:63-80): an icefall lands at At inside Size/2 of Position; a telegraph is a floor rectangle
    -- (CFrame along its LookVector, Size X width by Z length) for Duration. each is a strike zone until it lands, stepped out of by stepAvoid
    local strikes = {}
    local function serverNow() return env.Services.Workspace:GetServerTimeNow() end
    local function addStrike(verb, payload)
        local now = serverNow()
        if verb == "RingsIcefall" and typeof(payload.Position) == "Vector3" then
            local at = tonumber(payload.At) or now
            local size = tonumber(payload.Size) or 9
            if at - now > 0.05 and at - now <= 6 then strikes[#strikes + 1] = Hazards.circle(payload.Position, size / 2 + 3, at + 0.3) end
        elseif verb == "Telegraph" and typeof(payload.CFrame) == "CFrame" and typeof(payload.Size) == "Vector3" then
            local cf, size = payload.CFrame, payload.Size
            -- whether the frame marks the rectangle's centre or its start isn't known, so the box covers both
            local center = cf * CFrame.new(0, 0, -size.Z / 4)
            strikes[#strikes + 1] = { strike = true, untilAt = now + (tonumber(payload.Duration) or 1), box = { cf = center, size = Vector3.new(size.X + 2, 40, size.Z * 1.5 + 2) } }
        end
        for i = #strikes, 1, -1 do
            if strikes[i].untilAt < now then table.remove(strikes, i) end
        end
    end

    function R.onMessage(verb, payload)
        if (verb == "RingsIcefall" or verb == "Telegraph") and type(payload) == "table" then
            pcall(addStrike, verb, payload)
            return
        end
        if verb == "RingsChain" and type(payload) == "table" then
            if payload.On then startStruggle() else stopStruggle() end
            return
        end
        if verb == "Results" and type(payload) == "table" then
            result = payload
        elseif verb == "Suspect" or verb == "Purse" or verb == "Latch" or verb == "PurseResult" then
            queue[#queue + 1] = { verb = verb, payload = payload }
        end
    end

    local function state()
        local ok, st = Activities.raidState()
        return ok and st or nil
    end

    local function myPosition()
        local root = References.humanoidRootPart
        return root and root.Parent and root.Position or nil
    end

    local function spectating(st)
        if type(st) == "table" and st.Dead == true then return true end
        local char = References.character
        return char ~= nil and char:GetAttribute("TrainRaidSpectator") == true
    end

    -- the game's own cleanup runs when its Dialogue gui is disabled (DialogueHandler.lua:1069-1084); a suspect page left open would hold DialogueInputLocked
    local function closeDialogue()
        local player = References.player
        local gui = player and player:FindFirstChild("PlayerGui")
        local dialogue = gui and gui:FindFirstChild("Dialogue")
        if not (dialogue and dialogue:IsA("ScreenGui") and dialogue.Enabled) then return false end
        Identity.elevate()
        local ok = pcall(function() dialogue.Enabled = false end)
        -- live 2026-11-19 (user: the hp/moves/money hud sometimes vanishes): disabling the dialogue skips the close that fades the hud back in
        if ok then GameHud.restoreAfterClose(player) end
        return ok
    end

    local function stopFight()
        if handle then handle.stop() end
        handle, current = nil, nil
    end

    local function handleQueue()
        while #queue > 0 do
            local item = table.remove(queue, 1)
            local p = item.payload
            if item.verb == "Suspect" then
                if Plan.shouldAccuse(p) then
                    env.say("Accusing the spy")
                    local ok, err = Activities.raidAccuse(p.Index, p.Token)
                    if not ok then Log.dev("AutoRaid", "accuse refused: %s", tostring(err)) end
                else
                    closeDialogue()
                end
            elseif item.verb == "Purse" and type(p) == "table" and type(p.Token) == "string" then
                purse = { token = p.Token, at = os.clock() + PURSE_DELAY, from = myPosition() }
            elseif item.verb == "PurseResult" and type(p) == "table" then
                if purse and p.Token == purse.token then purse = nil end
                if p.Ok ~= true then Log.dev("AutoRaid", "purse result: %s", tostring(p.Text)) end
            elseif item.verb == "Latch" and type(p) == "table" then
                local count = tonumber(p.Count) or 0
                if count > 0 then
                    latch = latch or {}
                    latch.count, latch.hold = count, tonumber(p.Hold) or 0.6
                else
                    latch = nil
                end
            end
        end
    end

    -- TrainRaidClient.Highway.lua:400-436: KnockBegin, then Knock once the hold has run
    local function stepLatch()
        if not latch then return end
        local t = os.clock()
        if not latch.begunAt then
            env.say("Shaking it off")
            Activities.raidAction("KnockBegin")
            latch.begunAt = t
        elseif t - latch.begunAt >= latch.hold + KNOCK_SLACK then
            Activities.raidAction("Knock")
            latch.begunAt = nil
        end
    end

    -- live 2026-11-18: every take came back "You're too far from her." because the run wandered off in the 4 s wait; while a purse is open
    -- the run holds still, walks back to where it opened if it drifted, then takes the clip (true while a purse is pending)
    local PURSE_REACH = 6
    local function stepPurse()
        if not purse then return false end
        local from = myPosition()
        if purse.from and from and (purse.from - from).Magnitude > PURSE_REACH then
            stopFight()
            World.travelTo(purse.from, { token = env.token(), offset = 0 })
        end
        if os.clock() < purse.at then return true end
        env.say("Taking the paper clip")
        local token = purse.token
        purse = nil
        local ok, err = Activities.raidPurseTake(token)
        if not ok then Log.dev("AutoRaid", "purse take refused: %s", tostring(err)) end
        return true
    end

    local function aggroOnMe(model)
        local value = model:FindFirstChild("NPCCombatTarget")
        local char = References.character
        return value ~= nil and value:IsA("ObjectValue") and value.Value ~= nil and char ~= nil and value.Value == char
    end

    local function entryFor(model, bossName)
        local ok, info = World.info(model)
        if not ok or not info.alive then return nil end
        local target = model:GetAttribute("Target")
        return {
            model = model, name = Plan.baseName(model.Name), boss = Plan.isBoss(model, bossName),
            aggro = aggroOnMe(model), distance = info.distance or 999,
            -- the npc you were sent to protect is named in its attackers' Target
            protects = type(target) == "string" and string.find(target, "CocoJumbo", 1, true) ~= nil,
            angler = model:GetAttribute("StandAltName") == "Beach Boy",
            ratio = info.maxHealth > 0 and info.health / info.maxHealth or 1,
        }
    end

    local function enemies(st, radius)
        local engine = env.getEngine()
        if not engine then return {} end
        local ok, list = World.combatants({ npcs = true, alive = true, maxDistance = radius })
        if not ok then return {} end
        local bossName = type(st.Boss) == "table" and st.Boss.Name or nil
        local targets = Plan.targetNames(st)
        local out = {}
        for _, model in ipairs(list) do
            if Plan.isEnemy(model, bossName, targets) and engine.valid(model) then
                local e = entryFor(model, bossName)
                if e then out[#out + 1] = e end
            end
        end
        return out
    end

    -- live 2026-11-19: a target knocked off the side of the train took the attach with it, and the fight went on under the car until we died (151 hp to 1,
    -- a life gone); on the train the hold point is kept inside the car we're in (its width less a margin, never under its floor)
    local CONFINE_MARGIN = 3
    -- standing in a car puts the root about 3 under its box centre (see offTrain)
    local CONFINE_FLOOR = -3
    local confineCar = nil
    -- during a warm-up the fight is held near the fire (see stepWarm)
    local confineFire = nil
    local FIRE_ZONE = 8
    -- live 2026-11-19 (user: we fell off the mountain): rings' fights are on cliffs, and a vampire knocked over the graveyard's edge took the attach (and a
    -- life) with it; on rings a hold point with no floor within EDGE_DEPTH under it stays at the last one that had floor
    local EDGE_DEPTH = 40
    local confineEdges = false
    -- set once the hazard list exists (stepAvoid): (hazard, way out) at a point
    local confineHazards = nil
    local lastFooting = nil
    local edgeParams = nil
    local function hasFloor(position)
        -- no probe available reads as floor, so the hold is never pinned by a missing api
        if not edgeParams then
            local okP, params = pcall(function() return RaycastParams.new() end)
            if not okP then return true end
            edgeParams = params
        end
        edgeParams.FilterType = Enum.RaycastFilterType.Exclude
        local char = References.character
        edgeParams.FilterDescendantsInstances = char and { char } or {}
        pcall(function() edgeParams.RespectCanCollide = true end)
        local ok, hit = pcall(env.Services.Workspace.Raycast, env.Services.Workspace, position + Vector3.new(0, 3, 0), Vector3.new(0, -EDGE_DEPTH, 0), edgeParams)
        if not (ok and hit) then return false end
        -- a void slab (Chasm.VoidFloor, "counts as falling in when touched") under the point is no floor at all
        local node = hit.Instance
        for _ = 1, 3 do
            if not node then break end
            if string.find(node.Name, "Void", 1, true) then return false end
            node = node.Parent
        end
        return true
    end
    local function confine(position)
        if confineEdges and confineHazards then
            local okH, hazard, way = pcall(confineHazards, position)
            if okH and hazard and way then position = Vector3.new(way.X, position.Y, way.Z) end
        end
        if confineEdges then
            if hasFloor(position) then
                lastFooting = position
            elseif lastFooting then
                return lastFooting
            end
        end
        if confineFire then
            local flat = Vector3.new(position.X - confineFire.X, 0, position.Z - confineFire.Z)
            if flat.Magnitude > FIRE_ZONE then position = Vector3.new(confineFire.X, position.Y, confineFire.Z) + flat.Unit * FIRE_ZONE end
        end
        local car = confineCar
        if not (car and car.Parent) then return position end
        local cf, size = car:GetBoundingBox()
        local p = cf:PointToObjectSpace(position)
        local halfZ = math.max(0, size.Z / 2 - CONFINE_MARGIN)
        -- along the car (X) the gangways join the next car, so only the sides and the floor are held
        local clamped = Vector3.new(p.X, math.max(p.Y, CONFINE_FLOOR), math.clamp(p.Z, -halfZ, halfZ))
        if clamped == p then return position end
        return cf:PointToWorldSpace(clamped)
    end

    local function fightOpts()
        local o = { owner = OWNER, token = env.token(), timeout = FIGHT_TIMEOUT }
        -- always passed: confine reads the current car and warm-up fire each frame, and lets the point through when neither is set
        o.confine = confine
        local position = env.option("AutoRaid_Position", "Combat Settings")
        if position ~= "Combat Settings" and position ~= nil then
            o.mode = position
            o.distance = tonumber(env.option("AutoRaid_Distance", 3)) or 3
        end
        return o
    end

    local function label(st, text)
        local where = Plan.progress(st)
        if where ~= "" then return text .. " (" .. where .. ")" end
        return text
    end

    -- one engine fight per target; the run steers it onto a better target instead of restarting
    local function stepFight(st)
        if handle and handle.done() then handle, current = nil, nil end
        local list = enemies(st, ENEMY_RADIUS)
        local best = Plan.rank(list)
        if handle then
            if best and Plan.shouldSwitch(current, best) then
                handle.setTarget(best.model)
                current = best
            end
            env.say(label(st, "Fighting " .. (current and current.name or "enemies")))
            return true
        end
        if not best then return false end
        local engine = env.getEngine()
        local h, err = engine.start(best.model, fightOpts())
        if not h then
            Log.dev("AutoRaid", "fight didn't start: %s", tostring(err))
            return false
        end
        handle, current = h, best
        env.say(label(st, "Fighting " .. best.name))
        return true
    end

    local function raidRoot(st)
        if type(st.Id) ~= "string" and type(st.Id) ~= "number" then return nil end
        local gameRoot = env.Services.Workspace:FindFirstChild("Game")
        local map = gameRoot and gameRoot:FindFirstChild("Map")
        if not map then return nil end
        -- Map.RingsRaid_<id> / Map.HighwayStarRaid_<id> (Rings.lua:198-206, Highway.lua:614); the train follows the same naming
        local id = tostring(st.Id)
        for _, prefix in ipairs({ tostring(st.Raid) .. "Raid_", "TrainRaid_", "Raid_" }) do
            local found = map:FindFirstChild(prefix .. id)
            if found then return found, map end
        end
        return nil
    end

    -- live 2026-11-18: the old lady's one prompt goes Talk, then Search her purse; a prompt whose text changed is a new step with fresh tries.
    -- live 2026-11-18: "Return the tea flask" is her same Talk again, and the tries "Talk to the old lady" spent held it 24 s; a new objective is fresh tries too
    local objectiveNow = nil
    local function tryKey(p)
        return tostring(objectiveNow) .. "|" .. tostring(p.action)
    end
    -- live 2026-11-19: car 5's key hunt sat 20 s at 3 of 5 compartments; a search the hits interrupted used both tries and waited out PROMPT_RETRY. during a key hunt
    -- the compartments' own prompts come back after KEY_RETRY
    local function retryFor(p)
        local objective, action = string.lower(tostring(objectiveNow or "")), string.lower(tostring(p.action or ""))
        local hunt = string.find(objective, "key", 1, true) or string.find(objective, "compartment", 1, true)
        if hunt and (string.find(action, "search", 1, true) or string.find(action, "pick", 1, true)) then return KEY_RETRY end
        return PROMPT_RETRY
    end
    local function triesOf(p)
        local byAction = tries[p.prompt]
        local entry = byAction and byAction[tryKey(p)]
        if not entry or os.clock() - entry.at >= retryFor(p) then return 0 end
        return entry.count
    end

    local function countTry(p)
        local byAction = tries[p.prompt] or {}
        tries[p.prompt] = byAction
        local key = tryKey(p)
        local entry = byAction[key]
        if not entry or os.clock() - entry.at >= retryFor(p) then entry = { count = 0 } end
        entry.count, entry.at = entry.count + 1, os.clock()
        byAction[key] = entry
    end

    local function insideRoom(room, from)
        local ok, cf, size = pcall(function() return room:GetBoundingBox() end)
        if not ok or not cf then return false end
        local p = cf:PointToObjectSpace(from)
        return math.abs(p.X) <= size.X / 2 and math.abs(p.Y) <= size.Y / 2 and math.abs(p.Z) <= size.Z / 2
    end

    local function pressNext(list, from)
        local best, bestDistance = nil, math.huge
        for _, p in ipairs(list) do
            local iceOk = string.lower(tostring(p.action)) ~= "take ice" or string.find(string.lower(tostring(objectiveNow or "")), "take ice", 1, true) ~= nil
            if iceOk and Plan.safePrompt(p, objectiveNow) and triesOf(p) < PROMPT_TRIES and p.position then
                local d = from and (p.position - from).Magnitude or 0
                if d < bestDistance then best, bestDistance = p, d end
            end
        end
        if not best then return false end
        countTry(best)
        if bestDistance > (best.maxDistance or 8) - 1 then
            World.travelTo(best.position, { token = env.token() })
        end
        local ok, err = World.firePrompt(best.prompt)
        if not ok then Log.dev("AutoRaid", "prompt refused: %s", tostring(err)) end
        return true
    end

    -- loot drops first, then the raid's own interacts (doors, passengers, purses), nearest first and each a bounded number of times
    local function stepPrompts(st, radius)
        local from = myPosition()
        if not from then return false end
        local ok, drops = World.prompts({ near = from, radius = PICKUP_RADIUS, name = "WorldItemPickup" })
        if ok and pressNext(drops, from) then
            env.say(label(st, "Picking up loot"))
            return true
        end
        local root, map = raidRoot(st)
        if not root then return false end
        objectiveNow = st.Objective
        -- live 2026-11-18: car 8's fridge sits in its own room model (Map.Room_TrainCoco_<id>_8), beside the raid map
        local list = {}
        local okRaid, inRaid = World.prompts({ root = root, near = from, radius = radius })
        for _, p in ipairs(okRaid and inRaid or {}) do list[#list + 1] = p end
        local id = tostring(st.Id)
        -- live 2026-11-18: a pocket room is only entered through the game's own teleport; travelling into one left the client on "Streaming the area..." for good, so its prompts count only once you're inside it
        for _, child in ipairs(map:GetChildren()) do
            if child ~= root and string.find(child.Name, id, 1, true) and insideRoom(child, from) then
                local okRoom, inRoom = World.prompts({ root = child, near = from, radius = radius })
                for _, p in ipairs(okRoom and inRoom or {}) do list[#list + 1] = p end
            end
        end
        -- rings' spare rings (Props.SpareRing): one you've claimed carries Claimed_<UserId>, which only hides it on your client (Rings.lua:1371-1389)
        local claimKey = References.player and ("Claimed_" .. tostring(References.player.UserId))
        for _, p in ipairs(list) do
            local okRing, ring = pcall(function() return claimKey and p.prompt:FindFirstAncestor("SpareRing") end)
            if okRing and ring and ring:GetAttribute(claimKey) ~= nil then p.claimed = true end
        end
        if pressNext(list, from) then
            env.say(label(st, "Checking the " .. string.lower((Plan.RAIDS[st.Raid] or Plan.RAIDS.Train).unit)))
            return true
        end
        return false
    end

    -- nothing near: walk the fight forward to the nearest enemy anywhere in the raid
    local function advance(st)
        local list = enemies(st, FAR_RADIUS)
        local best = Plan.rank(list)
        if not best then return false end
        local pos = best.model:GetPivot().Position
        env.say(label(st, "Moving to " .. best.name))
        World.travelTo(pos, { token = env.token() })
        return true
    end

    -- live 2026-11-19 (user: our cold keeps rising): rings areas drain the character's Temperature (Map.Areas ColdRate -0.4 to -0.6 a second) toward -100,
    -- where it bites 1% max hp every 0.1 s (Temperature.lua ColdDamageFraction/Interval; "Frostbite" took 157 hp in 15 s). Fires warm you (Props Campfire /
    -- Brazier, Map.Torches), so a low temperature stops the fight for a warm-up beside the nearest one until it's back up
    -- live 2026-11-19 (user: we hit 100 cold without warming up): warmth is the server's (the client's fires are only lights, Rings.lua:1320-1369), and
    -- fighting 20 studs out never warmed us. so the warm-up goes by feedback: stand by the fire, fight only what comes within a few studs of it, and a fire
    -- that doesn't warm within WARM_CHECK is swapped for the next nearest
    local COLD_LOW = -60
    local COLD_OK = -20
    -- this cold, frostbite (-100) is a few seconds off: warmth first, whatever is around
    local COLD_CRITICAL = -90
    local FIRE_STAND = 3
    local WARM_CHECK = 5
    local WARM_FIGHT = 15
    local warming = nil
    local function temperature()
        local char = References.character
        local t = char and char:GetAttribute("Temperature")
        return type(t) == "number" and t or nil
    end
    -- the nearest fire not yet found cold (Props Campfire / Brazier first; a torch only when much nearer)
    local function nearestFire(st, from, skip)
        local root = raidRoot(st)
        if not root then return nil end
        local best, bestD = nil, math.huge
        local function consider(model, weight)
            local ok, pos = pcall(function() return model:GetPivot().Position end)
            if ok and pos and not (skip and skip[model]) then
                local d = (pos - from).Magnitude * weight
                if d < bestD then best, bestD = model, d end
            end
        end
        local props = root:FindFirstChild("Props")
        for _, c in ipairs(props and props:GetChildren() or {}) do
            if c.Name == "Campfire" or c.Name == "Brazier" then consider(c, 1) end
        end
        local map = root:FindFirstChild("Map")
        local torches = map and map:FindFirstChild("Torches")
        for _, c in ipairs(torches and torches:GetChildren() or {}) do consider(c, 2) end
        return best
    end
    local function stepWarm(st)
        local t = temperature()
        if not t then return false end
        if warming then
            if t >= COLD_OK then warming, confineFire = nil, nil return false end
        elseif t > COLD_LOW then
            return false
        end
        -- live 2026-11-22 (user: slow into the graveyard): the run starts near -60, and a fire first cost the walk-in; before a stage's
        -- waves start (no Progress yet) only deep cold stops the walk to its area
        if not warming and t > COLD_CRITICAL and (st.Progress == nil or st.Progress == "") then return false end
        local from = myPosition()
        if not from then return false end
        if not warming then
            local fire = nearestFire(st, from, nil)
            if not fire then return false end
            warming = { fire = fire, since = os.clock(), at = t, skip = {} }
        end
        -- swap a fire that hasn't warmed us since we got there
        if os.clock() - warming.since > WARM_CHECK then
            if t <= warming.at + 0.5 then
                warming.skip[warming.fire] = true
                local nextFire = nearestFire(st, from, warming.skip)
                if not nextFire then warming, confineFire = nil, nil return false end
                warming.fire = nextFire
            end
            warming.since, warming.at = os.clock(), t
        end
        local fireAt = warming.fire:GetPivot().Position
        confineFire = fireAt
        -- what's hitting us at the fire is fought there; deep cold puts warmth first
        if t > COLD_CRITICAL and #enemies(st, WARM_FIGHT) > 0 then return false end
        stopFight()
        env.say(label(st, ("Warming up (%d)"):format(math.floor(t))))
        local flat = Vector3.new(from.X - fireAt.X, 0, from.Z - fireAt.Z)
        local spot = fireAt + (flat.Magnitude > 0.5 and flat.Unit or Vector3.new(1, 0, 0)) * FIRE_STAND
        if (Vector3.new(spot.X, from.Y, spot.Z) - from).Magnitude > 2 then
            -- arriving restarts the warm check, so the walk over isn't counted against the fire
            warming.since, warming.at = os.clock(), t
            World.travelTo(spot, { token = env.token(), ground = true })
        end
        return true
    end

    -- rings' traps from the live map (live 2026-11-19 dump): spike strips (Props, Plate or Cycle), the spike floor and pit, the collapsing floor; inside one
    -- that hurts now (or is about to), and inside an announced strike, the run steps out before anything else, and fights are held outside them
    local HAZARD_REFRESH = 10
    local hazardList, hazardRoot, hazardAt = {}, nil, -math.huge
    local function hazardsFor(st)
        local root = raidRoot(st)
        if not root then return {} end
        if root ~= hazardRoot or os.clock() - hazardAt > HAZARD_REFRESH then
            hazardRoot, hazardAt = root, os.clock()
            local ok, list = pcall(Hazards.collect, root)
            hazardList = ok and list or {}
        end
        return hazardList
    end
    local function stepAvoid(st)
        if st.Raid ~= "Rings" then return false end
        local list = hazardsFor(st)
        confineHazards = function(position) return Hazards.at(list, strikes, position, serverNow(), true) end
        local from = myPosition()
        if not from then return false end
        local hazard, way = Hazards.at(list, strikes, from, serverNow())
        if not hazard then return false end
        stopFight()
        env.say(label(st, hazard.strike and "Dodging a strike" or ("Stepping off the " .. tostring(hazard.attrs and hazard.attrs.TrapType or "trap"))))
        World.travelTo(way, { token = env.token(), ground = true, groundUp = 8 })
        return true
    end

    -- user 2026-11-19 (get all the rings, as optimised as possible): rings' spare rings (Props.SpareRing, a prompt each; Claimed_<UserId> once taken,
    -- Rings.lua:1371-1389) are taken whenever nothing needs fighting, nearest first anywhere in the raid, before the run moves on
    local RING_TRIES = 3
    -- a ring more than this above the floor under it hangs over a drop or on a climb
    local RING_DROP = 15
    local ringTries = setmetatable({}, { __mode = "k" })
    local function stepSpareRings(st)
        if st.Raid ~= "Rings" then return false end
        local root = raidRoot(st)
        local from = myPosition()
        if not (root and from) then return false end
        local claimKey = References.player and ("Claimed_" .. tostring(References.player.UserId))
        local best, bestPrompt, bestD = nil, nil, math.huge
        for _, d in ipairs(root:GetDescendants()) do
            if d.Name == "SpareRing" and d:IsA("Model") and not (claimKey and d:GetAttribute(claimKey) ~= nil) and (ringTries[d] or 0) < RING_TRIES then
                local prompt = d:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt and prompt.Enabled then
                    local okP, pos = pcall(function() return d:GetPivot().Position end)
                    if okP and pos and (pos - from).Magnitude < bestD then best, bestPrompt, bestD = d, prompt, (pos - from).Magnitude end
                end
            end
        end
        if not best then return false end
        ringTries[best] = (ringTries[best] or 0) + 1
        env.say(label(st, "Taking a spare ring"))
        if bestD > (bestPrompt.MaxActivationDistance or 8) - 1 then
            -- a ring with no floor close under it (over a drop, on a wall) is skipped rather than teleported to
            local okGo = World.travelTo(best:GetPivot().Position, { token = env.token(), ground = true, groundRequired = true, groundMaxDrop = RING_DROP })
            if not okGo then
                ringTries[best] = RING_TRIES
                return true
            end
        end
        local ok, err = World.firePrompt(bestPrompt)
        if not ok then Log.dev("AutoRaid", "spare ring refused: %s", tostring(err)) end
        return true
    end

    -- live 2026-11-19: rings stage 1 ("Survive the dead in the graveyard") only starts once you walk through into its area (Map.Areas, ZoneId A<stage>,
    -- e.g. A1 The Graveyard Cliff 154 studs from the spawn); idle at the spawn, "Frostbite" took 157 hp in 15 s and a life. with nothing to fight, the run goes
    -- straight to the stage's area
    local AREA_NEAR = 40
    -- within this of a route point the route is picked up from there
    local ROUTE_NEAR = 25
    local ROUTE_TOLERANCE = 2.5
    local ROUTE_HOP_UP = 6
    local ROUTE_HOPS = 8
    local ROUTE_HOP_GAP = 0.1
    local ROUTE_FIGHT_NEAR = 40
    local AREA_DEADLY = 15
    local WAYPOINT_WAIT = 10
    local wayTry = nil
    local AREA_PROBE_UP = 12
    local AREA_EVERY = 4
    local areaAt = -math.huge
    local areaGoal = nil
    -- live 2026-11-19: "Cross the broken bridge" came as stage 1's second objective with nothing to fight, and the run stood in the graveyard; an objective
    -- that sends you on (cross / reach / climb / head / go) moves to the next area along the route (ZoneId order A1, A2, A3, A5...) after the one you're in
    local MOVE_WORDS = { "cross", "reach", "climb", "head", "go to", "make your way", "escape", "get to", "find the way" }
    local function zoneNumber(area)
        local id = area:GetAttribute("ZoneId")
        return type(id) == "string" and tonumber(string.match(id, "%d+")) or nil
    end
    function R.nextArea(areas, from, stage, objective)
        local list = {}
        for _, area in ipairs(areas) do
            local n = zoneNumber(area)
            local ok, pos = pcall(function() return area:GetPivot().Position end)
            if n and ok then list[#list + 1] = { area = area, n = n, pos = pos } end
        end
        table.sort(list, function(a, b) return a.n < b.n end)
        if #list == 0 then return nil end
        local text = string.lower(tostring(objective or ""))
        local moving = false
        for _, w in ipairs(MOVE_WORDS) do
            if string.find(text, w, 1, true) then moving = true break end
        end
        if moving then
            -- the area you're in is the nearest one; the next along the route is the goal
            local here, hereD = nil, math.huge
            for i, a in ipairs(list) do
                local d = (Vector3.new(a.pos.X, from.Y, a.pos.Z) - from).Magnitude
                if d < hereD then here, hereD = i, d end
            end
            local goal = list[math.min(#list, here + 1)]
            -- live 2026-11-22 (user: we lost the raid really quick): "Climb the frozen mountain" sent a fresh respawn to the summit's marker and the
            -- landing there dropped into the void, the last life gone in 3 s; the summit is climbed to, never teleported to
            if goal.area:GetAttribute("AreaId") == "RingsSummit" or goal.area:GetAttribute("ZoneId") == "A7" then return nil end
            return goal.area
        end
        for _, a in ipairs(list) do
            if a.n == stage then return a.area end
        end
        -- live 2026-11-22 (user: we only walked into the graveyard to warm up): the first State push came 16 s into the run, so with no stage
        -- known yet the route's first area is the goal
        if stage == nil then return list[1].area end
        return nil
    end

    -- live 2026-11-19: "Cross the broken bridge" is Map.Obstacles.BrokenSpan_*: pillars tagged Step 1..8 (a CrumbleTop on 3, an IceCap on 5, both Step too),
    -- then a ChainClimbPlate hanging from the far landing's edge above pillar 8 ("the climb up from pillar 8"); going straight to the next area didn't count.
    -- each step's top is stood on in order (ground landing finds the top), then the chain plate, then the landing beyond it
    local BRIDGE_GAP = 0.6
    local BRIDGE_RETRY = 20
    local bridgeDone = nil
    function R.bridgeSteps(span)
        local steps = {}
        for _, c in ipairs(span:GetChildren()) do
            local n = tonumber(c:GetAttribute("Step"))
            if n and c:IsA("BasePart") then
                -- a crumble or ice cap sits on its pillar: the cap is the top to stand on
                local top = c.Position + Vector3.new(0, c.Size.Y / 2, 0)
                if not steps[n] or top.Y > steps[n].Y then steps[n] = top end
            end
        end
        local out = {}
        for n = 1, 50 do
            if steps[n] then out[#out + 1] = steps[n] end
        end
        return out
    end
    local function stepRingsBridge(st, j)
        if st.Raid ~= "Rings" then return false end
        local objective = string.lower(tostring(st.Objective or ""))
        -- one crossing per objective, tried again if the objective is still there after BRIDGE_RETRY
        if not string.find(objective, "bridge", 1, true) then return false end
        if bridgeDone and bridgeDone.objective == st.Objective and os.clock() - bridgeDone.at < BRIDGE_RETRY then return false end
        local root = raidRoot(st)
        local map = root and root:FindFirstChild("Map")
        local obstacles = map and map:FindFirstChild("Obstacles")
        local span = nil
        for _, c in ipairs(obstacles and obstacles:GetChildren() or {}) do
            if string.find(c.Name, "BrokenSpan", 1, true) then span = c end
        end
        if not span then return false end
        bridgeDone = { objective = st.Objective, at = os.clock() }
        stopFight()
        local steps = R.bridgeSteps(span)
        for i, top in ipairs(steps) do
            env.say(label(st, ("Crossing the bridge %d/%d"):format(i, #steps)))
            World.travelTo(top, { token = env.token(), offset = 3 })
            if not j:sleep(BRIDGE_GAP) then return true end
        end
        local plate = span:FindFirstChild("ChainClimbPlate")
        if plate and plate:IsA("BasePart") then
            env.say(label(st, "Climbing the chain"))
            -- the landing is past the plate's top edge, away from the pillars
            local away = steps[#steps] and Vector3.new(plate.Position.X - steps[#steps].X, 0, plate.Position.Z - steps[#steps].Z) or Vector3.new(0, 0, 1)
            away = away.Magnitude > 0.1 and away.Unit or Vector3.new(0, 0, 1)
            local landing = plate.Position + Vector3.new(0, plate.Size.Y / 2 + 4, 0) + away * 6
            World.travelTo(landing, { token = env.token(), ground = true })
        end
        return true
    end

    -- live 2026-11-19: a move whose landing killed us was sent again after each respawn, three lives in 12 s; a death soon after a move drops it (called
    -- from the loop's respawn wait, since steps only run while alive)
    local function noteDeath()
        if areaGoal and areaGoal.movedAt and os.clock() - areaGoal.movedAt < AREA_DEADLY then areaGoal.dead = true end
    end

    -- live 2026-11-22 (user: you should see the actual dio model and just tp to that): the shrine's DIO waits dormant (TrainRaidDormant,
    -- FightableNPC false) ~200 studs from where the climb ends and nothing woke him; the run goes to the raid's boss model itself
    local BOSS_NEAR = 18
    local BOSS_STAND = 10
    local BOSS_EVERY = 4
    local bossAt = -math.huge
    local function stepRingsBoss(st)
        if st.Raid ~= "Rings" or not string.find(string.lower(tostring(st.Objective or "")), "defeat", 1, true) then return false end
        if os.clock() - bossAt < BOSS_EVERY then return false end
        local players = env.Services.Workspace:FindFirstChild("Game")
        players = players and players:FindFirstChild("Players")
        local boss = nil
        for _, model in ipairs(players and players:GetChildren() or {}) do
            if model:GetAttribute("TrainRaidBoss") == true and model:GetAttribute("TrainRaidNPC") == tostring(st.Id) then boss = model end
        end
        local here = myPosition()
        if not (boss and here) then return false end
        local okP, pivot = pcall(function() return boss:GetPivot() end)
        if not okP then return false end
        if (pivot.Position - here).Magnitude <= BOSS_NEAR then return false end
        bossAt = os.clock()
        env.say(label(st, "Going to " .. tostring(boss:GetAttribute("RingsBoss") or boss.Name)))
        World.travelTo(pivot.Position + pivot.LookVector * BOSS_STAND, { token = env.token(), ground = true, groundRequired = true, groundUp = AREA_PROBE_UP })
        return true
    end

    local function stepRingsArea(st, j)
        if st.Raid ~= "Rings" or os.clock() - areaAt < AREA_EVERY then return false end
        -- a recorded route is run one leg a pass, so a fight (an earlier step) cuts in between legs and the route picks up again after it
        -- (user 2026-11-22: enemies spawn on the path; pause, kill them, then resume)
        local route, hop = Plan.ringsRoute(st.Objective)
        if route then
            local here = myPosition()
            if not here then return false end
            local index, onRoute = Plan.routeResume(route, here, ROUTE_NEAR)
            areaAt = os.clock() - AREA_EVERY
            if not onRoute then
                env.say(label(st, "Going to the start of the route"))
                World.travelTo(route[1], { token = env.token(), ground = true, groundRequired = true, groundUp = AREA_PROBE_UP })
                return true
            end
            env.say(label(st, ("%s the route %d/%d"):format(hop and "Hopping" or "Running", index, #route)))
            local ok, err
            if hop then
                -- each hop lands on the floor just under the recorded spot, never on a void slab; several a pass along the loaded path (user 2026-11-22: the
                -- chains could be faster), stopping the moment an enemy is near or the objective moves so the fight step takes over
                local objective = st.Objective
                for i = index, math.min(#route, index + ROUTE_HOPS - 1) do
                    if i > index then
                        if j and not j:sleep(ROUTE_HOP_GAP) then return true end
                        if #enemies(st, ROUTE_FIGHT_NEAR) > 0 or (state() or {}).Objective ~= objective then break end
                    end
                    ok, err = World.travelTo(route[i], { token = env.token(), ground = true, groundRequired = true, groundUp = ROUTE_HOP_UP,
                        stream = false, viewZonesTimeout = 0 })
                    if not ok then break end
                end
            else
                ok, err = World.walkTo(route[index], { token = env.token(), sprint = true, direct = true, stream = false, tolerance = ROUTE_TOLERANCE })
            end
            if not ok then Log.dev("AutoRaid", "route leg %d: %s", index, tostring(err)) end
            return true
        end
        -- an objective with a known waypoint goes there instead of to an area
        -- candidates are tried in turn: one stood at for WAYPOINT_WAIT without the objective moving (or refused, or deadly) hands over to the next
        local waypoints, walks = Plan.ringsWaypoint(st.Objective)
        if waypoints then
            local objective = tostring(st.Objective)
            if not (wayTry and wayTry.objective == objective) then wayTry = { objective = objective, index = 1, since = nil } end
            if areaGoal and areaGoal.objective == objective and areaGoal.dead then
                areaGoal.dead = false
                wayTry.index, wayTry.since = wayTry.index + 1, nil
            end
            local waypoint = waypoints[wayTry.index]
            if not waypoint then return false end
            local here = myPosition()
            if not here then return false end
            if (Vector3.new(waypoint.X, here.Y, waypoint.Z) - here).Magnitude <= AREA_NEAR / 2 then
                wayTry.since = wayTry.since or os.clock()
                if os.clock() - wayTry.since < WAYPOINT_WAIT then return false end
                Log.dev("AutoRaid", "waypoint %d for %q didn't count", wayTry.index, objective)
                wayTry.index, wayTry.since = wayTry.index + 1, nil
                waypoint = waypoints[wayTry.index]
                if not waypoint then return false end
            end
            areaAt = os.clock()
            areaGoal = { objective = objective, movedAt = os.clock() }
            env.say(label(st, ("Heading for %s (%d/%d)"):format(string.lower(objective):gsub("^%a+ ", ""), wayTry.index, #waypoints)))
            local okGo
            if walks and walks[wayTry.index] then
                -- a leg the game only counts on foot (a teleport there didn't)
                okGo = World.walkTo(waypoint, { token = env.token(), sprint = true })
            else
                okGo = World.travelTo(waypoint, { token = env.token(), ground = true, groundRequired = true, groundUp = AREA_PROBE_UP })
            end
            -- a refused landing (no floor, a void slab) moves straight on to the next candidate
            if not okGo then wayTry.index, wayTry.since = wayTry.index + 1, nil end
            return true
        end
        local root = raidRoot(st)
        local map = root and root:FindFirstChild("Map")
        local areas = map and map:FindFirstChild("Areas")
        local from = myPosition()
        if not (areas and from) then return false end
        -- one goal per objective: arriving makes the goal the nearest area, and re-picking then would hop on along the route
        local objective = tostring(st.Objective)
        if areaGoal and areaGoal.objective == objective and areaGoal.dead then return false end
        local area = areaGoal and areaGoal.objective == objective and areaGoal.area or nil
        if not area then
            area = R.nextArea(areas:GetChildren(), from, tonumber(st.Car) or tonumber(st.Stage), st.Objective)
            if not area then return false end
            areaGoal = { objective = objective, area = area }
        end
        local pivot = area:GetPivot().Position
        if (Vector3.new(pivot.X, from.Y, pivot.Z) - from).Magnitude <= AREA_NEAR then return false end
        areaAt = os.clock()
        env.say(label(st, "Going to " .. tostring(area:GetAttribute("AreaTitle") or area.Name)))
        areaGoal.movedAt = os.clock()
        -- the floor is looked for from just above the area's marker, so a roof or overhang over it isn't taken for the ground
        World.travelTo(pivot, { token = env.token(), ground = true, groundRequired = true, groundUp = AREA_PROBE_UP })
        return true
    end

    -- live 2026-11-18: car 3's passengers stand in Game.Players with a Talk prompt, outside the raid map, so the prompt step never sees them; only the spy is talked to, and its page is accused
    local SPY_TRIES = 3
    local spyTalks = setmetatable({}, { __mode = "k" })
    local function stepSpy(st)
        local players = env.Services.Workspace:FindFirstChild("Game")
        players = players and players:FindFirstChild("Players")
        if not players then return false end
        for _, model in ipairs(players:GetChildren()) do
            if model:GetAttribute("TrainRaidNPC") == tostring(st.Id) and Plan.isSpy(model) and (spyTalks[model] or 0) < SPY_TRIES then
                local talk = model:FindFirstChild("Talk", true)
                if talk and talk:IsA("ProximityPrompt") and talk.Enabled then
                    spyTalks[model] = (spyTalks[model] or 0) + 1
                    env.say(label(st, "Questioning the spy"))
                    World.travelTo(model:GetPivot().Position, { token = env.token() })
                    local ok, err = World.firePrompt(talk)
                    if not ok then Log.dev("AutoRaid", "spy talk refused: %s", tostring(err)) end
                    return true
                end
            end
        end
        return false
    end

    -- live 2026-11-18: car 2 ("Enter the next car") spawns nothing until you walk in; the car is the raid model whose TrainRaidCar is the state's Car
    -- a cleared car keeps the state on it with "Enter the next car" again, so from inside it the next one is the goal
    local function carModel(st, index)
        local root = raidRoot(st)
        if not root or index == nil then return nil end
        for _, child in ipairs(root:GetChildren()) do
            if child:IsA("Model") and child:GetAttribute("TrainRaidCar") == index then return child end
        end
        return nil
    end

    local function insideCar(car, from)
        local cf, size = car:GetBoundingBox()
        local inside = cf:PointToObjectSpace(from)
        return math.abs(inside.X) < size.X / 2 - 4 and math.abs(inside.Z) < size.Z / 2, cf
    end

    local function enterCar(st)
        local from = myPosition()
        local car = carModel(st, st.Car)
        if not (car and from) then return false end
        local inside, cf = insideCar(car, from)
        if inside then
            -- only an "Enter the next car" objective moves on; any other means this car still has work
            if not string.find(string.lower(tostring(st.Objective or "")), "enter", 1, true) then return false end
            local nextCar = carModel(st, (tonumber(st.Car) or 0) + 1)
            if not nextCar then return false end
            inside, cf = insideCar(nextCar, from)
            if inside then return false end
        end
        env.say(label(st, "Entering the next " .. string.lower((Plan.RAIDS[st.Raid] or Plan.RAIDS.Train).unit)))
        World.travelTo(cf.Position, { token = env.token() })
        return true
    end

    -- live 2026-11-18: "Break down the exit door" (car 6) is the car's locked EndDoor; melee does nothing to it, but stand skills break its panels (red pull and crossfire took 100% to 60%)
    -- live 2026-11-18: casts from 30-40 studs never counted; from 4 studs inside, barrage alone took car 7's door 60% -> 9%
    local DOOR_REACH = 8
    local DOOR_STAND = 4
    -- Skills.lua: BarrageLength 2.5, so holding longer adds nothing
    local SKILL_HOLD = { Barrage = 2.5 }
    local DOOR_CAST_GAP = 0.5
    local DOOR_SWING_GAP = 0.8
    local doorCastAt = 0
    -- live 2026-11-18: after a respawn the stand stayed away and the door step "cast" into nothing (75% for minutes); skill steps call the stand first
    local summonAt = 0
    local function standOut()
        if not (Combat and Combat.stand) then return true end
        local ok, stand = Combat.stand()
        if ok and type(stand) == "table" and stand.summoned then return true end
        if os.clock() >= summonAt and Combat.summon then
            summonAt = os.clock() + 1
            Combat.summon(true)
        end
        return false
    end

    local function lockedDoor(st)
        local car = carModel(st, st.Car)
        if not car then return nil end
        local wantCloset = string.find(string.lower(tostring(st.Objective or "")), "closet", 1, true) ~= nil
        local fallback
        for _, d in ipairs(car:GetDescendants()) do
            -- live 2026-11-18: car 6's is EndDoor, car 7 (hide coco jumbo) locks its LeftDoor; any locked door model of the car is the one
            -- live 2026-11-18: car 6 also locks the spy's closet (TrainRaidCloset, DoorBroken once hit); "break down the exit door" sat at 100% while we beat on it
            if d:IsA("Model") and d:GetAttribute("DoorLocked") == true and (d:GetAttribute("TrainRaidCloset") == true) == wantCloset then
                if d:GetAttribute("DoorBroken") == nil then return d end
                fallback = fallback or d
            end
        end
        return fallback
    end

    -- live 2026-11-19: the last 9% of car 7's door sat out every skill's cooldown; each cast goes at the next panel still standing, round the door
    local aimTurn = 0
    local function doorAim(door)
        local standing = {}
        for _, d in ipairs(door:GetDescendants()) do
            if d:IsA("BasePart") and d.Name == "DESTRUCTABLE" and d.Transparency < 1 then standing[#standing + 1] = d.Position end
        end
        if #standing == 0 then return door:GetPivot().Position end
        aimTurn = aimTurn % #standing + 1
        return standing[aimTurn]
    end

    local function stepDoor(st)
        if not Combat then return false end
        local objective = string.lower(tostring(st.Objective or ""))
        if not (string.find(objective, "break", 1, true) and string.find(objective, "door", 1, true)) then return false end
        local door = lockedDoor(st)
        local from = myPosition()
        if not (door and from) then return false end
        local aim = doorAim(door)
        env.say(label(st, "Breaking the door"))
        -- live 2026-11-18: car 7's locked door is a side door; travelling onto its panel landed outside the car and bounced us around, so stand 6 studs inside, facing it
        local car = carModel(st, st.Car)
        local inward = car and (car:GetBoundingBox().Position - aim) or Vector3.new(0, 0, 0)
        inward = Vector3.new(inward.X, 0, inward.Z)
        local spot = inward.Magnitude > 1e-3 and (aim + inward.Unit * DOOR_STAND) or aim
        if (Vector3.new(spot.X, from.Y, spot.Z) - from).Magnitude > DOOR_REACH then
            stopFight()
            World.travelTo(spot, { token = env.token(), face = aim })
            return true
        end
        if os.clock() < doorCastAt then return true end
        if not standOut() then return true end
        local ok, list = Combat.skills()
        if not ok then return true end
        local anyReady = false
        for _, skill in ipairs(list) do
            if type(skill.name) == "string" and skill.name ~= "" and Combat.skillReady(skill.slot) then anyReady = true break end
        end
        -- every skill cooling down (barrage is 23 s): heavy swings at the door meanwhile instead of standing idle
        if not anyReady then
            if Combat.heavySwing and Combat.heavySwing({ aim = aim }) then doorCastAt = os.clock() + DOOR_SWING_GAP end
            return true
        end
        -- barrage first: it does most of a door's damage
        local ordered = {}
        for _, skill in ipairs(list) do if skill.name == "Barrage" then table.insert(ordered, 1, skill) else ordered[#ordered + 1] = skill end end
        for _, skill in ipairs(ordered) do
            if type(skill.name) == "string" and skill.name ~= "" and Combat.skillReady(skill.slot) then
                local cast = Combat.useSkill(skill.slot, aim)
                if cast then
                    local hold = SKILL_HOLD[skill.name] or 0.15
                    doorCastAt = os.clock() + hold + DOOR_CAST_GAP
                    local slot = skill.slot
                    task.delay(hold, function() Combat.releaseSkill(slot, aim) end) -- leak:allow a one-shot key release that neither loops nor waits again
                    return true
                end
            end
        end
        return true
    end

    -- live 2026-11-18 (shown by hand): "Break through the roof" after the pesci roof fight is punches on top of the NEXT car's middle, facing the train's front;
    -- each landed punch took 12.5%, no part breaks (the server keeps the roof's health), so this stands there and swings
    local ROOF_REACH = 5
    local function roofPanel()
        if not CollectionService then return nil end
        local okTag, list = pcall(CollectionService.GetTagged, CollectionService, "Damageable")
        for _, m in ipairs(okTag and list or {}) do
            if m:IsA("Model") and m.Name == "CrackedPanel" and m.Parent then return m end
        end
        return nil
    end
    local ROOF_STALL = 6
    local roofSince, roofProgress = nil, nil
    local function stepRoof(st)
        if not Combat then return false end
        local objective = string.lower(tostring(st.Objective or ""))
        if not (string.find(objective, "break", 1, true) and string.find(objective, "roof", 1, true)) then
            roofSince = nil
            return false
        end
        -- live 2026-11-18: the roof is a Damageable "CrackedPanel" model (Game.Effects, a 7-stud root): stand inside it and hit it, facing doesn't matter there
        local panel = roofPanel()
        if panel then
            local at = panel:GetPivot().Position
            local from0 = myPosition()
            env.say(label(st, "Breaking the roof"))
            if from0 and (at - from0).Magnitude > 3 then
                stopFight()
                World.travelTo(at, { token = env.token(), offset = 0 })
                return true
            end
            standOut()
            Combat.attack(panel)
            return true
        end
        local here, nextCar = carModel(st, st.Car), carModel(st, (tonumber(st.Car) or 0) + 1)
        local target = nextCar or here
        local from = myPosition()
        if not (target and from) then return false end
        local cf, size = target:GetBoundingBox()
        local spot = cf.Position + Vector3.new(0, size.Y / 2 + 3, 0)
        local ahead = here and (cf.Position - here:GetBoundingBox().Position) or cf.LookVector
        ahead = Vector3.new(ahead.X, 0, ahead.Z)
        ahead = ahead.Magnitude > 1e-3 and ahead.Unit or Vector3.new(1, 0, 0)
        env.say(label(st, "Breaking the roof"))
        if (Vector3.new(spot.X, from.Y, spot.Z) - from).Magnitude > ROOF_REACH or math.abs(from.Y - spot.Y) > 6 then
            World.travelTo(spot, { token = env.token(), face = spot + ahead * 10 })
            roofSince, roofProgress = nil, nil
            return true
        end
        -- live 2026-11-18: punching while turned backwards (the fights leave you facing anywhere) took a minute for 40%; face the train's front first
        local root = References.humanoidRootPart
        local look = root and Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
        if look and look.Magnitude > 1e-3 and look.Unit:Dot(ahead) < 0.8 then
            World.travelTo(from, { token = env.token(), face = from + ahead * 10 })
            return true
        end
        -- a stalled bar (no drop in a while) brings the heavy and the skills in too
        if st.Progress ~= roofProgress then roofSince, roofProgress = os.clock(), st.Progress end
        local stalled = roofSince and os.clock() - roofSince > ROOF_STALL
        if stalled and Combat.heavySwing and Combat.heavySwing() then return true end
        if stalled and os.clock() >= doorCastAt then
            local ok, list = Combat.skills()
            for _, skill in ipairs(ok and list or {}) do
                if type(skill.name) == "string" and skill.name ~= "" and Combat.skillReady(skill.slot) then
                    local aim = from + ahead * 6
                    if Combat.useSkill(skill.slot, aim) then
                        local hold = SKILL_HOLD[skill.name] or 0.15
                        doorCastAt = os.clock() + hold + 1.2
                        local slot = skill.slot
                        task.delay(hold, function() Combat.releaseSkill(slot, aim) end) -- leak:allow a one-shot key release that neither loops nor waits again
                        return true
                    end
                end
            end
        end
        Combat.lightSwing()
        return true
    end

    -- live 2026-11-18: cars 8-9 (The Grateful Dead) age you; Status_AgingStacks reached 42 and our damage fell to ~0.3/s against Prosciutto.
    -- "Take ice" (car 8's fridge room, car 9's EngineIceCooler) stops the mist for 60 s, so past a few stacks the fight pauses for ice
    -- live 2026-11-18: an ice trip at 8 stacks (91 studs, a held prompt) got us killed with prosciutto at 48 hp; ice waits for real slowdown
    local AGING_STACKS = 30
    local ICE_RADIUS = 300
    local ENTER_EVERY = 3
    local ENTER_LEAD = 3
    local iceAt, enterAt = 0, 0
    local ICE_COOLDOWN = 10.5
    -- 150 kills; past this the room's ice is worth the trip
    local ROOM_ICE_STACKS = 60
    local GIVE_RADIUS = 2000
    local GIVE_KEEP_STACKS = 90
    -- live 2026-11-18: the line stays up as "0 old passengers need ice" once all are iced, and matching the words alone sent us back for ice at 0 aging
    local function iceBonus(st)
        local waiting = tonumber(string.match(string.lower(tostring(st.Progress or "")), "(%d+) old passengers? needs? ice"))
        return waiting ~= nil and waiting > 0
    end
    local function givePrompt(from)
        local gameRoot = env.Services.Workspace:FindFirstChild("Game")
        local folder = gameRoot and gameRoot:FindFirstChild("Players")
        if not folder then return nil end
        local ok, list = World.prompts({ root = folder, near = from, radius = GIVE_RADIUS })
        local best, bestDistance = nil, math.huge
        for _, p in ipairs(ok and list or {}) do
            if p.position and string.lower(tostring(p.action)) == "give ice" and triesOf(p) < 3 then
                local d = (p.position - from).Magnitude
                if d < bestDistance then best, bestDistance = p, d end
            end
        end
        return best, bestDistance
    end
    local function iceWanted(st)
        local char = References.character
        local stacks = char and tonumber(char:GetAttribute("Status_AgingStacks")) or 0
        -- live 2026-11-18: a guessed 50 s ice window let aging climb to 52+ before the next ice; ice puts an IcePack model on the character
        -- (seen 75 s apart), so it's iced while that's there and needs ice again as soon as it's gone and stacks build
        if char and char:FindFirstChild("IcePack") then return false end
        -- a boss nearly down is finished first; leaving it for ice cost the life that would have won it
        if stacks < ROOM_ICE_STACKS + 40 then
            for _, entry in ipairs(enemies(st, ENEMY_RADIUS)) do
                if entry.boss and (tonumber(entry.ratio) or 1) < 0.25 then return false end
            end
        end
        -- live 2026-11-18: wanting ice for the whole mist objective kept us hiding in coco jumbo's room, where the mist timer stalls; only real aging wants ice,
        -- or an old passenger still waiting for some (the x1.5 bonus)
        return stacks >= AGING_STACKS or iceBonus(st), stacks
    end

    local function nearestPrompt(roots, from, match)
        local best, bestDistance = nil, math.huge
        for _, root in ipairs(roots) do
            local ok, list = World.prompts({ root = root, near = from, radius = ICE_RADIUS * 20 })
            for _, p in ipairs(ok and list or {}) do
                if p.position and match(string.lower(tostring(p.action))) then
                    local d = (p.position - from).Magnitude
                    if d < bestDistance then best, bestDistance = p, d end
                end
            end
        end
        return best, bestDistance
    end

    local function press(p, distance)
        if distance > (p.maxDistance or 8) - 1 then World.travelTo(p.position, { token = env.token() }) end
        local ok, err = World.firePrompt(p.prompt)
        if not ok then Log.dev("AutoRaid", "ice step refused: %s", tostring(err)) end
        return ok
    end

    -- live 2026-11-18: car 9 "Survive the mist" kills at 150 aging stacks and its ice is in coco jumbo's room cars back; the train's own cooler is used when
    -- there is one, else coco jumbo is entered through his prompt (a room is never travelled into), the room's fridge taken and the room left by its door
    local function stepIce(st)
        local want, stacks = iceWanted(st)
        if not want then return false end
        local char = References.character
        local inRoom = char and char:GetAttribute("InRoom") == true
        local root, map = raidRoot(st)
        local from = myPosition()
        if not (root and from) then return false end
        local isIce = function(a) return a == "take ice" end
        local room = inRoom and map:FindFirstChild(tostring(char:GetAttribute("PresidentRoom"))) or nil
        local p, d = nearestPrompt({ room or root }, from, isIce)
        local enter = nil
        if not p and not inRoom then
            -- live 2026-11-18: a trip into coco jumbo's room at 8 stacks cost minutes mid-door; the room is only worth it for the mist car or real danger
            local objective = string.lower(tostring(st.Objective or ""))
            if not (string.find(objective, "mist", 1, true) or (stacks or 0) >= ROOM_ICE_STACKS) then return false end
            enter = nearestPrompt({ root }, from, function(a) return string.find(a, "enter", 1, true) == 1 end)
            if not enter then return false end
        end
        if not (p or enter) then return false end
        local t = os.clock()
        if p then
            -- live 2026-11-18 (user): ice has a 10 s cooldown, so only the first press lands; a press counts as taken and nothing presses ice again until it's over.
            -- inside the room we wait it out (the mist is paused there); at the train's cooler the fight goes on meanwhile
            if t < iceAt then return inRoom end
            iceAt = t + ICE_COOLDOWN
            stopFight()
            env.say(label(st, ("Getting ice (%d aging)"):format(stacks or 0)))
            press(p, d)
            return true
        end
        -- live 2026-11-18: one throttle for entering and taking held the fridge press 8 s after every entry (29 s between the passengers' ice);
        -- coco jumbo is entered once the fridge is nearly ready, and re-pressed only after the enter's own hold and teleport
        if t < enterAt or t < iceAt - ENTER_LEAD then return false end
        enterAt = t + ENTER_EVERY
        stopFight()
        env.say(label(st, ("Getting ice (%d aging)"):format(stacks or 0)))
        press(enter, (enter.position - from).Magnitude)
        return true
    end

    -- live 2026-11-18: the mist car's bonus ("4 old passengers need ice (all iced: x1.5 rewards)") is a Give ice prompt (GiveIce, 8 studs, 0.5 s hold)
    -- on each old passenger in Game.Players; it hands over the ice we carry, so ice is fetched for them too and delivered before the fight
    local function stepGiveIce(st)
        if not iceBonus(st) then return false end
        local char = References.character
        if not (char and char:FindFirstChild("IcePack")) or char:GetAttribute("InRoom") == true then return false end
        -- deep in the aging ourselves, the ice is kept
        if (tonumber(char:GetAttribute("Status_AgingStacks")) or 0) >= GIVE_KEEP_STACKS then return false end
        local from = myPosition()
        if not from then return false end
        local p, d = givePrompt(from)
        if not p then
            -- live 2026-11-18: the passengers' prompts stream out from coco jumbo's car, 4 cars back; the ice is carried back to the mist car first
            local car = carModel(st, st.Car)
            if not car or insideCar(car, from) then return false end
            env.say(label(st, "Taking the ice back"))
            World.travelTo(car:GetBoundingBox().Position, { token = env.token() })
            return true
        end
        countTry(p)
        stopFight()
        env.say(label(st, "Giving ice to a passenger"))
        press(p, d)
        return true
    end

    -- live 2026-11-18: runs reached the last car in 15-20 of their 45 minutes but lost every life on the way (pesci, the roof fight);
    -- between cars, with nothing hostile left, the run catches its breath before walking into the next fight
    local REST_BELOW = 0.75
    local REST_MAX = 40
    local restSince = nil
    local function stepRest(st)
        local objective = string.lower(tostring(st.Objective or ""))
        if not string.find(objective, "enter", 1, true) then
            restSince = nil
            return false
        end
        local hum = References.humanoid
        if not (hum and hum.Parent and hum.MaxHealth > 0) then return false end
        local ratio = hum.Health / hum.MaxHealth
        if ratio >= REST_BELOW then
            restSince = nil
            return false
        end
        if #enemies(st, ENEMY_RADIUS) > 0 then return false end
        restSince = restSince or os.clock()
        if os.clock() - restSince > REST_MAX then return false end
        env.say(label(st, ("Resting (%d%% health)"):format(math.floor(ratio * 100))))
        return true
    end

    -- live 2026-11-18: we came back out of coco jumbo's room still flagged InRoom (PresidentRoom set) and every hit on the train was ignored for minutes,
    -- prosciutto included; while the character says it's in a room and the objective isn't a room step, the room's own Leave prompt comes first
    -- live 2026-11-18: the mist car reads "Survive the mist | Ice: Coco Jumbo, one car back", so a bare "ice" kept us flagged in the room
    local ROOM_WORDS = { "take ice", "fridge", "leave coco", "enter coco" }
    local leaveAt = 0
    local function stepLeaveRoom(st)
        local char = References.character
        if not (char and char:GetAttribute("InRoom") == true) or os.clock() < leaveAt then return false end
        if iceWanted(st) then return false end
        local objective = string.lower(tostring(st.Objective or ""))
        for _, word in ipairs(ROOM_WORDS) do
            if string.find(objective, word, 1, true) then return false end
        end
        local roomName = char:GetAttribute("PresidentRoom")
        local _, map = raidRoot(st)
        local room = map and type(roomName) == "string" and map:FindFirstChild(roomName)
        if not room then return false end
        local from = myPosition()
        local best, bestDistance = nil, math.huge
        local ok, list = World.prompts({ root = room, near = from, radius = 1e6 })
        for _, p in ipairs(ok and list or {}) do
            if string.lower(tostring(p.action)) == "leave" and p.position then
                local d = (p.position - from).Magnitude
                if d < bestDistance then best, bestDistance = p, d end
            end
        end
        if not best then return false end
        leaveAt = os.clock() + 3
        stopFight()
        env.say(label(st, "Leaving Coco Jumbo"))
        -- live 2026-11-18: flagged in the room while standing on the train; walking to its door means travelling into the pocket (the endless streaming screen),
        -- and the game takes the door's press from where you stand
        if not insideRoom(room, from) then
            if not Executor.call("fireproximityprompt", best.prompt) then World.firePrompt(best.prompt) end
            return true
        end
        if bestDistance > (best.maxDistance or 8) - 1 then World.travelTo(best.position, { token = env.token() }) end
        World.firePrompt(best.prompt)
        return true
    end

    -- live 2026-11-18: signal posts and gantries sweep the roof (State.RoofHazards; TrainRaidClient.lua:5880-6021): x = StartX - (now - StartsAt) * Speed,
    -- a Side post fills Z +- Span/2 from Bottom up Height, a Low gantry spans the roof low down, an Overhead one sits above a standing player
    local HAZARD_WARN = 1.2
    local JUMP_LEAD = 0.18
    local SIDE_CLEAR = 7
    local jumpsPlanned = {}
    local function jump()
        local hum = References.humanoid
        if hum and hum.Parent and hum.Health > 0 then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
    local function stepHazards(st)
        local list = st.RoofHazards
        local root = References.humanoidRootPart
        if type(list) ~= "table" or not (root and root.Parent) then return false end
        local pos = root.Position
        local now = env.Services.Workspace:GetServerTimeNow()
        for _, h in ipairs(list) do
            local speed, start, startsAt = tonumber(h.Speed), tonumber(h.StartX), tonumber(h.StartsAt)
            if speed and speed > 0 and start and startsAt then
                local x = start - math.max(0, now - startsAt) * speed
                local eta = (x - pos.X) / speed
                local bottom = tonumber(h.Bottom) or 0
                local height = tonumber(h.Height) or tonumber(h.Thickness) or 2
                local level = bottom < pos.Y + 2.5 and bottom + height > pos.Y - 3
                if level and eta > -0.2 and eta < HAZARD_WARN then
                    if h.Kind == "Side" then
                        local z, span = tonumber(h.Z) or 0, tonumber(h.Span) or 0
                        if math.abs(pos.Z - z) < span / 2 + 2 then
                            local center = tonumber(h.CenterZ) or 0
                            local away = (z <= center) and 1 or -1
                            stopFight()
                            env.say(label(st, "Dodging a signal post"))
                            World.travelTo(Vector3.new(pos.X, pos.Y, center + away * SIDE_CLEAR), { token = env.token(), offset = 0 })
                            return true
                        end
                    elseif h.Kind == "Low" then
                        local key = tostring(h.Id) .. "|" .. tostring(startsAt)
                        if not jumpsPlanned[key] then
                            jumpsPlanned[key] = true
                            local wait = math.max(0, eta - JUMP_LEAD)
                            Jobs.delay(wait, jump, { name = "AutoRaid roof jump" })
                        end
                    end
                end
            end
        end
        return false
    end

    -- live 2026-11-18: car 5's "Find the door key" is lockpicking compartments, so a key objective plays the lock too
    local LOCK_WORDS = { "lock", "key", "compartment" }
    local function lockObjective(st)
        local objective = string.lower(tostring(st.Objective or ""))
        for _, word in ipairs(LOCK_WORDS) do
            if string.find(objective, word, 1, true) then return true end
        end
        return false
    end

    -- live 2026-11-18: knockback threw us off the side of the train mid-fight and the fall killed us; outside every car's box (and not in a pocket room)
    -- the fight stops and we're put back in the current car before the drop finishes
    -- live 2026-11-18: a car's box reaches 17 studs under its centre (wheels), and standing in it puts the root 3 under; the ground beside the track sits
    -- above the box bottom, so "under the box" never fired and two of four lives went to falls. a drop this far under where we last stood in a car is a fall
    local OFF_BELOW = 5
    local STAND_Y = -3
    local standY = STAND_Y
    -- off the train = alongside a car (within its length) and well under the floor we stand on; past the ends is the gangways and doors, never a fall
    local function offTrain(root, from)
        for _, child in ipairs(root:GetChildren()) do
            if child:IsA("Model") and child:GetAttribute("TrainRaidCar") ~= nil then
                local ok, cf, size = pcall(function() return child:GetBoundingBox() end)
                if ok and cf then
                    local p = cf:PointToObjectSpace(from)
                    if math.abs(p.X) <= size.X / 2 then
                        -- inside the car's width at floor height: remember the floor (never the roof)
                        if math.abs(p.Z) < size.Z / 2 - 2 and p.Y < 2 and p.Y > STAND_Y - 3 then standY = math.min(STAND_Y, p.Y) end
                        return p.Y < standY - OFF_BELOW
                    end
                end
            end
        end
        return false
    end
    local function stepRecover(st)
        local char = References.character
        if char and char:GetAttribute("InRoom") == true then return false end
        local root, map = raidRoot(st)
        local from = myPosition()
        if not (root and from) then return false end
        if not offTrain(root, from) then return false end
        local car = carModel(st, st.Car)
        if not car then return false end
        stopFight()
        env.say(label(st, "Back onto the train"))
        local cf = car:GetBoundingBox()
        World.travelTo(cf.Position, { token = env.token() })
        return true
    end

    -- yields until the raid ends; (cleared, line)
    local highway = nil
    local function stepHighway(st)
        highway = highway or Highway.new({
            World = World, References = References, Services = env.Services, token = env.token, myPosition = myPosition,
            say = function(text) env.say(label(st, text)) end,
        })
        return highway.step(st)
    end
    local function stopHighway()
        if highway then highway.stop() end
    end

    function R.loop(j)
        local started = os.clock()
        local idleSince, lastAdvance = nil, -math.huge
        local picking = false
        local resultAt = nil
        while j.alive do
            local st = state()
            if not Plan.inRaid(st) then break end
            objectiveNow = st.Objective
            if result then
                stopFight()
                resultAt = resultAt or os.clock()
                if os.clock() - resultAt >= RESULTS_GRACE then break end
                env.wait(result.Cleared == true and "Raid cleared" or "Raid failed")
            elseif os.clock() - started >= RUN_TIMEOUT then
                stopFight()
                stopHighway()
                return false, "Raid took too long"
            else
                handleQueue()
                stepLatch()
                if stepPurse() then
                    env.say("Searching the purse")
                elseif spectating(st) then
                    stopFight()
                    env.wait("Out, spectating")
                elseif not env.alive() then
                    noteDeath()
                    env.wait("Waiting to respawn")
                elseif lockObjective(st) and lockpicker.tick() then
                    picking = true
                    env.say(label(st, "Picking the lock"))
                else
                    -- the train's cars hold the fight in (Highway Star's stages aren't cars, so none is set there)
                    confineCar = carModel(st, st.Car)
                    confineEdges = st.Raid == "Rings"
                    local acted = stepHighway(st) or stepRecover(st) or stepAvoid(st) or stepHazards(st) or stepLeaveRoom(st) or stepGiveIce(st) or stepIce(st) or stepWarm(st) or stepFight(st) or stepSpareRings(st) or stepRingsBridge(st, j) or stepRingsBoss(st) or stepRingsArea(st, j) or stepRest(st) or stepSpy(st) or stepDoor(st) or stepRoof(st) or stepPrompts(st, PROMPT_RADIUS)
                    if acted then
                        idleSince = nil
                    else
                        idleSince = idleSince or os.clock()
                        local t = os.clock()
                        if t - idleSince >= ADVANCE_AFTER and t - lastAdvance >= ADVANCE_EVERY then
                            lastAdvance = t
                            if not (advance(st) or enterCar(st) or stepPrompts(st, FAR_RADIUS)) then
                                env.wait(label(st, "Waiting for the next " .. string.lower((Plan.RAIDS[st.Raid] or Plan.RAIDS.Train).unit)))
                            end
                        else
                            env.say(label(st, type(st.Objective) == "string" and st.Objective ~= "" and st.Objective or "Looking for enemies"))
                        end
                    end
                end
            end
            local pause = picking and LOCK_TICK or TICK
            picking = false
            if not j:sleep(pause) then
                stopFight()
                stopHighway()
                return false, nil
            end
        end
        stopFight()
        stopHighway()
        if result then return result.Cleared == true, result.Cleared == true and "Raid cleared" or "Raid failed" end
        return false, "Raid ended"
    end

    function R.stop()
        stopFight()
        stopHighway()
        stopStruggle()
    end

    return R
end

return Run

end)
