local M = {}

M.SLOTS = { "Jacket", "Pants", "Accessory1", "Accessory2", "Accessory3", "Accessory4" }
M.ACCESSORY_SLOTS = { "Accessory1", "Accessory2", "Accessory3", "Accessory4" }
M.STAT_KEYS = { "Ability", "Strength", "Health" }

-- recon/damage.md 1.4-1.5: magician's red skills scale ~90% on Ability, Barrage 80% on Strength, Health is max health
M.STAT_WEIGHTS = { Ability = 1, Strength = 0.6, Health = 0.4 }
-- per 1.0 of the passive (ACC:90-122 descriptions); anything unlisted is worth nothing to a fight
M.PASSIVE_WEIGHTS = {
    Guard = 120,              -- ordinary combat damage taken, cap 10%
    DamageResistance = 120,   -- all damage taken, cap 30%
    ParryWindow = 40,
    EXGain = 40,
    FireResistance = 30,
    WalkSpeed = 20,
    FateFury = 20,
    Recovery = 10,
    FatedDodge = 3,
    KeeperInstinct = 3,
    BountyTarget = -2,
    CrimsonMark = -20,
}

local EPSILON = 1e-6

local function num(v)
    return type(v) == "number" and v == v and math.abs(v) < math.huge and v or 0
end

local function clamp(v, cap)
    v = num(v)
    if type(cap) ~= "number" then return v end
    return math.max(-cap, math.min(cap, v))
end

local function key(piece)
    return piece.name .. "\0" .. tostring(piece.id)
end
M.key = key

-- pieces is a list of {name, id, kind, stats, passives}; jacket/pants are only those in their own slot so a set needs both
function M.aggregate(loadout, sets, caps)
    caps = caps or {}
    local totals, seen = {}, {}
    local function add(stats, passives)
        for k, v in pairs(stats or {}) do totals[k] = (totals[k] or 0) + clamp(v, caps[k]) end
        for k, v in pairs(passives or {}) do totals[k] = (totals[k] or 0) + clamp(v, caps[k]) end
    end
    for _, slot in ipairs(M.SLOTS) do
