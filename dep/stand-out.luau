        return Net.fire("BagsGrooveMinigame", "Open")
    end

    -- BagsGrooveMinigame.Controller.lua:310-323: an uncleared unit 1..5, once until the server answers
    local function bagsClick(i)
        if type(i) ~= "number" or i % 1 ~= 0 or i < 1 or i > 5 then return false, Errors.BAD_ARGS end
        if not bags.open then return false, Errors.NO_SESSION end
        if bags.cleared[i] then return false, Errors.ALREADY_DONE end
        if bags.pending[i] then return false, Errors.BUSY end
        bags.pending[i] = true
        return Net.fire("BagsGrooveMinigame", "Click", i)
    end

    local knock

    -- DialogueHandler.lua:1195-1197: only a well-formed knock aimed at this character
    S.push("FoodSafety", "Knock", function(payload)
        if type(payload) ~= "table" or type(payload.Token) ~= "string" or type(payload.Message) ~= "string"
            or type(payload.Allow) ~= "string" or type(payload.Refuse) ~= "string"
            or typeof(payload.Actor) ~= "Instance" or type(payload.ExpiresAt) ~= "number" then
            return
        end
        local char = payload.Character
        local player = References.player
        if typeof(char) ~= "Instance" or not player or char.Name ~= player.Name then return end
        knock = { token = payload.Token, payload = payload, answered = false }
        emit("FoodSafety", "Knock", payload)
    end)

    local function foodSafety()
