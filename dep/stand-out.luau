return function(ctx, shared)
    local Services    = ctx.Services
    local References  = ctx.References
    local Workspace   = Services.Workspace
    local Pathfinding = Services.PathfindingService
    local base        = shared.base
    local Errors      = shared.Errors

    local claimed = nil
    local active = nil
    local claimSeq = 0
    local warnedCollide = false

    local function authorize(token)
        if claimed then
            if token ~= claimed.token then return false, Errors.NOT_OWNER end
        elseif token ~= nil then
            return false, Errors.NOT_OWNER
        end
        return true
    end

    local function runCleanup(trip)
        local list = trip.cleanup
        for i = #list, 1, -1 do
