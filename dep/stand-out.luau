return function(S, api)
    local Errors = S.Errors
    local base = S.base
    local Jobs = S.Jobs
    local Workspace = S.Services.Workspace
    local CollectionService = S.Services.CollectionService

    -- returnDirection (PlayerController.lua:2793-2809): the dash sends this vector, not the name
    local DASH_DIRS = {
        Front = Vector3.new(0, 0, -1), Back = Vector3.new(0, 0, 1),
        Left = Vector3.new(-1, 0, 0), Right = Vector3.new(1, 0, 0),
    }

    local function method(mod, name, ...)
        local fn = mod and mod[name]
        if type(fn) ~= "function" then return false end
        local result = table.pack(S.game(fn, mod, ...))
        if not result[1] then
            base.warn("%s failed: %s", name, tostring(result[2]))
            return false
        end
        return true, table.unpack(result, 2, result.n)
    end

    -- everything a melee plan reads, fresh per call
    local function context()
        if not S.hasNet then return nil, Errors.NO_NET end
        if not S.ready() then return nil, Errors.NOT_READY end
        local char = S.character()
        if not char then return nil, Errors.NO_CHARACTER end
        if not S.alive(char) then return nil, Errors.DEAD end
        local root, hum = S.root(char), S.humanoid(char)
        if not (root and hum) then return nil, Errors.NO_CHARACTER end
        local Weapons, Stands, Utility, Skills = S.mod("Weapons"), S.mod("Stands"), S.mod("Utility"), S.mod("Skills")
        if not (Weapons and Stands and Utility and Skills) then return nil, Errors.NO_PROFILE end
        local def = S.standDef(char)
        local model = S.standModel()
        local summoned = char:GetAttribute("Summoned") == true
        local standAway = char:GetAttribute("StandAway") == true
        return {
            char = char, root = root, hum = hum, data = S.Player.node(""),
            Weapons = Weapons, Stands = Stands, Utility = Utility, Skills = Skills,
            standName = S.standName(), def = def, model = model, summoned = summoned, standAway = standAway,
            -- loadCombatValues (PlayerController.lua:4058): the stand swings when it's out, owns M1s and isn't mid-skill
