        local model = D.npc(name)
        if not model then
            local spot = targetOf(e)
            if not spot then return false, "lost" end
            local ok, err = D.goTo(spot, D.sanitize(name))
            if not ok then return false, err end
            model = D.waitFor(function() return D.npc(name) end, STREAM_WAIT)
            if not model then return false, "missing" end
        end
