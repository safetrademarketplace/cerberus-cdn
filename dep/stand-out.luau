                if not j:sleep(1) then return end
            else
                fails = fails + 1
                dismissDialog()
                Log.devwarn("StandRoller", "roll failed: %s", tostring(result))
                if fails >= FAIL_TRIES then return finish("Rolling stopped working") end
                if not j:sleep(3) then return end
            end
        end
    end

    local function stop()
        enabled = false
        if job then job:Cancel() end
        job = nil
        Status.clear(OWNER)
    end

    local box = ctx.Tabs.GameCharacter:AddLeftGroupbox("Stand Roller", "dices")
    box:AddToggle("StandRoller_Enabled", {
        Text     = "Auto Roll Stand",
        Premium  = true,
        Default  = false,
        Tooltip  = "Uses your arrows until you get a pick",
        Callback = function(on)
            if not on then
                stop()
                return
            end
            if enabled or finishing then return end
            local s, r = picks()
            if count(s) + count(r) == 0 then
                UiWrite.notify(Library, "Pick a stand or rarity first.", 4)
                finish(nil)
                return
            end
            enabled = true
            job = O.track(Jobs.spawn(function(j)
                local ok, err = pcall(loop, j)
                if not ok then
                    Log.devwarn("StandRoller", "loop failed: %s", tostring(err))
                    finish("Rolling stopped working")
                end
            end, { name = "StandRoller" }))
        end,
    })
    box:AddDropdown("StandRoller_Arrow", { Text = "Arrow", Values = arrowNames, Default = "Mysterious Arrow" })
    box:AddDropdown("StandRoller_Stands", { Text = "Stop On Stand", Values = catalog.stands, Default = {}, Multi = true })
    box:AddDropdown("StandRoller_Rarities", { Text = "Stop On Rarity", Values = catalog.rarities, Default = {}, Multi = true })
    box:AddSlider("StandRoller_Max", { Text = "Max Arrows", Default = 5, Min = 1, Max = 100, Rounding = 0 })
    -- a saved config must never start spending arrows at load; only a click does
    local saves = ctx.SaveManager
    if saves and saves.SetIgnoreIndexes then
        local ok, err = pcall(saves.SetIgnoreIndexes, saves, { "StandRoller_Enabled" })
        if not ok then Log.devwarn("StandRoller", "couldn't keep the toggle out of configs: %s", tostring(err)) end
    end

    O.onUnload(stop)
    O.finalize()
end

return M

end)
__bundle_register("Utility/Mount", function(require, _LOADED, __bundle_register, __bundle_modules)
-- shared orchestrator scaffolding (maid + tracked conns + subCtx + Unloader register) for feature init.lua files
local Identity = require("Utility/Identity")
local Log      = require("Utility/Log")

local M = {}

local function resolveNewMaid(ctx)
    if type(ctx.NewMaid) == "function" then return ctx.NewMaid end
    if ctx.Maid and type(ctx.Maid.new) == "function" then
        return function() return ctx.Maid.new() end
    end
    return nil
end

function M.orchestrator(ctx, name)
    -- the feature mounted before this one may have called into the game and dropped the identity its Add* calls need
    Identity.elevate()
    local newMaid = resolveNewMaid(ctx)
    if not newMaid then
        Log.warn(("[%s] Missing ctx.NewMaid; module will not initialize."):format(name or "Mount"))
        return nil
    end

    local moduleMaid = newMaid()
    local tracked = {}
    local teardown = {}
    local registered = false
    local cleaned = false

    local function cleanup()
        -- exposed on the orchestrator and registered with the Unloader, guarded so a direct call followed by unload can't run every teardown twice
        if cleaned then return end
        cleaned = true
        -- disconnect before teardown so watchers can't race state-restore
        for conn in pairs(tracked) do
            local okDc, errDc = pcall(function()
                if conn and conn.Disconnect then conn:Disconnect() end
            end)
            if not okDc then
                Log.warn(("[%s] Mount: tracked disconnect failed: %s"):format(name or "Mount", tostring(errDc)))
            end
            tracked[conn] = nil
        end
        local okMaid, errMaid = pcall(function() moduleMaid:DoCleaning() end)
        if not okMaid then
            Log.warn(("[%s] Mount: maid cleanup failed: %s"):format(name or "Mount", tostring(errMaid)))
        end
        for i = #teardown, 1, -1 do
            local okTd, errTd = pcall(teardown[i])
            if not okTd then
                Log.warn(("[%s] Mount: teardown[%d] failed: %s"):format(name or "Mount", i, tostring(errTd)))
            end
        end
    end

    -- registers cleanup with the Unloader on first tracked resource, so a mid-body error can't orphan connections
    local function ensureRegistered()
        if registered then return end
        registered = true
        if ctx.Unloader and ctx.Unloader.Register then
            ctx.Unloader:Register(cleanup)
        end
    end

    local function track(conn)
        if conn then
            tracked[conn] = true
            ensureRegistered()
        end
        return conn
    end

    local function subCtx(extras)
        local lib = ctx.Library
        local base = {
            -- forwarded like everything else: a feature reading ctx.Api on a sub-ctx that dropped it silently renders nothing
            Api        = ctx.Api,
            Services   = ctx.Services,
            Tabs       = ctx.Tabs,
            References = ctx.References,
            Library    = lib,
            Options    = ctx.Options or (lib and lib.Options),
            Toggles    = ctx.Toggles or (lib and lib.Toggles),
            Window     = ctx.Window,
            Helpers    = ctx.Helpers,
            Maid       = ctx.Maid,
            NewMaid    = ctx.NewMaid,
            track      = track,
        }
        if type(extras) == "table" then
            for k, v in pairs(extras) do base[k] = v end
        end
        return base
    end

    local function onUnload(fn)
        if type(fn) == "function" then
            teardown[#teardown + 1] = fn
            ensureRegistered()
        end
    end

    -- pcall'd factory: an erroring sub-module can't short-circuit the orchestrator or orphan earlier mounts
    local function mount(factory, factoryCtx)
        ensureRegistered()
        local ok, apiOrErr = pcall(factory, factoryCtx or subCtx())
        if not ok then
            Log.warn(("[%s] Mount: sub-module factory errored: %s"):format(
                name or "Mount", tostring(apiOrErr)))
            return {}
        end
        local api = apiOrErr
        if type(api) == "table" then
            if type(api.cleanup) == "function" then onUnload(api.cleanup) end
            if type(api.destroy) == "function" then onUnload(api.destroy) end
        end
        return api or {}
    end

    -- idempotent, kept for backward compat; track/onUnload/mount auto-finalize on first use
    local finalize = ensureRegistered

    return {
        maid     = moduleMaid,
        track    = track,
        subCtx   = subCtx,
        mount    = mount,
        onUnload = onUnload,
        cleanup  = cleanup,
        finalize = finalize,
    }
end

return M

end)
__bundle_register("Features/Utilities/Rewards", function(require, _LOADED, __bundle_register, __bundle_modules)
-- rewards: while on, claims every gift in your phone's gift inbox and any community reward card you qualify for; also redeems a typed code. every call is the game's own Gifts / CommunityRewards request through Activities
local Jobs    = require("Utility/Jobs")
local Log     = require("Utility/Log")
local Mount   = require("Utility/Mount")
local UiWrite = require("Utility/UiWrite")

local TICK = 5
local COMMUNITY_EVERY = 300
-- a gift or card the server turned down is left alone this long before it is asked again
local RETRY_AFTER = 300
-- CommunityShopClient.lua:125-140, ShopProducts.lua:178
local CARDS = { "Favorite", "Group", "Invite" }
local CARD_TEXT = { Favorite = "favorite", Group = "group", Invite = "invite" }

local M = {}

-- server text for a notification: rich text tags stripped
function M.clean(text)
    return (tostring(text or ""):gsub("[<>]", ""))
end

-- inbox entries worth a claim now: an Id, and not turned down in the last RETRY_AFTER seconds (Gifts.lua:25-50 entry shape)
function M.claimable(entries, failedAt, now)
    local out = {}
    for _, entry in ipairs(type(entries) == "table" and entries or {}) do
        if type(entry) == "table" and entry.Id ~= nil then
            local at = failedAt[entry.Id]
            if not at or now - at >= RETRY_AFTER then out[#out + 1] = entry end
        end
    end
    return out
end

-- cards the Status answer says you can claim: { Ok, Rewards = { Group = { Eligible, Disabled, Claimed } } } (live 2026-11-17)
function M.eligibleCards(status, failedAt, now)
    local out = {}
    local rewards = type(status) == "table" and status.Ok == true and status.Rewards
    if type(rewards) ~= "table" then return out end
    for _, kind in ipairs(CARDS) do
        local card = rewards[kind]
        local at = failedAt[kind]
        if type(card) == "table" and card.Eligible == true and card.Claimed ~= true and card.Disabled ~= true
            and (not at or now - at >= RETRY_AFTER) then
            out[#out + 1] = kind
        end
    end
    return out
end

function M.mount(ctx)
    local O = Mount.orchestrator(ctx, "Rewards")
    if not O then return end
    local Activities = ctx.Api and ctx.Api.Activities
    if not Activities then
        Log.devwarn("Rewards", "activities api missing; rewards won't load")
        return
    end
    local Options, Library = ctx.Options, ctx.Library

    local enabled, job = false, nil
    local redeeming = false
    local failedAt = {}
    local communityAt = nil

    local function notify(text)
        UiWrite.notify(Library, text, 5)
    end

    local function claimGifts(j)
        local ok, inbox = Activities.giftInbox()
        if not ok then return end
        for _, entry in ipairs(M.claimable(inbox.entries, failedAt, os.clock())) do
            if not (j.alive and enabled) then return end
            local claimed, err, message = Activities.claimGift(entry.Id)
            if claimed then
                notify("Claimed " .. M.clean(entry.Title or "a gift"))
            else
                failedAt[entry.Id] = os.clock()
                Log.devwarn("Rewards", "gift %s not claimed: %s %s", tostring(entry.Id), tostring(err), tostring(message))
            end
        end
    end

    local function claimCards(j)
        if communityAt and os.clock() - communityAt < COMMUNITY_EVERY then return end
        communityAt = os.clock()
        local ok, status = Activities.communityRewards()
        if not ok then return end
        for _, kind in ipairs(M.eligibleCards(status, failedAt, os.clock())) do
            if not (j.alive and enabled) then return end
            local claimed, err, code = Activities.claimCommunity(kind)
            if claimed then
                notify("Claimed the " .. CARD_TEXT[kind] .. " reward")
            else
                failedAt[kind] = os.clock()
                Log.devwarn("Rewards", "%s card not claimed: %s %s", kind, tostring(err), tostring(code))
            end
        end
    end

    local function loop(j)
        while j.alive and enabled do
            local ok, err = pcall(claimGifts, j)
            if not ok then Log.devwarn("Rewards", "gift pass failed: %s", tostring(err)) end
            ok, err = pcall(claimCards, j)
            if not ok then Log.devwarn("Rewards", "community pass failed: %s", tostring(err)) end
            if not j:sleep(TICK) then return end
        end
    end

    local function stop()
        enabled = false
        if job then job:Cancel() end
        job = nil
    end

    -- GiftsApp.lua:504-515: the game's own redeem, the answer is the server's message
    local function redeem()
        if redeeming then return end
        local element = Options.Rewards_Code
        local code = element and element.Value
        if type(code) ~= "string" or code:gsub("%s", "") == "" then
            notify("Type a code first.")
            return
        end
        redeeming = true
        O.track(Jobs.spawn(function()
            local ok, result, message = Activities.redeemCode(code)
            redeeming = false
            if ok then
                notify(M.clean(result.message ~= "" and result.message or "Code redeemed!"))
            elseif type(message) == "string" and message ~= "" then
                notify(M.clean(message))
            else
                Log.devwarn("Rewards", "redeem failed: %s", tostring(result))
                notify("Couldn't redeem that code.")
            end
        end, { name = "Rewards redeem" }))
    end

    local box = ctx.Tabs.GameExtras:AddLeftGroupbox("Rewards", "gift")
    box:AddToggle("Rewards_AutoClaim", {
        Text     = "Auto Claim Rewards",
        Default  = false,
        Tooltip  = "Gifts and community rewards",
        Callback = function(on)
            if on then
                if enabled then return end
                enabled = true
                communityAt = nil
                job = O.track(Jobs.spawn(loop, { name = "Rewards" }))
            else
                stop()
            end
        end,
    })
    local codes = ctx.Tabs.GameExtras:AddLeftGroupbox("Codes", "ticket")
    codes:AddInput("Rewards_Code", { Text = "Code", Placeholder = "Type a code", ClearTextOnFocus = false })
    codes:AddButton({ Text = "Redeem Code", Func = redeem })

    O.onUnload(stop)
    O.finalize()
end

return M

end)
__bundle_register("Features/Utilities/Items", function(require, _LOADED, __bundle_register, __bundle_modules)
-- items: picks up dropped world items in reach without moving you, and says when a new one drops; each drop is workspace.Game.SpawnedItems.DroppedItem with an ItemName attribute and a 0 s WorldItemPickup prompt on its Handle (live 2026-11-17, a Mysterious Arrow at an Arrows spawn node)
local Jobs    = require("Utility/Jobs")
local Log     = require("Utility/Log")
local Mount   = require("Utility/Mount")
local UiWrite = require("Utility/UiWrite")
local FarmSettings = require("Utility/FarmSettings")

local TICK = 0.3
-- a drop is looked at only this close; the live prompt reaches 10 studs
local NEAR = 25
-- the same prompt isn't pressed again sooner than this, so a refused pickup isn't spammed
local RETRY = 3

local CHOICES = { "Arrows", "Other Items" }

local M = {}

function M.itemName(model)
    local name = model:GetAttribute("ItemName")
    if type(name) == "string" and name ~= "" then return name end
    local inner = model:FindFirstChildWhichIsA("Model")
    return inner and inner.Name or model.Name
end

function M.isArrow(name)
    return type(name) == "string" and string.find(name, "Arrow", 1, true) ~= nil
end

function M.wantAlert(name, picked)
    if M.isArrow(name) then return picked.Arrows == true end
    return picked["Other Items"] == true
end

function M.alertText(name, distance)
    if type(distance) == "number" then
        return ("%s dropped %d studs away."):format(name, math.floor(distance + 0.5))
    end
    return ("%s dropped."):format(name)
end

-- the drop's spot, or nil while none of its parts have streamed in
local function spot(model)
    local part = model:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position or nil
end

function M.mount(ctx)
    local O = Mount.orchestrator(ctx, "Items")
    if not O then return end
    local World = ctx.Api and ctx.Api.World
    if not (World and World.items and World.itemAdded and World.prompts and World.firePrompt) then
        Log.devwarn("Items", "world api missing; item tools won't load")
        return
    end
    local Player = ctx.Api.Player
    local References, Options, Library = ctx.References, ctx.Options, ctx.Library

    local alerts = false
    local job = nil
    local pressed = setmetatable({}, { __mode = "k" })
    local announced = setmetatable({}, { __mode = "k" })

    local function picked()
        local element = Options.Items_AlertFor
        local value = element and element.Value
        return type(value) == "table" and value or {}
    end

    local function rootPosition()
        local root = References.humanoidRootPart
        return root and root.Parent and root.Position or nil
    end

    -- one pickup per pass: the nearest drop whose prompt is in its own reach
    local function pass()
        local from = rootPosition()
        if not from then return end
        if Player and Player.isBusy and Player.isBusy() then return end
        local ok, list = World.items()
        if not ok then return end
        local now = os.clock()
        local best, bestDistance = nil, math.huge
        local near = FarmSettings.lootRadius(NEAR)
        for _, entry in ipairs(list) do
            local distance = (entry.position - from).Magnitude
            if not entry.putAway and distance <= near and distance < bestDistance then
                local okPrompts, prompts = World.prompts({ root = entry.model })
                local p = okPrompts and prompts[1]
                if p and p.distance and p.distance <= p.maxDistance and now - (pressed[p.prompt] or -math.huge) >= RETRY then
                    best, bestDistance = p.prompt, distance
                end
            end
        end
        if not best then return end
        pressed[best] = now
        local okFire, err = World.firePrompt(best)
        if not okFire then Log.devwarn("Items", "pickup refused: %s", tostring(err)) end
    end

    local function stopPickup()
        if job then job:Cancel() end
        job = nil
    end

    O.track(World.itemAdded:Connect(function(model)
        if not alerts or announced[model] then return end
        announced[model] = true
        local name = M.itemName(model)
        if not M.wantAlert(name, picked()) then return end
        local from, at = rootPosition(), spot(model)
        UiWrite.notify(Library, M.alertText(name, (from and at) and (at - from).Magnitude or nil), 8)
    end))

    local box = ctx.Tabs.GameCharacter:AddRightGroupbox("Items", "package")
    box:AddToggle("Items_AutoPickup", {
        Text     = "Auto Pick Up",
        Default  = false,
        Tooltip  = "Grabs dropped items when you walk past them",
        Callback = function(on)
            stopPickup()
            if on then job = O.track(Jobs.interval(TICK, pass, { name = "Items pickup" })) end
        end,
    })
    -- drop alerts sit with the event alerts on extras; auto pick up stays a character tool
    local alertBox = ctx.Tabs.GameExtras:AddRightGroupbox("Drop Alerts", "bell-ring")
    alertBox:AddToggle("Items_Alerts", {
        Text     = "Drop Alerts",
        Default  = false,
        Callback = function(on)
            alerts = on == true
            if not alerts then return end
            -- drops already lying around when you switch it on are not news
            local ok, list = World.items()
            if ok then
                for _, entry in ipairs(list) do announced[entry.model] = true end
            end
        end,
    })
    alertBox:AddDropdown("Items_AlertFor", {
        Text    = "Alert For",
        Values  = CHOICES,
        Default = { "Arrows" },
        Multi   = true,
    })

    O.onUnload(function()
        alerts = false
        stopPickup()
    end)
    O.finalize()
end

return M

end)
__bundle_register("Utility/FarmSettings", function(require, _LOADED, __bundle_register, __bundle_modules)
-- farm settings: the knobs more than one farm shares (travel, loot radius, scan speed), written by the farm control box and read by every farm; each read takes the farm's own default, so a farm works unchanged when the control box isn't mounted
local M = {}

-- scan speed multiplies each farm's own idle tick
local SCAN = { Fast = 0.5, Normal = 1, Light = 2 }

local values = {}

function M.set(key, value)
    if type(key) == "string" then values[key] = value end
end

function M.get(key, default)
    local value = values[key]
    if value == nil then return default end
    return value
end

-- how far a farm may walk before it teleports instead; 0 means always teleport
function M.walkRange(default)
    local travel = values.travel
    if travel == "Teleport" then return 0 end
    if travel == "Walk Short Trips" then return tonumber(default) or 200 end
    return tonumber(default) or 0
end

-- studs a farm looks for loot around a fight or drop
function M.lootRadius(default)
    return tonumber(values.lootRadius) or default
end

-- a farm's idle wait, scaled by the scan speed setting
function M.tick(base)
    base = tonumber(base) or 1
    return base * (SCAN[values.scan] or 1)
end

M.SCAN_CHOICES = { "Fast", "Normal", "Light" }

function M._reset()
    values = {}
end

return M

end)
__bundle_register("Features/Utilities/HurtSpeed", function(require, _LOADED, __bundle_register, __bundle_modules)
-- no hurt slowdown: undoes the game's low-health walk slow (PlayerController.lua:25976-26003, down to half speed) by scaling the character's Status_MoveSpeed, which the controller multiplies into walk and run speed and re-reads on every change (:25995, :26148-26150); server slows and the injury limp still apply
local Log   = require("Utility/Log")
local Mount = require("Utility/Mount")

local ATTR = "Status_MoveSpeed"
local EPS = 1e-4

local M = {}

-- lowHealthWalkScale (PlayerController.lua:25976-25983), rounded the same way so the product lands exactly on full speed
function M.healthScale(health, maxHealth)
    if type(health) ~= "number" or type(maxHealth) ~= "number" then return 1 end
    if health <= 0 or maxHealth <= 0 or maxHealth == math.huge then return 1 end
    local missing = math.clamp((1 - health / maxHealth) / 0.99, 0, 1)
    return math.round((1 - missing * 0.5) * 100) / 100
end

-- the attribute value to hold: the server's own value (nil = none) divided by the health slow; piloting reads it unscaled (:7495), so it gets the server's value
function M.wanted(base, scale, piloting)
    if piloting or type(scale) ~= "number" or scale <= 0 or scale >= 1 then return base end
    return (base or 1) / scale
end

local function same(a, b)
    if type(a) ~= "number" or type(b) ~= "number" then return a == b end
    return math.abs(a - b) < EPS
end

-- Utility:isActivelyPiloting (Utility.lua:6739-6748)
local function piloting(char)
    local active = char:GetAttribute("ActivePiloting")
    if type(active) == "boolean" then return active end
    return char:GetAttribute("Piloting") == true
end

function M.mount(ctx)
    local O = Mount.orchestrator(ctx, "HurtSpeed")
    if not O then return end
    local References = ctx.References

    local on = false
    local char, hum = nil, nil
    -- base: the server's value; ours: the last value this feature wrote, so a change that isn't ours is the server's
    local base, ours = nil, nil
    local conns = {}

    local function drop()
        for i = #conns, 1, -1 do
            conns[i]:Disconnect()
            conns[i] = nil
        end
    end

    local function apply()
        if not (char and char.Parent and hum and hum.Parent) then return end
        local target = base
        if on then target = M.wanted(base, M.healthScale(hum.Health, hum.MaxHealth), piloting(char)) end
        if same(char:GetAttribute(ATTR), target) then
            ours = target
            return
        end
        ours = target
        local ok, err = pcall(char.SetAttribute, char, ATTR, target)
        if not ok then Log.devwarn("HurtSpeed", "couldn't set the speed scale: %s", tostring(err)) end
    end

    local function onAttr()
        if not char then return end
        local value = char:GetAttribute(ATTR)
        if same(value, ours) then return end
        base = type(value) == "number" and value or nil
        ours = value
        apply()
    end

    local function bindHumanoid(h)
        hum = h
        conns[#conns + 1] = h.HealthChanged:Connect(apply)
        conns[#conns + 1] = h:GetPropertyChangedSignal("MaxHealth"):Connect(apply)
        apply()
    end

    local function bind(c)
        drop()
        char, hum = c, nil
        local value = c:GetAttribute(ATTR)
        base = type(value) == "number" and value or nil
        ours = value
        conns[#conns + 1] = c:GetAttributeChangedSignal(ATTR):Connect(onAttr)
        conns[#conns + 1] = c:GetAttributeChangedSignal("Piloting"):Connect(apply)
        conns[#conns + 1] = c:GetAttributeChangedSignal("ActivePiloting"):Connect(apply)
        local h = c:FindFirstChildOfClass("Humanoid")
        if h then
            bindHumanoid(h)
        else
            local waiting
            waiting = c.ChildAdded:Connect(function(child)
                if hum or not child:IsA("Humanoid") then return end
                waiting:Disconnect()
                bindHumanoid(child)
            end)
            conns[#conns + 1] = waiting
        end
    end

    local function unbind()
        drop()
        char, hum, base, ours = nil, nil, nil, nil
    end

    local unsubAdd = References.onCharacter(bind)
    local unsubRemove = References.onCharacterRemoving(unbind)

    local box = ctx.Tabs.GameCharacter:AddLeftGroupbox("Movement", "footprints")
    box:AddToggle("HurtSpeed_Enabled", {
        Text     = "No Hurt Slowdown",
        Default  = false,
        Tooltip  = "The game slows you to half speed as you lose health",
        Callback = function(value)
            on = value == true
            apply()
        end,
    })

    O.onUnload(function()
        on = false
        apply()
        unsubAdd()
        unsubRemove()
        unbind()
    end)
    O.finalize()
    -- the Movement box, shared with the other movement toggles
    return box
end

return M

end)
__bundle_register("Features/Utilities/EventAlerts", function(require, _LOADED, __bundle_register, __bundle_modules)
-- event alerts: a notification when a world event you picked starts (bosses, money transport, meteors, weather); reads the event table Activities keeps from the game's WorldEvents pushes, each event announced once
local Log     = require("Utility/Log")
local Mount   = require("Utility/Mount")
local UiWrite = require("Utility/UiWrite")

-- WorldEvents.lua (Modules):268-345 Definitions, by Id; the rain wave meteors are RainMeteor1..12 (:347-361)
local NAMES = {
    StandBoss = "Stand Boss", DIO = "DIO", MoneyTransport = "Money Transport", Meteor = "Meteor",
    LahainaNoon = "Lahaina Noon", Thunderstorm = "Thunderstorm", Fog = "Fog", Rain = "Rain",
}
local CHOICES = { "Stand Boss", "DIO", "Money Transport", "Meteor", "Lahaina Noon", "Thunderstorm", "Fog", "Rain" }
local DEFAULTS = { "Stand Boss", "DIO", "Money Transport", "Meteor" }
local MESSAGES = {
    ["Stand Boss"]      = "A Stand Boss has appeared!",
    ["DIO"]             = "DIO has appeared!",
    ["Money Transport"] = "A Money Transport is driving by!",
    ["Meteor"]          = "Meteors are falling!",
    ["Lahaina Noon"]    = "Lahaina Noon has started!",
    ["Thunderstorm"]    = "A thunderstorm started!",
    ["Fog"]             = "Fog is rolling in!",
    ["Rain"]            = "It started raining!",
}

local M = {}

-- the menu name for an event Id, or nil for one the menu doesn't offer
function M.label(id)
    if type(id) ~= "string" then return nil end
    if id:match("^RainMeteor%d+$") then return "Meteor" end
    return NAMES[id]
end

-- the text to show for an event, or nil when it shouldn't be announced (not picked, already seen, or ending)
function M.alert(ev, picked, seen)
    if type(ev) ~= "table" or type(ev.EventId) ~= "string" then return nil end
    if seen[ev.EventId] or ev.Phase == "Cleanup" then return nil end
    local label = M.label(ev.Id)
    if not (label and picked[label]) then return nil end
    return MESSAGES[label]
end

function M.mount(ctx)
    local O = Mount.orchestrator(ctx, "EventAlerts")
    if not O then return end
    local Activities = ctx.Api and ctx.Api.Activities
    if not (Activities and Activities.worldEvent) then
        Log.devwarn("EventAlerts", "activities api missing; event alerts won't load")
        return
    end
    local Options, Library = ctx.Options, ctx.Library

    local enabled = false
    local seen = {}

    local function picked()
        local element = Options.EventAlerts_Events
        local value = element and element.Value
        return type(value) == "table" and value or {}
    end

    -- events already running when you switch it on are not news
    local function markRunning()
        local ok, list = Activities.worldEvents()
        if not ok then return end
        for _, ev in ipairs(list) do
            if type(ev) == "table" and type(ev.EventId) == "string" then seen[ev.EventId] = true end
        end
    end

    O.track(Activities.worldEvent:Connect(function(ev)
        if not enabled then return end
        local text = M.alert(ev, picked(), seen)
        if type(ev) == "table" and type(ev.EventId) == "string" then seen[ev.EventId] = true end
        if text then UiWrite.notify(Library, text, 8) end
    end))

    local box = ctx.Tabs.GameExtras:AddRightGroupbox("Event Alerts", "bell")
    box:AddToggle("EventAlerts_Enabled", {
        Text     = "Event Alerts",
        Default  = false,
        Callback = function(on)
            enabled = on == true
            if enabled then markRunning() end
        end,
    })
    box:AddDropdown("EventAlerts_Events", {
        Text    = "Events",
        Values  = CHOICES,
        Default = DEFAULTS,
        Multi   = true,
    })

    O.onUnload(function() enabled = false end)
    O.finalize()
end

return M

end)
__bundle_register("Features/Utilities/DashCooldown", function(require, _LOADED, __bundle_register, __bundle_modules)
-- no dash cooldown: zeroes Weapons.DashCooldown, the 1.4 s the controller waits after every dash (PlayerController.lua:8556-8566, read live each dash), leaving only its fixed 0.4 s global lock (:8520-8529); the engine keeps the shipped value through Combat.dashCooldown, and the value goes back when off
local Log   = require("Utility/Log")
local Mount = require("Utility/Mount")

local OURS = 0

local M = {}

-- the value to put back: what was there before us, unless that was already ours (a reload over a crashed copy)
function M.restoreValue(seen, shipped)
    if type(seen) == "number" and seen ~= OURS then return seen end
    return shipped
end

function M.mount(ctx, box)
    local O = Mount.orchestrator(ctx, "DashCooldown")
    if not O then return end
    local apis = ctx.Api or {}
    local Net, Combat = apis.Net, apis.Combat
    if not (Net and Combat and box) then
        Log.devwarn("DashCooldown", "net or combat api missing; no dash cooldown won't load")
        return
    end

    local Weapons, original = nil, nil

    local function weapons()
        local ok, value = Net.module("Weapons")
        if ok and type(value) == "table" then return value end
        return nil
    end

    local function set(on)
        if on then
            if Weapons then return end
            local W = weapons()
            if not W then
                Log.devwarn("DashCooldown", "weapons module unavailable")
                return
            end
            -- read first, so the engine's copy is the real cooldown before ours goes in
            local shipped = type(Combat.dashCooldown) == "function" and Combat.dashCooldown() or 1.4
            original = M.restoreValue(W.DashCooldown, shipped)
            Weapons = W
            W.DashCooldown = OURS
        elseif Weapons then
            if Weapons.DashCooldown == OURS then Weapons.DashCooldown = original end
            Weapons, original = nil, nil
        end
    end

    box:AddToggle("DashCooldown_Enabled", {
        Text     = "No Dash Cooldown",
        Default  = false,
        Callback = function(on) set(on == true) end,
    })

    O.onUnload(function() set(false) end)
    O.finalize()
end

return M

end)
__bundle_register("Features/Utilities/Beachcombing", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto beachcombing: sweeps a sandy beach with the metal detector, follows its hot/cold signal to the buried cache, and digs it up through the game's own Unearth; buys the detector at big chop once when you have none; takes movement only for a pass and hands it back after each one
local Jobs        = require("Utility/Jobs")
local Log         = require("Utility/Log")
local Mount       = require("Utility/Mount")
local Status      = require("Utility/Status")
local UiWrite     = require("Utility/UiWrite")
local Farms       = require("Utility/Farms")
local FarmSettings = require("Utility/FarmSettings")
local WorldEvents = require("Features/Auto/WorldEvents")
local Search      = require("Features/Utilities/Beachcombing/Search")

local OWNER = "AutoBeachcombing"
local FARM = "Beachcombing"
-- live 2026-11-22 (user: as efficient as possible): caches cap at 3 alive and respawn 20-35 s after a dig (Beachcombing.lua Caches), about one
-- find per 9 s at best; a 1 s pass and 0.6 s settle ran ~13 s a find
local TICK = 0.3
local DETECTOR = "Metal Detector"
-- Modules.Beachcombing.lua:7, the model the server welds to your character while it is switched on
local HELD = "HeldMetalDetector"
-- ShopCatalog.lua:22-29
local DETECTOR_OFFER = "supply:metal-detector"
local DETECTOR_PRICE = 2500
local BIG_CHOP = "Big Chop"
-- the tutorial's "Search the sand" prompt at the shore (recon/quest_chain.md:181, live tracker in net_state.md:207)
local SHORE = Vector3.new(-360, 24.35, 2400)
-- caches spawn 10-36 studs from you and are dropped past 110 (Beachcombing.lua:48-60), so the sweep stays well inside that
local ROAM = 80
local SCAN = 36
local SPACING = 2.5
local STEP = 8
local SETTLE = 0.35
local SAMPLE_AGE = 20
local SAMPLE_REACH = 60
local DIG_WAIT = 6
local DIG_TRIES = 3
local PARK_FOR = 600
local SWITCH_WAIT = 3
local WALK_RANGE = 200
local SAND_CACHE_FOR = 120
local RETRY_AFTER = 30
local SHOP_WAIT = 6
-- live 2026-11-17 (garden flow): a trade sent right after the shop opens is refused with "Please wait a moment"
local SHOP_SETTLE = 1.5
local SHOP_TRIES = 3
-- Beachcombing.lua:75 HourlyFinds: past this many in an hour the loot turns to scrap 30 / junk 70 (recon/reward_rate.md:101), so the farm rests
local HOURLY_FINDS = 60
local HOUR = 3600

local M = {}

function M.mount(ctx)
    local O = Mount.orchestrator(ctx, OWNER)
    if not O then return end
    local Api = ctx.Api or {}
    local World, Player, Activities, Net = Api.World, Api.Player, Api.Activities, Api.Net
    if not (World and Player and Activities and Activities.beachcombing and Activities.unearth) then
        Log.devwarn("Beachcombing", "world, player or activities api missing; auto beachcombing won't load")
        return
    end
    local Toggles = ctx.Toggles
    local References = ctx.References
    local Workspace = ctx.Services.Workspace

    local enabled, job, token = false, nil, nil
    local anchor = nil
    local samples, blocked, sand = {}, {}, {}
    local sandAt0 = 0
    local tries, parked, failedAt = {}, {}, {}
    local lastDig = -math.huge
    -- os.clock() of each find this session, kept for the hour the game's cap counts
    local findTimes = {}
    local lastFinds = nil

    local function say(text) Status.set(OWNER, text, Status.ACTING) end

    local function sleep(seconds)
        if job then return job:sleep(seconds) end
        task.wait(seconds)
        return true
    end

    local function waitFor(check, timeout)
        local waited = 0
        while waited < timeout do
            local value = check()
            if value then return value end
            if not sleep(0.1) then return nil end
            waited = waited + 0.1
        end
        return check()
    end

    local function beachModule()
        if not Net then return nil end
        local ok, mod = Net.module("Beachcombing")
        if ok and type(mod) == "table" then return mod end
        return nil
    end

    local function bands()
        local mod = beachModule()
        local list = mod and type(mod.Detect) == "table" and mod.Detect.Bands
        return type(list) == "table" and #list > 0 and list or Search.BANDS
    end

    -- Beachcombing.lua:61 Dig.Cooldown
    local function digCooldown()
        local mod = beachModule()
        return mod and type(mod.Dig) == "table" and tonumber(mod.Dig.Cooldown) or 2.5
    end

    local function count(name)
        local ok, n = Player.count(name)
        return ok and n or 0
    end

    local function coins()
        return tonumber(Player.value("Stats.Coins")) or 0
    end

    local function toggleOn(id, default)
        local element = Toggles[id]
        if element == nil then return default end
        return element.Value == true
    end

    local function held()
        local char = References.character
        return char ~= nil and char.Parent ~= nil and char:FindFirstChild(HELD) ~= nil
    end

    local function cooling(key)
        return failedAt[key] ~= nil and os.clock() - failedAt[key] < RETRY_AFTER
    end

    local function claim()
        local ok, t = World.claim(OWNER)
        if not ok then return false end
        token = t
        return true
    end

    local function release()
        if token then World.release(token) end
        token = nil
    end

    -- a long trip teleports; a short one is walked (no sprint while the detector is out: the game stops your run, PlayerController.lua:7643)
    local function travel(goal)
        local root = References.humanoidRootPart
        if root and root.Parent and (root.Position - goal).Magnitude <= FarmSettings.walkRange(WALK_RANGE) then
            local ok = World.walkTo(goal, { token = token, sprint = not held(), tolerance = 3 })
            if ok then return true end
        end
        return World.travelTo(goal, { token = token })
    end

    -- ============================== the sand ==============================

    local function isSand(part)
        local mod = beachModule()
        if mod and type(mod.IsSandPart) == "function" then
            local ok, yes = pcall(mod.IsSandPart, part)
            if ok then return yes == true end
        end
        return part:IsA("BasePart") and part.Material == Enum.Material.Sand
    end

    local function rayParams()
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local list = {}
        local folder = Workspace:FindFirstChild("Game")
        local players = folder and folder:FindFirstChild("Players")
        if players then list[#list + 1] = players end
        if References.character then list[#list + 1] = References.character end
        local markers = Workspace:FindFirstChild("LocalBeachcombing")
        if markers then list[#list + 1] = markers end
        params.FilterDescendantsInstances = list
        return params
    end

    local function cellKey(p)
        return math.floor(p.X / SPACING + 0.5) .. "," .. math.floor(p.Z / SPACING + 0.5)
    end

    -- the sand surface under a flat point (Beachcombing.lua:102-109 reads the same way), cached per grid cell; false when it isn't sand
    local function sandAt(point, height, params)
        local key = cellKey(point)
        local hit = sand[key]
        if hit ~= nil then return hit end
        local result = Workspace:Raycast(Vector3.new(point.X, height + 12, point.Z), Vector3.new(0, -40, 0), params)
        hit = result ~= nil and isSand(result.Instance) and result.Position or false
        sand[key] = hit
        return hit
    end

    local function sandCandidates(here)
        if os.clock() - sandAt0 > SAND_CACHE_FOR then
            table.clear(sand)
            sandAt0 = os.clock()
        end
        local params = rayParams()
        local out = {}
        for _, p in ipairs(Search.grid(here, SCAN, SPACING)) do
            if Search.flat(p, anchor) <= ROAM and not blocked[cellKey(p)] then
                local hit = sandAt(p, here.Y, params)
                if hit then out[#out + 1] = hit end
            end
        end
        return out
    end

    -- ============================== the detector ==============================

    local function shopTrade(offerId)
        local okN, chop = World.npc(BIG_CHOP)
        if not okN then return false end
        say("Going to Big Chop")
        if not travel(chop:GetPivot().Position) then return false end
        -- right after a teleport the server may not see you beside him yet, so the open gets a second go
        local opened
        for _ = 1, 2 do
            Activities.gardenShopOpen()
            opened = waitFor(function()
                local ok, s = Activities.gardenShop()
                return ok and s and s.snapshot and s
            end, SHOP_WAIT / 2)
            if opened or not sleep(SHOP_SETTLE) then break end
        end
        if not opened then return false end
        say("Buying a detector")
        local bought = false
        for _ = 1, SHOP_TRIES do
            if not sleep(SHOP_SETTLE) then break end
            if not Activities.gardenShopBuy(offerId, 1) then break end
            local answered = waitFor(function()
                local ok, s = Activities.gardenShop()
                return ok and s and not s.pending and s.result
            end, SHOP_WAIT)
            if answered and answered.verb == "ShopResult" and answered.payload.Success ~= false then
                bought = true
                break
            end
            local message = answered and tostring(answered.payload.Message or "") or ""
            if not message:lower():find("wait") then break end
        end
        Activities.gardenShopClose()
        return bought
    end

    local function buyDetector()
        if not shopTrade(DETECTOR_OFFER) then return false end
        return waitFor(function() return count(DETECTOR) > 0 end, 3) ~= nil
    end

    -- Items.lua:614-629: the detector is a Tool the server switches on and off on Use
    local function switchOn()
        say("Switching on the detector")
        local ok = Player.useItem(DETECTOR)
        if not ok then return false end
        return waitFor(held, SWITCH_WAIT) ~= nil
    end

    -- ============================== digging ==============================

    local function located()
        local ok, beach = Activities.beachcombing()
        return ok and beach and beach.located or {}
    end

    local function stillThere(id)
        for _, spot in ipairs(located()) do
            if spot.id == id then return true end
        end
        return false
    end

    local function nextSpot(here)
        local best, bestDistance
        for _, spot in ipairs(located()) do
            local at = parked[spot.id]
            if not (at and os.clock() - at < PARK_FOR) and Search.flat(spot.position, anchor) <= ROAM + SCAN then
                local d = (spot.position - here).Magnitude
                if not best or d < bestDistance then best, bestDistance = spot, d end
            end
        end
        return best
    end

    local function finds()
        return Player.value("Stats.BeachFinds")
    end

    -- Beachcombing.lua:650-665: the dig prompt sends Unearth from within Dig.Range + 2; a find clears the marker ("Remove")
    local function dig(spot, here)
        say("Digging up a find")
        if Search.flat(here, spot.position) > 2.5 then
            World.walkTo(spot.position, { token = token, tolerance = 1.5, stream = false, timeout = 15 })
        end
        local wait = lastDig + digCooldown() - os.clock()
        if wait > 0 and not sleep(wait) then return end
        local before = finds()
        local sent = Activities.unearth(spot.id)
        lastDig = os.clock()
        local done = sent and waitFor(function() return not stillThere(spot.id) or finds() ~= before end, DIG_WAIT)
        if done then
            tries[spot.id] = nil
            samples = {}
            return
        end
        tries[spot.id] = (tries[spot.id] or 0) + 1
        if tries[spot.id] >= DIG_TRIES then
            parked[spot.id] = os.clock()
            tries[spot.id] = nil
        end
    end

    -- ============================== the sweep ==============================

    -- one reading where you stand, then a short walk toward the sand that fits every reading best
    local function sweep(here)
        if not sleep(SETTLE) then return nil end
        local root = References.humanoidRootPart
        if root and root.Parent then here = root.Position end
        local ok, beach = Activities.beachcombing()
        samples = Search.prune(samples, os.clock(), SAMPLE_AGE, here, SAMPLE_REACH)
        if ok and beach and beach.near ~= false then
            samples[#samples + 1] = { position = here, band = tonumber(beach.signal) or 0, at = os.clock() }
        end
        local candidates = sandCandidates(here)
        if #candidates == 0 then
            -- no sand in reach of here: back to where the sweep started
            samples = {}
            if Search.flat(here, anchor) <= 4 then
                failedAt.sand = os.clock()
                anchor = nil
                return "No sand here"
            end
            say("Going to the beach")
            travel(anchor)
            return nil
        end
        local best = Search.pick(candidates, samples, here, bands())
        if not best or Search.flat(best, here) < 1 then return "Waiting for a find" end
        say(ok and beach and (tonumber(beach.signal) or 0) > 0 and "Following the signal" or "Sweeping the sand")
        local goal = Search.step(here, best, STEP)
        local walked = World.walkTo(goal, { token = token, tolerance = 1.5, stream = false, timeout = 10 })
        if not walked then blocked[cellKey(best)] = true end
        return nil
    end

    local function hourlyCap()
        local mod = beachModule()
        return mod and tonumber(rawget(mod, "HourlyFinds")) or HOURLY_FINDS
    end

    -- counts new finds off Stats.BeachFinds and answers the seconds until the hour's cap frees a find, or nil while finds still pay
    local function capRest()
        local now, total = os.clock(), tonumber(finds())
        if total then
            if lastFinds and total > lastFinds then
                for _ = 1, math.min(total - lastFinds, 10) do findTimes[#findTimes + 1] = now end
            end
            lastFinds = total
        end
        while findTimes[1] and now - findTimes[1] > HOUR do table.remove(findTimes, 1) end
        if #findTimes < hourlyCap() then return nil end
        return HOUR - (now - findTimes[1])
    end

    -- gated: the farm plan held this pass back; work: the last pass that ran acted
    local gated, work = false, false
    local function pass()
        gated = false
        if not Player.ready() then return "Waiting for your save" end
        if WorldEvents.wants() then return "Paused for an event" end
        if Farms.priority("Beachcombing") then return "Paused for " .. Farms.priority("Beachcombing") end
        local may, why = Farms.mayAct(FARM)
        if not may then
            gated = true
            return why
        end
        local hum = References.humanoid
        local root = References.humanoidRootPart
        if not (hum and hum.Parent and hum.Health > 0 and root and root.Parent) then return "Waiting to respawn" end
        if Player.isBusy() then return "Waiting for a scene" end

        local rest = capRest()
        if rest and toggleOn("Beachcombing_StopAtCap", true) then
            if held() then Player.useItem(DETECTOR) end
            return ("Hourly finds used, back in %dm"):format(math.ceil(rest / 60))
        end

        if count(DETECTOR) < 1 then
            if not toggleOn("Beachcombing_Buy", true) then return "Need a Metal Detector" end
            if coins() < DETECTOR_PRICE then return "Need 2,500 dalas" end
            if cooling("buy") then return "Couldn't buy a detector" end
            if not claim() then return "Movement is busy" end
            if not buyDetector() then failedAt.buy = os.clock() end
            return nil
        end

        if not claim() then return "Movement is busy" end
        local here = root.Position
        if not anchor then
            if cooling("sand") then return "No sand here" end
            anchor = sandAt(here, here.Y, rayParams()) and here or SHORE
            samples = {}
        end
        if Search.flat(here, anchor) > ROAM + 10 then
            say("Going to the beach")
            samples = {}
            travel(anchor)
            return nil
        end
        if not held() then
            if cooling("switch") then return "Detector won't switch on" end
            if not switchOn() then failedAt.switch = os.clock() end
            return nil
        end
        local spot = nextSpot(here)
        if spot then
            dig(spot, here)
            return nil
        end
        return sweep(here)
    end

    local function loop(j)
        job = j
        while j.alive and enabled do
            local ok, line = pcall(pass)
            if ok then
                if not gated then work = line == nil end
                if line then Status.set(OWNER, line, gated and Status.WAITING or Status.IDLE) end
            else
                Log.devwarn("Beachcombing", "pass failed: %s", tostring(line))
            end
            -- movement is handed back after every pass so the other farms can use it
            release()
            if not j:sleep(FarmSettings.tick(TICK)) then return end
        end
    end

    local function stop()
        enabled = false
        if job then job:Cancel() end
        job = nil
        release()
        -- put the detector away so you can run again
        if held() then Player.useItem(DETECTOR) end
        anchor = nil
        samples = {}
        table.clear(blocked)
        table.clear(failedAt)
        gated, work = false, false
        Status.clear(OWNER)
    end

    local box = ctx.Tabs.Gathering:AddRightGroupbox("Beachcombing", "shovel")
    box:AddToggle("Beachcombing_Enabled", {
        Text     = "Auto Beachcombing",
        Default  = false,
        Callback = function(on)
            if on then
                if enabled then return end
                enabled = true
                O.track(Jobs.spawn(loop, { name = "AutoBeachcombing" }))
            else
                stop()
            end
        end,
    })
    Farms.register({
        name    = FARM,
        label   = "Beachcombing",
        owner   = OWNER,
        enable  = function(on) UiWrite.value(Toggles.Beachcombing_Enabled, on) end,
        enabled = function() return enabled end,
        active  = function() return token ~= nil end,
        wants   = function() return enabled and work end,
    })
    box:AddToggle("Beachcombing_StopAtCap", {
        Text    = "Stop At Hourly Cap",
        Default = true,
        Tooltip = "After 60 finds an hour it's only scrap and junk",
    })
    box:AddToggle("Beachcombing_Buy", {
        Text    = "Buy Detector",
        Default = true,
        Tooltip = "2,500 dalas at Big Chop, once",
    })

    O.onUnload(stop)
    O.onUnload(function() Farms.unregister(FARM) end)
    O.finalize()
end

return M

end)
__bundle_register("Features/Utilities/Beachcombing/Search", function(require, _LOADED, __bundle_register, __bundle_modules)
-- beach search: the hot/cold sweep's arithmetic; each detector reading bounds how far the nearest buried cache is (the bands at Beachcombing.lua:36-45), so a reading rules out the sand around it and points at the ring a cache must sit in
local M = {}

-- Modules.Beachcombing.lua:36, used when the module can't be read
M.BANDS = { 24, 16, 10, 5, 2.75 }
-- a reading is taken a moment after you stop, so the point it was read at is only this exact
local SLACK = 0.75

local function flat(a, b)
    local dx, dz = a.X - b.X, a.Z - b.Z
    return math.sqrt(dx * dx + dz * dz)
end
M.flat = flat

-- Beachcombing.lua:37-45: the highest band whose radius still covers the distance, 0 past the widest
function M.band(distance, bands)
    bands = bands or M.BANDS
    local out = 0
    for i, radius in ipairs(bands) do
        if distance <= radius then out = i end
    end
    return out
end

-- the nearest cache's distance window for a reading: band 0 is beyond the widest band, band k is inside bands[k] and outside bands[k + 1]
function M.window(band, bands)
    bands = bands or M.BANDS
    band = math.floor(tonumber(band) or 0)
    if band <= 0 then return bands[1], math.huge end
    if band > #bands then band = #bands end
    return bands[band + 1] or 0, bands[band]
end

-- nil when some reading rules the point out (no cache that close to where it was read), else how many readings it fits
function M.score(point, samples, bands)
    local score = 0
    for _, sample in ipairs(samples) do
        local lo, hi = M.window(sample.band, bands)
        local d = flat(point, sample.position)
        if d < lo - SLACK then return nil end
        if d <= hi + SLACK then score = score + 1 end
    end
    return score
end

-- the candidate that fits the most readings, the nearest to you on a tie; nil when every one is ruled out
function M.pick(candidates, samples, from, bands)
    local best, bestScore, bestDistance = nil, -1, math.huge
    for _, point in ipairs(candidates) do
        local score = M.score(point, samples, bands)
        if score then
            local d = flat(point, from)
            if score > bestScore or (score == bestScore and d < bestDistance) then
                best, bestScore, bestDistance = point, score, d
            end
        end
    end
    return best, best and bestScore or nil
end

-- flat grid points within radius of center, spacing apart, at center's height
function M.grid(center, radius, spacing)
    local out = {}
    local steps = math.floor(radius / spacing)
    for i = -steps, steps do
        for j = -steps, steps do
            local dx, dz = i * spacing, j * spacing
            if dx * dx + dz * dz <= radius * radius then
                out[#out + 1] = Vector3.new(center.X + dx, center.Y, center.Z + dz)
            end
        end
    end
    return out
end

-- a point at most maxStep along the flat line from from to goal, at goal's height when it is reached
function M.step(from, goal, maxStep)
    local d = flat(from, goal)
    if d <= maxStep or d <= 0 then return goal end
    local t = maxStep / d
    return Vector3.new(from.X + (goal.X - from.X) * t, goal.Y, from.Z + (goal.Z - from.Z) * t)
end

-- drops readings older than maxAge (caches spawn and expire, so an old "nothing here" stops being true) and ones read far from here
function M.prune(samples, now, maxAge, here, maxDistance)
    local out = {}
    for _, sample in ipairs(samples) do
        if now - sample.at <= maxAge and (not here or flat(sample.position, here) <= maxDistance) then out[#out + 1] = sample end
    end
    return out
end

return M

end)
__bundle_register("Features/Auto/WorldEvents", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto world events: goes to the world events you pick (stand boss, dio, money transport, meteors) while they run, fights with the shared combat engine and presses the event's loot prompts; it holds World movement only while it acts, or through the whole event with events first on, and never takes it from another farm
local Jobs   = require("Utility/Jobs")
local Log    = require("Utility/Log")
local Mount  = require("Utility/Mount")
local Status = require("Utility/Status")
local UiWrite = require("Utility/UiWrite")
local Farms  = require("Utility/Farms")
local FarmSettings = require("Utility/FarmSettings")
local Engage = require("Features/Combat/Engage")
local Plan   = require("Features/Auto/WorldEvents/Plan")

local OWNER = "AutoWorldEvents"
local FARM = "WorldEvents"
local IDLE_STEP = 0.25
local IDLE_MAX = 5
local FIGHT_POLL = 0.25
local BOSS_WAIT = 10
local BOSS_MISSES = 3
local MAX_DEATHS = 3
local PARTY_RANGE = 120
local FIGHT_TIMEOUT = 600
local CLEAR_TIMEOUT = 90
local CLEAR_RADIUS = 60
-- meteor parts scatter 12-48 studs from the impact (WorldEvents.lua (Modules):323-324)
local LOOT_RADIUS = 70
local LOOT_SETTLE = 1.5
local LOOT_EMPTY_WAIT = 3
-- the truck's cash is a 10 s hold claimed up to 3 times (WorldEvents.lua (Modules):279-280)
local HOLD_TRIES = 3
local PRESS_TRIES = 2
local WALK_RANGE = 80
local NEAR_ENOUGH = 15
local RESPAWN_POLL = 0.5
local RESPAWN_WAIT = 45

local M = {}

-- true while events first is on and a picked event is live; the orchestrator's priority hook for other farms
local wanting = false
function M.wants() return wanting end

function M.mount(ctx)
    local O = Mount.orchestrator(ctx, "AutoWorldEvents")
    if not O then return end
    local Api = ctx.Api or {}
    local Activities, World, Player, Combat = Api.Activities, Api.World, Api.Player, Api.Combat
    if not (Activities and Activities.worldEvents and Activities.worldEvent and World and Player) then
        Log.devwarn("AutoWorldEvents", "activities, world or player api missing; auto world events won't load")
        return
    end
    local Options, Toggles, References = ctx.Options, ctx.Toggles, ctx.References
    local WE = World.Errors or {}

    local enabled, job, token = false, nil, nil
    local woken = false
    local latched = nil
    local done, deaths, misses = {}, {}, {}
    local tries = setmetatable({}, { __mode = "k" })

    local function post(text, level) Status.set(OWNER, text, level) end
    local function say(text) post(text, Status.ACTING) end

    local function toggleOn(id, default)
        local element = Toggles[id]
        if element == nil then return default end
        return element.Value == true
    end

    local function picked()
        local element = Options.AutoWorldEvents_Events
        local value = element and element.Value
        return type(value) == "table" and value or {}
    end

    -- the shared combat engine, built once on the first fight
    local engine, engineTried = nil, false
    local function getEngine()
        if engine or engineTried then return engine end
        engineTried = true
        local ok, built = pcall(Engage.new, ctx)
        if ok and built then engine = built else Log.devwarn("AutoWorldEvents", "combat engine failed to build: %s", tostring(built)) end
        return engine
    end

    -- the claim is never taken from another owner: a busy claim waits for that farm's next idle pass
    local function ensureClaim()
        if token then
            local ok, owner = World.owner()
            if ok and owner == OWNER then return true end
            token = nil
        end
        local ok, got = World.claim(OWNER)
        if not ok then return false end
        token = got
        return true
    end

    local function releaseClaim()
        if token then World.release(token) end
        token = nil
    end

    local function alive()
        local hum = References.humanoid
        if not (hum and hum.Parent and hum.Health > 0) then return false end
        if Combat and Combat.alive then return Combat.alive() == true end
        return true
    end

    local function waitRespawn(j)
        post("Waiting to respawn", Status.WAITING)
        local waited = 0
        while j.alive and waited < RESPAWN_WAIT do
            if alive() and Player.spawnReady() then return true end
            if not j:sleep(RESPAWN_POLL) then return false end
            waited = waited + RESPAWN_POLL
        end
        return alive()
    end

    local function events()
        local ok, list = Activities.worldEvents()
        if ok and type(list) == "table" then return list end
        return {}
    end

    -- the latest table for an event, or nil once it has ended
    local function current(id)
        for _, ev in ipairs(events()) do
            if ev.EventId == id and ev.Phase ~= "Cleanup" then return ev end
        end
        return nil
    end

    local function siteSpot(site)
        if type(site) ~= "string" then return nil end
        local root = ctx.Services.Workspace:FindFirstChild("Game")
        local folder = root and root:FindFirstChild("WorldEventSites")
        local part = folder and (folder:FindFirstChild(site) or folder:FindFirstChild((string.gsub(site, "%s", ""))))
        if part and part:IsA("BasePart") then return part.Position end
        return nil
    end

    local function myPosition()
        local root = References.humanoidRootPart
        return root and root.Parent and root.Position or nil
    end

    -- a short hop runs on foot like a player; a far one, or a walk the path can't finish, teleports
    local function go(position)
        local from = myPosition()
        if from and (from - position).Magnitude <= FarmSettings.walkRange(WALK_RANGE) then
            if World.walkTo(position, { token = token, sprint = true }) then return true end
        end
        local ok, err = World.travelTo(position, { token = token })
        if ok then return true end
        from = myPosition()
        if err == WE.NOT_ARRIVED and from and (from - position).Magnitude <= NEAR_ENOUGH then return true end
        return false, err
    end

    -- yields until the engine handle finishes, the event ends, the job is cancelled or you have died too often; the engine itself sits out a respawn and goes back in
    local function run(j, handle, id)
        local wasAlive = alive()
        while not handle.done() do
            if not j:sleep(FIGHT_POLL) then
                handle.kill()
                return false, "stopped"
            end
            local now = alive()
            if wasAlive and not now then deaths[id] = (deaths[id] or 0) + 1 end
            wasAlive = now
            if not current(id) or (deaths[id] or 0) >= MAX_DEATHS then handle.stop() end
        end
        return handle.outcome()
    end

    local function aggroOnMe(model)
        local value = model:FindFirstChild("NPCCombatTarget")
        return value ~= nil and value:IsA("ObjectValue") and value.Value ~= nil and value.Value == References.character
    end

    -- the truck's agents, or anything else fighting you at the loot, are beaten before the next press
    local function clearAttackers(j, id)
        local ok, list = World.combatants({ npcs = true, hostileOnly = true, alive = true, maxDistance = CLEAR_RADIUS })
        if not ok then return end
        local attacked = false
        for _, model in ipairs(list) do
            if aggroOnMe(model) then attacked = true break end
        end
        if not attacked then return end
        local eng = getEngine()
        if not eng then return end
        say("Fighting the guards")
        local handle = eng.start(nil, {
            owner = OWNER, token = token, timeout = CLEAR_TIMEOUT,
            clear = { npcs = true, hostileOnly = true, alive = true, maxDistance = CLEAR_RADIUS },
        })
        if handle then run(j, handle, id) end
    end

    -- presses every loot prompt around a spot, nearest first, each a bounded number of times; (true) when nothing is left
    local function lootAround(j, id, center, line)
        local emptySince = nil
        while j.alive do
            if not current(id) then return false end
            if not alive() then return false end
            clearAttackers(j, id)
            local ok, list = World.prompts({ near = center, radius = FarmSettings.lootRadius(LOOT_RADIUS) })
            local from = myPosition()
            local best, bestDistance = nil, math.huge
            for _, p in ipairs(ok and list or {}) do
                local limit = p.holdDuration > 0 and HOLD_TRIES or PRESS_TRIES
                if Plan.isLoot(p.prompt) and (tries[p.prompt] or 0) < limit and p.position then
                    local distance = from and (p.position - from).Magnitude or 0
                    if distance < bestDistance then best, bestDistance = p, distance end
                end
            end
            if not best then
                emptySince = emptySince or os.clock()
                if os.clock() - emptySince >= LOOT_EMPTY_WAIT then return true end
                if not j:sleep(0.5) then return false end
            else
                emptySince = nil
                tries[best.prompt] = (tries[best.prompt] or 0) + 1
                say(line)
                if bestDistance > best.maxDistance - 1 then go(best.position) end
                local fired, err = World.firePrompt(best.prompt)
                if not fired then Log.dev("AutoWorldEvents", "loot press refused: %s", tostring(err)) end
            end
        end
        return false
    end

    -- ======================= per kind =======================

    -- other players close enough to be fighting the boss
    local function helpersNear(boss)
        -- cloneref breaks == on instances, so you are told apart by UserId
        local players = ctx.Services.Players
        local me = players.LocalPlayer and players.LocalPlayer.UserId
        local at = boss:GetPivot().Position
        local n = 0
        for _, plr in ipairs(players:GetPlayers()) do
            local char = plr.UserId ~= me and plr.Character
            if char and char.Parent and (char:GetPivot().Position - at).Magnitude <= PARTY_RANGE then n = n + 1 end
        end
        return n
    end

    local function findBoss(ev)
        local ok, list = World.combatants({ npcs = true, alive = true })
        if not ok then return nil end
        for _, model in ipairs(list) do
            if Plan.isBoss(model, ev) then return model end
        end
        return nil
    end

    -- (finished, line)
    local function runBoss(j, ev)
        local name = Plan.bossName(ev)
        local boss = findBoss(ev)
        if not boss then
            local spot = Plan.spots(ev, siteSpot)[1]
            if not spot then return false, "Can't find " .. name end
            say("Going to " .. name)
            local okGo = go(spot)
            if not okGo and not alive() then return false, "Waiting to respawn" end
            local waited = 0
            while not boss and waited < BOSS_WAIT do
                if not j:sleep(0.5) then return false, nil end
                waited = waited + 0.5
                boss = findBoss(ev)
            end
            if not boss then
                misses[ev.EventId] = (misses[ev.EventId] or 0) + 1
                if misses[ev.EventId] >= BOSS_MISSES then return true, "Can't find " .. name end
                return false, "Looking for " .. name
            end
        end
        -- live 2026-11-17: solo at level 24, jotaro (RecommendedPartySize 3, 800 hp) took a full health bar for every 180 dealt; a boss that wants a party is skipped unless someone else is on it
        local party = tonumber(boss:GetAttribute("RecommendedPartySize")) or 1
        if party > 1 and not toggleOn("AutoWorldEvents_Solo", false) and helpersNear(boss) < 1 then
            return true, name .. " needs a party"
        end
        local eng = getEngine()
        if not eng then return true, "Fighting is unavailable" end
        say("Fighting " .. name)
        local handle = eng.start(boss, { owner = OWNER, token = token, timeout = FIGHT_TIMEOUT })
        if not handle then return false, "Fight didn't start" end
        local spot = boss.Parent and boss:GetPivot().Position or nil
        local won, reason = run(j, handle, ev.EventId)
        if won then
            if spot then lootAround(j, ev.EventId, spot, "Looting " .. name) end
            return true, name .. " defeated"
        end
        if (deaths[ev.EventId] or 0) >= MAX_DEATHS then return true, name .. " is too strong" end
        if reason == "died" or not alive() then return false, "Waiting to respawn" end
        if not current(ev.EventId) then return true, name .. " is gone" end
        return false, "Fighting " .. name
    end

    local function runMeteor(j, ev)
        for _, spot in ipairs(Plan.spots(ev, siteSpot)) do
            if not current(ev.EventId) then return true, "Meteor is over" end
            say("Going to the meteor")
            local okGo = go(spot)
            if not okGo and not alive() then return false, "Waiting to respawn" end
            if not j:sleep(LOOT_SETTLE) then return false, nil end
            lootAround(j, ev.EventId, spot, "Grabbing arrow parts")
            if not alive() then return false, "Waiting to respawn" end
        end
        return true, "Meteor looted"
    end

    local function runTransport(j, ev)
        local spot = Plan.spots(ev, siteSpot)[1]
        if not spot then return true, "Can't find the truck" end
        say("Going to the truck")
        local okGo = go(spot)
        if not okGo and not alive() then return false, "Waiting to respawn" end
        if not j:sleep(LOOT_SETTLE) then return false, nil end
        lootAround(j, ev.EventId, spot, "Claiming the cash")
        if not alive() then return false, "Waiting to respawn" end
        return true, "Cash claimed"
    end

    local RUN = { boss = runBoss, meteor = runMeteor, transport = runTransport }

    -- ======================= loop =======================

    local function forgetEnded(list)
        local live = {}
        for _, ev in ipairs(list) do live[ev.EventId] = true end
        for _, t in ipairs({ done, deaths, misses }) do
            for id in pairs(t) do
                if not live[id] then t[id] = nil end
            end
        end
        if latched and not live[latched] then latched = nil end
    end

    -- (line, level, acted)
    local function pass(j)
        local list = events()
        forgetEnded(list)
        local want = picked()
        -- an event is time-limited, so it always outranks the farms that can run any time; the farm plan is where an order of your own goes
        local first = true
        wanting = first and Plan.anyLive(list, want, done)
        local ev, wait = Plan.pick(list, want, done, latched)
        if not ev then
            if wait then
                -- events first takes movement early, so the other farms are already parked when the loot lands (not for a transport en route: see Plan.holdsEarly)
                if wanting and first and Player.ready() and ensureClaim() then return wait, Status.WAITING, true end
                releaseClaim()
                return wait, Status.WAITING, false
            end
            return "No events", Status.IDLE, false
        end
        if not Player.ready() then return "Waiting for your save", Status.IDLE, false end
        if not alive() then
            if waitRespawn(j) then return "Back in action", Status.ACTING, true end
            return "Waiting to respawn", Status.WAITING, false
        end
        if Player.isBusy() then return "Waiting for a scene", Status.IDLE, false end
        if not ensureClaim() then return "Waiting for movement", Status.IDLE, false end
        latched = ev.EventId
        local finished, line = RUN[Plan.kind(ev.Id)](j, ev)
        if finished then
            done[ev.EventId] = true
            latched = nil
        end
        return line, Status.ACTING, not finished
    end

    -- idle waits wake early on a world event push
    local function idle(j)
        woken = false
        local waited, most = 0, FarmSettings.tick(IDLE_MAX)
        while waited < most do
            if not j:sleep(IDLE_STEP) then return false end
            if woken then return true end
            waited = waited + IDLE_STEP
        end
        return true
    end

    local function loop(j)
        while j.alive and enabled do
            local ok, line, level, keep = pcall(pass, j)
            if ok then
                if line then post(line, level) end
                if not keep then releaseClaim() end
            else
                Log.devwarn("AutoWorldEvents", "pass failed: %s", tostring(line))
                releaseClaim()
            end
            if not j.alive then return end
            if ok and keep and level == Status.ACTING then
                if not j:sleep(IDLE_STEP) then return end
            elseif not idle(j) then
                return
            end
        end
    end

    local function stop()
        enabled = false
        wanting = false
        if job then job:Cancel() end
        job = nil
        if engine then engine.destroy() end
        releaseClaim()
        latched = nil
        table.clear(done)
        table.clear(deaths)
        table.clear(misses)
        Status.clear(OWNER)
    end

    O.track(Activities.worldEvent:Connect(function() woken = true end))

    local box = ctx.Tabs.Fights:AddLeftGroupbox("World Events", "swords")
    box:AddToggle("AutoWorldEvents_Enabled", {
        Text     = "Auto World Events",
        Premium  = true,
        Default  = false,
        Callback = function(on)
            if on then
                if enabled then return end
                enabled = true
                job = O.track(Jobs.spawn(loop, { name = "AutoWorldEvents" }))
            else
                stop()
            end
        end,
    })
    -- an interrupt: it never asks the plan's gate, it only tells the plan when a picked event is live
    Farms.register({
        name    = FARM,
        label   = "Bosses and Events",
        owner   = OWNER,
        enable  = function(on) UiWrite.value(Toggles.AutoWorldEvents_Enabled, on) end,
        enabled = function() return enabled end,
        active  = function() return token ~= nil end,
        wants   = function() return enabled and Plan.anyLive(events(), picked(), done) end,
    })
    box:AddDropdown("AutoWorldEvents_Events", {
        Text    = "Events",
        Values  = Plan.CHOICES,
        Default = Plan.DEFAULTS,
        Multi   = true,
    })
    box:AddToggle("AutoWorldEvents_Solo", {
        Text    = "Solo Bosses",
        Default = false,
        Tooltip = "Fight party bosses even when alone",
    })

    O.onUnload(stop)
    O.onUnload(function() Farms.unregister(FARM) end)
    O.finalize()
end

return M

end)
__bundle_register("Features/Auto/WorldEvents/Plan", function(require, _LOADED, __bundle_register, __bundle_modules)
-- world events plan: the pure decisions behind auto world events (which live event to act on, when it can be acted on, where it is, which model is its boss, which prompts are its loot); menu names come from event alerts so both features agree on what an event is
local EventAlerts = require("Features/Utilities/EventAlerts")

local Plan = {}

Plan.CHOICES = { "Stand Boss", "DIO", "Money Transport", "Meteor" }
Plan.DEFAULTS = { "Stand Boss", "DIO", "Money Transport", "Meteor" }

-- WorldEvents.lua (Modules):292, :304 NaturalBoss
local NATURAL = { StandBoss = "Jotaro", DIO = "DIO" }
local KIND = { ["Stand Boss"] = "boss", ["DIO"] = "boss", ["Money Transport"] = "transport", ["Meteor"] = "meteor" }
-- a meteor's loot runs out first (LootLifetime 300, the truck's 180 but it needs a fight), a boss stays 1200 s
local ORDER = { meteor = 1, transport = 2, boss = 3 }

function Plan.label(id)
    return EventAlerts.label(id)
end

function Plan.kind(id)
    local label = Plan.label(id)
    return label and KIND[label] or nil
end

-- core WorldEvents.lua:158-186 and Effects.WorldEvents.lua:629: the truck is claimable once it has crashed (Loot), a meteor's parts once they lie on the ground (Loot); a boss is up for its whole run
function Plan.actionable(ev)
    if type(ev) ~= "table" or ev.Phase == "Cleanup" then return false end
    local kind = Plan.kind(ev.Id)
    if kind == "boss" then return true end
    if kind == "meteor" or kind == "transport" then return ev.Phase == "Loot" end
    return false
end

-- the countdown-free line for a picked event that isn't ready yet
function Plan.waitLine(ev)
    local kind = Plan.kind(ev.Id)
    if kind == "meteor" then
        if ev.Phase == "Scatter" then return "Meteor landing" end
        return "Meteor incoming"
    end
    if kind == "transport" then return "Transport en route" end
    return nil
end

-- (event to act on, wait line): the latched event first while it can still be acted on, else the most urgent ready one
function Plan.pick(list, picked, done, latched)
    local best, wait = nil, nil
    for _, ev in ipairs(type(list) == "table" and list or {}) do
        local label = type(ev) == "table" and Plan.label(ev.Id)
        if label and picked[label] and type(ev.EventId) == "string" and not done[ev.EventId] and ev.Phase ~= "Cleanup" then
            if Plan.actionable(ev) then
                if ev.EventId == latched then return ev, nil end
                if not best or ORDER[Plan.kind(ev.Id)] < ORDER[Plan.kind(best.Id)] then best = ev end
            else
                wait = wait or Plan.waitLine(ev)
            end
        end
    end
    return best, wait
end

