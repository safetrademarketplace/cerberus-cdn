    MusicGroup:AddButton({
        Text = "Play Music (Order)",
        Func = playOrdered
    })
    MusicGroup:AddButton({
        Text = "Play Music (Shuffled)",
        Func = playShuffled
    })
    MusicGroup:AddButton({
        Text = "Stop Music",
        Func = function()
            stopMusicHard()
            Library:Notify("⏹ Stopped.", 2)
        end
    })

    MusicGroup:AddDivider()

    MusicGroup:AddInput("MUSIC_URL", {
