    local function fallbackGate(char, verb, arg, isRelease)
        local cleanup = verb == "Reset" or verb == "ReleasedSkill" or verb == "SwingCancel"
            or (verb == "Dash" and arg == nil) or (CLEANUP_VERBS[verb] == true and arg == false)
        local player = References.player
        if (char:GetAttribute("TrainRaidSpectator") or (player and player:GetAttribute("TrainRaidSpectating"))) and not cleanup then
            return false
        end
        if not cleanup and PARRY_GATED[verb] and char:GetAttribute("Stunned") ~= true then
            if char:GetAttribute("ParryRecoveryActive") ~= nil then return false end
            if char:GetAttribute("ParryRecoveryWatch") ~= nil and S.data("SkillActive") ~= true then return false end
        end
        local token = char:GetAttribute("KraftWorkFixedToken")
        if type(token) == "string" and string.sub(token, 1, 5) == "Leap:" then
            local name = type(arg) == "string" and string.match(arg, "^[^;]*") or arg
            if name ~= "Kinetic Leap" then return false end
        end
        if verb == "Summon" and arg == true and char:GetAttribute("PassedOut") then return false end
        if verb == "Summon" and char:GetAttribute("Death13DreamOwner") then return false end
        local locks = char:FindFirstChild("ActionLocks")
        if locks and not cleanup and #locks:GetChildren() > 0 then return false end
        return true
    end

    -- Utility:canStartAction (Utility.lua:4006) reads only attributes, the stand ObjectValue and pure modules; its caches are keyed and re-validated per instance, so calling it from outside is safe
    function S.canAct(verb, arg, isRelease)
        local char = S.character()
        if not char then return false end
        local Utility = S.mod("Utility")
        local fn = Utility and Utility.canStartAction
        if type(fn) == "function" then
            local ok, allowed = S.game(fn, Utility, char, verb, arg, isRelease)
            if ok then return allowed == true end
            base.warn("canStartAction %s failed: %s", tostring(verb), tostring(allowed))
