            return Errors.BUSY
        end
        if S.piloting(char) then return Errors.PILOTING end
        if S.timeStopped(char) then return Errors.STUNNED end
        if S.isStunned(char) or char:GetAttribute("ParryStun") == true then return Errors.STUNNED end
        if L.combatDisabled == true then return Errors.COMBAT_DISABLED end
        if S.data("SkillActive") == true then return Errors.SKILL_ACTIVE end
        if L.blocking or L.swingCooldown or L.swinging or L.hitEnabled then return Errors.BUSY end
        if heavy and L.heavyCD then return Errors.COOLDOWN end
