}

function M.getEntry(entries, name)
    for i, e in ipairs(entries) do
        if e.name == name then
            return e, i
        end
    end
end

function M.getEntryIndex(entries, name)
    for i, e in ipairs(entries) do
        if e.name == name then
            return i, e
        end
    end
end

function M.buildNames(entries)
    local t = {}
    for _, e in ipairs(entries) do
        t[#t + 1] = e.name
    end
    return t
end

function M.propsFromPreset(entry)
    if not entry then return nil end
    local p = entry.props or {}
    if entry.type == "crosshair" then
        return {
            type = "crosshair",
            color = M.hexToColor3(p.color or "#FFFFFF"),
            thickness = math.max(1, tonumber(p.thickness) or 2),
            length = math.max(2, tonumber(p.length) or 18),
            gap = math.max(0, tonumber(p.gap) or 8),
            lineCount = math.clamp(tonumber(p.lineCount) or 4, 2, 24),
            centerDot = p.centerDot == true,
            dotSize = math.max(1, tonumber(p.dotSize) or 2),
            outline = p.outline == true,
            outlineColor = M.hexToColor3(p.outlineColor or "#000000"),
