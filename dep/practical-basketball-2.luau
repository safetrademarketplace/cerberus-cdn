local Errors = require("Api/Player/Errors")
local Limits = require("Api/Player/Limits")

local PIN            = "CFrame"
local ARRIVE_RADIUS  = 1
local STALL_SECONDS  = 5
local STALL_PROGRESS = 0.1
local MAX_HANG       = 8
local FLAT_EPSILON   = 0.05

local M = {}

function M.new(base, ctx, tracker, arbiter, levers)
    local Services  = ctx.Services
    local Workspace = Services.Workspace
    local Input     = Services.UserInputService
    local KeyCode   = Enum.KeyCode

    local pinned

    local function unpin()
        if not pinned then return end
        local held = pinned
        pinned = nil
        local ok, truth = pcall(held.model.GetAttribute, held.model, PIN)
        held.attributes[PIN] = ok and truth or nil
    end

    -- the mirror outlives the body's turn as ours, so the pin is cleared from the exact table it went into or a recycled body comes back stuck
    local function pin(state, cf)
        local attributes = state.data.Attributes
        if type(attributes) ~= "table" then return end
        if pinned and pinned.attributes ~= attributes then unpin() end
        if not pinned then pinned = { attributes = attributes, model = state.data.model } end
        attributes[PIN] = cf
    end

    -- skip the position and the hip-height spring drags you back; skip the velocity and you launch on arrival
    local function place(state, proxy, cf)
        proxy.CFrame = cf
        local holder = state.MovementPosition
        if holder then holder.Position = cf.Position end
        local movement = state.Movement
        local body = movement and movement.MovementVelocity
        if body then body.Velocity = Vector3.zero end
    end

    local function worldEdge()
        return Workspace:GetAttribute("Gamemode") == "Plaza" and Limits.plazaWorldEdge or Limits.worldEdge
    end

    local function inWorld(position, edge)
        return math.abs(position.X) <= edge and math.abs(position.Y) <= edge and math.abs(position.Z) <= edge
    end

    local function clampToWorld(position, edge)
        return Vector3.new(
            math.clamp(position.X, -edge, edge),
            math.clamp(position.Y, -edge, edge),
            math.clamp(position.Z, -edge, edge)
        )
    end

    -- nil for a bad argument; a getter that throws or returns junk reads as standing still
    local function rateOf(speed)
        if type(speed) == "function" then
            return function()
                local ok, value = pcall(speed)
                value = ok and tonumber(value) or 0
                return math.max(value, 0)
            end
        end
        local fixed = tonumber(speed)
        if not fixed then return nil end
        fixed = math.max(fixed, 0)
        return function() return fixed end
    end

    local function toPosition(value)
        local kind = typeof(value)
        if kind == "Vector3" then return value end
        if kind == "CFrame" then return value.Position end
        return nil
    end

    local function flatFacing(look, fallback)
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude > FLAT_EPSILON then return flat.Unit end
        return fallback
    end

    -- keyboard flies where the camera looks; a stick or touch has no vertical, so it rides the game's own flat move direction
    local function flightDirection(state)
        if Input:GetFocusedTextBox() then return Vector3.zero end
        local camera = ctx.References.camera
        local direction = Vector3.zero
        if camera then
            local view = camera.CFrame
            if Input:IsKeyDown(KeyCode.W) then direction = direction + view.LookVector end
            if Input:IsKeyDown(KeyCode.S) then direction = direction - view.LookVector end
            if Input:IsKeyDown(KeyCode.D) then direction = direction + view.RightVector end
            if Input:IsKeyDown(KeyCode.A) then direction = direction - view.RightVector end
            if Input:IsKeyDown(KeyCode.Space) then direction = direction + view.UpVector end
            if Input:IsKeyDown(KeyCode.LeftShift) or Input:IsKeyDown(KeyCode.LeftControl) then
                direction = direction - view.UpVector
            end
