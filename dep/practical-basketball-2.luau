__bundle_register("Features/Basketball/Defense/AutoGrab", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto grab ball: walking onto a loose ball picks it up, so this takes you onto one inside your range, at your pace or in one hop, and stands down the moment anyone has it or it is in the air
local Scheduler = require("Utility/Scheduler")
local Kit       = require("Features/Basketball/Defense/Kit")

local TICK     = 0.1
local HOP_GAP  = 0.5  -- hops are spaced so a pickup can land before the next one is judged
local HOP_LIFT = 1    -- studs above the ball, so a hop never lands in the floor

return function(ctx)
    local Library = ctx.Library
    local Toggles = ctx.Toggles
    local court   = ctx.Api and ctx.Api.Court
    local player  = ctx.Api and ctx.Api.Player

    local Group = ctx.Tabs.Defense:AddLeftGroupbox("Auto Grab Ball", "magnet")
    if not (court and player) then
        Group:AddLabel("Not available here", true)
        return
    end

    local range, instant = 30, false

    Group:AddToggle("AutoGrabEnabled", {
        Text = "Auto Grab Ball",
        Default = false,
    }):AddKeyPicker("AutoGrabKey", {
        Default = nil,
        SyncToggleState = true,
        Mode = "Toggle",
        Text = "Auto Grab Ball",
    })

    local Box = Group:AddDependencyBox()
    Box:AddSlider("AutoGrabRange", {
        Text = "Range",
        Default = range,
        Min = 5,
        Max = 100,
        Rounding = 0,
        Suffix = " studs",
        Callback = function(value) range = value end,
    })
    Box:AddToggle("AutoGrabInstant", {
        Text = "Go straight there",
        Default = false,
        Tooltip = "Teleports to it. Players may notice.",
        Callback = function(on) instant = on == true end,
    })
    local say = Kit.writer(Library, Box:AddLabel({ Text = "Off", DoesWrap = true }))
    Box:SetupDependencies({ { Toggles.AutoGrabEnabled, true } })

    local armed = Kit.armedMaid(ctx.track)
    local active = false
    local trip, lastHop = nil, nil

    local function stopTrip()
        if trip then
            trip:Cancel()
            trip = nil
        end
    end

    local function maxSpeed()
        return player.LIMITS.maxSpeed
    end

    local function tick()
        local position = player.position()
        if not position then return say("Waiting for your character") end
        if court.hasBall() then
            stopTrip()
            return say("You have the ball")
        end

        local ball = court.ball()
        if not ball then
            stopTrip()
            return say("No ball around")
        end
        if court.carrier(ball) then
            stopTrip()
            return say("Someone has the ball")
        end
        if court.ballInFlight(ball) then
            stopTrip()
            return say("Ball in the air")
        end

        local at = ball.Position
        local dx, dz = at.X - position.X, at.Z - position.Z
        local away = math.sqrt(dx * dx + dz * dz)
        if away > range then
            stopTrip()
            return say(("Loose ball %s away"):format(Kit.studs(away)))
        end

        if instant then
            stopTrip()
            local now = os.clock()
            if lastHop and now - lastHop < HOP_GAP then return end
            lastHop = now
            if player.teleport(CFrame.new(at.X, at.Y + HOP_LIFT, at.Z)) then
                say("Grabbing the ball")
            else
                say("Busy moving")
            end
            return
        end

        if trip and trip:IsRunning() then return say("Running to the ball") end
        local started = player.moveTo(function()
            return ball.Position
        end, maxSpeed)
        trip = started
        say(started and "Running to the ball" or "Busy moving")
    end

    local function setActive(on)
        if on == active then return end
        active = on
        armed:DoCleaning()
        stopTrip()
        lastHop = nil
        if on then
            armed:GiveTask(Scheduler.heartbeat(tick, { name = "AutoGrab", interval = TICK }))
        else
            say("Off", true)
        end
    end

    Toggles.AutoGrabEnabled:OnChanged(setActive)

    return {
        cleanup = function()
            stopTrip()
        end,
    }
end

end)
__bundle_register("Features/Basketball/Defense/AutoBlock", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto block: jumps to contest when a nearby opponent starts a shot; each opponent gets one watcher on its Action attribute, the cue the game's own defender raises his hands on (Guard:102) and present on every player and ai, where a Meter show can hang on the show other meters setting and a meter style of None
local Flat = require("Api/Court/Flat")
local Jobs = require("Utility/Jobs")
local Maid = require("Utility/Maid")
local Kit  = require("Features/Basketball/Defense/Kit")

local ACTION = "Action"
local SHOT_ACTIONS = { Shooting = true, Dunking = true, ContactLayup = true, ClutchLayup = true }
local FREE_THROW = "FreeThrow"
local REARM = 0.75  -- an action flicker this soon after a start is the same shot

-- a jumper leaves the hand about 0.39 s in (the meter's perfect step at the measured sweep rates) and a jump takes about 0.28 s to peak, which agrees with the game's own lesson to press as they jump (TutorialTypes.Simple:164)
local DEFAULT_DELAY = 0.1
local DEFAULT_REACH = 10

return function(ctx)
    local Library = ctx.Library
    local Toggles = ctx.Toggles
    local court   = ctx.Api and ctx.Api.Court
    local player  = ctx.Api and ctx.Api.Player
    local jumper  = ctx.Jumper
    local me      = ctx.References.player

    local Group = ctx.Tabs.Defense:AddLeftGroupbox("Auto Block", "shield")
    if not (court and player and jumper) then
        Group:AddLabel("Not available here", true)
        return
    end

    local reach, delay = DEFAULT_REACH, DEFAULT_DELAY

    Group:AddToggle("AutoBlockEnabled", {
        Text = "Auto Block",
        Default = false,
    }):AddKeyPicker("AutoBlockKey", {
        Default = nil,
        SyncToggleState = true,
        Mode = "Toggle",
        Text = "Auto Block",
    })

    local Box = Group:AddDependencyBox()
    Box:AddSlider("AutoBlockReach", {
        Text = "Reach",
        Default = reach,
        Min = 3,
        Max = 20,
        Rounding = 0,
        Suffix = " studs",
        Callback = function(value) reach = value end,
    })
    Box:AddSlider("AutoBlockDelay", {
        Text = "Jump delay",
        Default = delay,
        Min = 0,
        Max = 0.6,
        Rounding = 2,
        Suffix = " s",
        Tooltip = "Time after the shot starts",
        Callback = function(value) delay = value end,
    })
    local say = Kit.writer(Library, Box:AddLabel({ Text = "Off", DoesWrap = true }))
    Box:SetupDependencies({ { Toggles.AutoBlockEnabled, true } })

    local armed = Kit.armedMaid(ctx.track)
    local watchers = Maid.new()
    local watched = {}
    local active = false
    local queued = false

    local function distanceTo(rec)
        local root = rec.root
        local position = player.position()
        if not (root and position) then return nil end
        return Flat(root.Position, position)
    end

    local function leap(rec)
        local name = Kit.clean(rec.name)
        if not SHOT_ACTIONS[rec.model:GetAttribute(ACTION)] then
            return say(("%s stopped shooting"):format(name))
        end
        local away = distanceTo(rec)
        if not away or away > reach then
            return say(("%s too far"):format(name))
        end
        local jumped, why = jumper.go()
        if jumped then
            say(("Jumped at %s"):format(name))
        else
            say(why)
        end
    end

    local function shotStarted(rec, watch)
        local now = os.clock()
        if now - watch.startedAt < REARM then return end
        watch.startedAt = now
        if rec.model:GetAttribute(FREE_THROW) then return end
        if queued then return end

        local away = distanceTo(rec)
        if not away then return end
        if away > reach then
            return say(("Too far: %s"):format(Kit.studs(away)))
        end
        local why = jumper.refusal()
        if why then return say(why) end

        local wait = delay - Kit.ping(me)
        if wait <= 0 then return leap(rec) end
        queued = true
        armed.jump = Jobs.delay(wait, function()
            queued = false
            leap(rec)
        end, { name = "AutoBlockJump" })
    end

    local function watch(rec)
        local state = {
            shooting  = SHOT_ACTIONS[rec.model:GetAttribute(ACTION)] == true,
            startedAt = -math.huge,
        }
        local slot = Maid.new()
        slot:GiveTask(rec.model:GetAttributeChangedSignal(ACTION):Connect(function()
            local shooting = SHOT_ACTIONS[rec.model:GetAttribute(ACTION)] == true
            if shooting == state.shooting then return end
            state.shooting = shooting
            if shooting then shotStarted(rec, state) end
        end))
        watchers[rec] = slot
        watched[rec] = true
    end

    -- court owns who is here; this only keeps one watcher per name on its list
    local function syncWatchers()
        local present = {}
        local list = court.opponents()
        for i = 1, #list do
            local rec = list[i]
            present[rec] = true
            if not watched[rec] then watch(rec) end
        end
        for rec in pairs(watched) do
            if not present[rec] then
                watched[rec] = nil
                watchers[rec] = nil
            end
        end
    end

    local function setActive(on)
        if on == active then return end
        active = on
        armed:DoCleaning()
        queued = false
        table.clear(watched)
        if on then
            armed:GiveTask(watchers)
            armed:GiveTask(court.RosterChanged:Connect(syncWatchers))
            syncWatchers()
            say("Watching for a shot", true)
        else
            say("Off", true)
        end
    end

    Toggles.AutoBlockEnabled:OnChanged(setActive)
end

end)
