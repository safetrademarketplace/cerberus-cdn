-- shooting suite: builds the main tab's four shooting groupboxes and mounts each feature into them, sharing one label painter and one owner of the auto release
local Mount = require("Utility/Mount")

local AutoCalibrate  = require("Features/Basketball/Shooting/AutoCalibrate")
local AutoShoot      = require("Features/Basketball/Shooting/AutoShoot")
local Labels         = require("Features/Basketball/Shooting/Labels")
local PerfectRelease = require("Features/Basketball/Shooting/PerfectRelease")
local Release        = require("Features/Basketball/Shooting/Release")
local ReleaseOffset  = require("Features/Basketball/Shooting/ReleaseOffset")
local ShotLog        = require("Features/Basketball/Shooting/ShotLog")
local ShotMeter      = require("Features/Basketball/Shooting/ShotMeter")
local TapToShoot     = require("Features/Basketball/Shooting/TapToShoot")

local UNAVAILABLE = "Not available here"

return function(ctx)
    local O = Mount.orchestrator(ctx, "Shooting")
    if not O then return {} end

    local Apis = ctx.Api or {}
    local Main = ctx.Tabs.Main

    local shootingBox = Main:AddLeftGroupbox("Shooting", "target")
    local logBox      = Main:AddLeftGroupbox("Shot Log", "scroll-text")
    local autoBox     = Main:AddRightGroupbox("Auto Shoot", "crosshair")
    local meterBox    = Main:AddRightGroupbox("Shot Meter", "gauge")

    if Apis.Shot and Apis.Input then
        local labels  = Labels.new(ctx.Library, O.track)
        local release = Release.new(Apis.Shot)

        O.track(Apis.Shot.Finished:Connect(labels.touch))

        local perfect = O.mount(PerfectRelease, O.subCtx({ Group = shootingBox, Release = release }))
        O.mount(TapToShoot, O.subCtx({ Perfect = perfect }))
        O.mount(ReleaseOffset, O.subCtx({ Perfect = perfect, Labels = labels }))
        O.mount(AutoCalibrate, O.subCtx({ Group = shootingBox, Labels = labels }))
        O.mount(ShotLog, O.subCtx({ Group = logBox, Labels = labels }))

        if Apis.Court and Apis.Player then
            O.mount(AutoShoot, O.subCtx({ Group = autoBox, Labels = labels, Release = release }))
        else
            autoBox:AddLabel(UNAVAILABLE, true)
        end
    else
        shootingBox:AddLabel(UNAVAILABLE, true)
        logBox:AddLabel(UNAVAILABLE, true)
        autoBox:AddLabel(UNAVAILABLE, true)
    end

    if Apis.Prefs then
        O.mount(ShotMeter, O.subCtx({ Group = meterBox }))
    else
        meterBox:AddLabel(UNAVAILABLE, true)
    end

    O.finalize()

    return {}
end

end)
__bundle_register("Features/Basketball/Shooting/TapToShoot", function(require, _LOADED, __bundle_register, __bundle_modules)
-- tap to shoot: one tap is held for you until perfect release lets go on the green; it runs only while both its toggle and perfect release are on, and because it swallows your let-go, a shot it was holding is never left held when that ends
local UiWrite = require("Utility/UiWrite")

return function(ctx)
    local Input   = ctx.Api.Input
    local Library = ctx.Library
    local Shot    = ctx.Api.Shot
    local perfect = ctx.Perfect
    local track   = ctx.track

    local toggle

    local function apply()
        local want = toggle.Value == true and perfect.enabled()
        if want == Shot.tapToShoot() then return end

        local shot = Shot.current()
        local owed = not want and shot ~= nil and not shot.released
        local ok = Shot.setTapToShoot(want)
        if owed and not Shot.autoRelease() then Input.shootRelease() end

        if want and not ok then
            UiWrite.notify(Library, "Couldn't start Tap To Shoot", 5)
            UiWrite.value(toggle, false)
        end
    end

    toggle = perfect.box:AddToggle("TapToShoot", {
        Text     = "Tap To Shoot",
        Default  = false,
        Tooltip  = "No need to hold the button",
        Callback = apply,
    })

    perfect.onChanged(apply)

    -- a shot can close with no release ever sent, and the let-go it swallowed will not come again
    track(Shot.Finished:Connect(function(shot)
        if Shot.tapToShoot() and not shot.released then Input.shootRelease() end
    end))

    return {
        cleanup = function()
            if Shot.tapToShoot() then Shot.setTapToShoot(false) end
        end,
    }
end

end)
__bundle_register("Features/Basketball/Shooting/ShotMeter", function(require, _LOADED, __bundle_register, __bundle_modules)
-- shot meter: picks your meter style and whether you see other players' meters; both reach your account through the prefs api, which puts them back on unload, and the menu is filled and kept honest from a job because reading the game mid-build would drop the thread identity
local Jobs    = require("Utility/Jobs")
local UiWrite = require("Utility/UiWrite")

local SYNC_EVERY = 1

local STYLES = { "Vertical", "Bat", "Hoop", "Roblox", "Rocket", "Funnel", "Pill", "Arrow", "Diamond", "Funnel2", "Tube", "None" }

return function(ctx)
    local Library = ctx.Library
    local Options = ctx.Options
    local Prefs   = ctx.Api.Prefs
    local Toggles = ctx.Toggles
    local group   = ctx.Group
    local track   = ctx.track

    local filled, syncing = false, false
    local wantedStyle, wantedOthers = nil, nil

    -- writing back into the menu fires the control's callback, and that must not reach the account
    local function quietly(element, value)
        syncing = true
        UiWrite.value(element, value)
        syncing = false
    end

    local function showCurrent()
        local style = Prefs.meterStyle()
        if style and style ~= Options.MeterStyle.Value then quietly(Options.MeterStyle, style) end
        local ok, others = Prefs.showOtherMeters()
        if ok and others ~= Toggles.MeterShowOthers.Value then quietly(Toggles.MeterShowOthers, others) end
    end

    -- a choice made before your settings load, usually by a config, waits for them instead of being lost
    local function applyStyle(style)
        local ok, err = Prefs.setMeterStyle(style)
        if not ok and err == Prefs.Errors.NOT_READY then
            wantedStyle = style
            return
        end
        wantedStyle = nil
        if ok then return end
        UiWrite.notify(Library, "Couldn't change the meter", 3)
        showCurrent()
    end

    local function applyOthers(on)
        local ok, err = Prefs.setShowOtherMeters(on)
        if not ok and err == Prefs.Errors.NOT_READY then
            wantedOthers = on
            return
        end
        wantedOthers = nil
        if ok then return end
        UiWrite.notify(Library, "Couldn't change that", 3)
        showCurrent()
    end

    local function sync()
        if not filled then
            local ok, list = Prefs.meterStyles()
            if not ok then return end
            filled = true
            UiWrite.values(Options.MeterStyle, list)
        end
        if wantedStyle then applyStyle(wantedStyle) end
        if wantedOthers ~= nil then applyOthers(wantedOthers) end
        if Library.Toggled and not wantedStyle and wantedOthers == nil then showCurrent() end
    end

    group:AddDropdown("MeterStyle", {
        Text     = "Meter",
        Values   = STYLES,
        Default  = STYLES[1],
        Tooltip  = "Every style works, even None",
        Callback = function(style)
            if not syncing then applyStyle(style) end
        end,
    })

    group:AddToggle("MeterShowOthers", {
        Text     = "Show other meters",
        Default  = false,
        Callback = function(on)
            if not syncing then applyOthers(on) end
        end,
    })

    group:AddButton({
        Text    = "Put back",
        Tooltip = "Restores your original meter",
        Func = function()
            wantedStyle, wantedOthers = nil, nil
            local ok = Prefs.restoreMeter()
            if not ok then UiWrite.notify(Library, "Settings not loaded yet", 3) end
            showCurrent()
        end,
    })

    track(Jobs.interval(SYNC_EVERY, sync, { name = "ShotMeterSync" }))

    return {}
end

end)
