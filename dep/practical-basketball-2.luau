        stepEntry = emit({ text = rendered, color = resolveColor(color) })
        return
    end
    stepEntry.text, stepEntry.color = rendered, resolveColor(color)
    flush(stepEntry)
end

-- discrete one-off colored line (webhook syncs, notices); each gets its own line
function M.log(text, color)
    emit({ text = tostring(text), color = resolveColor(color) })
end

-- drops the console watchers so a relaunched session's history is the only one being rebound
function M.stop()
    if masterConn then masterConn:Disconnect() end
    if enabledConn then enabledConn:Disconnect() end
    if windowConn then windowConn:Disconnect() end
    if coreConn then coreConn:Disconnect() end
    if resolver then resolver:Cancel() end
    masterConn, enabledConn, windowConn, coreConn = nil, nil, nil, nil
    master, window, resolver = nil, nil, nil
    requested = false
    table.clear(history)
    stepEntry = nil
end

return M

