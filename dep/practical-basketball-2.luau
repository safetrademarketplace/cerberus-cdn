__bundle_register("Features/Basketball/Shooting/Words", function(require, _LOADED, __bundle_register, __bundle_modules)
-- shot words: plain names for what the game calls a shot and the short phrases the menu shows for one
local KINDS = {
    ThreePointShot    = "Three",
    MidRangeShot      = "Mid",
    CloseShot         = "Close",
    UnderRimCloseShot = "Close",
    FreeThrow         = "Free throw",
    Jumpshot          = "Jumper",
    MovingShot        = "Moving shot",
    FadeAway          = "Fadeaway",
    Layup             = "Layup",
    DrivingLayup      = "Layup",
    InsideHandLayup   = "Layup",
    ReverseLayup      = "Layup",
    ContactLayup      = "Layup",
    StandingDunk      = "Dunk",
    DrivingDunk       = "Dunk",
    ReverseDunk       = "Dunk",
}

local NO_GRADE = "No grade"

local M = {}

function M.kind(kind)
    if type(kind) ~= "string" or kind == "" then return "Shot" end
    return KINDS[kind] or (string.gsub(kind, "(%l)(%u)", "%1 %2"))
end

-- floored, because the top of the game's scale is 102.5 and it should read as 102
function M.chance(chance)
    if type(chance) ~= "number" then return nil end
    return ("%d%%"):format(math.floor(chance))
end

-- the game rounds this one for its own contested line
function M.contest(contest)
