__bundle_register("Features/Player/Movement/Guard", function(require, _LOADED, __bundle_register, __bundle_modules)
-- movement guard: what every feature needs around a player api call, its own thread to make the call on and a plain english no when the api refuses; a feature that could not start never reads as on
local UiWrite = require("Utility/UiWrite")

local M = {}

function M.words(Player, err)
    local Errors = Player.Errors
    if err == Errors.BUSY then return "Your player is busy" end
    if err == Errors.NO_CHARACTER then return "Join a game first" end
    if err == Errors.NO_MOVEMENT then return "Game not ready yet" end
    if err == Errors.OUT_OF_RANGE then return "Outside the map" end
    return "That didn't work"
end

function M.say(Library, Player, err)
    UiWrite.notify(Library, M.words(Player, err), 3)
end

function M.backOut(Library, toggle, Player, err)
    M.say(Library, Player, err)
    if toggle.Value then UiWrite.value(toggle, false) end
end

-- reading a game module costs a thread its identity, and the menu or a config load is still using the one it hands this callback
function M.drive(toggle, start, stop)
    toggle:OnChanged(function()
        task.spawn(toggle.Value and start or stop)
    end)
end

return M

end)
__bundle_register("Features/Player/Movement", function(require, _LOADED, __bundle_register, __bundle_modules)
-- movement orchestrator: wires Flight, Speed, Jump, ClickTp, ClickWalk and PositionRewind onto the player api, because humanoid writes, root teleports and constraints do nothing in this game
local Mount          = require("Utility/Mount")
local ClickTp        = require("Features/Player/Movement/ClickTp")
local ClickWalk      = require("Features/Player/Movement/ClickWalk")
local Flight         = require("Features/Player/Movement/Flight")
local Jump           = require("Features/Player/Movement/Jump")
local PositionRewind = require("Features/Player/Movement/PositionRewind")
local Speed          = require("Features/Player/Movement/Speed")

return function(ctx)
    local O = Mount.orchestrator(ctx, "Movement")
    if not O then return end

    -- nothing here can work without it, and a missing movement api is already handled by SessionLifecycle
    local Player = ctx.Api and ctx.Api.Player
    if not Player then
        ctx.Tabs.Player:AddLeftGroupbox("Movement", "move"):AddLabel("Not available here", true)
        return
    end

    -- O.mount so a crashing sub-module factory can't take down siblings; manual onUnload stays since these expose stopX, not cleanup
    local subCtx = O.subCtx({ Player = Player })
    local flightAPI    = O.mount(Flight, subCtx)
    local speedAPI     = O.mount(Speed, subCtx)
    local jumpAPI      = O.mount(Jump, subCtx)
    local clickTpAPI   = O.mount(ClickTp, subCtx)
    local clickWalkAPI = O.mount(ClickWalk, subCtx)
    local rewindAPI    = O.mount(PositionRewind, subCtx)

    local API = {
        startFlight       = flightAPI.startFlight,
        stopFlight        = flightAPI.stopFlight,
        startSpeed        = speedAPI.startSpeed,
        stopSpeed         = speedAPI.stopSpeed,
        startJumpMod      = jumpAPI.startJumpMod,
        stopJumpMod       = jumpAPI.stopJumpMod,
        startInfiniteJump = jumpAPI.startInfiniteJump,
        stopInfiniteJump  = jumpAPI.stopInfiniteJump,
        startClickTP      = clickTpAPI.startClickTP,
        stopClickTP       = clickTpAPI.stopClickTP,
        stopClickWalk     = clickWalkAPI.stopClickWalk,
        startRewind       = rewindAPI.startRewind,
        stopRewind        = rewindAPI.stopRewind,
    }

    O.onUnload(function()
        if API.stopClickWalk    then API.stopClickWalk() end
        if API.stopFlight       then API.stopFlight() end
        if API.stopSpeed        then API.stopSpeed() end
        if API.stopJumpMod      then API.stopJumpMod() end
        if API.stopInfiniteJump then API.stopInfiniteJump() end
        if API.stopClickTP      then API.stopClickTP() end
        if API.stopRewind       then API.stopRewind() end
    end)
    O.finalize()

    return API
end

end)
