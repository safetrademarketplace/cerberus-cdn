__bundle_register("Features/Basketball/Body/Takeover", function(require, _LOADED, __bundle_register, __bundle_modules)
-- takeover sub-module of body: charge, ready and live readout plus the boost list, with an alert; the game starts a takeover by itself and the client has no call for it, so nothing here can start one or claims to
local Jobs    = require("Utility/Jobs")
local UiWrite = require("Utility/UiWrite")

local FULL_BAR = 100
-- the build's pick lands after the bar does and changes nothing the signal watches
local READ_EVERY = 2

local function plain(text)
    return (tostring(text or ""):gsub("[<>]", ""))
end

local function spaced(name)
    return (plain(name):gsub("(%l)(%u)", "%1 %2"))
end

local function amount(value)
    if value % 1 == 0 then return ("%d"):format(value) end
    return ("%.1f"):format(value)
end

-- every takeover is a flat bonus to all stats plus a few spikes, so the value most stats share is the flat part; with no majority there is no honest every-stat claim
local function flatPart(attributes)
    local seen, total, best, bestCount = {}, 0, nil, 0
    for _, value in pairs(attributes) do
        total = total + 1
        seen[value] = (seen[value] or 0) + 1
        if seen[value] > bestCount or (seen[value] == bestCount and value < best) then
            best, bestCount = value, seen[value]
        end
    end
    return bestCount * 2 > total and best or nil
end

local function describeBoosts(boosts)
    if not boosts then return nil end
    local flat = flatPart(boosts.attributes)
    local spikes = {}
    for name, value in pairs(boosts.attributes) do
        if value ~= flat then spikes[#spikes + 1] = { name = spaced(name), value = value } end
    end
    table.sort(spikes, function(a, b)
        if a.value ~= b.value then return a.value > b.value end
        return a.name < b.name
    end)
    local parts = {}
    for i, spike in ipairs(spikes) do
        parts[i] = ("%s %s%s"):format(spike.name, spike.value > 0 and "+" or "", amount(spike.value))
    end
    local list = table.concat(parts, ", ")
    if flat and #parts > 0 then return ("All stats +%s. More: %s"):format(amount(flat), list) end
    if flat then return ("All stats +%s"):format(amount(flat)) end
    if #parts > 0 then return ("Boosts: %s"):format(list) end
    return nil
end

return function(ctx)
    local Tabs    = ctx.Tabs
    local Library = ctx.Library
    local Toggles = ctx.Toggles
    local track   = ctx.track
    local Player  = ctx.Api and ctx.Api.Player

    local Group = Tabs.Main:AddLeftGroupbox("Takeover", "flame")

    if not Player then
        Group:AddLabel("Not available here", true)
        return {}
    end

    Group:AddToggle("TakeoverAlert", {
        Text    = "Alert when ready",
        Default = true,
    })

    local stateLabel = Group:AddLabel("Loading…", true)
    local boostLabel = Group:AddLabel("", true)

    local seen, wasFull, wasActive = false, false, false
    local shownKind, shownBoosts
    local shown = {}

    local function write(label, text)
        if shown[label] == text then return end
        if UiWrite.text(label, text) then shown[label] = text end
    end

    -- a miss is never remembered: the config can land after the build does
    local function paintBoosts(kind)
        if kind == shownKind and shownBoosts then return end
        shownKind = kind
        shownBoosts = kind and describeBoosts(Player.takeoverBoosts(kind)) or nil
        write(boostLabel, shownBoosts or "")
    end

    -- rides the bar being full and not the ready flag, because a takeover ending on a full bar flips ready back on and would read as a fresh fill
    local function alert(active, full)
        if not (seen and Toggles.TakeoverAlert.Value) then return end
        if active and not wasActive then
            UiWrite.notify(Library, "Takeover live", 4)
        elseif full and not wasFull and not active then
            UiWrite.notify(Library, "Takeover bar full", 4)
        end
    end

    local function update(now)
        if not now then
            seen, wasFull, wasActive = false, false, false
            write(stateLabel, "Waiting for your player")
            return
        end
        local word = now.active and "live" or (now.ready and "full" or "charging")
        local fill = math.floor(math.clamp(now.fill, 0, FULL_BAR))
        write(stateLabel, ("%s: %d%%, %s"):format(plain(now.kind or "Takeover"), fill, word))
        paintBoosts(now.kind)
        local active, full = now.active, now.fill >= FULL_BAR
        alert(active, full)
        seen, wasFull, wasActive = true, full, active
    end

    local function refresh()
        update(Player.takeover())
    end

    -- turning it on forgets the bar, so one that is already full still gets announced once
    Toggles.TakeoverAlert:OnChanged(function()
        if Toggles.TakeoverAlert.Value then wasFull, wasActive = false, false end
        task.spawn(refresh)
    end)

    track(Player.TakeoverChanged:Connect(update))
    track(Jobs.interval(READ_EVERY, refresh, { immediate = true, name = "BodyTakeover" }))

    return {}
end

end)
__bundle_register("Features/Basketball/Body/Stamina", function(require, _LOADED, __bundle_register, __bundle_modules)
-- infinite stamina sub-module of body: holds the sprint flag and a full stamina reading together, because the game's speed code checks both and sprint alone does not hold at zero, and reads out the real stamina the server still has
local Jobs    = require("Utility/Jobs")
local UiWrite = require("Utility/UiWrite")
local Guard   = require("Features/Player/Movement/Guard")

local FULL_STAMINA = 100
-- an override hides the server's writes from every watcher, so the real number has to be read
local READ_EVERY = 0.25

return function(ctx)
    local Tabs    = ctx.Tabs
    local Library = ctx.Library
    local Toggles = ctx.Toggles
    local track   = ctx.track
    local Player  = ctx.Api and ctx.Api.Player

    local Group = Tabs.Main:AddLeftGroupbox("Stamina", "battery-charging")

    if not Player then
        Group:AddLabel("Not available here", true)
        return {}
    end

    local readout = Group:AddLabel("Loading…", true)

    Group:AddToggle("InfiniteStamina", {
        Text    = "Infinite Stamina",
        Default = false,
        Tooltip = "Does not make you faster",
    }):AddKeyPicker("InfiniteStaminaKey", {
        Default         = nil,
        SyncToggleState = true,
        Mode            = "Toggle",
    })

    local stopSprint, stopFull, heldMax
    local shown

    local function paint(current, max)
        local text
        if current then
            text = ("Real stamina: %d%%"):format(math.floor(current / max * 100 + 0.5))
        else
            text = "Waiting for your player"
        end
        if text == shown then return end
        if UiWrite.text(readout, text) then shown = text end
    end

    -- a new body or build can have a different maximum, and the fresh hold goes on before the stale one comes off
    local function followMax(max)
        if not (stopFull and max and max ~= heldMax) then return end
        local fresh = Player.overrideAttr("Stamina", max)
        if not fresh then return end
        local stale = stopFull
        stopFull, heldMax = fresh, max
        stale()
    end

    local function tick()
        local current, max = Player.trueStamina()
        followMax(max)
        paint(current, max)
    end

    local function start()
        if stopSprint then return end
        local sprint, sprintErr = Player.forceSprint()
        if not sprint then
            Guard.backOut(Library, Toggles.InfiniteStamina, Player, sprintErr)
            return
        end
        local _, max = Player.trueStamina()
        max = max or FULL_STAMINA
        local full, fullErr = Player.overrideAttr("Stamina", max)
        if not full then
            sprint()
            Guard.backOut(Library, Toggles.InfiniteStamina, Player, fullErr)
            return
        end
        stopSprint, stopFull, heldMax = sprint, full, max
        tick()
    end

    local function stop()
        if not stopSprint then return end
        local sprint, full = stopSprint, stopFull
        stopSprint, stopFull, heldMax = nil, nil, nil
        full()
        sprint()
        tick()
    end

    Guard.drive(Toggles.InfiniteStamina, start, stop)

    track(Jobs.interval(READ_EVERY, tick, { immediate = true, name = "BodyStamina" }))

    return { cleanup = stop }
end

end)
__bundle_register("Features/Basketball/Body/Instant", function(require, _LOADED, __bundle_register, __bundle_modules)
-- instant input sub-module of body: cuts the wait the game's client adds to your shot and dribble keys through the input api, and your own numbers come back when it goes off or the script unloads; the shot wait is also how the game spots a double tap, so a short window can stay to keep it
local Jobs    = require("Utility/Jobs")
local UiWrite = require("Utility/UiWrite")
local Guard   = require("Features/Player/Movement/Guard")

local TAP_MIN_MS, TAP_MAX_MS, TAP_DEFAULT_MS = 20, 250, 80
-- the slider fires on every pixel of a drag, and only where it stops is worth writing
local SLIDER_SETTLE = 0.15
-- the settings arrive after the menu is built, and can change while it runs
local READ_EVERY = 2

local function milliseconds(seconds)
    return math.floor(seconds * 1000 + 0.5)
end

local function saving(own, applied, what)
    if type(own) ~= "number" or applied == nil then return nil end
    local saved = milliseconds(own) - milliseconds(applied)
    return saved > 0 and ("%d ms %s"):format(saved, what) or nil
end

local function waiting(own, what)
    return type(own) == "number" and ("%d ms %s"):format(milliseconds(own), what) or nil
end

local function joined(first, second)
    if first and second then return first .. ", " .. second end
    return first or second
end

return function(ctx)
    local Tabs    = ctx.Tabs
    local Options = ctx.Options
    local Toggles = ctx.Toggles
    local track   = ctx.track
    local Input   = ctx.Api and ctx.Api.Input
    local instant = Input and Input.instant

    local Group = Tabs.Main:AddRightGroupbox("Instant Input", "zap")

    if not instant then
        Group:AddLabel("Not available here", true)
        return {}
    end

    Group:AddToggle("InstantInputEnabled", {
        Text    = "Instant Input",
        Default = false,
        Tooltip = "Removes shot and dribble key delay",
    }):AddKeyPicker("InstantInputKey", {
        Default         = nil,
        SyncToggleState = true,
        Mode            = "Toggle",
    })

    local Box = Group:AddDependencyBox()

    Box:AddToggle("InstantInputShooting", {
        Text    = "Shooting",
        Default = true,
    })

    Box:AddToggle("InstantInputDribbling", {
        Text    = "Dribbling",
        Default = true,
    })

    Box:AddToggle("InstantInputKeepDoubleTap", {
        Text    = "Keep double taps",
        Default = true,
        Tooltip = "Double tap shots still work",
    })

    local WindowBox = Box:AddDependencyBox()

    WindowBox:AddSlider("InstantInputTapWindow", {
        Text     = "Double tap window",
        Default  = TAP_DEFAULT_MS,
        Min      = TAP_MIN_MS,
        Max      = TAP_MAX_MS,
        Rounding = 0,
        Suffix   = " ms",
        Tooltip  = "Lower is faster but harder",
    })

    local readout = Group:AddLabel("Loading…", true)

    Box:SetupDependencies({ { Toggles.InstantInputEnabled, true } })
    WindowBox:SetupDependencies({
        { Toggles.InstantInputEnabled, true },
        { Toggles.InstantInputShooting, true },
        { Toggles.InstantInputKeepDoubleTap, true },
    })

    local applied
    local settle
    local shown

    local function wanted()
        return Toggles.InstantInputEnabled.Value
            and (Toggles.InstantInputShooting.Value or Toggles.InstantInputDribbling.Value)
    end

    local function describe()
        local own = instant.delays()
        if not own then return "Waiting for your settings" end
        if not applied then
            if Toggles.InstantInputEnabled.Value and not wanted() then return "Pick Shooting or Dribbling" end
            local waits = joined(waiting(own.shoot, "shots"), waiting(own.dribble, "dribbles"))
            return waits and ("Off: %s"):format(waits) or "Off"
        end
        local saved = joined(saving(own.shoot, applied.shoot, "shots"), saving(own.dribble, applied.dribble, "dribbles"))
        local text = saved and ("Saved: %s"):format(saved) or "Already instant"
        if applied.shoot == 0 then return text .. "\nDouble taps off" end
        if applied.shoot then return text .. ("\nDouble taps: %d ms"):format(milliseconds(applied.shoot)) end
        return text
    end

    local function paint()
        local text = describe()
        if text == shown then return end
        if UiWrite.text(readout, text) then shown = text end
    end

    -- never hands back a longer wait than the player already had, whatever the slider says
    local function shotDelay(own)
        if not Toggles.InstantInputShooting.Value then return nil end
        if not Toggles.InstantInputKeepDoubleTap.Value then return 0 end
        local window = Options.InstantInputTapWindow.Value / 1000
        local mine = own and own.shoot
        return type(mine) == "number" and math.min(window, mine) or window
    end

    -- a refusal only means the settings are not here yet, so the toggle stays on and the regular read tries again
    local function apply()
        if not wanted() then
            instant.disable()
            applied = nil
        else
            local shoot = shotDelay(instant.delays())
            local dribble = Toggles.InstantInputDribbling.Value and 0 or nil
            applied = instant.setDelays(shoot, dribble) and { shoot = shoot, dribble = dribble } or nil
        end
        paint()
    end

    local function tick()
        if wanted() and not instant.isEnabled() then apply() else paint() end
    end

    for _, name in ipairs({ "InstantInputEnabled", "InstantInputShooting", "InstantInputDribbling", "InstantInputKeepDoubleTap" }) do
        Guard.drive(Toggles[name], apply, apply)
    end

    Options.InstantInputTapWindow:OnChanged(function()
        if settle then settle:Cancel() end
        settle = Jobs.delay(SLIDER_SETTLE, apply, { name = "BodyInstantSettle" })
    end)

    track(Jobs.interval(READ_EVERY, tick, { immediate = true, name = "BodyInstant" }))

    return {
        cleanup = function()
            if settle then settle:Cancel() end
            task.spawn(instant.disable)
        end,
    }
end

end)
__bundle_register("Features/Basketball/Body/Form", function(require, _LOADED, __bundle_register, __bundle_modules)
-- form sub-module of body: shows the game's cold flag, the green window size and what recent shots really got for make chance, split by cold and normal, because the client cannot read what cold does and can only measure it; cold belongs to the server and nothing here changes it
local Jobs    = require("Utility/Jobs")
local UiWrite = require("Utility/UiWrite")

local RECENT_SHOTS = 5
-- the server moves the window mid-shot with no signal to hang off
local READ_EVERY = 0.25

local function shotCount(count)
    return ("%d shot%s"):format(count, count == 1 and "" or "s")
end

local function bucketText(bucket)
    if bucket.count == 0 then return "none" end
    return ("%.1f (%s)"):format(bucket.sum / bucket.count, shotCount(bucket.count))
end

return function(ctx)
    local Tabs   = ctx.Tabs
    local track  = ctx.track
    local Player = ctx.Api and ctx.Api.Player
    local Shot   = ctx.Api and ctx.Api.Shot

    local Group = Tabs.Main:AddRightGroupbox("Form", "snowflake")

    if not (Player and Shot) then
        Group:AddLabel("Not available here", true)
        return {}
    end

    local formLabel = Group:AddLabel("Loading…", true)
    local windowLabel = Group:AddLabel("", true)
    local chanceLabel = Group:AddLabel("", true)

    local widest = {}
    local cold, normal = { count = 0, sum = 0 }, { count = 0, sum = 0 }
    local startedId, startedCold
    local shown = {}

    local function write(label, text)
        if shown[label] == text then return end
        if UiWrite.text(label, text) then shown[label] = text end
    end

    local function isCold()
        return Player.attr("Cold") == true
    end

    local function formText()
        if not Player.model() then return "Waiting for your player" end
        return isCold() and "Cold" or "Normal"
    end

    local function windowText()
        local shot = Shot.current() or Shot.lastShot()
        local green = shot and shot.green
        if not green then return "Green window: waiting" end
        local top = widest[shot.style]
        if not top or green > top then
            top = green
            widest[shot.style] = green
        end
        if green == top then return ("Green window: %.2f, your best"):format(green) end
        return ("Green window: %.2f, best %.2f"):format(green, top)
    end

    local function chanceText()
        local sum, count = 0, 0
        for _, shot in ipairs(Shot.history()) do
            if shot.chance then
                sum, count = sum + shot.chance, count + 1
                if count == RECENT_SHOTS then break end
            end
        end
        if count == 0 then return "Make chance: waiting" end
        return ("Make chance: %.1f (last %s)\nCold: %s\nNormal: %s"):format(
            sum / count, shotCount(count), bucketText(cold), bucketText(normal))
    end

    local function paint()
        write(formLabel, formText())
        write(windowLabel, windowText())
        write(chanceLabel, chanceText())
    end

    -- read as the shot starts, because the server can change the flag on how it ends
    track(Shot.Started:Connect(function(shot)
        startedId, startedCold = shot.id, isCold()
    end))

    track(Shot.Finished:Connect(function(shot)
        if not shot.chance then return end
        local wasCold = startedCold
        if startedId ~= shot.id then wasCold = isCold() end
        local bucket = wasCold and cold or normal
        bucket.count = bucket.count + 1
        bucket.sum = bucket.sum + shot.chance
    end))

    track(Jobs.interval(READ_EVERY, paint, { immediate = true, name = "BodyForm" }))

    return {}
end

end)
