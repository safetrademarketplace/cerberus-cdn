    end

    local function watchGoal(rec, folder, slot)
        rec.goal = nil
        if not folder then return end
        Watch.child(slot, folder, GOAL_NAME, function(value, valueSlot)
            rec.goal = value and value.Value or nil
            if not value then return end
            valueSlot:GiveTask(value:GetPropertyChangedSignal("Value"):Connect(function()
                rec.goal = value.Value
            end))
        end)
    end

    local function readTeam(rec)
        local model = rec.model
        local team, index, court = numberAttr(model, "Team"), numberAttr(model, "TeamIndex"), numberAttr(model, "CourtNumber")
        if team == rec.team and index == rec.teamIndex and court == rec.court then return end
        rec.team, rec.teamIndex, rec.court = team, index, court
        if rec == mine then classifyAll() else classify(rec) end
        settle()
    end

    local function bind(model)
        local body = Maid.new()
        local rec = {
            model     = model,
            name      = model.Name,
            team      = numberAttr(model, "Team"),
            teamIndex = numberAttr(model, "TeamIndex"),
            court     = numberAttr(model, "CourtNumber"),
            isLocal   = false,
            isAlly    = false,
        }
        records[model] = rec
        bodies[model] = body
        claimName(rec)
        listsStale = true
        refreshMine()
        classify(rec)

        local function teamChanged() readTeam(rec) end
        body:GiveTask(model:GetAttributeChangedSignal("Team"):Connect(teamChanged))
        body:GiveTask(model:GetAttributeChangedSignal("TeamIndex"):Connect(teamChanged))
        body:GiveTask(model:GetAttributeChangedSignal("CourtNumber"):Connect(teamChanged))

        -- last, because a body renamed mid-hold fires possession from here and the record has to be whole by then
        Watch.child(body, model, ROOT_NAME, function(root, slot) watchRoot(rec, root, slot) end)
        Watch.child(body, model, FOLDER_NAME, function(folder, slot) watchGoal(rec, folder, slot) end)
    end

    -- anyone holding this record keeps a dead one: no root and no ball, so it cannot read a recycled body
    local function drop(rec)
        local model = rec.model
        records[model] = nil
        bodies[model] = nil
        releaseName(rec)
        rec.root, rec.joint, rec.goal, rec.side = nil, nil, nil, nil
        rec.isLocal, rec.isAlly = false, false
        listsStale = true
        refreshMine()
        setHeld(rec, nil)
    end

    local function rename(rec, name)
        releaseName(rec)
        rec.name = name
        claimName(rec)
        classify(rec)
    end

    local function sync(model)
        local name = model.Name
        local rec = records[model]
        if name == DUMMY_NAME then
            if not rec then return false end
            drop(rec)
        elseif not rec then
            bind(model)
        elseif rec.name ~= name then
            rename(rec, name)
        else
            return false
        end
        return true
    end

    local function track(child)
        if not child:IsA("Model") then return false end
        local watch = Maid.new()
        watch:GiveTask(child:GetPropertyChangedSignal("Name"):Connect(function()
            if sync(child) then settle() end
        end))
        renames[child] = watch
        return sync(child)
    end

    local function untrack(child)
        renames[child] = nil
        local rec = records[child]
        if not rec then return end
        drop(rec)
        settle()
    end

    local function bindFolder(folder, slot)
        for _, rec in pairs(records) do drop(rec) end
        renames:DoCleaning()
        if folder then
            slot:GiveTask(folder.ChildAdded:Connect(function(child)
                if track(child) then settle() end
            end))
            slot:GiveTask(folder.ChildRemoved:Connect(untrack))
            for _, child in ipairs(folder:GetChildren()) do track(child) end
        end
        settle()
    end

    -- fresh arrays on each rebuild so a caller mid-iteration keeps a stable snapshot, and a read between changes is one branch
    local function flush()
        if not listsStale then return end
        listsStale = false
        local nextAll, nextAllies, nextEnemies, nextBenched = {}, {}, {}, {}
        for _, rec in pairs(records) do
            nextAll[#nextAll + 1] = rec
            local side = rec.side
            if side == SIDE_ALLY then
                nextAllies[#nextAllies + 1] = rec
            elseif side == SIDE_ENEMY then
                nextEnemies[#nextEnemies + 1] = rec
            elseif side == SIDE_BENCH then
                nextBenched[#nextBenched + 1] = rec
            end
        end
        table.sort(nextAll, byName)
        table.sort(nextAllies, byName)
        table.sort(nextEnemies, byName)
        table.sort(nextBenched, byName)
        all, allies, enemies, benched = nextAll, nextAllies, nextEnemies, nextBenched
    end

    local function recordOf(model)
        local rec = records[model]
        if rec then return rec end
        -- a cloneref'd handle keys differently, so the name index gets a second look
        if typeof(model) == "Instance" then return named[model.Name] end
        return nil
    end

    return {
        bindFolder = bindFolder,
        recordOf   = recordOf,
        me         = function() return mine end,

        players   = function() flush() return all end,
        teammates = function() flush() return allies end,
        opponents = function() flush() return enemies end,
        bench     = function() flush() return benched end,

        -- a ball coming or going moves no joint, so held balls are re-read off the welds
        rereadHeld = function()
            for _, rec in pairs(records) do readHeld(rec) end
        end,

        reclassify = function()
            classifyAll()
            settle()
        end,
    }
end

