                DoesWrap = true,
            })
        end
    end

    do
        local Link = ctx.Api and ctx.Api.Link
        if Link and Link.Mode() ~= "off" then
            local linkGroup = Tabs.Home:AddRightGroupbox("Dashboard", "monitor-smartphone")
