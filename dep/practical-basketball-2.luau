__bundle_register("Features/Basketball/Defense/PlayFeed", function(require, _LOADED, __bundle_register, __bundle_modules)
-- play feed: lists the plays the game credits you with (InterfaceService.Grade carries one id into Config.Enum.Grade), keeps a running total and shows your teammate grade; listens only while it is on
local Jobs      = require("Utility/Jobs")
local Log       = require("Utility/Log")
local Scheduler = require("Utility/Scheduler")
local UiWrite   = require("Utility/UiWrite")
local Kit       = require("Features/Basketball/Defense/Kit")

local LINES      = 5
local REFRESH    = 1
local BIND_TRIES = 5   -- the remote tree can still be replicating when this switches on
local BIND_WAIT  = 1
local POPUP_TIME = 3

local SERVICE   = "InterfaceService"
local ENUM_PATH = "Config.Enum"
local NO_GRADE  = "Waiting for a match"
local NO_PLAYS  = "No plays yet"

return function(ctx)
    local Library = ctx.Library
    local Toggles = ctx.Toggles
    local net     = ctx.Api and ctx.Api.Net
    local player  = ctx.Api and ctx.Api.Player

    local Group = ctx.Tabs.Defense:AddRightGroupbox("Play Feed", "list")
    if not (net and player) then
        Group:AddLabel("Not available here", true)
        return
    end

    Group:AddToggle("PlayFeedEnabled", {
        Text = "Play Feed",
        Default = false,
        Tooltip = "Plays you get credit for",
    }):AddKeyPicker("PlayFeedKey", {
        Default = nil,
        SyncToggleState = true,
        Mode = "Toggle",
        Text = "Play Feed",
    })

    local Box = Group:AddDependencyBox()
    local sayGrade = Kit.writer(Library, Box:AddLabel({ Text = NO_GRADE, DoesWrap = true }))
    local sayTotal = Kit.writer(Library, Box:AddLabel({ Text = " ", DoesWrap = true }))
    local sayLine = {}
    for i = 1, LINES do
        sayLine[i] = Kit.writer(Library, Box:AddLabel({ Text = i == 1 and NO_PLAYS or " ", DoesWrap = true }))
    end
    Box:AddToggle("PlayFeedPopups", {
        Text = "Pop ups",
        Default = false,
    })

    local armed = Kit.armedMaid(ctx.track)
    local active = false
    local feed = {}
    local good, bad, points = 0, 0, 0

    local function render(always)
        for i = 1, LINES do
            sayLine[i](feed[i] or (i == 1 and NO_PLAYS or " "), always)
        end
        if good == 0 and bad == 0 then
            sayTotal(" ", always)
        else
            sayTotal(("%d good, %d bad, %+d total"):format(good, bad, points), always)
        end
    end

    Box:AddButton({
        Text = "Clear",
        Func = function()
            table.clear(feed)
            good, bad, points = 0, 0, 0
            render(true)
        end,
    })
    Box:SetupDependencies({ { Toggles.PlayFeedEnabled, true } })

    local function push(text)
        table.insert(feed, 1, text)
        feed[LINES + 1] = nil
        render()
        local popups = Toggles.PlayFeedPopups
        if popups and popups.Value then UiWrite.notify(Library, text, POPUP_TIME) end
    end

    local function enum()
        local value = net.shared(ENUM_PATH)
        return type(value) == "table" and value or nil
    end

    -- the table is keyed by the id as a string, and the id reaches us however the server sent it (UI.Shared.Grade:15-18)
    local function playInfo(id)
        local config = enum()
        local grades = config and config.Grade
        local entry = type(grades) == "table" and grades[tostring(id)] or nil
        if type(entry) ~= "table" then return nil end
        return entry.Name, tonumber(entry.Value)
    end

    local function onPlay(id)
        if id == nil then return end
        local name, worth = playInfo(id)
        if not name then return push(("Play %s"):format(Kit.clean(id))) end
        local value = math.floor(worth or 0)
        if value > 0 then
            good = good + 1
        elseif value < 0 then
            bad = bad + 1
        end
        points = points + value
        push(("%+d  %s"):format(value, Kit.clean(name)))
    end

    -- the first argument is whether you won (UI.Court.Summary:29,44)
    local function onSummary(won)
        push(won and "Game over, you won" or "Game over, you lost")
    end

    -- the game's own letter lookup (Components.Court.Grade:36-44)
    local function letterOf(value)
        local config = enum()
        local ranges = config and config.GradeRanges
        if type(ranges) ~= "table" then return "-" end
        local rounded = math.ceil(value)
        for _, range in pairs(ranges) do
            if range.Min <= rounded and rounded < range.Max then return Kit.clean(range.Grade) end
        end
        return "-"
    end

    local function refresh()
        if Library.Toggled == false then return end
        render()
        local value = player.attr("Grade")
        if type(value) ~= "number" then return sayGrade(NO_GRADE) end
        sayGrade(("Teammate grade: %s (%d)"):format(letterOf(value), math.floor(value)))
    end

    -- each pass only asks for what is still missing, so one remote arriving first cannot double the other
    local function listen(job)
        local wanted = { { "Grade", onPlay }, { "Summary", onSummary } }
        for _ = 1, BIND_TRIES do
            local missing = false
            for _, want in ipairs(wanted) do
                if not want.bound then
                    local handle = net.on(SERVICE, want[1], want[2])
                    if handle then
                        armed:GiveTask(handle)
                        want.bound = true
                    else
                        missing = true
                    end
                end
            end
            if not missing then return end
            if not job:sleep(BIND_WAIT) then return end
        end
        Log.devwarn("PlayFeed", "the play remotes never showed up here")
    end

    local function setActive(on)
        if on == active then return end
        active = on
        armed:DoCleaning()
        if not on then return end
        armed:GiveTask(Jobs.spawn(listen, { name = "PlayFeedListen" }))
        armed:GiveTask(Scheduler.heartbeat(refresh, { name = "PlayFeed", interval = REFRESH, deferrable = true }))
        render(true)
    end

    Toggles.PlayFeedEnabled:OnChanged(setActive)
end

end)
__bundle_register("Features/Basketball/Defense/Kit", function(require, _LOADED, __bundle_register, __bundle_modules)
-- defense kit: what the suite's features share and nothing about the game, a maid for what a toggle holds, label text that stays safe and readable, and the connection delay
local Maid    = require("Utility/Maid")
local UiWrite = require("Utility/UiWrite")

local FALLBACK_PING = 0.1

local M = {}

-- track keeps every handle it is given for the whole session, so it gets this one and the toggle churns inside the maid
function M.armedMaid(track)
    local maid = Maid.new()
    track({ Disconnect = function() maid:DoCleaning() end })
    return maid
end

-- a closed menu is never read, so a tick skips it and the next tick with it open catches up; always is for the last word a stopped feature will not repeat
function M.writer(Library, label)
    local shown = nil
    return function(text, always)
        if text == shown then return end
        if Library.Toggled == false and not always then return end
        if UiWrite.text(label, text) then shown = text end
    end
