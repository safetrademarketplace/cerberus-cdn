local HAIR_TAG       = "SmartBone"
local HAIR_ATTRIBUTE = "ActivationDistance"
local HAIR_ACTORS    = "SmartBone-Actors"

local EMITTERS = { ParticleEmitter = true, Beam = true, Trail = true }

-- decor only: characters, the takeover meters, the ball and the tutorial marker all have emitters the game itself switches or that the player needs
local WORLD_ROOTS = { "Map", "Props", "Hoops" }
local STREAKS     = "Streaks"

