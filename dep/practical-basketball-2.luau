    O.mount(Zoom, subCtx)
    O.mount(PerformanceMode, subCtx)
    O.mount(ModSafety, subCtx)
    O.mount(AutoRejoin, subCtx)
    O.mount(AntiAFK, subCtx)
    O.mount(AntiKick, subCtx)
    O.mount(FPSCap, subCtx)

    O.finalize()
    return {}
end

