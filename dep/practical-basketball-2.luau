__bundle_register("Utility/Scheduler", function(require, _LOADED, __bundle_register, __bundle_modules)
-- shared frame scheduler: one runservice connection per lane dispatching a priority-sorted task list under an optional frame budget, so features never hold their own per-frame connections

local Services = require("Services")
local Log      = require("Utility/Log")

local RunService = Services.RunService

local DEFAULT_PRIORITY = 100
local COST_SMOOTHING   = 0.1 -- ema weight for the per-task cost estimate the budget spends against
local MAX_STRIKES      = 3   -- consecutive errors before a task is dropped instead of left to spam
local MAX_STARVES      = 2   -- a deferrable task runs regardless after this many budget skips
local PHASE_SLOTS      = 8   -- start offsets equal-interval tasks are spread across

local M = {}

local budget    = nil -- seconds of dispatch time per frame; nil = unlimited
local paused    = false
local profiling = false
local nextSeq   = 0
local lanes     = {}

-- compaction and sorting happen here, never in the dispatch loop, so the hot path only ever walks a stable array
local function compact(lane)
    local tasks = lane.tasks
    local n = 0
    for i = 1, #tasks do
        local t = tasks[i]
        if t.alive then
            n = n + 1
            tasks[n] = t
        end
    end
    for i = #tasks, n + 1, -1 do
        tasks[i] = nil
    end
    -- seq tiebreak keeps equal priorities in registration order, which table.sort alone does not guarantee
    table.sort(tasks, function(a, b)
        if a.priority ~= b.priority then return a.priority < b.priority end
        return a.seq < b.seq
    end)
    lane.dirty = false
end

local function detach(lane)
    if lane.conn then
        lane.conn:Disconnect()
        lane.conn = nil
    end
end

local function unbind(lane, t)
    if not t.alive then return end
    t.alive = false
    lane.live = lane.live - 1
    lane.dirty = true
    if lane.live > 0 then return end
    detach(lane)
    -- an idle lane would otherwise hold every dead task's closure until something rebinds it
    if not lane.running then compact(lane) end
end

local function makeDispatch(lane)
    return function(a, b)
        if paused then return end
        if lane.dirty then compact(lane) end

        local tasks   = lane.tasks
        local dt      = lane.dtSecond and b or a
        local cap     = budget
        local measure = cap ~= nil or profiling
        local now     = os.clock()
        local spent   = 0

        lane.running = true
        -- `t` may be nil: a task that triggers the unloader clears this array mid-iteration, after the numeric for fixed its bound
        for i = 1, #tasks do
            local t = tasks[i]
            if t and t.alive and now >= t.nextRun then
                if cap and t.deferrable and t.starved < MAX_STARVES and spent + t.cost > cap then
                    t.starved = t.starved + 1
                else
                    t.starved = 0
                    local started = measure and os.clock() or 0
                    local ok, err = pcall(t.fn, dt)
                    if measure then
                        local elapsed = os.clock() - started
                        t.cost = t.cost + (elapsed - t.cost) * COST_SMOOTHING
                        spent = spent + elapsed
                    end
                    -- scheduled off the frame stamp, not the post-run clock, so a slow task can't drift its own cadence
                    t.nextRun = (t.interval > 0) and (now + t.interval) or 0
                    if ok then
                        t.strikes = 0
                    else
                        t.strikes = t.strikes + 1
                        Log.devwarn("Scheduler", "%s/%s errored (%d/%d): %s",
                            lane.name, t.name, t.strikes, MAX_STRIKES, tostring(err))
                        if t.strikes >= MAX_STRIKES then
                            lane.dropped = lane.dropped + 1
                            unbind(lane, t)
                        end
                    end
                end
            end
        end
        lane.running = false

        lane.spent = spent
    end
end

local function newLane(name, signal, dtSecond)
    local lane = {
        name     = name,
        signal   = signal,
        dtSecond = dtSecond, -- Stepped passes (elapsed, delta); render and heartbeat pass delta first
        tasks    = {},
        live     = 0,
        phase    = 0,
        spent    = 0,
        dropped  = 0,
        dirty    = false,
        running  = false,
        conn     = nil,
    }
    lane.dispatch = makeDispatch(lane)
    return lane
end

lanes.render    = newLane("render", RunService.RenderStepped, false)
lanes.heartbeat = newLane("heartbeat", RunService.Heartbeat, false)
lanes.stepped   = newLane("stepped", RunService.Stepped, true)

local function attach(lane)
    if lane.conn then return end
    local ok, conn = pcall(lane.signal.Connect, lane.signal, lane.dispatch)
    if not ok or not conn then
        Log.devwarn("Scheduler", "%s lane failed to connect: %s", lane.name, tostring(conn))
        return
    end
    lane.conn = conn
end

-- Destroy mirrors Disconnect so one handle is equally valid for Mount's track() and Maid:GiveTask()
local function newHandle(lane, t)
    local handle = {}

    function handle:Disconnect()
        unbind(lane, t)
    end

    handle.Destroy = handle.Disconnect

    function handle:SetInterval(seconds)
        t.interval = math.max(0, tonumber(seconds) or 0)
        t.nextRun = 0
    end

    function handle:SetPriority(priority)
        t.priority = tonumber(priority) or DEFAULT_PRIORITY
        lane.dirty = true
    end

    -- read through to the task so Connected stays honest after a strike-out drop, not just after Disconnect
    return setmetatable(handle, {
        __index = function(_, key)
            if key == "Connected" then return t.alive end
            return nil
        end,
    })
end

function M.bind(laneName, fn, opts)
    local lane = lanes[laneName]
    if not lane then
        Log.devwarn("Scheduler", "unknown lane %s", tostring(laneName))
        return nil
    end
    if type(fn) ~= "function" then
        Log.devwarn("Scheduler", "%s bind ignored: fn is %s", lane.name, type(fn))
        return nil
    end

    opts = opts or {}
    nextSeq = nextSeq + 1

    local interval = math.max(0, tonumber(opts.interval) or 0)
    local t = {
        fn         = fn,
        name       = tostring(opts.name or ("task#" .. nextSeq)),
        priority   = tonumber(opts.priority) or DEFAULT_PRIORITY,
        interval   = interval,
        deferrable = opts.deferrable == true,
        seq        = nextSeq,
        alive      = true,
        cost       = 0,
        strikes    = 0,
        starved    = 0,
        nextRun    = 0,
    }

    -- phase-offset equal-interval tasks so they land on different frames instead of stacking on one
    if interval > 0 then
        t.nextRun = os.clock() + (lane.phase / PHASE_SLOTS) * interval
        lane.phase = (lane.phase + 1) % PHASE_SLOTS
    end

    lane.tasks[#lane.tasks + 1] = t
    lane.live = lane.live + 1
    lane.dirty = true
    attach(lane)

    return newHandle(lane, t)
end

function M.render(fn, opts) return M.bind("render", fn, opts) end
function M.heartbeat(fn, opts) return M.bind("heartbeat", fn, opts) end
function M.stepped(fn, opts) return M.bind("stepped", fn, opts) end

-- milliseconds in, seconds internally: os.clock deals in seconds but a frame budget is only ever discussed in ms
function M.setBudget(ms)
    local value = tonumber(ms)
    budget = (value and value > 0) and (value / 1000) or nil
end

function M.getBudget()
    return budget and (budget * 1000) or nil
end

function M.setPaused(on)
    paused = on == true
end

function M.isPaused()
    return paused
end

-- cost sampling rides along for free while a budget is set; this turns it on for read-only consumers like the perf hud
function M.setProfiling(on)
    profiling = on == true
end

function M.stats()
    local out = { budgetMs = M.getBudget(), paused = paused, lanes = {} }
    for name, lane in pairs(lanes) do
        out.lanes[name] = {
            tasks     = lane.live,
            connected = lane.conn ~= nil,
            spentMs   = lane.spent * 1000,
            dropped   = lane.dropped,
        }
    end
    return out
end

function M.stop()
    for _, lane in pairs(lanes) do
        detach(lane)
        for i = 1, #lane.tasks do
            lane.tasks[i].alive = false
        end
        table.clear(lane.tasks)
        lane.live = 0
        lane.dirty = false
        lane.running = false
    end
end

return M

end)
__bundle_register("Features/Fun/CustomCursor/Storage", function(require, _LOADED, __bundle_register, __bundle_modules)
-- load/save cursor_builder.json, falling back to (and re-writing) a clone of Presets.DEFAULTS when missing or corrupt

local Store   = require("Utility/Store")
local Presets = require("Features/Fun/CustomCursor/Presets")

local M = {}

local KEY = "cursor_builder"

-- intentionally shallow clone — entries still share references with Presets.DEFAULTS; deep-cloning would change observable behavior
local function freshDefaults()
    local cfg = table.clone(Presets.DEFAULTS)
    for _, entry in ipairs(cfg.entries) do
        entry.locked = false
    end
    return cfg
end

function M.load()
    local cfg = Store.read(Store.GLOBAL, KEY)
    if type(cfg) == "table" and type(cfg.entries) == "table" then
        cfg.enabled  = cfg.enabled == true
        cfg.selected = tostring(cfg.selected or Presets.DEFAULTS.selected)
        cfg.settings = cfg.settings or table.clone(Presets.DEFAULTS.settings)
        cfg.settings.xNudge = tonumber(cfg.settings.xNudge) or 0
        cfg.settings.yNudge = tonumber(cfg.settings.yNudge) or 0
        for _, entry in ipairs(cfg.entries) do
            if type(entry) == "table" then
                entry.locked = false
            end
        end
        return cfg
    end

    local fresh = freshDefaults()
    M.save(fresh)
    return fresh
end

function M.save(cfg)
    Store.write(Store.GLOBAL, KEY, cfg)
end

M.freshDefaults = freshDefaults

return M

end)
__bundle_register("Utility/Store", function(require, _LOADED, __bundle_register, __bundle_modules)
-- namespaced json persistence: one path builder, one folder-ensure, one encode/decode, so a feature never hand-rolls the readfile/writefile/pcall dance again

local Services   = require("Services")
local References = require("References")
local Fs         = require("Utility/Helpers/Fs")
local Log        = require("Utility/Log")

local HttpService = Services.HttpService

local ROOT = "Cerberus"

local M = {}

-- a fork's Meta game name is arbitrary ("Bleach: VV"), and executors reject makefolder/writefile on reserved punctuation, so anything outside this set becomes "_"
local function sanitize(segment)
    segment = tostring(segment or "")
    segment = segment:gsub("[^%w%-_ %.]", "_")
    segment = segment:gsub("^%s+", ""):gsub("%s+$", "")
    return segment
end

M.GLOBAL = ""
M.GAME   = sanitize(References.gameName)

-- creates each segment in turn: makefolder fails on a nested path whose parent doesn't exist yet
local function ensureFolder(dir)
    if not (isfolder and makefolder) then return false end
    if isfolder(dir) then return true end
    local accum = nil
    for segment in dir:gmatch("[^/]+") do
        accum = accum and (accum .. "/" .. segment) or segment
        if not isfolder(accum) then
            local ok = pcall(makefolder, accum)
            if not ok then
                Log.devwarn("Store", "makefolder failed for %s", accum)
                return false
            end
        end
    end
    return true
end

-- a namespace may nest ("Universal/settings"); each segment is sanitized, the separators survive
local function folderOf(namespace)
    local dir = ROOT
    for segment in tostring(namespace or ""):gmatch("[^/]+") do
        local clean = sanitize(segment)
        if clean ~= "" then dir = dir .. "/" .. clean end
    end
    return dir
end

function M.path(namespace, key)
    return folderOf(namespace) .. "/" .. sanitize(key) .. ".json"
end

function M.exists(namespace, key)
    return type(isfile) == "function" and isfile(M.path(namespace, key)) == true
end

-- reads the raw file body; nil when absent or unreadable, so a caller can tell empty from missing
function M.readRaw(namespace, key)
    local file = M.path(namespace, key)
    if type(isfile) ~= "function" or type(readfile) ~= "function" then return nil end
    if not isfile(file) then return nil end
    local ok, body = pcall(readfile, file)
    if not ok or type(body) ~= "string" then
        Log.devwarn("Store", "readfile failed for %s", file)
        return nil
    end
    return body
end

function M.writeRaw(namespace, key, body)
    if not ensureFolder(folderOf(namespace)) then return false, "no folder" end
    return Fs.safeWrite(M.path(namespace, key), body, "Store")
end

-- `default` covers missing and corrupt alike: a half-written json file should degrade to first-run rather than throw
function M.read(namespace, key, default)
    local body = M.readRaw(namespace, key)
    if not body or body == "" then return default end
    local ok, value = pcall(HttpService.JSONDecode, HttpService, body)
    if not ok then
        Log.devwarn("Store", "corrupt json at %s, using default", M.path(namespace, key))
        return default
    end
    return value
end

function M.write(namespace, key, value)
    local ok, body = pcall(HttpService.JSONEncode, HttpService, value)
    if not ok or type(body) ~= "string" then
        Log.devwarn("Store", "encode failed for %s", M.path(namespace, key))
        return false, "encode failed"
    end
    return M.writeRaw(namespace, key, body)
end

function M.delete(namespace, key)
    local file = M.path(namespace, key)
    if type(isfile) ~= "function" or not isfile(file) then return true end
    if type(delfile) ~= "function" then return false end
    return (pcall(delfile, file))
end

-- key names (no directory, no .json) of every entry in the namespace
function M.list(namespace)
    local out = {}
    local dir = folderOf(namespace)
    if not (type(listfiles) == "function" and type(isfolder) == "function") then return out end
    if not isfolder(dir) then return out end
    local ok, entries = pcall(listfiles, dir)
    if not ok or type(entries) ~= "table" then return out end
    for _, full in ipairs(entries) do
        local name = tostring(full):match("([^/\\]+)%.json$")
        if name then out[#out + 1] = name end
    end
    table.sort(out)
    return out
end

return M

end)
