            display    = display,
            patName    = name ~= "" and escapePattern(name) or nil,
            patDisplay = (display ~= "" and display ~= name) and escapePattern(display) or nil,
        }
        escapedCache[plr] = entry
        return entry
    end

    -- replace player names with "Anonymous"; gsubs gated behind cheap plain-finds so no-match strings stay one scan
    local function anonymize(text)
        local out = tostring(text or "")
        if out == "" then return out end
        local hasAt = string.find(out, "@", 1, true) ~= nil
        for _, plr in ipairs(Players:GetPlayers()) do
            local e = getEscaped(plr)
            if e.patName and string.find(out, e.name, 1, true) then
                if hasAt then out = out:gsub("@" .. e.patName, "@Anonymous") end
                out = out:gsub(e.patName, "Anonymous")
            end
            if e.patDisplay and string.find(out, e.display, 1, true) then
                if hasAt then out = out:gsub("@" .. e.patDisplay, "@Anonymous") end
                out = out:gsub(e.patDisplay, "Anonymous")
            end
        end
        return out
    end

    -- spec = embed content; opts = live theme { defaultColor, anon, attribution, playerName, gameName }
    local function build(spec, opts)
        spec = spec or {}
        opts = opts or {}
        local anon = opts.anon == true
        local function clean(s) return anon and anonymize(s) or tostring(s or "") end

        local embed = {}

        if spec.title and spec.title ~= "" then
            embed.title = truncate(clean(spec.title), LIMIT.title)
        end
        if spec.description and spec.description ~= "" then
            embed.description = truncate(clean(spec.description), LIMIT.description)
        end
        if spec.url and spec.url ~= "" then embed.url = tostring(spec.url) end

        local color = discordColor(spec.color) or discordColor(opts.defaultColor)
        if color then embed.color = color end

        local fields = {}
        if type(spec.fields) == "table" then
            for _, f in ipairs(spec.fields) do
                if type(f) == "table" and f.name and f.value then
                    fields[#fields + 1] = {
                        name   = truncate(clean(f.name), LIMIT.fieldName),
                        value  = truncate(clean(f.value), LIMIT.fieldValue),
                        inline = f.inline == true,
                    }
                end
            end
        end

        -- session attribution unless a spec opts out or anon hides the player
        local wantAttribution = spec.attribution ~= false and opts.attribution ~= false
        if wantAttribution and not anon and opts.playerName then
            fields[#fields + 1] = { name = "Player", value = truncate(tostring(opts.playerName), LIMIT.fieldValue), inline = true }
        end
        if wantAttribution and opts.gameName then
            fields[#fields + 1] = { name = "Game", value = truncate(tostring(opts.gameName), LIMIT.fieldValue), inline = true }
        end

        if #fields > 0 then
            if #fields > LIMIT.fields then
                for i = #fields, LIMIT.fields + 1, -1 do fields[i] = nil end
            end
            embed.fields = fields
        end

        if type(spec.thumbnail) == "string" and spec.thumbnail ~= "" then
            embed.thumbnail = { url = spec.thumbnail }
        end
        if type(spec.image) == "string" and spec.image ~= "" then
            embed.image = { url = spec.image }
        end

        if type(spec.author) == "table" and spec.author.name then
            embed.author = { name = truncate(clean(spec.author.name), LIMIT.authorName) }
            if type(spec.author.icon) == "string" and spec.author.icon ~= "" then
                embed.author.icon_url = spec.author.icon
            end
        end

        if spec.footer ~= nil then
            local text, icon
            if type(spec.footer) == "table" then
                text, icon = spec.footer.text, spec.footer.icon
            else
                text = spec.footer
            end
            if text and text ~= "" then
                embed.footer = { text = truncate(clean(text), LIMIT.footer) }
                if type(icon) == "string" and icon ~= "" then embed.footer.icon_url = icon end
            end
        end

        if spec.timestamp == true then
            embed.timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
        elseif type(spec.timestamp) == "string" then
            embed.timestamp = spec.timestamp
        end

        return embed
    end

    return {
        build        = build,
        anonymize    = anonymize,
        discordColor = discordColor,
    }
end

return M

end)
__bundle_register("Api/Webhook/Transport", function(require, _LOADED, __bundle_register, __bundle_modules)
-- webhook http layer: enqueues built payloads onto a bounded fifo that one lazy worker paces out to discord, backing off + requeuing on rate-limit; the worker spawns on first send and exits when the queue drains, so it's idle-free

local Http = require("Utility/Helpers/Http")
local Jobs = require("Utility/Jobs")

-- pacing/backoff tunables, file-scoped so behaviour is visible at a glance
local MIN_GAP_SECONDS   = 0.75   -- min spacing between sends (burst-friendly, well under 429s)
local RATE_BACKOFF      = 2.0    -- fallback sleep on a 429 with no Retry-After
local TRANSIENT_BACKOFF = 3.0    -- sleep before re-sending after a timeout or 5xx
local MAX_ATTEMPTS      = 3      -- per-item send attempts before it's dropped
local MAX_PENDING       = 120    -- queue cap; oldest is dropped past this

local M = {}

local function statusOf(res)
    if type(res) ~= "table" then return nil end
    return tonumber(res.StatusCode or res.Status or res.status_code)
end

-- best-effort Retry-After (seconds) from a 429 response; executors vary in shape
local function retryAfter(res, decode)
    if type(res) ~= "table" then return nil end
    local h = res.Headers or res.headers
    if type(h) == "table" then
        local v = tonumber(h["Retry-After"] or h["retry-after"])
        if v then return v end
    end
    if type(res.Body) == "string" and res.Body ~= "" and type(decode) == "function" then
        local ok, decoded = pcall(decode, res.Body)
        if ok and type(decoded) == "table" and tonumber(decoded.retry_after) then
            return tonumber(decoded.retry_after)
        end
    end
    return nil
end

-- opts = { encode = fn(tbl)->str, decode = fn(str)->tbl, log, warn, onResult = fn(label, ok, status) }
function M.new(opts)
    local encode   = opts.encode
    local decode   = opts.decode
    local log      = opts.log or function() end
    local warn     = opts.warn or function() end
    local onResult = opts.onResult or function() end

    local queue = {}      -- FIFO of { url, payload, label, attempts }
    local head, tail = 1, 0
    local running = false
    local stopped = false
    local workerJob = nil

    local function pending()
        return tail - head + 1
    end

    -- fire the shared result hook + the per-send onDone (test pings await this) exactly once
    local function finish(item, ok, status)
        onResult(item.label, ok, status)
        local cb = item.onDone
        if cb then item.onDone = nil; pcall(cb, ok, status) end
    end

    -- one send. returns true on success, false to requeue (rate-limited), nil to drop
    local function sendOne(item)
        local okEnc, body = pcall(encode, item.payload)
        if not okEnc or type(body) ~= "string" then
            warn("payload encode failed: %s", tostring(body))
            finish(item, false, nil)
            return nil
        end

        local ok, res = Http.request({
            Url     = item.url,
            Method  = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body    = body,
        })

        local status = statusOf(res)
        if ok and (status == nil or (status >= 200 and status < 300)) then
            log("sent %s -> HTTP %s (%d queued)", tostring(item.label), tostring(status or "?"), pending() - 1)
            finish(item, true, status)
            return true
        end

        -- a timeout arrives as a transport failure with no status; requeue those alongside 429s and 5xx rather than losing the event
        if Http.isTransient(ok, res) then
            item.lastStatus = status
            local wait = (status == 429 and (retryAfter(res, decode) or RATE_BACKOFF)) or TRANSIENT_BACKOFF
            warn("%s on %s, retrying in %.2fs", status == 429 and "rate-limited" or "transient failure",
                tostring(item.label), wait)
            task.wait(wait)
            return false
        end

        warn("send %s failed (HTTP %s, ok=%s)", tostring(item.label), tostring(status), tostring(ok))
        finish(item, false, status)
        return nil
    end

    -- named local (not a literal) so the auto-wrapper leaves the worker virtualized — sub-30Hz pacer, no perf need, no secrets
    local function worker(job)
        while job.alive and not stopped and head <= tail do
            local item = queue[head]
            local verdict = sendOne(item)
            if verdict == false and item.attempts < MAX_ATTEMPTS then
                item.attempts = item.attempts + 1   -- keep at head, retry after the backoff
            else
                if verdict == false then
                    warn("dropping %s after %d attempts", tostring(item.label), item.attempts)
                    finish(item, false, item.lastStatus)
                end
                queue[head] = nil
                head = head + 1
            end
            if not stopped and head <= tail then
                if not job:sleep(MIN_GAP_SECONDS) then return end
            end
        end
        if head > tail then head, tail = 1, 0 end   -- reset indices when fully drained
        running = false
        workerJob = nil
    end

    -- onDone(ok, status) is an optional per-send result callback (used by test pings)
    local function post(url, payload, label, onDone)
        if stopped then return false, "transport stopped" end
        if type(url) ~= "string" or url == "" then return false, "no url" end
        if type(encode) ~= "function" then return false, "no encoder" end

        if pending() >= MAX_PENDING then
            local dropped = queue[head]
            queue[head] = nil
            head = head + 1
            warn("queue full (%d) — dropped oldest (%s)", MAX_PENDING, dropped and tostring(dropped.label) or "?")
            if dropped then finish(dropped, false, nil) end
        end

        tail = tail + 1
        queue[tail] = { url = url, payload = payload, label = label or "event", attempts = 1, onDone = onDone }

        if not running then
            running = true
            workerJob = Jobs.spawn(worker, { name = "WebhookQueue" })
        end
        return true
    end

    local function stop()
        stopped = true
        -- cancel rather than let the worker notice: it may be parked in a 3s transient backoff
        if workerJob then workerJob:Cancel(); workerJob = nil end
        running = false
        for i = head, tail do queue[i] = nil end
        head, tail = 1, 0
    end

    return {
        post    = post,
        stop    = stop,
        pending = pending,
    }
end

return M

end)
__bundle_register("Api/Esp", function(require, _LOADED, __bundle_register, __bundle_modules)
-- esp api: Drawing engine over a group registry fed by Api/Esp/Sources; one rescan task reconciles targets, one sample task reads every object's slow values and one draw task projects and paints, so nothing runs per object per frame; shared as ctx.Api.Esp

local Api       = require("Api")
local Identity  = require("Utility/Identity")
local Scheduler = require("Utility/Scheduler")
local VMath     = require("Utility/Helpers/VMath")
local UiHost    = require("UI/UiHost")
local Groups    = require("Api/Esp/Groups")
local Object    = require("Api/Esp/Object")
local Sources   = require("Api/Esp/Sources")

local RESCAN_SECONDS = 0.1
local SAMPLE_SECONDS = 0.1
local WARN_SECONDS   = 15

local M = {}

function M.new(ctx)
    local base = Api.define("Esp", ctx)
    local Workspace = ctx.Services.Workspace

    local hasDrawing = type(Drawing) == "table" and type(Drawing.new) == "function"

    local groups = Groups.new()
    local shared = { textSize = 13, textFont = 2 }
    local objects = {}  -- key -> { [instance] = Object }
    local lastRescan, dirty, present = {}, {}, {}
    local groupKeys = {}
    local liveCount = 0
    local failures, lastFailure, lastWarned = 0, nil, nil
    local origin = function() return nil end
    local folder = nil

    -- made on first use, so a session with chams off leaves no instance behind at all
    local deps = {
        folder = function()
            if folder then return folder end
            folder = Instance.new("Folder")
            pcall(function() folder.Parent = UiHost.pick() end)
            return folder
        end,
    }

    local function noteFailure(what, err)
        failures = failures + 1
        lastFailure = what .. ": " .. tostring(err)
        local now = os.clock()
        if lastWarned and now - lastWarned < WARN_SECONDS then return end
        lastWarned = now
        base.warn("%s", lastFailure)
    end

    local function removeObject(bucket, inst, obj)
        bucket[inst] = nil
        liveCount = liveCount - 1
        pcall(obj.Destruct, obj)
    end

    local function clearBucket(bucket)
        for inst, obj in pairs(bucket) do removeObject(bucket, inst, obj) end
    end

    -- drawings live in each object's bin, so they all go down here on unload
    base.maid:GiveTask(function()
        for _, bucket in pairs(objects) do clearBucket(bucket) end
        if folder then pcall(folder.Destroy, folder) end
        folder = nil
    end)

    local function nearestFirst(targets)
        local here = origin()
        if not here then return targets end
        local away, ranked = {}, table.create(#targets)
        for i = 1, #targets do
            local inst = targets[i]
            local ok, pivot = pcall(inst.GetPivot, inst)
            away[inst] = ok and VMath.distanceSqr3(pivot.Position, here) or math.huge
            ranked[i] = inst
        end
        table.sort(ranked, function(a, b) return away[a] < away[b] end)
        return ranked
    end

    local function addObject(bucket, inst, config)
        local made, obj = pcall(Object.new, inst, config, shared, deps)
        if not made then
            noteFailure("object", obj)
            return
        end
        bucket[inst] = obj
        liveCount = liveCount + 1
        -- sampled now, because the first paint can land before the next sample task
        local ok, err = pcall(obj.Sample, obj)
        if not ok then
            noteFailure("sample", err)
            removeObject(bucket, inst, obj)
        end
    end

    -- a source may hand back a shared array, so it is only ever read; the cap keeps the nearest targets
    local function rescan(group)
        local config = group.config
        local bucket = objects[group.key]
        if not bucket then
            bucket = {}
            objects[group.key] = bucket
        end

        if not (config.enabled and hasDrawing) then
            clearBucket(bucket)
            return
        end

        local ok, targets = pcall(group.source, group)
        if not ok or type(targets) ~= "table" then
            noteFailure(group.key .. " source", targets)
            return
        end

        local cap = config.maxTracked or 100
        if #targets > cap then targets = nearestFirst(targets) end

        table.clear(present)
        for i = 1, math.min(#targets, cap) do present[targets[i]] = true end

        for inst, obj in pairs(bucket) do
            if not present[inst] then removeObject(bucket, inst, obj) end
        end
        for inst in pairs(present) do
            if not bucket[inst] then addObject(bucket, inst, config) end
        end
    end

    -- each lane elevates on every wake: a scheduler callback runs below the identity an instance read or a Highlight needs, and it does not keep what it set last frame
    base.maid:GiveTask(Scheduler.heartbeat(function()
        Identity.elevate()
        local now = os.clock()
        for i = 1, #groupKeys do
            local key = groupKeys[i]
            local group = groups.Get(key)
            if group and (dirty[key] or now - (lastRescan[key] or -math.huge) >= (group.config.refreshInterval or 1)) then
                dirty[key] = nil
                lastRescan[key] = now
                rescan(group)
            end
        end
    end, { name = "EspRescan", priority = 210, interval = RESCAN_SECONDS, deferrable = true }))

    base.maid:GiveTask(Scheduler.heartbeat(function()
        if liveCount == 0 then return end
        Identity.elevate()
        for _, bucket in pairs(objects) do
            for inst, obj in pairs(bucket) do
                local ok, err = pcall(obj.Sample, obj)
                if not ok then
                    noteFailure("sample", err)
                    removeObject(bucket, inst, obj)
                end
            end
        end
    end, { name = "EspSample", priority = 207, interval = SAMPLE_SECONDS, deferrable = true }))

    -- a throwing object is torn down, not left to spam, and the failure stays readable through Stats
    base.maid:GiveTask(Scheduler.render(function()
        if liveCount == 0 then return end
        Identity.elevate()
        local camera = Workspace.CurrentCamera
        if not camera then return end
        local viewport = camera.ViewportSize
        local okOrigin, here = pcall(origin)
        if not okOrigin then here = nil end
        for _, bucket in pairs(objects) do
            for inst, obj in pairs(bucket) do
                local ok, err = pcall(obj.Tick, obj, camera, viewport, here)
                if not ok then
                    noteFailure("draw", err)
                    removeObject(bucket, inst, obj)
                end
            end
        end
    end, { name = "EspDraw", priority = 205, deferrable = true }))

    local function register(def)
        if not groups.Register(def) then return false end
        groupKeys = {}
        for _, entry in ipairs(groups.List()) do groupKeys[#groupKeys + 1] = entry.key end
        for _, signal in ipairs(def.changed or {}) do
            base.maid:GiveTask(signal:Connect(function() dirty[def.key] = true end))
        end
        return true
    end

    local court = Sources.new(ctx.Api)
    if court then
        origin = court.origin
        for _, def in ipairs(court.groups) do register(def) end
    else
        base.warn("court api unavailable, no esp groups registered")
    end

    if not hasDrawing then base.warn("Drawing api unavailable, esp will not render") end
    base.log("esp api ready (drawing=%s, groups=%d)", tostring(hasDrawing), #groupKeys)

    local function setConfig(key, partial)
        groups.SetConfig(key, partial)
        dirty[key] = true
    end

    return {
        RegisterGroup  = register,
        GetGroupList   = function() return groups.List() end,
        GetGroupConfig = function(key)
            local group = groups.Get(key)
            return group and group.config
        end,
        SetGroupConfig = setConfig,
        SetEnabled     = function(key, on) setConfig(key, { enabled = on == true }) end,
        SetShared      = function(cfg)
            if type(cfg) ~= "table" then return end
            for k, v in pairs(cfg) do shared[k] = v end
        end,
        GetShared      = function() return shared end,
        -- apply one field across every group (drives the universal ui controls)
        SetAllGroups   = function(partial)
            for i = 1, #groupKeys do setConfig(groupKeys[i], partial) end
        end,
        HasDrawing     = function() return hasDrawing end,
        Stats          = function()
            local counts = {}
            for key, bucket in pairs(objects) do
                local n = 0
                for _ in pairs(bucket) do n = n + 1 end
                counts[key] = n
            end
            return { objects = counts, total = liveCount, failures = failures, lastFailure = lastFailure }
        end,
    }
end

return M

end)
__bundle_register("Api/Esp/Sources", function(require, _LOADED, __bundle_register, __bundle_modules)
-- esp sources: all of the esp's basketball knowledge, as five provider-carrying groups over the court api; stamina and takeover come off character attributes because Humanoid.Health is pinned, sides come from court records because roblox teams are unused, and the ball and hoops are bare parts

local Groups = require("Api/Esp/Groups")

local ALLY              = Color3.fromRGB(80, 200, 120)
local ENEMY             = Color3.fromRGB(255, 70, 70)
local BENCH             = Color3.fromRGB(150, 150, 150)
local CARRIER           = Color3.fromRGB(255, 215, 60)
local BALL_HELD         = Color3.fromRGB(255, 140, 40)
local BALL_LOOSE        = Color3.fromRGB(255, 235, 60)
local HOOP              = Color3.fromRGB(120, 190, 255)
local STAMINA_FULL      = Color3.fromRGB(70, 220, 90)
local STAMINA_EMPTY     = Color3.fromRGB(230, 55, 55)
local TAKEOVER_CHARGING = Color3.fromRGB(130, 90, 190)
local TAKEOVER_LIVE     = Color3.fromRGB(215, 130, 255)

-- the game falls back to 100 for both, and it divides TakeoverFill by 100 for its own meter
local FULL_STAMINA  = 100
local FULL_TAKEOVER = 100
local GASSED_AT     = 0.25
local MAX_FLAGS     = 4
local FLAG_GAP      = " | "

local LATER_FLAGS = {
    { "CallingForBall", "OPEN" },
    { "InPost", "POST" },
    { "Boxout", "BOXOUT" },
    { "Sprinting", "SPRINT" },
    { "Cold", "COLD" },
}

local PLAYER_LABELS = {
    leftBar     = "Stamina Bar",
    leftBarText = "Stamina Percent",
    rightBar    = "Takeover Bar",
    status      = "Live Status",
    skeleton    = "Skeleton",
}

local PLAYER_EXTRAS = {
    { id = "Carrier", text = "Highlight Ball Carrier", field = "highlightCarrier" },
    { id = "Rating", text = "Show Position And Rating", field = "showRating" },
    { id = "Build", text = "Show Build Name", field = "showBuild" },
}

local M = {}

-- the set of actions is small and fixed, so each is worked out once
local actionNames = {}
local function actionName(action)
    local known = actionNames[action]
    if known then return known end
    known = string.upper((string.gsub(action, "(%l)(%u)", "%1 %2")))
    actionNames[action] = known
    return known
end

local flags = {}

-- ordered by how much each state should change what you do about the player; an empty Action is the game's resting state
local function flagLine(rec, staminaRatio)
    local model = rec.model
    table.clear(flags)
    if rec.held then flags[#flags + 1] = "BALL" end
    if model:GetAttribute("Stunned") == true then flags[#flags + 1] = "STUNNED" end
    if model:GetAttribute("Takeover") == true then flags[#flags + 1] = "TAKEOVER" end
    local action = model:GetAttribute("Action")
    if type(action) == "string" and action ~= "" then flags[#flags + 1] = actionName(action) end
    if staminaRatio and staminaRatio <= GASSED_AT then flags[#flags + 1] = "GASSED" end
    for i = 1, #LATER_FLAGS do
        local flag = LATER_FLAGS[i]
        if model:GetAttribute(flag[1]) == true then flags[#flags + 1] = flag[2] end
    end
    if not flags[1] then return nil end
    return table.concat(flags, FLAG_GAP, 1, math.min(#flags, MAX_FLAGS))
end

local function staminaOf(model)
    local current = model:GetAttribute("Stamina")
    if type(current) ~= "number" then return nil end
    local max = model:GetAttribute("MaxStamina")
    if type(max) ~= "number" or max <= 0 then max = FULL_STAMINA end
    return math.clamp(current / max, 0, 1)
end

local function titleOf(rec, config)
    if not config.showRating then return rec.name end
    local model = rec.model
    local role, overall = model:GetAttribute("Position"), model:GetAttribute("Overall")
    if not (role or overall) then return rec.name end
    return string.format("%s  %s %s", rec.name, tostring(role or "-"), tostring(overall or "-"))
end

local function playerGroup(Court, key, accent, list)
    local config = Groups.defaultConfig(accent)
    config.maxTracked = 24
    config.leftBar.fullColor = STAMINA_FULL
    config.leftBar.emptyColor = STAMINA_EMPTY
    config.rightBar.enabled = true
    config.rightBar.color = TAKEOVER_CHARGING
    config.status.enabled = true
    config.highlightCarrier = true
    config.showRating = true
    config.showBuild = false

    -- a recycled body keeps its parent and only changes name, so belonging is the record's call and never the instance's
    function config.provider(model, sample)
        local rec = Court.recordOf(model)
        local root = rec and rec.model == model and rec.root
        if not root then
            sample.gone = true
            return
        end
        sample.anchor = root
        sample.title = titleOf(rec, config)
        if config.highlightCarrier and rec.held then sample.tint = CARRIER end

        local stamina = staminaOf(model)
        sample.left = stamina
        if stamina and config.leftBar.text then sample.leftText = math.round(stamina * 100) .. "%" end

        local fill = model:GetAttribute("TakeoverFill")
        if type(fill) == "number" then
            sample.right = fill / FULL_TAKEOVER
            sample.rightColor = model:GetAttribute("Takeover") == true and TAKEOVER_LIVE or TAKEOVER_CHARGING
        end

        if config.status.enabled then
            local build = config.showBuild and model:GetAttribute("BuildName") or nil
            sample.lineA = type(build) == "string" and build ~= "" and build or nil
            sample.lineB = flagLine(rec, stamina)
        end
    end

    return {
        key = key, label = key, config = config,
        labels = PLAYER_LABELS,
        extras = PLAYER_EXTRAS,
        changed = { Court.RosterChanged },
        source = function()
            local records = list()
            local models = table.create(#records)
            for i = 1, #records do models[i] = records[i].model end
            return models
        end,
    }
end

local function ballGroup(Court)
    local config = Groups.defaultConfig(BALL_HELD)
    config.maxTracked = 16
    config.refreshInterval = 0.25
    config.status.enabled = true
    config.tracer.enabled = true
    config.arrow.enabled = true
    config.distance.enabled = true
    config.leftBar.enabled = false
    config.allBalls = false

    function config.provider(part, sample)
        local holder = Court.carrier(part)
        local flying = Court.ballInFlight(part)
        sample.title = (config.allBalls and Court.ball() == part) and "Ball In Play" or "Ball"
        -- a loose ball is the one worth reacting to, so it gets its own color
        sample.tint = holder and BALL_HELD or BALL_LOOSE
