        status.TextSize = 13
        status.TextWrapped = true
        status.TextColor3 = Theme.TextSecondary
        status.TextXAlignment = Enum.TextXAlignment.Left
        status.TextYAlignment = Enum.TextYAlignment.Top
        status.Text = "Starting up..."
        status.Parent = panel
        self.statusLabel = status

        local progressBg = Instance.new("Frame")
        progressBg.Position = UDim2.new(0, 24, 1, -40)
        progressBg.Size = UDim2.new(1, -100, 0, 10)
        progressBg.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
        progressBg.BorderSizePixel = 0
        progressBg.Parent = panel

        local progressCorner = Instance.new("UICorner")
        progressCorner.CornerRadius = UDim.new(1, 0)
        progressCorner.Parent = progressBg

        local progressFill = Instance.new("Frame")
        progressFill.Size = UDim2.fromScale(0, 1)
        progressFill.BackgroundColor3 = accent
        progressFill.BorderSizePixel = 0
        progressFill.Parent = progressBg

        local fillGlow = Instance.new("UIStroke")
        fillGlow.Color = accent
        fillGlow.Transparency = 0.6
        fillGlow.Thickness = 3
        fillGlow.Parent = progressFill

        local fillCorner = Instance.new("UICorner")
        fillCorner.CornerRadius = UDim.new(1, 0)
        fillCorner.Parent = progressFill

        local fillGradient = Instance.new("UIGradient")
        fillGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, accentDim),
            ColorSequenceKeypoint.new(1, accent),
        })
        fillGradient.Parent = progressFill

        self.progressFill = progressFill

        local percent = Instance.new("TextLabel")
        percent.BackgroundTransparency = 1
        percent.Position = UDim2.new(1, -65, 1, -47)
        percent.Size = UDim2.fromOffset(50, 24)
        percent.Font = Enum.Font.GothamBold
        percent.TextSize = 16
        percent.TextColor3 = accent
        percent.TextXAlignment = Enum.TextXAlignment.Right
        percent.Text = "0%"
        percent.Parent = panel
        self.percentLabel = percent

        local animInfo = TweenInfo.new(0.6, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out)
        TweenService:Create(blur, animInfo, { Size = 15 }):Play()
        TweenService:Create(backdrop, animInfo, { BackgroundTransparency = 0.4 }):Play()
        TweenService:Create(panel, animInfo, {
            GroupTransparency = 0,
            Position = UDim2.fromScale(0.5, 0.5),
        }):Play()

        self.target = 0.02
    end

    function self:hide(onComplete)
        if not self.gui then
            if onComplete then pcall(onComplete) end
            return
        end

        local gui      = self.gui
        local blur     = self.blur
        local panel    = self.panelGroup
        local backdrop = gui:FindFirstChild("Frame")

        local animInfo = TweenInfo.new(0.8, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out)

        if blur then
            TweenService:Create(blur, animInfo, { Size = 0 }):Play()
        end
        if backdrop then
            TweenService:Create(backdrop, animInfo, { BackgroundTransparency = 1 }):Play()
        end
        if panel then
            TweenService:Create(panel, animInfo, {
                Position = UDim2.fromScale(0.5, 0.45),
                GroupTransparency = 1,
            }):Play()
            -- per-descendant fallback: some executors don't respect CanvasGroup transparency
            for _, desc in ipairs(panel:GetDescendants()) do
                if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                    -- background as well as text: it is a no-op for the labels that are already
                    -- transparent, and it is the whole fade for the ones that are filled (the tier
                    -- badge, the skip button), which would otherwise sit solid and then vanish
                    TweenService:Create(desc, animInfo,
                        { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
                elseif desc:IsA("ImageLabel") then
                    TweenService:Create(desc, animInfo, { ImageTransparency = 1 }):Play()
                elseif desc:IsA("UIStroke") then
                    TweenService:Create(desc, animInfo, { Transparency = 1 }):Play()
                elseif desc:IsA("Frame") then
                    TweenService:Create(desc, animInfo, { BackgroundTransparency = 1 }):Play()
                end
            end
        end

        -- leak:allow — completes a teardown; cancelling it at unload would strand the loader on screen
        task.delay(0.85, function()
            self:_stopLoop()
            if gui then gui:Destroy() end
            if blur then blur:Destroy() end

            if self.gui == gui then
                self.gui = nil
                self.blur = nil
                self.panelGroup = nil
                self.statusLabel = nil
                self.subtitleLabel = nil
                self.progressFill = nil
                self.percentLabel = nil
                self.value = 0
                self.target = 0
                self.bootAdvance = 0
                self.bootPhase = false
            end

            if onComplete then pcall(onComplete) end
        end)
    end

    -- translation phase: boot step driver is frozen so manual setProgress calls don't get clobbered

    function self:freezeBootProgress()
        self.bootPhase = false
    end

    function self:setStatus(text)
        if self.statusLabel then
            self.statusLabel.Text = tostring(text or "")
        end
    end

    function self:setSubtitle(text)
        if self.subtitleLabel then
            self.subtitleLabel.Text = tostring(text or "")
        end
    end

    function self:setProgress(ratio)
        if type(ratio) ~= "number" then return end
        self.target = math.clamp(ratio, 0, 1)
    end

    -- adds a skip button row below the bar; returns a remove function for when the queue drains
    function self:addSkipButton(label, onClick)
        if not (self.gui and self.panelGroup) then return function() end end
        local panel = self.panelGroup

        -- grow taller but keep scale-based width so mobile-safe sizing from show() survives
        if panel.Size.Y.Offset < 240 then
            panel.Size = UDim2.new(panel.Size.X.Scale, panel.Size.X.Offset, 0, 240)
        end

        -- percent label renders right where the skip button needs to live
        if self.percentLabel then
            self.percentLabel.Visible = false
        end

        -- lift the bar so the skip button gets its own row beneath it
        if self.progressFill and self.progressFill.Parent then
            local progressBg = self.progressFill.Parent
            progressBg.Position = UDim2.new(0, 24, 1, -64)
            progressBg.Size = UDim2.new(1, -48, 0, 10)
        end

        local btn = Instance.new("TextButton")
        btn.Name = "SkipButton"
        btn.AnchorPoint = Vector2.new(0.5, 1)
        btn.Position = UDim2.new(0.5, 0, 1, -16)
        btn.Size = UDim2.fromOffset(220, 28)
        btn.BackgroundColor3 = Color3.fromRGB(34, 34, 42)
        btn.BackgroundTransparency = 0
        btn.BorderSizePixel = 0
        btn.AutoButtonColor = false
        btn.Text = tostring(label or "Skip")
        btn.Font = Enum.Font.GothamSemibold
        btn.TextSize = 13
        btn.TextColor3 = Theme.TextPrimary
        btn.Parent = panel

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = btn

        local stroke = Instance.new("UIStroke")
        stroke.Color = accentDim
        stroke.Thickness = 1
        stroke.Transparency = 0.4
        stroke.Parent = btn

        local hoverInfo = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        btn.MouseEnter:Connect(function()
            TweenService:Create(btn, hoverInfo,
                { BackgroundColor3 = Color3.fromRGB(46, 46, 56) }):Play()
            TweenService:Create(stroke, hoverInfo, { Transparency = 0.1 }):Play()
        end)
        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, hoverInfo,
                { BackgroundColor3 = Color3.fromRGB(34, 34, 42) }):Play()
            TweenService:Create(stroke, hoverInfo, { Transparency = 0.4 }):Play()
        end)
        btn.MouseButton1Down:Connect(function()
            TweenService:Create(btn, hoverInfo,
                { BackgroundColor3 = Color3.fromRGB(28, 28, 36) }):Play()
        end)

        local fired = false
        btn.Activated:Connect(function()
            if fired then return end
            fired = true
            if onClick then pcall(onClick) end
        end)

        return function()
            if btn and btn.Parent then
                pcall(function() btn:Destroy() end)
            end
            if self.percentLabel then self.percentLabel.Visible = true end
            if self.progressFill and self.progressFill.Parent then
                local progressBg = self.progressFill.Parent
                progressBg.Position = UDim2.new(0, 24, 1, -40)
                progressBg.Size = UDim2.new(1, -100, 0, 10)
            end
        end
    end

    function self:finalize(onComplete)
        if self.statusLabel then
            self.statusLabel.Text = "Ready."
        end
        self.bootPhase = false
        self.target = 1

        -- wait for the lerp to reach 100%; onComplete fires post-fade so the main UI never appears over the loader
        Jobs.spawn(function(job)
            local deadline = tick() + 0.8
            while job.alive and tick() < deadline and (self.value or 0) < 0.995 do
                if not job:sleep() then return end
            end
            if not job:sleep(0.25) then return end
            self:hide(onComplete)
        end, { name = "LoaderFade" })
    end

    return self
end

return M

end)
