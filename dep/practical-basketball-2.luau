        refreshParts(self)
        if group.skeleton.enabled then refreshBones(self) end
    end
    applyChams(self)
end

Object.Update = function(self, camera, viewport, origin)
    local group = self.group
    local anchor = self.anchor
    local enabled = group.enabled and self.live and anchor ~= nil and anchor.Parent ~= nil
    self.onScreen, self.corners, self.direction = false, nil, nil

    if enabled then
        local world = anchor.Position
        local screen, onScreen, depth = Geometry.worldToScreen(camera, world)
        local distance = origin and (world - origin).Magnitude or depth
