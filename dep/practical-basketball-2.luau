    local rightCfg = group.rightBar
    local rightValue = sample.right
    self.rightBar.Visible = drawBox and rightCfg.enabled and rightValue ~= nil
    self.rightOutline.Visible = self.rightBar.Visible and rightCfg.outline
    if self.rightBar.Visible then
        local barBottom = corners.bottomRight + BAR_OFFSET
        local barTop = corners.topRight + BAR_OFFSET
        self.rightBar.To = barBottom
        self.rightBar.From = barBottom:Lerp(barTop, math.clamp(rightValue, 0, 1))
        self.rightBar.Color = sample.rightColor or rightCfg.color
        self.rightBar.Transparency = rightCfg.transparency
        if self.rightOutline.Visible then
            self.rightOutline.To = barBottom + BAR_CAP
            self.rightOutline.From = barTop - BAR_CAP
            self.rightOutline.Color = rightCfg.outlineColor
        end
    end

