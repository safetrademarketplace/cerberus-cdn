        return true
    end

    local function pathOf(section)
        if type(section) ~= "string" then return nil end
        local path = {}
        for segment in string.gmatch(section, "[^%.]+") do path[#path + 1] = segment end
        return path
    end

    local function get(section, name)
        local path = pathOf(section)
        if not path then return nil end
        return saved.read(path, name)
    end

    -- what the account holds, looking through any override
    local function savedValue(section, name)
        local held, value = layer.baseOf(keyOf(section, name))
        if held then return value end
        return get(section, name)
    end

    local meter = Meter.new({
        Net          = Net,
        catalog      = catalog,
        saved        = saved,
        writeAccount = writeAccount,
        maid         = base.maid,
        userId       = References.player.UserId,
    })

    local function save(section, name, value)
        if unloaded then return false, Errors.UNLOADED end
        local row = catalog.row(section, name)
        if not row then return false, missing() end
        if row.vip then return false, Errors.VIP_ONLY end
        local ok, err = writeAccount(section, name, value)
        if not ok then return false, err end
        meter.forget(section, name)
        return true
    end

    local function catalogView()
        local snapshot = catalog.snapshot()
        if not snapshot then return false, Errors.NOT_READY end
        return true, snapshot
    end

    local effects = Effects.new({
        override   = override,
        layer      = layer,
        Net        = Net,
        Services   = ctx.Services,
        References = References,
    })

    local camera = Camera.new({
        Net       = Net,
        base      = base,
        catalog   = catalog,
        layer     = layer,
        override  = override,
        readSaved = get,
    })

    -- the levers that take no profile refuse here too, so a token can never be minted after the layer has emptied
    local function guarded(fn)
        return function(...)
            if unloaded then return nil, Errors.UNLOADED end
            return fn(...)
        end
    end

    base.maid:GiveTask(function()
        unloaded = true
        if listener then listener:Disconnect() end
        layer.restoreAll()
        flush()
        meter.restore()
    end)

    base.log("prefs api ready")

    return {
        Errors = Errors,

        catalog = catalogView,
        get     = get,
        saved   = savedValue,
        save    = save,

        override = override,
        active   = layer.active,

        meterStyles        = meter.styles,
        meterStyle         = meter.style,
        setMeterStyle      = meter.setStyle,
        showOtherMeters    = meter.showOthers,
        setShowOtherMeters = meter.setShowOthers,
        restoreMeter       = meter.restore,

        setCrowd         = effects.setCrowd,
        setShadows       = effects.setShadows,
        setNets          = effects.setNets,
        setGreenEffects  = effects.setGreenEffects,
        setBadgeEffects  = effects.setBadgeEffects,
        setStreakEffects = effects.setStreakEffects,
        setShotCamera    = effects.setShotCamera,
        setHairPhysics   = guarded(effects.setHairPhysics),
        setSparks        = guarded(effects.setSparks),
        setScenery       = effects.setScenery,
        setEventEffects  = effects.setEventEffects,
        crowdCount       = effects.crowdCount,

        cameraModes   = camera.modes,
        cameraMode    = camera.mode,
        setCameraMode = guarded(camera.setMode),
        cameraFov     = camera.fov,
        setCameraFov  = guarded(camera.setFov),
    }
end

return M

end)
__bundle_register("Api/Prefs/Saved", function(require, _LOADED, __bundle_register, __bundle_modules)
-- prefs saved: the only reader and writer of the live ProfileData.SavedSettings, which the game swaps whole on every profile push, so it is never cached; each swap bumps a generation the override layer watches
local M = {}

function M.new(Net)
    local last, generation = nil, 0
    local created = {}

    local function root()
        local player = Net.controller("Player")
        local profile = player and player.ProfileData
        local saved = type(profile) == "table" and profile.SavedSettings or nil
        if type(saved) ~= "table" then return nil end
        if saved ~= last then
            last = saved
            generation = generation + 1
            table.clear(created)
        end
        return saved
    end

    local function read(path, name)
        local node = root()
        if not node then return nil end
        for _, segment in ipairs(path) do
            node = node[segment]
            if type(node) ~= "table" then return nil end
        end
        return node[name]
    end

    -- a table made only to hold an override leaves with it, or the profile would not end up as it started
    local function prune(path)
        local nodes = { root() }
        for i, segment in ipairs(path) do
            nodes[i + 1] = nodes[i] and nodes[i][segment] or nil
        end
        for i = #path, 1, -1 do
            local key = table.concat(path, ".", 1, i)
            if not created[key] or type(nodes[i + 1]) ~= "table" or next(nodes[i + 1]) ~= nil then return end
            nodes[i][path[i]] = nil
            created[key] = nil
        end
    end

    local function write(path, name, value)
        local node = root()
        if not node then return false end
        for i, segment in ipairs(path) do
            local child = node[segment]
            if type(child) ~= "table" then
                if value == nil then return true end
                child = {}
                node[segment] = child
                created[table.concat(path, ".", 1, i)] = true
            end
            node = child
        end
        node[name] = value
        if value == nil then prune(path) end
        return true
    end

    return {
        ready      = function() return root() ~= nil end,
        generation = function()
            root()
            return generation
        end,
        read       = read,
        write      = write,
    }
end

return M

end)
__bundle_register("Api/Prefs/Meter", function(require, _LOADED, __bundle_register, __bundle_modules)
-- prefs meter: the shot meter style and other players' meters, the two settings only the server reads, so unlike every other lever they must reach the account; each change is journalled through Store before it is sent and undone on unload, or on the next boot if the session died first
local Jobs  = require("Utility/Jobs")
local Store = require("Utility/Store")

local Errors = require("Api/Prefs/Errors")

local SECTION   = "Meter"
local PATH      = { SECTION }
local TYPE      = "Type"
local OTHERS    = "ShowOtherMeters"
local NAMESPACE = Store.GAME .. "/prefs"
local BOOT_WAIT = 60

local M = {}

function M.new(deps)
    local Net, catalog, saved = deps.Net, deps.catalog, deps.saved
    local writeAccount = deps.writeAccount
    local journalKey = "meter_restore_" .. tostring(deps.userId)

    local journal = Store.read(NAMESPACE, journalKey, {})
    if type(journal) ~= "table" then journal = {} end
    local stale = next(journal) ~= nil

    local function persist()
        if next(journal) == nil then
            Store.delete(NAMESPACE, journalKey)
        else
            Store.write(NAMESPACE, journalKey, journal)
        end
    end

    -- only undoes what is still ours: any other value means the player chose it in the game's own menu since, and that stands
    local function settle()
        if not saved.ready() then return false end
        for name, entry in pairs(journal) do
            local current = saved.read(PATH, name)
            local ours = current ~= nil and catalog.labelOf(current) == entry.applied
            if not ours or writeAccount(SECTION, name, entry.original) then journal[name] = nil end
        end
        persist()
        stale = false
        return true
    end

    if stale then
        deps.maid:GiveTask(Jobs.spawn(function(job)
            -- the profile arrives after boot, and a change made first settles this itself
            for _ = 1, BOOT_WAIT do
                if not stale or settle() then return end
                if not job:sleep(1) then return end
            end
        end, { name = "PrefsMeterHeal" }))
    end

    local function change(name, value)
        if not saved.ready() then return false, Errors.NOT_READY end
        if stale then settle() end
        local row = catalog.row(SECTION, name)
        if not row then return false, Errors.UNKNOWN_SETTING end
        local label = catalog.encode(row, value)
        if label == nil then return false, Errors.BAD_VALUE end
        local current = saved.read(PATH, name)
        -- there is no way to unset a key on the server, so a value with nothing to return to is refused rather than left behind
        if current == nil then return false, Errors.NO_BASELINE end
        local now = catalog.labelOf(current)
        if label == now then return true end

        local before = journal[name]
        -- a value we did not apply is the player's own choice from the game's menu, so it becomes what we return to
        local original = (before and before.applied == now) and before.original or now
        journal[name] = original ~= label and { original = original, applied = label } or nil
        persist()

        local ok, err = writeAccount(SECTION, name, label)
        if not ok then
            journal[name] = before
            persist()
            return false, err
        end
        return true
    end

    local function styles()
        local row = catalog.row(SECTION, TYPE)
        if not row or not row.options then return false, Errors.NOT_READY end
        local clientConfig = Net.module("Config.Meters")
        local out = {}
        for _, option in ipairs(row.options) do
            -- the game's packet handler indexes this table with the server's name and throws on a miss
            if type(clientConfig) ~= "table" or clientConfig[option] ~= nil then out[#out + 1] = option end
        end
        return true, out
    end

    local function style()
        local value = saved.read(PATH, TYPE)
        return type(value) == "string" and value or nil
    end

    local function setStyle(name)
        local ok, list = styles()
        if not ok then return false, list end
        if not table.find(list, name) then return false, Errors.BAD_VALUE end
        return change(TYPE, name)
    end

    local function showOthers()
        local value = saved.read(PATH, OTHERS)
        if type(value) ~= "boolean" then return false, Errors.NOT_READY end
        return true, value
    end

    local function setShowOthers(on)
        return change(OTHERS, on == true)
    end

    -- an explicit save means the player keeps that value, so unload must not take it back
    local function forget(section, name)
        if section ~= SECTION or journal[name] == nil then return end
        journal[name] = nil
        persist()
    end

    return {
        styles        = styles,
        style         = style,
        setStyle      = setStyle,
        showOthers    = showOthers,
        setShowOthers = setShowOthers,
        forget        = forget,
        restore       = settle,
    }
end

return M

end)
