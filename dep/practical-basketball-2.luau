    local Tabs    = ctx.Tabs
    local NewMaid = ctx.NewMaid

    local ConsoleGroup = Tabs.Misc:AddRightGroupbox("Console", "code")

    -- hoisted so the module cleanup hook can tear down a launched console on unload
    local currentConsole = nil

    local function launchConsole()
        local Players          = Services.Players
        local LogService       = Services.LogService
        local UserInputService = Services.UserInputService

        if Globals.get("__rbx_runtime_console") then return end
        Globals.set("__rbx_runtime_console", true)

        -- per-launch maid, NOT the module maid: service-level connections must die when this window closes
        local maid = NewMaid and NewMaid() or nil
        local function track(conn) if maid and conn then maid:GiveTask(conn) end; return conn end

        local state = {
            gui       = nil,
            minimized = false,
            showLog   = true,
            showWarn  = true,
            showErr   = true,
            buffer    = {},
            maxBuffer = 1000,
        }

        local function cleanup()
            if maid then maid:DoCleaning() end
            -- defensive: also destroy directly in case NewMaid was missing from ctx
            if state.gui then state.gui:Destroy(); state.gui = nil end
            currentConsole = nil
            Globals.unset("__rbx_runtime_console")
        end

        local function bufferMessage(msg, mt)
            local kind = "Log"
            if mt == Enum.MessageType.MessageWarning then
                kind = "Warning"
            elseif mt == Enum.MessageType.MessageError then
                kind = "Error"
            end
            local buf = state.buffer
            buf[#buf + 1] = { msg = tostring(msg or ""), type = kind }
            if #buf > state.maxBuffer then table.remove(buf, 1) end
        end

        local function buildGui()
            local screenGui = Instance.new("ScreenGui")
