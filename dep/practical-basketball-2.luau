__bundle_register("Features/Basketball/Shooting/AutoShoot", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto shoot: presses the shot once per possession while you hold the ball inside your range of your hoop, holds the auto release for the shots it started so it works without perfect release and never strands one, and says in plain words why it is standing down
local Scheduler = require("Utility/Scheduler")
local UiWrite   = require("Utility/UiWrite")

local RangeRing = require("Features/Basketball/Shooting/RangeRing")

local CLAIM          = "AutoShoot"
local TICK_EVERY     = 0.05
local PRESS_GRACE    = 1.2  -- no shot this long after a press means it never started
local RETRY_GAP      = 0.6
local MAX_TRIES      = 3    -- per possession, so a press the game refuses can never become a stream
local POSSESSION_GAP = 0.3  -- the ball can leave the hand for a moment without the possession ending
local NO_OPTIONS     = {}

local RANGE_COLOR = Color3.fromRGB(255, 170, 60)

-- a shot can only start from these; every other action is a pass, a steal, a rebound or a shot already under way
local START_ACTIONS = { [""] = true, Moving = true, Dribbling = true }

local function studs(value)
    return math.floor(value + 0.5)
end

return function(ctx)
    local Court   = ctx.Api.Court
    local Input   = ctx.Api.Input
    local Library = ctx.Library
    local Options = ctx.Options
    local Player  = ctx.Api.Player
    local Shot    = ctx.Api.Shot
    local Toggles = ctx.Toggles
    local group   = ctx.Group
    local labels  = ctx.Labels
    local release = ctx.Release
    local track   = ctx.track

    local enabled, tick = false, nil
    local pressedAt, ownShot = nil, nil
    local holding, lostAt = false, -math.huge
    local tries, taken, nextPressAt = 0, false, 0
    local statusText = "Off"
    local ringRefused = false

    -- the one range test, read by the trigger and the ring alike; flat, because that is what the game grades
    local function reach()
        local hoop = Court.myHoop()
        local flat = hoop and Court.distanceToHoop(hoop)
        if not flat then return nil end
        local range = Options.AutoShootRange.Value
        return hoop, flat, range, flat <= range
    end

    local ring = RangeRing.new({
        Workspace = ctx.Services.Workspace,
        position  = Player.position,
        reach     = reach,
        color     = function() return Options.AutoShootRangeColor.Value end,
    })

    local function setStatus(text)
        if text == statusText then return end
        statusText = text
        labels.touch()
    end

    local function letGo()
        pressedAt = nil
        Input.shootRelease()
        if not ownShot then release.drop(CLAIM) end
    end

    local function readPossession(now)
        local has = Court.hasBall()
        if has and not holding then
            holding = true
            if now - lostAt >= POSSESSION_GAP then tries, taken, nextPressAt = 0, false, 0 end
        elseif holding and not has then
            holding = false
            lostAt = now
            if pressedAt then letGo() end
        end
        return has
    end

    local function evaluate(now)
        if not Player.model() then return "Waiting for your character" end
        if not readPossession(now) then return "Waiting for the ball" end
        if pressedAt then return "Starting your shot" end
        if Shot.isShooting() then return "Shooting" end
        if taken then return "Shot taken" end
        if tries >= MAX_TRIES then return "Shot would not start" end

        local _, flat, _, inside = reach()
        if not flat then return "Looking for your hoop" end
        if not inside then return ("Too far: %d studs"):format(studs(flat)) end

        local action = Player.action()
        if action ~= nil and not START_ACTIONS[action] then return "Waiting to shoot" end

        if Toggles.AutoShootOpenOnly.Value then
            local _, gap = Court.nearestOpponent()
            if gap and gap < Options.AutoShootOpenDistance.Value then
                return ("Covered: %d studs"):format(studs(gap))
            end
        end

        if not Input.legal("shootPress", NO_OPTIONS) then return "Can't shoot right now" end
        if now < nextPressAt then return "Trying again" end
        return ("Shooting from %d studs"):format(studs(flat)), true
    end

    local function press(now)
        tries = tries + 1
        nextPressAt = now + RETRY_GAP
        pressedAt = now
        release.claim(CLAIM)
        if Input.shootPress(NO_OPTIONS) then return "Starting your shot" end
        pressedAt = nil
        if not ownShot then release.drop(CLAIM) end
        return "Couldn't start the shot"
    end

    local function step()
        local now = os.clock()
        if pressedAt and now - pressedAt >= PRESS_GRACE then
            letGo()
            nextPressAt = now + RETRY_GAP
        end
        local text, ready = evaluate(now)
        setStatus(ready and press(now) or text)
    end

    local function refreshRing()
        if not (enabled and Toggles.AutoShootShowRange.Value) then
            ring.hide()
        elseif not ring.show() and not ringRefused then
            ringRefused = true
            UiWrite.notify(Library, "Can't show the range circle", 5)
        end
    end

    -- a shot already under way keeps its claim and is finished by the shot api; only a press with no shot behind it is let go
    local function setEnabled(on)
        on = on == true
        if on == enabled then return end
        enabled = on
        if on then
            holding, lostAt = false, -math.huge
            tries, taken, nextPressAt = 0, false, 0
            tick = Scheduler.heartbeat(step, { name = "AutoShoot", interval = TICK_EVERY })
        else
            tick:Disconnect()
            tick = nil
            if pressedAt then letGo() end
            setStatus("Off")
        end
        refreshRing()
    end

    group:AddToggle("AutoShoot", {
        Text     = "Auto Shoot",
        Default  = false,
        Premium  = true,
        Tooltip  = "Works without Perfect Release",
        Callback = setEnabled,
    }):AddKeyPicker("AutoShootKey", {
        Text            = "Auto Shoot",
        SyncToggleState = true,
        Mode            = "Toggle",
    })

    local box = group:AddDependencyBox()

    box:AddSlider("AutoShootRange", {
        Text     = "Range",
        Default  = 40,
        Min      = 5,
        Max      = 60,
        Rounding = 1,
        Suffix   = " studs",
    })

    box:AddButton({
        Text    = "Use 3PT line",
        Tooltip = "Sets Range to the three point line",
        Func = function()
            local line = Court.threePointDistance()
            if type(line) ~= "number" then
                UiWrite.notify(Library, "Can't find the 3PT line", 3)
                return
            end
            UiWrite.value(Options.AutoShootRange, math.floor(line * 10 + 0.5) / 10)
        end,
    })

    box:AddToggle("AutoShootOpenOnly", {
        Text    = "Only when open",
        Default = false,
        Tooltip = "Waits until no defender is close",
    })

    box:AddSlider("AutoShootOpenDistance", {
        Text     = "Defender distance",
        Default  = 10,
        Min      = 3,
        Max      = 30,
        Rounding = 0,
        Suffix   = " studs",
    })

    box:AddToggle("AutoShootShowRange", {
        Text     = "Show range",
        Default  = true,
        Callback = refreshRing,
    }):AddColorPicker("AutoShootRangeColor", {
        Default = RANGE_COLOR,
        Title   = "Circle color",
    })

    labels.bind(box:AddLabel("Off", true), function() return statusText end)

    box:SetupDependencies({
        { Toggles.AutoShoot, true },
    })

    track(Shot.Started:Connect(function(shot)
        taken = true
        if pressedAt then
            pressedAt = nil
            ownShot = shot
        end
    end))

    track(Shot.Finished:Connect(function(shot)
        if shot ~= ownShot then return end
        ownShot = nil
        -- a shot can close with no release ever sent, and nothing else would let go of this press
        if Input.held("shoot") then Input.shootRelease() end
        release.drop(CLAIM)
    end))

    return {
        cleanup = function()
            enabled = false
            if tick then
                tick:Disconnect()
                tick = nil
            end
            if (pressedAt or ownShot) and Input.held("shoot") then Input.shootRelease() end
            pressedAt, ownShot = nil, nil
            release.drop(CLAIM)
            ring.destroy()
        end,
    }
end

end)
__bundle_register("Features/Basketball/Shooting/RangeRing", function(require, _LOADED, __bundle_register, __bundle_modules)
-- range ring: the auto shoot range drawn as a circle of lines around your hoop at your own height, coloured by the same test that fires the shot, so what you see and what triggers can never disagree
local Executor  = require("Utility/Executor")
local Scheduler = require("Utility/Scheduler")

local SEGMENTS  = 48
local THICKNESS = 2
local IN_RANGE  = Color3.fromRGB(95, 235, 130)

local COS, SIN = {}, {}
for i = 1, SEGMENTS do
    local angle = (i - 1) / SEGMENTS * math.pi * 2
    COS[i], SIN[i] = math.cos(angle), math.sin(angle)
end

local M = {}

-- deps: Workspace, position(), reach() -> (hoop, flat, range, inside), color()
function M.new(deps)
    local lines, showing = {}, {}
    local points, inFront = {}, {}
    local painted
    local handle

    local function removeLines()
        for i = #lines, 1, -1 do
            pcall(function() lines[i]:Remove() end)
            lines[i], showing[i] = nil, nil
        end
        painted = nil
    end

    -- a missing or stubbed Drawing just means no ring; auto shoot itself does not need it
    local function build()
        if #lines == SEGMENTS then return true end
        local Drawing = Executor.get("Drawing")
        if Drawing == nil then return false end
        for i = #lines + 1, SEGMENTS do
            local ok, line = pcall(function() return Drawing.new("Line") end)
            if not (ok and line) then
                removeLines()
                return false
            end
            line.Thickness    = THICKNESS
            line.Transparency = 1
            line.Visible      = false
            lines[i], showing[i] = line, false
        end
        return true
    end

    local function hideLines()
        for i = 1, #lines do
            if showing[i] then
                lines[i].Visible = false
                showing[i] = false
            end
        end
    end

    local function paint()
        local camera = deps.Workspace.CurrentCamera
        local hoop, flat, range, inside = deps.reach()
        local me = deps.position()
        if not (camera and flat and me) then
            hideLines()
            return
        end

        local center = hoop.goal.Position
        local centerX, centerZ, height = center.X, center.Z, me.Y
        for i = 1, SEGMENTS do
            local screen = camera:WorldToViewportPoint(Vector3.new(centerX + COS[i] * range, height, centerZ + SIN[i] * range))
            points[i] = Vector2.new(screen.X, screen.Y)
            inFront[i] = screen.Z > 0
        end

        local color = inside and IN_RANGE or deps.color()
        if color ~= painted then
            painted = color
            for i = 1, SEGMENTS do lines[i].Color = color end
        end

        for i = 1, SEGMENTS do
            local nextPoint = i % SEGMENTS + 1
            local line = lines[i]
            if inFront[i] and inFront[nextPoint] then
                line.From, line.To = points[i], points[nextPoint]
                if not showing[i] then
                    line.Visible = true
                    showing[i] = true
                end
            elseif showing[i] then
                line.Visible = false
                showing[i] = false
            end
        end
    end

    local function hide()
        if handle then
            handle:Disconnect()
            handle = nil
        end
        hideLines()
    end

    return {
        show = function()
            if handle then return true end
            if not build() then return false end
            handle = Scheduler.render(paint, { name = "AutoShootRing", deferrable = true })
            return true
        end,
        hide = hide,
        destroy = function()
            hide()
            removeLines()
        end,
    }
end

return M

end)
__bundle_register("Features/Basketball/Shooting/AutoCalibrate", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto calibrate: lets the shot api learn the release from where each of your shots froze, says in plain words how that is going, and can forget it all; the learning itself lives in the api
local UiWrite = require("Utility/UiWrite")

local Words = require("Features/Basketball/Shooting/Words")

local WINDOW      = 12  -- recent shots the verdict is based on
local MIN_VERDICT = 5   -- fewer than this says nothing about how it is going

return function(ctx)
    local Options = ctx.Options
    local Shot    = ctx.Api.Shot
    local group   = ctx.Group
    local labels  = ctx.Labels

    local toggle = group:AddToggle("AutoCalibrate", {
        Text     = "Auto Calibrate",
        Default  = true,
        Tooltip  = "Learns timing from your shots",
        Callback = function(on)
            Shot.setLearning(on)
            labels.touch()
        end,
    })

    labels.bind(group:AddLabel("Waiting for a shot", true), function()
        if not Shot.learning() then return "Off, learning kept" end

        local history = Shot.history()
        local seen = math.min(#history, WINDOW)
        local perfect = 0
        for i = 1, seen do
            if history[i].grade == Shot.PERFECT then perfect = perfect + 1 end
        end
        if seen >= MIN_VERDICT and perfect * 2 >= seen then
            return ("Dialed in: %d/%d Perfect"):format(perfect, seen)
        end

        local learned = Shot.learnedShots()
        if learned == 0 then return "Waiting for a shot" end
        return ("Learning: %s"):format(Words.count(learned, "shot"))
    end)

    group:AddButton({
        Text        = "Reset",
        DoubleClick = true,
        Tooltip     = "Forgets what it learned. Click twice.",
        Func = function()
            Shot.resetLearning()
            UiWrite.value(Options.ReleaseOffset, 0)
            labels.touch()
        end,
    })

    Shot.setLearning(toggle.Value)

    return {}
end

end)
