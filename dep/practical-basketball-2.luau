    local labelTop = corners and (corners.topLeft + corners.topRight) * 0.5 or self.screenPoint
    local labelBottom = corners and (corners.bottomLeft + corners.bottomRight) * 0.5 or self.screenPoint

    local name = group.name
    self.name.Visible = enabled and onScreen and name.enabled and labelTop ~= nil
