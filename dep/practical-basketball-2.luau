-- zoom sub-module of utils (fov-based zoom on the render lane)
local Scheduler = require("Utility/Scheduler")

return function(ctx)
    local Services   = ctx.Services
    local Library    = ctx.Library
    local References = ctx.References
    local Toggles    = ctx.Toggles
    local UtilsGroup = ctx.UtilsGroup
    local track      = ctx.track

    local Zoom = { on = false, conn = nil, origFov = nil, strength = 2 }

    local function applyZoom()
        local cam = References.camera or Services.Workspace.CurrentCamera
        if not (cam and Zoom.origFov) then return end
        cam.FieldOfView = math.clamp(Zoom.origFov / math.max(0.1, Zoom.strength), 10, 120)
    end

