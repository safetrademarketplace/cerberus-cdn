        local frame = New("Frame", {
            Name             = "Pane_" .. name,
            Size             = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            BorderSizePixel  = 0,
            Visible          = false,
            Parent           = self.contentArea,
