end

Object.Render = function(self, camera, viewport)
    local group = self.group
    local shared = self.shared
    local sample = self.sample
    local tint = sample.tint
    local onScreen = self.onScreen
    local enabled = self.enabled
    local corners = self.corners
    local textSize = shared.textSize or 13
    local textFont = shared.textFont or 2

    -- chams show through walls and off screen, so they follow enabled and not on-screen
    local highlight = self.highlight
    if highlight then
        local wanted = enabled and group.chams.enabled
        if wanted ~= self.chamsOn then
            highlight.Enabled = wanted
            self.chamsOn = wanted
        end
    end

    local drawBox = enabled and onScreen and corners ~= nil
    local box = group.box
    self.box.Visible = drawBox and box.enabled
    self.boxOutline.Visible = self.box.Visible and box.outline
    if self.box.Visible then
        self.box.Position = corners.topLeft
        self.box.Size = corners.bottomRight - corners.topLeft
        self.box.Color = tint or box.color
        self.box.Transparency = box.transparency
        self.box.Thickness = box.thickness or 1
        if self.boxOutline.Visible then
            self.boxOutline.Position = corners.topLeft
            self.boxOutline.Size = self.box.Size
            self.boxOutline.Color = box.outlineColor
            self.boxOutline.Transparency = box.transparency
        end
    end

    local fill = group.boxFill
    self.boxFill.Visible = drawBox and fill.enabled
    if self.boxFill.Visible then
        self.boxFill.Position = corners.topLeft
        self.boxFill.Size = corners.bottomRight - corners.topLeft
        self.boxFill.Color = tint or fill.color
        self.boxFill.Transparency = fill.transparency
    end

    local leftCfg = group.leftBar
    local leftValue = sample.left
    local leftRatio = leftValue and math.clamp(leftValue, 0, 1) or 1
    self.leftBar.Visible = drawBox and leftCfg.enabled and leftValue ~= nil
    self.leftOutline.Visible = self.leftBar.Visible and leftCfg.outline
    if self.leftBar.Visible then
        local barBottom = corners.bottomLeft - BAR_OFFSET
        local barTop = corners.topLeft - BAR_OFFSET
        self.leftBar.To = barBottom
        self.leftBar.From = barBottom:Lerp(barTop, leftRatio)
        self.leftBar.Color = leftCfg.emptyColor:Lerp(leftCfg.fullColor, leftRatio)
        if self.leftOutline.Visible then
            self.leftOutline.To = barBottom + BAR_CAP
            self.leftOutline.From = barTop - BAR_CAP
            self.leftOutline.Color = leftCfg.outlineColor
        end
    end
    self.leftText.Visible = drawBox and leftCfg.text and sample.leftText ~= nil
    if self.leftText.Visible then
