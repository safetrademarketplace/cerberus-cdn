__bundle_register("Features/Basketball/Effects/LowEffects", function(require, _LOADED, __bundle_register, __bundle_modules)
-- low effects feature: a switch per expensive visual plus one for the lot, held through prefs overrides so nothing reaches the account, with the measured frame rate either side of the change
local Jobs    = require("Utility/Jobs")
local Log     = require("Utility/Log")
local UiWrite = require("Utility/UiWrite")

local FrameRate    = require("Features/Basketball/Effects/FrameRate")
local MenuCallback = require("Features/Basketball/Effects/MenuCallback")

local LEVERS = {
    {
        id = "LowFxCrowd", short = "crowd", setter = "setCrowd", value = "None",
        text = "No crowd",
        tooltip = "Usually the biggest win",
    },
    {
        id = "LowFxShadows", short = "shadows", setter = "setShadows", value = false,
        text = "No shadows",
    },
    {
        id = "LowFxNets", short = "nets", setter = "setNets", value = false,
        text = "No hoop nets",
        tooltip = "Scoring stays the same",
    },
    {
        id = "LowFxGreen", short = "green effects", setter = "setGreenEffects", value = false,
        text = "No green effects",
        tooltip = "Your shot still greens",
    },
    {
        id = "LowFxBadges", short = "badge effects", setter = "setBadgeEffects", value = false,
        text = "No badge effects",
    },
    {
        id = "LowFxStreak", short = "streak effects", setter = "setStreakEffects", value = false,
        text = "No streak effects",
    },
    {
        id = "LowFxShotCam", short = "shot camera", setter = "setShotCamera", value = false,
        text = "No shot camera",
        tooltip = "The movie after a perfect shot",
    },
    {
        id = "LowFxHair", short = "hair", setter = "setHairPhysics", value = false,
        text = "No hair movement",
        tooltip = "Only hair that loads later",
    },
    {
        id = "LowFxSparks", short = "sparks", setter = "setSparks", value = false,
        text = "No sparks or glow",
        tooltip = "Only what is already in the map",
    },
    {
        id = "LowFxScenery", short = "scenery", setter = "setScenery", value = false,
        text = "No scenery",
    },
    {
        id = "LowFxEvents", short = "event effects", setter = "setEventEffects", value = false,
        text = "No event effects",
    },
}

local NOTHING_OFF = "Nothing off"

return function(ctx)
    local Library = ctx.Library
    local Prefs   = ctx.Api and ctx.Api.Prefs
    local tab     = ctx.Tabs.Misc

    local group = tab:AddLeftGroupbox("Low Effects", "zap-off")

    if not Prefs then
        group:AddLabel({ Text = "Not available here", DoesWrap = true })
        return
    end

    local meter = FrameRate.new()

    local dead, cascading, bouncing = false, false, false
    local held, waiting, refused, byMaster = {}, {}, {}, {}
    local switches = {}
    local master, statusLabel, statusJob
    local shownStatus = NOTHING_OFF
    local baseline, reading, measuring

    local function statusText()
        local off, pending, blocked = {}, {}, {}
        for _, lever in ipairs(LEVERS) do
            if held[lever.id] then off[#off + 1] = lever.short end
            if waiting[lever.id] then pending[#pending + 1] = lever.short end
            if refused[lever.id] then blocked[#blocked + 1] = lever.short end
        end

        local parts = {}
        if #off == 0 then parts[1] = NOTHING_OFF else parts[1] = "Off: " .. table.concat(off, ", ") end
        if #pending > 0 then
            parts[#parts + 1] = "Waiting: " .. table.concat(pending, ", ")
        end
        if #blocked > 0 then
            parts[#parts + 1] = "Not available here: " .. table.concat(blocked, ", ")
        end
        if measuring then
            parts[#parts + 1] = "Checking frame rate"
        elseif reading and baseline then
            parts[#parts + 1] = string.format("Frame rate: %d before, %d now",
                math.round(baseline), math.round(reading))
        elseif reading then
            parts[#parts + 1] = string.format("Frame rate now: %d", math.round(reading))
        end
        return table.concat(parts, "\n")
    end

    -- one label write per batch, so the master switch does not rebuild the groupbox eleven times
    local function queueStatus()
        if dead or statusJob then return end
        statusJob = Jobs.delay(0, function()
            statusJob = nil
            if dead then return end
            local text = statusText()
            if text ~= shownStatus and UiWrite.text(statusLabel, text) then shownStatus = text end
        end, { name = "LowEffectsStatus" })
    end

    local function noteChange(wasIdle)
        if wasIdle then baseline, reading = meter.average(), nil end
        if next(held) then
            measuring, reading = true, nil
            meter.measure()
        else
            baseline, reading, measuring = nil, nil, nil
            meter.cancel()
        end
    end

    -- a lever that throws counts as refused, so one bad lever can never stop the ones after it
    local function pull(lever)
        local ok, token, reason = pcall(Prefs[lever.setter], lever.value)
        if not ok then
            Log.devwarn("LowEffects", "%s threw: %s", lever.setter, tostring(token))
            return nil, nil
        end
        return token, reason
    end

    local function restore(token)
        local ok, err = pcall(token.Restore)
        if not ok then Log.devwarn("LowEffects", "restore failed: %s", tostring(err)) end
    end

    -- false only for a lever this place cannot do; one the game has not loaded yet stays on and is retried
    local function engage(lever)
        local wasIdle = next(held) == nil
        local token, reason = pull(lever)
        if token then
            held[lever.id] = token
            waiting[lever.id], refused[lever.id] = nil, nil
            noteChange(wasIdle)
            return true
        end
        if reason == Prefs.Errors.NOT_READY then
            waiting[lever.id], refused[lever.id] = true, nil
            return true
        end
        waiting[lever.id], refused[lever.id] = nil, true
        return false
    end

    -- the bounce back off is the game saying no, not the player changing their mind
    local function apply(lever)
        if engage(lever) then return end
        byMaster[lever.id] = nil
        bouncing = true
        UiWrite.value(switches[lever.id], false)
        bouncing = false
    end

    local function release(lever)
        waiting[lever.id] = nil
        local token = held[lever.id]
        if not token then return end
        held[lever.id] = nil
        restore(token)
        noteChange(false)
    end

    -- a switch turned off by hand means the master is no longer telling the truth, but the others stay as they are
    local function dropMaster(lever)
        byMaster[lever.id] = nil
        if not master.Value then return end
        cascading = true
        UiWrite.value(master, false)
        cascading = false
    end

    local function onSwitch(lever, on)
        if dead then return end
        if on then
            if not held[lever.id] then apply(lever) end
        else
            release(lever)
            if not (cascading or bouncing) then dropMaster(lever) end
        end
        queueStatus()
    end

    -- switching the master off only undoes what the master itself switched on
    local function onMaster(on)
        if dead or cascading then return end
        cascading = true
        for _, lever in ipairs(LEVERS) do
            local switch = switches[lever.id]
            if on and not switch.Value then
                byMaster[lever.id] = true
                UiWrite.value(switch, true)
            elseif not on and byMaster[lever.id] then
                byMaster[lever.id] = nil
                UiWrite.value(switch, false)
            end
        end
        cascading = false
        queueStatus()
    end

    master = group:AddToggle("LowFxAll", {
        Text = "Turn off everything",
        Default = false,
        Tooltip = "Not saved to your account",
        Callback = MenuCallback(onMaster),
    })

    group:AddDivider()

    for _, lever in ipairs(LEVERS) do
        switches[lever.id] = group:AddToggle(lever.id, {
            Text = lever.text,
            Default = false,
            Tooltip = lever.tooltip,
            Callback = MenuCallback(function(on) onSwitch(lever, on == true) end),
        })
    end

    statusLabel = group:AddLabel({ Text = NOTHING_OFF, DoesWrap = true })

    -- armed only with this tab on screen or a reading under way, so a closed menu costs nothing per frame
    ctx.track(Jobs.interval(FrameRate.SAMPLE_SECONDS, function()
        local finished = meter.tick(Library.Toggled == true and Library.ActiveTab == tab)
        if finished then
            reading, measuring = finished, nil
            queueStatus()
        end
        if next(waiting) then
            for _, lever in ipairs(LEVERS) do
                if waiting[lever.id] then apply(lever) end
            end
            queueStatus()
        end
    end, { name = "LowEffectsTick" }))

    return {
        cleanup = function()
            dead = true
            meter.stop()
            for _, lever in ipairs(LEVERS) do
                local token = held[lever.id]
                if token then restore(token) end
            end
            table.clear(held)
