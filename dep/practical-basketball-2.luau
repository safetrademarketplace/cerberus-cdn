__bundle_register("Features/Basketball/Defense/AutoSteal", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto steal: reaches when an opposing carrier is inside your reach, judged on where they will be by the time the reach lands, at your pace, and never again until the last reach has played out
local Scheduler = require("Utility/Scheduler")
local Kit       = require("Features/Basketball/Defense/Kit")
local Motion    = require("Features/Basketball/Defense/Motion")

local TICK   = 0.05  -- how often we look; the wait slider is what paces the reaches
local SETTLE = 0.15  -- extra breath after a reach finishes, since a second reach on its heels is how fouls get handed out

local STEALING = "Stealing"  -- our action while a reach plays (Movement:378)
local SHOOTING = "Shooting"

return function(ctx)
    local Library = ctx.Library
    local Toggles = ctx.Toggles
    local court   = ctx.Api and ctx.Api.Court
    local input   = ctx.Api and ctx.Api.Input
    local player  = ctx.Api and ctx.Api.Player
    local me      = ctx.References.player

    local Group = ctx.Tabs.Defense:AddLeftGroupbox("Auto Steal", "hand")
    if not (court and input and player) then
        Group:AddLabel("Not available here", true)
        return
    end

    local reach, wait = 8, 0.6

    Group:AddToggle("AutoStealEnabled", {
        Text = "Auto Steal",
        Default = false,
    }):AddKeyPicker("AutoStealKey", {
        Default = nil,
        SyncToggleState = true,
        Mode = "Toggle",
        Text = "Auto Steal",
    })

    local Box = Group:AddDependencyBox()
    Box:AddSlider("AutoStealReach", {
        Text = "Reach",
        Default = reach,
        Min = 4,
        Max = 20,
        Rounding = 0,
        Suffix = " studs",
        Callback = function(value) reach = value end,
    })
    Box:AddSlider("AutoStealWait", {
        Text = "Wait between",
        Default = wait,
        Min = 0.2,
        Max = 3,
        Rounding = 2,
        Suffix = " s",
        Tooltip = "Reaching too often gives fouls.",
        Callback = function(value) wait = value end,
    })
    local say = Kit.writer(Library, Box:AddLabel({ Text = "Off", DoesWrap = true }))
    Box:SetupDependencies({ { Toggles.AutoStealEnabled, true } })

    local armed = Kit.armedMaid(ctx.track)
    local active = false
    local motion = Motion.new()
    local target = nil
    local lastReach, settledAt = nil, nil

    local function nearestCarrier(position)
        local list = court.opponents()
        local best, bestDistance = nil, math.huge
        for i = 1, #list do
            local rec = list[i]
            local root = rec.root
            if rec.held and root then
                local at = root.Position
                local dx, dz = at.X - position.X, at.Z - position.Z
                local distance = dx * dx + dz * dz
                if distance < bestDistance then best, bestDistance = rec, distance end
            end
        end
        return best
    end

    local function tick()
        local position = player.position()
        if not position then return say("Waiting for your character") end
        if court.hasBall() then return say("You have the ball") end

        local rec = nearestCarrier(position)
        if not rec then
            target = nil
            return say("No opponent has it")
        end

        local now = os.clock()
        if rec ~= target then
            target = rec
            motion:reset()
        end
        local at = rec.root.Position
        local vx, vz = motion:sample(at, now)
        local lead = Kit.ping(me)
        local dx, dz = at.X + vx * lead - position.X, at.Z + vz * lead - position.Z
        local away = math.sqrt(dx * dx + dz * dz)
        local name = Kit.clean(rec.name)

        if away > reach then return say(("%s, %s away"):format(name, Kit.studs(away))) end

        if player.action() == STEALING then settledAt = now + SETTLE end
        local gap = math.max(wait, lead + SETTLE)
        if (settledAt and now < settledAt) or (lastReach and now - lastReach < gap) then
            return say("Waiting to reach again")
        end
        if rec.model:GetAttribute("Action") == SHOOTING then
            return say(("%s is shooting"):format(name))
        end

        lastReach = now
        if input.steal() then
            say(("Reaching for %s"):format(name))
        else
            say("Reach failed")
        end
    end

    local function setActive(on)
        if on == active then return end
        active = on
        armed:DoCleaning()
        target, lastReach, settledAt = nil, nil, nil
        motion:reset()
        if on then
            armed:GiveTask(Scheduler.heartbeat(tick, { name = "AutoSteal", interval = TICK }))
        else
            say("Off", true)
        end
    end

    Toggles.AutoStealEnabled:OnChanged(setActive)
end

end)
__bundle_register("Features/Basketball/Defense/Motion", function(require, _LOADED, __bundle_register, __bundle_modules)
-- defense motion: how fast a body is moving across the floor, from where it has been, because a remote player's velocity reads zero here
local SMOOTHING   = 0.4   -- weight of the newest reading; replicated positions land unevenly
local STALE_AFTER = 0.3   -- a gap this long means the old reading says nothing about now
local MIN_STEP    = 1 / 240
local MAX_SPEED   = 60    -- nobody runs this fast, so a step this big is the game moving them

local Motion = {}
Motion.__index = Motion

function Motion.new()
    return setmetatable({ vx = 0, vz = 0 }, Motion)
end

function Motion:reset()
    self.at = nil
    self.vx, self.vz = 0, 0
end

-- returns the smoothed speed along x and z, zero until there are two readings to compare
function Motion:sample(position, now)
    local at = self.at
    local gap = at and (now - at) or nil
    if gap and gap < MIN_STEP then return self.vx, self.vz end

    local x, z = position.X, position.Z
    if not gap or gap > STALE_AFTER then
        self.vx, self.vz = 0, 0
    else
        local stepX, stepZ = (x - self.x) / gap, (z - self.z) / gap
        if stepX * stepX + stepZ * stepZ > MAX_SPEED * MAX_SPEED then
            self.vx, self.vz = 0, 0
        else
            self.vx = self.vx + (stepX - self.vx) * SMOOTHING
            self.vz = self.vz + (stepZ - self.vz) * SMOOTHING
        end
    end
    self.x, self.z, self.at = x, z, now
    return self.vx, self.vz
end

return Motion

end)
__bundle_register("Features/Basketball/Defense/AutoRebound", function(require, _LOADED, __bundle_register, __bundle_modules)
-- auto rebound: jumps as a shot comes down near you; samples only balls in the air, predicts from their measured motion when and where they pass your reach height, waits out anything still bound for the rim, and stands down the moment anyone gets the ball
local Flat      = require("Api/Court/Flat")
local Scheduler = require("Utility/Scheduler")
local Flight    = require("Features/Basketball/Defense/Flight")
local Jumper    = require("Features/Basketball/Defense/Jumper")
local Kit       = require("Features/Basketball/Defense/Kit")

local DEFAULT_REACH = 8

local JUMP_LIFT      = 3     -- how far a jump lifts your hands before the ball reaches them; checked live
local FALLBACK_REACH = 4.4   -- standing reach above the root at the formula's average build
local RIM_RISE       = 1.3   -- every rim touch in Config.Game.Basketball aims at the goal part plus this
local BOARD_ZONE     = 6.5   -- a first leg can be aimed off the board, 5.7 out, and still hits the hoop before it falls
local RIM_ZONE       = 3.2   -- later legs only count if they land on the rim itself, 1.42 out plus the ball
local THROUGH_RIM    = 1.6   -- under the rim and this close to its middle, the shot went in
local MAX_FOLLOW     = 6     -- no shot stays up this long
local AFTER_CLEAR    = 2     -- the flag can clear mid bounce (Basketball.RimOut), so the fall gets this long after it
local BALL_BEHIND    = 0.065 -- the client draws a ball at server time less ReplicationConfig.Ball.DELAY, plus its smoothing

return function(ctx)
    local Library   = ctx.Library
    local Toggles   = ctx.Toggles
    local Workspace = ctx.Services.Workspace
    local court     = ctx.Api and ctx.Api.Court
    local player    = ctx.Api and ctx.Api.Player
    local jumper    = ctx.Jumper
    local me        = ctx.References.player

    local Group = ctx.Tabs.Defense:AddRightGroupbox("Auto Rebound", "hand-metal")
    if not (court and player and jumper) then
        Group:AddLabel("Not available here", true)
        return
    end

    local reach = DEFAULT_REACH

    Group:AddToggle("AutoReboundEnabled", {
        Text = "Auto Rebound",
        Default = false,
    }):AddKeyPicker("AutoReboundKey", {
        Default = nil,
        SyncToggleState = true,
        Mode = "Toggle",
        Text = "Auto Rebound",
    })

    local Box = Group:AddDependencyBox()
    Box:AddSlider("AutoReboundReach", {
        Text = "Reach",
        Default = reach,
        Min = 2,
        Max = 20,
        Rounding = 0,
        Suffix = " studs",
        Callback = function(value) reach = value end,
    })
    local say = Kit.writer(Library, Box:AddLabel({ Text = "Off", DoesWrap = true }))
    Box:SetupDependencies({ { Toggles.AutoReboundEnabled, true } })

    local armed = Kit.armedMaid(ctx.track)
    local active = false
    local follows = {}
    local jumpedAt = {}
    local samplerTask = nil

    -- hand height above the root, from the game's own standing reach (Scenarios.Dunk:236-239)
    local function standingReach()
        local build = player.build()
        local height, wingspan = build and build.height, build and build.wingspan
        if type(height) ~= "number" or type(wingspan) ~= "number" then return FALLBACK_REACH end
        return 3.85 * (1.135 + (height - 69) * 0.025) + (wingspan - height) * 1.2 / 12
    end

