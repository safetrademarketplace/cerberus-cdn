__bundle_register("Features/Misc/Spectate", function(require, _LOADED, __bundle_register, __bundle_modules)
-- spectate sub-module of misc: points the camera at a court player's root and hands it back on stop; the game's player camera rewrites CameraSubject every frame just after the camera step reads it, so the write is repeated each render frame and a one-off would be gone before it was ever read
local Identity  = require("Utility/Identity")
local Jobs      = require("Utility/Jobs")
local Scheduler = require("Utility/Scheduler")
local UiWrite   = require("Utility/UiWrite")

-- a respawn empties the name for a moment, so a target only counts as gone after this long
local LOST_GRACE_SECONDS = 3
local REFRESH_DELAY = 0.25

return function(ctx)
    local Api = ctx.Api
    local Court, Player = Api and Api.Court, Api and Api.Player
    if not (Court and Player) then return {} end

    local Workspace = ctx.Services.Workspace
    local Library   = ctx.Library
    local track     = ctx.track

    local target, targetName, lostAt, driver, previous, refreshJob

    local SpectateGroupbox = ctx.Tabs.Misc:AddLeftGroupbox("Spectate", "view")

    local dd = SpectateGroupbox:AddDropdown("SpectateTarget", {
        Values = {},
        Default = nil,
        Multi = false,
        Text = "Select Player",
        Searchable = true,
    })

    local function recordNamed(name)
        local list = Court.players()
        for i = 1, #list do
            local rec = list[i]
            if rec.name == name and not rec.isLocal then return rec end
        end
        return nil
    end

    local function rosterNames()
        local names, used = {}, {}
        local list = Court.players()
        for i = 1, #list do
            local rec = list[i]
            if not rec.isLocal and rec.root and not used[rec.name] then
                used[rec.name] = true
                names[#names + 1] = rec.name
            end
        end
        return names
    end

    local function refreshNames()
        local names = rosterNames()
        UiWrite.values(dd, names)
        if dd.Value and not targetName and not table.find(names, dd.Value) then
            UiWrite.value(dd, nil)
        end
    end

    SpectateGroupbox:AddButton({
        Text = "Refresh Players",
        Func = refreshNames,
    })

    local tg = SpectateGroupbox:AddToggle("SpectateEnabled", {
        Text = "Spectate Player",
        Default = false,
        Tooltip = "Normal camera view only",
    })

    local function stopDriver()
        if driver then
            driver:Disconnect()
            driver = nil
        end
    end

    local function stopSpectate()
        if not targetName then return end
        target, targetName, lostAt = nil, nil, nil
        stopDriver()
        Identity.elevate()
        local back = previous
        previous = nil
        if not (back and back.Parent) then back = Player.humanoid() end
        local camera = Workspace.CurrentCamera
        if camera and back then camera.CameraSubject = back end
    end

    local function giveUp()
        stopSpectate()
        UiWrite.value(tg, false)
        UiWrite.notify(Library, "Player left, spectate stopped", 4)
    end

    -- every wake, because a scheduler callback runs below the identity a camera write needs; a dead record stays dead, so a new body is found again by name
    local function step()
        Identity.elevate()
        local root = target and target.root
        if not root then
            target = recordNamed(targetName)
            root = target and target.root
        end
        if not root then
            local now = os.clock()
            lostAt = lostAt or now
            if now - lostAt >= LOST_GRACE_SECONDS then giveUp() end
            return
        end
        lostAt = nil
        local camera = Workspace.CurrentCamera
        if camera and camera.CameraSubject ~= root then camera.CameraSubject = root end
    end

    -- the first start keeps the subject to hand back, and switching player mid-watch keeps it; not deferrable, since one skipped frame is one frame on your own head
    local function startSpectate(name)
        local rec = name and recordNamed(name)
        if not (rec and rec.root) then return false end
        Identity.elevate()
        if not targetName then
            local camera = Workspace.CurrentCamera
            previous = camera and camera.CameraSubject or nil
        end
        target, targetName, lostAt = rec, name, nil
        stopDriver()
        driver = Scheduler.render(step, { name = "Spectate", priority = 150 })
        step()
        return true
    end

    tg:OnChanged(function()
        if not tg.Value then
            stopSpectate()
        elseif not startSpectate(dd.Value) then
            UiWrite.notify(Library, "Pick a player first", 3)
            UiWrite.value(tg, false)
        end
    end)

    dd:OnChanged(function(name)
        if tg.Value and name and not startSpectate(name) then
            UiWrite.notify(Library, "Player not on the court", 3)
        end
    end)

    -- what we saved belongs to a body that has just gone back to the pool
    track(Player.CharacterChanged:Connect(function() previous = nil end))

    -- several changes land together when a body recycles, so they share one refresh
    track(Court.RosterChanged:Connect(function()
        if refreshJob and refreshJob.alive then return end
        refreshJob = Jobs.delay(REFRESH_DELAY, refreshNames, { name = "SpectateNames" })
    end))

    -- the first fill is after every widget, because reading the game between Add calls can drop the identity they need
    track(Jobs.spawn(function() refreshNames() end, { name = "SpectateFill" }))

    local function cleanup()
        stopSpectate()
        UiWrite.value(tg, false)
    end

    return { cleanup = cleanup }
end

end)
__bundle_register("Features/Misc/StreamerMode", function(require, _LOADED, __bundle_register, __bundle_modules)
-- streamer mode: hides player names/skins via nameplate DDT, stripped avatar assets, and throttled TextLabel substitution
local Executor  = require("Utility/Executor")
local Scheduler = require("Utility/Scheduler")
local UiHost    = require("UI/UiHost")

return function(ctx)
    local Services = ctx.Services
    local Tabs     = ctx.Tabs
    local Library  = ctx.Library
    local Toggles  = ctx.Toggles

    local Players          = Services.Players
    local TextChatService  = Services.TextChatService
    local CoreGui          = Services.CoreGui
    local UIRoot           = UiHost.pick() or CoreGui
    local LOCAL            = Players.LocalPlayer

    local SCRUB_BUDGET_PER_FRAME = 40
    local NEUTRAL_COLOR = Color3.fromRGB(130, 130, 130)
    local DEFAULT_DDT = Enum.HumanoidDisplayDistanceType.Viewer

    local Streamer = {
        enabled = false,
        selected = {
            ["Hide Own Name"]     = false,
            ["Hide Others Names"] = false,
            ["Hide Own Skin"]     = false,
            ["Hide Others Skins"] = false,
        },
    }

    -- uid → original Humanoid.DisplayDistanceType
    local origDDT = {}
    -- uid → { acc={...}, shirt, pants, tshirt, colors={...} }
    local origSkin = {}

    -- patterns sorted longest-first so "DisplayName" wins over "Name"
    local replaceMap = { patterns = {}, alias = {}, plain = {}, dirty = true }

    local mainConns = {}
    local playerConns = {}
    -- weak keys so GC'd labels don't pin their PropertyChangedSignal entries
    local textWatchers = setmetatable({}, { __mode = "k" })

    local pending = {}
    local pendingSet = setmetatable({}, { __mode = "k" })

    local chatConn = nil
    local legacyChatConns = {}

    local function alive(inst)
        return typeof(inst) == "Instance" and inst.Parent ~= nil
    end

    local function safeChild(parent, classOrName, byClass)
        if not alive(parent) then return nil end
        local ok, res = pcall(function()
            if byClass then
                return parent:FindFirstChildOfClass(classOrName)
            end
            return parent:FindFirstChild(classOrName)
        end)
        if ok and alive(res) then return res end
        return nil
    end

    local function escapePattern(s)
        return (tostring(s or ""):gsub("([^%w])", "%%%1"))
    end

    local function disconnectList(t)
        for _, c in ipairs(t) do
            pcall(function() c:Disconnect() end)
        end
        table.clear(t)
    end

    local function addPlayerConn(uid, conn)
        local bucket = playerConns[uid]
        if not bucket then
            bucket = {}
            playerConns[uid] = bucket
        end
        bucket[#bucket + 1] = conn
    end

    local function dropPlayerConns(uid)
        local bucket = playerConns[uid]
        if not bucket then return end
        disconnectList(bucket)
        playerConns[uid] = nil
    end

    local function markMapDirty()
        replaceMap.dirty = true
    end

    local function rebuildMap()
        local hideSelf   = Streamer.selected["Hide Own Name"]
        local hideOthers = Streamer.selected["Hide Others Names"]
        replaceMap.patterns = {}
        replaceMap.alias    = {}
        replaceMap.plain    = {}
        replaceMap.dirty    = false
        if not (hideSelf or hideOthers) then return end

        local raw = {}
        local function addRaw(s)
            if type(s) == "string" and s ~= "" and s ~= "???" then
                raw[s] = true
            end
        end

        for _, p in ipairs(Players:GetPlayers()) do
            local isMe = (p.UserId == LOCAL.UserId)
            if (isMe and hideSelf) or ((not isMe) and hideOthers) then
                addRaw(p.Name)
                addRaw(p.DisplayName)
            end
        end

        local list = {}
        for s in pairs(raw) do list[#list + 1] = s end
        table.sort(list, function(a, b) return #a > #b end)

        for i, s in ipairs(list) do
            local pat = escapePattern(s)
            replaceMap.patterns[i] = pat
            replaceMap.plain[i]    = s
            replaceMap.alias[pat]  = "???"
            local atPat = "@" .. pat
            replaceMap.patterns[#replaceMap.patterns + 1] = atPat
            replaceMap.plain[#replaceMap.plain + 1]       = "@" .. s
            replaceMap.alias[atPat] = "@???"
        end
    end

    local function getMap()
        if replaceMap.dirty then rebuildMap() end
        return replaceMap
    end

    -- idempotent so the PropertyChanged watcher can't loop
    local function scrubText(text)
        if type(text) ~= "string" or text == "" then return text, false end
        local map = getMap()
        local n = #map.patterns
        if n == 0 then return text, false end

        local out = text
        local changed = false
        for i = 1, n do
            local plain = map.plain[i]
            if string.find(out, plain, 1, true) then -- prefilter skips gsub alloc
                local pat = map.patterns[i]
                local replaced, count = out:gsub(pat, map.alias[pat])
                if count > 0 then
                    out = replaced
                    changed = true
                end
            end
        end
        return out, changed
    end

    local function isTextNode(inst)
        return inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox")
    end

    local function attachTextWatcher(node)
        if textWatchers[node] then return end
        textWatchers[node] = node:GetPropertyChangedSignal("Text"):Connect(function()
            if not Streamer.enabled then return end
            local newText, changed = scrubText(node.Text)
            if changed then node.Text = newText end
        end)
    end

    local function scrubTextNode(node)
        if not alive(node) then return end
        local newText, changed = scrubText(node.Text)
        if changed then
            node.Text = newText
            -- only labels that actually matched get a watcher
            attachTextWatcher(node)
        end
    end

    local function scrubInstance(obj)
        if not alive(obj) then return end
        if isTextNode(obj) then
            scrubTextNode(obj)
        elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") or obj:IsA("ScreenGui") then
            for _, d in ipairs(obj:GetDescendants()) do
                if isTextNode(d) then scrubTextNode(d) end
            end
        end
    end

    local function enqueue(obj)
        if not obj or pendingSet[obj] then return end
        pendingSet[obj] = true
        pending[#pending + 1] = obj
    end

    local heartbeatConn = nil
    local function startDrainer()
        if heartbeatConn then return end
        heartbeatConn = Scheduler.heartbeat(function()
            local count = #pending
            if count == 0 then return end
            if not Streamer.enabled then
                table.clear(pending)
                return
            end
            local map = getMap()
            if #map.patterns == 0 then
                table.clear(pending)
                return
            end
            local budget = SCRUB_BUDGET_PER_FRAME
            while budget > 0 and #pending > 0 do
                local obj = table.remove(pending)
                -- scrub BEFORE clearing pendingSet: the mutation re-fires the watcher, and the held flag blocks a same-frame re-enqueue
                scrubInstance(obj)
                pendingSet[obj] = nil
                budget = budget - 1
            end
        end, { name = "StreamerScrub", priority = 200, deferrable = true })
    end

    local function stopDrainer()
        if heartbeatConn then
            heartbeatConn:Disconnect()
            heartbeatConn = nil
        end
        table.clear(pending)
    end

    local function getHumanoid(plr)
        local char = plr and plr.Character
        if not alive(char) then return nil end
        return safeChild(char, "Humanoid", true)
    end

    local function setOverheadHidden(plr, hidden)
        local hum = getHumanoid(plr)
        if not hum then return end
        local uid = plr.UserId
        if hidden then
            if origDDT[uid] == nil then
                origDDT[uid] = hum.DisplayDistanceType
            end
            hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        else
            hum.DisplayDistanceType = origDDT[uid] or DEFAULT_DDT
        end
    end

    local function snapshotSkin(plr, char)
        local uid = plr.UserId
        if origSkin[uid] then return origSkin[uid] end

        local bucket = { acc = {}, shirt = nil, pants = nil, tshirt = nil, colors = nil }
        for _, inst in ipairs(char:GetChildren()) do
            if inst:IsA("Accessory") then
                bucket.acc[#bucket.acc + 1] = inst
            end
        end
        bucket.shirt  = safeChild(char, "Shirt", true)
        bucket.pants  = safeChild(char, "Pants", true)
        bucket.tshirt = safeChild(char, "ShirtGraphic", true)

        local bc = safeChild(char, "BodyColors", true)
        if bc then
            bucket.colors = {
                Head  = bc.HeadColor3,
                LA    = bc.LeftArmColor3,  RA = bc.RightArmColor3,
                LL    = bc.LeftLegColor3,  RL = bc.RightLegColor3,
                Torso = bc.TorsoColor3,
            }
        end

        origSkin[uid] = bucket
        return bucket
    end

    local function hideSkin(plr)
        local char = plr and plr.Character
        if not alive(char) then return end
        snapshotSkin(plr, char)

        for _, inst in ipairs(char:GetChildren()) do
            if inst:IsA("Accessory") then
                pcall(function() inst.Parent = nil end)
            end
        end
        for _, cls in ipairs({ "Shirt", "Pants", "ShirtGraphic" }) do
            local item = safeChild(char, cls, true)
            if item then pcall(function() item.Parent = nil end) end
        end

        local bc = safeChild(char, "BodyColors", true)
        if bc then
            pcall(function()
                bc.HeadColor3     = NEUTRAL_COLOR
                bc.LeftArmColor3  = NEUTRAL_COLOR
                bc.RightArmColor3 = NEUTRAL_COLOR
                bc.LeftLegColor3  = NEUTRAL_COLOR
                bc.RightLegColor3 = NEUTRAL_COLOR
                bc.TorsoColor3    = NEUTRAL_COLOR
            end)
        end
    end

    local function restoreSkin(plr)
        local bucket = origSkin[plr.UserId]
        if not bucket then return end
        local char = plr.Character
        if not alive(char) then return end

        if bucket.shirt  and bucket.shirt.Parent  == nil then pcall(function() bucket.shirt.Parent = char end) end
        if bucket.pants  and bucket.pants.Parent  == nil then pcall(function() bucket.pants.Parent = char end) end
        if bucket.tshirt and bucket.tshirt.Parent == nil then pcall(function() bucket.tshirt.Parent = char end) end

        for _, acc in ipairs(bucket.acc) do
            if alive(acc) and acc.Parent == nil then
                pcall(function() acc.Parent = char end)
            end
        end

        local bc = safeChild(char, "BodyColors", true)
        if bc and bucket.colors then
            pcall(function()
                bc.HeadColor3     = bucket.colors.Head
                bc.LeftArmColor3  = bucket.colors.LA
                bc.RightArmColor3 = bucket.colors.RA
                bc.LeftLegColor3  = bucket.colors.LL
                bc.RightLegColor3 = bucket.colors.RL
                bc.TorsoColor3    = bucket.colors.Torso
            end)
        end
    end

    local function applyFor(plr)
        if not (Streamer.enabled and plr) then return end
        local isMe = (plr.UserId == LOCAL.UserId)

        local hideName = (isMe and Streamer.selected["Hide Own Name"])
            or ((not isMe) and Streamer.selected["Hide Others Names"])
        setOverheadHidden(plr, hideName)

        local hideSkin_ = (isMe and Streamer.selected["Hide Own Skin"])
            or ((not isMe) and Streamer.selected["Hide Others Skins"])
        if hideSkin_ then
            hideSkin(plr)
        else
            restoreSkin(plr)
        end
    end

    local function restoreFor(plr)
        if not plr then return end
        setOverheadHidden(plr, false)
        restoreSkin(plr)
    end

    local function applyAll()
        markMapDirty()
        if not Streamer.enabled then
            for _, p in ipairs(Players:GetPlayers()) do restoreFor(p) end
            return
        end
        for _, p in ipairs(Players:GetPlayers()) do applyFor(p) end
        -- map likely changed — re-scan GUI roots
        for _, root in ipairs({ safeChild(LOCAL, "PlayerGui", false), UIRoot }) do
            if alive(root) then
                for _, d in ipairs(root:GetDescendants()) do
                    if isTextNode(d) or d:IsA("BillboardGui") then enqueue(d) end
                end
            end
        end
    end

    local function bindPlayer(plr)
        local uid = plr.UserId
        dropPlayerConns(uid)

        addPlayerConn(uid, plr.CharacterAdded:Connect(function()
            -- old bucket references destroyed children; drop it
            origSkin[uid] = nil
            origDDT[uid] = nil
            task.defer(function() applyFor(plr) end) -- let Humanoid settle
        end))

        if plr.Character then
            task.defer(function() applyFor(plr) end)
        end
    end

    local function bindGuiRoot(root)
        if not alive(root) then return end
        for _, d in ipairs(root:GetDescendants()) do enqueue(d) end
        mainConns[#mainConns + 1] = root.DescendantAdded:Connect(function(obj)
            if not Streamer.enabled then return end
            enqueue(obj)
        end)
    end

    local function bindPlayerGuiRoot()
        local pg = safeChild(LOCAL, "PlayerGui", false)
        bindGuiRoot(pg)
        mainConns[#mainConns + 1] = LOCAL.ChildAdded:Connect(function(child)
            if child and child.Name == "PlayerGui" then bindGuiRoot(child) end
        end)
    end

    local function hookChat()
        if chatConn then chatConn:Disconnect(); chatConn = nil end
        disconnectList(legacyChatConns)

        if TextChatService and TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            -- this is a callback with one owner, and the game's quick chat holds it, so it is chained only if the executor can read it and left alone otherwise
            local readCallback = Executor.get("getcallbackvalue")
            if type(readCallback) ~= "function" then return end
            local okRead, gameCallback = pcall(readCallback, TextChatService, "OnIncomingMessage")
            if not okRead then return end

            TextChatService.OnIncomingMessage = function(msg)
                local passed = type(gameCallback) == "function" and gameCallback(msg) or nil
                if not (Streamer.enabled and msg) then return passed end
                local src = msg.TextSource
                if not src then return passed end
                local plr = Players:GetPlayerByUserId(src.UserId)
                if not plr then return passed end

                local isMe = (plr.UserId == LOCAL.UserId)
                local hideName = (isMe and Streamer.selected["Hide Own Name"])
                    or ((not isMe) and Streamer.selected["Hide Others Names"])
                if not hideName then return passed end

                local props = Instance.new("TextChatMessageProperties")
                props.PrefixText = "???:"
                props.Text = (scrubText(msg.Text or ""))
                return props
            end
            chatConn = {
                Disconnect = function() TextChatService.OnIncomingMessage = gameCallback end,
            }
            return
        end

        local Rep = Services.ReplicatedStorage
        local ChatEvents = Rep and safeChild(Rep, "DefaultChatSystemChatEvents", false)
        if not ChatEvents then return end
        local ev = safeChild(ChatEvents, "OnMessageDoneFiltering", false)
        if not (ev and ev.OnClientEvent) then return end

        legacyChatConns[#legacyChatConns + 1] = ev.OnClientEvent:Connect(function(data)
            if not (Streamer.enabled and data) then return end
            local plr = data.FromSpeaker and Players:FindFirstChild(data.FromSpeaker) or nil
            if not plr then return end
            local isMe = (plr.UserId == LOCAL.UserId)
            local hideName = (isMe and Streamer.selected["Hide Own Name"])
                or ((not isMe) and Streamer.selected["Hide Others Names"])
            if not hideName then return end
            data.FromSpeaker = "???"
            if data.Message then
                data.Message = (scrubText(data.Message))
            end
            data.ExtraData = data.ExtraData or {}
        end)
    end

    local function bindAll()
        disconnectList(mainConns)
        for uid in pairs(playerConns) do dropPlayerConns(uid) end

        for _, plr in ipairs(Players:GetPlayers()) do bindPlayer(plr) end

        mainConns[#mainConns + 1] = Players.PlayerAdded:Connect(function(plr)
            markMapDirty()
            bindPlayer(plr)
        end)
        mainConns[#mainConns + 1] = Players.PlayerRemoving:Connect(function(plr)
            local uid = plr.UserId
            dropPlayerConns(uid)
            origSkin[uid] = nil
            origDDT[uid] = nil
            markMapDirty()
        end)

        bindPlayerGuiRoot()
        bindGuiRoot(UIRoot)
        hookChat()
        startDrainer()
    end

    local function unbindAll()
        disconnectList(mainConns)
        for uid in pairs(playerConns) do dropPlayerConns(uid) end
        if chatConn then chatConn:Disconnect(); chatConn = nil end
        disconnectList(legacyChatConns)
        for node, conn in pairs(textWatchers) do
            pcall(function() conn:Disconnect() end)
            textWatchers[node] = nil
        end
        stopDrainer()
    end

    local smGroup = Tabs.Misc:AddLeftGroupbox("Streamer Mode", "video")

    smGroup:AddToggle("streamer_mode_toggle", {
        Text = "Streamer Mode",
        Default = false,
        Callback = function(on)
            Streamer.enabled = on
            if on then
                Library:Notify("Open the Roblox menu briefly", 3)
                bindAll()
                applyAll()
            else
                applyAll()
                unbindAll()
            end
        end,
    })

    local StreamerBox = smGroup:AddDependencyBox()

    StreamerBox:AddDropdown("streamer_mode_options", {
        Text = "Affects",
        Values = { "Hide Own Name", "Hide Others Names", "Hide Own Skin", "Hide Others Skins" },
        Multi = true,
        Default = {},
        AllowNull = true,
        Callback = function(selected)
            for k in pairs(Streamer.selected) do Streamer.selected[k] = false end
            if typeof(selected) == "table" then
                local hasBool = false
                for k, v in pairs(selected) do
                    if type(v) == "boolean" then
                        hasBool = true
                        if v and Streamer.selected[k] ~= nil then
                            Streamer.selected[k] = true
                        end
                    end
                end
                if not hasBool then
                    for _, v in ipairs(selected) do
                        if Streamer.selected[v] ~= nil then Streamer.selected[v] = true end
                    end
                end
            end
            markMapDirty()
            if Streamer.enabled then applyAll() end
        end,
    })

    StreamerBox:SetupDependencies({
        { Toggles.streamer_mode_toggle, true },
    })

    local function cleanup()
        Streamer.enabled = false
        for _, p in ipairs(Players:GetPlayers()) do restoreFor(p) end
        unbindAll()
        table.clear(origDDT)
        table.clear(origSkin)
        replaceMap.patterns = {}
        replaceMap.alias    = {}
        replaceMap.plain    = {}
        replaceMap.dirty    = true
    end

    return { cleanup = cleanup }
end

end)
__bundle_register("Features/Misc/AutoChat", function(require, _LOADED, __bundle_register, __bundle_modules)
-- autoChat sub-module of Misc: periodically sends a canned message
local Services = require("Services")
local Jobs     = require("Utility/Jobs")

return function(ctx)
    local Tabs    = ctx.Tabs
    local Library = ctx.Library
    local Options = ctx.Options
    local Toggles = ctx.Toggles
    local track   = ctx.track

    local AutoChatGroup = Tabs.Misc:AddRightGroupbox("Auto Chat", "message-circle")

    local autoChatJob = nil

    local function interval()
        return tonumber(Options.autoChatInterval and Options.autoChatInterval.Value) or 5
    end

    local function stop()
        if autoChatJob then
            autoChatJob:Cancel()
            autoChatJob = nil
        end
    end

    local function sendChatMessage(msg)
        local TextChatService = Services.TextChatService

        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local channel = TextChatService:FindFirstChild("TextChannels") and TextChatService.TextChannels:FindFirstChild("RBXGeneral")
            if channel then
                pcall(function() channel:SendAsync(msg) end)
            end
        else
            local ReplicatedStorage = Services.ReplicatedStorage
            local chatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
            if chatEvents and chatEvents:FindFirstChild("SayMessageRequest") then
                pcall(function() chatEvents.SayMessageRequest:FireServer(msg, "All") end)
            end
        end
    end

    AutoChatGroup:AddToggle("autoChatEnabled", {
        Text = "Auto Chat",
        Default = false,
        Callback = function(enabled)
            -- cancelling the job replaces the old generation-token dance: a stale loop cannot outlive it
            stop()
            if enabled then
                autoChatJob = track(Jobs.interval(interval(), function(job)
                    local msg = Options.autoChatMessage.Value
                    if not (msg and msg:match("%S")) then
                        Library:Notify("Message is empty", 3)
                        Toggles.autoChatEnabled:SetValue(false)
                        job:Cancel()
                        return
                    end
                    sendChatMessage(msg)
                end, { name = "AutoChat", immediate = true, period = interval }))
            end
        end
    })

    local AutoChatBox = AutoChatGroup:AddDependencyBox()

    AutoChatBox:AddInput("autoChatMessage", {
        Default = "Hello Everyone!",
        Numeric = false,
        Finished = false,
        ClearTextOnFocus = true,
        Text = "Message"
    })

    AutoChatBox:AddSlider("autoChatInterval", {
        Text = "Chat Interval (s)",
        Default = 10,
        Min = 1,
        Max = 120,
        Rounding = 1,
        Suffix = "s"
    })

    AutoChatBox:SetupDependencies({
        { Toggles.autoChatEnabled, true },
    })

    local function cleanup()
        stop()
        if Toggles.autoChatEnabled then
            Toggles.autoChatEnabled:SetValue(false)
        end
    end

    return { cleanup = cleanup }
end

end)
__bundle_register("Features/Misc/Environment", function(require, _LOADED, __bundle_register, __bundle_modules)
-- environment sub-module of Misc: custom ambient + time-of-day lock
local Scheduler = require("Utility/Scheduler")

return function(ctx)
    local Services = ctx.Services
    local Tabs     = ctx.Tabs
    local Toggles  = ctx.Toggles
    local track    = ctx.track

    local EnvironmentGroup = Tabs.Misc:AddRightGroupbox("Environment", "trees")

    local ambientOn, ambientColor = false, Color3.fromRGB(128, 128, 128)
    local ambientOrig = Services.Lighting and Services.Lighting.Ambient or Color3.new()
    local origClockTime = Services.Lighting and Services.Lighting.ClockTime or 12
    local timeLocked, timeValue, timeConn = false, origClockTime, nil

    local function applyAmbient()
        if Services.Lighting then
            Services.Lighting.Ambient = ambientOn and ambientColor or ambientOrig
        end
    end

    EnvironmentGroup:AddToggle("ENV_Ambient", {
        Text = "Custom Ambient",
        Default = false,
        Callback = function(v)
            ambientOn = v
            applyAmbient()
        end
    })

    local AmbientBox = EnvironmentGroup:AddDependencyBox()
    AmbientBox:AddLabel("Ambient Color"):AddColorPicker("ENV_AmbientColor", {
        Default = ambientColor,
        Title = "Ambient Color",
        Callback = function(c)
            ambientColor = c
            if ambientOn then applyAmbient() end
        end
    })
    AmbientBox:SetupDependencies({
        { Toggles.ENV_Ambient, true },
    })

    EnvironmentGroup:AddToggle("ENV_TimeLock", {
        Text = "Custom Time of Day",
        Default = false,
        Callback = function(on)
            timeLocked = on
            if on then
                if Services.Lighting then
                    Services.Lighting.ClockTime = timeValue
                end
                if not timeConn then
                    timeConn = track(Scheduler.render(function()
                        if Services.Lighting then
                            Services.Lighting.ClockTime = timeValue
                        end
                    end, { name = "TimeLock" }))
                end
            else
                if timeConn then
                    timeConn:Disconnect()
                    timeConn = nil
                end
            end
        end
    })

    local TimeBox = EnvironmentGroup:AddDependencyBox()
    TimeBox:AddSlider("ENV_Time", {
        Text = "Time of Day",
        Default = timeValue,
        Min = 0,
        Max = 24,
        Rounding = 2,
        Suffix = "h",
        Callback = function(v)
            timeValue = v
            if timeLocked and Services.Lighting then
                Services.Lighting.ClockTime = v
            end
        end
    })
    TimeBox:SetupDependencies({
        { Toggles.ENV_TimeLock, true },
    })

    local function cleanup()
        if timeConn then
            timeConn:Disconnect()
            timeConn = nil
        end
        if Services.Lighting then
            pcall(function()
                Services.Lighting.Ambient = ambientOrig
                if timeLocked then
                    Services.Lighting.ClockTime = origClockTime
                end
            end)
        end
        ambientOn = false
        timeLocked = false
    end

    return { cleanup = cleanup }
end

end)
