    local function setNets(state) return override("Graphics", "Nets", state) end
    local function setGreenEffects(state) return override("Graphics", "GreenEffects", state) end
    local function setBadgeEffects(state) return override("Graphics", "BadgeEffects", state) end
    local function setStreakEffects(state) return override("Graphics", "ParkStreakEffects", state) end

