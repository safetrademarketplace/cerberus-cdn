-- input rules: legal answers whether all of the game's own input modules would send a verb right now, reading live state at call time; advisory only, the verbs never consult it and the server may still refuse
local Errors = require("Api/Input/Errors")

local function free()
    return true
end

local M = {}

function M.new(ctx, base, net)
    -- the player api is a peer's and may not be built yet, so no answer is a normal state here
    local function body()
        local player = ctx.Api and ctx.Api.Player
        if type(player) ~= "table" then return nil, Errors.NO_STATE end
        if not player.model() then return nil, Errors.NO_CHARACTER end
        return player
    end

    local function controller(name)
        local bus = net()
        return bus and bus.controller(name) or nil
    end

    -- the jump key means the seat or the vehicle first: Keyboard:189,195 Gamepad:244 Mobile:431
    local function canJump()
        local player, err = body()
        if not player then return false, err end
        if player.attr("SeatCFrame") then return false, Errors.SEATED end
        local vehicles = controller("Vehicles")
        if vehicles and vehicles.activeVehicle then return false, Errors.IN_VEHICLE end
        return true
    end

    -- no ball on the module that decides by it: Gamepad:234 for emotes, Gamepad:289 for fouls, Mobile only offers fouls on defense
    local function withoutBall()
        local player, err = body()
        if not player then return false, err end
        if player.attr("Basketball") then return false, Errors.HAS_BALL end
        return true
    end

    local RULES = {
        shootRelease = free,
        sprint       = free,
        steal        = free,
        holdG        = free,
        clutch       = free,
        screen       = free,
        jump         = canJump,

        intentionalFoul = withoutBall,
        emote           = withoutBall,

        shootPress = function(opts)
            if type(opts) == "table" and opts.space then return canJump() end
            return true
        end,

        -- Team.Passing:29 and :32, shared by every device; the self lob fires straight past them at Keyboard:174 Gamepad:163 Mobile:459
        pass = function(kind)
            if kind == "selfLob" then return true end
            local player, err = body()
            if not player then return false, err end
            local action = player.action()
            if action == "Passing" then return false, Errors.PASSING end
            if not player.attr("Basketball") and action ~= "CatchingPass" then return false, Errors.NO_BALL end
            return true
        end,

        -- the hand switch has no gate at Keyboard:185 Mobile:457; combos need the ball at Gamepad:178,192,205,234 and a V waits out a shot at Keyboard:159
        dribble = function(kind)
            if kind == "H" then return true end
            local player, err = body()
            if not player then return false, err end
            if not player.attr("Basketball") then return false, Errors.NO_BALL end
            local mayHoldV = type(kind) ~= "string" or string.find(kind, "V", 1, true) ~= nil
            if mayHoldV and player.action() == "Shooting" then return false, Errors.SHOOTING end
            return true
        end,

        -- Gamepad:283 opens quick chat instead in a game or with nothing to drop
        dropBall = function()
            local player, err = body()
            if not player then return false, err end
            if not player.attr("Basketball") then return false, Errors.NO_BALL end
            if player.attr("InGame") then return false, Errors.IN_GAME end
            return true
        end,

        -- the wheel only opens inside the prompt's window: Keyboard:247 Gamepad:197 Celebrations:331
        celebrate = function()
            local gui = controller("Gui")
            local wheel = gui and gui:GetComponent("Celebrations") or nil
            if type(wheel) == "table" and wheel.ActiveInput == true then return true end
            return false, Errors.NO_CELEBRATION
        end,
    }

    -- arg is what the verb itself would take: its opts for shootPress, its kind for pass and dribble
    local function legal(verb, arg)
        local rule = type(verb) == "string" and RULES[verb] or nil
        if not rule then return false, Errors.UNKNOWN_VERB end
        local ok, allowed, reason = pcall(rule, arg)
        if not ok then
            base.warn("legal %s could not read the game: %s", verb, tostring(allowed))
            return false, Errors.NO_STATE
        end
        return allowed, reason
    end

    return { legal = legal }
end

return M

end)
