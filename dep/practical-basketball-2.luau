__bundle_register("Api/Prefs", function(require, _LOADED, __bundle_register, __bundle_modules)
-- prefs api: reads and locally overrides the game's own settings through one override layer, with nothing reaching the player's account unless save, or the meter which only the server reads, says so; everything is put back on unload
local Api      = require("Api")
local Identity = require("Utility/Identity")

local Camera  = require("Api/Prefs/Camera")
local Catalog = require("Api/Prefs/Catalog")
local Effects = require("Api/Prefs/Effects")
local Errors  = require("Api/Prefs/Errors")
local Layer   = require("Api/Prefs/Layer")
local Meter   = require("Api/Prefs/Meter")
local Saved   = require("Api/Prefs/Saved")

local SERVICE = "PlayerService"

-- the game brings scenery back only on an exact true, so a never-written key has to pass through it on the way out
local RETURNS_THROUGH_TRUE = { ["Graphics.Scenery"] = true }

local M = {}

function M.new(ctx)
    local base       = Api.define("Prefs", ctx)
    local Net        = ctx.Api.Net
    local References = ctx.References

    local catalog = Catalog.new(Net)
    local saved   = Saved.new(Net)

    local unloaded = false
    local owedSettings, owedCrowd, flushQueued = false, false, false
    local bindings = {}
    local listener

    -- the game's apply can throw, say mid body swap, and a game call drops the thread's identity for whoever runs next
    local function callGame(controllerName, method)
        local controller = Net.controller(controllerName)
        local fn = controller and controller[method]
        if type(fn) ~= "function" then return false end
        Identity.elevate()
        local ok = base.safe(controllerName .. "." .. method, fn, controller)
        Identity.elevate()
        return ok
    end

    -- the same two calls the menu makes for any setting, and owed again on a failure so the guard retries it
    local function flush()
        flushQueued = false
        if owedSettings then owedSettings = not callGame("Player", "OnSettingUpdate") end
        if owedCrowd then owedCrowd = not callGame("Crowd", "Update") end
    end

    -- batched onto its own thread: flipping nine levers costs one apply, and the caller's thread keeps its identity
    local function queueFlush()
        if flushQueued or not (owedSettings or owedCrowd) then return end
        flushQueued = true
        task.defer(flush)
    end

    local layer = Layer.new(base, queueFlush)

    local function touched(section, name)
        if catalog.needsApply(section, name) then owedSettings = true end
        if name == "Crowd" then owedCrowd = true end
        queueFlush()
    end

    local function keyOf(section, name)
        return "setting:" .. section .. "." .. name
    end

    local function bindingFor(section, name)
        local key = keyOf(section, name)
        if bindings[key] then return bindings[key] end
        local path = catalog.path(section)
        local binding = {
            key        = key,
            live       = true,
            ready      = saved.ready,
            generation = saved.generation,
            read       = function() return saved.read(path, name) end,
            write      = function(value)
                if value == nil and RETURNS_THROUGH_TRUE[section .. "." .. name] then
                    saved.write(path, name, true)
                    owedSettings = true
                    flush()
                end
                saved.write(path, name, value)
            end,
            touched    = function() touched(section, name) end,
        }
        bindings[key] = binding
        return binding
    end

    local function listen()
        if listener then return end
        -- the game swaps ProfileData on this same event, so the sweep has to land behind its handler
        listener = Net.on(SERVICE, "ProfileUpdated", function()
            task.defer(layer.sweep)
        end)
    end

    local function missing()
        return catalog.ready() and Errors.UNKNOWN_SETTING or Errors.NOT_READY
    end

    local function override(section, name, value)
        if unloaded then return nil, Errors.UNLOADED end
        local row = catalog.row(section, name)
        if not row then return nil, missing() end
        if not row.localEffect then return nil, Errors.NO_LOCAL_EFFECT end
        if not saved.ready() then return nil, Errors.NOT_READY end
        local label, decoded = catalog.encode(row, value)
        if label == nil then return nil, Errors.BAD_VALUE end
