local SNAP = 0.005

-- the whole client has no reader for these: the server consumes them or nothing does, so a local write changes nothing
local NO_LOCAL_EFFECT = {
    ["Meter.Type"]                       = true,
    ["Meter.ShowOtherMeters"]            = true,
    ["General.Joinability"]              = true,
    ["General.HideLogo"]                 = true,
    ["General.HideParkRecord"]           = true,
    ["Gameplay.PerfectJumpshotLandings"] = true,
    ["Graphics.TakeoverEffects"]         = true,
    ["Graphics.ParkBlimp"]               = true,
    ["Graphics.ParkDoors"]               = true,
}

-- read at the moment of use, so the game's apply pass has nothing to do for them and would only reset Lighting.ClockTime
local READ_AT_USE = {
    ["Graphics.GreenEffects"]  = true,
    ["Graphics.BadgeEffects"]  = true,
    ["Graphics.PerfectCamera"] = true,
    ["Graphics.EventEffects"]  = true,
}
local READ_AT_USE_SECTION = {
    ["Gameplay.Keyboard"]   = true,
    ["Gameplay.Controller"] = true,
}

local NOT_SETTINGS = { Tab = true, Edit = true, Button = true, Bind = true }

local function decode(label)
    if label == "Enabled" then return true end
    if label == "Disabled" then return false end
    return label
end

local function labelOf(value)
    if value == true then return "Enabled" end
    if value == false then return "Disabled" end
    return value
end

-- callers think in booleans and the menu in labels; a row with no Enabled option treats its first option that is not off as on
local function labelFor(row, value)
    if type(value) ~= "boolean" then return value end
    local hasOff, on = false, nil
    for _, option in ipairs(row.options) do
        if option == "Disabled" then
            hasOff = true
        elseif on == nil or option == "Enabled" then
            on = option
        end
    end
    if not hasOff then return nil end
    return value and on or "Disabled"
end

-- returns the wire label and the value the local table holds; nil when the row cannot take it
local function encode(row, value)
    if row.options then
        local label = labelFor(row, value)
        if label == nil or not table.find(row.options, label) then return nil end
        return label, decode(label)
    end
    if row.min ~= nil or row.max ~= nil then
        local number = tonumber(value)
        if number == nil or number ~= number then return nil end
        number = math.clamp(number, row.min or number, row.max or number)
        -- the menu snaps then rounds, and its `step` is a count of decimal places rather than an increment
        local scale = 10 ^ (row.places or 0)
        local snapped = math.round(math.round(number / SNAP) * SNAP * scale) / scale
        return snapped, snapped
    end
    if value == nil then return nil end
    return value, decode(value)
end

local function readRow(raw, section)
    return {
        name        = raw.settingName,
        label       = raw.visualName or raw.settingName,
        kind        = raw.settingType,
        options     = type(raw.options) == "table" and table.clone(raw.options) or nil,
        min         = raw.min,
        max         = raw.max,
        places      = raw.step,
        description = raw.description,
        vip         = raw.vip == true,
        localEffect = not NO_LOCAL_EFFECT[section .. "." .. raw.settingName],
    }
end

local function isPage(raw, all)
    return raw.settingType == "Edit" and not raw.binds and type(all[raw.settingName]) == "table"
end

-- the config is flat and only its Edit rows say where a sub-page lives, so roots are the pages no row links to
local function build(all)
    local linked = {}
    for _, rows in pairs(all) do
        if type(rows) == "table" then
            for _, raw in ipairs(rows) do
