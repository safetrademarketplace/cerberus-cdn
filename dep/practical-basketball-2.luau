        local Stats = Services.Stats
        local function isStatItem(item)
            return typeof(item) == "Instance" and (item.GetValue ~= nil or item.GetValueString ~= nil)
        end

        local function findStatItem(parent, names, keywords)
            if not parent then return nil end
            for _, name in ipairs(names) do
                local item = parent:FindFirstChild(name)
                if item then return item end
            end
            if keywords then
                for _, item in ipairs(parent:GetDescendants()) do
                    if isStatItem(item) then
                        local n = tostring(item.Name):lower()
                        local ok = true
                        for _, k in ipairs(keywords) do
                            if not n:find(k, 1, true) then ok = false; break end
                        end
                        if ok then return item end
                    end
                end
            end
            return nil
        end

        local function collectStatItems(parent, keywords)
            local out = {}
            if not parent then return out end
            for _, item in ipairs(parent:GetDescendants()) do
                if isStatItem(item) then
                    local n = tostring(item.Name):lower()
                    local ok = true
                    for _, k in ipairs(keywords) do
                        if not n:find(k, 1, true) then ok = false; break end
                    end
                    if ok then out[#out + 1] = item end
                end
            end
            return out
        end

        local statsRoot = Stats and Stats.Network and (Stats.Network.ServerStatsItem or Stats.Network) or nil
        local pingItem = findStatItem(statsRoot, { "Data Ping", "Ping" }, { "ping" })
        local recvItem = findStatItem(statsRoot, { "Data Receive Kbps", "Data Receive (Kbps)", "Data Receive" },
            { "receive" })
        local sendItem = findStatItem(statsRoot, { "Data Send Kbps", "Data Send (Kbps)", "Data Send" },
            { "send" })

        local function refreshStatItems()
            if not statsRoot then
                statsRoot = Stats and Stats.Network and (Stats.Network.ServerStatsItem or Stats.Network) or nil
            end
            if statsRoot then
                pingItem = pingItem or findStatItem(statsRoot, { "Data Ping", "Ping" }, { "ping" })
                if not recvItem then
                    recvItem = findStatItem(statsRoot,
                        { "Data Receive Kbps", "Data Receive (Kbps)", "Data Receive" }, { "receive" })
                end
                if not recvItem then
                    recvItem = findStatItem(statsRoot, {}, { "incoming" })
                end
                if not recvItem then
                    recvItem = findStatItem(statsRoot, {}, { "recv" })
                end
                if not sendItem then
                    sendItem = findStatItem(statsRoot,
                        { "Data Send Kbps", "Data Send (Kbps)", "Data Send" }, { "send" })
                end
                if not sendItem then
                    sendItem = findStatItem(statsRoot, {}, { "outgoing" })
                end
                if not sendItem then
                    sendItem = findStatItem(statsRoot, {}, { "sent" })
                end
                diag.recvCandidates = collectStatItems(statsRoot, { "receive" })
                diag.sendCandidates = collectStatItems(statsRoot, { "send" })
                if #diag.recvCandidates == 0 then
                    diag.recvCandidates = collectStatItems(statsRoot, { "incoming" })
                end
                if #diag.sendCandidates == 0 then
                    diag.sendCandidates = collectStatItems(statsRoot, { "outgoing" })
                end
            end
        end
        refreshStatItems()

        local function readStat(item)
            if not item then return nil end
            local value = nil
            if item.GetValue then
                local ok, v = pcall(function() return item:GetValue() end)
                if ok and type(v) == "number" then value = v end
            end
            if item.GetValueString then
                local ok, s = pcall(function() return item:GetValueString() end)
                if ok and type(s) == "string" then
                    local parsed = tonumber(s:match("([%d%.]+)"))
                    if parsed and (value == nil or value <= 0) then value = parsed end
                end
            end
            return value
        end

        local function setValue(key, text)
            local label = diag.values[key]
            if label then label.Text = text end
        end

        local function formatVec(vec)
            if not vec then return "--" end
            return string.format("%.1f, %.1f, %.1f", vec.X, vec.Y, vec.Z)
        end

        -- 1s cached toggle count; can't hook :OnChanged (obsidian is single-subscriber) and a 4Hz full rescan is wasted work
        local TOGGLE_COUNT_TTL  = 1.0
        local cachedToggleCount = 0
        local toggleCountClock  = -math.huge
        local function countEnabledToggles()
            local now = os.clock()
            if now - toggleCountClock < TOGGLE_COUNT_TTL then
                return cachedToggleCount
            end
            toggleCountClock = now
            local count = 0
            for _, t in pairs(Toggles) do
                if type(t) == "table" and t.Value == true then count = count + 1 end
            end
            cachedToggleCount = count
            return count
        end

        local startedAt = os.clock()
        local lastViewport = Vector2.new(0, 0)
        local function fitPanelToViewport()
            local cam = References.camera or Services.Workspace.CurrentCamera
            if not cam then return end
            local view = cam.ViewportSize
            if view.X <= 0 or view.Y <= 0 then return end
            if view == lastViewport then return end
            lastViewport = view
            local maxWidth = math.max(300, view.X - 40)
            local maxHeight = math.max(240, view.Y - 80)
            local width = math.min(520, maxWidth)
            local height = math.min(420, maxHeight)
            frame.Size = UDim2.fromOffset(width, height)
        end

        diag.conn = track(Scheduler.render(function(dt)
            if not diag.gui then return end
            fitPanelToViewport()
            local instFPS = (dt > 0) and (1 / dt) or 60
            diag.fpsSmooth = diag.fpsSmooth + (instFPS - diag.fpsSmooth) * 0.2
            diag.frameMs = dt * 1000
            diag.accum = diag.accum + dt
            if diag.accum < diag.updateInterval then return end
            diag.accum = 0

            local costStart = os.clock()
            if os.clock() >= diag.nextStatRefresh then
                refreshStatItems()
                diag.nextStatRefresh = os.clock() + 2
            end
            local ping = readStat(pingItem)
            if not ping and References.player and References.player.GetNetworkPing then
                local ok, rtt = pcall(function() return References.player:GetNetworkPing() end)
                if ok and type(rtt) == "number" then ping = rtt * 1000 end
            end
            local recv = readStat(recvItem)
            if (not recv or recv <= 0) and diag.recvCandidates and #diag.recvCandidates > 0 then
                for _, item in ipairs(diag.recvCandidates) do
                    local v = readStat(item)
                    if v and v > 0 then recv = v; break end
                end
            end
            local send = readStat(sendItem)
            if (not send or send <= 0) and diag.sendCandidates and #diag.sendCandidates > 0 then
                for _, item in ipairs(diag.sendCandidates) do
                    local v = readStat(item)
                    if v and v > 0 then send = v; break end
                end
            end
            local luaMemKb = collectgarbage and collectgarbage("count") or nil
            local totalMemMb
            if Stats and Stats.GetTotalMemoryUsageMb then
                local ok, mem = pcall(Stats.GetTotalMemoryUsageMb, Stats)
                if ok then totalMemMb = mem end
            end

            local hum = References.humanoid
            local root = References.humanoidRootPart
            local healthText = "--"
            if hum then
                healthText = string.format("%d / %d", math.floor(hum.Health + 0.5), math.floor(hum.MaxHealth + 0.5))
            end

            setValue("fps", string.format("%d", math.floor(diag.fpsSmooth + 0.5)))
            setValue("framems", string.format("%.1f ms", diag.frameMs))
            setValue("ping", ping and (math.floor(ping + 0.5) .. " ms") or "--")
            setValue("luamem", luaMemKb and string.format("%.1f MB", luaMemKb / 1024) or "--")
            setValue("totalmem", totalMemMb and string.format("%.1f MB", totalMemMb) or "--")

            setValue("netin", recv and string.format("%.1f kbps", recv) or "n/a")
            setValue("netout", send and string.format("%.1f kbps", send) or "n/a")

            setValue("health", healthText)
            setValue("walkspeed", hum and string.format("%.1f", hum.WalkSpeed) or "--")
            setValue("jumppower", hum and string.format("%.1f", hum.JumpPower) or "--")
            setValue("velocity", root and string.format("%.1f", root.AssemblyLinearVelocity.Magnitude) or "--")
            setValue("position", root and formatVec(root.Position) or "--")

            setValue("fov", References.camera and string.format("%.1f", References.camera.FieldOfView) or "--")
            setValue("gravity", tostring(Services.Workspace.Gravity))
            setValue("place", tostring(Services.Game.PlaceId))
            setValue("job", tostring(Services.Game.JobId or "--"))
            setValue("players", tostring(#Services.Players:GetPlayers()))

            setValue("toggles", tostring(countEnabledToggles()))
            setValue("uptime", string.format("%.0f s", os.clock() - startedAt))

            local sched = Scheduler.stats()
            local laneMs = 0
            local laneTasks = 0
            for _, lane in pairs(sched.lanes) do
                laneMs = laneMs + lane.spentMs
                laneTasks = laneTasks + lane.tasks
            end
            setValue("loops", string.format("%d (%.2f ms%s)", laneTasks, laneMs,
                sched.budgetMs and string.format(", cap %.0f ms", sched.budgetMs) or ""))

            diag.lastCostMs = (os.clock() - costStart) * 1000
            setValue("cerbcost", string.format("%.2f ms", diag.lastCostMs))
        end, { name = "PerfDiagnostics", priority = 200 }))
    end

    HudGroup:AddToggle("HUD_Enable", {
        Text = "Show FPS + Ping",
        Tooltip = "Shows 60 fps at most",
        Default = false,
        Callback = function(on)
            if on then createHud() else destroyHud() end
        end
    })

    local HudBox = HudGroup:AddDependencyBox()

    HudBox:AddSlider("HUD_Scale", {
        Text = "HUD Scale",
        Default = 90,
        Min = 70,
        Max = 150,
        Rounding = 0,
        Suffix = "%",
        Callback = function(v)
            hud.scale = v / 100
            if hud.gui and hud.gui:FindFirstChild("Holder") then
                local holder = hud.gui.Holder
                holder.Size = UDim2.fromOffset(320 * hud.scale, 100 * hud.scale)
                for _, frame in ipairs(holder:GetDescendants()) do
                    if frame:IsA("TextLabel") then
                        if frame.Name == "Title" then
                            frame.TextSize = 16 * hud.scale
                        elseif frame.Name == "Value" then
                            frame.TextSize = 28 * hud.scale
                        end
                    end
                end
            end
        end
    })

    HudBox:SetupDependencies({
        { Toggles.HUD_Enable, true },
    })

    local diagDefault = false
    HudGroup:AddToggle("HUD_Diagnostics", {
        Text = "Diagnostics Panel",
        Default = diagDefault,
        Callback = function(on)
            if on then createDiagnostics() else destroyDiagnostics() end
        end
    })
    if diagDefault and not diag.gui then
        createDiagnostics()
    end

    local function cleanup()
        destroyHud()
        destroyDiagnostics()
    end

    return { cleanup = cleanup }
end

end)
