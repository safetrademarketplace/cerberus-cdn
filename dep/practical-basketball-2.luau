            local cam = References.camera or Services.Workspace.CurrentCamera
            if not cam then
                Library:Notify("Camera not ready", 3); if tg.SetValue then tg:SetValue(false) end; return
            end
            if on then
                if not Zoom.origFov then Zoom.origFov = cam.FieldOfView end
                Zoom.on = true; applyZoom()
                if not Zoom.conn then
                    Zoom.conn = track(Scheduler.render(function()
                        if Zoom.on then applyZoom() end
                    end, { name = "Zoom", priority = 50 }))
                end
            else
                stopZoom()
            end
        end
