-- player attributes: reads, watchers and local overrides for our own body over a single AttributeChanged connection, rebound only from the tracker; overrides write the instance, so the game's mirror table and its direct instance readers both see them
local Errors = require("Api/Player/Errors")
local Tokens = require("Api/Player/Tokens")

local FOLDER = "Attributes"

local UNWRITABLE = { Instance = true, table = true, ["function"] = true, thread = true, ["nil"] = true }

local M = {}

function M.new(base, tracker)
    local bound, folder
    local attrConn, childConn, folderAddedConn, folderRemovedConn
    local watchers, valueConns, overrides = {}, {}, {}

    -- Goal, Basketball and TargetBasketball are ObjectValues in the Attributes folder, not attributes
    local function read(name)
        if not bound or type(name) ~= "string" then return nil end
        local value = bound:GetAttribute(name)
        if value ~= nil then return value end
        local holder = folder and folder:FindFirstChild(name)
        if holder then return holder.Value end
        return nil
    end

    local function dispatch(name)
        local watch = watchers[name]
        if not watch then return end
        local value = read(name)
        if value == watch.last then return end
        local old = watch.last
        watch.last = value
        local snapshot = table.move(watch.subs, 1, #watch.subs, 1, {})
        for _, sub in ipairs(snapshot) do
            if sub.fn then base.safe("attribute watcher", sub.fn, value, old) end
        end
    end

    local function unbindValue(name)
        local conn = valueConns[name]
        if conn then
            conn:Disconnect()
            valueConns[name] = nil
        end
    end

    local function bindValue(name)
        unbindValue(name)
        local holder = folder and folder:FindFirstChild(name)
        if not (holder and holder:IsA("ValueBase")) then return end
        valueConns[name] = holder:GetPropertyChangedSignal("Value"):Connect(function() dispatch(name) end)
    end

    local function write(model, name, value)
        local ok, err = pcall(model.SetAttribute, model, name, value)
        if not ok then base.warn("could not write %s: %s", tostring(name), tostring(err)) end
        return ok
    end

    -- remembers what actually landed, so a value that does not round-trip exactly can never re-assert itself forever; writing covers a client on immediate signals, where our own event lands inside the call
    local function apply(entry, name, value)
        if not bound then return true end
        entry.writing = true
        local ok = write(bound, name, value)
        entry.writing = false
        entry.written = bound:GetAttribute(name)
        return ok
    end

    local function onChanged(name)
        local entry = overrides[name]
        if entry and bound and not entry.writing then
            local value = bound:GetAttribute(name)
            if value ~= entry.written then
                entry.truth = value
                apply(entry, name, entry.stack.top())
            end
        end
        dispatch(name)
    end

    local function setFolder(found)
        if folderAddedConn then folderAddedConn:Disconnect() end
        if folderRemovedConn then folderRemovedConn:Disconnect() end
        folderAddedConn, folderRemovedConn, folder = nil, nil, found
        if not found then return end
        folderAddedConn = found.ChildAdded:Connect(function(child)
            local name = child.Name
            if watchers[name] then
                bindValue(name)
                dispatch(name)
            end
        end)
        folderRemovedConn = found.ChildRemoved:Connect(function(child)
            local name = child.Name
            if watchers[name] then
                unbindValue(name)
                dispatch(name)
            end
        end)
    end

    -- a recycled body goes back to the pool, so it must not keep values only this client believes
    local function release()
        if attrConn then attrConn:Disconnect() end
        if childConn then childConn:Disconnect() end
        attrConn, childConn = nil, nil
        if bound then
            for name, entry in pairs(overrides) do write(bound, name, entry.truth) end
        end
        setFolder(nil)
        for name in pairs(valueConns) do unbindValue(name) end
        bound = nil
    end

    local function rebindWatched()
        local names = {}
        for name in pairs(watchers) do names[#names + 1] = name end
        for _, name in ipairs(names) do
            bindValue(name)
            dispatch(name)
        end
    end

    local function bind(model)
        release()
        if model then
            bound = model
            attrConn = model.AttributeChanged:Connect(onChanged)
            local found = model:FindFirstChild(FOLDER)
            if found then
                setFolder(found)
            else
                childConn = model.ChildAdded:Connect(function(child)
                    if child.Name ~= FOLDER then return end
                    childConn:Disconnect()
                    childConn = nil
                    setFolder(child)
                    rebindWatched()
                end)
            end
            for name, entry in pairs(overrides) do
                entry.truth = model:GetAttribute(name)
                apply(entry, name, entry.stack.top())
            end
        end
        rebindWatched()
    end

    local function attr(name)
        tracker.model()
        return read(name)
    end

    -- what the server last wrote, whatever an override is showing the game right now
    local function trueAttr(name)
        tracker.model()
        if not bound then return nil end
        local entry = overrides[name]
        if entry then return entry.truth end
        return read(name)
    end

    local function onAttr(name, fn)
        if type(name) ~= "string" or type(fn) ~= "function" then return nil, Errors.BAD_ARGS end
        tracker.model()
        local watch = watchers[name]
        if not watch then
            watch = { subs = {}, last = read(name) }
            watchers[name] = watch
            bindValue(name)
        end
        local sub = { fn = fn }
        watch.subs[#watch.subs + 1] = sub
        local handle = {}
        function handle.Disconnect()
            if not sub.fn then return end
            sub.fn = nil
            for i = #watch.subs, 1, -1 do
                if watch.subs[i] == sub then table.remove(watch.subs, i) end
            end
            if #watch.subs == 0 and watchers[name] == watch then
                watchers[name] = nil
                unbindValue(name)
            end
        end
        handle.Destroy = handle.Disconnect
        return handle
    end

    local function entryFor(name)
        local entry = overrides[name]
        if entry then return entry end
        entry = {}
        if bound then
            entry.truth = bound:GetAttribute(name)
            entry.written = entry.truth
        end
        entry.stack = Tokens.stack(function(value)
            if entry.stack.count() > 0 then
                entry.rejected = not apply(entry, name, value)
            else
                overrides[name] = nil
                if bound then write(bound, name, entry.truth) end
            end
            dispatch(name)
        end)
        overrides[name] = entry
        return entry
    end

    -- also fine with no body yet: the token waits and lands on the next one
    local function overrideAttr(name, value)
        if type(name) ~= "string" or name == "" then return nil, Errors.BAD_ARGS end
        if UNWRITABLE[typeof(value)] or value ~= value then return nil, Errors.BAD_ARGS end
        tracker.model()
        local entry = entryFor(name)
        local restore = entry.stack.push(value)
        if entry.rejected then
            restore()
            return nil, Errors.REJECTED
        end
        return restore
    end

    tracker.onModel(bind)
    bind(tracker.model())

    return {
        attr         = attr,
        trueAttr     = trueAttr,
        onAttr       = onAttr,
        overrideAttr = overrideAttr,
        clear        = function()
            for _, entry in pairs(overrides) do entry.stack.clear() end
            release()
            table.clear(watchers)
        end,
    }
end

return M

end)
__bundle_register("Api/Player/Arbiter", function(require, _LOADED, __bundle_register, __bundle_modules)
-- player arbiter: at most one motion owns the proxy; the owner's step runs on one scheduler task that exists only while it is held, and finishing a claim that is no longer the owner does nothing, so standing down can never stop someone else
local Scheduler = require("Utility/Scheduler")

local Errors = require("Api/Player/Errors")

local M = {}

function M.new(base)
    local owner, driver

    local function stopDriver()
        if driver then driver:Disconnect() end
        driver = nil
    end

    -- a step that throws must end its claim: the scheduler would only drop the task and leave the character pinned for good
    local function run(dt)
        local claim = owner
        if not claim then
            stopDriver()
            return
        end
        local ok, err = pcall(claim.step, dt)
        if not ok then
            base.warn("%s step failed: %s", claim.kind, tostring(err))
            claim.finish("failed")
        end
    end

    local function claim(kind, step, opts)
        if owner then return nil, Errors.BUSY end
        opts = opts or {}
        local held = { kind = kind, step = step, keepOnRespawn = opts.keepOnRespawn == true }
        function held.finish(reason)
            if owner ~= held then return false end
            owner = nil
            stopDriver()
            if opts.onRelease then base.safe(kind .. " release", opts.onRelease, reason) end
            return true
        end
        owner = held
        driver = Scheduler.heartbeat(run, { name = "Player/motion" })
        return held
    end

    return {
        claim   = claim,
        owner   = function() return owner end,
        isOwner = function(held) return owner == held end,
        clear   = function()
            if owner then owner.finish("unloaded") end
            stopDriver()
        end,
    }
end

return M

end)
__bundle_register("Api/Net", function(require, _LOADED, __bundle_register, __bundle_modules)
-- net api: the game's remote bus and module access; sends return (ok, err), listeners are reaped by the api's maid, and anything that spends money or changes the account needs the explicit Allowed call
local Api         = require("Api")
local Errors      = require("Api/Net/Errors")
local GameModules = require("Api/Net/GameModules")
local Protected   = require("Api/Net/Protected")

local AERO        = "Aero"
local REMOTE_ROOT = "AeroRemoteServices"

local M = {}

function M.new(ctx)
    local base      = Api.define("Net", ctx)
    local Services  = ctx.Services
    local Workspace = Services.Workspace
    local maid      = base.maid
    local modules   = GameModules.new(base, ctx)

    -- the service set changes per place, so a missing folder is a normal state and never a WaitForChild
    local function root()
        local aero = Services.ReplicatedStorage:FindFirstChild(AERO)
        return aero and aero:FindFirstChild(REMOTE_ROOT) or nil
    end

    local function locate(service, remote)
        if type(service) ~= "string" or type(remote) ~= "string" then return nil, Errors.BAD_ARGS end
        local folder = root()
        if not folder then return nil, Errors.NO_ROOT end
        local svc = folder:FindFirstChild(service)
        if not svc then return nil, Errors.NO_SERVICE end
        local inst = svc:FindFirstChild(remote)
        if not inst then return nil, Errors.NO_REMOTE end
        return inst
    end

    local function fire(service, remote, ...)
        local inst, err = locate(service, remote)
        if not inst then return false, err end
        if not inst:IsA("BaseRemoteEvent") then return false, Errors.WRONG_KIND end
        local ok, failure = pcall(inst.FireServer, inst, ...)
        if not ok then
            base.warn("send %s.%s failed: %s", service, remote, tostring(failure))
            return false, Errors.SEND_FAILED
        end
        return true
    end

    -- yields on the server, so callers run this inside a job; the result is (true, ...server returns) or (false, err)
    local function call(service, remote, ...)
        local inst, err = locate(service, remote)
        if not inst then return false, err end
        if not inst:IsA("RemoteFunction") then return false, Errors.WRONG_KIND end
        local result = table.pack(pcall(inst.InvokeServer, inst, ...))
        if not result[1] then
            base.warn("invoke %s.%s failed: %s", service, remote, tostring(result[2]))
            return false, Errors.SEND_FAILED
        end
        return table.unpack(result, 1, result.n)
    end

    local function send(service, remote, ...)
        if Protected.isProtected(service, remote) then return false, Errors.PROTECTED end
        return fire(service, remote, ...)
    end

    local function invoke(service, remote, ...)
        if Protected.isProtected(service, remote) then return false, Errors.PROTECTED end
        return call(service, remote, ...)
    end

    -- the handle's Destroy matters: Utility/Maid warns and skips any table task without one
    local function track(conn)
        local id = maid and maid:GiveTask(conn) or nil
        local handle = {}
        function handle:Disconnect()
            if id then maid[id] = nil else conn:Disconnect() end
        end
        handle.Destroy = handle.Disconnect
        return handle
    end

    local function on(service, remote, fn)
        if type(fn) ~= "function" then return nil, Errors.BAD_ARGS end
        local inst, err = locate(service, remote)
        if not inst then return nil, err end
        if not inst:IsA("BaseRemoteEvent") then return nil, Errors.WRONG_KIND end
        return track(inst.OnClientEvent:Connect(fn))
    end

    local function has(service, remote)
        return (locate(service, remote)) ~= nil
    end

    local function place()
        return { placeId = Services.Game.PlaceId, gamemode = Workspace:GetAttribute("Gamemode") }
    end

    -- rebuilt per character, so it is read fresh on every call and never cached
    local function playerState()
        local player = modules.controller("Player")
        local state = player and player.Character
        return type(state) == "table" and state or nil
    end

    base.log("net api ready (%s)", root() and "remote bus found" or "no remote bus here")

    return {
        Errors = Errors,

        isReady = function() return root() ~= nil end,
        has     = has,
        place   = place,

        send   = send,
        invoke = invoke,
        on     = on,

        sendAllowed   = fire,
        invokeAllowed = call,

        controller  = modules.controller,
        module      = modules.module,
        shared      = modules.shared,
        playerState = playerState,
    }
end

return M

end)
