        local section = SECTION .. "." .. tostring(name)
        if not catalog.row(section, FOV_ROW) then return false, Errors.UNKNOWN_SETTING end
        local value = readSaved(section, FOV_ROW)
        if value == nil then value = FOV_FALLBACK[name] end
        if type(value) ~= "number" then return false, Errors.NOT_READY end
