__bundle_register("Features/Player/Movement/PositionRewind", function(require, _LOADED, __bundle_register, __bundle_modules)
-- position rewind: ring buffer of your position read from the player api, and the hotkey puts you back through a player api teleport; a new body wipes the ring
local Scheduler = require("Utility/Scheduler")
local UiWrite   = require("Utility/UiWrite")
local Guard     = require("Features/Player/Movement/Guard")

-- twice what the sliders can ask for at their worst, 30s at 100ms; the ring never grows once warm
local MAX_BUFFER = 600

local DEFAULT_REWIND_SECONDS = 5
local DEFAULT_SAMPLE_MS      = 250
local POST_REWIND_PAUSE      = 0.5

return function(ctx)
    local Services = ctx.Services
    local Tabs     = ctx.Tabs
    local Library  = ctx.Library
    local Options  = ctx.Options
    local Toggles  = ctx.Toggles
    local Player   = ctx.Player
    local track    = ctx.track

    local RewindGroup = Tabs.Player:AddLeftGroupbox("Position Rewind", "rewind")

    RewindGroup:AddToggle("RewindEnabled", {
        Text    = "Position Rewind",
        Default = false,
        Tooltip = "Jumps back a few seconds",
    })

    local RewindBox = RewindGroup:AddDependencyBox()

    RewindBox:AddSlider("RewindWindow", {
        Text     = "Rewind Window",
        Default  = DEFAULT_REWIND_SECONDS,
        Min      = 1,
        Max      = 30,
        Rounding = 0,
        Suffix   = "s",
        Tooltip  = "How far back it goes",
    })

    RewindBox:AddSlider("RewindSampleMs", {
        Text     = "Sample Interval",
        Default  = DEFAULT_SAMPLE_MS,
        Min      = 100,
        Max      = 1000,
        Rounding = 0,
        Suffix   = "ms",
        Tooltip  = "How often your spot is saved",
    })

    -- KeyPicker has no fire-on-press callback, so stash the key via ChangedCallback and match in InputBegan; starts unbound because every sensible default is already a game key (r is steal)
    local rewindKey = nil
    RewindBox:AddLabel("Rewind Key"):AddKeyPicker("RewindKey", {
        Default          = nil,
        SyncToggleState  = false,
        Mode             = "Toggle",
        Text             = "Rewind Now",
        NoUI             = false,
        ChangedCallback  = function(key) rewindKey = key end,
    })

    RewindBox:SetupDependencies({
        { Toggles.RewindEnabled, true },
    })

    local buffer = {}
    local head   = 1
    local count  = 0

    local sampler
    local pauseSamplingUntil = -math.huge

    local function sampleInterval()
        return Options.RewindSampleMs.Value / 1000
    end

    local function clearBuffer()
        table.clear(buffer)
        head, count = 1, 0
    end

    local function sample()
        if os.clock() < pauseSamplingUntil then return end
        local cf = Player.cframe()
        if not cf then return end
        -- reuse the entry table to avoid gc pressure on the steady-state ring
        local entry = buffer[head] or {}
        entry.cf = cf
        entry.t  = os.clock()
        buffer[head] = entry
        head = (head % MAX_BUFFER) + 1
        if count < MAX_BUFFER then count = count + 1 end
    end

    -- newest entry at or before the time, or nil if the ring doesn't reach that far back
    local function entryAtOrBefore(target)
        for i = 1, count do
            local entry = buffer[((head - 1 - i) % MAX_BUFFER) + 1]
            if entry.t <= target then return entry end
        end
        return nil
    end

    -- once wrapped, head is the next slot to overwrite, so it still holds the oldest
    local function oldestEntry()
        if count < MAX_BUFFER then return buffer[1] end
        return buffer[head]
    end

    local function rewind()
        if count == 0 then
            UiWrite.notify(Library, "Nothing to rewind yet", 2)
            return
        end
        local entry = entryAtOrBefore(os.clock() - Options.RewindWindow.Value) or oldestEntry()
        local restore, err = Player.teleport(entry.cf)
        if not restore then
            Guard.say(Library, Player, err)
            return
        end
        -- or the next sample overwrites good entries and a second rewind lands on the same spot
        pauseSamplingUntil = os.clock() + POST_REWIND_PAUSE
    end

    local function startRewind()
        if sampler then return end
        sampler = Scheduler.heartbeat(sample, { name = "PositionRewind", interval = sampleInterval() })
    end

    local function stopRewind()
        if sampler then
            sampler:Disconnect()
            sampler = nil
        end
        clearBuffer()
    end

    -- rewinding onto a spot from the last body is a footgun
    track(Player.CharacterChanged:Connect(clearBuffer))

    Toggles.RewindEnabled:OnChanged(function()
        if Toggles.RewindEnabled.Value then startRewind() else stopRewind() end
    end)

    Options.RewindSampleMs:OnChanged(function()
        if sampler then sampler:SetInterval(sampleInterval()) end
    end)

    track(Services.UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed or not rewindKey or not Toggles.RewindEnabled.Value then return end
        if input.KeyCode == rewindKey or input.UserInputType == rewindKey then rewind() end
    end))

    return { startRewind = startRewind, stopRewind = stopRewind, rewind = rewind }
end

end)
