__bundle_register("Utility/EventBuffer", function(require, _LOADED, __bundle_register, __bundle_modules)
-- bounded timestamped event buffer feeding the crash report's recent-events and module-timeline sections
local M = {}

local function nowStamp()
    local ok, value = pcall(os.date, "!%Y-%m-%d %H:%M:%S UTC")
    return ok and value or "unknown-time"
end

function M.new(maxEvents)
    local self = { events = {}, max = maxEvents or 160 }

    function self:push(stage, message)
        local line = string.format("%s | [%s] %s", nowStamp(), tostring(stage or "INFO"), tostring(message or ""))
        self.events[#self.events + 1] = line
        if #self.events > self.max then
            table.remove(self.events, 1)
        end
    end

    function self:snapshot() return self.events end

    return self
end

M.nowStamp = nowStamp
return M

end)
