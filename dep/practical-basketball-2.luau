    base.maid:GiveTask(function()
        travel.clear()
        levers.clear()
        attrs.clear()
        tracker.clear()
    end)

    base.log("player api ready (%s)", tracker.model() and "character found" or "no character yet")

    return {
        Errors = Errors,
        LIMITS = Limits,

        CharacterChanged = tracker.CharacterChanged,
        model            = tracker.model,
        root             = tracker.root,
        humanoid         = tracker.humanoid,
        proxy            = tracker.proxy,
        position         = tracker.position,
        cframe           = tracker.cframe,

        attr     = attrs.attr,
        trueAttr = attrs.trueAttr,
        onAttr   = attrs.onAttr,

        action      = profile.action,
        isOnCourt   = profile.isOnCourt,
        isSprinting = profile.isSprinting,
        inAir       = profile.inAir,
        team        = profile.team,
        stat        = profile.stat,
        build       = profile.build,
        stamina     = profile.stamina,
        trueStamina = profile.trueStamina,

        TakeoverChanged = profile.TakeoverChanged,
        takeover        = profile.takeover,
        takeoverBoosts  = profile.takeoverBoosts,

        setSpeed     = levers.setSpeed,
        forceSprint  = levers.forceSprint,
        overrideAttr = attrs.overrideAttr,
        setNoclip    = levers.setNoclip,

        startFlight = travel.startFlight,
        moveTo      = travel.moveTo,
        teleport    = travel.teleport,
        hop         = travel.hop,
        motionOwner = travel.motionOwner,
    }
end

return M

end)
__bundle_register("Api/Player/Travel", function(require, _LOADED, __bundle_register, __bundle_modules)
