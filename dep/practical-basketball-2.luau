            enabledConn = root:GetPropertyChangedSignal("Enabled"):Connect(function()
                if root.Enabled then schedule() end
            end)
        end)
    end
    local win = root:FindFirstChild(WINDOW)
    if win then watchWindow(win) end
end

function observe()
    if coreConn then return end
    coreConn = CoreGui.ChildAdded:Connect(function(child)
        if child.Name == "DevConsoleMaster" then
            watch(child)
            schedule()
        end
    end)
