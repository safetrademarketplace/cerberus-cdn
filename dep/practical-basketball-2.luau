        if text == "" then return false, Errors.NO_CODE end
        local bus = net()
        if not bus then return false, Errors.NO_NET end
        local sent, done, message = bus.invokeAllowed("CodeService", "Redeem", text)
        if not sent then return false, done end
        return done == true, type(message) == "string" and message or nil
    end

    local function wallet()
        local bus = net()
        local player = bus and bus.controller("Player")
        local profile = player and player.ProfileData
        if type(profile) ~= "table" then return nil end
        return { coins = tonumber(profile.Coins) or 0, tickets = tonumber(profile.Tickets) or 0 }
    end

    local bus = net()
    if bus then
        local handle = bus.on("DailyTaskService", "TasksUpdated", function(data)
            if type(data) == "table" then TasksChanged:Fire(data) end
        end)
        if handle and base.maid then base.maid:GiveTask(handle) end
    end

    base.log("rewards api ready")

    return {
        Errors       = Errors,
        TasksChanged = TasksChanged,
        tasks        = tasks,
        finished     = finished,
        claim        = claim,
        redeem       = redeem,
        wallet       = wallet,
    }
