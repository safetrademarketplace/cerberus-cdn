        if group.limitDistance and distance > group.maxDistance then
            enabled = false
        else
            self.onScreen = onScreen
            self.screenPoint = screen
            if onScreen then
                local parts = self.parts
                if parts[1] then
                    local cf, size = Geometry.boundingBox(parts)
                    if cf then self.corners = Geometry.corners(camera, viewport, cf, size) end
                elseif self.isPart then
                    local inst = self.instance
                    self.corners = Geometry.corners(camera, viewport, inst.CFrame, inst.Size)
                end
            elseif group.arrow.enabled then
                local view = camera.CFrame
                local flat = CFrame.fromMatrix(view.Position, view.RightVector, Vector3.yAxis)
