-- owns the obsidian window, theme/save managers, and tab construction so Cerberus.lua only wires ctx

local Library         = require("UI/Vendor/Library")
local Icons           = require("UI/Vendor/Icons")
local ThemeManager    = require("UI/Vendor/Theme")
local SaveManager     = require("UI/Vendor/SaveManager")
local References      = require("References")
local Services        = require("Services")
local FeatureRegistry = require("FeatureRegistry")
local Globals         = require("Utility/Globals")
local UiHost          = require("UI/UiHost")
local Localize        = require("Utility/Localize")
local LocalizePatch   = require("UI/LocalizePatch")
local Premium         = require("UI/Premium")

-- tint the top-bar icon with the accent color and register it so theme switches keep it in sync
local function tintTopbarIcon(lib)
    local MainFrame = lib.ScreenGui and lib.ScreenGui:FindFirstChild("Main")
    if not MainFrame then return end

    local TopBar
    for _, child in ipairs(MainFrame:GetChildren()) do
        if child:IsA("Frame") and child.Size.Y.Offset == 48 then
            TopBar = child
            break
        end
    end
    if not TopBar then return end

    local TitleHolder = TopBar:FindFirstChildOfClass("Frame")
    if not TitleHolder then return end

    local Icon = TitleHolder:FindFirstChildOfClass("ImageLabel")
    if not Icon then return end

    lib:AddToRegistry(Icon, { ImageColor3 = "AccentColor" })
    if lib.Scheme and lib.Scheme.AccentColor then
        Icon.ImageColor3 = lib.Scheme.AccentColor
    end
end

-- marker makes the single-instance guard fire next launch if roblox tears us down without OnUnload
local function installInstanceMarker()
    local uiRoot = UiHost.pick()
    local marker = uiRoot and uiRoot:FindFirstChild("__rbx_runtime_handle")
    if not marker then
        marker = Instance.new("Folder")
        marker.Name = "__rbx_runtime_handle"
        marker.Parent = uiRoot
    end
    Globals.set("__rbx_runtime_handle", marker)
    return marker
end

local M = {}

-- only a saved-and-decoded `autoshow = false` hides the window; every failure mode falls through to visible
local function getAutoShowState()
    if not (isfile and readfile and Services.HttpService and References.gameName) then
        return true
    end
    local stateFile = string.format("Cerberus/%s/settings/autoshow_state.json", References.gameName)
    if not isfile(stateFile) then
        return true
    end
    local okRead, raw = pcall(readfile, stateFile)
    if not okRead or type(raw) ~= "string" then
        return true
    end
    local HttpService = Services.HttpService
    local okDecode, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
    if not okDecode or type(decoded) ~= "table" then
        return true
    end
    if type(decoded.autoshow) == "boolean" then
        return decoded.autoshow
    end
    return true
end

function M.setup(Config)
    Globals.set("__rbx_runtime_ui", Library)

    -- must land before CreateWindow: the library resolves its own chrome icons off this module
    Library:SetIconModule(Icons)

    -- patches must install before CreateWindow so the Window/Tab/Groupbox closures are the wrapped variants
    Localize.start()
    LocalizePatch.install(Library)
    Premium.install(Library)

    if ThemeManager and ThemeManager.SetLibrary then
        ThemeManager:SetLibrary(Library)
    end

    Library.ForceCheckbox = false
    Library.ShowToggleFrameInKeybinds = true

    local autoShowState = getAutoShowState()
    -- AutoShow stays false so the window doesn't pop over the fading loader; Cerberus.lua applies the saved preference later
    local Window = Library:CreateWindow({
        Title = "Cerberus",
        Footer = References.gameName .. " | https://getcerberus.com",
        Icon = 124492948563353,
        NotifySide = "Right",
        ShowCustomCursor = false,
        AutoShow = false,
        Font = Enum.Font.BuilderSans,
        CornerRadius = 10,
        -- library ships these off by default; slate wants the motion
        Animations = {
            ToggleWindow = true,
            TabSwitch = false,
            Groupbox = true,
            Dropdown = true,
            KeyPicker = true,
        },
    })

    tintTopbarIcon(Library)
    installInstanceMarker()

    local Tabs = FeatureRegistry.buildTabs(Window, Config)

    return {
        Library       = Library,
        ThemeManager  = ThemeManager,
        SaveManager   = SaveManager,
        Window        = Window,
        Tabs          = Tabs,
        AutoShowState = autoShowState,
    }
end

return M

end)
__bundle_register("UI/LocalizePatch", function(require, _LOADED, __bundle_register, __bundle_modules)
-- idempotent monkey-patch of obsidian's public surface routing every user-facing string through Localize.T at UI build time
local Jobs     = require("Utility/Jobs")
local Localize = require("Utility/Localize")
local Log      = require("Utility/Log")

local M = {}

local T = Localize.T

local function tStr(v)
    if type(v) == "string" then return T(v) end
    return v
end

-- mutating info tables in place is safe: Library:Validate clones into a fresh output table
local TEXT_FIELDS = {
    "Text", "Tooltip", "Title", "Description", "Placeholder",
    "DisabledTooltip", "Suffix", "Prefix", "Footer", "Name",
}

-- only flag translations long enough to visibly overflow obsidian's fixed-width rows
local LONG_TEXT_FLOOR = 28      -- characters; below this, no risk of overflow
local LONG_TEXT_RATIO = 1.3     -- translated/original; above this it expanded

local function translateInfo(info)
    if type(info) ~= "table" then return info end
    -- snapshot the label pre-translation so length growth can be compared for the auto-tooltip
    local origText = type(info.Text) == "string" and info.Text or nil
    for _, key in ipairs(TEXT_FIELDS) do
        local v = info[key]
        if type(v) == "string" then info[key] = T(v) end
    end
    -- dialog footer buttons carry their visible label in each button's Title
    if type(info.FooterButtons) == "table" then
        for _, btn in pairs(info.FooterButtons) do
            if type(btn) == "table" then
                if type(btn.Title) == "string" then btn.Title = T(btn.Title) end
            end
        end
    end
    -- long translations get an auto-tooltip: paired with the TextTruncate sweep, hover reveals the full label
    if origText
        and type(info.Text) == "string"
        and info.Text ~= origText
        and #info.Text > LONG_TEXT_FLOOR
        and #info.Text > #origText * LONG_TEXT_RATIO
        and (info.Tooltip == nil or info.Tooltip == "")
    then
        info.Tooltip = info.Text
    end
    -- dropdown Values deliberately untranslated: callbacks compare against literal english strings
    return info
end

local funcsPatched = false
local function patchFuncs(groupboxLike)
    if funcsPatched then return end
    local mt = getmetatable(groupboxLike)
    if not mt or type(mt.__index) ~= "table" then
        Log.warn("[Cerberus/LocalizePatch] patchFuncs: missing metatable on groupbox")
        return
    end
    local Funcs = mt.__index

    -- strict shape (self, Idx, Info): Idx is a state key, never user-visible — translate the info table only
    local function wrapStrict(name)
        local orig = Funcs[name]
        if type(orig) ~= "function" then return end
        Funcs[name] = function(self, idx, info, ...)
            if type(info) == "table" then translateInfo(info) end
            return orig(self, idx, info, ...)
        end
    end

    for _, name in ipairs({
        "AddToggle", "AddSlider", "AddDropdown", "AddInput",
        "AddKeyPicker", "AddColorPicker", "AddCheckbox",
        "AddViewport", "AddImage", "AddVideo",
    }) do
        wrapStrict(name)
    end

    -- loose shape: AddLabel/AddButton take (text,...), (info) or (idx, info) — disambiguate by the second arg's type
    local function wrapLoose(name)
        local orig = Funcs[name]
        if type(orig) ~= "function" then return end
        Funcs[name] = function(self, first, second, ...)
            if type(first) == "table" then
                translateInfo(first)
            elseif type(second) == "table" then
                -- (idx, info) shape: first is the state key, leave it alone
                translateInfo(second)
            elseif type(first) == "string" then
                first = T(first)
            end
            return orig(self, first, second, ...)
        end
    end

    wrapLoose("AddLabel")
    wrapLoose("AddButton")

    funcsPatched = true
    Log.print("[Cerberus/LocalizePatch] BaseGroupbox Funcs patched (Add* wrappers installed)")
end

local function wrapTab(tab)
    if not tab or tab.__cerb_localize_wrapped then return tab end
    tab.__cerb_localize_wrapped = true

    local function wrapGroupboxFactory(method)
        local orig = tab[method]
        if type(orig) ~= "function" then return end
        tab[method] = function(self, name, icon, ...)
            local gb = orig(self, tStr(name), icon, ...)
            if gb then patchFuncs(gb) end
            return gb
        end
    end

    wrapGroupboxFactory("AddLeftGroupbox")
    wrapGroupboxFactory("AddRightGroupbox")

    local function wrapTabboxFactory(method)
        local orig = tab[method]
        if type(orig) ~= "function" then return end
        tab[method] = function(self, name, ...)
            local tabbox = orig(self, tStr(name), ...)
            if tabbox and not tabbox.__cerb_localize_wrapped then
                tabbox.__cerb_localize_wrapped = true
                local addTab = tabbox.AddTab
                if type(addTab) == "function" then
                    tabbox.AddTab = function(tbself, subName, iconName)
                        local subTab = addTab(tbself, tStr(subName), iconName)
                        if subTab then patchFuncs(subTab) end
                        return subTab
                    end
                end
            end
            return tabbox
        end
    end

    wrapTabboxFactory("AddLeftTabbox")
    wrapTabboxFactory("AddRightTabbox")

    -- UpdateWarningBox: Title + Text are user-visible; the flag keys are left alone
    if type(tab.UpdateWarningBox) == "function" then
        local origUpdateWarning = tab.UpdateWarningBox
        tab.UpdateWarningBox = function(self, info)
            if type(info) == "table" then translateInfo(info) end
            return origUpdateWarning(self, info)
        end
    end

    -- SetName/SetDescription relabel at runtime, so translate those too; SetIcon takes lucide ids, not text
    for _, method in ipairs({ "SetName", "SetDescription" }) do
        if type(tab[method]) == "function" then
            local orig = tab[method]
            tab[method] = function(self, value, ...)
                if type(value) == "string" then value = T(value) end
                return orig(self, value, ...)
            end
        end
    end

    return tab
end

local function wrapWindow(window)
    if not window or window.__cerb_localize_wrapped then return window end
    window.__cerb_localize_wrapped = true

    local function wrapTabFactory(method)
        local orig = window[method]
        if type(orig) ~= "function" then return end
        window[method] = function(self, ...)
            local args = { ... }
            -- AddTab/AddKeyTab signatures: (Name, IconName) or (Info table)
            if type(args[1]) == "string" then
                args[1] = T(args[1])
            elseif type(args[1]) == "table" then
                translateInfo(args[1])
            end
            local tab = orig(self, table.unpack(args))
            return wrapTab(tab)
        end
    end

    wrapTabFactory("AddTab")
    wrapTabFactory("AddKeyTab")

    do
        local origAddDialog = window.AddDialog
        if type(origAddDialog) == "function" then
            window.AddDialog = function(self, idx, info)
                if type(info) == "table" then translateInfo(info) end
                local dlg = origAddDialog(self, idx, info)
                if dlg then patchFuncs(dlg) end
                return dlg
            end
        end
    end

    return window
end

local libraryPatched = false
local function patchLibrary(Library)
    if libraryPatched or type(Library) ~= "table" then return Library end
    libraryPatched = true

    local origNotify = Library.Notify
    if type(origNotify) == "function" then
        Library.Notify = function(self, info, time, soundId)
            if type(info) == "string" then
                info = T(info)
            elseif type(info) == "table" then
                translateInfo(info)
            end
            return origNotify(self, info, time, soundId)
        end
    end

    local origCreateWindow = Library.CreateWindow
    if type(origCreateWindow) == "function" then
        Library.CreateWindow = function(self, info)
            if type(info) == "table" then translateInfo(info) end
            local window = origCreateWindow(self, info)
            return wrapWindow(window)
        end
    end

    return Library
end

-- TextTruncate=AtEnd sweep guards against translation length blowup; skips TextWrapped labels, the window title, and english passthrough entirely

-- resolved lazily so the per-descendant fast path never walks the ancestor chain
local windowTitleLabel = nil

-- MainFrame → TopBar (Frame with Y.Offset == 48) → TitleHolder → TextLabel, mirrors UiRuntime.tintTopbarIcon
local function findWindowTitleLabel(Library)
    local sg = Library and Library.ScreenGui
    local main = sg and sg:FindFirstChild("Main")
    if not main then return nil end
    local topBar
    for _, child in ipairs(main:GetChildren()) do
        if child:IsA("Frame") and child.Size.Y.Offset == 48 then
            topBar = child
            break
        end
    end
    if not topBar then return nil end
    local titleHolder = topBar:FindFirstChildOfClass("Frame")
    if not titleHolder then return nil end
    return titleHolder:FindFirstChildOfClass("TextLabel")
end

local function ensureTruncate(inst)
    if not inst then return end
    if inst == windowTitleLabel then return end
    if not (inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox")) then
        return
    end
    if inst.TextWrapped then return end
    if inst.TextTruncate ~= Enum.TextTruncate.AtEnd then
        local ok = pcall(function()
            inst.TextTruncate = Enum.TextTruncate.AtEnd
        end)
        if not ok then return end
    end
end

local truncateInstalled = false
local function installTruncationSweep(Library)
    if truncateInstalled then return end
    if not (Library and Library.ScreenGui) then return end
    -- english passthrough: no expansion risk, so honor authored widths
    if Localize.locale() == "en" then
        Log.print("[Cerberus/LocalizePatch] truncation sweep skipped (English passthrough mode)")
        truncateInstalled = true
        return
    end
    truncateInstalled = true
    local sg = Library.ScreenGui
    for _, d in ipairs(sg:GetDescendants()) do
        ensureTruncate(d)
    end
    -- task.defer lets obsidian's constructors finish before we inspect TextWrapped
    sg.DescendantAdded:Connect(function(d)
        task.defer(ensureTruncate, d)
    end)
    Log.print("[Cerberus/LocalizePatch] truncation sweep installed (TextTruncate=AtEnd on all non-wrapping text)")
end

function M.install(Library)
    Log.print("[Cerberus/LocalizePatch] installing Library wrappers")
    patchLibrary(Library)
    -- install() runs before CreateWindow, so poll for the title label with a deadline instead of assuming it exists
    Jobs.spawn(function(job)
        local deadline = os.clock() + 10
        while job.alive and os.clock() < deadline do
            local label = findWindowTitleLabel(Library)
            if label then
                windowTitleLabel = label
                -- title is sized to fit at construction; never ellipsize it
                pcall(function() label.TextTruncate = Enum.TextTruncate.None end)
                Log.print("[Cerberus/LocalizePatch] window title pinned (truncation suppressed)")
                break
            end
            if not job:sleep(0.1) then return end
        end
        installTruncationSweep(Library)
    end, { name = "TitlePin" })
    return Library
end

return M

end)
__bundle_register("Utility/Localize", function(require, _LOADED, __bundle_register, __bundle_modules)
-- lazy machine-translation of UI strings via google's gtx endpoint, background worker + on-disk cache keyed by source string
local Services       = require("Services")
local Http           = require("Utility/Helpers/Http")
local Jobs           = require("Utility/Jobs")
local Log            = require("Utility/Log")
local LanguagePicker = require("Auth/LanguagePicker")

local M = {}

local CACHE_DIR     = "Cerberus"
local CACHE_FILE    = nil   -- set in start() once locale is known
local TARGET_LOCALE = nil   -- nil = english passthrough mode

local cache       = {}      -- [source] = translated
local registry    = {}      -- [source] = true; every string ever seen
local pendingList = {}      -- ordered queue of strings awaiting fetch
local pendingSet  = {}      -- dedupe map for pendingList

local workerActive = false
local workerJob    = nil     -- Jobs handle; cancelled by stop() so unload doesn't wait out a fetch
local stopRequested = false  -- set by stop(); the worker checks each iteration
local saveDirty    = false
local saveDeadline = 0
local SAVE_BATCH   = 15      -- save after this many new translations
local SAVE_AFTER_S = 5       -- or this many seconds since last unsaved write
local FETCH_GAP_S  = 0.15    -- gentle pacing between requests
local FETCH_TIMEOUT_BACKOFF = 5  -- seconds to back off after an HTTP failure
local MAX_STRING_ATTEMPTS   = 3  -- per-string retries before that one string falls through to english
local consecutiveFailures = 0
local attemptsByText = {}        -- [source] = failed attempts so far

-- after this many failures across distinct strings the endpoint is declared dead and misses fall through to english
local API_FAILURE_THRESHOLD = 5
local distinctFailures   = 0
local apiAvailable       = true
local apiFailureNotified = false  -- set after onApiUnavailable fires so it only happens once
local apiUnavailableCallback     -- registered by Cerberus.lua to surface a Library:Notify
local apiUnavailableErrorSample  -- last error string we saw; passed to callback for the toast

-- source of truth is the LanguagePicker save; roblox system locale only when start() beats LanguagePicker.ensure()
local function detectLocale()
    local saved = LanguagePicker.read()
    if type(saved) == "string" and saved ~= "" then
        return saved:lower():match("^([a-z]+)") or "en"
    end
    local ok, loc = pcall(function()
        local svc = Services.LocalizationService
        return svc and svc.RobloxLocaleId or "en"
    end)
    if not ok or type(loc) ~= "string" then return "en" end
    return loc:lower():match("^([a-z]+)") or "en"
end

local function isEnglish(loc)
    return loc == nil or loc == "" or loc == "en"
end

local function ensureFolder()
    if makefolder then pcall(makefolder, CACHE_DIR) end
end

local function loadCache()
    if not (isfile and readfile and CACHE_FILE) then
        Log.print("[Cerberus/Localize] cache load skipped: filesystem API unavailable")
        return
    end
    local exists = false
    pcall(function() exists = isfile(CACHE_FILE) end)
    if not exists then
        Log.print(("[Cerberus/Localize] cache file %s not found, starting fresh"):format(CACHE_FILE))
        return
    end
    local ok, raw = pcall(readfile, CACHE_FILE)
    if not ok or type(raw) ~= "string" or raw == "" then
        Log.warn(("[Cerberus/Localize] cache file %s unreadable"):format(CACHE_FILE))
        return
    end
    local ok2, data = pcall(Services.HttpService.JSONDecode, Services.HttpService, raw)
    if not ok2 or type(data) ~= "table" then
        Log.warn(("[Cerberus/Localize] cache file %s malformed JSON"):format(CACHE_FILE))
        return
    end
    -- discard outright on locale mismatch so a language swap never leaks stale strings
    if data.locale ~= TARGET_LOCALE then
        Log.print(("[Cerberus/Localize] cache locale (%s) ≠ current (%s); discarding"):format(
            tostring(data.locale), tostring(TARGET_LOCALE)))
        return
    end
    local count = 0
    if type(data.entries) == "table" then
        for k, v in pairs(data.entries) do
            if type(k) == "string" and type(v) == "string" then
                cache[k] = v
                count = count + 1
            end
        end
    end
    Log.print(("[Cerberus/Localize] loaded %d cached entries for locale '%s'"):format(count, TARGET_LOCALE))
end

local function saveCache()
    if not (writefile and CACHE_FILE) then return end
    ensureFolder()
    local data = { locale = TARGET_LOCALE, entries = cache }
    local ok, encoded = pcall(Services.HttpService.JSONEncode, Services.HttpService, data)
    if not ok then
        Log.warn("[Cerberus/Localize] save: JSONEncode failed")
        return
    end
    local writeOk, writeErr = pcall(writefile, CACHE_FILE, encoded)
    if not writeOk then
        Log.warn(("[Cerberus/Localize] save: writefile failed: %s"):format(tostring(writeErr)))
    else
        local count = 0
        for _ in pairs(cache) do count = count + 1 end
        Log.print(("[Cerberus/Localize] saved %d entries to %s"):format(count, CACHE_FILE))
    end
    saveDirty = false
end

local function urlEncode(s)
    return Services.HttpService:UrlEncode(s)
end

-- keyless gtx endpoint can rate-limit by IP (429); worker pacing + backoff guard against that
local function fetchTranslation(text, target)
    local url = ("https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=%s&dt=t&q=%s")
        :format(target, urlEncode(text))

    local ok, res = Http.request({
        Url = url,
        Method = "GET",
        Headers = {
            ["User-Agent"] = "Mozilla/5.0",
            ["Accept"]     = "application/json",
        },
    })
    if not ok or type(res) ~= "table" then return nil, "no http" end

    local status = res.StatusCode or res.status_code or res.Status
    if type(status) == "number" and (status < 200 or status >= 300) then
        return nil, "http " .. tostring(status)
    end

    local body = res.Body or res.body
    if type(body) ~= "string" or body == "" then return nil, "empty body" end

    local ok2, data = pcall(Services.HttpService.JSONDecode, Services.HttpService, body)
    if not ok2 or type(data) ~= "table" then return nil, "decode failed" end

    -- response shape: [[[ "translated", "source", null, null, ...], ...], null, "src"]
    local segs = data[1]
    if type(segs) ~= "table" then return nil, "no segments" end
    local out = {}
    for _, seg in ipairs(segs) do
        if type(seg) == "table" and type(seg[1]) == "string" then
            out[#out + 1] = seg[1]
        end
    end
    if #out == 0 then return nil, "empty translation" end
    return table.concat(out)
end

local function enqueue(text)
    if cache[text] then return end
    if pendingSet[text] then return end
    pendingSet[text] = true
    pendingList[#pendingList + 1] = text
end

local function maybeSave(force)
    if not saveDirty then return end
    if force or os.clock() >= saveDeadline then
        saveCache()
    end
end

local function declareApiUnavailable(errSample)
    if not apiAvailable then return end
    apiAvailable = false
    apiUnavailableErrorSample = errSample
    -- drop the queue; existing cache entries stay readable, only future misses fall through to english
    pendingList = {}
    pendingSet = {}
    Log.warn(("[Cerberus/Localize] API declared unavailable after %d distinct failures (last error: %s)"):format(
        distinctFailures, tostring(errSample)))
    -- persist whatever did translate so subsequent runs hit cache for that subset
    if saveDirty then saveCache() end
    if apiUnavailableCallback and not apiFailureNotified then
        apiFailureNotified = true
        local ok, err = pcall(apiUnavailableCallback, errSample)
        if not ok then
            Log.warn(("[Cerberus/Localize] onApiUnavailable callback errored: %s"):format(tostring(err)))
        end
    end
end

local function startWorker()
    if workerActive then return end
    workerActive = true
    stopRequested = false
    Log.print(("[Cerberus/Localize] worker started for locale '%s'"):format(TARGET_LOCALE))
    -- deliberately not LPH_NO_VIRTUALIZE: a sub-30Hz worker carrying the translation endpoint, so de-virtualizing would expose the url for no speed
    workerJob = Jobs.spawn(function(job)
        local sinceLastSaveCount = 0
        while job.alive and not stopRequested and apiAvailable do
            if #pendingList == 0 then
                maybeSave(true)
                task.wait(2)
            else
                local text = table.remove(pendingList, 1)
                pendingSet[text] = nil
                if not cache[text] then
                    local translated, err = fetchTranslation(text, TARGET_LOCALE)
                    if stopRequested then break end
                    if translated then
                        cache[text] = translated
                        attemptsByText[text] = nil
                        saveDirty = true
                        sinceLastSaveCount = sinceLastSaveCount + 1
                        saveDeadline = os.clock() + SAVE_AFTER_S
                        consecutiveFailures = 0
                        Log.print(("[Cerberus/Localize] '%s' → '%s' (%d in queue)"):format(
                            text:sub(1, 40), translated:sub(1, 40), #pendingList))
                        if sinceLastSaveCount >= SAVE_BATCH then
                            sinceLastSaveCount = 0
                            saveCache()
                        end
                    else
                        consecutiveFailures = consecutiveFailures + 1
                        local tries = (attemptsByText[text] or 0) + 1
                        attemptsByText[text] = tries
                        -- only a string's first failure counts, so retries can't fake a sustained outage
                        if tries == 1 then distinctFailures = distinctFailures + 1 end
                        if consecutiveFailures == 1 then
                            Log.warn(("[Cerberus/Localize] translate '%s' failed: %s"):format(
                                text:sub(1, 40), tostring(err)))
                        end
                        -- sustained outage: endpoint is gone, stop trying
                        if distinctFailures >= API_FAILURE_THRESHOLD then
                            declareApiUnavailable(err)
                            break
                        end
                        -- a timeout shouldn't cost this string its translation, so send it to the back of the queue until its own budget runs out
                        if tries < MAX_STRING_ATTEMPTS then
                            enqueue(text)
                        else
                            Log.warn(("[Cerberus/Localize] giving up on '%s' after %d attempts"):format(
                                text:sub(1, 40), tries))
                        end
                        if consecutiveFailures >= 3 then
                            Log.warn(("[Cerberus/Localize] backing off %ds after %d consecutive failures"):format(
                                FETCH_TIMEOUT_BACKOFF, consecutiveFailures))
                            task.wait(FETCH_TIMEOUT_BACKOFF)
                            consecutiveFailures = 0
                        end
                    end
                end
                task.wait(FETCH_GAP_S)
                maybeSave(false)
            end
        end
        -- final flush on stop / API death
        maybeSave(true)
        workerActive = false
        Log.print("[Cerberus/Localize] worker stopped")
    end, { name = "LocalizeWorker" })
end

-- cached translation if present, else queue for background fetch and return the source unchanged
function M.T(text)
    if type(text) ~= "string" or text == "" then return text end
    if not TARGET_LOCALE then return text end
    if not registry[text] then registry[text] = true end
    local hit = cache[text]
    if hit then return hit end
    -- if the API is declared dead the worker is gone — don't queue more work
    if apiAvailable then enqueue(text) end
    return text
end

-- bulk-warm strings into cache for next session, e.g. from a build-time manifest
function M.warmup(list)
    if not TARGET_LOCALE or type(list) ~= "table" then return end
    for _, s in ipairs(list) do
        if type(s) == "string" and s ~= "" and not cache[s] then
            enqueue(s)
        end
    end
end

-- drop the on-disk cache and re-fetch every registered string ("Refresh translations" button)
function M.clearCache()
    local n = 0
    for _ in pairs(registry) do n = n + 1 end
    Log.print(("[Cerberus/Localize] clearCache: dropping %d cached entries, re-queuing %d registered strings"):format(
        (function() local c=0; for _ in pairs(cache) do c=c+1 end; return c end)(), n))
    cache = {}
    pendingList = {}
    pendingSet = {}
    if delfile and CACHE_FILE then
        local exists = false
        pcall(function() exists = isfile and isfile(CACHE_FILE) end)
        if exists then pcall(delfile, CACHE_FILE) end
    end
    saveDirty = false
    -- refresh is the user's signal things work again: give the API a fresh chance, respawn the worker
    apiAvailable = true
    apiFailureNotified = false
    distinctFailures = 0
    consecutiveFailures = 0
    for s in pairs(registry) do enqueue(s) end
    if not workerActive and TARGET_LOCALE then
        startWorker()
    end
end

function M.locale()
    return TARGET_LOCALE or "en"
end

-- false after API_FAILURE_THRESHOLD distinct fetch failures
function M.isApiAvailable()
    return apiAvailable
end

-- one-shot callback on API death; fires immediately if the API is already dead when registered
function M.onApiUnavailable(fn)
    if type(fn) ~= "function" then return end
    apiUnavailableCallback = fn
    if not apiAvailable and not apiFailureNotified then
        apiFailureNotified = true
        local ok, err = pcall(fn, apiUnavailableErrorSample)
        if not ok then
            Log.warn(("[Cerberus/Localize] onApiUnavailable callback errored: %s"):format(tostring(err)))
        end
    end
end

-- idempotent worker shutdown + flush; wired into Unloader so an unload mid-translation persists progress
function M.stop()
    if not workerActive and not saveDirty then return end
    if stopRequested then return end
    Log.print(("[Cerberus/Localize] stop requested (%d queued, %d cached, dirty=%s)"):format(
        #pendingList,
        (function() local n=0; for _ in pairs(cache) do n=n+1 end; return n end)(),
        tostring(saveDirty)))
    stopRequested = true
    -- save on the calling thread too: a mid-fetch worker won't notice stopRequested for seconds
    if saveDirty then saveCache() end
    -- ...and then kill it outright, so unload doesn't leave a thread fetching against dead state
    if workerJob then
        workerJob:Cancel()
        workerJob = nil
        workerActive = false
    end
end

function M.stats()
    return {
        locale     = TARGET_LOCALE or "en",
        cached     = (function() local n=0; for _ in pairs(cache) do n=n+1 end; return n end)(),
        registered = (function() local n=0; for _ in pairs(registry) do n=n+1 end; return n end)(),
        queued     = #pendingList,
    }
end

-- kick everything off; subsequent calls no-op
function M.start(opts)
    opts = opts or {}
    if TARGET_LOCALE ~= nil then
        Log.print(("[Cerberus/Localize] start: already running for '%s'"):format(TARGET_LOCALE))
        return
    end
    local loc = opts.locale or detectLocale()
    if isEnglish(loc) then
        Log.print(("[Cerberus/Localize] start: locale '%s' is English, passthrough mode"):format(loc))
        return
    end
    TARGET_LOCALE = loc
    CACHE_FILE = ("%s/translations_%s.json"):format(CACHE_DIR, TARGET_LOCALE)
    Log.print(("[Cerberus/Localize] start: locale '%s', cache=%s"):format(TARGET_LOCALE, CACHE_FILE))
    ensureFolder()
    loadCache()
    startWorker()
end

return M

end)
__bundle_register("FeatureRegistry", function(require, _LOADED, __bundle_register, __bundle_modules)
-- featureregistry: declarative tab metadata + mount order; static requires because luabundle can't follow dynamic ones

local TabHome       = require("Tabs/Home")
local TabMain       = require("Tabs/Main")
local TabDefense    = require("Tabs/Defense")
local TabPlayer     = require("Tabs/Player")
local TabESP        = require("Tabs/ESP")
local TabMisc       = require("Tabs/Misc")
local TabFun        = require("Tabs/Fun")
local TabUISettings = require("Tabs/UISettings")

local M = {}

-- display = entry order, mount = ascending mountOrder (UISettings first so theme/save hooks land before features); configKeys all-false skips the tab, none = always present
M.tabs = {
    { key = "Home",        label = "Home",        icon = "house",       mount = TabHome,       mountOrder = 2,  configKeys = { "Home" } },
    { key = "Main",        label = "Main",        icon = "star",        mount = TabMain,       mountOrder = 3,  configKeys = { "Basketball" } },
    { key = "Defense",     label = "Defense",     icon = "shield",      mount = TabDefense,    mountOrder = 11, configKeys = { "Basketball" } },
    { key = "Player",      label = "Player",      icon = "circle-user", mount = TabPlayer,     mountOrder = 5,  captureAs = "Movement", configKeys = { "Movement", "PlayerUtils", "Visuals" } },
    { key = "ESP",         label = "ESP",         icon = "eye",         mount = TabESP,        mountOrder = 7,  configKeys = { "ESP" } },
    { key = "Misc",        label = "Misc",        icon = "archive",     mount = TabMisc,       mountOrder = 8,  configKeys = { "Misc" } },
    { key = "Fun",         label = "Fun",         icon = "joystick",    mount = TabFun,        mountOrder = 10, configKeys = { "Fun" } },
    { key = "UI Settings", label = "UI Settings", icon = "settings",    mount = TabUISettings, mountOrder = 1 },
}

local function isTabEnabled(def, Config)
    if not def.configKeys then return true end
    if type(Config) ~= "table" then return true end
    for _, key in ipairs(def.configKeys) do
        if Config[key] then return true end
    end
    return false
end

function M.buildTabs(Window, Config)
    local Tabs = {}
    for _, def in ipairs(M.tabs) do
        if isTabEnabled(def, Config) then
            Tabs[def.key] = Window:AddTab(def.label, def.icon)
        end
    end
    return Tabs
end

function M.mountAll(ctx, Debug)
    local ordered = {}
    for _, def in ipairs(M.tabs) do ordered[#ordered + 1] = def end
    table.sort(ordered, function(a, b)
        return (a.mountOrder or math.huge) < (b.mountOrder or math.huge)
    end)

    local captured = {}
    local Tabs = ctx.Tabs or {}
    for _, def in ipairs(ordered) do
        if Tabs[def.key] then
            Debug:LoadModule(def.key, function()
                local result = def.mount(ctx)
                if def.captureAs then captured[def.captureAs] = result end
            end)
        end
    end
    return captured
end

return M

end)
