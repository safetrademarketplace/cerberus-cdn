__bundle_register("Features/Visuals/Visuals/Fullbright", function(require, _LOADED, __bundle_register, __bundle_modules)
-- fullbright sub-module of visuals (passive/aggressive lighting override)
local Scheduler = require("Utility/Scheduler")

return function(ctx)
    local Services     = ctx.Services
    local Options      = ctx.Options
    local Toggles      = ctx.Toggles
    local track        = ctx.track
    local VisualsGroup = ctx.VisualsGroup

    VisualsGroup:AddToggle("Fullbright", {
        Text = "Fullbright",
        Default = false
    })

    local FullbrightBox = VisualsGroup:AddDependencyBox()

    FullbrightBox:AddDropdown("Fullbright_Mode", {
        Text = "Lighting Mode",
        Default = 2,
        Values = {"Passive", "Aggressive"},
        Tooltip = "Aggressive removes shadows"
    })

    FullbrightBox:AddSlider("Fullbright_Brightness", {
        Text = "Brightness",
        Default = 1,
        Min = 0.01,
        Max = 5,
        Rounding = 3
    })

    FullbrightBox:SetupDependencies({
        { Toggles.Fullbright, true },
    })

    local currentBrightness = Options.Fullbright_Brightness.Value

    local fbConn, fbSaved

    local COLOR_AGGRESSIVE = Color3.new(1, 1, 1)
    local COLOR_PASSIVE    = Color3.fromRGB(150, 150, 150)

    local function fbOn()
        if fbConn then return end

        local lighting = Services.Lighting

        fbSaved = fbSaved or {
            B = lighting.Brightness,
            GS = lighting.GlobalShadows,
            A = lighting.Ambient,
            OA = lighting.OutdoorAmbient
        }

        fbConn = track(Scheduler.render(function()
            local mode = Options.Fullbright_Mode and Options.Fullbright_Mode.Value or "Aggressive"

