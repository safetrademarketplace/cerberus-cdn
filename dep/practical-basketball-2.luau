-- quenty nevermore Maid, forked: luau types stripped for luabundler and every task dispatched under pcall, because upstream lets one throwing task abort the rest of DoCleaning
local Log = require("Utility/Log")

local Maid = {}
Maid.ClassName = "Maid"

-- one task's failure is logged and skipped, never allowed to abort the sweep
local function runTask(job)
	local ok, err = pcall(function()
		if typeof(job) == "function" then
			job()
		elseif typeof(job) == "table" then
			if type(job.Destroy) == "function" then
				job:Destroy()
			end
		elseif typeof(job) == "Instance" then
			job:Destroy()
		elseif typeof(job) == "thread" then
			local cancelled
			if coroutine.running() ~= job then
				cancelled = pcall(function()
					task.cancel(job)
				end)
			end

			if not cancelled then
				task.defer(function()
					task.cancel(job)
				end)
			end
		elseif typeof(job) == "RBXScriptConnection" then
			job:Disconnect()
		end
	end)
	if not ok then
		Log.devwarn("Maid", "task failed during cleanup: %s", tostring(err))
	end
end

function Maid.new()
	return setmetatable({ _tasks = {} }, Maid)
end

function Maid.isMaid(value)
	return type(value) == "table" and value.ClassName == "Maid"
end

function Maid.__index(self, index)
	if Maid[index] then
		return Maid[index]
	else
		return self._tasks[index]
	end
end

function Maid.__newindex(self, index, newTask)
	if Maid[index] ~= nil then
		error(string.format("Cannot use '%s' as a Maid key", tostring(index)), 2)
	end

	local tasks = self._tasks
	local job = tasks[index]

	if job == newTask then
		return
	end

	tasks[index] = newTask

	if job then
		runTask(job)
	end
end

function Maid:Add(taskItem)
	if not taskItem then
		error("Task cannot be false or nil", 2)
	end

	self[#self._tasks + 1] = taskItem

	if type(taskItem) == "table" and not taskItem.Destroy then
		Log.warn("[Maid.Add] - Gave table task without .Destroy\n\n" .. debug.traceback())
	end

	return taskItem
end

function Maid:GiveTask(taskItem)
	if not taskItem then
		error("Task cannot be false or nil", 2)
	end

	local taskId = #self._tasks + 1
	self[taskId] = taskItem

	if type(taskItem) == "table" and not taskItem.Destroy then
		Log.warn("[Maid.GiveTask] - Gave table task without .Destroy\n\n" .. debug.traceback())
	end

	return taskId
end

function Maid:GivePromise(promise)
	if not promise:IsPending() then
		return promise
	end

	local newPromise = promise.resolved(promise)
	local id = self:GiveTask(newPromise)

	newPromise:Finally(function()
		self[id] = nil
	end)

	return newPromise
end

-- second fork delta: upstream drains with `next()`, so unwinding GiveTask's ascending integer keys in reverse is what gives callers LIFO
function Maid:DoCleaning()
	local tasks = self._tasks

	-- connections first, so a watcher can't fire on a state-restoring task and undo it
	for index, job in pairs(tasks) do
		if typeof(job) == "RBXScriptConnection" then
			tasks[index] = nil
			runTask(job)
		end
	end

	local highest = 0
	for index in pairs(tasks) do
		if type(index) == "number" and index > highest then highest = index end
	end
	for i = highest, 1, -1 do
		local job = tasks[i]
		if job ~= nil then
			tasks[i] = nil
			runTask(job)
		end
	end

	local index, job = next(tasks)
	while job ~= nil do
		tasks[index] = nil
		runTask(job)
		index, job = next(tasks)
	end
end

Maid.Destroy = Maid.DoCleaning

return Maid

end)
__bundle_register("Features/Basketball/Defense/Jumper", function(require, _LOADED, __bundle_register, __bundle_modules)
-- defense jumper: the one way the suite leaves the floor, sending what the space key sends (Input.Keyboard:156-157 going down, :208 coming up) and refusing while the ball is ours, because space with the ball is a shot
local Jobs = require("Utility/Jobs")

local TAP    = 0.08  -- about as long as a finger stays on the key
local SETTLE = 0.5   -- a round trip passes before InAir says so, and a block then a rebound must not stack

-- what the game itself counts as being on offense (Input.Mobile:83), the ball's weld and attribute being the other half
local OFFENSE = { CatchingPass = true, CatchingLob = true, Shooting = true, Dunking = true }

local SPACE = { space = true }

local M = {}

-- how long a jump takes to reach its peak; the server owns the jump, so this is not readable from the client and is checked live
M.RISE = 0.28

function M.new(court, input, player)
    local lastJump = nil

    -- plain english for the status label, nil when a jump is fine
    local function refusal()
        if not player.model() then return "Waiting for your character" end
        if court.hasBall() or player.attr("Basketball") then return "You have the ball" end
        if OFFENSE[player.action()] then return "You have the ball" end
        if player.inAir() then return "Already in the air" end
        if lastJump and os.clock() - lastJump < SETTLE then return "You just jumped" end
        if not input.legal("shootPress", SPACE) then return "Can't jump right now" end
        return nil
    end

    local function go()
        local why = refusal()
        if why then return false, why end
        if not input.shootPress(SPACE) then return false, "Jump failed" end
        lastJump = os.clock()
        -- deliberately not tied to the toggle: switching off mid tap must still let go of the key
        Jobs.delay(TAP, function() input.shootRelease() end, { name = "DefenseJumpRelease" })
        return true
    end

    return { refusal = refusal, go = go }
end

return M

end)
