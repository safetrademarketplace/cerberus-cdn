-- prefs camera: the game's camera views and field of view; a view is held by overriding the per-device preference, so a rebuilt body or a device change lands on it through the game's own code with nothing polling
local Identity = require("Utility/Identity")

local Errors = require("Api/Prefs/Errors")

local SECTION = "Camera"
local FOV_ROW = "FieldOfView"

-- only these three views give a never-written value a fallback; the rest read it unguarded
local FOV_FALLBACK = { Player = 70, Court = 70, Wire = 60 }

local M = {}

local function noop() end

function M.new(deps)
    local Net       = deps.Net
    local base      = deps.base
    local catalog   = deps.catalog
    local layer     = deps.layer
    local override  = deps.override
    local readSaved = deps.readSaved

    -- rebuilt with every body, so read fresh each time
    local function camera()
        local state = Net.playerState()
        local cam = state and state.Camera
        if type(cam) ~= "table" or type(cam.Types) ~= "table" then return nil end
        return cam
    end

    local function deviceRows()
        local out = {}
        for _, row in ipairs(catalog.rows(SECTION)) do
            if row.options and string.match(row.name, "Camera$") then out[#out + 1] = row end
        end
        return out
    end

    local function modes()
        local cam = camera()
        local rows = deviceRows()
        local out, seen = {}, {}
        if rows[1] then
            for _, name in ipairs(rows[1].options) do
                if not cam or cam.Types[name] then
                    seen[name] = true
                    out[#out + 1] = name
                end
            end
        end
        if cam then
            local extra = {}
            for name in pairs(cam.Types) do
                if not seen[name] then extra[#extra + 1] = name end
            end
            table.sort(extra)
            for _, name in ipairs(extra) do out[#out + 1] = name end
        end
        if #out == 0 then return false, Errors.NOT_READY end
        return true, out
    end

    local function mode()
        local cam = camera()
        if not cam or type(cam.ActiveMode) ~= "string" then return false, Errors.NOT_READY end
        return true, cam.ActiveMode
    end

    -- the same pair the game runs on a device change; a game call drops the thread's identity, and this runs on the caller's thread
    local function switchTo(name)
