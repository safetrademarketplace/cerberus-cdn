__bundle_register("Api/Esp/Groups", function(require, _LOADED, __bundle_register, __bundle_modules)
-- esp group registry: a group is { key, label, source, config, labels, extras, changed }; source returns the instances to draw, config is the style the renderer reads live and can carry a provider, labels and extras name the group's own menu controls, changed lists signals that make a rescan due at once

local M = {}

-- one fresh, fully-populated config per group (accent tints the box/tracer/fill/chams)
local function defaultConfig(accent)
    accent = accent or Color3.fromRGB(255, 60, 60)
    local black, white = Color3.new(), Color3.new(1, 1, 1)
    return {
        enabled = false, limitDistance = false, maxDistance = 150,
        maxTracked = 100, refreshInterval = 1.0,
        box      = { enabled = true,  color = accent, transparency = 1, thickness = 1, outline = true, outlineColor = black },
        boxFill  = { enabled = false, color = accent, transparency = 0.35 },
        box3d    = { enabled = false, color = accent, transparency = 1, thickness = 1 },
        name     = { enabled = true,  color = white, transparency = 1, outline = true, outlineColor = black },
        distance = { enabled = false, color = white, transparency = 1, outline = true, outlineColor = black },
        leftBar  = { enabled = true, text = false, fullColor = Color3.new(0, 1, 0), emptyColor = Color3.new(1, 0, 0), outline = true, outlineColor = black, textColor = white },
        rightBar = { enabled = false, color = accent, transparency = 1, outline = true, outlineColor = black },
        status   = { enabled = false, color = white, transparency = 1, outline = true, outlineColor = black },
        tracer   = { enabled = false, origin = "Bottom", color = accent, transparency = 1, outline = true, outlineColor = black },
        arrow    = { enabled = false, color = white, transparency = 1, size = 15, radius = 150, outline = true, outlineColor = black },
        skeleton = { enabled = false, color = white, transparency = 1, thickness = 1 },
        chams    = { enabled = false, fillColor = accent, fillTransparency = 0.5, outlineColor = white, outlineTransparency = 0, visibleOnly = false },
    }
end

M.defaultConfig = defaultConfig

function M.new()
    local groups = {}
    local order = {}

    local function register(def)
        if type(def) ~= "table" or type(def.key) ~= "string" or def.key == "" then return false end
        if type(def.source) ~= "function" then return false end
        if not groups[def.key] then order[#order + 1] = def.key end
        groups[def.key] = {
            key    = def.key,
            label  = def.label or def.key,
            source = def.source,
            config = def.config or defaultConfig(),
            labels = def.labels or {},
            extras = def.extras or {},
        }
        return true
    end

    -- two-level merge so the ui can push one knob (e.g. { box = { enabled = true } })
    local function setConfig(key, partial)
        local g = groups[key]
        if not g or type(partial) ~= "table" then return end
        for k, v in pairs(partial) do
            if type(v) == "table" and type(g.config[k]) == "table" then
                for kk, vv in pairs(v) do g.config[k][kk] = vv end
            else
                g.config[k] = v
            end
        end
    end

    return {
        Register = register,
        Get = function(key) return groups[key] end,
        List = function()
            local out = {}
            for _, key in ipairs(order) do
                local g = groups[key]
                out[#out + 1] = { key = g.key, label = g.label, labels = g.labels, extras = g.extras }
            end
            return out
        end,
        SetConfig = setConfig,
    }
end

return M

end)
__bundle_register("Api/Esp/Object", function(require, _LOADED, __bundle_register, __bundle_modules)
-- one config-driven visual per target: a reused Drawing bin (box/box3d/fill/name/distance/bars/status/tracer/arrow/skeleton) plus a chams Highlight made only once chams are on; Sample caches the slow reads at the engine's rate, and Update and Render are the per-frame hot path that read only that cache, native-speed in the unobfuscated half

local Geometry = require("Api/Esp/Geometry")

local round = math.round
local BAR_OFFSET = Vector2.new(5, 0)
local BAR_CAP = Vector2.new(0, 1)
local NAME_OFFSET = Vector2.new(0, 2)
local BELOW_OFFSET = Vector2.new(0, 2)
local SKELETON_MAX = 16
local WHITE = Color3.new(1, 1, 1)

local Object = {}
Object.__index = Object

local function create(bin, class, props)
    local drawing = Drawing.new(class)
    for prop, value in next, props do
        pcall(function() drawing[prop] = value end)
    end
    bin[#bin + 1] = drawing
    return drawing
end

-- group is the live config, so a menu change lands on the next frame without touching the object
function Object.new(instance, group, shared, deps)
    local self = setmetatable({}, Object)
    self.instance = instance
    self.group    = group
    self.shared   = shared
    self.deps     = deps
    self.isModel  = instance:IsA("Model")
    self.isPart   = instance:IsA("BasePart")
    self.bin      = {}
    self.sample   = {}
    self.parts    = {}
    self.bonePairs = {}
    self.childCount = -1
    self.live     = false
    self.chamsOn  = false

    local bin = self.bin
    -- drawing order = creation order, so a fill/outline must be created before the element it sits behind or it paints over it
    self.boxFill     = create(bin, "Square", { Filled = true, Visible = false })
    self.boxOutline  = create(bin, "Square", { Thickness = 3, Filled = false, Visible = false })
    self.box         = create(bin, "Square", { Thickness = 1, Filled = false, Visible = false })

    self.box3d = {}
    for _ = 1, 12 do self.box3d[#self.box3d + 1] = create(bin, "Line", { Thickness = 1, Visible = false }) end
    self.skeleton = {}
    for _ = 1, SKELETON_MAX do self.skeleton[#self.skeleton + 1] = create(bin, "Line", { Visible = false }) end

    self.leftOutline  = create(bin, "Line", { Thickness = 3, Visible = false })
    self.leftBar      = create(bin, "Line", { Thickness = 1, Visible = false })
    self.rightOutline = create(bin, "Line", { Thickness = 3, Visible = false })
    self.rightBar     = create(bin, "Line", { Thickness = 1, Visible = false })
    self.tracerOutln  = create(bin, "Line", { Thickness = 3, Visible = false })
    self.tracer       = create(bin, "Line", { Thickness = 1, Visible = false })
    self.arrowOutln   = create(bin, "Triangle", { Thickness = 3, Visible = false })
    self.arrow        = create(bin, "Triangle", { Filled = true, Visible = false })
    self.leftText     = create(bin, "Text", { Center = true, Visible = false })
    self.name         = create(bin, "Text", { Center = true, Visible = false })
    self.distance     = create(bin, "Text", { Center = true, Visible = false })
    self.lineA        = create(bin, "Text", { Center = true, Visible = false })
    self.lineB        = create(bin, "Text", { Center = true, Visible = false })

    return self
end

function Object:Destruct()
    for i = 1, #self.bin do pcall(self.bin[i].Remove, self.bin[i]) end
    if self.highlight then pcall(self.highlight.Destroy, self.highlight) end
    table.clear(self)
end

-- a group with no provider still gets a working bar off the humanoid, so the engine stays usable with no game file behind it
local function readDefaults(self, sample)
    local humanoid = self.isModel and self.instance:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.MaxHealth <= 0 then return end
    sample.left = humanoid.Health / humanoid.MaxHealth
    sample.leftText = round(humanoid.Health) .. "hp"
    sample.gone = humanoid.Health <= 0
end

local function findAnchor(self)
    local inst = self.instance
    if self.isPart then return inst end
    if not self.isModel then return nil end
    return inst:FindFirstChild("Head") or inst:FindFirstChild("HumanoidRootPart") or inst.PrimaryPart
end

local function refreshParts(self)
    local children = self.instance:GetChildren()
    local count = #children
    if count == self.childCount then return end
    self.childCount = count
    local parts = self.parts
    table.clear(parts)
    for i = 1, count do
        local part = children[i]
        if part:IsA("BasePart") and Geometry.isBodyPart(part.Name) then parts[#parts + 1] = part end
    end
end

local function refreshBones(self)
    local model = self.instance
    local out = self.bonePairs
    local bones = Geometry.bones(model, model:FindFirstChildOfClass("Humanoid"))
    local used = 0
    for i = 1, #bones do
        local from, to = model:FindFirstChild(bones[i][1]), model:FindFirstChild(bones[i][2])
        if from and to then
            used = used + 1
            local pair = out[used]
            if not pair then
                pair = {}
