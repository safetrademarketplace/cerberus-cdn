                    self.nameInput.Text = name
                end
            end)
        end
        if self.selected and rows[self.selected] then
            selectRow(self.selected, rows)
        end
    end

    submitBtn.Activated:Connect(function()
        if not Api.canWrite() then
            setStatus(tr("Submitting is off"), true)
            return
        end
        local discordId = services.viewerDiscordId
        if not discordId or discordId == "" then
            setStatus(tr("Link Discord on Luarmor to submit"), true)
            return
        end
        local pickedLocal = self.selected
        if not pickedLocal then
            setStatus(tr("Pick a local config first"), true)
            return
        end
        local payload = Storage.read(pickedLocal)
        if payload == nil then
            setStatus(string.format(tr("Couldn't read %q"), pickedLocal), true)
            return
        end
        local submittedName = self.nameInput.Text
        if submittedName == nil or submittedName:gsub("%s", "") == "" then
            submittedName = pickedLocal
        end

        -- client-side language gate before the network; backend should also enforce (see Filter.lua)
        local allowed, reason = Filter.checkSubmission(submittedName, self.descInput.Text)
        if not allowed then
            setStatus(reason or tr("Contains banned words"), true)
            return
        end

        local existingEntry = nil
        if self.mode == "update" then
            existingEntry = self.existing[self.existingIndex]
            if not existingEntry then
                setStatus(tr("Pick a config to update"), true)
                return
            end
        end
        local isUpdate = existingEntry ~= nil
        local updateId = existingEntry and existingEntry.id

        submitBtn.Text = "..."
        submitBtn.AutoButtonColor = false
        setStatus(isUpdate and tr("Updating…") or tr("Uploading…"), false)

        task.spawn(function()
            local payloadBody = {
                name        = submittedName,
                description = self.descInput.Text or "",
                discord_id  = discordId,
                game        = Storage.gameName(),
                data        = payload,
            }
            local data, err, status
            if isUpdate then
                data, err, status = Api.update(updateId, payloadBody)
            else
                data, err, status = Api.create(payloadBody)
            end
            if not data then
                if status == 429 then
                    local window = isUpdate and tr("10 minutes between updates")
                        or tr("10 minutes between uploads")
                    setStatus(string.format(tr("Wait %s. %s"), window, tostring(err)), true)
                elseif status == 403 then
                    setStatus(tr("Not yours to update"), true)
                else
                    setStatus(string.format(
                        isUpdate and tr("Update failed: %s") or tr("Upload failed: %s"),
                        tostring(err)), true)
                end
                submitBtn.Text = isUpdate and tr("Update") or tr("Submit")
                return
            end
            local statusText = isUpdate
                and tr("Updated %q")
                or tr("Uploaded %q")
            local notifyText = isUpdate
                and tr("Updated %q")
                or tr("Uploaded %q")
            setStatus(string.format(statusText, submittedName), false)
            Library:Notify(string.format(notifyText, submittedName), 4)
            submitBtn.Text = isUpdate and tr("Update") or tr("Submit")
            -- refresh so the just-created entry shows up in the mode picker
            self:_refreshExisting()
        end)
    end)

    local function disarmDelete()
        self.deleteArmed = false
        self.deleteResetToken = self.deleteResetToken + 1
        if self.deleteBtn then
            self.deleteBtn.Text = tr("Delete")
            self.deleteBtn.BackgroundColor3 = theme.Row
            self.deleteBtn.TextColor3 = theme.TextMuted
        end
    end

    local function applyMode()
        local entry = self.existing[self.existingIndex]
        disarmDelete()
        if entry then
            self.mode = "update"
            self.modeBtn.Text = string.format(tr("Update: %s"), tostring(entry.name))
            -- prefill name + description so the user can tweak them
            self.nameInput.Text = entry.name or ""
            self.descInput.Text = entry.description or ""
            self.submitBtn.Text = tr("Update")
            self.deleteBtn.Visible = true
        else
            self.mode = "new"
            self.modeBtn.Text = #self.existing > 0
                and tr("Submit as new (click to switch)")
                or tr("Submit as new")
            self.submitBtn.Text = tr("Submit")
            self.deleteBtn.Visible = false
            -- don't wipe a name/desc the user typed
        end
    end

    function self:_refreshExisting()
        local discordId = services.viewerDiscordId
        if not discordId or discordId == "" then
            self.existing = {}
            self.existingIndex = 0
            applyMode()
            return
        end
        task.spawn(function()
            local data, err = Api.list({
                discord_id = discordId,
                game       = Storage.gameName(),
                limit      = 50,
            })
            if not data then
                Log.warn("[Cerberus.Configs] couldn't fetch existing submissions: " .. tostring(err))
                self.existing = {}
            else
                local items = data.items or data.configs or data
                if type(items) == "table" then
                    self.existing = items
                else
                    self.existing = {}
                end
            end
            -- reset cycle when the list changes
            self.existingIndex = 0
            applyMode()
        end)
    end

    self.modeBtn.Activated:Connect(function()
        if #self.existing == 0 then
            Library:Notify(tr("No submissions yet"), 3)
            return
        end
        -- cycle: 0 (new) → 1 → ... → #existing → 0
        self.existingIndex = (self.existingIndex + 1) % (#self.existing + 1)
        applyMode()
    end)

    -- first click arms, second within 3s deletes; auto-reset so a stray click doesn't nuke a config
    self.deleteBtn.Activated:Connect(function()
        if self.mode ~= "update" then return end
        local entry = self.existing[self.existingIndex]
        if not entry then return end

        if not self.deleteArmed then
            self.deleteArmed = true
            self.deleteBtn.Text = tr("Confirm?")
            self.deleteBtn.BackgroundColor3 = theme.Danger
            self.deleteBtn.TextColor3 = Color3.new(1, 1, 1)
            self.deleteResetToken = self.deleteResetToken + 1
            local myToken = self.deleteResetToken
            Jobs.delay(3, function()
                if self.deleteResetToken == myToken and self.deleteArmed then
                    disarmDelete()
                end
            end, { name = "ConfigDeleteDisarm" })
            return
        end

        local discordId = services.viewerDiscordId
        if not discordId or discordId == "" then
            setStatus(tr("Link Discord to delete"), true)
            disarmDelete()
            return
        end
        local entryId = entry.id
        local entryName = entry.name or tr("(unnamed)")

        self.deleteBtn.Text = "..."
        setStatus(tr("Deleting…"), false)
        task.spawn(function()
            local data, err, status = Api.delete(entryId, discordId)
            if not data then
                if status == 403 then
                    setStatus(tr("Not yours to delete"), true)
                elseif status == 404 then
                    setStatus(tr("Already gone"), false)
                else
                    setStatus(string.format(tr("Delete failed: %s"), tostring(err)), true)
                end
                disarmDelete()
                return
            end
            setStatus(string.format(tr("Deleted %q"), entryName), false)
            Library:Notify(string.format(tr("Deleted %q"), entryName), 4)
            disarmDelete()
            self.nameInput.Text = ""
            self.descInput.Text = ""
            self:_refreshExisting()
        end)
    end)

    function self:OnShow()
        refreshLocalList()
        self:_refreshExisting()
        if self.statusLabel and self.statusLabel.Text ~= "" then
            -- keep success text across pane switches; only clear stale errors
            if self.statusLabel.TextColor3 == theme.Danger then
                setStatus("", false)
            end
        end
    end

    return self
end

end)
__bundle_register("Features/Configs/Filter", function(require, _LOADED, __bundle_register, __bundle_modules)
-- best-effort client-side slur filter for submissions (server is the real defence); normalize (lowercase → leet swap → strip non-alpha) then substring-match char-code-encoded patterns

local M = {}

-- ascii-encoded so no plaintext slurs ship; slurs that collide with normal english substrings are deliberately excluded
local ENCODED = {
    { 110, 105, 103, 103, 101, 114 },       -- anti-Black slur, hard-r
    { 110, 105, 103, 103, 97 },              -- anti-Black slur, soft-a
    { 102, 97, 103, 103, 111, 116 },         -- anti-gay slur
    { 114, 101, 116, 97, 114, 100 },         -- anti-disabled slur
    { 107, 105, 107, 101 },                  -- anti-Jewish slur
    { 99, 104, 105, 110, 107 },              -- anti-East-Asian slur
    { 116, 114, 97, 110, 110, 121 },         -- anti-trans slur
    { 99, 111, 111, 110 },                   -- racial slur (animal-based)
    { 103, 111, 111, 107 },                  -- anti-East-Asian slur
}

local PATTERNS = {}
do
    local unpack_ = table.unpack or unpack
    for _, codes in ipairs(ENCODED) do
        PATTERNS[#PATTERNS + 1] = string.char(unpack_(codes))
    end
end

local function normalize(text)
    if type(text) ~= "string" or text == "" then return "" end
    local lowered = text:lower()
    -- leet swaps must run before the non-alpha strip so 1→i etc. survive
    local swapped = lowered
        :gsub("[!|1]", "i")
        :gsub("0", "o")
        :gsub("3", "e")
        :gsub("[4@]", "a")
        :gsub("[5%$]", "s")
        :gsub("7", "t")
    -- strip non a-z so separators between letters collapse
    return (swapped:gsub("[^a-z]", ""))
end

-- returns (allowed, reason); reason is a short string suitable for Notify, empty input always allowed
function M.check(text)
    local norm = normalize(text)
    if norm == "" then return true end
    for _, pat in ipairs(PATTERNS) do
        if norm:find(pat, 1, true) then
            return false, "Contains banned words"
        end
    end
    return true
end

-- validate a (name, description) pair; first failure wins, nil skips a field
function M.checkSubmission(name, description)
    local ok, reason = M.check(name)
    if not ok then return false, reason end
    return M.check(description)
end

return M

end)
