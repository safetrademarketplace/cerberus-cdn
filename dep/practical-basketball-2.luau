        if Zoom.conn then
            pcall(function() Zoom.conn:Disconnect() end); Zoom.conn = nil
        end
        local cam = References.camera or Services.Workspace.CurrentCamera
        if cam and Zoom.origFov then pcall(function() cam.FieldOfView = Zoom.origFov end) end
    end

    local tg
