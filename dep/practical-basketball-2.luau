__bundle_register("Utility/Helpers/Webhook", function(require, _LOADED, __bundle_register, __bundle_modules)
-- discord webhook poster, falling back from the shared http stack to HttpService:PostAsync

local Http = require("Utility/Helpers/Http")
local Log  = require("Utility/Log")

return function(ctx, Helpers)
    local Services   = ctx.Services
    local References = ctx.References

    function Helpers.SendDiscordWebhook(webhookUrl, title, description, nickname, color, iconUrl, anonymize)
        local EMBED_COLOR = color or 3577389
        local ICON_URL = iconUrl
            or "https://media.discordapp.net/attachments/1349939253739651134/1428995137505067069/cerberus_logo.png"

        local playerName = "Unknown Player"
        local gameName = References.gameName or "Unknown Game"

        pcall(function()
            playerName = Services.Players.LocalPlayer.Name
        end)

        local desc = tostring(description or "")
        if anonymize ~= true then
            desc = desc .. string.format(
                "\n\n**Player:** `%s`\n**Game:** `%s`",
                tostring(playerName),
                tostring(gameName)
            )
        end

        local payload = {
            username = nickname or "Cerberus Macro Logger",
            avatar_url = ICON_URL,
            embeds = { {
                title = tostring(title or "Cerberus Event"),
                description = desc,
                color = EMBED_COLOR,
            } },
        }

        local ok
        if Http.client() then
            -- through Http.postJson so discord's per-host pacing and 429 backoff apply here too
            ok = Http.postJson(webhookUrl, payload) ~= nil
        else
            local body = Services.HttpService:JSONEncode(payload)
            ok = pcall(function()
                Services.HttpService:PostAsync(
                    webhookUrl,
                    body,
                    Enum.HttpContentType.ApplicationJson
                )
            end)
        end
        Log.webhook(tostring(title or "event"), ok)
    end
end

end)
__bundle_register("Utility/Helpers/Move", function(require, _LOADED, __bundle_register, __bundle_modules)
-- move helper: walks to a point on a player api trip, which holds its own noclip and refuses while anything else owns the character; returns a stop that is safe to call at any time, plus the reason when no trip started
local Api = require("Api")

local function idle() end

return function(_, Helpers)
    function Helpers.MoveToPos(targetPos, studsPerSecond, dynamicTargetFunc)
        local Player = Api.get("Player")
        if not Player then return idle end
        if type(studsPerSecond) ~= "function" then
            studsPerSecond = tonumber(studsPerSecond) or 0
            if studsPerSecond <= 0 then return idle end
        end
        local target = type(dynamicTargetFunc) == "function" and dynamicTargetFunc or targetPos
        local trip, err = Player.moveTo(target, studsPerSecond)
        if not trip then return idle, err end
        return trip.Cancel
    end
end

end)
__bundle_register("Utility/Helpers/Noclip", function(require, _LOADED, __bundle_register, __bundle_modules)
-- noclip helper: one player api token behind the start and stop counts the helpers have always offered; resolved at call time because helpers are built before the apis, and respawns are the token's own business
local Api = require("Api")

return function(_, Helpers)
    local count = 0
    local release

    function Helpers.startNoclip()
        if not release then
            local Player = Api.get("Player")
            local restore = Player and Player.setNoclip(true)
            if not restore then return false end
            release = restore
        end
        count = count + 1
        return true
    end

    function Helpers.stopNoclip()
        if count == 0 then return end
        count = count - 1
        if count > 0 then return end
        local restore = release
        release = nil
        restore()
    end
end

end)
__bundle_register("Utility/BuildStamp", function(require, _LOADED, __bundle_register, __bundle_modules)
-- build age: turns Meta.builtAt (stamped by build.sh) into the phrase the boot notification reads, "last updated 3 hours ago"

local Meta = require("Meta")

local MINUTE = 60
local HOUR   = 60 * MINUTE
local DAY    = 24 * HOUR
local WEEK   = 7 * DAY

local M = {}

local function count(n, unit)
    n = math.floor(n)
    return ("%d %s%s"):format(n, unit, n == 1 and "" or "s")
end

-- builtAt is unix seconds and the real answer; the date-only `updated` is the fallback for a
-- bundle built before the stamp existed, and noon keeps that guess inside a day of the truth
local function stampedAt()
    local epoch = tonumber(Meta.builtAt)
    if epoch and epoch > 0 then return epoch end

    local y, m, d = tostring(Meta.updated or ""):match("^(%d%d%d%d)%-(%d%d)%-(%d%d)$")
    if not y then return nil end
    local ok, guess = pcall(os.time, { year = tonumber(y), month = tonumber(m), day = tonumber(d), hour = 12 })
    return ok and guess or nil
end

-- how long ago this build was made, in plain english. weeks is the largest unit on purpose:
-- past that the number is the point, not the calendar. a clock skewed ahead reads as "just now"
function M.relative(now)
    local at = stampedAt()
    if not at then return nil end

    local delta = (now or os.time()) - at
    if delta < 0      then delta = 0 end
    if delta < MINUTE then return "just now" end
    if delta < HOUR   then return count(delta / MINUTE, "minute") .. " ago" end
    if delta < DAY    then return count(delta / HOUR,   "hour")   .. " ago" end
    if delta < WEEK   then return count(delta / DAY,    "day")    .. " ago" end
    return count(delta / WEEK, "week") .. " ago"
end

-- the boot line itself; with no stamp to work from it degrades to whatever date Meta carries
function M.describe()
    local rel = M.relative()
    if rel then return "Last updated " .. rel end
    return "Last updated " .. tostring(Meta.updated or "unknown")
end

return M

end)
end
