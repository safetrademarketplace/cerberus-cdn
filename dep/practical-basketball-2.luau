        groups = {
            playerGroup(Court, "Teammates", ALLY, Court.teammates),
            playerGroup(Court, "Opponents", ENEMY, Court.opponents),
            ballGroup(Court),
            playerGroup(Court, "Bench", BENCH, Court.bench),
            hoopGroup(Court),
        },
        origin = function()
            return Player and Player.position() or nil
        end,
    }
end

