        ready      = function() return load() ~= nil end,
        row        = row,
        rows       = rows,
        path       = path,
        keys       = keys,
        snapshot   = snapshot,
        needsApply = needsApply,
        encode     = encode,
        labelOf    = labelOf,
    }
end

return M

