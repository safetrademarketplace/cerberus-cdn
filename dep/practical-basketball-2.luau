        follows[ball] = nil
        if samplerTask and next(follows) == nil then
            armed[samplerTask] = nil
            samplerTask = nil
        end
        if text then say(text) end
    end

    local function flatTo(x, z, at)
        local dx, dz = x - at.X, z - at.Z
        return math.sqrt(dx * dx + dz * dz)
    end

    -- nil means the hoop has no say this frame; otherwise the words for why we are waiting
    local function rimVerdict(follow, position)
        local hoop = court.nearestHoop(position)
        local goal = hoop and hoop.goal
        if not goal then return nil end
        local at = goal.Position
        local rimHeight = at.Y + RIM_RISE
        local flight = follow.flight
        local untilRim, rimX, rimZ = flight:crossing(rimHeight)
        if untilRim then
            local zone = flight:legs() == 0 and BOARD_ZONE or RIM_ZONE
            if flatTo(rimX, rimZ, at) <= zone then return "Waiting on the rim" end
            return nil
        end
        if position.Y < rimHeight and Flat(position, at) <= THROUGH_RIM then return "went in" end
        return nil
    end

    local function stepBall(ball, follow, now)
        if not ball.Parent then return finish(ball) end
        if not follow.clearedAt and not court.ballInFlight(ball) then follow.clearedAt = now end
        if now - follow.startedAt > MAX_FOLLOW or (follow.clearedAt and now - follow.clearedAt > AFTER_CLEAR) then
            return finish(ball)
        end

        local flight = follow.flight
        local position = ball.Position
        flight:add(now, position)

        local mine = player.position()
        if not mine then return end
        local height = mine.Y + follow.reachAbove + JUMP_LIFT
        local untilReach, x, z = flight:crossing(height)
        if not untilReach then
            if flight:fellPast(height) then return finish(ball, "Landed away from you") end
            return
        end
        -- the ball we see is this old and our press is half a round trip from landing, on top of the jump itself
        local halfTrip = Kit.ping(me) / 2
        if untilReach > Jumper.RISE + math.max(BALL_BEHIND, halfTrip) + halfTrip then
            return say("Shot in the air")
        end

        local verdict = rimVerdict(follow, position)
        if verdict == "went in" then return finish(ball, "Shot went in") end
        if verdict then return say(verdict) end

        local away = flatTo(x, z, mine)
        if away > reach then return say(("Coming down %s away"):format(Kit.studs(away))) end

        local jumped, why = jumper.go()
        if jumped then
            jumpedAt[ball] = now
            finish(ball, "Jumped for the rebound")
        else
            say(why)
        end
    end

    local function sample()
        local now = os.clock()
        for ball, follow in pairs(follows) do stepBall(ball, follow, now) end
    end

    -- one jump per shot: a shot only ends when someone has the ball, so the flag rising again before that is still this one
    local function followShot(ball)
        if follows[ball] then return end
        local now = os.clock()
        if jumpedAt[ball] and now - jumpedAt[ball] < MAX_FOLLOW then return end
        follows[ball] = {
            flight     = Flight.new(Workspace.Gravity),
            startedAt  = now,
            reachAbove = standingReach(),
        }
        if not samplerTask then
            samplerTask = armed:GiveTask(Scheduler.heartbeat(sample, { name = "AutoRebound" }))
        end
    end

    -- the shooter letting go arrives here too, as a nil holder, so only a new holder ends the chase
    local function onPossession(holder, _, ball)
        if not holder then return end
        jumpedAt[ball] = nil
        if follows[ball] then finish(ball, "Someone got the ball") end
    end

    local function setActive(on)
        if on == active then return end
        active = on
        armed:DoCleaning()
        samplerTask = nil
        table.clear(follows)
        table.clear(jumpedAt)
        if on then
            armed:GiveTask(court.ShotInAir:Connect(followShot))
            armed:GiveTask(court.PossessionChanged:Connect(onPossession))
            say("Watching for a shot", true)
            local balls = court.balls()
            for i = 1, #balls do
                if court.ballInFlight(balls[i]) then followShot(balls[i]) end
            end
        else
            say("Off", true)
        end
    end

    Toggles.AutoReboundEnabled:OnChanged(setActive)
end

end)
__bundle_register("Features/Basketball/Defense/Flight", function(require, _LOADED, __bundle_register, __bundle_modules)
-- defense flight: where a shot ball comes down, from where it has been; each leg of a shot is a plain throw under workspace gravity (Config.Game.Basketball ApplyVelocity), so a measured speed settles the rest, and a touch on the rim or a hand starts a new leg, which shows as a jump in that speed; a ball out of camera view only moves five times a second (PlayerScripts.Basketballs), so only real movement counts as a sample
local WINDOW    = 0.24  -- seconds of the current leg the fit looks back over
local RECENT    = 0.05  -- the newest slice of it, held against the rest to spot a new leg
local LEG_BREAK = 12    -- studs per second of change beyond gravity that cannot be the same throw
local MIN_SPAN  = 0.05  -- over less time than this a speed reading is mostly noise
local MIN_SPEED = 2     -- a ball slower than this is resting somewhere, not falling
local STALE_AFTER = 0.3 -- this long without moving and it has stopped; out of view it still moves every 0.2
local MIN_GRAVITY = 1
local LAUNCH_GRACE = 0.25  -- leaving the hands is a jump in speed too, and it is not a touch

local Flight = {}
Flight.__index = Flight

function Flight.new(gravity)
    return setmetatable({
        gravity = math.max(gravity, MIN_GRAVITY),
        times = {}, xs = {}, ys = {}, zs = {},
        first = 1, last = 0,
        now = 0,
        legCount = 0,
    }, Flight)
end

-- anything measured so far stops counting, as when the ball is pinned in place
function Flight:reset()
    self.first = self.last + 1
end

function Flight:legs()
    return self.legCount
end

function Flight:splitLegs()
    local times, xs, ys, zs = self.times, self.xs, self.ys, self.zs
    local first, last = self.first, self.last
    local newest = times[last]

    local split = last
    while split > first and newest - times[split - 1] <= RECENT do split = split - 1 end
    if split <= first or split == last then return end

    local oldSpan, newSpan = times[split] - times[first], newest - times[split]
    if oldSpan <= 0 or newSpan <= 0 then return end

    local dx = (xs[last] - xs[split]) / newSpan - (xs[split] - xs[first]) / oldSpan
    local dz = (zs[last] - zs[split]) / newSpan - (zs[split] - zs[first]) / oldSpan
    -- the two averages sit half the window apart, and gravity alone explains that much of a change in height
    local dy = (ys[last] - ys[split]) / newSpan - (ys[split] - ys[first]) / oldSpan
        + self.gravity * (newest - times[first]) / 2

    if dx * dx + dy * dy + dz * dz > LEG_BREAK * LEG_BREAK then
        self.first = split
        if newest - times[1] > LAUNCH_GRACE then self.legCount = self.legCount + 1 end
    end
end

function Flight:add(now, position)
    self.now = now
    local x, y, z = position.X, position.Y, position.Z
    local newest = self.last
    if newest >= self.first and x == self.xs[newest] and y == self.ys[newest] and z == self.zs[newest] then return end

    local last = newest + 1
    self.last = last
    local times = self.times
    times[last], self.xs[last], self.ys[last], self.zs[last] = now, x, y, z

    local first = self.first
    while first < last and now - times[first] > WINDOW do first = first + 1 end
    self.first = first
    self:splitLegs()
end

-- position and speed at the newest sample; an average speed is the true speed at the middle of its span, so height gets half a span of gravity taken off
function Flight:state()
    local first, last = self.first, self.last
    if last < first then return nil end
    local times, xs, ys, zs = self.times, self.xs, self.ys, self.zs
    local span = times[last] - times[first]
    if span < MIN_SPAN or self.now - times[last] > STALE_AFTER then return nil end
    return xs[last], ys[last], zs[last],
        (xs[last] - xs[first]) / span,
        (ys[last] - ys[first]) / span - self.gravity * span / 2,
        (zs[last] - zs[first]) / span
end

-- seconds until the ball next passes down through this height and where it is then, or nil if it is not on the way there
function Flight:crossing(height)
    local x, y, z, vx, vy, vz = self:state()
    if not x then return nil end
    if vx * vx + vy * vy + vz * vz < MIN_SPEED * MIN_SPEED then return nil end
    local gravity = self.gravity
    local under = vy * vy + 2 * gravity * (y - height)
    if under < 0 then return nil end
    local seconds = (vy + math.sqrt(under)) / gravity
    if seconds < self.now - self.times[self.last] then return nil end
    return seconds - (self.now - self.times[self.last]), x + vx * seconds, z + vz * seconds
end

function Flight:fellPast(height)
    local x, y, _, _, vy = self:state()
    return x ~= nil and y < height and vy < 0
end

return Flight

end)
