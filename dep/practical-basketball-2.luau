                    or  '<font color="#fca5a5">Needs a key</font>  <font color="#9ca3af">getcerberus.com</font>',
                DoesWrap = true,
            })
        end
    end

    -- connectivity lives in its own module; mounted here so it sits below the changelog
    pcall(Connectivity, ctx)

    do
        local creditsGroup = Tabs.Home:AddRightGroupbox("Credits + Disclaimer", "shield-alert")
        creditsGroup:AddLabel('<b>Script</b>  @tevilii')
        creditsGroup:AddLabel('<b>UI Library</b>  Obsidian by deivid')

        local urls = META.urls or {}
        if Helpers.copyLink and urls.obsidian then
            creditsGroup:AddButton({
                Text = "Obsidian Library",
