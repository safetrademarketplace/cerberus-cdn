    JumpGroup:AddToggle("JumpPower", {
        Text = "Jump Power",
        Default = false,
    })

    local JumpPowerBox = JumpGroup:AddDependencyBox()

    JumpPowerBox:AddSlider("JumpHeight", {
        Text = "Jump Height",
        Default = DEFAULT_HEIGHT,
        Min = 5,
        Max = 200,
        Rounding = 1,
        Suffix = " studs"
    })

    JumpPowerBox:SetupDependencies({
        { Toggles.JumpPower, true },
    })

    JumpGroup:AddToggle("InfiniteJump", {
        Text = "Infinite Jump",
        Default = false,
    })

    local currentJumpHeight = Options.JumpHeight.Value
    local heightOn, infiniteOn = false, false
    local cancelHop
    local lastHop = -math.huge

    local function stopHop()
        if cancelHop then cancelHop() end
        cancelHop = nil
    end

    -- a refused hop means flying or on a trip, where the jump key has nothing to add
    local function hop()
        if not (heightOn or infiniteOn) or Input:GetFocusedTextBox() then return end
        local now = os.clock()
        if now - lastHop < RELAUNCH_COOLDOWN then return end
        if not infiniteOn and Player.inAir() then return end
        local cancel = Player.hop(heightOn and currentJumpHeight or DEFAULT_HEIGHT)
        if cancel then lastHop, cancelHop = now, cancel end
    end

    -- no game script reads JumpRequest, so the space bar backs it up and the cooldown makes the pair one hop
    track(Input.JumpRequest:Connect(hop))
    track(Input.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.KeyCode == Enum.KeyCode.Space then hop() end
    end))

    local function startJumpMod() heightOn = true end

    local function stopJumpMod()
        heightOn = false
        if not infiniteOn then stopHop() end
    end

    local function startInfiniteJump() infiniteOn = true end

    local function stopInfiniteJump()
        infiniteOn = false
        if not heightOn then stopHop() end
    end

    Toggles.JumpPower:OnChanged(function()
        if Toggles.JumpPower.Value then startJumpMod() else stopJumpMod() end
    end)

    Options.JumpHeight:OnChanged(function()
        currentJumpHeight = Options.JumpHeight.Value
    end)

    Toggles.InfiniteJump:OnChanged(function()
        if Toggles.InfiniteJump.Value then startInfiniteJump() else stopInfiniteJump() end
    end)

    return {
        startJumpMod      = startJumpMod,
        stopJumpMod       = stopJumpMod,
        startInfiniteJump = startInfiniteJump,
        stopInfiniteJump  = stopInfiniteJump,
    }
end

end)
