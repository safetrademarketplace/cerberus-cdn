__bundle_register("Features/Visuals/Visuals/Freecam", function(require, _LOADED, __bundle_register, __bundle_modules)
-- freecam sub-module of visuals, cinematic (spring-smoothed) and functional styles
return function(ctx)
    local Services     = ctx.Services
    local References   = ctx.References
    local Library      = ctx.Library
    local Options      = ctx.Options
    local Toggles      = ctx.Toggles
    local track        = ctx.track
    local VisualsGroup = ctx.VisualsGroup

    VisualsGroup:AddToggle("FreecamEnabled", {
        Text = "Freecam",
        Default = false
    }):AddKeyPicker("FreecamKey", {
        Default = nil,
        SyncToggleState = true,
        Mode = "Toggle",
        Text = "Freecam Key"
    })

    local FreecamBox = VisualsGroup:AddDependencyBox()

    FreecamBox:AddDropdown("FreecamMode", {
        Text = "Type",
        Values = { "Cinematic", "Functional" },
        Default = 1,
        Multi = false
    })

    FreecamBox:AddSlider("FreecamSensitivity", {
        Text = "Sensitivity",
        Default = 1,
        Min = 0.1,
        Max = 3,
        Rounding = 2,
        Tooltip = "Look and move speed"
    })

    FreecamBox:SetupDependencies({
        { Toggles.FreecamEnabled, true },
    })

    local Camera = Services.Workspace.CurrentCamera
    track(Services.Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        Camera = Services.Workspace.CurrentCamera
    end))

    local pi, exp, rad, sqrt, tan, abs, clamp, sign =
        math.pi, math.exp, math.rad, math.sqrt, math.tan, math.abs, math.clamp, math.sign

    local PITCH_LIMIT = rad(89.9)
    local FREECAM_RENDERSTEP = "CerbFreecam"

    local Spring = {}
    Spring.__index = Spring

    function Spring.new(freq, pos)
        return setmetatable({
            f = freq,
            p = pos,
            v = pos * 0
        }, Spring)
    end

    function Spring:Update(dt, goal)
        local f = self.f * 2 * pi
        local p0, v0 = self.p, self.v
        local offset = goal - p0
        local decay = exp(-f * dt)
        local p1 = goal + (v0 * dt - offset * (f * dt + 1)) * decay
        local v1 = (f * dt * (offset * f - v0) + v0) * decay
        self.p, self.v = p1, v1
        return p1
    end

    function Spring:Reset(pos)
        self.p = pos
        self.v = pos * 0
    end

    local velSpring = Spring.new(1.5, Vector3.new())
    local panSpring = Spring.new(1.0, Vector2.new())
    local fovSpring = Spring.new(4.0, 0)

    local cameraPos = Vector3.zero
    local cameraRot = Vector2.zero
    local cameraFov = 70
    local navSpeed = 1
    local freecamOn = false
    local restoringToggle = false

    local inputBindNames = {
        KB = "CerbFC_Keyboard",
        MousePan = "CerbFC_MousePan",
        Wheel = "CerbFC_MouseWheel",
        GPBtn = "CerbFC_GPBtn",
        GPTrig = "CerbFC_GPTrig",
        GPThumb = "CerbFC_GPThumb",
        TouchPan = "CerbFC_TouchPan",
    }

    local gamepad = {
        ButtonX = 0,
        ButtonY = 0,
        ButtonL2 = 0,
        ButtonR2 = 0,
        Thumbstick1 = Vector2.zero,
        Thumbstick2 = Vector2.zero
    }

    local keyboard = {
        W = 0, A = 0, S = 0, D = 0,
        E = 0, Q = 0,
        U = 0, H = 0, J = 0, K = 0, I = 0, Y = 0,
        Up = 0, Down = 0
    }

    local mouse = {
        Delta = Vector2.zero,
        MouseWheel = 0
    }

    local touch = {
        PanDelta = Vector2.zero,
        VerticalPanDelta = Vector2.zero,
        PinchDelta = 1.0,
        ActiveTouches = {}
    }

    local touchPinchConn
    local jumpConn
    local characterAddedConn
    local healthConn

    local hudCache = {}
    local humRef
    local humJumpState
    local lastHealth

    local savedState = {
        CameraType = nil,
        CameraSubject = nil,
        FieldOfView = nil,
        MouseBehavior = nil,
        MouseIconEnabled = nil
    }

    local function getFreecamMode()
        local modeOpt = Options.FreecamMode
        local value = modeOpt and modeOpt.Value or "Cinematic"
        if value ~= "Functional" then
            return "Cinematic"
        end
        return "Functional"
    end

    local function isCinematic()
        return getFreecamMode() == "Cinematic"
    end

    local function thumbstickCurve(x)
        local K_CURVATURE = 2.0
        local K_DEADZONE = 0.15

        local function fCurve(v)
            return (exp(K_CURVATURE * v) - 1) / (exp(K_CURVATURE) - 1)
        end

        local function fDeadzone(v)
            return fCurve((v - K_DEADZONE) / (1 - K_DEADZONE))
        end

        return sign(x) * clamp(fDeadzone(abs(x)), 0, 1)
    end

    local function resetInputState()
        navSpeed = 1

        for k, v in pairs(gamepad) do
            gamepad[k] = typeof(v) == "Vector2" and Vector2.zero or 0
        end

        for k in pairs(keyboard) do
            keyboard[k] = 0
        end

        mouse.Delta = Vector2.zero
        mouse.MouseWheel = 0

        touch.PanDelta = Vector2.zero
        touch.VerticalPanDelta = Vector2.zero
        touch.PinchDelta = 1.0
        table.clear(touch.ActiveTouches)
    end

    local function unbindInputs()
        for _, bindName in pairs(inputBindNames) do
            Services.ContextActionService:UnbindAction(bindName)
        end

        if touchPinchConn then
            touchPinchConn:Disconnect()
            touchPinchConn = nil
        end

        resetInputState()
    end

    -- all freecam binds share the same priority/no-touch-button/sink shape; only name, handler, and keys differ
    local function bindAction(name, handler, ...)
        Services.ContextActionService:BindActionAtPriority(
            name,
            function(_, state, input)
                handler(state, input)
                return Enum.ContextActionResult.Sink
            end,
            false,
            Enum.ContextActionPriority.High.Value,
            ...
        )
    end

    -- maps input.KeyCode.Name into a target table; valueFn picks digital/scalar/Vector2 per input kind
    local function keyMapHandler(target, valueFn)
        return function(state, input)
            local keyName = input.KeyCode.Name
            if target[keyName] ~= nil then
                target[keyName] = valueFn(state, input)
            end
        end
    end

    local function digitalKeyValue(state)
        return (state == Enum.UserInputState.Begin) and 1 or 0
    end

    local function bindInputs()
        bindAction(
            inputBindNames.KB,
            keyMapHandler(keyboard, digitalKeyValue),
            Enum.KeyCode.W, Enum.KeyCode.U,
            Enum.KeyCode.A, Enum.KeyCode.H,
            Enum.KeyCode.S, Enum.KeyCode.J,
            Enum.KeyCode.D, Enum.KeyCode.K,
            Enum.KeyCode.E, Enum.KeyCode.I,
            Enum.KeyCode.Q, Enum.KeyCode.Y,
            Enum.KeyCode.Up, Enum.KeyCode.Down
        )

        bindAction(inputBindNames.MousePan, function(_, input)
            local d = input.Delta
            mouse.Delta = Vector2.new(-d.Y, -d.X)
        end, Enum.UserInputType.MouseMovement)

        bindAction(inputBindNames.Wheel, function(_, input)
            mouse.MouseWheel = -input.Position.Z
        end, Enum.UserInputType.MouseWheel)

        bindAction(inputBindNames.TouchPan, function(state, input)
            if state == Enum.UserInputState.Begin then
                touch.ActiveTouches[input] = true
            elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
                touch.ActiveTouches[input] = nil
            elseif state == Enum.UserInputState.Change then
                local touchCount = 0
                for _ in pairs(touch.ActiveTouches) do
                    touchCount = touchCount + 1
                end

                local d = input.Delta
                if touchCount == 1 then
                    touch.PanDelta = touch.PanDelta + Vector2.new(-d.Y, -d.X)
                elseif touchCount >= 2 then
                    touch.VerticalPanDelta = touch.VerticalPanDelta + d
                end
            end
        end, Enum.UserInputType.Touch)

        if Services.UserInputService and Services.UserInputService.TouchPinch then
            touchPinchConn = Services.UserInputService.TouchPinch:Connect(function(_, scale, _, state)
                if state == Enum.UserInputState.Change then
                    touch.PinchDelta = scale
                end
            end)
        end

        bindAction(
            inputBindNames.GPBtn,
            keyMapHandler(gamepad, digitalKeyValue),
            Enum.KeyCode.ButtonX,
            Enum.KeyCode.ButtonY
        )

        bindAction(
            inputBindNames.GPTrig,
            keyMapHandler(gamepad, function(_, input) return input.Position.Z end),
            Enum.KeyCode.ButtonR2,
            Enum.KeyCode.ButtonL2
        )

        bindAction(
            inputBindNames.GPThumb,
            keyMapHandler(gamepad, function(_, input) return input.Position end),
            Enum.KeyCode.Thumbstick1,
            Enum.KeyCode.Thumbstick2
        )
    end

    local function pushGuiState()
        if not isCinematic() then
            return
        end

        local playerGui = References.player and References.player:FindFirstChildOfClass("PlayerGui")
        hudCache.screens = {}

        if not playerGui then
            return
        end

        for _, gui in ipairs(playerGui:GetChildren()) do
            if gui:IsA("ScreenGui")
                and gui.Enabled
                and gui.Name ~= "TouchGui"
                and gui.Name ~= "DynamicThumbstick" then
                table.insert(hudCache.screens, gui)
                gui.Enabled = false
            end
        end
    end

    local function popGuiState()
        if hudCache.screens then
            for _, gui in ipairs(hudCache.screens) do
                if gui and gui.Parent then
                    gui.Enabled = true
                end
            end
        end

        hudCache = {}
    end

    local function disableJumpForHumanoid(humanoid)
        if not humanoid then
            return
        end

        humRef = humanoid

        if humRef.SetStateEnabled then
            humJumpState = humRef:GetStateEnabled(Enum.HumanoidStateType.Jumping)
            humRef:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
        end

        if jumpConn then
            jumpConn:Disconnect()
            jumpConn = nil
        end

        if Services.UserInputService and Services.UserInputService.JumpRequest then
            jumpConn = Services.UserInputService.JumpRequest:Connect(function()
                if humRef then
                    humRef.Jump = false
                end
            end)
        end
    end

    local function restoreJump()
        if jumpConn then
            jumpConn:Disconnect()
            jumpConn = nil
        end

        if humRef and humRef.SetStateEnabled then
            humRef:SetStateEnabled(Enum.HumanoidStateType.Jumping, humJumpState ~= false)
        end

        humRef = nil
        humJumpState = nil
    end

    local function forceDisableFromDamage()
        if not freecamOn then
            return
        end

        if restoringToggle then
            return
        end

        restoringToggle = true
        Library:Notify("Freecam off: you took damage", 2)
        Toggles.FreecamEnabled:SetValue(false)
        restoringToggle = false
    end

    local function bindDamageWatcher(humanoid)
        if healthConn then
            healthConn:Disconnect()
            healthConn = nil
        end

        lastHealth = nil

        if not humanoid then
            return
        end

        lastHealth = humanoid.Health

        healthConn = humanoid.HealthChanged:Connect(function(newHealth)
            if freecamOn and lastHealth and newHealth < lastHealth - 0.001 then
                forceDisableFromDamage()
            end
            lastHealth = newHealth
        end)
    end

    local function handleCharacterAdded(character)
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not humanoid then
            humanoid = References.humanoid
        end

        bindDamageWatcher(humanoid)

        if freecamOn then
            disableJumpForHumanoid(humanoid)
        end
    end

    local function bindCharacterWatcher()
        if characterAddedConn then
            characterAddedConn:Disconnect()
            characterAddedConn = nil
        end

        if References.player then
            characterAddedConn = References.player.CharacterAdded:Connect(function(character)
                handleCharacterAdded(character)
            end)
        end

        handleCharacterAdded(References.character)
    end

    local function velInput(dt, sens)
        navSpeed = clamp(navSpeed + dt * (keyboard.Up - keyboard.Down) * 0.75, 0.01, 4)

        local gamepadVec = Vector3.new(
            thumbstickCurve(gamepad.Thumbstick1.X),
            thumbstickCurve(gamepad.ButtonR2) - thumbstickCurve(gamepad.ButtonL2),
            thumbstickCurve(-gamepad.Thumbstick1.Y)
        )

        local keyboardVec = Vector3.new(
            keyboard.D - keyboard.A + keyboard.K - keyboard.H,
            keyboard.E - keyboard.Q + keyboard.I - keyboard.Y - (touch.VerticalPanDelta.Y * 0.1),
            keyboard.S - keyboard.W + keyboard.J - keyboard.U
        )

        touch.VerticalPanDelta = Vector2.zero

        local shiftHeld =
            Services.UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
            or Services.UserInputService:IsKeyDown(Enum.KeyCode.RightShift)

        local speedMultiplier = 64 * navSpeed * (shiftHeld and 0.25 or 1) * sens

        return (gamepadVec + keyboardVec) * speedMultiplier
    end

    local function panInput(sens)
        local gp = Vector2.new(
            thumbstickCurve(gamepad.Thumbstick2.Y),
            thumbstickCurve(-gamepad.Thumbstick2.X)
        ) * (pi / 8)

        local km = (mouse.Delta + touch.PanDelta) * (pi / 64)

        mouse.Delta = Vector2.zero
        touch.PanDelta = Vector2.zero

        return (gp + km) * (8 * sens)
    end

    local function fovInput()
        local gp = (gamepad.ButtonX - gamepad.ButtonY) * 0.25
        local mw = mouse.MouseWheel
        local pinch = (touch.PinchDelta - 1.0) * -5.0

        mouse.MouseWheel = 0
        touch.PinchDelta = 1.0

        return gp + mw + pinch
    end

    local function stepCinematic(dt)
        local sens = (Options.FreecamSensitivity and Options.FreecamSensitivity.Value) or 1

        local vel = velSpring:Update(dt, velInput(dt, sens))
        local pan = panSpring:Update(dt, panInput(sens))
        local fov = fovSpring:Update(dt, fovInput())

        local zoomFactor = sqrt(tan(rad(70 / 2)) / tan(rad(cameraFov / 2)))
        cameraFov = clamp(cameraFov + fov * 300 * (dt / zoomFactor), 1, 120)
        cameraRot = cameraRot + pan * (dt / zoomFactor)
        cameraRot = Vector2.new(clamp(cameraRot.X, -PITCH_LIMIT, PITCH_LIMIT), cameraRot.Y % (2 * pi))

        local cf = CFrame.new(cameraPos)
            * CFrame.fromOrientation(cameraRot.X, cameraRot.Y, 0)
            * CFrame.new(vel * dt)

        cameraPos = cf.Position

        Camera.CFrame = cf
        Camera.Focus = cf
        Camera.FieldOfView = cameraFov
    end

    local function stepFunctional(dt)
        local sens = (Options.FreecamSensitivity and Options.FreecamSensitivity.Value) or 1

        local vel = velInput(dt, sens)
        local pan = panInput(sens)
        local fov = fovInput()

        cameraFov = clamp(cameraFov + (fov * 8), 1, 120)
        cameraRot = cameraRot + pan * dt
        cameraRot = Vector2.new(clamp(cameraRot.X, -PITCH_LIMIT, PITCH_LIMIT), cameraRot.Y % (2 * pi))

        local cf = CFrame.new(cameraPos)
            * CFrame.fromOrientation(cameraRot.X, cameraRot.Y, 0)
            * CFrame.new(vel * dt)

        cameraPos = cf.Position

        Camera.CFrame = cf
        Camera.Focus = cf
        Camera.FieldOfView = cameraFov
    end

    local function assertFreecamState()
        if not Camera then return end
        -- PlayerScripts CameraModule/MouseLockController revert these, so re-assert every frame
        if Camera.CameraType ~= Enum.CameraType.Scriptable then
            Camera.CameraType = Enum.CameraType.Scriptable
        end
        if Camera.CameraSubject ~= nil then
            Camera.CameraSubject = nil
        end
        pcall(function()
            if Services.UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
                Services.UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
            end
            if Services.UserInputService.MouseIconEnabled then
                Services.UserInputService.MouseIconEnabled = false
            end
        end)
    end

    local stepFreecam = function(dt)
        if not freecamOn or not Camera then
            return
        end

        assertFreecamState()

        if getFreecamMode() == "Functional" then
            stepFunctional(dt)
        else
            stepCinematic(dt)
        end
    end

    local function saveState()
        savedState.CameraType = Camera.CameraType
        savedState.CameraSubject = Camera.CameraSubject
        savedState.FieldOfView = Camera.FieldOfView
        savedState.MouseBehavior = Services.UserInputService.MouseBehavior
        savedState.MouseIconEnabled = Services.UserInputService.MouseIconEnabled
    end

    local function restoreState()
        if Camera then
            -- subject first so CameraModule has a valid target the moment it reactivates on the Scriptable→Custom flip
            Camera.CameraSubject = References.humanoid or savedState.CameraSubject
            Camera.CameraType = Enum.CameraType.Custom
            Camera.FieldOfView = savedState.FieldOfView or 70
        end

        -- force the mouse back unconditionally (savedState may say hidden if shift-lock hid it first) and repeat across frames to outrun CameraModule re-asserting its own mouse state
        local function forceMouseBack()
            pcall(function()
                Services.UserInputService.MouseBehavior = Enum.MouseBehavior.Default
                Services.UserInputService.MouseIconEnabled = true
            end)
        end
        forceMouseBack()
        task.defer(forceMouseBack)
        -- leak:allow — completes a teardown; cancelling it at unload would leave mouse behaviour freecam's
        task.delay(0.1, forceMouseBack)
        -- leak:allow — as above; the second pass catches a late camera-script rewrite
        task.delay(0.3, forceMouseBack)

        savedState.CameraType, savedState.CameraSubject = nil, nil
        savedState.FieldOfView = nil
        savedState.MouseBehavior, savedState.MouseIconEnabled = nil, nil
    end

    local function StartFreecam()
        -- re-resolve in case CurrentCamera flipped before our listener fired and the upvalue is a destroyed camera
        Camera = Services.Workspace.CurrentCamera
        if freecamOn or not Camera then
            return
        end

        saveState()

        -- snapshot pose before switching CameraType (Scriptable stops CFrame updates); roll is dropped so cameraRot stays pitch/yaw
        local cf = Camera.CFrame
        local pitch, yaw = cf:ToOrientation()
        cameraRot = Vector2.new(clamp(pitch, -PITCH_LIMIT, PITCH_LIMIT), yaw)
        cameraPos = cf.Position
        cameraFov = Camera.FieldOfView

        velSpring:Reset(Vector3.zero)
        panSpring:Reset(Vector2.zero)
        fovSpring:Reset(0)

        pushGuiState()
        disableJumpForHumanoid(References.humanoid)

        -- clear the follow target before flipping CameraType so PlayerScripts doesn't re-attach to the humanoid
        Camera.CameraSubject = nil
        Camera.CameraType = Enum.CameraType.Scriptable
        pcall(function()
            Services.UserInputService.MouseIconEnabled = false
            Services.UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
        end)

        bindInputs()
        -- scheduler:allow — must run at RenderPriority.Camera + 1, i.e. after roblox's own camera step; a render-lane task has no such ordering
        Services.RunService:BindToRenderStep(
            FREECAM_RENDERSTEP,
            Enum.RenderPriority.Camera.Value + 1,
            stepFreecam
        )

        freecamOn = true
    end

    local function StopFreecam()
        if not freecamOn then
            return
        end

        freecamOn = false

        -- re-resolve so restoreState writes to whichever camera is live now
        Camera = Services.Workspace.CurrentCamera

        Services.RunService:UnbindFromRenderStep(FREECAM_RENDERSTEP)
        unbindInputs()
        restoreJump()
        restoreState()
        popGuiState()
    end

    bindCharacterWatcher()

    Toggles.FreecamEnabled:OnChanged(function()
        if Toggles.FreecamEnabled.Value then
            StartFreecam()
        else
            StopFreecam()
        end
    end)

    return {
        cleanup = function()
            if healthConn then
                healthConn:Disconnect()
                healthConn = nil
            end

            if characterAddedConn then
                characterAddedConn:Disconnect()
                characterAddedConn = nil
            end

            StopFreecam()
        end
    }
end

end)
__bundle_register("Features/Visuals/Visuals/FOV", function(require, _LOADED, __bundle_register, __bundle_modules)
-- camera fov slider sub-module of visuals
return function(ctx)
    local References   = ctx.References
    local Options      = ctx.Options
    local VisualsGroup = ctx.VisualsGroup

    VisualsGroup:AddSlider("CameraFOV", {
        Text = "Camera FOV",
        Default = 70,
        Min = 40,
        Max = 120,
        Rounding = 0
    })

    local origFOV = References.camera and References.camera.FieldOfView or 70

    local function applyFOV()
