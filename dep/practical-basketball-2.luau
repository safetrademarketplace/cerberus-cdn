        if not isfile(stateFile) then return true end
        local okRead, raw = pcall(readfile, stateFile)
        if not okRead or type(raw) ~= "string" then return true end
        local okDecode, decoded = pcall(Services.HttpService.JSONDecode, Services.HttpService, raw)
        if not okDecode or type(decoded) ~= "table" then return true end
        if type(decoded.autoexecute) == "boolean" then return decoded.autoexecute end
        return true
