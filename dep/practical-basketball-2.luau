                            end
                            blip.Size = UDim2.fromOffset(blipSize, blipSize)
                            blip.Position = UDim2.fromOffset(cx + rx * invRange * radius, cy + rz * invRange * radius)
                            blip.BackgroundColor3 = rec.held and CARRIER or color
                            blip.Visible = true
                            seen[rec] = true
                        end
                    end
                end
            end

            -- a record with no root has gone back to the dummy pool for good, anyone else is just out of range
            for rec, blip in pairs(radar.blips) do
                if not seen[rec] then
                    if rec.root then
                        blip.Visible = false
                    else
                        blip:Destroy()
                        radar.blips[rec] = nil
                    end
                end
            end
        end, { name = "Radar", priority = 200, interval = TICK_SECONDS, deferrable = true }))

        radar._holder = holder
        radar._centerIcon = centerIcon
        radar.buildRings = buildRings
        radar.updateRings = updateRingLabels
    end

    RadarGroup:AddToggle("Radar_Enable", {
        Text = "Radar",
        Default = false,
        Callback = function(v) if v then createRadar() else destroyRadar() end end
    })

    local RadarBox = RadarGroup:AddDependencyBox()

    RadarBox:AddSlider("Radar_Range", {
        Text = "Range",
        Default = DEFAULT_RANGE,
        Min = MIN_RANGE,
        Max = MAX_RANGE,
        Rounding = 0,
        Suffix = " studs",
        Callback = function(v)
            radar.range = v
            if radar.gui and radar.updateRings then
                Identity.elevate()
                radar.updateRings()
            end
        end
    })

    RadarBox:AddSlider("Radar_Scale", {
        Text = "HUD Scale",
        Default = 100,
        Min = 50,
        Max = 200,
        Rounding = 0,
        Suffix = "%",
        Callback = function(v)
            radar.scale = v / 100
            if radar.gui and radar._holder then
                Identity.elevate()
                local h = radar._holder
                h.Size = UDim2.fromOffset(200 * radar.scale, 200 * radar.scale)
                if radar._centerIcon then
                    radar._centerIcon.Size = UDim2.fromOffset(22 * radar.scale, 22 * radar.scale)
                end
                for _, r in ipairs(radar.rings) do
                    r.Label.TextSize = 10 * radar.scale
                    r.Label.Position = UDim2.new(0.5, 0, 1, 2 * radar.scale)
                end
            end
        end
    })

    RadarBox:AddDropdown("Radar_Mode", {
        Text = "Rotation Mode",
        Values = { "Camera", "North" },
        Default = "Camera",
        Callback = function(v) radar.mode = v end
    })

    RadarBox:SetupDependencies({
        { Toggles.Radar_Enable, true },
    })

    return { cleanup = destroyRadar }
end

end)
__bundle_register("Utility/Helpers/VMath", function(require, _LOADED, __bundle_register, __bundle_modules)
-- squared-distance helpers; the hottest per-entity-per-frame math across esp/aimbot/instakill, native-speed in the unobfuscated half

local M = {}

M.distanceSqr3 = function(a, b)
    local dx = a.X - b.X
    local dy = a.Y - b.Y
    local dz = a.Z - b.Z
    return dx * dx + dy * dy + dz * dz
end

M.distanceSqr2 = function(a, b)
    local dx = a.X - b.X
    local dz = a.Z - b.Z
    return dx * dx + dz * dz
end

return M

end)
__bundle_register("Features/Player/Utils", function(require, _LOADED, __bundle_register, __bundle_modules)
-- utils orchestrator: wires the player utility sub-modules that apply to this game
local Mount            = require("Utility/Mount")
local NoClip           = require("Features/Player/Utils/NoClip")
local Zoom             = require("Features/Player/Utils/Zoom")
local PerformanceMode  = require("Features/Player/Utils/PerformanceMode")
local ModSafety        = require("Features/Player/Utils/ModSafety")
local AutoRejoin       = require("Features/Player/Utils/AutoRejoin")
local AntiAFK          = require("Features/Player/Utils/AntiAFK")
local AntiKick         = require("Features/Player/Utils/AntiKick")
local FPSCap           = require("Features/Player/Utils/FPSCap")

return function(ctx)
    local O = Mount.orchestrator(ctx, "Utils")
    if not O then return end

    local UtilsGroup = ctx.Tabs.Player:AddRightGroupbox("Utils", "lightbulb")
    local subCtx = O.subCtx({
        UtilsGroup  = UtilsGroup,
        startNoclip = ctx.startNoclip,
        stopNoclip  = ctx.stopNoclip,
