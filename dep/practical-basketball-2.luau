        addMetric("framems", "Frame Time")
        addMetric("ping", "Ping")
        addMetric("luamem", "Lua Memory")
        addMetric("totalmem", "Total Memory")
        addMetric("cerbcost", "Cerberus Cost (est.)")
        addMetric("loops", "Active Loops")

        addSection("Network")
        addMetric("netin", "Data Receive")
        addMetric("netout", "Data Send")

