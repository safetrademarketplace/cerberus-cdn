-- shooting release: the shot api has one auto release switch and two features that want it, so each holds a named claim and the switch stays on until the last claim goes
local M = {}

function M.new(Shot)
    local claims = {}

    local function settle()
        local on = next(claims) ~= nil
        if on ~= Shot.autoRelease() then Shot.setAutoRelease(on) end
    end

