            local from = cam.Types[cam.ActiveMode]
            if from and from.Switch then from:Switch(false) end
            cam.ActiveMode = name
            local to = cam.Types[name]
            if to and to.Switch then to:Switch(true) end
        end)
        Identity.elevate()
    end

    local liveBinding = {
        key     = "camera:view",
        live    = false,
        touched = noop,
        read    = function()
            local cam = camera()
            return cam and cam.ActiveMode or nil
