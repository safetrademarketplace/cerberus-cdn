return function(ctx)
    local Services   = ctx.Services
    local UtilsGroup = ctx.UtilsGroup

    local toggleConn = nil

    local function startAntiAFK()
        if toggleConn then return end
        local localPlayer = Services.Players.LocalPlayer
        if not localPlayer then return end

        toggleConn = localPlayer.Idled:Connect(function()
            Services.VirtualUser:CaptureController()
            Services.VirtualUser:ClickButton2(Vector2.new())
        end)
    end

    local function stopAntiAFK()
        if toggleConn then
            toggleConn:Disconnect()
            toggleConn = nil
        end
    end

    local afkToggle = UtilsGroup:AddToggle("AntiAFK_Toggle", {
        Text = "Anti-AFK",
        Default = true,
        Callback = function(enabled)
            if enabled then
                startAntiAFK()
            else
                stopAntiAFK()
            end
        end
