function M.new(ctx)
    local base    = Api.define("Player", ctx)
    local tracker = Tracker.new(base, ctx)
    local attrs   = Attributes.new(base, tracker)
    local profile = Profile.new(base, ctx, tracker, attrs)
    local levers  = Levers.new(base, ctx, tracker, attrs)
    local arbiter = Arbiter.new(base)
    local travel  = Travel.new(base, ctx, tracker, arbiter, levers)

