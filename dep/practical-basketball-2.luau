__bundle_register("Features/Visuals/Visuals/Radar", function(require, _LOADED, __bundle_register, __bundle_modules)
-- radar sub-module of visuals: minimap of the court's players under the esp tab, plotted from court records because Player.Character is always nil here and centred on the player api's position; blips are pooled per record and die with it
local Identity  = require("Utility/Identity")
local Scheduler = require("Utility/Scheduler")
local VMath     = require("Utility/Helpers/VMath")
local UiHost    = require("UI/UiHost")

-- a court and not a map: the three point line is about 34 studs from the rim, so this covers one end to the other
local DEFAULT_RANGE = 120
local MIN_RANGE, MAX_RANGE = 30, 500
local TICK_SECONDS = 1 / 30

local ALLY    = Color3.fromRGB(55, 235, 120)
local ENEMY   = Color3.fromRGB(235, 55, 55)
local BENCH   = Color3.fromRGB(150, 150, 150)
local CARRIER = Color3.fromRGB(255, 215, 60)

return function(ctx)
    local Api = ctx.Api
    local Court, Player = Api and Api.Court, Api and Api.Player
    if not (Court and Player) then return {} end

    local Services = ctx.Services
    local Tabs     = ctx.Tabs
    local Toggles  = ctx.Toggles
    local track    = ctx.track

    local RadarGroup = Tabs.ESP:AddRightGroupbox("Mini Radar", "map")

    local sides = {
        { list = Court.teammates, color = ALLY },
        { list = Court.opponents, color = ENEMY },
        { list = Court.bench, color = BENCH },
    }

    local radar = {
        gui = nil,
        conn = nil,
        range = DEFAULT_RANGE,
        scale = 1,
        mode = "Camera",
        rings = {},
        blips = {},  -- [record] = Frame, pooled, never re-created per frame
        _holder = nil,
        _centerIcon = nil,
        buildRings = nil,
        updateRings = nil,
    }

    local function destroyRadar()
        if radar.conn then
            radar.conn:Disconnect(); radar.conn = nil
        end
        if radar.gui then
            radar.gui:Destroy(); radar.gui = nil
        end
        radar.rings = {}
        radar.blips = {}
        radar._holder, radar._centerIcon = nil, nil
    end

    local function createRadar()
        Identity.elevate()
        destroyRadar()
        local parent = UiHost.pick()
        local sg = Instance.new("ScreenGui")
        sg.Name = "Radar"
        sg.ResetOnSpawn = false
        sg.IgnoreGuiInset = true
        sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        sg.Parent = parent
        radar.gui = sg

        local holder = Instance.new("Frame")
        holder.Name = "Holder"
        holder.AnchorPoint = Vector2.new(1, 1)
        holder.Position = UDim2.new(1, -20, 1, -20)
        holder.Size = UDim2.fromOffset(200 * radar.scale, 200 * radar.scale)
        holder.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        holder.BackgroundTransparency = 0.2
        holder.Active = true
        holder.ClipsDescendants = false
        holder.Parent = sg

        local corner = Instance.new("UICorner", holder)
        corner.CornerRadius = UDim.new(1, 0)
        local stroke = Instance.new("UIStroke", holder)
        stroke.Thickness = 2
        stroke.Color = Color3.fromRGB(92, 94, 104)
        stroke.Transparency = 0.3

        local centerIcon = Instance.new("ImageLabel")
        centerIcon.BackgroundTransparency = 1
        centerIcon.Image = "rbxassetid://136497541793809"
        centerIcon.ImageColor3 = ALLY
        centerIcon.AnchorPoint = Vector2.new(0.5, 0.5)
        centerIcon.Position = UDim2.fromScale(0.5, 0.5)
        centerIcon.Size = UDim2.fromOffset(22 * radar.scale, 22 * radar.scale)
        centerIcon.Parent = holder

        local function buildRings()
