end)
__bundle_register("Api/Court/Hoops", function(require, _LOADED, __bundle_register, __bundle_modules)
-- court hoops: every hoop in workspace.Hoops or loose at the workspace root, and the geometry the game grades against; a three is flat distance past the ThreePoint zone on the line from the rim, the GameUtil.CheckInsideArc test with its raycast params kept instead of rebuilt per call
local Maid  = require("Utility/Maid")
local Flat  = require("Api/Court/Flat")
local Watch = require("Api/Court/Watch")

local FOLDER_NAME    = "Hoops"
local GOAL_NAME      = "Goal"
local PAINT_NAME     = "PaintZone"
local BACKBOARD_NAME = "Backboard"
local LOOSE_PATTERN  = "^_Hoop%d+$"
local INDEX_PATTERN  = "(%d+)$"

local ARC_GRACE = 0.95
local ARC_REACH = 100

-- hoop numbers follow the court and not the team in these modes
local OPEN_MODES = { Park = true, Plaza = true }

local M = {}

local function byName(a, b)
    return a.name < b.name
end

-- deps: Workspace, frame(), me(), position(), gamemode()
function M.new(maid, deps)
    local Workspace = deps.Workspace
    local records, byGoal, byIndex = {}, {}, {}
    local list = {}
    local bodies = Maid.new()
    local folder = nil
    local stray = nil
    local zone, params = nil, nil
    local memoStamp, memoGoal, memoX, memoZ = nil, nil, nil, nil
    local memoThree, memoBoundary, memoFlat = false, 0, 0

    maid:GiveTask(bodies)

    local function relist()
        local nextList, nextIndex = {}, {}
        for _, hoop in pairs(records) do
            if hoop.goal then nextList[#nextList + 1] = hoop end
        end
        table.sort(nextList, byName)
        for _, hoop in ipairs(nextList) do
            if hoop.index and not nextIndex[hoop.index] then nextIndex[hoop.index] = hoop end
        end
        list, byIndex = nextList, nextIndex
    end

    local function add(model)
        if records[model] then return end
        local body = Maid.new()
        local hoop = { name = model.Name, model = model, index = tonumber(string.match(model.Name, INDEX_PATTERN)) }
        records[model] = hoop
        bodies[model] = body

        Watch.child(body, model, GOAL_NAME, function(goal)
            if hoop.goal then byGoal[hoop.goal] = nil end
            hoop.goal = goal
            if goal then byGoal[goal] = hoop end
            relist()
        end)
        Watch.child(body, model, PAINT_NAME, function(paint) hoop.paint = paint end)
        Watch.child(body, model, BACKBOARD_NAME, function(backboard) hoop.backboard = backboard end)
    end

    local function remove(model)
        local hoop = records[model]
        if not hoop then return end
        records[model] = nil
        bodies[model] = nil
        if hoop.goal then byGoal[hoop.goal] = nil end
        hoop.goal, hoop.paint, hoop.backboard = nil, nil, nil
        relist()
    end

    -- Services.Workspace is cloneref'd, so the root is recognised by class and never by ==
    local function belongs(child)
        local parent = child.Parent
        if not parent then return false end
        if parent == folder then return true end
        return parent:IsA("Workspace") and string.match(child.Name, LOOSE_PATTERN) ~= nil
    end

    local function sync(child)
        if child:IsA("Model") and belongs(child) then add(child) else remove(child) end
    end

    local function syncLoose(child)
        if string.match(child.Name, LOOSE_PATTERN) then sync(child) end
    end

    local function bindFolder(found, slot)
        folder = found
        for model in pairs(records) do sync(model) end
        if not found then return end
        slot:GiveTask(found.ChildAdded:Connect(sync))
        slot:GiveTask(found.ChildRemoved:Connect(sync))
        for _, child in ipairs(found:GetChildren()) do sync(child) end
    end

    local function start()
        maid:GiveTask(Workspace.ChildAdded:Connect(syncLoose))
        maid:GiveTask(Workspace.ChildRemoved:Connect(syncLoose))
        Watch.child(maid, Workspace, FOLDER_NAME, bindFolder)
        for _, child in ipairs(Workspace:GetChildren()) do syncLoose(child) end
    end

    -- a Goal value pointing outside both known places still names a real hoop, so it is answered without being listed
    local function hoopOfGoal(goal)
        local hoop = byGoal[goal]
        if hoop then return hoop end
        local model = goal.Parent
        if not model then return nil end
        if stray and stray.goal == goal and stray.model == model then return stray end
        stray = {
            name      = model.Name,
            model     = model,
            goal      = goal,
            paint     = model:FindFirstChild(PAINT_NAME),
            backboard = model:FindFirstChild(BACKBOARD_NAME),
        }
        return stray
    end

    local function nearest(position)
        position = position or deps.position()
        if not position then return nil end
        local best, bestDistance = nil, math.huge
        for i = 1, #list do
            local hoop = list[i]
            local distance = Flat(hoop.goal.Position, position)
            if distance < bestDistance then best, bestDistance = hoop, distance end
        end
        if not best then return nil end
        return best, bestDistance
    end

    -- the server hands each character its basket as the Goal value, which is what the game's camera and takeover read; the rest only matters before that replicates
    local function myHoop()
        local mine = deps.me()
        local goal = mine and mine.goal
        local hoop = goal and hoopOfGoal(goal)
        if hoop then return hoop end
        if #list == 1 then return list[1] end
        if mine and mine.teamIndex ~= 0 and not OPEN_MODES[deps.gamemode()] then
            hoop = byIndex[mine.teamIndex]
            if hoop then return hoop end
        end
        return (nearest())
    end

    local function distanceToHoop(hoop, position)
        hoop = hoop or myHoop()
        position = position or deps.position()
        local goal = hoop and hoop.goal
        if not (goal and position) then return nil end
        local at = goal.Position
        local dx, dy, dz = position.X - at.X, position.Y - at.Y, position.Z - at.Z
        local flatSquared = dx * dx + dz * dz
        return math.sqrt(flatSquared), math.sqrt(flatSquared + dy * dy)
    end

    local function arcParams()
        if zone and zone.Parent then return params end
        local node = Workspace:FindFirstChild("Assets")
        node = node and node:FindFirstChild("Functionals")
        node = node and node:FindFirstChild("Zones")
        zone = node and node:FindFirstChild("ThreePoint") or nil
        params = nil
        if not zone then return nil end
        params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Include
        params.FilterDescendantsInstances = { zone }
        return params
    end

    -- GameUtil.GetThreePointMagnitude's bands scaled by the map, the only other arc the game carries; used for the number when the zone has none to give
    local function bandRadius(goal, dx, dy, dz)
        local full = math.sqrt(dx * dx + dy * dy + dz * dz)
        local dot = 0
        if full > 0 then
            local look = goal.CFrame.LookVector
            dot = (dx * look.X + dy * look.Y + dz * look.Z) / full
        end
        local radius = 34.1
        if dot >= 0.8 then
            radius = 33.5
        elseif dot >= 0.4 then
            radius = 35.8
        end
        local scale = Workspace:GetAttribute("CourtMultiplier")
        return radius * (type(scale) == "number" and scale or 1)
    end

    -- one raycast per distinct position per frame; a zone miss is never a three, because that is what the game's test answers, and with no zone at all the bands decide
    local function grade(hoop, position)
        local goal = hoop.goal
        local stamp = deps.frame()
        local x, z = position.X, position.Z
        if memoStamp == stamp and memoGoal == goal and memoX == x and memoZ == z then
            return memoThree, memoBoundary, memoFlat
        end

        local at = goal.Position
        local dx, dy, dz = x - at.X, position.Y - at.Y, z - at.Z
        local flat = math.sqrt(dx * dx + dz * dz)
        local cast = arcParams()
        local hit = nil
        if cast and flat > 0 then
            hit = Workspace:Raycast(at, Vector3.new(dx / flat * ARC_REACH, 0, dz / flat * ARC_REACH), cast)
        end

        local boundary
        if hit then
            boundary = Flat(at, hit.Position) + ARC_GRACE
        else
            boundary = bandRadius(goal, dx, dy, dz) + ARC_GRACE
        end
        local three = flat >= boundary
        if cast and not hit then three = false end

        memoStamp, memoGoal, memoX, memoZ = stamp, goal, x, z
        memoThree, memoBoundary, memoFlat = three, boundary, flat
        return three, boundary, flat
    end

    local function threePointDistance(hoop, position)
        hoop = hoop or myHoop()
        position = position or deps.position()
        if not (hoop and hoop.goal and position) then return nil end
        local _, boundary, flat = grade(hoop, position)
        return boundary, flat
    end

    local function isThree(position, hoop)
        hoop = hoop or myHoop()
        position = position or deps.position()
        if not (hoop and hoop.goal and position) then return nil end
        local three = grade(hoop, position)
        return three
    end

    -- height is ignored because a player in the air is still in the lane; the reach check spares a CFrame read for every paint not close enough to matter
    local function paintHas(paint, position)
        local center, size = paint.Position, paint.Size
        local dx, dz = position.X - center.X, position.Z - center.Z
        local halfX, halfY, halfZ = size.X * 0.5, size.Y * 0.5, size.Z * 0.5
        local reach = halfX + halfY + halfZ
        if dx * dx + dz * dz > reach * reach then return false end
        local frame = paint.CFrame
        local right, up, look = frame.RightVector, frame.UpVector, frame.LookVector
        return math.abs(dx * right.X + dz * right.Z) <= halfX
            and math.abs(dx * up.X + dz * up.Z) <= halfY
            and math.abs(dx * look.X + dz * look.Z) <= halfZ
    end

    local function inPaint(position, hoop)
        position = position or deps.position()
        if not position then return false end
        if hoop then
            local paint = hoop.paint
            if paint and paintHas(paint, position) then return true, hoop end
            return false
        end
        for i = 1, #list do
            local candidate = list[i]
            local paint = candidate.paint
            if paint and paintHas(paint, position) then return true, candidate end
        end
        return false
    end

    return {
        start = start,

        list               = function() return list end,
        myHoop             = myHoop,
        nearest            = nearest,
        distanceToHoop     = distanceToHoop,
        threePointDistance = threePointDistance,
        isThree            = isThree,
        inPaint            = inPaint,
    }
end

return M

end)
__bundle_register("Api/Court/Balls", function(require, _LOADED, __bundle_register, __bundle_modules)
-- court balls: every ball under workspace.Basketballs with who holds it and which are mid shot, moved by events so a read is a table lookup; several can be live at once, so nothing here assumes there is one
local Maid = require("Utility/Maid")
local Flat = require("Api/Court/Flat")

local MID_SHOT = "MidShot"

-- order of interest once my hands are empty: a shot in the air, then a ball someone holds, then a loose one
local RANK_FLYING, RANK_HELD, RANK_LOOSE = 1, 2, 3

local M = {}

-- deps: frame(), me(), position(), rereadHeld(), onPossession(newModel, oldModel, ball), onShot(ball)
function M.new(maid, deps)
    local list = {}
    local tracked, flying, holders = {}, {}, {}
    local shotWatches = Maid.new()
    local pick, pickStamp = nil, nil

    maid:GiveTask(shotWatches)

    local function readShot(part)
        local now = part:GetAttribute(MID_SHOT) == true
        if now == (flying[part] == true) then return end
        flying[part] = now or nil
        pickStamp = nil
        if now then deps.onShot(part) end
    end

    local function add(part)
        if tracked[part] or not part:IsA("BasePart") then return end
        tracked[part] = true
        flying[part] = part:GetAttribute(MID_SHOT) == true or nil
        local watch = Maid.new()
        watch:GiveTask(part:GetAttributeChangedSignal(MID_SHOT):Connect(function() readShot(part) end))
        shotWatches[part] = watch

        local nextList = table.create(#list + 1)
        for i = 1, #list do nextList[i] = list[i] end
        nextList[#list + 1] = part
        list = nextList
        pickStamp = nil
    end

    local function remove(part)
        if not tracked[part] then return end
        tracked[part] = nil
        flying[part] = nil
        shotWatches[part] = nil

        local nextList = table.create(#list)
        for i = 1, #list do
            if list[i] ~= part then nextList[#nextList + 1] = list[i] end
        end
        list = nextList
        pickStamp = nil
    end

    local function bindFolder(folder, slot)
        shotWatches:DoCleaning()
        tracked, flying, list = {}, {}, {}
        pickStamp = nil
        if folder then
            slot:GiveTask(folder.ChildAdded:Connect(function(child)
                add(child)
                deps.rereadHeld()
            end))
            slot:GiveTask(folder.ChildRemoved:Connect(function(child)
                remove(child)
                deps.rereadHeld()
            end))
            for _, child in ipairs(folder:GetChildren()) do add(child) end
        end
        deps.rereadHeld()
    end

    -- a steal can land in either order, so a release only counts if this record still owns the ball
    local function onHeld(rec, new, previous)
        pickStamp = nil
        if previous and holders[previous] == rec then
            holders[previous] = nil
            deps.onPossession(nil, rec.model, previous)
        end
        if new then
            local old = holders[new]
            holders[new] = rec
            deps.onPossession(rec.model, old and old.model or nil, new)
        end
    end

    local function choose()
        local mine = deps.me()
        local held = mine and mine.held
        if held then return held end

        local count = #list
        if count == 0 then return nil end
        if count == 1 then return list[1] end

        local origin = deps.position()
        local best, bestRank, bestDistance = nil, nil, nil
        for i = 1, count do
            local part = list[i]
            local rank = RANK_LOOSE
            if flying[part] then
                rank = RANK_FLYING
            elseif holders[part] then
                rank = RANK_HELD
            end
            if not best or rank <= bestRank then
                local distance = origin and Flat(origin, part.Position) or 0
                if not best or rank < bestRank or distance < bestDistance then
                    best, bestRank, bestDistance = part, rank, distance
                end
            end
        end
        return best
    end

    -- most relevant needs distances, so it is worked out once a frame; anything that changes the answer clears the stamp
    local function ball()
        local stamp = deps.frame()
        if pickStamp ~= stamp then
            pickStamp = stamp
            pick = choose()
        end
        return pick
    end

    local function carrier(part)
        local rec = holders[part or ball()]
        return rec and rec.model or nil
    end

    local function myBall()
        local mine = deps.me()
        return mine and mine.held or nil
    end

    local function ballPosition()
        local part = ball()
        return part and part.Position or nil
    end

    local function ballInFlight(part)
        local target = part or ball()
        return target ~= nil and flying[target] == true
    end

    return {
        bindFolder = bindFolder,
        onHeld     = onHeld,

        list         = function() return list end,
        ball         = ball,
        carrier      = carrier,
        myBall       = myBall,
        ballPosition = ballPosition,
        ballInFlight = ballInFlight,
    }
end

return M

end)
