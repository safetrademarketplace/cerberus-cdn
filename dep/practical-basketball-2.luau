        if not Options or not Toggles then return nil end
        local t      = Options.CursorType and Options.CursorType.Value or "crosshair"
        local color3 = (Options.PrimaryColor and Options.PrimaryColor.Value) or Color3.new(1, 1, 1)
        local out3   = (Options.OutlineColor and Options.OutlineColor.Value) or Color3.new(0, 0, 0)
        local outEn  = Toggles.OutlineEnabled and (Toggles.OutlineEnabled.Value == true) or false
