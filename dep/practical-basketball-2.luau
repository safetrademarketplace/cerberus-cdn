local function applyValue(values, key, want, real)
    real[key] = values[key]
    values[key] = want
end

-- a value that is not ours came from a fresh profile or from the player, so it stays
local function restoreValue(values, key, want, real)
    if values[key] == want then values[key] = real[key] end
end

local function toDelay(value)
    if type(value) ~= "number" or value ~= value then return nil end
    return math.clamp(value, MIN_DELAY, MAX_DELAY)
end

local M = {}

function M.new(base, net)
    local token = nil

    local function gameplay()
        local bus = net()
        local player = bus and bus.controller("Player")
        local profile = player and player.ProfileData
        local saved = type(profile) == "table" and profile.SavedSettings
        local settings = type(saved) == "table" and saved.Gameplay
        return type(settings) == "table" and settings or nil
    end

    -- TabMenu:940 reads the same flag, and TabMenu:365 clears it when the menu closes
    local function settingsOpen()
        local bus = net()
        local gui = bus and bus.controller("Gui")
        if not gui then return false end
        local ok, menu = pcall(gui.GetComponent, gui, "TabMenu")
        if not ok or type(menu) ~= "table" then return false end
        local pages = menu.Pages
        local page = type(pages) == "table" and pages.Settings
        return type(page) == "table" and page.Active == true
    end

    local function activeScheme()
        local bus = net()
        local input = bus and bus.controller("UserInput")
        local preferred = input and input._preferred
        return SCHEME_OF[preferred] or DEFAULT_SCHEME
    end

    local function each(settings, fn)
        for _, scheme in ipairs(SCHEMES) do
            local values = settings[scheme]
            if type(values) == "table" then
                local real = token.real[scheme]
                if not real then
                    real = {}
                    token.real[scheme] = real
                end
                for key, want in pairs(token.want) do fn(values, key, want, real) end
            end
        end
    end

    -- while stepped aside the table holds the truth, so stepping back in recaptures from it
    local function sync()
        local settings = gameplay()
        if not settings then return end
        if settingsOpen() then
            if token.aside then return end
            each(settings, restoreValue)
            token.aside = true
        elseif token.aside then
            each(settings, applyValue)
            token.aside = false
        else
            each(settings, holdValue)
        end
    end

    -- nil for either leaves that one on the player's own value; use disable to drop both
    local function setDelays(shoot, dribble)
        local shootDelay, dribbleDelay = toDelay(shoot), toDelay(dribble)
        if shoot == nil and dribble == nil then return false, Errors.BAD_ARGS end
        if (shoot ~= nil and shootDelay == nil) or (dribble ~= nil and dribbleDelay == nil) then
            return false, Errors.BAD_ARGS
        end
        local settings = gameplay()
        if not settings then return false, Errors.NO_SETTINGS end
        -- back to the truth first, or the new targets would capture the old override as the player's own
        if token and not token.aside then each(settings, restoreValue) end
        if not token then
            token = { real = {} }
            token.guard = Jobs.interval(GUARD_PERIOD, function()
                base.safe("instant input guard", sync)
            end, { name = "InputInstantGuard" })
        end
        token.want = { ShootDelay = shootDelay, DribbleDelay = dribbleDelay }
        token.aside = true
        sync()
        return true
    end

    local function disable()
        if not token then return true end
        local settings = gameplay()
        if settings and not token.aside then each(settings, restoreValue) end
        token.guard:Cancel()
        token = nil
        return true
    end

    local function isEnabled()
        return token ~= nil
    end

    -- the player's own numbers, never the override
    local function delays()
        local settings = gameplay()
        local scheme = activeScheme()
        local values = settings and settings[scheme]
        if type(values) ~= "table" then return nil, Errors.NO_SETTINGS end
        local real = token and not token.aside and token.real[scheme] or nil
        local function own(key)
            if real and token.want[key] ~= nil then return real[key] end
            return values[key]
        end
        return { shoot = own("ShootDelay"), dribble = own("DribbleDelay"), scheme = scheme }
    end

    return {
        delays    = delays,
        setDelays = setDelays,
        disable   = disable,
        isEnabled = isEnabled,
    }
end

return M

end)
__bundle_register("Api/Input/Held", function(require, _LOADED, __bundle_register, __bundle_modules)
-- input held: the one owner of every press the api has out; each let-go goes through here, so releasing everything always works and a shot can never stay down past its limit
local Jobs = require("Utility/Jobs")

-- the meter peaks in under a second, so a shot down this long means whoever pressed it died
local SHOT_LIMIT = 5

local ORDER = { "shoot", "screen", "holdG", "sprint" }

local RELEASES = {
    shoot  = { remote = "Shoot",  value = { Shoot = false } },
    screen = { remote = "Screen", value = false },
    holdG  = { remote = "HoldG",  value = { HoldingG = false } },
    sprint = { remote = "Sprint", value = false },
}

local M = {}

function M.new(base, send)
    local out = {}
    local limit = nil

    local function disarm()
        if not limit then return end
        limit:Cancel()
        limit = nil
    end

    -- a failed send keeps the record, so the next release or the unload still tries
    local function release(name)
        local entry = RELEASES[name]
        local ok, err = send(entry.remote, entry.value)
        if not ok then return false, err end
        out[name] = nil
        if name == "shoot" then disarm() end
        return true
    end

    local function mark(name)
        out[name] = true
        if name ~= "shoot" then return end
        disarm()
        limit = Jobs.delay(SHOT_LIMIT, function()
            limit = nil
            base.warn("a shot stayed held for %d seconds, letting go", SHOT_LIMIT)
            release("shoot")
        end, { name = "InputShotLimit" })
    end

    local function releaseAll()
        local failure = nil
        for _, name in ipairs(ORDER) do
            if out[name] then
                local ok, err = release(name)
                if not ok then failure = failure or err end
            end
        end
        disarm()
        if failure then return false, failure end
        return true
    end

    -- with a name, whether that press is out; without one, whether any is, plus a copy of which
    local function held(name)
        if name ~= nil then return out[name] == true end
        local copy = {}
        for key in pairs(out) do copy[key] = true end
        return next(copy) ~= nil, copy
    end

    return {
        mark       = mark,
        release    = release,
        releaseAll = releaseAll,
        held       = held,
    }
end

return M

end)
__bundle_register("Api/Input/Actions", function(require, _LOADED, __bundle_register, __bundle_modules)
-- input actions: every payload the game's input modules send, written once from their call sites, so no feature builds one or names a remote
local Errors = require("Api/Input/Errors")

local PASS_TYPES = { tap = 1, double = 2, doubleSprint = 3, lob = 4, fake = 5 }

-- Team.Passing only ever marks a quick pass as directional on these three
local DIRECTIONAL = { tap = true, lob = true, fake = true }

local SWITCH_HAND = "H"
local COMBO = "^[ZXCV]+$"

local M = {}

function M.new(ctx, send, held, net)
    local function localState()
        local bus = net()
        return bus and bus.playerState() or nil
    end

    -- the attribute the mobile module sends; the keyboard module reads its key instead, and a verb has no key
    local function sprinting(state)
        if not state then return false end
        local ok, value = pcall(state.GetAttribute, state, "Sprinting")
        return ok and value == true
    end

    local function hold(name, remote, value)
        local ok, err = send(remote, value)
        if not ok then return false, err end
        held.mark(name)
        return true
    end

    local function plain(remote)
        return function() return send(remote) end
    end

    local function toggle(name, remote, down)
        return function(on)
            if type(on) ~= "boolean" then return false, Errors.BAD_ARGS end
            if on then return hold(name, remote, down) end
            return held.release(name)
        end
    end

    local function packaged(remote)
        return function(id)
            local valid = type(id) == "number" or (type(id) == "string" and id ~= "")
            if not valid then return false, Errors.BAD_ARGS end
            return send(remote, id)
        end
    end

    -- sprint only rides along on a double tap, the one shot the game sends it with
    local function shootPress(opts)
        if opts ~= nil and type(opts) ~= "table" then return false, Errors.BAD_ARGS end
        local tap = opts or {}
        if tap.doubleTap and tap.space then return false, Errors.BAD_ARGS end
        if tap.doubleTap then
            local sprint = tap.sprint
            if sprint == nil then sprint = sprinting(localState()) end
            return hold("shoot", "Shoot", { Shoot = true, Sprint = sprint == true, Input = "EE" })
        end
        if not tap.space then
            return hold("shoot", "Shoot", { Shoot = true, Input = "E" })
        end
        local ok, err = hold("shoot", "Shoot", { Shoot = true, Input = "E", UseSpace = true })
        if not ok then return false, err end
        ok, err = send("Jump")
        if ok then return true end
        -- half a space shot is no shot, and the press must not outlive it
        held.release("shoot")
        return false, err
    end

    local function shootRelease()
        return held.release("shoot")
    end

    -- target is the teammate's character name; only a self lob knows its own
    local function pass(kind, target, opts)
        if kind == "selfLob" then
            local me = ctx.References.player
            if not me then return false, Errors.NO_CHARACTER end
            return send("Pass", { PassType = PASS_TYPES.lob, Player = me.Name })
        end
        local passType = PASS_TYPES[kind]
        if not passType or type(target) ~= "string" or target == "" then return false, Errors.BAD_ARGS end
        if opts ~= nil and type(opts) ~= "table" then return false, Errors.BAD_ARGS end
        if not (opts and opts.directional) then
            return send("Pass", { Player = target, PassType = passType })
        end
        if not DIRECTIONAL[kind] then return false, Errors.BAD_ARGS end
        return send("Pass", { Directional = true, Player = target, PassType = passType })
    end

    -- kind is "H" to switch hands, or the letters of a combo in the order they were tapped
    local function dribble(kind)
        if kind == SWITCH_HAND then return send("Dribble", SWITCH_HAND) end
        if type(kind) ~= "string" or not string.find(kind, COMBO) then return false, Errors.BAD_ARGS end
        local state = localState()
        local movement = state and state.Movement
        local direction = type(movement) == "table" and movement.lastMoveDirection or nil
        if direction == nil then return false, Errors.NO_CHARACTER end
        return send("Dribble", kind, sprinting(state), direction)
    end

    local function clutch(double)
        if not double then return send("Clutch") end
        local ok, err = send("Clutch", true)
        if not ok then return false, err end
        return pass("selfLob")
    end

    return {
        shootPress      = shootPress,
        shootRelease    = shootRelease,
        jump            = plain("Jump"),
        sprint          = toggle("sprint", "Sprint", true),
        steal           = plain("Steal"),
        pass            = pass,
        dribble         = dribble,
        holdG           = toggle("holdG", "HoldG", { HoldingG = true }),
        clutch          = clutch,
        screen          = toggle("screen", "Screen", true),
        dropBall        = plain("DropBall"),
        intentionalFoul = plain("IntentionalFoul"),
        emote           = packaged("Emote"),
        celebrate       = packaged("GreenAnimation"),
    }
end

return M

end)
__bundle_register("Api/Court", function(require, _LOADED, __bundle_register, __bundle_modules)
-- court api: everything about the court that is not me (roster, balls, possession, hoops and their geometry), kept current by events so esp and automation can read it every frame for free; lists are shared arrays that callers must not mutate
local Api    = require("Api")
local Balls  = require("Api/Court/Balls")
local Flat   = require("Api/Court/Flat")
local Hoops  = require("Api/Court/Hoops")
local Roster = require("Api/Court/Roster")
local Watch  = require("Api/Court/Watch")

local CHARACTERS  = "Characters"
local BASKETBALLS = "Basketballs"
local PROXY       = "ProxyCharacter"
local GAMEMODE    = "Gamemode"

local M = {}

function M.new(ctx)
    local base      = Api.define("Court", ctx)
    local Workspace = ctx.Services.Workspace
    local maid      = base.maid

    -- the shared signal's handle has no Destroy, and Utility/Maid silently drops a table without one
    local function newSignal()
        local inner = base.signal()
        local signal = {}
        function signal:Connect(fn)
            local conn = inner:Connect(fn)
            local handle = {}
            function handle.Disconnect() conn:Disconnect() end
            handle.Destroy = handle.Disconnect
            return handle
        end
        function signal:Fire(...)
            inner:Fire(...)
        end
        return signal
    end

    local RosterChanged     = newSignal()
    local PossessionChanged = newSignal()
    local ShotInAir         = newSignal()

    local mode = Workspace:GetAttribute(GAMEMODE)
    local proxy = nil
    local balls = nil

    local function frame() return Workspace.DistributedGameTime end
    local function gamemode() return mode end

    local roster = Roster.new(maid, {
        selfName  = ctx.References.player.Name,
        gamemode  = gamemode,
        onChanged = function() RosterChanged:Fire() end,
        onHeld    = function(rec, new, previous) balls.onHeld(rec, new, previous) end,
    })

    -- the player api owns "me" when it is up; the roster's name index answers the same question without it
    local function me()
        local playerApi = ctx.Api.Player
        local model = playerApi and playerApi.model and playerApi.model()
        local rec = model and roster.recordOf(model)
        return rec or roster.me()
    end

    -- the proxy is the body the client streams to the server, so it is what a graded distance measures from
    local function here()
        if proxy then return proxy.Position end
        local rec = me()
        local root = rec and rec.root
        return root and root.Position or nil
    end

    balls = Balls.new(maid, {
        frame        = frame,
        me           = me,
        position     = here,
        rereadHeld   = roster.rereadHeld,
        onPossession = function(new, old, part) PossessionChanged:Fire(new, old, part) end,
        onShot       = function(part) ShotInAir:Fire(part) end,
    })

    local hoops = Hoops.new(maid, {
        Workspace = Workspace,
        frame     = frame,
        me        = me,
        position  = here,
        gamemode  = gamemode,
    })

    local function hasBall(model)
        local rec
        if model == nil then rec = me() else rec = roster.recordOf(model) end
        return rec ~= nil and rec.held ~= nil
    end

    local function isAlly(model)
        local rec = roster.recordOf(model)
        return rec ~= nil and rec.isAlly
    end

    local function teamOf(model)
        local rec = roster.recordOf(model)
        if not rec then return nil end
        return rec.team, rec.teamIndex
    end

    local function nearestOpponent(position)
        position = position or here()
        if not position then return nil end
        local list = roster.opponents()
        local best, bestDistance = nil, math.huge
        for i = 1, #list do
            local rec = list[i]
            local root = rec.root
            if root then
                local distance = Flat(root.Position, position)
                if distance < bestDistance then best, bestDistance = rec, distance end
            end
        end
        if not best then return nil end
        return best, bestDistance
    end

    maid:GiveTask(Workspace:GetAttributeChangedSignal(GAMEMODE):Connect(function()
        mode = Workspace:GetAttribute(GAMEMODE)
        roster.reclassify()
    end))
    Watch.child(maid, Workspace, PROXY, function(part) proxy = part end)
    Watch.child(maid, Workspace, CHARACTERS, roster.bindFolder)
    Watch.child(maid, Workspace, BASKETBALLS, balls.bindFolder)
    hoops.start()

    base.log("court api ready (%d players, %d balls, %d hoops)", #roster.players(), #balls.list(), #hoops.list())

    return {
        players   = roster.players,
        teammates = roster.teammates,
        opponents = roster.opponents,
        bench     = roster.bench,
        recordOf  = roster.recordOf,
        isAlly    = isAlly,

        balls        = balls.list,
        ball         = balls.ball,
        carrier      = balls.carrier,
        myBall       = balls.myBall,
        hasBall      = hasBall,
        ballPosition = balls.ballPosition,
        ballInFlight = balls.ballInFlight,

        hoops              = hoops.list,
        myHoop             = hoops.myHoop,
        nearestHoop        = hoops.nearest,
        distanceToHoop     = hoops.distanceToHoop,
        threePointDistance = hoops.threePointDistance,
        isThree            = hoops.isThree,

        nearestOpponent = nearestOpponent,
        inPaint         = hoops.inPaint,

        teamOf   = teamOf,
        gamemode = gamemode,

        RosterChanged     = RosterChanged,
        PossessionChanged = PossessionChanged,
        ShotInAir         = ShotInAir,
    }
end

return M

end)
__bundle_register("Api/Court/Watch", function(require, _LOADED, __bundle_register, __bundle_modules)
-- court watch: follows one named child of a parent across late replication and replacement, giving each instance a maid that dies with it
local Maid = require("Utility/Maid")

local M = {}

-- bind(child, slot) runs for every instance that takes the name, and with nil when the name empties; it does not run if the name was never filled
function M.child(maid, parent, name, bind)
    local slot = Maid.new()
    local current = nil
    maid:GiveTask(slot)

    local function set(child)
        if child == current then return end
        current = child
        slot:DoCleaning()
        bind(child, slot)
    end

    maid:GiveTask(parent.ChildAdded:Connect(function(child)
        if child.Name == name then set(child) end
    end))
    maid:GiveTask(parent.ChildRemoved:Connect(function(child)
        if child == current then set(parent:FindFirstChild(name)) end
    end))

    set(parent:FindFirstChild(name))
end

return M

end)
__bundle_register("Api/Court/Roster", function(require, _LOADED, __bundle_register, __bundle_modules)
-- court roster: a record for every real character under workspace.Characters, kept by events alone; bodies are recycled by renaming in place, so every child stays watched in both directions for as long as it is parented
local Maid  = require("Utility/Maid")
local Watch = require("Api/Court/Watch")

local DUMMY_NAME  = "InvisCharacter"
local ROOT_NAME   = "HumanoidRootPart"
local JOINT_NAME  = "Basketball"
local FOLDER_NAME = "Attributes"
local GOAL_NAME   = "Goal"
local PRIVATE_GYM = "PrivateGym"

local SIDE_SELF, SIDE_ALLY, SIDE_ENEMY, SIDE_BENCH = 0, 1, 2, 3

local M = {}

local function numberAttr(model, name)
    local value = model:GetAttribute(name)
    return type(value) == "number" and value or 0
end

local function byName(a, b)
    return a.name < b.name
end

-- deps: selfName, gamemode(), onHeld(record, newBall, oldBall), onChanged()
function M.new(maid, deps)
    local selfName = deps.selfName
    local records, named = {}, {}
    local mine = nil
    local bodies, renames = Maid.new(), Maid.new()
    local all, allies, enemies, benched = {}, {}, {}, {}
    local listsStale = false

    maid:GiveTask(bodies)
    maid:GiveTask(renames)

    -- the game's own Same and Opposite tests: Team is the key and TeamIndex is not (learn pb has Team 1 and 2 with TeamIndex 0); with no team of mine everyone counts as opposite, except a private gym where team 0 is one shared team
    local function sideOf(rec)
        if rec.isLocal then return SIDE_SELF end
        if not mine then return SIDE_ENEMY end
        local myTeam = mine.team
        if myTeam == 0 and deps.gamemode() ~= PRIVATE_GYM then return SIDE_ENEMY end
        if rec.court ~= 0 and mine.court ~= 0 and rec.court ~= mine.court then return SIDE_BENCH end
        if rec.team == myTeam then return SIDE_ALLY end
        if rec.team == 0 then return SIDE_BENCH end
        return SIDE_ENEMY
    end

    local function classify(rec)
        local side = sideOf(rec)
        rec.side = side
        rec.isAlly = side == SIDE_SELF or side == SIDE_ALLY
    end

    local function classifyAll()
        for _, rec in pairs(records) do classify(rec) end
    end

    local function refreshMine()
        local current = named[selfName]
        if current == mine then return end
        mine = current
        classifyAll()
    end

    local function settle()
        refreshMine()
        listsStale = true
        deps.onChanged()
    end

    local function claimName(rec)
        rec.isLocal = rec.name == selfName
        named[rec.name] = rec
    end

    -- recycling can briefly leave two bodies on one name, so the survivor takes the index back
    local function releaseName(rec)
        local name = rec.name
        if named[name] ~= rec then return end
        named[name] = nil
        for _, other in pairs(records) do
            if other ~= rec and other.name == name then
                named[name] = other
                return
            end
        end
    end

    local function setHeld(rec, held)
        local previous = rec.held
        if held == previous then return end
        rec.held = held
        deps.onHeld(rec, held, previous)
    end

    -- the weld is on every body and holds a ball only while Part1 is set and Part0 belongs to this character; ball:GetJoints() finds this same joint
    local function readHeld(rec)
        local joint = rec.joint
        local part0 = joint and joint.Part0
        local part1 = joint and joint.Part1
        if part0 and part1 and part0.Parent == rec.model and part1.Parent then
            setHeld(rec, part1)
        else
            setHeld(rec, nil)
        end
