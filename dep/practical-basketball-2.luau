__bundle_register("Features/Basketball/Effects/FrameRate", function(require, _LOADED, __bundle_register, __bundle_modules)
-- effects frame rate: counts heartbeats into one second samples only while something needs them, keeps the latest six as the current figure, and times a fresh reading behind a settle so the change being measured has landed
local Scheduler = require("Utility/Scheduler")

local WINDOW_SAMPLES = 6
local SETTLE_SECONDS = 3
local MIN_SAMPLES    = 2 -- below this a "before" figure is one frame hitch away from nonsense

local M = { SAMPLE_SECONDS = 1 }

function M.new()
    local counter
    local frames, stamp = 0, 0
    local samples = {}
    local settleUntil

    local function disarm()
        if not counter then return end
        counter:Disconnect()
        counter = nil
        table.clear(samples)
    end

    local function mean()
        local sum = 0
        for _, fps in ipairs(samples) do sum = sum + fps end
        return sum / #samples
    end

    local function average()
        if #samples < MIN_SAMPLES then return nil end
        return mean()
    end

    -- runs once per SAMPLE_SECONDS from the owner's job and returns a reading on the tick that completes one
    local function tick(wanted)
        if not (wanted or settleUntil) then
            disarm()
            return nil
        end
        if not counter then
            frames, stamp = 0, os.clock()
            counter = Scheduler.heartbeat(function() frames = frames + 1 end, { name = "LowEffectsFrames" })
            return nil
        end

        local now = os.clock()
        local from, counted = stamp, frames
        frames, stamp = 0, now
        -- a paused scheduler counts nothing, which is not a frame rate of zero
        if counted == 0 or now <= from then return nil end
        -- a sample that began inside the settle still holds frames from before the change landed
        if settleUntil and from < settleUntil then return nil end

        samples[#samples + 1] = counted / (now - from)
        if #samples > WINDOW_SAMPLES then table.remove(samples, 1) end
        if settleUntil and #samples == WINDOW_SAMPLES then
            settleUntil = nil
            return mean()
        end
        return nil
    end

    local function measure()
        table.clear(samples)
        settleUntil = os.clock() + SETTLE_SECONDS
    end

    local function cancel()
        settleUntil = nil
    end

    local function stop()
        settleUntil = nil
        disarm()
    end

    return {
        tick    = tick,
        average = average,
        measure = measure,
        cancel  = cancel,
        stop    = stop,
    }
end

return M

end)
__bundle_register("Features/Basketball/Effects/Celebrations", function(require, _LOADED, __bundle_register, __bundle_modules)
-- celebrations feature: answers the game's offer after our own green and plays owned emotes; the offer names a category of celebrations, never one celebration, so what plays comes from the owned list the game's wheel is built from
local Jobs    = require("Utility/Jobs")
local UiWrite = require("Utility/UiWrite")

local MenuCallback = require("Features/Basketball/Effects/MenuCallback")

local SHOT_WINDOW    = 6   -- seconds after our own shot started inside which an offer is ours to answer
local ANSWER_DELAY   = 0.5 -- the wheel takes a person longer than this, and the shot's own result lands by then
local RETRY_SECONDS  = 2
local NOTIFY_SECONDS = 3

local EMOTES    = "Emotes"
local LOADING   = "Loading..."
local NO_EMOTES = "No emotes yet"

local NO_LAST_TEXT = "No celebration yet"

-- server text in a menu element goes through the rich text parser, and a stray bracket throws on every layout
local function clean(text)
    return (string.gsub(string.gsub(tostring(text), "<", "("), ">", ")"))
end

local function ownedIn(profile, category)
    local owned = type(profile) == "table" and profile.OwnedAnimations
    local character = type(owned) == "table" and owned.Character
    local list = type(character) == "table" and character[category]
    return type(list) == "table" and list or nil
end

return function(ctx)
    local Library = ctx.Library
    local track   = ctx.track
    local Api     = ctx.Api

    local Input = Api and Api.Input
    local Net   = Api and Api.Net
    local Shot  = Api and Api.Shot

    local group = ctx.Tabs.Fun:AddRightGroupbox("Celebrations", "sparkles")

    if not (Input and Net and Shot) then
        group:AddLabel({ Text = "Not available here", DoesWrap = true })
        return
    end

    local EMOTE_REFUSED = {
        [Input.Errors.HAS_BALL]     = "Let go of the ball",
        [Input.Errors.NO_CHARACTER] = "Get on the court first",
    }

    local dead = false
    local last, answerJob
    local names = {}
    local packages = {}
    local shownEmotes

    local autoSwitch, lastLabel, emoteDrop

    local function notify(text)
        UiWrite.notify(Library, text, NOTIFY_SECONDS)
    end

    local function nameOf(package)
        return clean(names[tostring(package)] or package)
    end

    local function profileNow()
        local player = Net.controller("Player")
        return player and player.ProfileData or nil
    end

    -- the offer carries no player, so our own shot has to vouch for it; one still open has not reached lastShot yet
    local function isOurs()
        local shot = Shot.current() or Shot.lastShot()
        return type(shot) == "table" and os.clock() - shot.startedAt <= SHOT_WINDOW
    end

    -- the wheel lays its slots out in owned order, so the first entry is the top pick on its first page
    local function answer(category)
        if dead or not isOurs() then return end
        local owned = ownedIn(profileNow(), category)
        local package = owned and owned[1]
        if package == nil then
            UiWrite.text(lastLabel, "You do not own one")
            return
        end
        last = package
        UiWrite.text(lastLabel, "Last: " .. nameOf(package))
        if autoSwitch.Value and not Input.celebrate(package) then
            notify("Celebration would not play")
        end
    end

    -- this cannot ask Input.legal first: the game's own handler for this same event is what opens the window, and it may not have run yet
    local function onOffer(category)
        if type(category) ~= "string" then return end
        if answerJob then answerJob:Cancel() end
        answerJob = Jobs.delay(ANSWER_DELAY, function()
            answerJob = nil
            answer(category)
        end, { name = "CelebrationAnswer" })
    end

    local function playLast()
        if last == nil then
            notify("Green a shot first")
            return
        end
        local inWindow = Input.legal("celebrate")
        if not Input.celebrate(last) then
            notify("Celebration would not play")
        elseif not inWindow then
            notify("Sent, but may not show")
        end
    end

    local function playEmote()
        local package = packages[emoteDrop.Value]
        if package == nil then
            notify("You have no emote")
            return
        end
        local allowed, reason = Input.legal("emote")
        if not allowed then
            notify(EMOTE_REFUSED[reason] or "Can't do that right now")
            return
        end
        if not Input.emote(package) then notify("Emote would not play") end
    end

    autoSwitch = group:AddToggle("CelebrateAuto", {
        Text = "Auto celebrate",
        Default = false,
        Tooltip = "Plays your first after a green",
    })

    lastLabel = group:AddLabel({ Text = NO_LAST_TEXT, DoesWrap = true })

    group:AddButton({
        Text = "Play last celebration",
        Func = MenuCallback(playLast),
    })

    group:AddDivider("your emotes")

    emoteDrop = group:AddDropdown("CelebrateEmote", {
        Text = "Emote",
        Values = { LOADING },
        Default = 1,
        Multi = false,
    })

    group:AddButton({
        Text = "Play emote",
        Tooltip = "Not while holding the ball",
        Func = MenuCallback(playEmote),
    })

    -- returns false until the profile has an emote list to read; profile is given when the game has just pushed one
    local function renderEmotes(profile)
        local owned = ownedIn(profile or profileNow(), EMOTES)
        if not owned then return false end

        local labels, byLabel = {}, {}
        for _, package in ipairs(owned) do
            local label = nameOf(package)
            if byLabel[label] ~= nil then label = clean(package) end
            if byLabel[label] == nil then
                labels[#labels + 1] = label
                byLabel[label] = package
            end
        end
        if #labels == 0 then labels[1] = NO_EMOTES end

        local signature = table.concat(labels, "\0")
        if signature == shownEmotes then return true end
        shownEmotes = signature

        -- a renamed list must not lose the emote the player has picked
        local picked = packages[emoteDrop.Value]
        local keep = labels[1]
        for label, package in pairs(byLabel) do
            if package == picked then keep = label end
        end
        packages = byLabel
        UiWrite.values(emoteDrop, labels)
        UiWrite.value(emoteDrop, keep)
        return true
    end

    local function loadNames(job)
        local ok, data = Net.invoke("WebService", "GetData", "Animations")
        if not job.alive then return end
        local character = ok and type(data) == "table" and data.Character
        if type(character) ~= "table" then return end
        for _, list in pairs(character) do
            for _, entry in pairs(type(list) == "table" and list or {}) do
                if type(entry) == "table" and entry.package ~= nil and type(entry.name) == "string" then
                    names[tostring(entry.package)] = entry.name
                end
            end
        end
        renderEmotes()
    end

    -- nothing here may run during the build: a game call there would drop the identity the next feature's Add* needs
    track(Jobs.delay(0, function(job)
        local offers, profiles
        local unavailable = false
        while true do
            if not offers then
                offers = Net.on("InterfaceService", "GreenCelebration", onOffer)
                if offers then
                    track(offers)
                    if unavailable then UiWrite.text(lastLabel, NO_LAST_TEXT) end
                elseif not unavailable then
                    unavailable = true
                    UiWrite.text(lastLabel, "Not available here")
                end
            end
            if not profiles then
                profiles = Net.on("PlayerService", "ProfileUpdated", renderEmotes)
                if profiles then track(profiles) end
            end
            -- the emote list is usable before its names arrive, and a slow server must not hold it back
            local listed = renderEmotes()
            if listed and offers and profiles then break end
            if not job:sleep(RETRY_SECONDS) then return end
        end
        loadNames(job)
    end, { name = "CelebrationsSetup" }))

    return {
        cleanup = function()
            dead = true
            if answerJob then answerJob:Cancel() end
        end,
    }
end

end)
__bundle_register("Features/Basketball/Effects/Camera", function(require, _LOADED, __bundle_register, __bundle_modules)
-- camera feature: the game's views and a custom field of view held through prefs tokens, with the menu following whatever the l key does
local Jobs    = require("Utility/Jobs")
local UiWrite = require("Utility/UiWrite")

local MenuCallback = require("Features/Basketball/Effects/MenuCallback")

local SYNC_SECONDS = 1

-- the range every Camera.* FieldOfView row in the game's settings config allows
local FOV_MIN, FOV_MAX, FOV_NORMAL = 20, 120, 70

-- a saved config lands before the first sync, so the placeholder has to hold real names or that saved view is dropped
local KNOWN_VIEWS = { "Player", "Court", "Wire", "POV", "Broadcast", "BehindGoal", "FirstPerson" }

return function(ctx)
    local Library = ctx.Library
    local Prefs   = ctx.Api and ctx.Api.Prefs

    local group = ctx.Tabs.Misc:AddRightGroupbox("Camera", "camera")

    if not Prefs then
        group:AddLabel({ Text = "Not available here", DoesWrap = true })
        return
    end

    local NOT_READY = Prefs.Errors.NOT_READY

    local viewDrop, fovSwitch, fovSlider
    local viewToken, heldView, wantedView
    local fovToken, fovWaiting
    local shownList
    local dead, syncing, filled = false, false, false

    -- the new token goes on before the old comes off, so the view never passes through the player's own setting
    local function holdView(name)
        local token, err = Prefs.setCameraMode(name)
        if not token then return false, err end
        if viewToken then viewToken.Restore() end
        viewToken, heldView = token, name
        return true
    end

    local function showView(name)
        if viewDrop.Value == name or not table.find(viewDrop.Values, name) then return end
        syncing = true
        UiWrite.value(viewDrop, name)
        syncing = false
    end

    local function pickView(name)
        wantedView = nil
        local live, active = Prefs.cameraMode()
        if live and active == name and not viewToken then return end
        local held, err = holdView(name)
        if held then return end
        if err == NOT_READY then
            wantedView = name
            return
        end
        UiWrite.notify(Library, "View not available", 3)
        if live then showView(active) end
    end

    local function applyFov()
        local token, err = Prefs.setCameraFov(fovSlider.Value)
        if token then
            fovWaiting = false
            if fovToken then fovToken.Restore() end
            fovToken = token
            return
        end
        if err == NOT_READY then
            fovWaiting = true
            return
        end
        fovWaiting = false
        UiWrite.notify(Library, "Couldn't change field of view", 3)
        UiWrite.value(fovSwitch, false)
    end

    local function dropFov()
        fovWaiting = false
        if not fovToken then return end
        fovToken.Restore()
        fovToken = nil
    end

    viewDrop = group:AddDropdown("CameraView", {
        Text = "View",
        Values = KNOWN_VIEWS,
        Multi = false,
        Callback = MenuCallback(function(name)
            if dead or syncing or type(name) ~= "string" then return end
            pickView(name)
        end),
    })

    fovSwitch = group:AddToggle("CameraFovOn", {
        Text = "Custom field of view",
        Default = false,
        Tooltip = "Not saved to your account",
        Callback = MenuCallback(function(on)
            if dead then return end
            if on then applyFov() else dropFov() end
        end),
    })

    local fovBox = group:AddDependencyBox()

    fovSlider = fovBox:AddSlider("CameraFov", {
        Text = "Field of view",
        Default = FOV_NORMAL,
        Min = FOV_MIN,
        Max = FOV_MAX,
        Rounding = 0,
        Tooltip = "70 is normal",
        Callback = MenuCallback(function()
            if dead or syncing or not fovSwitch.Value then return end
            applyFov()
        end),
    })

    fovBox:SetupDependencies({ { fovSwitch, true } })

    local function fillViews(live)
        local ok, list = Prefs.cameraModes()
        if not ok then return end
        local joined = table.concat(list, "\0")
        if joined ~= shownList then
            shownList = joined
            UiWrite.values(viewDrop, list)
        end
        -- the list only narrows to the views this body really has once a camera exists
        filled = live
    end

    -- with the override off the slider tracks the view's own value, so switching it on starts where the player already is
    local function followFov()
        if fovSwitch.Value then return end
        local ok, value = Prefs.cameraFov()
        if not ok then return end
        value = math.clamp(value, FOV_MIN, FOV_MAX)
        if value == fovSlider.Value then return end
        syncing = true
        UiWrite.value(fovSlider, value)
        syncing = false
    end

    -- the game keeps the view in a plain field with no signal, so the l key can only be seen by reading it
    ctx.track(Jobs.interval(SYNC_SECONDS, function()
        if wantedView then pickView(wantedView) end
        if fovWaiting then applyFov() end

        local live, active = Prefs.cameraMode()
        if not filled then fillViews(live) end
        if not live then return end

        -- the l key moved the view under a hold, so the hold moves too or the next body snaps back to the old pick
        if viewToken and active ~= heldView then holdView(active) end
        showView(active)
        followFov()
    end, { name = "CameraSync" }))

    return {
        cleanup = function()
            dead = true
            if viewToken then viewToken.Restore() end
            if fovToken then fovToken.Restore() end
            viewToken, fovToken = nil, nil
        end,
    }
end

end)
