__bundle_register("Api/Net/GameModules", function(require, _LOADED, __bundle_register, __bundle_modules)
-- net game modules: hands back the live tables of the game's own controllers and modules, the one place in the fork that requires game code; some places destroy PlayerScripts after boot, so it falls back to the orphaned instances and never touches the StarterPlayer template, which would build a second dead copy
local Executor = require("Utility/Executor")

local AERO = "Aero"

-- a leaf name can repeat across the game, so an orphan has to carry the fields its live table always has
local SIGNATURES = {
    Player   = { "ProfileData" },
    Meter    = { "ActivePackets" },
    Movement = { "IsSprinting", "GetAcceleration" },
    Gui      = { "GetComponent" },
}

local M = {}

function M.new(base, ctx)
    local References = ctx.References
    local Replicated = ctx.Services.ReplicatedStorage

    local resolved = {}

    local function playerAero()
        local player = References.player
        local scripts = player and player:FindFirstChild("PlayerScripts")
        return scripts and scripts:FindFirstChild(AERO) or nil
    end

    local function descend(from, path)
        local node = from
        for part in string.gmatch(path, "[^%.]+") do
            if not node then return nil end
            node = node:FindFirstChild(part)
        end
        return node
    end

    local function matches(value, leaf)
        local keys = SIGNATURES[leaf]
        if not keys then return true end
        for _, key in ipairs(keys) do
            if rawget(value, key) == nil then return false end
        end
        return true
    end

    local function fromOrphans(path)
        local ok, list = Executor.call("getloadedmodules")
        if not ok or type(list) ~= "table" then return nil end
        local leaf = string.match(path, "[^%.]+$") or path
        local found
        for _, inst in ipairs(list) do
            local okRead, isMatch = pcall(function()
                return inst.Name == leaf and inst.Parent == nil and inst:IsA("ModuleScript")
            end)
            if okRead and isMatch then
                local okReq, value = pcall(require, inst)
                if okReq and type(value) == "table" and matches(value, leaf) then
                    -- two different tables with no signature to split them would be a coin flip, so refuse
                    if found and found ~= value then return nil end
                    found = value
                end
            end
        end
        return found
    end

    -- a miss is never remembered: game modules can appear after we boot, and a cached nil would kill the feature for the session
    local function grab(kind, rootOf, path)
        if type(path) ~= "string" or path == "" then return nil end
        local key = kind .. path
        local hit = resolved[key]
        if hit and (hit.orphan or hit.inst.Parent) then return hit.value end
        resolved[key] = nil

        local root = rootOf()
        local inst = root and descend(root, path)
        if inst and inst:IsA("ModuleScript") then
            local ok, value = pcall(require, inst)
            if ok and type(value) == "table" then
                resolved[key] = { inst = inst, value = value }
                return value
            end
            base.warn("could not read game module %s: %s", path, tostring(value))
            return nil
        end

        local orphan = fromOrphans(path)
        if orphan then resolved[key] = { orphan = true, value = orphan } end
        return orphan
    end

    local function branch(name)
        return function()
            local aero = playerAero()
            return aero and aero:FindFirstChild(name) or nil
        end
    end

    local controllers = branch("Controllers")
    local modules = branch("Modules")

    local function shared()
        local aero = Replicated:FindFirstChild(AERO)
        return aero and aero:FindFirstChild("Shared") or nil
    end

    if base.maid then
        base.maid:GiveTask(function() table.clear(resolved) end)
    end

    return {
        controller = function(name) return grab("c:", controllers, name) end,
        module     = function(path) return grab("m:", modules, path) end,
        shared     = function(path) return grab("s:", shared, path) end,
    }
end

return M

end)
