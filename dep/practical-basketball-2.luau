local Api    = require("Api")
local Errors = require("Api/Rewards/Errors")

local M = {}

function M.new(ctx)
    local base = Api.define("Rewards", ctx)
    local TasksChanged = base.signal()

    local function net() return ctx.Api and ctx.Api.Net end

    local function tasks()
        local bus = net()
        if not bus then return false, Errors.NO_NET end
        local ok, data = bus.invoke("DailyTaskService", "GetTasks")
        if not ok then return false, data end
        if type(data) ~= "table" or type(data.Tasks) ~= "table" then return false, Errors.NO_DATA end
        return true, data
    end

    -- returns the entries ready to claim out of a task list
    local function finished(data)
        local out = {}
        if type(data) ~= "table" or type(data.Tasks) ~= "table" then return out end
        for _, entry in ipairs(data.Tasks) do
            if entry.Completed == true and entry.Claimed ~= true then out[#out + 1] = entry end
        end
        return out
    end

    -- the game replies (done, fresh task list), so a failed claim still refreshes the caller's view
    local function claim(index)
        if type(index) ~= "number" then return false, Errors.BAD_TASK end
        local bus = net()
        if not bus then return false, Errors.NO_NET end
        local sent, done, data = bus.invokeAllowed("DailyTaskService", "ClaimTask", index)
        if not sent then return false, done end
        if type(data) == "table" then TasksChanged:Fire(data) end
        return done == true, data
    end

