-- filesystem helpers centralising the pcall + warn pattern so call sites don't silently swallow disk failures
local Log = require("Utility/Log")

local M = {}

-- returns (ok, err); warns exactly once per site whether writefile is missing or the write fails
function M.safeWrite(path, body, moduleName)
    local tag = moduleName or "Fs"
    if type(writefile) ~= "function" then
        Log.warn(("[%s] writefile unavailable — %s not persisted"):format(tag, path))
        return false, "no writefile"
    end
    local ok, err = pcall(writefile, path, body)
    if not ok then
        Log.warn(("[%s] writefile failed for %s: %s"):format(tag, path, tostring(err)))
        return false, err
    end
    return true
end

return M

