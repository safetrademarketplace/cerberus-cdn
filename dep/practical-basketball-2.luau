-- references: shared player/character/camera handles + character add/remove subscription api
local Services = require("Services")
local Meta     = require("Meta")

local gameName = Meta.gameName

local References = {
    player           = cloneref(Services.Players.LocalPlayer),
    character        = nil,
    humanoid         = nil,
    humanoidRootPart = nil,
    camera           = cloneref(Services.Workspace.CurrentCamera),
    gameName         = gameName,
    gameDir          = ("Cerberus/%s"):format(gameName),
    executorName     = (identifyexecutor and identifyexecutor()) or "Unknown",
}

-- SessionLifecycle fires _fireCharacter on mutation — subscribe here instead of polling References.character
local addListeners, removeListeners = {}, {}

function References.onCharacter(cb)
    addListeners[#addListeners + 1] = cb
    if References.character then
        pcall(cb, References.character)
    end
    return function()
        for i = #addListeners, 1, -1 do
            if addListeners[i] == cb then table.remove(addListeners, i) end
        end
    end
end

function References.onCharacterRemoving(cb)
    removeListeners[#removeListeners + 1] = cb
    return function()
        for i = #removeListeners, 1, -1 do
            if removeListeners[i] == cb then table.remove(removeListeners, i) end
        end
    end
end

-- iterate a snapshot — a callback that unsubscribes mid-fire would shift the live array and skip the next listener
function References._fireCharacter(char)
    local snap = table.move(addListeners, 1, #addListeners, 1, table.create(#addListeners))
    for _, cb in ipairs(snap) do pcall(cb, char) end
end

function References._fireCharacterRemoving()
    local snap = table.move(removeListeners, 1, #removeListeners, 1, table.create(#removeListeners))
    for _, cb in ipairs(snap) do pcall(cb) end
end

return References

end)
