                    return nil, err
                end
                tokens[#tokens + 1] = token
            end
        end
        if #tokens == 0 then return nil, Errors.NOT_READY end
        return layer.group(tokens)
    end

    return {
        modes   = modes,
        mode    = mode,
        setMode = setMode,
        fov     = fov,
        setFov  = setFov,
    }
end

return M

end)
__bundle_register("Api/Input", function(require, _LOADED, __bundle_register, __bundle_modules)
-- input api: typed verbs over the game's input remotes, the rules its client applies to them, one owner for held presses and the instant input control; on unload nothing stays held and the player's delays are back
local Api     = require("Api")
local Actions = require("Api/Input/Actions")
local Errors  = require("Api/Input/Errors")
local Held    = require("Api/Input/Held")
local Instant = require("Api/Input/Instant")
local Rules   = require("Api/Input/Rules")

local SERVICE = "InputService"

local M = {}

function M.new(ctx)
    local base = Api.define("Input", ctx)

    local function net()
        return ctx.Api and ctx.Api.Net or nil
    end

    local function send(remote, ...)
        local bus = net()
        if not bus then return false, Errors.NO_NET end
        return bus.send(SERVICE, remote, ...)
    end

    local held    = Held.new(base, send)
    local actions = Actions.new(ctx, send, held, net)
    local rules   = Rules.new(ctx, base, net)
    local instant = Instant.new(base, net)

    -- server to client: fn(level, text), level being "Log", "Warn" or "Error"
    local function onServerLog(fn)
        if type(fn) ~= "function" then return nil, Errors.BAD_ARGS end
        local bus = net()
        if not bus then return nil, Errors.NO_NET end
        return bus.on(SERVICE, "Output", fn)
    end

    if base.maid then
        base.maid:GiveTask(function()
            base.safe("release held presses", held.releaseAll)
            base.safe("restore input delays", instant.disable)
        end)
    end

    base.log("input api ready")

    return {
        Errors = Errors,

        shootPress      = actions.shootPress,
        shootRelease    = actions.shootRelease,
        jump            = actions.jump,
        sprint          = actions.sprint,
        steal           = actions.steal,
        pass            = actions.pass,
        dribble         = actions.dribble,
        holdG           = actions.holdG,
        clutch          = actions.clutch,
        screen          = actions.screen,
        dropBall        = actions.dropBall,
        intentionalFoul = actions.intentionalFoul,
        emote           = actions.emote,
        celebrate       = actions.celebrate,

        legal = rules.legal,

        held        = held.held,
        releaseHeld = held.releaseAll,

        onServerLog = onServerLog,

        instant = instant,
    }
end

return M

end)
