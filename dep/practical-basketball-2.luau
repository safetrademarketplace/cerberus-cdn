    local function saveAutoShowState(value)
        if not (writefile and Services.HttpService and References.gameName) then return end
        local settingsDir = string.format("Cerberus/%s/settings", References.gameName)
        if makefolder and not isfolder(settingsDir) then
            pcall(function() makefolder(settingsDir) end)
        end
        local stateFile = string.format("Cerberus/%s/settings/autoshow_state.json", References.gameName)
        local data = { autoshow = value }
        local okEncode, encoded = pcall(Services.HttpService.JSONEncode, Services.HttpService, data)
        if okEncode and type(encoded) == "string" then
            pcall(function() writefile(stateFile, encoded) end)
