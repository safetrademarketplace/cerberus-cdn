__bundle_register("Api/Player/Tracker", function(require, _LOADED, __bundle_register, __bundle_modules)
-- player tracker: the one place that knows which body and physics proxy are ours, from events alone; bodies are recycled by renaming in place, so a handle only holds while its name and parent both do, and a miss is re-read rather than remembered
local Signal = require("Api/Player/Signal")

local CHARACTERS = "Characters"
local PROXY      = "ProxyCharacter"
local ROOT       = "HumanoidRootPart"
local HUMANOID   = "Humanoid"

local M = {}

function M.new(base, ctx)
    local Workspace = ctx.Services.Workspace
    local player    = ctx.References.player
    local maid      = base.maid

    local CharacterChanged, fireChanged = Signal.new(base)

    local modelListeners, proxyListeners = {}, {}
    local nameConns = {}
    local folder, addedConn, removedConn
    local current, pending, pendingConn
    local proxy, rootPart, humanoidPart
    local closed = false

    local function isMine(model)
        return model.Parent ~= nil and model.Name == player.Name
    end

    -- internal listeners run in order and first, so a public subscriber always reads a rebound api
    local function publish(model)
        if current == model then return end
        current, rootPart, humanoidPart = model, nil, nil
        for _, fn in ipairs(modelListeners) do base.safe("character listener", fn, model) end
        fireChanged(model)
    end

    local function clearPending()
        if pendingConn then pendingConn:Disconnect() end
        pending, pendingConn = nil, nil
    end

    -- a fresh clone replicates its parts after the model, so a partial rig waits on its own events and is never published
    local function adopt(model)
        if model == current then
            clearPending()
            return
        end
        if model:FindFirstChildOfClass(HUMANOID) and model:FindFirstChild(ROOT) then
            clearPending()
            publish(model)
            return
        end
        if pending == model then return end
        clearPending()
        pending = model
        pendingConn = model.ChildAdded:Connect(function()
            if pending ~= model then return end
            if isMine(model) then adopt(model) else clearPending() end
        end)
    end

    local function rescan()
        local found = folder and folder:FindFirstChild(player.Name) or nil
        if found and found:IsA("Model") then
            adopt(found)
        else
            clearPending()
            publish(nil)
        end
    end

    local function onRenamed(child)
        if child.Name == player.Name then
            adopt(child)
        elseif child == current or child == pending then
            rescan()
        end
    end

    -- every pooled body gets one, because a dummy becomes ours by being renamed and nothing else announces it
    local function watch(child)
        if nameConns[child] or not child:IsA("Model") then return end
        nameConns[child] = child:GetPropertyChangedSignal("Name"):Connect(function() onRenamed(child) end)
    end

    local function unbindFolder()
        if addedConn then addedConn:Disconnect() end
        if removedConn then removedConn:Disconnect() end
        addedConn, removedConn, folder = nil, nil, nil
        for child, conn in pairs(nameConns) do
            conn:Disconnect()
            nameConns[child] = nil
        end
    end

    local function bindFolder(found)
        if folder == found then return end
        unbindFolder()
        folder = found
        if not found then return end
        addedConn = found.ChildAdded:Connect(function(child)
            watch(child)
            if child.Name == player.Name and child:IsA("Model") then adopt(child) end
        end)
        removedConn = found.ChildRemoved:Connect(function(child)
            local conn = nameConns[child]
            if conn then
                conn:Disconnect()
                nameConns[child] = nil
            end
            if child == current or child == pending then rescan() end
        end)
        for _, child in ipairs(found:GetChildren()) do watch(child) end
    end

    local function setProxy(part)
        if proxy == part then return end
        proxy = part
        for _, fn in ipairs(proxyListeners) do base.safe("proxy listener", fn, part) end
    end

    -- closed stops a late read at unload from rebinding what was just released
    local function model()
        if closed then return nil end
        if current and isMine(current) then return current end
        if not folder then bindFolder(Workspace:FindFirstChild(CHARACTERS)) end
        rescan()
        return current
    end

    local function root()
        local body = model()
        if not body then return nil end
        if rootPart and rootPart.Parent == body then return rootPart end
        rootPart = body:FindFirstChild(ROOT)
        return rootPart
    end

    local function humanoid()
        local body = model()
        if not body then return nil end
        if humanoidPart and humanoidPart.Parent == body then return humanoidPart end
        humanoidPart = body:FindFirstChildOfClass(HUMANOID)
        return humanoidPart
    end

    local function proxyPart()
        if not model() then return nil end
        if proxy and proxy.Parent then return proxy end
        local part = Workspace:FindFirstChild(PROXY)
        if part and part:IsA("BasePart") then
            setProxy(part)
            return part
        end
        setProxy(nil)
        return nil
    end

    -- the game's own physics object: only valid while it belongs to the current body, since LoadCharacter yields with the destroyed one still assigned
    local function state()
        local net = ctx.Api and ctx.Api.Net
        local live = net and net.playerState()
        if not (live and model()) then return nil end
        local data, part = live.data, live.ProxyCharacter
        if not (data and part and part.Parent and data.model and isMine(data.model)) then return nil end
        return live
    end

    local function cframe()
        local part = proxyPart() or root()
        return part and part.CFrame or nil
    end

    local function position()
        local part = proxyPart() or root()
        return part and part.Position or nil
    end

    maid:GiveTask(Workspace.ChildAdded:Connect(function(child)
        local name = child.Name
        if name == CHARACTERS then
            bindFolder(child)
            rescan()
        elseif name == PROXY and child:IsA("BasePart") then
            setProxy(child)
        end
    end))
    maid:GiveTask(Workspace.ChildRemoved:Connect(function(child)
        if child == folder then
            bindFolder(nil)
            rescan()
        elseif child == proxy then
            setProxy(nil)
        end
    end))

    bindFolder(Workspace:FindFirstChild(CHARACTERS))
    rescan()
    local existing = Workspace:FindFirstChild(PROXY)
    if existing and existing:IsA("BasePart") then proxy = existing end

    return {
        CharacterChanged = CharacterChanged,
        model            = model,
        root             = root,
        humanoid         = humanoid,
        proxy            = proxyPart,
        state            = state,
        cframe           = cframe,
        position         = position,
        onModel          = function(fn) modelListeners[#modelListeners + 1] = fn end,
        onProxy          = function(fn) proxyListeners[#proxyListeners + 1] = fn end,
        clear            = function()
            closed = true
            clearPending()
            unbindFolder()
            current, proxy, rootPart, humanoidPart = nil, nil, nil, nil
            table.clear(modelListeners)
            table.clear(proxyListeners)
        end,
    }
end

return M

end)
__bundle_register("Api/Player/Signal", function(require, _LOADED, __bundle_register, __bundle_modules)
-- player signal: Api.signal behind a connect-only face whose handles also have Destroy, because Utility/Maid silently skips a table task without one
local M = {}

function M.new(base)
    local inner = base.signal()
    local face = {}

    function face:Connect(fn)
        local conn = inner:Connect(fn)
        local handle = {}
        function handle.Disconnect() conn:Disconnect() end
        handle.Destroy = handle.Disconnect
        return handle
    end

    return face, function(...) inner:Fire(...) end
end

return M

end)
__bundle_register("Api/Player/Profile", function(require, _LOADED, __bundle_register, __bundle_modules)
-- player profile: read-only views of our gameplay state, the build's stats, stamina and takeover, all through the attribute layer and the player controller so nothing else reads SlotData or the takeover config
local Signal = require("Api/Player/Signal")

local FULL_STAMINA    = 100
local FULL_TAKEOVER   = 100
local GROUND_MARGIN   = 0.1
local TAKEOVER_CONFIG = "Config.Takeover"

local M = {}

function M.new(base, ctx, tracker, attrs)
    local TakeoverChanged, fireTakeover = Signal.new(base)

    local function net()
        return ctx.Api and ctx.Api.Net
    end

    local function slot()
        local api = net()
        local controller = api and api.controller("Player")
        local data = controller and controller.SlotData
        return type(data) == "table" and data or nil
    end

    local function action()
        local value = attrs.attr("Action")
        return type(value) == "string" and value or nil
    end

    local function isOnCourt()
        return attrs.attr("OnCourt") and true or false
    end

    -- the game's own predicate, so forward-only and server-driven sprinting read exactly as its speed code sees them
    local function isSprinting()
        local state = tracker.state()
        local movement = state and state.Movement
        if movement then
            local ok, sprinting = pcall(movement.IsSprinting, movement)
            if ok then return sprinting and true or false end
        end
        return attrs.attr("Sprinting") and true or false
    end

    -- a hop pins the proxy without the server's InAir, so height above the game's own ground read counts too
    local function inAir()
        if attrs.attr("InAir") then return true end
        local state = tracker.state()
        local ground = state and state.lastValidHeight
        local proxy = state and tracker.proxy()
        if type(ground) ~= "number" or not proxy then return false end
        return proxy.Position.Y > ground + GROUND_MARGIN
    end

    -- Team is what the game compares between players; TeamIndex is the home or away side
    local function team()
        return attrs.attr("Team"), attrs.attr("TeamIndex")
    end

    local function stat(name)
        local data = slot()
        local groups = data and data.Attributes
        if type(groups) ~= "table" then return nil end
        for _, group in pairs(groups) do
            local value = type(group) == "table" and group[name]
            if type(value) == "number" then return value end
        end
        return nil
    end

    local function build()
        local data = slot()
        if not data then return nil end
        local info = type(data.Info) == "table" and data.Info or {}
        local vitals = type(data.Vitals) == "table" and data.Vitals or {}
        return {
            name       = info.BuildName,
            position   = info.Position,
            hand       = info.DominantHand,
            takeover   = info.Takeover,
            height     = vitals.Height,
            wingspan   = vitals.Wingspan,
            info       = info,
            vitals     = vitals,
            attributes = data.Attributes,
        }
    end

    local function capacity(read)
        local max = read("MaxStamina")
        return (type(max) == "number" and max > 0) and max or FULL_STAMINA
    end

    local function stamina()
        local current = attrs.attr("Stamina")
        if type(current) ~= "number" then return nil end
        return current, capacity(attrs.attr)
    end

    local function trueStamina()
        local current = attrs.trueAttr("Stamina")
        if type(current) ~= "number" then return nil end
        return current, capacity(attrs.trueAttr)
    end

    -- the build's pick is what the movement code buffs from; TakeoverType only dresses the ground decal
    local function takeoverKind()
        local data = slot()
        local info = data and data.Info
        local picked = type(info) == "table" and info.Takeover
        if type(picked) == "string" and picked ~= "" then return picked end
        local shown = attrs.attr("TakeoverType")
        if type(shown) == "string" and shown ~= "" then return shown end
        return nil
    end

    local function takeover()
        if not tracker.model() then return nil end
        local fill = attrs.attr("TakeoverFill")
        fill = type(fill) == "number" and fill or 0
        local active = attrs.attr("Takeover") and true or false
        return {
            fill   = fill,
            active = active,
            ready  = not active and fill >= FULL_TAKEOVER,
            kind   = takeoverKind(),
        }
    end

    local function takeoverBoosts(kind)
        kind = kind or takeoverKind()
        local api = net()
        local config = api and api.shared(TAKEOVER_CONFIG)
        local entry = (type(kind) == "string" and config) and config[kind] or nil
        if type(entry) ~= "table" then return nil end
        local attributes, info = {}, {}
        if type(entry.Attributes) == "table" then
            for name, amount in pairs(entry.Attributes) do
                if amount ~= 0 then attributes[name] = amount end
            end
        end
        if type(entry.Info) == "table" then
            for name, value in pairs(entry.Info) do info[name] = value end
        end
        return { attributes = attributes, info = info }
    end

    local last = takeover()

    -- one body change moves all three attributes, so only a real difference gets reported
    local function reportTakeover()
        local now = takeover()
        if now and last and now.fill == last.fill and now.active == last.active and now.kind == last.kind then return end
        if not now and not last then return end
        last = now
        fireTakeover(now)
    end

    attrs.onAttr("Takeover", reportTakeover)
    attrs.onAttr("TakeoverFill", reportTakeover)
    attrs.onAttr("TakeoverType", reportTakeover)
    -- a body with none of them set still takes this from nil to an empty bar
    tracker.onModel(reportTakeover)

    return {
        TakeoverChanged = TakeoverChanged,
        action          = action,
        isOnCourt       = isOnCourt,
        isSprinting     = isSprinting,
        inAir           = inAir,
        team            = team,
        stat            = stat,
        build           = build,
        stamina         = stamina,
        trueStamina     = trueStamina,
        takeover        = takeover,
        takeoverBoosts  = takeoverBoosts,
    }
end

return M

end)
__bundle_register("Api/Player/Levers", function(require, _LOADED, __bundle_register, __bundle_modules)
-- player levers: speed, sprint and noclip, the holds that leave ownership of the proxy alone; each stacks as tokens and follows the character across respawns without the caller doing anything
local Errors = require("Api/Player/Errors")
local Limits = require("Api/Player/Limits")
local Tokens = require("Api/Player/Tokens")

local MOVEMENT = "Components.Character.Movement"

-- the types that walk on the ground; seats, vehicles and the tip-off keep their own speed
local GROUND = { Base = true, Guard = true, Post = true, Retreat = true, Boxout = true, BoxoutPlayer = true, Call = true }

local M = {}

function M.new(base, ctx, tracker, attrs)
    local forced
    local hookModule, hookOriginal, hook
    local holdingCollide, collideConn, collideRelease
    local closed = false

    -- an idle body keeps its last Direction, so forcing without input would walk it off on its own; and while CanMove is off the server is steering
    local function force(movement, speed)
        if not GROUND[movement.CurrentMovementType] then return end
        if not movement.State:GetAttribute("CanMove") then return end
        if movement.MoveDirection.Magnitude <= 0 then return end
        movement.WalkSpring:SetPosition(speed)
        movement.MovementVelocity.Velocity = movement.Direction * speed
    end

    -- Update is the one dispatch every movement type goes through, so this covers them all with a single swap on the class
    local function install()
        if hook then return true end
        local net = ctx.Api and ctx.Api.Net
        local module = net and net.module(MOVEMENT)
        local original = type(module) == "table" and rawget(module, "Update") or nil
        if type(original) ~= "function" then return false end
        hookModule, hookOriginal = module, original
        hook = function(self, dt)
            original(self, dt)
            local speed = forced
            if speed then force(self, speed) end
        end
        module.Update = hook
        return true
    end

    local function uninstall()
        if not hook then return end
        if rawget(hookModule, "Update") == hook then hookModule.Update = hookOriginal end
        hookModule, hookOriginal, hook = nil, nil, nil
    end

    local speeds = Tokens.stack(function(value)
        forced = value
        if value == nil then uninstall() end
    end)

    local function setSpeed(studsPerSecond)
        if type(studsPerSecond) ~= "number" or studsPerSecond ~= studsPerSecond or studsPerSecond < 0 then
            return nil, Errors.BAD_ARGS
        end
        if closed or not install() then return nil, Errors.NO_MOVEMENT end
        return speeds.push(math.min(studsPerSecond, Limits.maxSpeed))
    end

    -- the attribute write reaches IsSprinting through the mirror; sprinting at zero stamina also needs a Stamina override, because the speed code reads that off the instance
    local function forceSprint()
        return attrs.overrideAttr("Sprinting", true)
    end

    local function dropCollideWatch()
        if collideConn then collideConn:Disconnect() end
        collideConn = nil
    end

    -- the proxy is re-cloned on respawn with collisions on, and the game only writes them at creation, so a change event is enough
    local function holdCollide(part)
        dropCollideWatch()
        if not part then return end
        part.CanCollide = false
        collideConn = part:GetPropertyChangedSignal("CanCollide"):Connect(function()
            if part.CanCollide then part.CanCollide = false end
