        local seeded, position, facing

        -- the state is rebuilt on respawn, so a new one re-seeds from the new proxy and the flight simply carries on
        local function step(dt)
            local part, live = tracker.proxy(), tracker.state()
            if not (part and live) then return end
            if live ~= seeded then
                seeded, position = live, part.Position
                facing = flatFacing(part.CFrame.LookVector, facing or Vector3.new(0, 0, -1))
            end
            local direction = flightDirection(live)
            if direction.Magnitude > 0 then
                local unit = direction.Unit
                position = clampToWorld(position + unit * (rate() * dt), edge)
                facing = flatFacing(unit, facing)
            end
            pin(live, CFrame.lookAt(position, position + facing))
        end

        local claim, err = arbiter.claim("flight", step, { keepOnRespawn = true, onRelease = unpin })
        if not claim then return nil, err end
        -- held where it stands until the first step, so nothing drops for a frame
        pin(state, proxy.CFrame)
        return function() claim.finish("stopped") end
    end

    -- walks on the ground the game itself reads under us, so a target's height only matters as a place on the floor
    local function moveTo(target, speedGetter)
        local rate = rateOf(speedGetter)
        if not rate then return nil, Errors.BAD_ARGS end
        local edge = worldEdge()
        local goalOf
        if type(target) == "function" then
            goalOf = function()
                local ok, value = pcall(target)
                return ok and toPosition(value) or nil
            end
        else
            local fixed = toPosition(target)
            if not fixed then return nil, Errors.BAD_ARGS end
            if not inWorld(fixed, edge) then return nil, Errors.OUT_OF_RANGE end
            goalOf = function() return fixed end
        end
        if not (tracker.proxy() and tracker.state()) then return nil, Errors.NO_CHARACTER end

        local status = "running"
        local stopNoclip
        local claim, best, bestAt

        local function step(dt)
            local proxy, state = tracker.proxy(), tracker.state()
            if not (proxy and state) then
                claim.finish("lost")
                return
            end
            local goal = goalOf()
            if not goal then
                claim.finish("lost target")
                return
            end
            local from = proxy.Position
            local flat = Vector3.new(goal.X - from.X, 0, goal.Z - from.Z)
            local distance = flat.Magnitude
            if distance <= ARRIVE_RADIUS then
                claim.finish("arrived")
                return
            end
            local now = os.clock()
            if type(target) ~= "function" then
                if not best or distance < best - STALL_PROGRESS then
                    best, bestAt = distance, now
                elseif now - bestAt > STALL_SECONDS then
                    claim.finish("stalled")
                    return
                end
            end
            local stride = math.min(distance, rate() * dt)
            if stride <= 0 then return end
            local heading = flat.Unit
            local ground = state.lastValidHeight
            local height = type(ground) == "number" and ground or from.Y
            local nextAt = Vector3.new(from.X + heading.X * stride, height, from.Z + heading.Z * stride)
            -- faced by hand, because the turn gyro cannot steer a body whose cframe is rewritten every frame
            place(state, proxy, CFrame.lookAt(nextAt, nextAt + heading))
        end

        local err
        claim, err = arbiter.claim("moveTo", step, {
            onRelease = function(reason)
                status = reason or "finished"
                if stopNoclip then stopNoclip() end
                stopNoclip = nil
            end,
        })
        if not claim then return nil, err end
        stopNoclip = levers.setNoclip(true)

        local handle = {}
        function handle.Cancel() claim.finish("cancelled") end
        handle.Disconnect = handle.Cancel
        handle.Destroy = handle.Cancel
        function handle.IsRunning() return arbiter.isOwner(claim) end
        function handle.Status() return status end
        return handle
    end

    -- with hold set (seconds, or true for until released) the arrival is pinned as a claim; without it this is one atomic write that owns nothing, and the restore has nothing left to do
    local function teleport(target, hold)
        local cf = target
        if typeof(target) == "Vector3" then cf = CFrame.new(target) end
        if typeof(cf) ~= "CFrame" then return nil, Errors.BAD_ARGS end
        if hold ~= nil and hold ~= true and not (type(hold) == "number" and hold > 0) then
            return nil, Errors.BAD_ARGS
        end
        if not inWorld(cf.Position, worldEdge()) then return nil, Errors.OUT_OF_RANGE end
        local proxy, state = tracker.proxy(), tracker.state()
        if not (proxy and state) then return nil, Errors.NO_CHARACTER end
        if arbiter.owner() then return nil, Errors.BUSY end
        place(state, proxy, cf)
        if not hold then return function() end end

        local deadline = type(hold) == "number" and os.clock() + hold or nil
        local claim, err
        claim, err = arbiter.claim("teleport", function()
            if deadline and os.clock() >= deadline then
                claim.finish("expired")
                return
            end
            local live = tracker.state()
            if live then pin(live, cf) end
        end, { onRelease = unpin })
        if not claim then return nil, err end
        pin(state, cf)
        return function() claim.finish("released") end
    end

    -- a client-side arc on the pin, since jump height belongs to the server; while airborne it steers from the game's own direction and speed, so a speed override carries into the air
    local function hop(height)
        if type(height) ~= "number" or height ~= height or height <= 0 then return nil, Errors.BAD_ARGS end
        local proxy, state = tracker.proxy(), tracker.state()
        if not (proxy and state) then return nil, Errors.NO_CHARACTER end
        local owner = arbiter.owner()
        if owner then
            if owner.kind ~= "hop" then return nil, Errors.BUSY end
            owner.finish("relaunched")
        end

        local gravity = Workspace.Gravity
        local rise = math.sqrt(2 * gravity * height)
        local launch = proxy.AssemblyLinearVelocity
        local drift = Vector3.new(launch.X, 0, launch.Z)
        local position = proxy.Position
        local facing = flatFacing(proxy.CFrame.LookVector, Vector3.new(0, 0, -1))
        local edge = worldEdge()
        local startedAt = os.clock()
        local claim

        local function step(dt)
            local part, live = tracker.proxy(), tracker.state()
            if not (part and live) then
                claim.finish("lost")
                return
            end
            local movement = live.Movement
            if movement and movement.MoveDirection.Magnitude > 0 then
                drift = movement.Direction * movement.WalkSpring:GetPosition()
            end
            rise = rise - gravity * dt
            position = clampToWorld(position + (drift + Vector3.new(0, rise, 0)) * dt, edge)
            facing = flatFacing(drift, facing)
            local ground = live.lastValidHeight
            if rise <= 0 and type(ground) == "number" and position.Y <= ground then
                local landing = Vector3.new(position.X, ground, position.Z)
                place(live, part, CFrame.lookAt(landing, landing + facing))
                claim.finish("landed")
                return
            end
            -- a missing ground read would otherwise leave the character hanging in the air
            if os.clock() - startedAt > MAX_HANG then
                claim.finish("timed out")
                return
            end
            pin(live, CFrame.lookAt(position, position + facing))
        end

        local err
        claim, err = arbiter.claim("hop", step, { onRelease = unpin })
        if not claim then return nil, err end
        return function() claim.finish("cancelled") end
    end

    tracker.onModel(function()
        local owner = arbiter.owner()
        if owner and not owner.keepOnRespawn then owner.finish("lost") end
        unpin()
    end)

    return {
        startFlight = startFlight,
        moveTo      = moveTo,
        teleport    = teleport,
        hop         = hop,
        motionOwner = function()
            local owner = arbiter.owner()
            return owner and owner.kind or nil
        end,
        clear       = function()
            arbiter.clear()
            unpin()
        end,
    }
end

return M

end)
