__bundle_register("Api/Prefs/Layer", function(require, _LOADED, __bundle_register, __bundle_modules)
-- prefs layer: one stack per lever, whatever the lever drives, so tokens restore in any order and hold against the game re-asserting; the value underneath follows the game's own writes, so a restore only ever puts back what the game last said
local Jobs = require("Utility/Jobs")

local GUARD_SECONDS = 1

local M = {}

local function newToken(undo)
    local token = {}
    local spent = false
    function token.Restore()
        if spent then return false end
        spent = true
        return undo()
    end
    -- maid and track each call their own verb, and maid drops a table that has no Destroy
    token.Destroy = token.Restore
    token.Disconnect = token.Restore
    return token
end

function M.new(base, onGuardTick)
    local slots, count = {}, 0
    local guard

    local function top(slot)
        return slot.stack[#slot.stack].value
    end

    local function put(slot, value)
        slot.binding.write(value)
        slot.written = value
        slot.binding.touched()
    end

    -- a swapped table is the server speaking and a value we did not write is the game's menu speaking; either one is the new truth underneath
    local function follow(slot)
        local binding = slot.binding
        if not binding.live or not binding.ready() then return end
        local generation = binding.generation()
        local current = binding.read()
        if generation ~= slot.generation or current ~= slot.written then
            slot.generation = generation
            slot.base = current
            slot.written = current
        end
    end

    local function sweep()
        for _, slot in pairs(slots) do
            local binding = slot.binding
            if binding.live and binding.ready() then
                follow(slot)
                local want = top(slot)
                if binding.read() ~= want then put(slot, want) end
            end
        end
    end

    -- ProfileUpdated is the real trigger; this catches the game's own menu writing an overridden setting, which fires nothing
    local function startGuard()
        if guard then return end
        guard = Jobs.interval(GUARD_SECONDS, function()
            base.safe("sweep", sweep)
            onGuardTick()
        end, { name = "PrefsGuard" })
    end

    local function stopGuard()
        if not guard then return end
        guard:Cancel()
        guard = nil
    end

    local function release(slot, entry)
        local index = table.find(slot.stack, entry)
        if not index then return false end
        follow(slot)
        local wasTop = index == #slot.stack
        table.remove(slot.stack, index)
        if #slot.stack == 0 then
            slots[slot.binding.key] = nil
            count = count - 1
            if count == 0 then stopGuard() end
            put(slot, slot.base)
        elseif wasTop then
            put(slot, top(slot))
        end
        return true
    end

    local function push(binding, value)
        local slot = slots[binding.key]
        if slot then
            follow(slot)
        else
            local current = binding.read()
            slot = {
                binding    = binding,
                stack      = {},
                base       = current,
                written    = current,
                generation = binding.live and binding.generation() or nil,
            }
            slots[binding.key] = slot
            count = count + 1
            startGuard()
        end
        local entry = { value = value }
        slot.stack[#slot.stack + 1] = entry
        put(slot, value)
        return newToken(function() return release(slot, entry) end)
    end

    local function group(tokens)
        return newToken(function()
            local undid = false
            for i = #tokens, 1, -1 do undid = tokens[i].Restore() or undid end
            return undid
        end)
    end

    -- a real save landing under an override moves the value it will restore to; false means nothing holds this key
    local function setBase(key, value)
        local slot = slots[key]
        if not slot then return false end
        follow(slot)
        slot.base = value
        return true
    end

    local function baseOf(key)
        local slot = slots[key]
        if not slot then return false, nil end
        follow(slot)
        return true, slot.base
    end

    local function active()
        local out = {}
        for key, slot in pairs(slots) do
            follow(slot)
            out[key] = { value = top(slot), base = slot.base, depth = #slot.stack }
        end
        return out
    end

    local function restoreAll()
        stopGuard()
        for _, slot in pairs(slots) do
            follow(slot)
            slot.stack = {}
            put(slot, slot.base)
        end
        table.clear(slots)
        count = 0
    end

    return {
        push       = push,
        group      = group,
        sweep      = sweep,
        setBase    = setBase,
        baseOf     = baseOf,
        active     = active,
        restoreAll = restoreAll,
    }
end

return M

end)
