                            lit[#lit + 1] = inst
                        end
                    end
                end
            end
        end,
    }

    local function setSparks(on)
        return layer.push(sparksBinding, on == true)
    end

    return {
        setCrowd         = setCrowd,
        setShadows       = setShadows,
        setNets          = setNets,
        setGreenEffects  = setGreenEffects,
        setBadgeEffects  = setBadgeEffects,
        setStreakEffects = setStreakEffects,
        setShotCamera    = setShotCamera,
        setHairPhysics   = setHairPhysics,
        setSparks        = setSparks,
        setScenery       = setScenery,
        setEventEffects  = setEventEffects,
        crowdCount       = crowdCount,
    }
