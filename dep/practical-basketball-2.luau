__bundle_register("UI/Scrim", function(require, _LOADED, __bundle_register, __bundle_modules)
-- scrim: full-viewport backdrop geometry for modals living inside a ScreenGui they do not own, where IgnoreGuiInset being off leaves the topbar strip undimmed

local Services = require("Services")

local M = {}

-- how far the gui's own origin sits below the true top of the screen, zero when it already ignores the inset
function M.topInset(screenGui)
    if screenGui and screenGui.IgnoreGuiInset then return 0 end
    local ok, inset = pcall(function() return Services.GuiService:GetGuiInset() end)
    if not ok or typeof(inset) ~= "Vector2" then return 0 end
    return inset.Y
end

-- size a frame to the whole screen rather than the whole ScreenGui; host defaults to the frame's own ancestry so a caller cannot pass the wrong one
function M.cover(frame, screenGui)
    local host = screenGui or frame:FindFirstAncestorWhichIsA("ScreenGui")
    local inset = M.topInset(host)
    frame.Position = UDim2.fromOffset(0, -inset)
    frame.Size = UDim2.new(1, 0, 1, inset)
    return frame
end

return M

end)
__bundle_register("UI/Premium", function(require, _LOADED, __bundle_register, __bundle_modules)
-- premium gate: any element built with `Premium = true` renders normally but, while the gate is shut, swallows clicks behind an upsell overlay, no-ops its callbacks and rejects every value mutation including config loads, replaying the last rejected mutation if entitlement lands afterwards

local Jobs = require("Utility/Jobs")
local Log  = require("Utility/Log")

local M = {}

-- until configure() wires the real predicate nothing is locked
local lockPredicate = function() return false end
local popupFn       = function() end
local Library

-- strict adds take (idx, info) and register the element under that idx; addons take the same shape but return the parent element and build into its label
local STRICT = {
    AddToggle = true, AddCheckbox = true, AddSlider = true, AddDropdown = true,
    AddInput = true, AddViewport = true, AddImage = true, AddVideo = true,
    AddUIPassthrough = true, AddKeyPicker = true, AddColorPicker = true,
}
local ADDON = { AddKeyPicker = true, AddColorPicker = true }
local LOOSE = { "AddButton", "AddLabel" }

local CALLBACKS = { "Callback", "Func", "Changed", "ChangedCallback", "Clicked" }
local MUTATORS  = { "SetValue", "SetValueRGB" }

-- covering a frame that arranges its children would add the overlay as one more flex item, so descend instead of filling
local MAX_COVER_DEPTH = 3

-- long enough for an in-flight key check to settle, so an entitled user never sees the notice
local SKIP_NOTICE_DELAY = 6

local overlays = {}   -- click-catchers we own, so one refresh retargets them all
local gated    = {}   -- premium elements whose value mutators we own
local skipNoticeArmed = false

local function isLocked()
    local ok, res = pcall(lockPredicate)
    return ok and res == true
end
M.isLocked = isLocked

local function noteSkipped()
    if skipNoticeArmed or not Library then return end
    skipNoticeArmed = true
    Jobs.delay(SKIP_NOTICE_DELAY, function()
        if not isLocked() then
            skipNoticeArmed = false
            return
        end
        pcall(Library.Notify, Library,
            "Some options in that config are premium only, so they were left switched off.", 7)
    end, { name = "PremiumSkipNotice" })
end

local function replay(entry)
    for name, call in pairs(entry.pending) do
        local orig = entry.originals[name]
        if orig then pcall(orig, entry.element, table.unpack(call, 1, call.n)) end
    end
    table.clear(entry.pending)
end

-- point every overlay at the current lock state, dropping dead ones, then release anything a config tried to set while the gate was shut
local function refresh()
    local shut = isLocked()
    for i = #overlays, 1, -1 do
        local ov = overlays[i]
        if not (ov and ov.Parent) then
            table.remove(overlays, i)
        else
            ov.Visible = shut
        end
    end
    if shut then return end
    skipNoticeArmed = false
    for _, entry in ipairs(gated) do replay(entry) end
end
M.refresh = refresh

function M.configure(opts)
    if type(opts) ~= "table" then return end
    if type(opts.isLocked) == "function" then lockPredicate = opts.isLocked end
    if type(opts.showPopup) == "function" then popupFn = opts.showPopup end
    refresh()
end

-- a premium callback no-ops while locked so keybinds and dependency boxes can't drive it either
local function guard(fn)
    if type(fn) ~= "function" then return fn end
    return function(...)
        if isLocked() then return end
        return fn(...)
    end
end

local function guardInfo(info)
    for _, key in ipairs(CALLBACKS) do
        if type(info[key]) == "function" then info[key] = guard(info[key]) end
    end
end

-- obsidian stores each element's mutators on the element table itself, so wrapping them there catches every write path: autoload, shared configs and scripted SetValue alike
local function gateValues(element)
    if type(element) ~= "table" or rawget(element, "__cerbPremium") then return end

    local entry = { element = element, originals = {}, pending = {} }
    for _, name in ipairs(MUTATORS) do
        local orig = rawget(element, name)
        if type(orig) == "function" then
            entry.originals[name] = orig
            element[name] = function(self, ...)
                if not isLocked() then return orig(self, ...) end
                entry.pending[name] = table.pack(...)
                noteSkipped()
            end
        end
    end
    if not next(entry.originals) then return end

    rawset(element, "__cerbPremium", true)
    gated[#gated + 1] = entry
end

-- transparent click-catcher filling a target; only visible, and thus only blocking, while locked
local function lockFrame(frame)
    local overlay = Instance.new("TextButton")
    overlay.Name = "__cerb_premium_lock"
    overlay.Text = ""
    overlay.AutoButtonColor = false
    overlay.BackgroundTransparency = 1
    overlay.BorderSizePixel = 0
    overlay.Size = UDim2.fromScale(1, 1)
    overlay.ZIndex = 60
    overlay.Visible = isLocked()
    overlay.Parent = frame
    overlay.MouseButton1Click:Connect(function()
        if isLocked() then pcall(popupFn) end
    end)
    overlays[#overlays + 1] = overlay
end

local function installLockOn(frame, depth)
    if not (typeof(frame) == "Instance" and frame:IsA("GuiObject")) then return end
    depth = depth or 1

    local arranged = frame:FindFirstChildOfClass("UIListLayout")
        or frame:FindFirstChildOfClass("UIGridLayout")
    if arranged and depth < MAX_COVER_DEPTH then
        local covered = false
        for _, child in ipairs(frame:GetChildren()) do
            if child:IsA("GuiObject") then
                installLockOn(child, depth + 1)
                covered = true
            end
        end
        if covered then return end
    end

    lockFrame(frame)
end

local function snapshot(container)
    local set = {}
    for _, c in ipairs(container:GetChildren()) do set[c] = true end
    return set
end

local function coverNew(host, before)
    for _, child in ipairs(host:GetChildren()) do
        if not before[child] then installLockOn(child) end
    end
end

-- addons build into the parent element's label rather than the groupbox container
local function overlayHost(self, name)
    local host = ADDON[name] and (self.TextLabel or self.Base) or self.Container
    if typeof(host) == "Instance" and host:IsA("GuiObject") then return host end
    return nil
end

-- the first table arg carrying `Premium = true`; works for both strict (self,idx,info) and loose (self,text|info,...) add shapes
local function findPremiumInfo(...)
    for i = 1, select("#", ...) do
        local a = select(i, ...)
        if type(a) == "table" and a.Premium == true then return a end
    end
    return nil
end

local function resolveElement(idx)
    if type(idx) ~= "string" or not Library then return nil end
    local toggles, options = Library.Toggles, Library.Options
    return (toggles and toggles[idx]) or (options and options[idx]) or nil
end

-- keypicker and colorpicker hang off a second shared funcs table only reachable through an element, so it is patched the first time one comes back
local addonFuncs
local wrapAdd

-- buttons copy AddKeyPicker off that table at construction rather than inheriting it, so any built before the patch is re-pointed afterwards
local ORPHAN_LIMIT = 32
local orphans = {}

local function adoptAddons(element)
    if type(element) ~= "table" or rawget(element, "AddKeyPicker") == nil then return end
    if addonFuncs then
        element.AddKeyPicker = addonFuncs.AddKeyPicker
    elseif #orphans < ORPHAN_LIMIT then
        orphans[#orphans + 1] = element
    end
end

local function patchAddons(element)
    if addonFuncs or type(element) ~= "table" then return end
    local mt = getmetatable(element)
    local Funcs = mt and type(mt.__index) == "table" and mt.__index or nil
    if not (Funcs and type(Funcs.AddKeyPicker) == "function") then return end

    addonFuncs = Funcs
    wrapAdd(Funcs, "AddKeyPicker")
    wrapAdd(Funcs, "AddColorPicker")
    for _, orphan in ipairs(orphans) do orphan.AddKeyPicker = Funcs.AddKeyPicker end
    table.clear(orphans)
    Log.print("[Cerberus/Premium] BaseAddons Add* wrapped")
end

function wrapAdd(Funcs, name)
    local orig = Funcs[name]
    if type(orig) ~= "function" then return end
    local isAddon = ADDON[name] == true

    Funcs[name] = function(self, ...)
        local info = findPremiumInfo(...)
        if not info then
            local plain = orig(self, ...)
            if not isAddon then
                patchAddons(plain)
                adoptAddons(plain)
            end
            return plain
        end

        info.Premium = nil
        guardInfo(info)

        local host   = overlayHost(self, name)
        local before = host and snapshot(host) or nil
        local result = orig(self, ...)

        if before then coverNew(host, before) end
        if STRICT[name] then gateValues(resolveElement((select(1, ...)))) end
        if not isAddon then
            patchAddons(result)
            adoptAddons(result)
        end
        return result
    end
end

-- BaseGroupbox.__index is shared across every groupbox, so one patch covers all present and future elements
local funcsPatched = false
local function patchFuncs(groupboxLike)
    if funcsPatched then return end
    local mt = getmetatable(groupboxLike)
    if not (mt and type(mt.__index) == "table") then
        Log.warn("[Cerberus/Premium] patchFuncs: missing metatable on groupbox")
        return
    end

    funcsPatched = true
    local Funcs = mt.__index
    for name in pairs(STRICT) do wrapAdd(Funcs, name) end
    for _, name in ipairs(LOOSE) do wrapAdd(Funcs, name) end
    Log.print("[Cerberus/Premium] BaseGroupbox Add* wrapped")
end

local function wrapTab(tab)
    if not tab or tab.__cerb_premium_wrapped then return tab end
    tab.__cerb_premium_wrapped = true

    local function wrapGroupboxFactory(method)
        local orig = tab[method]
        if type(orig) ~= "function" then return end
        tab[method] = function(self, ...)
            local gb = orig(self, ...)
            if gb then patchFuncs(gb) end
            return gb
        end
    end
    wrapGroupboxFactory("AddLeftGroupbox")
    wrapGroupboxFactory("AddRightGroupbox")

    -- tabbox tabs share the same Funcs table, so patching from one covers them too
    local function wrapTabboxFactory(method)
        local orig = tab[method]
        if type(orig) ~= "function" then return end
        tab[method] = function(self, ...)
            local tabbox = orig(self, ...)
            if tabbox and not tabbox.__cerb_premium_wrapped then
                tabbox.__cerb_premium_wrapped = true
                local addTab = tabbox.AddTab
                if type(addTab) == "function" then
                    tabbox.AddTab = function(tbself, ...)
                        local subTab = addTab(tbself, ...)
                        if subTab then patchFuncs(subTab) end
                        return subTab
                    end
                end
            end
            return tabbox
        end
    end
    wrapTabboxFactory("AddLeftTabbox")
    wrapTabboxFactory("AddRightTabbox")

    return tab
end

local function wrapWindow(window)
    if not window or window.__cerb_premium_wrapped then return window end
    window.__cerb_premium_wrapped = true

    local function wrapTabFactory(method)
        local orig = window[method]
        if type(orig) ~= "function" then return end
        window[method] = function(self, ...)
            return wrapTab(orig(self, ...))
        end
    end
    wrapTabFactory("AddTab")
    wrapTabFactory("AddKeyTab")

    -- dialogs expose the same element funcs, so a premium element inside one is gated too
    local origAddDialog = window.AddDialog
    if type(origAddDialog) == "function" then
        window.AddDialog = function(self, ...)
            local dlg = origAddDialog(self, ...)
            if dlg then patchFuncs(dlg) end
            return dlg
        end
    end

    return window
end

-- install before CreateWindow so the returned window/tab/groupbox closures are the wrapped variants
local installed = false
function M.install(lib)
    if installed or type(lib) ~= "table" then return lib end
    installed = true
    Library = lib

    local origCreateWindow = lib.CreateWindow
    if type(origCreateWindow) == "function" then
        lib.CreateWindow = function(self, info)
            return wrapWindow(origCreateWindow(self, info))
        end
    end

    Log.print("[Cerberus/Premium] Library wrappers installed")
    return lib
end

return M

end)
