local Storage       = require("Features/Configs/Storage")
local UiShell       = require("Features/Configs/Ui")
local Browse        = require("Features/Configs/Ui/Browse")
local Submit        = require("Features/Configs/Ui/Submit")
local ReportModal   = require("Features/Configs/Ui/ReportModal")
local AgreementGate = require("Features/Configs/Agreement")
local Log           = require("Utility/Log")

local M = {}

-- same placeholders Auth/Fingerprint filters, duplicated to avoid coupling a Feature to the Auth module
local DISCORD_PLACEHOLDERS = {
    ["null"] = true, ["nil"] = true, ["none"] = true, ["0"] = true,
    ["false"] = true, ["unknown"] = true, ["unlinked"] = true,
    ["not linked"] = true, [""] = true,
}

local function readViewerDiscordId()
    local lrm = rawget(_G, "__rbx_runtime_auth")
    if type(lrm) ~= "table" then return nil end
    local v = lrm.LRM_LinkedDiscordID
    if type(v) == "number" then v = tostring(v) end
    if type(v) ~= "string" or v == "" then return nil end
    if DISCORD_PLACEHOLDERS[v:lower()] then return nil end
    return v
end

function M.init(ctx)
    local Library = ctx and ctx.Library
    if not Library then
        Log.warn("[Cerberus.Configs] init: missing Library on ctx — aborting")
        return
    end

    local services = {
        Api              = Api,
        Storage          = Storage,
        Library          = Library,
        SaveManager      = ctx.SaveManager,
        Unloader         = ctx.Unloader,
        viewerDiscordId  = readViewerDiscordId(),
    }

    local shell = UiShell(services)
    services.theme = shell.theme   -- panes pull palette off shell so they stay in sync
    services.shell = shell          -- exposes OnViewportChange for responsive panes

    -- single report modal; opener lets Browse rows raise it without a require dependency
    local reportModal = ReportModal(services)
    services.openReportModal = function(item) reportModal:Show(item) end

    shell:RegisterPane("Browse", function(parent, svcs)
        return Browse(parent, svcs)
    end)
    shell:RegisterPane("Submit", function(parent, svcs)
        return Submit(parent, svcs)
    end)

    -- opener global, cleared on unload; gated on the one-time community-configs agreement modal
    local env = (type(getgenv) == "function") and getgenv() or _G
    env.CERBERUS_CONFIGS_OPEN = function()
        local ok, agreed = pcall(AgreementGate.ensure)
        if not ok then
            Log.warn("[Cerberus.Configs] agreement gate threw: " .. tostring(agreed))
            -- fail-open so a transient UI issue doesn't lock users out of their own configs
            shell:Show()
            return
        end
        if not agreed then
            if Library and Library.Notify then
                Library:Notify("You must accept the Community Configs agreement to use the catalog.", 5)
            end
            return
        end
        shell:Show()
    end

    if ctx.Unloader and ctx.Unloader.Register then
        ctx.Unloader:Register(function()
            env.CERBERUS_CONFIGS_OPEN = nil
        end)
    end

    return {
        shell = shell,
        open  = function() shell:Show() end,
        close = function() shell:Hide() end,
    }
end

return M

