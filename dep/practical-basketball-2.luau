__bundle_register("Features/Player/Movement/ClickWalk", function(require, _LOADED, __bundle_register, __bundle_modules)
-- click-to-walk sub-module of movement: left-click the floor and a player api trip walks the route there under a beacon; the trip holds its own noclip, and a move key, a right-click or the trip ending clears it all
local Identity  = require("Utility/Identity")
local Jobs      = require("Utility/Jobs")
local Scheduler = require("Utility/Scheduler")
local Cursor    = require("Features/Player/Movement/Cursor")
local Guard     = require("Features/Player/Movement/Guard")

local NEON = Color3.fromRGB(55, 235, 120)

local AGENT = { AgentRadius = 2, AgentHeight = 5, AgentCanJump = false, WaypointSpacing = 4 }
local MIN_REPATH_INTERVAL = 0.3
-- a trip ends one stud from whatever it is handed, so a waypoint has to be passed on before that or the walk stops at the first one
local ADVANCE_RADIUS = 3
local TRIP_POLL      = 0.1
local STICK_DEADZONE = 0.15

return function(ctx)
    local Services = ctx.Services
    local Tabs     = ctx.Tabs
    local Library  = ctx.Library
    local Options  = ctx.Options
    local Toggles  = ctx.Toggles
    local NewMaid  = ctx.NewMaid
    local Player   = ctx.Player
    local track    = ctx.track
    local Input    = Services.UserInputService

    local CTWGroup = Tabs.Player:AddLeftGroupbox("Click To Walk", "mouse-pointer")

    CTWGroup:AddToggle("ClickToWalk", {
        Text = "Click To Walk",
        Default = false,
        Tooltip = "Left-click to walk, right-click to stop"
    })

    local CTWBox = CTWGroup:AddDependencyBox()

    CTWBox:AddSlider("CTW_Speed", {
        Text = "Walk Speed",
        Default = 16,
        Min = 8,
        Max = 300,
        Rounding = 0,
        Suffix = " studs/s"
    })

    CTWBox:SetupDependencies({
        { Toggles.ClickToWalk, true },
    })

    local pick = Cursor(ctx)
    local armed = false
    local walk
    local lastComputeAt = -math.huge

    local function walkSpeed() return Options.CTW_Speed.Value end

    local function endWalk()
        local ending = walk
        if not ending then return end
        walk = nil
        ending.maid:DoCleaning()
    end

    local function fadeAndDestroy(folder)
        Identity.elevate()
        for _, inst in ipairs(folder:GetDescendants()) do
            if inst:IsA("BasePart") then
                Services.TweenService:Create(inst, TweenInfo.new(0.25), { Transparency = 1 }):Play()
            end
        end
        -- leak:allow: completes a teardown, and cancelling it at unload would orphan the folder
        task.delay(0.3, function()
            pcall(folder.Destroy, folder)
        end)
    end

    local function ownedFolder(current, name)
        local folder = Instance.new("Folder")
        folder.Name = name
        folder.Parent = Services.Workspace
        current.maid:GiveTask(function() fadeAndDestroy(folder) end)
        return folder
    end

    local function neonPart(folder, name, size, cf)
        local part = Instance.new("Part")
        part.Name = name
        part.Anchored, part.CanCollide = true, false
        part.Material = Enum.Material.Neon
        part.Color = NEON
        part.Size = size
        part.CFrame = cf
        part.Parent = folder
        return part
    end

    local function drawBeacon(current, pos)
        Identity.elevate()
        local folder = ownedFolder(current, "Beacon")

        local pillar = neonPart(folder, "Pillar", Vector3.new(0.25, 12, 0.25), CFrame.new(pos + Vector3.new(0, 6, 0)))

        local flat = CFrame.Angles(math.rad(90), 0, 0)
        local ring = neonPart(folder, "Ring", Vector3.new(2, 0.2, 2), CFrame.new(pos) * flat)
        ring.Shape = Enum.PartType.Cylinder

        local glow = neonPart(folder, "Glow", Vector3.new(1.5, 0.15, 1.5), CFrame.new(pos + Vector3.new(0, 0.05, 0)))
        glow.Transparency = 0.5

        Services.TweenService:Create(ring,
            TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, -1, true), {
                Size = Vector3.new(6, 0.2, 6)
            }):Play()
        Services.TweenService:Create(pillar,
            TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
                Transparency = 0.25
            }):Play()

        local theta = 0
        current.maid:GiveTask(Scheduler.heartbeat(function(dt)
            -- the lane's thread is shared, and any task before this one may have read the game
            Identity.elevate()
            theta = theta + dt * math.pi / 2
            ring.CFrame = CFrame.new(pos) * CFrame.Angles(math.rad(90), theta, 0)
        end, { name = "ClickWalkBeacon", priority = 200, deferrable = true }))
    end

    local function drawRoute(current, points)
        Identity.elevate()
        local folder = ownedFolder(current, "PathContainer")
        for i, point in ipairs(points) do
            local dot = neonPart(folder, "Waypoint", Vector3.new(0.35, 0.35, 0.35), CFrame.new(point + Vector3.new(0, 0.15, 0)))
            dot.Shape = Enum.PartType.Ball
            local following = points[i + 1]
            if following then
                local segment = neonPart(folder, "Segment", Vector3.new(0.15, 0.15, (point - following).Magnitude),
                    CFrame.lookAt((point + following) / 2, following))
                segment.Transparency = 1
                Services.TweenService:Create(segment, TweenInfo.new(0.2), { Transparency = 0 }):Play()
            end
        end
    end

    -- nil only when cancelled; a search that fails still walks, because the trip holds noclip and the straight line gets there too
    local function findRoute(job, from, dest)
        local remaining = MIN_REPATH_INTERVAL - (os.clock() - lastComputeAt)
        if remaining > 0 and not job:sleep(remaining) then return nil end
        lastComputeAt = os.clock()
        local path = Services.PathfindingService:CreatePath(AGENT)
        local ok = pcall(path.ComputeAsync, path, from, dest)
        if not job.alive then return nil end
        if not ok or path.Status ~= Enum.PathStatus.Success then return { dest } end
        local points = {}
        for i, waypoint in ipairs(path:GetWaypoints()) do points[i] = waypoint.Position end
        if #points == 0 then return { dest } end
        return points
    end

    local function nextPoint(current)
        local points = current.points
        local position = Player.position()
        if position then
            while current.index < #points do
                local point = points[current.index]
                local flat = Vector3.new(point.X - position.X, 0, point.Z - position.Z)
                if flat.Magnitude > ADVANCE_RADIUS then break end
                current.index = current.index + 1
            end
        end
        return points[current.index]
    end

    -- the trip has no callback for ending, and it can end on its own by arriving, losing the body or at unload
    local function runTrip(job, current, dest)
        local from = Player.position()
        if not from then
            Guard.say(Library, Player, Player.Errors.NO_CHARACTER)
            endWalk()
            return
        end
        local route = findRoute(job, from, dest)
        if not route or walk ~= current then return end
        current.points, current.index = route, 1
        drawRoute(current, route)
        local trip, err = Player.moveTo(function() return nextPoint(current) end, walkSpeed)
        if not trip then
            Guard.say(Library, Player, err)
            endWalk()
            return
        end
        current.maid:GiveTask(trip)
        while job.alive and trip.IsRunning() do job:sleep(TRIP_POLL) end
        if walk == current then endWalk() end
    end

    local function wireInterrupts(current)
        current.maid:GiveTask(Input.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            local key = input.KeyCode
            if key == Enum.KeyCode.W or key == Enum.KeyCode.A or key == Enum.KeyCode.S or key == Enum.KeyCode.D
                or input.UserInputType == Enum.UserInputType.MouseButton2 then
                endWalk()
            end
        end))
        current.maid:GiveTask(Input.InputChanged:Connect(function(input, gameProcessed)
            if gameProcessed or input.KeyCode ~= Enum.KeyCode.Thumbstick1 then return end
            if input.Position.Magnitude > STICK_DEADZONE then endWalk() end
        end))
    end

    local function beginWalk(dest)
        endWalk()
        local current = { maid = NewMaid() }
        walk = current
        drawBeacon(current, dest)
        wireInterrupts(current)
        current.maid:GiveTask(Jobs.spawn(function(job)
            runTrip(job, current, dest)
        end, { name = "ClickWalk" }))
    end

    track(Input.InputBegan:Connect(function(input, gameProcessed)
        if not armed or gameProcessed or input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        local dest = pick()
        if dest then beginWalk(dest) end
    end))

    local function stopClickWalk()
        armed = false
        endWalk()
    end

    Toggles.ClickToWalk:OnChanged(function()
        if Toggles.ClickToWalk.Value then armed = true else stopClickWalk() end
    end)

    return { stopClickWalk = stopClickWalk }
end

end)
__bundle_register("Features/Player/Movement/Cursor", function(require, _LOADED, __bundle_register, __bundle_modules)
-- movement cursor: the world point under the mouse, looking past every body, ball and the proxy, and past anything you can walk through, because each would swallow the ray and put you in the air
local IGNORED = { "Characters", "ProxyCharacter", "Basketballs" }
local REACH   = 2000

return function(ctx)
    local Services   = ctx.Services
    local References = ctx.References

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.RespectCanCollide = true

    return function()
        local camera = References.camera
        if not camera then return nil end
        local Workspace = Services.Workspace
        local mouse = Services.UserInputService:GetMouseLocation()
        local ray = camera:ViewportPointToRay(mouse.X, mouse.Y)
        local ignored = {}
        for _, name in ipairs(IGNORED) do
            local found = Workspace:FindFirstChild(name)
            if found then ignored[#ignored + 1] = found end
        end
        params.FilterDescendantsInstances = ignored
        local hit = Workspace:Raycast(ray.Origin, ray.Direction * REACH, params)
        return hit and hit.Position or nil
    end
end

end)
