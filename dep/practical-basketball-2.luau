    local Services   = ctx.Services
    local Tabs       = ctx.Tabs
    local Library    = ctx.Library
    local Options    = ctx.Options
    local Toggles    = ctx.Toggles
    local track      = ctx.track

    local SndSvc  = Services.SoundService
    local HttpSvc = Services.HttpService

    if makefolder then
        pcall(makefolder, "Cerberus")
    end
    local CACHE_DIR = "Cerberus/MusicCache"
    if makefolder then
        pcall(makefolder, CACHE_DIR)
    end

    local PLAYLIST_FILE = "Cerberus/music.json"

    local DEFAULT_PLAYLIST = { {
        name = "Never Gonna Give You Up",
        url =
        "https://gitlab.com/main5015442/scripts/-/raw/main/music/Rick_Astley_-_Never_Gonna_Give_You_Up__Official_Video___4K_Remaster_.mp3?inline=false"
    }, {
        name = "Running in the 90s",
        url =
        "https://gitlab.com/main5015442/scripts/-/raw/main/music/Initial_D_-_Running_in_The_90s.mp3?inline=false"
    }, {
        name = "Phonk 1",
        url =
        "https://gitlab.com/main5015442/scripts/-/raw/main/music/MONTAGEM_SUPERSONIC__Slowed_Reverb___BRAZILIAN_PHONK_.mp3?inline=false"
    }, {
        name = "Phonk 2",
        url =
        "https://gitlab.com/main5015442/scripts/-/raw/main/music/ENVY_-_SLXUGHTER__SLOWED_REVERB___BRAZILIAN_PHONK_.mp3?inline=false"
    }, {
        name = "The Blinding Lights",
        url =
        "https://gitlab.com/main5015442/scripts/-/raw/main/music/The_Weeknd_-_Blinding_Lights__Official_Audio_.mp3?inline=false"
    }, {
        name = "Shape of You",
        url =
        "https://gitlab.com/main5015442/scripts/-/raw/main/music/Ed_Sheeran_-_Shape_of_You__Official_Music_Video_.mp3?inline=false"
    }, {
        name = "Billie Jean",
        url =
        "https://gitlab.com/main5015442/scripts/-/raw/main/music/Michael_Jackson_-_Billie_Jean__Official_Video_.mp3?inline=false"
    }, {
        name = "Bohemian Rhapsody",
        url =
        "https://gitlab.com/main5015442/scripts/-/raw/main/music/Queen_Bohemian_Rhapsody__Official_Video_Remastered_.mp3?inline=false"
    }, {
        name = "Thunderstruck",
        url =
        "https://gitlab.com/main5015442/scripts/-/raw/main/music/ACDC_-_Thunderstruck__Official_Video_.mp3?inline=false"
    }, {
        name = "Smooth Criminal",
        url =
        "https://gitlab.com/main5015442/scripts/-/raw/main/music/Michael_Jackson_-_Smooth_Criminal__Official_Video_.mp3?inline=false"
    }, {
        name = "Kung Fu Fighting",
        url =
        "https://gitlab.com/main5015442/scripts/-/raw/main/music/Carl_Douglas_Kung_Fu_Fighting__Original_Music_Video_.mp3?inline=false"
    }, {
        name = "Livin' On A Prayer",
        url =
        "https://gitlab.com/main5015442/scripts/-/raw/main/music/Bon_Jovi_-_Livin__On_A_Prayer.mp3?inline=false"
    }, {
        name = "Highway to Hell",
        url = "https://gitlab.com/main5015442/scripts/-/raw/main/music/highwayToHell.mp3?inline=false"
    }, {
        name = "God's Plan",
        url = "https://gitlab.com/main5015442/scripts/-/raw/main/music/Drake_-_God_s_Plan.mp3?inline=false"
    }, {
        name = "California Gurls",
        url =
        "https://gitlab.com/main5015442/scripts/-/raw/main/music/Katy_Perry_-_California_Gurls__Official_Music_Video__ft._Snoop_Dogg.mp3?inline=false"
    } }

    local function http_get(url)
        local ok, res = Http.request({ Url = url, Method = "GET" })
        if ok and res and (res.Body or res.body) then
            return true, (res.Body or res.body)
        end
        return false, "Not supported here"
    end

    local function write_bytes(path, bytes)
        if not writefile then
            return false, "Not supported here"
        end
        local ok, err = pcall(function()
            writefile(path, bytes)
        end)
        if not ok then
            return false, tostring(err)
        end
        return true
    end

    local function url_hash(s)
        local h = 5381
        for i = 1, #s do
            h = (h * 33 + string.byte(s, i)) % 4294967296
        end
        return string.format("%08x", h)
    end

    local function cache_path_for(url)
        local ext = url:match("%.([A-Za-z0-9]+)%f[%z%?%#]") or "bin"
        ext = ext:lower()
        if ext ~= "mp3" and ext ~= "ogg" and ext ~= "wav" then
            ext = "mp3"
        end
        return ("%s/%s.%s"):format(CACHE_DIR, url_hash(url), ext)
    end

    local function map_to_asset(path)
        if getcustomasset then
            local ok, v = pcall(getcustomasset, path)
            if ok and type(v) == "string" and #v > 0 then
                return true, v
            end
        end

        if getsynasset then
            local ok, v = pcall(getsynasset, path)
            if ok and type(v) == "string" and #v > 0 then
                return true, v
            end
        end

        if getsynfile then
            local ok, v = pcall(getsynfile, path)
            if ok and type(v) == "string" and #v > 0 then
                return true, v
            end
        end

        return false, "Not supported here"
    end

    local function readPlaylist()
        if isfile and isfile(PLAYLIST_FILE) then
            local ok, raw = pcall(readfile, PLAYLIST_FILE)
            if ok and type(raw) == "string" and #raw > 0 then
                local ok2, t = pcall(function()
                    return HttpSvc:JSONDecode(raw)
                end)
                if ok2 and type(t) == "table" then
                    return t
                end
            end
        end
        if writefile then
            pcall(function()
                writefile(PLAYLIST_FILE, HttpSvc:JSONEncode(DEFAULT_PLAYLIST))
            end)
        end
        return table.clone(DEFAULT_PLAYLIST)
    end

    local function writePlaylist(list)
        if not (writefile and list) then
            return
        end
        pcall(function()
            writefile(PLAYLIST_FILE, HttpSvc:JSONEncode(list))
        end)
    end

    local Playlist = readPlaylist()
    local MUSIC_FOLDER = SndSvc:FindFirstChild("MediaSource") or Instance.new("Folder")
    MUSIC_FOLDER.Name = "MediaSource"
    MUSIC_FOLDER.Parent = SndSvc

    for _, d in ipairs(SndSvc:GetDescendants()) do
        if d:IsA("Sound") and d:GetAttribute("MediaSource") == true then
            pcall(function()
                d:Stop()
            end)
            pcall(function()
                d:Destroy()
            end)
        end
    end

    local MAIN = MUSIC_FOLDER:FindFirstChild("MAIN")
    if not (MAIN and MAIN:IsA("Sound")) then
        MAIN = Instance.new("Sound")
        MAIN.Name = "MAIN"
        MAIN.Parent = MUSIC_FOLDER
    end
    MAIN:SetAttribute("MediaSource", true)

    local endedConn = nil
    local sessionToken = nil
    local modeState = "idle"
    local currentIndex = nil
    local lastTrackName = nil

    local MusicGroup = Tabs.Fun:AddLeftGroupbox("Music Player", "music")

    local function getSliderVal(opt, def)
        local v = def
        if opt then
            v = opt.Value or opt.CurrentValue or opt.Current or def
        end
        if type(v) ~= "number" then
            v = def
        end
        return v
    end
    local function getToggleVal(tog, def)
        if tog == nil then
            return def
        end
        local v = (tog.Value ~= nil) and tog.Value or (tog.Current ~= nil and tog.Current or def)
        return not not v
    end

    local function disconnectEnded()
        if endedConn then
            pcall(function()
                endedConn:Disconnect()
            end)
            endedConn = nil
        end
    end

    local function stopMusicHard()
        sessionToken = nil
        disconnectEnded()
        pcall(function()
            MAIN:Stop()
        end)
        lastTrackName = nil
        modeState = "idle"
        currentIndex = nil
    end

    local function musicCleanup()
        stopMusicHard()
        pcall(function()
            if MAIN then
                MAIN:Stop()
            end
        end)
        pcall(function()
            if MUSIC_FOLDER and MUSIC_FOLDER.Parent then
                MUSIC_FOLDER:Destroy()
            end
        end)
    end

    local function ensure_local_asset(url)
        local path = cache_path_for(url)
        if not (isfile and isfile(path)) then
            local ok, body = http_get(url)
            if not ok then
                return false, "Download failed"
            end
            local wOK = write_bytes(path, body)
            if not wOK then
                return false, "Couldn't save the track"
            end
        end
        local mapOK, mapped = map_to_asset(path)
        if not mapOK then
            return false, mapped
        end
        return true, mapped
    end

    local function applySoundProps()
        if not MAIN then
            return
        end
        local speed = getSliderVal(Options.MusicSpeed, 10)
        local vol = getSliderVal(Options.MusicVolume, 10)
        local pitch = getSliderVal(Options.MusicPitch, 10)
        local loop = getToggleVal(Toggles.MusicLooped, false)

        local spd = math.clamp(speed / 10, 0.1, 2.0)
        local pMul = math.clamp(pitch / 10, 0.1, 2.0)
        local voln = math.clamp(vol / 10, 0.0, 2.0)
        MAIN.PlaybackSpeed = spd * pMul
        MAIN.Volume = voln
        MAIN.Looped = loop
    end

    local function onLiveChange()
        applySoundProps()
    end

    local function startTrack(index, chainMode)
        if #Playlist == 0 then
            return
        end
        index = math.clamp(index, 1, #Playlist)
        currentIndex = index

        local song = Playlist[index]
        if not song or not song.url or song.url == "" then
            return
        end

        disconnectEnded()
        pcall(function()
            MAIN:Stop()
        end)
        MAIN.TimePosition = 0

        local ok, mappedOrErr = ensure_local_asset(song.url)
        if not ok then
            Library:Notify("⚠️ " .. (song.name or ("Track " .. index)) .. ": " .. tostring(mappedOrErr), 5)
            return
        end
        applySoundProps()
        MAIN.SoundId = mappedOrErr
        MAIN:SetAttribute("MediaSource", true)

        local okPlay = pcall(function()
            MAIN:Play()
        end)
        if not okPlay then
            Library:Notify("⚠️ Couldn't start: " .. (song.name or ("Track " .. index)), 5)
            return
        end

        lastTrackName = song.name or ("Track " .. index)
        Library:Notify("▶ " .. lastTrackName, 3)
        local myToken = {}
        sessionToken = myToken

        if chainMode == "order" then
            endedConn = track(MAIN.Ended:Connect(function()
                if sessionToken ~= myToken or modeState ~= "order" then
                    return
                end
                local nxt = currentIndex + 1
                if nxt > #Playlist then
                    nxt = 1
                end
                startTrack(nxt, "order")
            end))
        elseif chainMode == "shuffle" then
            endedConn = track(MAIN.Ended:Connect(function()
                if sessionToken ~= myToken or modeState ~= "shuffle" then
                    return
                end
                local n, nxt = #Playlist, 1
                if n == 1 then
                    nxt = 1
                else
                    repeat
                        nxt = math.random(1, n)
                    until nxt ~= currentIndex
                end
                startTrack(nxt, "shuffle")
            end))
        end
    end

    local function namesFrom(list)
        local t = {}
        for i = 1, #list do
            t[#t + 1] = (list[i] and list[i].name) or ("Track " .. i)
        end
        return (#t > 0) and t or { "---" }
    end

    local ddMusic = MusicGroup:AddDropdown("MUSIC_List", {
        Text = "Music List",
        Values = namesFrom(Playlist),
        Default = (Playlist[1] and Playlist[1].name) or "---",
        Multi = false
    })

    local function findIndexByName(name)
        if not name then
            return 1
        end
        for i = 1, #Playlist do
            if Playlist[i].name == name then
                return i
            end
        end
        return 1
    end

    local function playOrdered()
        if #Playlist == 0 then
            return Library:Notify("No songs", 3)
        end
        modeState = "order"
        sessionToken = {}
        local idx = ddMusic and ddMusic.Value and findIndexByName(ddMusic.Value) or (currentIndex or 1)
        startTrack(idx, "order")
    end

    local function playShuffled()
        if #Playlist == 0 then
            return Library:Notify("No songs", 3)
        end
        modeState = "shuffle"
        sessionToken = {}
        local n = #Playlist
        local idx
        if n == 1 then
            idx = 1
        else
            repeat
                idx = math.random(1, n)
            until idx ~= currentIndex
        end
        startTrack(idx, "shuffle")
    end

    MusicGroup:AddButton({
        Text = "Play In Order",
        Func = playOrdered
    })
    MusicGroup:AddButton({
        Text = "Play Shuffled",
        Func = playShuffled
    })
    MusicGroup:AddButton({
        Text = "Stop Music",
        Func = function()
            stopMusicHard()
        end
    })

    MusicGroup:AddDivider()

    MusicGroup:AddInput("MUSIC_URL", {
        Text = "Music URL",
        Placeholder = "https://... .mp3 / .ogg / .wav",
        ClearTextOnFocus = false,
        Finished = false
    })
    MusicGroup:AddInput("MUSIC_NAME", {
        Text = "Music Name",
        Placeholder = "Name",
        ClearTextOnFocus = false,
        Finished = false
    })

    local removeDD

    local function refreshDropdowns(selectName)
        local names = namesFrom(Playlist)
        if ddMusic and ddMusic.SetValues then
            ddMusic:SetValues(names)
            local want = selectName
            if not want and ddMusic.Value and table.find(names, ddMusic.Value) then
                want = ddMusic.Value
            end
            ddMusic:SetValue(want or names[1])
        end
        if removeDD and removeDD.SetValues then
            removeDD:SetValues(names)
            local rWant = names[1]
            if removeDD.Value and table.find(names, removeDD.Value) then
                rWant = removeDD.Value
            end
            removeDD:SetValue(rWant)
        end
    end

    MusicGroup:AddButton({
        Text = "Add To List",
        Func = function()
            local url = Str.trim(tostring((Options.MUSIC_URL and Options.MUSIC_URL.Value) or ""))
            local nm  = Str.trim(tostring((Options.MUSIC_NAME and Options.MUSIC_NAME.Value) or ""))
            if url == "" or not url:match("^https?://") then
                return Library:Notify("Enter an mp3, ogg or wav link", 3)
            end
            if nm == "" then
                nm = "Track " .. url_hash(url)
            end
            Playlist[#Playlist + 1] = {
                name = nm,
                url = url
            }
            writePlaylist(Playlist)
            refreshDropdowns(nm)
            if Options.MUSIC_URL and Options.MUSIC_URL.SetValue then
                Options.MUSIC_URL:SetValue("")
            end
            if Options.MUSIC_NAME and Options.MUSIC_NAME.SetValue then
                Options.MUSIC_NAME:SetValue("")
            end
        end
    })

    removeDD = MusicGroup:AddDropdown("MUSIC_Remove", {
        Text = "Remove Sound",
        Values = namesFrom(Playlist),
        Default = (#Playlist > 0 and Playlist[1].name) or "---"
    })

    MusicGroup:AddButton({
        Text = "Remove Selected",
        Func = function()
            local sel = removeDD.Value
            if not sel or sel == "---" then
                return Library:Notify("Pick a track first", 3)
            end
            for i = #Playlist, 1, -1 do
                if Playlist[i].name == sel then
                    table.remove(Playlist, i)
                end
            end
            writePlaylist(Playlist)
            refreshDropdowns()
        end
    })

    local ConfigGroup = Tabs.Fun:AddLeftGroupbox("Music Config", "sliders-vertical")
    MusicGroup:AddDivider()

    ConfigGroup:AddSlider("MusicSpeed", {
        Text = "Playback Speed",
        Default = 10,
        Min = 1,
        Max = 20,
        Rounding = 0,
        Callback = onLiveChange
    })
    ConfigGroup:AddSlider("MusicVolume", {
        Text = "Volume",
        Default = 10,
        Min = 0,
        Max = 20,
        Rounding = 0,
        Callback = onLiveChange
    })
    ConfigGroup:AddSlider("MusicPitch", {
        Text = "Pitch",
        Default = 10,
        Min = 1,
        Max = 20,
        Rounding = 0,
        Callback = onLiveChange
    })
    ConfigGroup:AddToggle("MusicLooped", {
        Text = "Loop",
        Default = false,
        Callback = onLiveChange
    })

    if Options.MusicSpeed and Options.MusicSpeed.OnChanged then
        Options.MusicSpeed:OnChanged(onLiveChange)
    end
    if Options.MusicVolume and Options.MusicVolume.OnChanged then
        Options.MusicVolume:OnChanged(onLiveChange)
    end
    if Options.MusicPitch and Options.MusicPitch.OnChanged then
        Options.MusicPitch:OnChanged(onLiveChange)
    end
    if Toggles.MusicLooped and Toggles.MusicLooped.OnChanged then
        Toggles.MusicLooped:OnChanged(onLiveChange)
    end

    return { cleanup = musicCleanup }
end

end)
__bundle_register("Utility/Helpers/Str", function(require, _LOADED, __bundle_register, __bundle_modules)
-- small string helpers: trim + brandless random hex names

local M = {}

function M.trim(s)
    if type(s) ~= "string" then return s end
    return (s:gsub("^%s+", ""):gsub("%s+$", ""))
end

-- cache the result at module-init: FindFirstChild by a cached name misses a fresh roll
function M.randomHex(len)
    len = len or 8
    local chars = "0123456789abcdef"
    local out = {}
    for i = 1, len do
        local j = math.random(1, #chars)
        out[i] = chars:sub(j, j)
    end
    return table.concat(out)
end

return M

end)
__bundle_register("Utility/Mount", function(require, _LOADED, __bundle_register, __bundle_modules)
-- shared orchestrator scaffolding (maid + tracked conns + subCtx + Unloader register) for feature init.lua files
local Identity = require("Utility/Identity")
local Log      = require("Utility/Log")

local M = {}

local function resolveNewMaid(ctx)
    if type(ctx.NewMaid) == "function" then return ctx.NewMaid end
    if ctx.Maid and type(ctx.Maid.new) == "function" then
        return function() return ctx.Maid.new() end
    end
    return nil
end

function M.orchestrator(ctx, name)
    -- the feature mounted before this one may have called into the game and dropped the identity its Add* calls need
    Identity.elevate()
    local newMaid = resolveNewMaid(ctx)
    if not newMaid then
        Log.warn(("[%s] Missing ctx.NewMaid; module will not initialize."):format(name or "Mount"))
        return nil
    end

    local moduleMaid = newMaid()
    local tracked = {}
    local teardown = {}
    local registered = false
    local cleaned = false

    local function cleanup()
        -- exposed on the orchestrator and registered with the Unloader, guarded so a direct call followed by unload can't run every teardown twice
        if cleaned then return end
        cleaned = true
        -- disconnect before teardown so watchers can't race state-restore
        for conn in pairs(tracked) do
            local okDc, errDc = pcall(function()
                if conn and conn.Disconnect then conn:Disconnect() end
            end)
            if not okDc then
                Log.warn(("[%s] Mount: tracked disconnect failed: %s"):format(name or "Mount", tostring(errDc)))
            end
            tracked[conn] = nil
        end
        local okMaid, errMaid = pcall(function() moduleMaid:DoCleaning() end)
        if not okMaid then
            Log.warn(("[%s] Mount: maid cleanup failed: %s"):format(name or "Mount", tostring(errMaid)))
        end
        for i = #teardown, 1, -1 do
            local okTd, errTd = pcall(teardown[i])
            if not okTd then
                Log.warn(("[%s] Mount: teardown[%d] failed: %s"):format(name or "Mount", i, tostring(errTd)))
            end
        end
    end

    -- registers cleanup with the Unloader on first tracked resource, so a mid-body error can't orphan connections
    local function ensureRegistered()
        if registered then return end
        registered = true
        if ctx.Unloader and ctx.Unloader.Register then
            ctx.Unloader:Register(cleanup)
        end
    end

    local function track(conn)
        if conn then
            tracked[conn] = true
            ensureRegistered()
        end
        return conn
    end

    local function subCtx(extras)
        local lib = ctx.Library
        local base = {
            -- forwarded like everything else: a feature reading ctx.Api on a sub-ctx that dropped it silently renders nothing
            Api        = ctx.Api,
            Services   = ctx.Services,
            Tabs       = ctx.Tabs,
            References = ctx.References,
            Library    = lib,
            Options    = ctx.Options or (lib and lib.Options),
            Toggles    = ctx.Toggles or (lib and lib.Toggles),
            Window     = ctx.Window,
            Helpers    = ctx.Helpers,
            Maid       = ctx.Maid,
            NewMaid    = ctx.NewMaid,
            track      = track,
        }
        if type(extras) == "table" then
            for k, v in pairs(extras) do base[k] = v end
        end
        return base
    end

    local function onUnload(fn)
        if type(fn) == "function" then
            teardown[#teardown + 1] = fn
            ensureRegistered()
        end
    end

    -- pcall'd factory: an erroring sub-module can't short-circuit the orchestrator or orphan earlier mounts
    local function mount(factory, factoryCtx)
        ensureRegistered()
        local ok, apiOrErr = pcall(factory, factoryCtx or subCtx())
        if not ok then
            Log.warn(("[%s] Mount: sub-module factory errored: %s"):format(
                name or "Mount", tostring(apiOrErr)))
            return {}
        end
        local api = apiOrErr
        if type(api) == "table" then
            if type(api.cleanup) == "function" then onUnload(api.cleanup) end
            if type(api.destroy) == "function" then onUnload(api.destroy) end
        end
        return api or {}
    end

    -- idempotent, kept for backward compat; track/onUnload/mount auto-finalize on first use
    local finalize = ensureRegistered

    return {
        maid     = moduleMaid,
        track    = track,
        subCtx   = subCtx,
        mount    = mount,
        onUnload = onUnload,
        cleanup  = cleanup,
        finalize = finalize,
    }
end

return M

end)
__bundle_register("Utility/Identity", function(require, _LOADED, __bundle_register, __bundle_modules)
-- thread identity: restores the executor thread to an identity that may create and touch gui instances, because a game-api call or a yield silently drops it mid-build

-- 8 is the level at which Instance.new and gui property writes are permitted; below it they throw
-- "lacking capability Plugin"
local TARGET = 8

local setter = setthreadidentity or set_thread_identity or setidentity
    or (syn and syn.set_thread_identity)
local getter = getthreadidentity or get_thread_identity or getidentity
    or (syn and syn.get_thread_identity)

local M = {}

M.supported = type(setter) == "function"

function M.current()
    if type(getter) ~= "function" then return nil end
    local ok, value = pcall(getter)
    return ok and value or nil
end

-- always sets, never trusts a read: the getter can report the target while the thread has already lost the
-- capability, and skipping the write on that reading is what leaves a groupbox unable to build
function M.elevate()
    if not M.supported then return false end
    return (pcall(setter, TARGET))
end

return M

end)
__bundle_register("Tabs/Misc", function(require, _LOADED, __bundle_register, __bundle_modules)
-- misc tab: server tools and utilities, game effects, subplaces and account rewards
local Effects   = require("Features/Basketball/Effects")
local Misc      = require("Features/Misc")
local Subplaces = require("Features/Misc/Subplaces")
local Rewards   = require("Features/Rewards")

return function(ctx)
    local Config = ctx.Config

    if Config.Misc then
        Misc({
            Api         = ctx.Api,
            Services    = ctx.Services,
            Tabs        = ctx.Tabs,
            References  = ctx.References,
            Library     = ctx.Library,
            Options     = ctx.Library.Options,
            Toggles     = ctx.Library.Toggles,
            Unloader    = ctx.Unloader,
            Maid        = ctx.Maid,
            NewMaid     = ctx.NewMaid,
        })
    end

    -- after Misc so its boxes read below the universal ones; it also places Celebrations on the Fun tab
    if Config.Basketball then Effects(ctx) end
    if Config.Subplaces then Subplaces(ctx) end
    if Config.Rewards then Rewards(ctx) end
end

end)
__bundle_register("Features/Rewards", function(require, _LOADED, __bundle_register, __bundle_modules)
-- rewards feature: shows daily task progress and claims finished ones when asked, redeems a code you type, and shows your coins and tickets, all on the rewards api
local Jobs  = require("Utility/Jobs")
local Mount = require("Utility/Mount")
local UiWrite = require("Utility/UiWrite")

local REFRESH_EVERY = 60
local LABEL_TASKS   = 4

local function plain(text)
    return (tostring(text or ""):gsub("[<>]", ""))
end

return function(ctx)
    local O = Mount.orchestrator(ctx, "Rewards")
    if not O then return {} end

    local Library = ctx.Library
    local Options = Library.Options
    local Tabs    = ctx.Tabs
    local Toggles = Library.Toggles
    local Rewards = ctx.Api and ctx.Api.Rewards

    local TaskGroup   = Tabs.Misc:AddLeftGroupbox("Daily Tasks", "list-checks")
    local CodeGroup   = Tabs.Misc:AddRightGroupbox("Codes", "ticket")
    local WalletGroup = Tabs.Misc:AddRightGroupbox("Your Account", "wallet")

    local taskLabel   = TaskGroup:AddLabel("Loading…", true)
    local walletLabel = WalletGroup:AddLabel("Loading…", true)

    if not Rewards then
        UiWrite.text(taskLabel, "Not available here")
        UiWrite.text(walletLabel, "Not available here")
        return {}
    end

    local alive = true
    local claiming, redeeming = false, false

    local function paintWallet()
        local money = Rewards.wallet()
        if not money then return end
        UiWrite.text(walletLabel, ("Coins: %d\nTickets: %d"):format(money.coins, money.tickets))
    end

    local function paintTasks(data)
        if type(data) ~= "table" or type(data.Tasks) ~= "table" then return end
        local done, lines = 0, {}
        for _, entry in ipairs(data.Tasks) do
            if entry.Claimed == true then
                done = done + 1
            elseif #lines < LABEL_TASKS then
                local state = entry.Completed == true and "Ready to claim"
                    or ("%d/%d"):format(tonumber(entry.Progress) or 0, tonumber(entry.Goal) or 0)
                lines[#lines + 1] = ("%s: %s"):format(plain(entry.Description or entry.Id), state)
            end
        end
        local head = ("%d of %d claimed"):format(done, #data.Tasks)
        UiWrite.text(taskLabel, #lines > 0 and (head .. "\n" .. table.concat(lines, "\n")) or head)
    end

    -- each claim replies with a fresh list, so the loop reads the newest one instead of walking a stale copy
    local function claimAll(data, job)
        if claiming then return 0 end
        claiming = true
        local total = 0
        local list = data
        while alive and job.alive do
            local ready = Rewards.finished(list)
            if #ready == 0 then break end
            local ok, fresh = Rewards.claim(ready[1].Index)
            if not ok then break end
            total = total + 1
            if type(fresh) ~= "table" then break end
            list = fresh
        end
        claiming = false
        paintTasks(list)
        paintWallet()
        return total
    end

    local function autoClaimOn()
        return Toggles.AutoClaimDailyTasks ~= nil and Toggles.AutoClaimDailyTasks.Value == true
    end

    local function refresh(job)
        local ok, data = Rewards.tasks()
        if not ok then
            if not job.alive then return end
            UiWrite.text(taskLabel, "Couldn't read your tasks")
            return
        end
        paintTasks(data)
        paintWallet()
        if autoClaimOn() then
            local claimed = claimAll(data, job)
            if claimed > 0 then UiWrite.notify(Library, ("Claimed %d task%s"):format(claimed, claimed == 1 and "" or "s"), 4) end
        end
    end

    TaskGroup:AddToggle("AutoClaimDailyTasks", {
        Text    = "Auto Claim",
        Default = false,
        Callback = function(on)
            if on then O.track(Jobs.spawn(refresh, { name = "RewardsRefresh" })) end
        end,
    })

    TaskGroup:AddButton({
        Text    = "Claim Finished Tasks",
        Func = function()
            O.track(Jobs.spawn(function(job)
                local ok, data = Rewards.tasks()
                if not ok then
                    UiWrite.notify(Library, "Couldn't read your tasks", 4)
                    return
                end
                local claimed = claimAll(data, job)
                UiWrite.notify(Library, claimed > 0 and ("Claimed %d task%s"):format(claimed, claimed == 1 and "" or "s")
                    or "Nothing to claim", 4)
            end, { name = "RewardsClaim" }))
        end,
    })

    CodeGroup:AddInput("RewardCode", {
        Text        = "Code",
        Default     = "",
        Placeholder = "Type a code",
        Finished    = false,
    })

    local codeLabel = CodeGroup:AddLabel("", true)

    CodeGroup:AddButton({
        Text    = "Redeem Code",
        Tooltip = "Some need the game's Roblox group",
        Func = function()
            if redeeming then return end
            local code = Options.RewardCode and Options.RewardCode.Value or ""
            redeeming = true
            O.track(Jobs.spawn(function()
                local ok, message = Rewards.redeem(code)
                redeeming = false
                local text
                if ok then
                    text = message and plain(message) or "Code redeemed"
                    UiWrite.value(Options.RewardCode, "")
                    paintWallet()
                elseif message == Rewards.Errors.NO_CODE then
                    text = "Type a code first"
                else
                    text = (type(message) == "string" and not message:find("/", 1, true)) and plain(message)
                        or "Code didn't work"
                end
                UiWrite.text(codeLabel, text)
            end, { name = "RewardsRedeem" }))
        end,
    })

    O.track(Rewards.TasksChanged:Connect(function(data)
        paintTasks(data)
        if autoClaimOn() and #Rewards.finished(data) > 0 then
            O.track(Jobs.spawn(refresh, { name = "RewardsRefresh" }))
        end
    end))

    O.track(Jobs.interval(REFRESH_EVERY, refresh, { name = "RewardsPoll", immediate = true }))

    O.onUnload(function() alive = false end)
    O.finalize()

    return {}
end

end)
__bundle_register("Utility/UiWrite", function(require, _LOADED, __bundle_register, __bundle_modules)
-- ui write: the one way a job, scheduler task or post-yield callback touches the menu; a game call or yield drops the thread's identity, so each write elevates first and is guarded, because obsidian sets its lua-side text before the instance and a refused write otherwise leaves the old text on screen with nothing to say so
local Identity = require("Utility/Identity")
local Log      = require("Utility/Log")

local M = {}

local function run(what, fn, ...)
    Identity.elevate()
    local ok, err = pcall(fn, ...)
    if not ok then Log.devwarn("UiWrite", "%s failed: %s", what, tostring(err)) end
    return ok
end

-- returns false for a missing element too, so a caller can tell the write did not land
function M.text(label, text)
    if not (label and label.SetText) then return false end
    return run("text", label.SetText, label, text)
end

function M.notify(library, text, seconds)
    if not (library and library.Notify) then return false end
    return run("notify", library.Notify, library, text, seconds)
end

function M.value(element, value)
    if not (element and element.SetValue) then return false end
    return run("value", element.SetValue, element, value)
end

function M.values(element, list)
    if not (element and element.SetValues) then return false end
    return run("values", element.SetValues, element, list)
end

function M.visible(element, on)
    if not (element and element.SetVisible) then return false end
    return run("visible", element.SetVisible, element, on)
end

return M

end)
__bundle_register("Features/Misc/Subplaces", function(require, _LOADED, __bundle_register, __bundle_modules)
-- lists every place in the current universe and TPs to one; develop.roblox.com via Http.client() (executor forwards .ROBLOSECURITY)
local Http  = require("Utility/Helpers/Http")
local Mount = require("Utility/Mount")

return function(ctx)
    local O = Mount.orchestrator(ctx, "Subplaces")
    if not O then return end

    local Services   = ctx.Services
    local Tabs       = ctx.Tabs
    local Library    = ctx.Library
    local References = ctx.References

    local SubplacesGroup = Tabs.Misc:AddLeftGroupbox("Subplaces", "map")

    local statusLabel = SubplacesGroup:AddLabel({ Text = "Idle", DoesWrap = true })

    local subplaceDD = SubplacesGroup:AddDropdown("SubplaceTarget", {
        Text       = "Destination",
        Values     = {},
        Default    = nil,
        Multi      = false,
        Searchable = true,
    })

    local labelToPlaceId = {}
    local fetching = false
    local cancelled = false

    O.onUnload(function() cancelled = true end)

    local function setStatus(text)
        if cancelled then return end
        if statusLabel and statusLabel.SetText then
            pcall(function() statusLabel:SetText(text) end)
        end
    end

    local function fetchSubplaces()
        if fetching then return end
        fetching = true
        setStatus("Loading…")

        task.spawn(function()
            local httpRequest = Http.client()
            if not httpRequest then
                setStatus("Not supported here")
                fetching = false
                return
            end

            local universeId = Services.Game.GameId
            if not universeId or universeId == 0 then
                setStatus("Game not found")
                fetching = false
                return
            end

            local collected = {}
            local cursor = nil
            local errMsg = nil
            local MAX_PAGES = 5

            for page = 1, MAX_PAGES do
                if cancelled then fetching = false; return end
                local url = ("https://develop.roblox.com/v1/universes/%d/places?isUniverseCreation=false&limit=100&sortOrder=Asc"):format(universeId)
                if cursor and cursor ~= "" then
                    url = url .. "&cursor=" .. Services.HttpService:UrlEncode(cursor)
                end

                local okCall, res = pcall(httpRequest, {
                    Url = url,
                    Method = "GET",
                    Headers = { ["Content-Type"] = "application/json" },
                })

                if not okCall or type(res) ~= "table" then
                    errMsg = "request failed"
                    break
                end

                local status = res.StatusCode or res.status_code or res.Status
                local ok2xx = type(status) == "number" and status >= 200 and status < 300
                if status == nil and res.Success ~= nil then ok2xx = res.Success == true end
                if not ok2xx then
                    errMsg = "HTTP " .. tostring(status or "error")
                    break
                end

                local body = res.Body or res.body
                if type(body) ~= "string" or body == "" then
                    errMsg = "empty response"
                    break
                end

                local okDec, data = pcall(Services.HttpService.JSONDecode, Services.HttpService, body)
                if not okDec or type(data) ~= "table" or type(data.data) ~= "table" then
                    errMsg = "decode failed"
                    break
                end

                for _, entry in ipairs(data.data) do
                    if entry.id and entry.name then
                        collected[#collected + 1] = { id = entry.id, name = entry.name }
                    end
                end

                cursor = data.nextPageCursor
                if not cursor or cursor == "" then break end
            end

            if #collected == 0 then
                if errMsg == "HTTP 401" or errMsg == "HTTP 403" then
                    setStatus("Roblox refused the list")
                elseif errMsg then
                    setStatus("Couldn't load subplaces")
                else
                    setStatus("No subplaces found")
                end
                fetching = false
                return
            end

            table.sort(collected, function(a, b)
                return a.name:lower() < b.name:lower()
            end)

            local labels = {}
            local mapping = {}
            local currentPlaceId = Services.Game.PlaceId
            for _, p in ipairs(collected) do
                local label = p.name
                if p.id == currentPlaceId then
                    label = label .. "  (current)"
                end
                -- disambiguate duplicate names by appending the placeId
                if mapping[label] then
                    label = ("%s [%d]"):format(label, p.id)
                end
                labels[#labels + 1] = label
                mapping[label] = p.id
            end

            if cancelled then fetching = false; return end

            labelToPlaceId = mapping
            pcall(function() subplaceDD:SetValues(labels) end)
            setStatus(("%d subplace%s"):format(#collected, #collected == 1 and "" or "s"))
            fetching = false
        end)
    end

    SubplacesGroup:AddButton({
        Text = "Teleport",
        Func = function()
            local label = subplaceDD.Value
            local placeId = label and labelToPlaceId[label]
            if not placeId then
                Library:Notify("Pick a subplace first", 3)
                return
            end
            local ok = pcall(function()
                Services.TeleportService:Teleport(placeId, References.player)
            end)
            if not ok then
                Library:Notify("Teleport failed", 4)
            end
        end,
    })

    task.spawn(fetchSubplaces)

    O.finalize()
    return {}
end

end)
