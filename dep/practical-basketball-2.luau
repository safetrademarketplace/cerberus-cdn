            local function changed() readHeld(rec) end
            jointSlot:GiveTask(joint:GetPropertyChangedSignal("Part0"):Connect(changed))
            jointSlot:GiveTask(joint:GetPropertyChangedSignal("Part1"):Connect(changed))
