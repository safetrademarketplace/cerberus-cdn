local services = {
    AdminService = true,
    AnimationService = true,
    BoostService = true,
    BuilderService = true,
    CodeService = true,
    CurrencyService = true,
    GiftService = true,
    GymCustomizeService = true,
    InventoryService = true,
    LiveEventService = true,
    PartyService = true,
    SeasonService = true,
    StoreService = true,
    TeleportService = true,
    UpgradeService = true,
}

local remotes = {
    DailyTaskService = { ClaimTask = true },
    GamemodeService = { Forfeit = true, StartVersus = true },
    InterfaceService = {
        JoinFriend = true, JoinPlace = true, LeaveRec = true, LoadLeagueCourt = true,
