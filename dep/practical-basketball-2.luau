__bundle_register("Api/Shot/Sweep", function(require, _LOADED, __bundle_register, __bundle_modules)
-- shot sweep: models one shot's meter as a straight line in time from the samples the server sends; phase runs 0 to 1 on the way up and 1 to 2 on the way back down, and network delay only ever makes a sample late, so the earliest-arriving fit is the true line

-- only vertical starts away from zero; the rest run from 0 on one axis to their own top, measured live over repeated full holds, and none still sweeps with the meter hidden
local VERTICAL = { axis = "Y", zero = -0.2411, span = -1.2488 }
local TOPS = {
    Hoop = 0.99, Bat = 0.99, Funnel = 0.99, Pill = 0.99, Funnel2 = 0.985, Arrow = 0.96,
    None = 0.94, Rocket = 0.92, Roblox = 0.92, Tube = 0.92, Diamond = 0.915,
}
local DEFAULT_TOP = 0.95  -- a style added after these were measured reads a little off and the learned lead absorbs it

local MIN_RATE, MAX_RATE = 1.6, 3.8
local MIN_FIT_POINTS = 8
local TURN_FLOOR   = 0.75  -- the meter only turns back near its top; a drop before this is a stale or out-of-order value
local TURN_DROP    = 0.35  -- and only a sample or two's worth, so a bigger drop is last shot's frozen value being replaced
local MAX_POINTS   = 40

local Sweep = {}
Sweep.__index = Sweep

local function inferGeometry(style, offset)
    local top = TOPS[style] or DEFAULT_TOP
    if offset.X ~= 0 then return { axis = "X", zero = 0, span = offset.X > 0 and top or -top } end
    if offset.Y ~= 0 then return { axis = "Y", zero = 0, span = offset.Y > 0 and top or -top } end
    return nil
end

function Sweep.new(style, rateHint)
    return setmetatable({
        style    = style,
        geometry = style == "Vertical" and VERTICAL or nil,
        hint     = rateHint,
        points   = {},
        count    = 0,
        leg      = 1,
    }, Sweep)
end

-- the server names the real style just after the shot starts, and the settings we read first can be stale
function Sweep:setStyle(style)
    if style == self.style then return end
    self.style = style
    self.geometry = style == "Vertical" and VERTICAL or nil
    self.points, self.count, self.leg = {}, 0, 1
    self.lastValue, self.lastProgress, self.lastPhase = nil, nil, nil
end

function Sweep:sample(now, offset)
    if offset == nil then return end
    local geometry = self.geometry
    if not geometry then
        geometry = inferGeometry(self.style, offset)
        if not geometry then return end
        self.geometry = geometry
    end
    local value = geometry.axis == "X" and offset.X or offset.Y
    if value == self.lastValue then return end
    self.lastValue = value

    local progress = (value - geometry.zero) / geometry.span
    local before = self.lastProgress
    if before and self.leg == 1 and progress < before - 1e-4 then
        if before >= TURN_FLOOR and before - progress <= TURN_DROP then
            self.leg = -1
        else
            self.points, self.count = {}, 0
        end
    end
    self.lastProgress = progress
    self.lastPhase = self.leg == 1 and progress or (2 - progress)

    if self.leg == 1 and self.count < MAX_POINTS then
        self.count = self.count + 1
        self.points[self.count] = { now, progress }
    end
end

function Sweep:rate()
    return self.hint
end

-- a straight-line fit over the whole way up, worth remembering for this shot speed
function Sweep:learnedRate()
    local n = self.count
    if n < MIN_FIT_POINTS then return nil end
    local sumT, sumP = 0, 0
    for i = 1, n do
        sumT = sumT + self.points[i][1]
        sumP = sumP + self.points[i][2]
    end
    local meanT, meanP = sumT / n, sumP / n
    local top, bottom = 0, 0
    for i = 1, n do
        local dt = self.points[i][1] - meanT
        top = top + dt * (self.points[i][2] - meanP)
        bottom = bottom + dt * dt
    end
    if bottom <= 0 then return nil end
    local rate = top / bottom
    return (rate >= MIN_RATE and rate <= MAX_RATE) and rate or nil
end

function Sweep:samples()
    return self.count
end

function Sweep:anchor()
    local rate = self:rate()
    local best
    for i = 1, self.count do
        local point = self.points[i]
        local start = point[1] - point[2] / rate
        if not best or start < best then best = start end
    end
    return best
end

function Sweep:timeOfPhase(phase)
    local anchor = self:anchor()
    return anchor and (anchor + phase / self:rate()) or nil
end

function Sweep:phaseAt(time)
    local anchor = self:anchor()
    return anchor and ((time - anchor) * self:rate()) or nil
end

function Sweep:finalPhase()
    return self.lastPhase
end

return Sweep

end)
