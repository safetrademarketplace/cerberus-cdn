    if not Tabs["UI Settings"] then return end

    local function getAutoShowDefault()
        local default = true
        if not (isfile and readfile and Services.HttpService and References.player) then
            return default
        end
        local settingsPath = string.format("Cerberus/%s/settings/Configurations", References.gameName)
        local localPlayerName = References.player.Name

        local function readJson(path)
            if not isfile(path) then return nil end
            local okRead, raw = pcall(readfile, path)
            if not okRead or type(raw) ~= "string" then return nil end
            local okDecode, decoded = pcall(Services.HttpService.JSONDecode, Services.HttpService, raw)
            if not okDecode or type(decoded) ~= "table" then return nil end
            return decoded
        end

        local function readToggleFromConfig(configName)
            if type(configName) ~= "string" or configName == "" or configName == "none" then return nil end
            local decoded = readJson(settingsPath .. "/" .. configName .. ".json")
            if not decoded or type(decoded.objects) ~= "table" then return nil end
            for _, obj in ipairs(decoded.objects) do
                if type(obj) == "table" and obj.type == "Toggle" and obj.idx == "Menu_AutoShow" then
                    if type(obj.value) == "boolean" then return obj.value end
                    return nil
                end
            end
            return nil
        end

        local configName
        local playerAutoload = readJson(settingsPath .. "/autoload_players.json")
        if playerAutoload and type(playerAutoload[localPlayerName]) == "string" and playerAutoload[localPlayerName] ~= "" then
            configName = playerAutoload[localPlayerName]
        end
        if not configName then
            local globalAutoloadPath = settingsPath .. "/autoload.txt"
            if isfile(globalAutoloadPath) then
                local okRead, raw = pcall(readfile, globalAutoloadPath)
                if okRead and type(raw) == "string" then
                    local trimmed = raw:gsub("^%s+", ""):gsub("%s+$", "")
                    if trimmed ~= "" then configName = trimmed end
                end
            end
        end

        local value = readToggleFromConfig(configName)
        if type(value) == "boolean" then return value end
        return default
